---
/**
 * Rack — the machine the music actually lives on.
 *
 * Every other study in the set argues about the phone. This one draws the
 * other end of the wire: a rack unit, cropped by both edges of the frame,
 * sitting low and heavy under a quiet column of type. Self-hosting is the
 * whole product, and nothing says it faster than the hardware humming in
 * somebody's cupboard.
 *
 * The one gesture is the machine itself, drawn properly — ears, screws, a
 * brushed faceplate, a silkscreened mark, real drive bays. The only motion on
 * the page is a single drive light, because that is the only thing that moves
 * on a real one.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

const SERVERS = ['Plex', 'Jellyfin', 'Navidrome'];
const BAYS = [0, 1, 2, 3, 4, 5, 6, 7];
---

<Layout
  title={`${NAME} — a free player for the music on your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Navidrome server you already run, listen at home, or download an album and play it offline."
  themeColor="#0b0b0d"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Azeret+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="rack" />

  <main class="bay">
    <div class="col">
      <header class="brow">
        <span class="lockup">
          <Mark size={24} decorative />
          <b>Mozz</b>
        </span>
        <span class="tag">self&#8209;hosted music player</span>
        <span class="tag dim">free forever &middot; gpl&#8209;3.0</span>
      </header>

      <div class="say">
        <h1>Mozz is a free player for the music on your own server.</h1>

        <div class="aside">
          <p class="sup">
            The library is already yours and it is already running. Mozz is the
            part you hold: stream it over your own network, or take an album with
            you and play it with no signal at all.
          </p>

          <p class="works">
            <span>plays from</span>
            {SERVERS.map((server) => <b>{server}</b>)}
          </p>
        </div>
      </div>

      <div class="acts">
        <a class="btn go" href={GITHUB_URL}>Source on GitHub</a>
        {
          APP_STORE_URL ? (
            <a class="btn wait" href={APP_STORE_URL}>
              Download on the App Store
            </a>
          ) : (
            <span class="btn wait" aria-disabled="true">
              Coming to the App Store
            </span>
          )
        }
      </div>
    </div>

    <!-- ---- the machine --------------------------------------------------- -->
    <div class="unit" role="img" aria-label="A rack-mounted home server with eight drive bays, running a music library.">
      <span class="ear left" aria-hidden="true"><i></i><i></i></span>

      <div class="face" aria-hidden="true">
        <span class="silk">
          <b>MOZZ</b>
          <i>library node &middot; 01</i>
        </span>

        <span class="vents"></span>

        <span class="lcd">
          <em>&#9679; online</em>
          <span>your music &middot; your hardware &middot; no account</span>
        </span>

        <span class="vents"></span>

        <span class="bays">
          {
            BAYS.map((index) => (
              <i class={index === 5 ? 'active' : undefined}>
                <u />
                <s />
              </i>
            ))
          }
        </span>

        <span class="power"></span>
      </div>

      <span class="ear right" aria-hidden="true"><i></i><i></i></span>
    </div>

    <p class="fine">iPhone and iPad &middot; no account, no tracking, no subscription</p>
  </main>
</Layout>

<style is:global>
  body {
    background: #0b0b0d;
  }
</style>

<style>
  .bay {
    --void: #0b0b0d;
    --cream: #f2eee6;
    --red: #d8002d;
    --steel: #2a2a2f;

    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh;
    padding: clamp(56px, 7vh, 84px) clamp(18px, 4vw, 56px) clamp(14px, 2.4vh, 28px);
    overflow: hidden;
    background:
      radial-gradient(110% 62% at 50% 104%, rgba(216, 0, 45, 0.3), transparent 68%),
      var(--void);
    color: var(--cream);
    font-family: 'Archivo', 'Helvetica Neue', system-ui, sans-serif;
  }

  .col {
    width: min(84rem, 100%);
    margin-bottom: auto;
  }

  .say {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    align-items: end;
    gap: clamp(1.2rem, 3vw, 3.4rem);
    margin-top: clamp(1.1rem, 4vh, 2.6rem);
  }

  .aside {
    padding-bottom: 0.35rem;
  }

  .brow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tag {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(9.5px, 0.76vw, 11px);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(242, 238, 230, 0.62);
  }

  .tag.dim {
    margin-left: auto;
    color: rgba(242, 238, 230, 0.36);
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(34px, 5.3vw, 84px);
    font-weight: 800;
    font-variation-settings: 'wdth' 96;
    line-height: 0.98;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .sup {
    max-width: 44ch;
    font-size: clamp(13px, 1.05vw, 16px);
    line-height: 1.55;
    color: rgba(242, 238, 230, 0.68);
    text-wrap: pretty;
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: clamp(0.8rem, 2vh, 1.2rem);
  }

  .works span {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(9px, 0.72vw, 10.5px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(242, 238, 230, 0.4);
  }

  .works b {
    padding: 0.3rem 0.62rem;
    border: 1px solid rgba(242, 238, 230, 0.22);
    border-radius: 999px;
    font-size: clamp(11.5px, 0.9vw, 13.5px);
    font-weight: 600;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: clamp(1.1rem, 3vh, 1.9rem);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.15rem;
    border-radius: 999px;
    font-size: clamp(12px, 0.92vw, 14px);
    font-weight: 700;
    white-space: nowrap;
  }

  .go {
    background: var(--red);
    color: #fff;
    transition: background 160ms ease;
  }

  .go:hover {
    background: #f10233;
  }

  .wait {
    border: 1.5px dashed rgba(242, 238, 230, 0.34);
    color: rgba(242, 238, 230, 0.72);
  }

  /* ---- the rack unit ---------------------------------------------------- */

  .unit {
    display: flex;
    align-items: stretch;
    width: max(1120px, 104vw);
    height: clamp(120px, 36vh, 340px);
    margin-top: clamp(1.4rem, 4vh, 2.8rem);
    flex: none;
    border-radius: 4px;
    background: linear-gradient(180deg, #55555f, #2c2c33 46%, #1b1b20);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 -26px 46px -22px rgba(0, 0, 0, 0.95),
      0 0 0 1px rgba(0, 0, 0, 0.8),
      0 0 90px 10px rgba(216, 0, 45, 0.1);
  }

  .ear {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: none;
    width: clamp(20px, 2.4vw, 40px);
    padding: clamp(8px, 1.4vh, 16px) 0;
    background: linear-gradient(180deg, #5a5a65, #26262c);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5);
  }

  .ear i {
    display: block;
    width: clamp(7px, 0.72vw, 11px);
    height: clamp(7px, 0.72vw, 11px);
    margin-inline: auto;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #6d6d76, #101013 74%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .face {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 34px);
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 clamp(14px, 2.4vw, 40px);
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.028) 0 1px,
        transparent 1px 3px
      ),
      linear-gradient(180deg, #4c4c56, #2e2e35 52%, #1e1e23);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  .silk {
    display: flex;
    flex-direction: column;
    gap: 0.22em;
    flex: none;
  }

  .silk b {
    font-size: clamp(17px, 2vw, 34px);
    font-weight: 900;
    font-variation-settings: 'wdth' 82;
    letter-spacing: 0.06em;
    color: rgba(242, 238, 230, 0.92);
  }

  .silk i {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(7px, 0.62vw, 9.5px);
    font-style: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(242, 238, 230, 0.3);
  }

  /* Cooling slots, milled into the plate. */
  .vents {
    flex: 1 1 0;
    max-width: clamp(70px, 22vw, 420px);
    align-self: stretch;
    min-width: 0;
    margin-block: clamp(26px, 8.5vh, 88px);
    background-image: repeating-linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.55) 0 3px,
      transparent 3px 9px
    );
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  .lcd {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4em;
    flex: 0 1 auto;
    width: clamp(180px, 26vw, 420px);
    min-width: 0;
    padding: clamp(6px, 1.1vh, 13px) clamp(9px, 1.2vw, 18px);
    border-radius: 3px;
    background: #08080a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.9),
      inset 0 2px 10px rgba(0, 0, 0, 0.8);
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(8px, 0.72vw, 11px);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lcd em {
    font-style: normal;
    color: var(--red);
  }

  .lcd span {
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(242, 238, 230, 0.5);
  }

  .bays {
    display: flex;
    gap: clamp(3px, 0.42vw, 6px);
    flex: none;
    height: 66%;
    padding: clamp(3px, 0.4vw, 6px);
    border-radius: 3px;
    background: #0d0d10;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.85), inset 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .bays i {
    position: relative;
    display: block;
    width: clamp(11px, 1.25vw, 21px);
    border-radius: 2px;
    background: linear-gradient(100deg, #33333a, #1d1d22 40%, #131317);
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.7),
      inset 1px 0 0 rgba(255, 255, 255, 0.09);
  }

  /* The tray handle. */
  .bays u {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 16%;
    height: 26%;
    border-radius: 1px;
    background: rgba(0, 0, 0, 0.55);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .bays s {
    position: absolute;
    left: 50%;
    bottom: 9%;
    width: clamp(4px, 0.4vw, 6px);
    height: clamp(4px, 0.4vw, 6px);
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgba(242, 238, 230, 0.18);
  }

  /* One drive is working. Nothing else on the page moves. */
  .bays .active s {
    background: var(--red);
    box-shadow: 0 0 8px 1px rgba(216, 0, 45, 0.85);
    animation: seek 1.9s steps(1, end) infinite;
  }

  @keyframes seek {
    0%,
    38% {
      opacity: 1;
    }
    44%,
    52% {
      opacity: 0.18;
    }
    58%,
    100% {
      opacity: 1;
    }
  }

  .power {
    flex: none;
    width: clamp(13px, 1.5vw, 24px);
    height: clamp(13px, 1.5vw, 24px);
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%, #45454d, #17171b 72%);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.72),
      0 0 0 3px rgba(216, 0, 45, 0.28);
  }

  .fine {
    margin-top: clamp(0.7rem, 2vh, 1.2rem);
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(8.5px, 0.68vw, 10.5px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(242, 238, 230, 0.32);
    text-align: center;
  }

  a:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  /* ---- narrow ----------------------------------------------------------- */

  @media (max-width: 72rem) {
    .say {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .aside {
      padding-bottom: 0;
    }
  }

  @media (max-width: 62rem) {
    .tag.dim {
      margin-left: 0;
    }

    .lcd span {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .bay {
      padding-inline: 18px;
    }

    h1 {
      max-width: 13ch;
      font-size: clamp(32px, 10.4vw, 46px);
    }

    .sup {
      max-width: 36ch;
      font-size: 13.5px;
    }

    .works b {
      font-size: 12px;
    }

    .unit {
      width: 118vw;
      height: clamp(84px, 16vh, 130px);
    }

    /* Four bays read as a drive array; eight at this width read as noise. */
    .bays i:nth-child(n + 5) {
      display: none;
    }

    .lcd,
    .vents {
      display: none;
    }

    .face {
      justify-content: space-between;
      gap: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bays .active s {
      animation: none;
    }

    .go {
      transition: none;
    }
  }
</style>
