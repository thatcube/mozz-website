---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import { GITHUB_URL, NAME } from '../../data/site';

const HEADLINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT =
  'Stream at home, or download an album and keep listening when there is no signal.';
const SERVERS = ['Plex', 'Jellyfin', 'Navidrome'];
---

<Layout
  title={`${NAME} — a free player for the music on your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Play from your own Plex, Jellyfin or Navidrome server, at home or offline."
  themeColor="#d8002d"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="corona" />

  <main class="corona">
    <header class="top">
      <a class="brand" href="/" aria-label="Mozz home">
        <Mark size={42} decorative />
        <span>
          <strong>Mozz</strong>
          <small>Free · open source</small>
        </span>
      </a>

      <nav class="actions" aria-label="Get Mozz">
        <span class="store" aria-disabled="true">Coming to the App Store</span>
        <a class="github" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <section class="intro">
      <p class="eyebrow">A self-hosted music player for iPhone and iPad</p>
      <h1>{HEADLINE}</h1>
      <p class="support">{SUPPORT}</p>
      <p class="servers">
        <span>Plays from</span>
        {SERVERS.map((server, index) => (
          <>
            {index > 0 && <i aria-hidden="true"></i>}
            <strong>{server}</strong>
          </>
        ))}
      </p>
    </section>

    <div class="stage" aria-hidden="true">
      <div class="beam"></div>
      <div class="word">MOZZ</div>
      <div class="long-shadow"></div>
      <svg class="light-mark mark-left" viewBox="0 0 44 44">
        <path d="M22 2v40M2 22h40M8 8l28 28M36 8 8 36" />
      </svg>
      <svg class="light-mark mark-right" viewBox="0 0 44 44">
        <path d="M22 4v36M4 22h36" />
      </svg>
    </div>

    <div
      class="phone"
      role="img"
      aria-label="An iPhone showing Mozz playing Half Awake by Static Choir, downloaded for offline listening."
    >
      <span class="side-button side-a" aria-hidden="true"></span>
      <span class="side-button side-b" aria-hidden="true"></span>
      <div class="screen">
        <span class="island" aria-hidden="true"></span>

        <div class="status">
          <span>9:41</span>
          <span class="status-icons" aria-hidden="true">
            <svg viewBox="0 0 18 12">
              <path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path>
            </svg>
            <svg viewBox="0 0 26 12">
              <rect x="1" y="1" width="21" height="10" rx="2.5"></rect>
              <path d="M23 4h2v4h-2z"></path>
              <rect x="3" y="3" width="14" height="6" rx="1"></rect>
            </svg>
          </span>
        </div>

        <div class="app-head">
          <Mark size={22} decorative />
          <span>
            <small>NOW PLAYING</small>
            <b>From your server</b>
          </span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="5" cy="12" r="1.5"></circle>
            <circle cx="12" cy="12" r="1.5"></circle>
            <circle cx="19" cy="12" r="1.5"></circle>
          </svg>
        </div>

        <div class="album" aria-hidden="true">
          <svg viewBox="0 0 240 240">
            <rect width="240" height="240" fill="#d8002d"></rect>
            <path d="M-25 52 131-28l134 61-157 80z" fill="#0a070d"></path>
            <path d="M-18 202 119 89l151 66-137 113z" fill="#fdf6ec"></path>
            <path d="m37 181 83-68 86 38-83 68z" fill="#7d0019"></path>
            <path d="M0 151 240 42M0 168 240 59" fill="none" stroke="#d8002d" stroke-width="5"></path>
            <text
              x="18"
              y="31"
              fill="#fdf6ec"
              font-family="IBM Plex Mono, monospace"
              font-size="10"
              font-weight="600"
              letter-spacing="2">NORTH / 04</text
            >
          </svg>
        </div>

        <div class="track">
          <span>
            <strong>Half Awake</strong>
            <small>Static Choir · Northbound</small>
          </span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.8 4.8a5.3 5.3 0 0 0-7.6 0L12 6l-1.2-1.2a5.3 5.3 0 0 0-7.6 7.5L12 21l8.8-8.7a5.3 5.3 0 0 0 0-7.5Z"
            ></path>
          </svg>
        </div>

        <div class="progress" aria-hidden="true">
          <span><i></i></span>
          <div><b>1:37</b><b>−2:18</b></div>
        </div>

        <div class="controls" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M18 5v14M16 6 6 12l10 6z"></path>
          </svg>
          <span class="pause">
            <svg viewBox="0 0 24 24">
              <rect x="6" y="5" width="4" height="14" rx="1"></rect>
              <rect x="14" y="5" width="4" height="14" rx="1"></rect>
            </svg>
          </span>
          <svg viewBox="0 0 24 24">
            <path d="M6 5v14M8 6l10 6-10 6z"></path>
          </svg>
        </div>

        <div class="offline">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="9"></circle>
            <path d="m6 10.2 2.5 2.5 5.5-6"></path>
          </svg>
          <span>Downloaded · ready offline</span>
        </div>

        <span class="home-indicator" aria-hidden="true"></span>
      </div>
    </div>

    <footer class="foot">
      <span>No account</span>
      <i aria-hidden="true"></i>
      <span>No tracking</span>
      <i aria-hidden="true"></i>
      <span>No subscription</span>
      <span class="license">GPL-3.0</span>
    </footer>
  </main>
</Layout>

<style is:global>
  body {
    background: #0a070d;
  }
</style>

<style>
  .corona {
    --black: #0a070d;
    --ink: #191320;
    --deep: #7d0019;
    --red: #d8002d;
    --soft: #eeeae2;
    --paper: #fdf6ec;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: var(--paper);
    background: var(--red);
    font-family: 'IBM Plex Sans', 'Avenir Next', Arial, sans-serif;
  }

  .corona::before {
    content: '';
    position: absolute;
    inset: 42px 0 0;
    z-index: 0;
    background: var(--black);
  }

  .top {
    position: absolute;
    z-index: 9;
    top: calc(42px + clamp(14px, 2.2vh, 22px));
    right: clamp(18px, 3.4vw, 52px);
    left: clamp(18px, 3.4vw, 52px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--paper);
    text-decoration: none;
  }

  .brand > span {
    display: grid;
    gap: 2px;
  }

  .brand strong {
    font-family: 'Bowlby One SC', 'Arial Black', Arial, sans-serif;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .brand small {
    color: rgba(238, 234, 226, 0.56);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .store,
  .github {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(238, 234, 226, 0.34);
    border-radius: 999px;
    padding: 0 14px;
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
  }

  .store {
    color: rgba(238, 234, 226, 0.66);
  }

  .github {
    gap: 7px;
    border-color: var(--red);
    color: var(--paper);
    background: var(--red);
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .github:hover {
    color: var(--red);
    background: var(--paper);
    transform: translateY(-2px);
  }

  .brand:focus-visible,
  .github:focus-visible {
    border-radius: 4px;
    outline: 3px solid var(--paper);
    outline-offset: 4px;
  }

  .intro {
    position: absolute;
    z-index: 7;
    top: calc(42px + clamp(58px, 7.5vh, 72px));
    left: 50%;
    width: min(94vw, 1120px);
    text-align: center;
    transform: translateX(-50%);
    animation: copy-in 650ms 80ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--red);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: clamp(8px, 0.72vw, 10px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 19ch;
    margin: 0 auto;
    color: var(--paper);
    font-size: clamp(40px, 4.25vw, 62px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .support {
    max-width: 56ch;
    margin: 15px auto 0;
    color: rgba(238, 234, 226, 0.78);
    font-size: clamp(11px, 0.95vw, 13px);
    line-height: 1.45;
  }

  .servers {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 13px 0 0;
    font-size: clamp(9px, 0.78vw, 11px);
  }

  .servers span {
    color: rgba(238, 234, 226, 0.44);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: 0.78em;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .servers strong {
    font-weight: 500;
  }

  .servers i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--red);
  }

  .stage {
    position: absolute;
    inset: 42px 0 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    z-index: 0;
    background: var(--deep);
  }

  .stage::before {
    top: 7%;
    left: 0;
    width: 73%;
    height: 39%;
    clip-path: polygon(0 0, 100% 89%, 100% 100%, 0 22%);
  }

  .stage::after {
    top: 6%;
    right: 0;
    width: 31%;
    height: 39%;
    clip-path: polygon(0 89%, 100% 0, 100% 22%, 0 100%);
  }

  .beam {
    position: absolute;
    z-index: 1;
    top: 43%;
    left: -3vw;
    width: 106vw;
    height: 64%;
    clip-path: polygon(0 4%, 100% 0, 100% 94%, 0 100%);
    background: var(--paper);
    box-shadow:
      0 -13px 0 var(--deep),
      0 -22px 0 rgba(125, 0, 25, 0.5);
    animation: beam-on 900ms cubic-bezier(0.16, 0.78, 0.22, 1) both;
  }

  .word {
    position: absolute;
    z-index: 2;
    top: 67%;
    left: 48%;
    color: var(--black);
    font-family: 'Bowlby One SC', 'Arial Black', Arial, sans-serif;
    font-size: clamp(280px, 24.5vw, 370px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.8;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    user-select: none;
  }

  .long-shadow {
    position: absolute;
    z-index: 1;
    top: 44%;
    left: 68%;
    width: 38vw;
    height: 67%;
    clip-path: polygon(0 0, 100% 13%, 100% 100%, 0 93%);
    background: var(--red);
    transform: rotate(3.5deg);
    transform-origin: left center;
    animation: shadow-in 900ms 160ms cubic-bezier(0.16, 0.78, 0.22, 1) both;
  }

  .light-mark {
    position: absolute;
    z-index: 4;
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 2;
  }

  .mark-left {
    top: 48%;
    left: 8%;
    color: var(--red);
    transform: rotate(12deg);
  }

  .mark-right {
    top: 72%;
    right: 9%;
    width: 17px;
    color: var(--paper);
    transform: rotate(18deg);
  }

  .phone {
    --phone-w: clamp(240px, 18.75vw, 270px);
    position: absolute;
    z-index: 6;
    top: 45%;
    left: 68%;
    width: var(--phone-w);
    aspect-ratio: 9 / 19.5;
    padding: calc(var(--phone-w) * 0.034);
    border: calc(var(--phone-w) * 0.014) solid var(--black);
    border-radius: calc(var(--phone-w) * 0.15);
    color: var(--paper);
    background: var(--paper);
    box-shadow:
      calc(var(--phone-w) * 0.035) calc(var(--phone-w) * 0.045) 0 var(--black),
      0 0 0 2px var(--paper);
    transform: translateX(-50%) rotate(3.5deg);
    animation: phone-in 820ms 130ms cubic-bezier(0.17, 0.84, 0.22, 1) both;
  }

  .side-button {
    position: absolute;
    left: calc(var(--phone-w) * -0.052);
    width: calc(var(--phone-w) * 0.025);
    border-radius: 4px 0 0 4px;
    background: var(--black);
  }

  .side-a {
    top: 22%;
    height: 10%;
  }

  .side-b {
    top: 35%;
    height: 15%;
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--phone-w) * 0.115);
    color: var(--paper);
    background: var(--ink);
    font-family: 'IBM Plex Sans', 'Avenir Next', Arial, sans-serif;
  }

  .island {
    position: absolute;
    z-index: 5;
    top: calc(var(--phone-w) * 0.02);
    left: 50%;
    width: 29%;
    height: calc(var(--phone-w) * 0.064);
    border-radius: 999px;
    background: var(--black);
    transform: translateX(-50%);
  }

  .status {
    display: flex;
    height: calc(var(--phone-w) * 0.11);
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--phone-w) * 0.026) calc(var(--phone-w) * 0.06) 0;
    font-size: calc(var(--phone-w) * 0.026);
    font-weight: 600;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: calc(var(--phone-w) * 0.015);
  }

  .status-icons svg {
    width: calc(var(--phone-w) * 0.038);
    height: calc(var(--phone-w) * 0.026);
    fill: currentColor;
  }

  .status-icons svg:last-child {
    width: calc(var(--phone-w) * 0.054);
  }

  .status-icons rect:first-child {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .app-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: calc(var(--phone-w) * 0.025);
    padding: calc(var(--phone-w) * 0.015) calc(var(--phone-w) * 0.06) 0;
  }

  .app-head > span {
    display: grid;
    gap: 1px;
  }

  .app-head small {
    color: rgba(238, 234, 226, 0.46);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: calc(var(--phone-w) * 0.015);
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .app-head b {
    font-size: calc(var(--phone-w) * 0.026);
    font-weight: 500;
  }

  .app-head > svg {
    width: calc(var(--phone-w) * 0.05);
    fill: currentColor;
  }

  .album {
    width: 80%;
    aspect-ratio: 1;
    margin: calc(var(--phone-w) * 0.055) auto 0;
    overflow: hidden;
    border: 1px solid rgba(238, 234, 226, 0.2);
    border-radius: calc(var(--phone-w) * 0.016);
    box-shadow: 0 calc(var(--phone-w) * 0.045) calc(var(--phone-w) * 0.09) rgba(10, 7, 13, 0.46);
  }

  .album svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .track {
    display: flex;
    width: 80%;
    align-items: center;
    justify-content: space-between;
    margin: calc(var(--phone-w) * 0.048) auto 0;
  }

  .track > span {
    display: grid;
    gap: 2px;
  }

  .track strong {
    font-size: calc(var(--phone-w) * 0.039);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .track small {
    color: rgba(238, 234, 226, 0.5);
    font-size: calc(var(--phone-w) * 0.025);
  }

  .track svg {
    width: calc(var(--phone-w) * 0.05);
    fill: none;
    stroke: var(--red);
    stroke-width: 1.7;
  }

  .progress {
    display: grid;
    width: 80%;
    gap: calc(var(--phone-w) * 0.012);
    margin: calc(var(--phone-w) * 0.04) auto 0;
  }

  .progress > span {
    position: relative;
    height: 3px;
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.17);
  }

  .progress > span::before {
    content: '';
    display: block;
    width: 43%;
    height: 100%;
    border-radius: inherit;
    background: var(--red);
  }

  .progress i {
    position: absolute;
    top: 50%;
    left: 43%;
    width: calc(var(--phone-w) * 0.018);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .progress div {
    display: flex;
    justify-content: space-between;
    color: rgba(238, 234, 226, 0.4);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: calc(var(--phone-w) * 0.016);
  }

  .progress b {
    font-weight: 500;
  }

  .controls {
    display: flex;
    width: 68%;
    align-items: center;
    justify-content: space-between;
    margin: calc(var(--phone-w) * 0.032) auto 0;
  }

  .controls > svg {
    width: calc(var(--phone-w) * 0.058);
    fill: currentColor;
  }

  .pause {
    display: grid;
    width: calc(var(--phone-w) * 0.135);
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    color: var(--black);
    background: var(--paper);
  }

  .pause svg {
    width: 58%;
    fill: currentColor;
  }

  .offline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--phone-w) * 0.018);
    margin-top: calc(var(--phone-w) * 0.045);
    color: rgba(238, 234, 226, 0.65);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: calc(var(--phone-w) * 0.017);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .offline svg {
    width: calc(var(--phone-w) * 0.04);
    fill: var(--red);
  }

  .offline path {
    fill: none;
    stroke: var(--paper);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .home-indicator {
    position: absolute;
    bottom: calc(var(--phone-w) * 0.018);
    left: 50%;
    width: 34%;
    height: 4px;
    border-radius: 99px;
    background: rgba(238, 234, 226, 0.7);
    transform: translateX(-50%);
  }

  .foot {
    position: absolute;
    z-index: 7;
    right: clamp(20px, 3.4vw, 52px);
    bottom: clamp(17px, 2.6vh, 25px);
    left: clamp(20px, 3.4vw, 52px);
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(125, 0, 25, 0.68);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .foot i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--red);
  }

  .license {
    margin-left: auto;
  }

  @keyframes beam-on {
    from {
      opacity: 0;
      transform: scaleX(0.08);
    }
  }

  @keyframes shadow-in {
    from {
      opacity: 0;
      transform: rotate(3.5deg) scaleX(0.08);
    }
  }

  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translate(-50%, 70px) rotate(0deg);
    }
  }

  @keyframes copy-in {
    from {
      opacity: 0;
      transform: translate(-50%, -10px);
    }
  }

  @media (max-width: 720px) {
    .top {
      top: 54px;
      right: 14px;
      left: 14px;
      gap: 8px;
    }

    .brand {
      gap: 7px;
    }

    .brand :global(svg) {
      width: 32px;
      height: 32px;
    }

    .brand strong {
      font-size: 14px;
    }

    .brand small {
      display: none;
    }

    .actions {
      gap: 6px;
    }

    .store,
    .github {
      min-height: 32px;
      padding: 0 10px;
      font-size: 8px;
    }

    .intro {
      top: 103px;
      width: calc(100% - 26px);
    }

    .eyebrow {
      margin-bottom: 9px;
      font-size: 7px;
      letter-spacing: 0.11em;
    }

    h1 {
      max-width: 10.7em;
      font-size: clamp(31px, 8.9vw, 36px);
      line-height: 0.98;
    }

    .support {
      max-width: 35ch;
      margin-top: 11px;
      font-size: 10px;
