---
import Mark from '../../components/Mark.astro';

const GITHUB_URL = 'https://github.com/thatcube/Mozz';
const headline = 'Mozz is a free player for the music on your server.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Mozz is a free, open source player for music on your Plex, Jellyfin or Navidrome server."
    />
    <meta name="theme-color" content="#fdf6ec" />
    <meta name="robots" content="noindex" />
    <title>Mozz — a free player for your self-hosted music</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,600..900&family=Fragment+Mono:ital@0;1&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="hero">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Mozz home">
          <Mark size={34} decorative />
          <span>Mozz</span>
        </a>

        <p class="category">Self-hosted music player · iPhone + iPad</p>

        <nav class="actions" aria-label="Get Mozz">
          <a href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
          <span class="pending" aria-disabled="true">
            <span class="pending-wide">Coming to the App Store</span>
            <span class="pending-short">App Store soon</span>
          </span>
        </nav>
      </header>

      <section class="composition" aria-labelledby="stack-headline">
        <h1 id="stack-headline" aria-label={headline}>
          <span>Mozz is a</span>
          <span>free player</span>
          <span>for the music</span>
          <span>on your server.</span>
        </h1>

        <div class="sleeves" aria-hidden="true">
          <div class="sleeve sleeve-one">
            <svg viewBox="0 0 240 240">
              <rect width="240" height="240" fill="#191320" />
              <circle cx="168" cy="73" r="68" fill="#eeeae2" />
              <circle cx="168" cy="73" r="42" fill="#d8002d" />
              <circle cx="168" cy="73" r="13" fill="#191320" />
              <path d="M-8 170Q58 113 124 170T256 170V247H-8Z" fill="#7d0019" />
              <path d="M-8 188Q58 131 124 188T256 188" fill="none" stroke="#eeeae2" stroke-width="8" />
              <text x="17" y="27" fill="#eeeae2" font-size="11" letter-spacing="2.7">LOW TIDE</text>
              <text x="18" y="220" fill="#eeeae2" font-size="8" letter-spacing="1.7">FIELD RECORDING 04</text>
            </svg>
          </div>

          <div class="sleeve sleeve-two">
            <svg viewBox="0 0 240 240">
              <rect width="240" height="240" fill="#eeeae2" />
              <rect width="240" height="30" fill="#191320" />
              <rect y="204" width="240" height="36" fill="#d8002d" />
              <path d="M18 42v147M222 42v147" stroke="#7d0019" stroke-width="6" />
              <g>
                <circle cx="120" cy="112" r="58" fill="#d8002d" />
                <path d="M87 88h26v7l-13 13h13v8H87v-7l13-13H87z" fill="#eeeae2" />
                <path d="M127 88h26v7l-13 13h13v8h-26v-7l13-13h-13z" fill="#eeeae2" />
                <path
                  d="M91 126c11 18 47 19 58-1"
                  fill="none"
                  stroke="#eeeae2"
                  stroke-width="9"
                  stroke-linecap="round"
                />
              </g>
              <text x="16" y="229" fill="#eeeae2" font-size="9" letter-spacing="2.2">SLEEP MODE</text>
            </svg>
          </div>

          <div class="sleeve sleeve-three">
            <svg viewBox="0 0 240 240">
              <rect width="240" height="240" fill="#0a070d" />
              <rect x="18" y="18" width="204" height="204" fill="#eeeae2" />
              <path d="M18 18h102v102H18z" fill="#d8002d" />
              <path d="M120 120h102v102H120z" fill="#7d0019" />
              <circle cx="120" cy="120" r="61" fill="#fdf6ec" />
              <circle cx="120" cy="120" r="21" fill="#191320" />
              <path d="M120 59v40M120 141v40M59 120h40M141 120h40" stroke="#191320" stroke-width="8" />
              <text x="29" y="207" fill="#191320" font-size="8" letter-spacing="2.2">TENDER STATIC</text>
            </svg>
          </div>

          <div class="sleeve sleeve-four">
            <svg viewBox="0 0 240 240">
              <rect width="240" height="240" fill="#d8002d" />
              <path d="M0 34h240M0 76h240M0 118h240M0 160h240M0 202h240" stroke="#191320" stroke-width="3" />
              <path d="M0 118h34l14-45 24 92 23-124 25 157 22-103 19 54 18-31h61" fill="none" stroke="#eeeae2" stroke-width="12" stroke-linejoin="bevel" />
              <circle cx="120" cy="118" r="13" fill="#7d0019" />
              <rect x="14" y="14" width="90" height="23" fill="#191320" />
              <text x="22" y="29" fill="#eeeae2" font-size="8" letter-spacing="1.9">SOFT CIRCUITS</text>
              <text x="165" y="226" fill="#191320" font-size="8" letter-spacing="1.3">33:08</text>
            </svg>
          </div>

          <div class="sleeve sleeve-five">
            <svg viewBox="0 0 240 240">
              <rect width="240" height="240" fill="#eeeae2" />
              <circle cx="120" cy="120" r="91" fill="#191320" />
              <path d="M120 29a91 91 0 0 1 91 91h-91z" fill="#d8002d" />
              <path d="M120 211a91 91 0 0 1-91-91h91z" fill="#7d0019" />
              <circle cx="120" cy="120" r="34" fill="#eeeae2" />
              <circle cx="120" cy="120" r="26" fill="#d8002d" />
              <path d="M102 106h14v4l-7 7h7v5h-14v-4l7-7h-7z" fill="#eeeae2" />
              <path d="M124 106h14v4l-7 7h7v5h-14v-4l7-7h-7z" fill="#eeeae2" />
              <path
                d="M105 127c6 9 24 9 30 0"
                fill="none"
                stroke="#eeeae2"
                stroke-width="4.5"
                stroke-linecap="round"
              />
              <text x="16" y="24" fill="#191320" font-size="9" letter-spacing="2.5">NIGHT BUS</text>
              <text x="159" y="227" fill="#191320" font-size="8" letter-spacing="1.4">SIDE A</text>
            </svg>
          </div>
        </div>

        <p class="support">
          Stream from home or download albums for anywhere without a signal.
          No account, no tracking, no subscription.
        </p>
      </section>

      <footer class="footer">
        <p><span>Works with</span> Plex · Jellyfin · Navidrome</p>
        <p>Free forever · GPL-3.0 · Open source</p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --paper: #fdf6ec;
    --soft-white: #eeeae2;
    --red: #d8002d;
    --deep-red: #7d0019;
    --ink: #191320;
    --black: #0a070d;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Spline Sans', 'Avenir Next', system-ui, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--paper);
  }

  .topbar {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 72px;
    margin: 0 2.25vw;
    border-bottom: 2px solid var(--ink);
    font-family: 'Fragment Mono', 'Courier New', monospace;
    font-size: 11px;
    letter-spacing: -0.02em;
  }

  .brand {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 9px;
    font-family: 'Anybody', 'Arial Black', sans-serif;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .category {
    margin: 0;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
  }

  .actions a,
  .pending {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0 13px;
    border: 1.5px solid var(--ink);
  }

  .actions a {
    background: var(--ink);
    color: var(--paper);
    transition: background 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .actions a:hover {
    background: var(--red);
    transform: translateY(-2px);
  }

  .pending {
    border-style: dashed;
    opacity: 0.68;
  }

  .pending-short {
    display: none;
  }

  .actions a:focus-visible,
  .brand:focus-visible {
    outline: 4px solid var(--red);
    outline-offset: 3px;
  }

  .composition {
    position: absolute;
    inset: 88px 2.25vw 82px;
  }

  h1 {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    font-family: 'Anybody', 'Arial Black', sans-serif;
    font-size: clamp(66px, 8.2vw, 126px);
    font-stretch: 108%;
    font-weight: 850;
    line-height: 0.78;
    letter-spacing: -0.068em;
  }

  h1 span {
    display: block;
    width: max-content;
    max-width: 100%;
  }

  h1 span:nth-child(2) {
    color: var(--red);
  }

  h1 span:nth-child(3),
  h1 span:nth-child(4) {
    margin-left: 6.8vw;
  }

  .sleeves {
    position: absolute;
    z-index: 5;
    top: 49%;
    right: 5vw;
    width: min(64vw, 900px);
    height: min(36vw, 460px);
    pointer-events: none;
  }

  .sleeve {
    --r: 0deg;
    position: absolute;
    width: clamp(126px, 15.3vw, 220px);
    aspect-ratio: 1;
    overflow: hidden;
    border: clamp(2px, 0.22vw, 4px) solid var(--ink);
    background: var(--paper);
    box-shadow: clamp(5px, 0.7vw, 11px) clamp(6px, 0.8vw, 13px) 0 rgb(25 19 32 / 20%);
    transform: rotate(var(--r));
    transform-origin: 50% 90%;
    animation: deal-in 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .sleeve svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: 'Fragment Mono', 'Courier New', monospace;
  }

  .sleeve-one {
    --r: -10deg;
    top: 25%;
    left: 0;
    animation-delay: 40ms;
  }

  .sleeve-two {
    --r: -4deg;
    z-index: 2;
    top: 5%;
    left: 18%;
    animation-delay: 100ms;
  }

  .sleeve-three {
    --r: 2deg;
    z-index: 4;
    top: 19%;
    left: 38%;
    animation-delay: 160ms;
  }

  .sleeve-four {
    --r: 8deg;
    z-index: 3;
    top: 0;
    left: 58%;
    animation-delay: 220ms;
  }

  .sleeve-five {
    --r: 14deg;
    z-index: 1;
    top: 29%;
    left: 78%;
    animation-delay: 280ms;
  }

  .support {
    position: absolute;
    z-index: 8;
    bottom: 39%;
    left: 0;
    max-width: 49ch;
    margin: 0;
    font-size: clamp(13px, 1.05vw, 16px);
    line-height: 1.45;
  }

  .footer {
    position: absolute;
    z-index: 20;
    right: 2.25vw;
    bottom: 0;
    left: 2.25vw;
    display: flex;
    min-height: 63px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 2px solid var(--ink);
    font-family: 'Fragment Mono', 'Courier New', monospace;
    font-size: clamp(9px, 0.78vw, 11px);
    letter-spacing: -0.025em;
  }

  .footer p {
    margin: 0;
  }

  .footer p:first-child {
    font-size: clamp(10px, 0.9vw, 13px);
  }

  .footer p:first-child span {
    color: var(--red);
  }

  @keyframes deal-in {
    from {
      opacity: 0;
      transform: translateY(70px) rotate(0deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(var(--r)) scale(1);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 620px;
    }

    .topbar {
      grid-template-columns: 1fr auto;
      min-height: 62px;
      margin-inline: 15px;
    }

    .category {
      display: none;
    }

    .brand {
      gap: 7px;
      font-size: 18px;
    }

    .actions {
      gap: 6px;
      font-size: 9px;
    }

    .actions a,
    .pending {
      min-height: 32px;
      padding-inline: 9px;
    }

    .pending-wide {
      display: none;
    }

    .pending-short {
      display: inline;
    }

    .composition {
      inset: 76px 15px 78px;
    }

    h1 {
      font-size: clamp(44px, 12.7vw, 61px);
      line-height: 0.84;
      letter-spacing: -0.066em;
    }

    h1 span:nth-child(3),
    h1 span:nth-child(4) {
      margin-left: 0;
    }

    .sleeves {
      top: 35%;
      right: -7px;
      width: calc(100% + 8px);
      height: 220px;
    }

    .sleeve {
      width: 34.5vw;
      max-width: 145px;
      border-width: 2px;
      box-shadow: 5px 6px 0 rgb(25 19 32 / 20%);
    }

    .sleeve-one {
      top: 27%;
      left: -3%;
    }

    .sleeve-two {
      top: 3%;
      left: 16%;
    }

    .sleeve-three {
      top: 23%;
      left: 35%;
    }

    .sleeve-four {
      top: 0;
      left: 54%;
    }

    .sleeve-five {
      top: 29%;
      left: 72%;
    }

    .support {
      bottom: 62px;
      max-width: 37ch;
      font-size: 12.5px;
      line-height: 1.4;
    }

    .footer {
      right: 15px;
      left: 15px;
      min-height: 65px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 4px;
      font-size: 8.7px;
    }

    .footer p:first-child {
      font-size: 10px;
    }
  }

  @media (max-height: 700px) {
    .composition {
      inset-block: 76px 68px;
    }

    h1 {
      font-size: clamp(48px, 7.5vw, 104px);
    }

    .sleeves {
      top: 27%;
      transform: scale(0.86);
      transform-origin: right center;
    }

    .footer {
      min-height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sleeve {
      animation: none;
    }

    .actions a {
      transition: none;
    }
  }
</style>
