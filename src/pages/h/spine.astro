---
/**
 * Spine — the gap in the shelf is the layout.
 *
 * The whole frame is a rack of records seen edge-on: spines packed tight,
 * vertical type, a shelf board underneath. One record has been pulled, and the
 * empty slot it left is where the page actually lives. The record itself is
 * leaning against the right-hand side of the gap, in red, with MOZZ on it.
 *
 * On a wide screen more of the collection simply comes into view — the spines
 * overflow rather than stretch, which is how a shelf behaves.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

/** Invented spines. Tone, width in units, and what is printed on the edge. */
const LEFT = [
  { w: 1.5, tone: '#221c29', ink: '#e9e2d5', text: 'Corner Signal — Long Way Down' },
  { w: 1.1, tone: '#e4dcce', ink: '#1a1620', text: 'Quiet Hours' },
  { w: 1.9, tone: '#12101a', ink: '#cfc6b6', text: 'The Fifth Room — Anthology' },
  { w: 1.2, tone: '#2d2634', ink: '#e9e2d5', text: 'Pale Machine' },
  { w: 1.0, tone: '#d8d0c0', ink: '#1a1620', text: 'Slow Tape' },
  { w: 1.6, tone: '#191521', ink: '#e9e2d5', text: 'Marrow — Second Shadow' },
  { w: 1.1, tone: '#3a3243', ink: '#e9e2d5', text: 'Northbound' },
  { w: 1.4, tone: '#ece5d8', ink: '#1a1620', text: 'Halo North — Nightside' },
  { w: 1.2, tone: '#141019', ink: '#cfc6b6', text: 'Static Garden' },
  { w: 1.7, tone: '#262030', ink: '#e9e2d5', text: 'Common Weather — Volume II' },
  { w: 1.3, tone: '#e0d8c8', ink: '#1a1620', text: 'Copper Lane' },
  { w: 1.1, tone: '#1d1826', ink: '#e9e2d5', text: 'Ash & Amber' },
  { w: 1.6, tone: '#2f2839', ink: '#e9e2d5', text: 'Winter Palace — Sessions' },
  { w: 1.0, tone: '#131019', ink: '#cfc6b6', text: 'Low Beam' },
  { w: 1.4, tone: '#e7e0d2', ink: '#1a1620', text: 'The Silent Type' },
  { w: 1.2, tone: '#1a1522', ink: '#e9e2d5', text: 'Harbour Light' },
];

const RIGHT = [
  { w: 1.3, tone: '#171320', ink: '#e9e2d5', text: 'Ledger — Blue Hour' },
  { w: 1.1, tone: '#e4dcce', ink: '#1a1620', text: 'Field Notes' },
  { w: 1.8, tone: '#2a2333', ink: '#e9e2d5', text: 'Ivory Coast Radio — Live' },
  { w: 1.2, tone: '#100e16', ink: '#cfc6b6', text: 'Undertow' },
  { w: 1.5, tone: '#dcd4c4', ink: '#1a1620', text: 'Small Hours Quartet' },
  { w: 1.1, tone: '#211b28', ink: '#e9e2d5', text: 'Paper Lantern' },
  { w: 1.6, tone: '#15111c', ink: '#e9e2d5', text: 'Rivermouth — Collected' },
  { w: 1.2, tone: '#332c3c', ink: '#e9e2d5', text: 'Dust & Glass' },
  { w: 1.4, tone: '#eae3d6', ink: '#1a1620', text: 'The Long Player' },
  { w: 1.1, tone: '#191521', ink: '#cfc6b6', text: 'Tin Roof' },
  { w: 1.5, tone: '#2c2535', ink: '#e9e2d5', text: 'Brass Cathedral — Live' },
  { w: 1.0, tone: '#e2dacb', ink: '#1a1620', text: 'Nine Rooms' },
  { w: 1.3, tone: '#141119', ink: '#cfc6b6', text: 'Grey Market' },
  { w: 1.7, tone: '#241e2c', ink: '#e9e2d5', text: 'The Wire Chorus — Retrospect' },
  { w: 1.1, tone: '#e8e1d4', ink: '#1a1620', text: 'Salt Flats' },
  { w: 1.4, tone: '#181420', ink: '#e9e2d5', text: 'Afterhours — Anthology' },
];

const SERVERS = ['Plex', 'Jellyfin', 'Navidrome'];
---

<Layout
  title={`${NAME} — a free player for the music on your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Navidrome server you already run, listen at home, or download an album and play it offline."
  themeColor="#efe9dc"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="spine" />

  <main class="rack">
    <div class="shelf">
      <div class="side left" aria-hidden="true">
        {
          LEFT.map((rec) => (
            <span class="rec" style={`--w:${rec.w};--tone:${rec.tone};--ink:${rec.ink}`}>
              <i />
              <b>{rec.text}</b>
            </span>
          ))
        }
      </div>

      <section class="slot">
        <!-- The record that came out of the gap, resting against the stack. -->
        <span
          class="rec pulled"
          role="img"
          aria-label="A red record spine reading Mozz, leaning in the empty slot."
        >
          <i></i>
          <b>MOZZ<em> &mdash; your music, your server</em></b>
        </span>

        <header class="brow">
          <span class="lockup">
            <Mark size={22} decorative />
            <b>Mozz</b>
          </span>
          <span>self&#8209;hosted music player</span>
        </header>

        <h1>Mozz is a free player for the music on your <em>own</em> server.</h1>

        <p class="sup">
          The collection is already yours. Point Mozz at the Plex, Jellyfin or
          Navidrome server you run, stream it at home, or take a record with you
          and play it with no signal at all.
        </p>

        <p class="works">
          {SERVERS.map((server) => <b>{server}</b>)}
        </p>

        <div class="acts">
          <a class="btn go" href={GITHUB_URL}>Source on GitHub</a>
          {
            APP_STORE_URL ? (
              <a class="btn wait" href={APP_STORE_URL}>
                Download on the App Store
              </a>
            ) : (
              <span class="btn wait" aria-disabled="true">
                Coming to the App Store
              </span>
            )
          }
        </div>

        <p class="fine">free forever &middot; gpl&#8209;3.0 &middot; no account, no tracking</p>
      </section>

      <div class="side right">
        {
          RIGHT.map((rec) => (
            <span class="rec" aria-hidden="true" style={`--w:${rec.w};--tone:${rec.tone};--ink:${rec.ink}`}>
              <i />
              <b>{rec.text}</b>
            </span>
          ))
        }
      </div>
    </div>

    <div class="board" aria-hidden="true"></div>
  </main>
</Layout>

<style is:global>
  body {
    background: #efe9dc;
  }
</style>

<style>
  .rack {
    --paper: #efe9dc;
    --ink: #16131a;
    --soft: #6d685f;
    --red: #d8002d;
    --unit: clamp(17px, 1.95vw, 32px);

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    /* The backboard is in shadow at the edges; the empty slot catches light. */
    background:
      radial-gradient(120% 90% at 50% 42%, #f6f1e6, var(--paper) 58%, #ded6c6 100%);
    color: var(--ink);
    font-family: 'Archivo', 'Helvetica Neue', system-ui, sans-serif;
  }

  .shelf {
    display: flex;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
  }

  .side {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .left {
    justify-content: flex-end;
  }

  /* ---- one record --------------------------------------------------------- */

  .rec {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    width: calc(var(--unit) * var(--w, 1.2));
    padding: clamp(16px, 3vh, 30px) 0 clamp(12px, 2.2vh, 22px);
    /* Tone and ink arrive per record as inline custom properties. */
    background: var(--tone, #1a1620);
    color: var(--ink);
    box-shadow:
      inset -1px 0 0 rgba(0, 0, 0, 0.34),
      inset 1px 0 0 rgba(255, 255, 255, 0.07);
  }

  /* The printed band every spine seems to have. */
  .rec i {
    display: block;
    width: 62%;
    height: 3px;
    margin-bottom: clamp(10px, 1.8vh, 18px);
    background: currentColor;
    opacity: 0.55;
  }

  .rec b {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    writing-mode: vertical-rl;
    font-size: clamp(8px, 0.66vw, 10.5px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ---- the one that was pulled -------------------------------------------- */

  .pulled {
    --w: 2.4;
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    height: 100%;
    /* Bottom edge in the gap, top edge resting on the records beside it. */
    transform-origin: bottom left;
    transform: rotate(4.8deg);
    background: var(--red);
    color: #fff2f4;
    box-shadow:
      18px 26px 44px -18px rgba(22, 19, 26, 0.55),
      inset -1px 0 0 rgba(0, 0, 0, 0.3),
      inset 1px 0 0 rgba(255, 255, 255, 0.28);
  }

  .pulled b {
    font-size: clamp(9.5px, 0.78vw, 12.5px);
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .pulled i {
    opacity: 0.9;
  }

  .pulled em {
    font-style: normal;
  }

  /* ---- the gap ------------------------------------------------------------ */

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    flex: 0 1 min(46rem, 48%);
    min-width: 0;
    padding: max(56px, 6vh) clamp(76px, 8vw, 128px) clamp(20px, 3vh, 34px)
      clamp(22px, 3vw, 52px);
    box-shadow:
      inset 22px 0 34px -26px rgba(22, 19, 26, 0.6),
      inset -22px 0 34px -26px rgba(22, 19, 26, 0.6);
  }

  .brow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1rem;
    font-size: clamp(9px, 0.72vw, 10.5px);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--ink);
  }

  h1 {
    margin-top: clamp(0.9rem, 2.6vh, 1.7rem);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(28px, min(3.4vw, 5.6vh), 54px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--red);
  }

  .sup {
    max-width: 42ch;
    margin-top: clamp(0.8rem, 2vh, 1.2rem);
    font-size: clamp(12.5px, 0.95vw, 15px);
    line-height: 1.55;
    color: #4a463f;
    text-wrap: pretty;
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: clamp(0.8rem, 2vh, 1.2rem);
  }

  .works b {
    padding: 0.28rem 0.64rem;
    border: 1px solid rgba(22, 19, 26, 0.24);
    border-radius: 999px;
    font-size: clamp(11px, 0.86vw, 12.5px);
    font-weight: 600;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(0.9rem, 2.4vh, 1.4rem);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    font-size: clamp(12px, 0.88vw, 13.5px);
    font-weight: 700;
    white-space: nowrap;
  }

  .go {
    background: var(--red);
    color: #fff;
    transition: background 160ms ease;
  }

  .go:hover {
    background: #a80020;
  }

  .wait {
    border: 1.5px dashed rgba(22, 19, 26, 0.34);
    color: #4f4a44;
  }

  .fine {
    margin-top: clamp(0.8rem, 2vh, 1.2rem);
    font-size: clamp(9px, 0.7vw, 10.5px);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--soft);
  }

  /* ---- the shelf board ---------------------------------------------------- */

  .board {
    flex: none;
    height: clamp(14px, 2.2vh, 26px);
    background: linear-gradient(180deg, #241e2b, #16131a 40%, #0d0b11);
    box-shadow:
      0 -1px 0 rgba(255, 255, 255, 0.14) inset,
      0 -20px 30px -22px rgba(22, 19, 26, 0.7);
  }

  a:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  /* ---- narrow ------------------------------------------------------------- */

  @media (max-width: 62rem) {
    .rack {
      --unit: clamp(14px, 3.6vw, 24px);
    }

    .slot {
      flex: 1 1 auto;
      padding-left: clamp(18px, 4vw, 30px);
      padding-right: clamp(58px, 15vw, 92px);
    }

    h1 {
      font-size: clamp(28px, min(6.4vw, 5.4vh), 40px);
    }
  }

  @media (max-width: 40rem) {
    .rack {
      --unit: 15px;
    }

    .slot {
      padding-top: max(52px, 6vh);
    }

    .sup {
      max-width: 34ch;
      font-size: 13px;
    }

    /* Leaning right would carry the top of the record off the screen at this
       width, so on a phone it tips into the gap instead. */
    .pulled {
      --w: 2.5;
      transform-origin: bottom right;
      transform: rotate(-3.4deg);
    }

    /* A narrow spine only has room for the name. */
    .pulled em {
      display: none;
    }

    .left .rec:nth-last-child(n + 3),
    .right .rec:nth-child(n + 3) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .go {
      transition: none;
    }
  }
</style>
