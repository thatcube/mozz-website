---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { HERO_COPY } from '../../data/hero-copy';
import {
  APP_STORE_URL,
  NAME,
  SERVERS,
} from '../../data/site';

const TICKS = Array.from({ length: 21 }, (_, index) => ({
  angle: -82 + index * 8.2,
  major: index % 5 === 0,
}));

const DIAL_MODES = ['Radio', 'Mozz Weekly', 'Offline'];
---

<Layout
  title={`${NAME} — a free player for Plex, Jellyfin and Navidrome`}
  description="A free, open source iPhone and iPad music player for your own Plex, Jellyfin, Navidrome and Subsonic library — streaming or offline."
  themeColor="#f7f7f3"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="dial" />

  <main class="dial-hero">
    <figure class="dial-stage" aria-labelledby="dial-title dial-caption">
      <svg
        class="dial-svg dial-svg--wide"
        viewBox="0 0 1600 920"
        aria-hidden="true"
      >
        <path class="arc" pathLength="1" d="M120 790A680 680 0 0 1 1480 790" />
        <g class="ticks">
          {TICKS.map(({ angle, major }) => (
            <line
              class:list={['tick', { 'tick--major': major }]}
              x1="800"
              y1={major ? 76 : 88}
              x2="800"
              y2="108"
              transform={`rotate(${angle} 800 790)`}
            />
          ))}
        </g>
        <path class="needle" pathLength="1" d="M800 790L1105 194" />
        <g class="music-note" transform="translate(1105 194)">
          <path d="M7-25v22M7-25l16-4v6L7-19" />
          <ellipse cx="0" cy="-1" rx="7" ry="5" transform="rotate(-12 0 -1)" />
        </g>
      </svg>

      <svg
        class="dial-svg dial-svg--narrow"
        viewBox="0 0 430 850"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <path class="arc" pathLength="1" d="M464 94A330 330 0 0 0 464 756" />
        <g class="mobile-ticks">
          <path d="M440 96l-4-22M358 112l-9-20M284 150l-13-18M223 207l-18-13" />
          <path d="M179 276l-21-8M151 353l-22-3M140 434h-22M153 514l-22 4" />
          <path d="M184 590l-21 9M231 657l-17 14M294 710l-12 19M370 744l-7 21" />
        </g>
        <path class="needle" pathLength="1" d="M464 425L197 196" />
        <g class="music-note" transform="translate(197 196)">
          <path d="M6-21v19M6-21l14-3v5L6-16" />
          <ellipse cx="0" cy="0" rx="6" ry="4.5" transform="rotate(-12 0 0)" />
        </g>
      </svg>

      {SERVERS.map((server) => (
        <div class={`source source--${server.name.toLowerCase()}`}>
          <ServerLogo name={server.name} size={27} />
          <span>{server.name}</span>
        </div>
      ))}

      {DIAL_MODES.map((mode, index) => (
        <div class={`mode mode--${index + 1}`}>
          <span aria-hidden="true"></span>
          {mode}
        </div>
      ))}

      <div class="copy">
        <div class="lockup">
          <Mark size={38} decorative />
          <span>{NAME}</span>
        </div>

        <p class="eyebrow">Music player for iPhone and iPad</p>
        <h1 id="dial-title">{HERO_COPY.headline}</h1>
        <p class="lede">{HERO_COPY.body}</p>

        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
            </svg>
            <span><small>Download on the</small>App Store</span>
          </a>
        ) : (
          <span class="store store--pending" aria-disabled="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
            </svg>
            <span><small>Coming to the</small>App Store</span>
          </span>
        )}
        <p class="principles">{HERO_COPY.support}</p>
      </div>

      <figcaption id="dial-caption" class="visually-hidden">
        A spare tuning dial shows Mozz compatibility with Plex, Jellyfin and
        Navidrome, with radio, Mozz Weekly and offline listening marked along
        the scale.
      </figcaption>
    </figure>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f7f7f3;
  }

  :global(body) {
    min-width: 320px;
    overflow-x: hidden;
    background: #f7f7f3;
  }

  .dial-hero {
    --paper: #f7f7f3;
    --ink: #17201f;
    --muted: #66706c;
    --line: #c8ceca;
    --signal: #2c4d53;
    --red: #c80028;
    display: grid;
    min-height: 100svh;
    padding-top: 42px;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(circle at 50% 91%, rgba(44, 77, 83, 0.035), transparent 28%),
      var(--paper);
    font-family: 'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif;
  }

  .dial-stage {
    position: relative;
    align-self: center;
    width: min(100%, calc((100svh - 42px) * 1.739), 1600px);
    aspect-ratio: 40 / 23;
    margin: 0 auto;
  }

  .dial-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dial-svg--narrow {
    display: none;
  }

  .arc,
  .tick,
  .mobile-ticks path {
    fill: none;
    stroke: var(--line);
    vector-effect: non-scaling-stroke;
  }

  .arc {
    stroke-width: 1.35;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trace 1.2s cubic-bezier(.22, .75, .23, 1) .08s forwards;
  }

  .tick {
    stroke-width: 1;
  }

  .tick--major {
    stroke: #919b96;
  }

  .ticks {
    opacity: 0;
    animation: appear .7s ease .72s forwards;
  }

  .needle {
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
    animation: trace .85s cubic-bezier(.33, 1, .68, 1) .7s forwards;
  }

  .music-note {
    opacity: 0;
    animation: appear .4s ease 1.35s forwards;
  }

  .music-note path {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.75;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .music-note ellipse {
    fill: var(--red);
  }

  .source,
  .mode {
    position: absolute;
    z-index: 1;
    font: 500 clamp(.58rem, .68vw, .72rem)/1 'IBM Plex Mono', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .source {
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .4rem .48rem;
    color: var(--ink);
    background: var(--paper);
    opacity: 0;
    animation: appear .5s ease forwards;
  }

  .source :global(.server-logo) {
    width: clamp(20px, 1.7vw, 27px);
    height: clamp(20px, 1.7vw, 27px);
  }

  .source--plex {
    top: 50.2%;
    left: 9.5%;
    animation-delay: .82s;
  }

  .source--jellyfin {
    top: 12%;
    left: 34.5%;
    animation-delay: .92s;
  }

  .source--navidrome {
    top: 40%;
    right: 8%;
    animation-delay: 1.02s;
  }

  .mode {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: var(--muted);
  }

  .mode span {
    display: block;
    width: 8px;
    height: 1px;
    background: #9ca49f;
  }

  .mode--1 {
    top: 31%;
    left: 17.5%;
  }

  .mode--2 {
    top: 8.8%;
    right: 38.5%;
  }

  .mode--3 {
    top: 24.8%;
    right: 20.2%;
  }

  .copy {
    position: absolute;
    z-index: 2;
    top: 51%;
    left: 50%;
    width: min(39%, 610px);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: clamp(1rem, 2.4vh, 1.45rem);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -.03em;
  }

  .eyebrow {
    margin: 0 0 .85rem;
    color: var(--signal);
    font: 500 .68rem/1.2 'IBM Plex Mono', monospace;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12em;
    margin: 0 auto;
    font-size: clamp(2.8rem, 4.7vw, 5rem);
    font-weight: 600;
    line-height: .96;
    letter-spacing: -.065em;
    text-wrap: balance;
  }

  .lede {
    max-width: 40rem;
    margin: clamp(.9rem, 2.2vh, 1.35rem) auto 0;
    color: var(--muted);
    font-size: clamp(.88rem, 1.05vw, 1rem);
    line-height: 1.55;
    text-wrap: balance;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    min-height: 51px;
    margin-top: clamp(1rem, 2.4vh, 1.4rem);
    padding: .55rem 1.05rem;
    color: #fff;
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    box-shadow: none;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-align: left;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  a.store:hover {
    color: #fff;
    background: var(--red);
    border-color: var(--red);
    transform: translateY(-1px);
  }

  a.store:focus-visible {
    outline: 3px solid rgba(200, 0, 40, .28);
    outline-offset: 4px;
  }

  .store svg {
    width: 23px;
    height: 23px;
    fill: currentColor;
  }

  .store small {
    display: block;
    margin-bottom: .18rem;
    font-size: .58rem;
    font-weight: 500;
    letter-spacing: .04em;
  }

  .store--pending {
    color: var(--muted);
    background: var(--paper);
    border-color: var(--line);
    box-shadow: none;
  }

  .principles {
    margin: .8rem 0 0;
    color: #7f8884;
    font: 500 .65rem/1.5 'IBM Plex Mono', monospace;
    letter-spacing: .02em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes trace {
    to { stroke-dashoffset: 0; }
  }

  @keyframes appear {
    to { opacity: 1; }
  }

  @media (max-width: 720px) {
    .dial-hero {
      min-height: max(760px, 100svh);
    }

    .dial-stage {
      align-self: stretch;
      width: 100%;
      min-height: 718px;
      aspect-ratio: auto;
    }

    .dial-svg--wide {
      display: none;
    }

    .dial-svg--narrow {
      display: block;
    }

    .mobile-ticks path {
      stroke-width: 1;
    }

    .copy {
      top: 51%;
      left: 52%;
      width: min(78%, 360px);
    }

    .lockup {
      margin-bottom: .9rem;
    }

    .eyebrow {
      margin-bottom: .7rem;
    }

    h1 {
      font-size: clamp(2.55rem, 11.8vw, 3.55rem);
    }

    .lede {
      max-width: 19rem;
      margin-top: .85rem;
      font-size: .83rem;
      line-height: 1.48;
    }

    .store {
      min-height: 48px;
      margin-top: 1rem;
    }

    .source {
      gap: .38rem;
      padding: .32rem;
      font-size: .55rem;
    }

    .source--plex {
      top: 5.5%;
      left: auto;
      right: 6%;
    }

    .source--jellyfin {
      top: 33%;
      left: 22%;
    }

    .source--navidrome {
      top: 82%;
      right: 8%;
    }

    .mode {
      font-size: .5rem;
    }

    .mode--1 {
      top: 18%;
      left: 43%;
    }

    .mode--2 {
      top: 63%;
      right: auto;
      left: 23%;
    }

    .mode--3 {
      top: 75%;
      right: 14%;
    }
  }

  @media (max-width: 380px) {
    .copy {
      width: 82%;
    }

    .lede {
      font-size: .78rem;
    }

    .mode--2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc,
    .ticks,
    .needle,
    .music-note,
    .source {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }

    .store {
      transition: none;
    }
  }
</style>
