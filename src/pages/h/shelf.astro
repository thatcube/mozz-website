---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { APP_STORE_URL } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';
---

<Layout
  title="Mozz — a free player for your self-hosted music"
  description={HERO_COPY.body}
  themeColor="#f5f7f4"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="shelf" />

  <main>
    <header class="intro">
      <div class="wordmark" aria-label="Mozz">
        <Mark size={40} decorative />
        <span>Mozz</span>
      </div>
      <h1>{HERO_COPY.headline}</h1>
      <p class="lede">{HERO_COPY.body}</p>
    </header>

    <figure class="shelf-scene">
      <div class="shelf" aria-hidden="true">
        <div class="spines">
          <i style="--w:19px;--h:70px;--c:#e16b58"></i>
          <i style="--w:12px;--h:87px;--c:#eab659"></i>
          <i style="--w:22px;--h:61px;--c:#6f9f91"></i>
          <i style="--w:14px;--h:95px;--c:#b66885"></i>
          <i class="quiet" style="--w:10px;--h:55px;--c:#9ab1bd"></i>
          <i style="--w:24px;--h:77px;--c:#d58b49"></i>
          <i class="playing" style="--w:16px;--h:82px;--c:#c80028"></i>
          <i style="--w:13px;--h:65px;--c:#7188b0"></i>
          <i style="--w:20px;--h:91px;--c:#df835e"></i>
          <i class="quiet" style="--w:11px;--h:52px;--c:#86a189"></i>
          <i style="--w:17px;--h:75px;--c:#c7a04e"></i>
          <i style="--w:13px;--h:58px;--c:#c66f72"></i>
          <i style="--w:23px;--h:86px;--c:#789aab"></i>
          <i class="weekly-spine" style="--w:16px;--h:68px;--c:#d43b58"></i>
          <i style="--w:11px;--h:78px;--c:#7f9c72"></i>
        </div>

        <div class="rail"></div>

        <div class="source source-plex">
          <ServerLogo name="Plex" size={25} brand />
          <small>Plex</small>
        </div>
        <div class="source source-jellyfin">
          <ServerLogo name="Jellyfin" size={25} brand />
          <small>Jellyfin</small>
        </div>
        <div class="source source-navidrome">
          <ServerLogo name="Navidrome" size={25} brand />
          <small>Navidrome</small>
        </div>

        <div class="player">
          <div class="player-face">
            <Mark size={34} decorative />
            <span><b>MOZZ PLAYER</b> now playing</span>
          </div>
          <i class="needle"></i>
        </div>

        <div class="offline-path"></div>
        <div class="offline-pocket">
          <i></i>
          <span>offline</span>
        </div>

        <div class="radio-path">
          <i></i><i></i><i></i>
          <span>radio</span>
        </div>

        <div class="weekly-note">
          <span>new</span>
          Mozz Weekly
        </div>
      </div>
      <figcaption>
        Mozz playing music from a shelf, with Plex, Jellyfin, and Navidrome
        shown as compatible servers.
      </figcaption>
    </figure>

    <footer class="close">
      <p>{HERO_COPY.support}</p>
      {
        APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>
            <span>Download on the</span>
            <strong>App Store</strong>
          </a>
        ) : (
          <span
            class="store store-pending"
            role="status"
            aria-label="Download on the App Store — coming soon"
          >
            <span>Download on the</span>
            <strong>App Store</strong>
            <b>Coming soon</b>
          </span>
        )
      }
    </footer>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f5f7f4;
  }

  :global(body) {
    margin: 0;
    color: #202524;
    background:
      radial-gradient(circle at 50% 54%, rgba(255, 255, 255, 0.94) 0 19rem, transparent 38rem),
      #f5f7f4;
    font-family: 'Bricolage Grotesque', 'Avenir Next', sans-serif;
  }

  main {
    --red: #c80028;
    --ink: #202524;
    --muted: #68706d;
    --line: #adb5b1;
    display: grid;
    grid-template-rows: auto minmax(290px, 1fr) auto;
    min-height: 100svh;
    padding-top: 42px;
    overflow: clip;
  }

  .intro {
    position: relative;
    z-index: 2;
    width: min(780px, calc(100% - 2rem));
    margin: 0 auto;
    padding-top: clamp(1.8rem, 5vh, 4.5rem);
    text-align: center;
  }

  .wordmark {
    position: absolute;
    top: clamp(1.6rem, 4.5vh, 4.2rem);
    left: max(-7rem, calc((100vw - 780px) / -2 + 1.2rem));
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-stretch: 86%;
    font-weight: 580;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .lede {
    max-width: 580px;
    margin: clamp(1rem, 2.5vh, 1.55rem) auto 0;
    color: var(--muted);
    font-size: clamp(0.92rem, 1.25vw, 1.08rem);
    line-height: 1.45;
    text-wrap: balance;
  }

  .shelf-scene {
    position: relative;
    width: 100%;
    min-height: 290px;
    margin: 0;
  }

  .shelf {
    position: absolute;
    inset: 0;
  }

  .rail {
    position: absolute;
    top: 54%;
    left: 2.5vw;
    width: 95vw;
    height: 7px;
    background: #7c8581;
    border-radius: 2px;
    box-shadow:
      0 2px 0 #fff,
      0 7px 0 rgba(41, 48, 45, 0.1);
  }

  .rail::before,
  .rail::after {
    position: absolute;
    top: -5px;
    width: 3px;
    height: 17px;
    content: '';
    background: #69716e;
    border-radius: 2px;
  }

  .rail::before { left: 0; }
  .rail::after { right: 0; }

  .spines {
    position: absolute;
    top: calc(54% - 104px);
    right: 8vw;
    left: 8vw;
    display: flex;
    align-items: end;
    justify-content: space-around;
    height: 104px;
    padding: 0 1.5rem;
  }

  .spines i {
    position: relative;
    display: block;
    width: var(--w);
    height: var(--h);
    background: var(--c);
    border-radius: 2px 2px 0 0;
    box-shadow:
      inset 3px 0 rgba(255, 255, 255, 0.22),
      inset -2px 0 rgba(30, 38, 34, 0.1);
  }

  .spines i::after {
    position: absolute;
    top: 9px;
    right: 3px;
    left: 3px;
    height: 1px;
    content: '';
    background: rgba(255, 255, 255, 0.62);
  }

  .spines .quiet { opacity: 0.72; }

  .spines .playing {
    box-shadow:
      inset 3px 0 rgba(255, 255, 255, 0.25),
      0 -3px 0 1px #fff,
      0 -4px 0 1px rgba(200, 0, 40, 0.68);
  }

  .weekly-spine {
    transform: translateY(-11px);
  }

  .weekly-spine::before {
    position: absolute;
    inset: -4px -4px -15px;
    z-index: -1;
    content: '';
    border: 1px dashed rgba(200, 0, 40, 0.35);
    border-radius: 3px;
  }

  .source {
    position: absolute;
    top: calc(54% - 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 70px;
    gap: 0.35rem;
    color: #53605b;
    background: rgba(245, 247, 244, 0.88);
    border-right: 3px solid #89918d;
    border-bottom: 3px solid #89918d;
    border-radius: 0 0 3px;
  }

  .source small {
    color: #7a827e;
    font: 500 0.48rem/1 'IBM Plex Mono', monospace;
    letter-spacing: -0.04em;
  }

  .source-plex { left: 4vw; }
  .source-jellyfin { left: 35.5vw; }
  .source-navidrome { right: 4vw; }

  .player {
    position: absolute;
    top: calc(54% - 160px);
    left: calc(50% - 49px);
    z-index: 4;
    width: 98px;
    height: 65px;
    animation: seek 7s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
  }

  .player-face {
    display: flex;
    align-items: center;
    width: 98px;
    height: 58px;
    padding: 0 0.65rem;
    gap: 0.55rem;
    color: #303633;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #b7bfbb;
    border-radius: 18px;
    box-shadow: 0 8px 20px rgba(60, 70, 65, 0.08);
  }

  .player-face span {
    font: 500 0.51rem/1.25 'IBM Plex Mono', monospace;
    white-space: nowrap;
  }

  .player-face b {
    display: block;
    margin-bottom: 0.18rem;
    color: var(--red);
    font-size: 0.44rem;
    letter-spacing: 0.12em;
  }

  .needle {
    position: absolute;
    top: 58px;
    left: 10px;
    width: 2px;
    height: 14px;
    background: #454c49;
    transform: rotate(-6deg);
    transform-origin: top;
  }

  .needle::after {
    position: absolute;
    bottom: -3px;
    left: -3px;
    width: 8px;
    height: 8px;
    content: '';
    background: var(--red);
    border-radius: 50%;
  }

  .offline-path {
    position: absolute;
    top: calc(54% + 7px);
    left: 25%;
    width: 1px;
    height: 38px;
    border-left: 1px dashed #92a09a;
  }

  .offline-pocket {
    position: absolute;
    top: calc(54% + 39px);
    left: calc(25% - 23px);
    width: 47px;
    height: 40px;
    border: 2px solid #8b9691;
    border-top: 0;
    border-radius: 0 0 12px 12px;
  }

  .offline-pocket i {
    position: absolute;
    bottom: 8px;
    left: 16px;
    width: 12px;
    height: 44px;
    background: #eab659;
    border-radius: 2px 2px 0 0;
    box-shadow: inset 3px 0 rgba(255, 255, 255, 0.3);
  }

  .offline-pocket span {
    position: absolute;
    top: 46px;
    left: 50%;
    color: #77817c;
    font: 500 0.52rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .radio-path {
    position: absolute;
    top: calc(54% + 4px);
    left: 58%;
    width: 104px;
    height: 45px;
    border-bottom: 1px solid #9ba7a1;
    border-left: 1px solid #9ba7a1;
    border-radius: 0 0 0 30px;
  }

  .radio-path i {
    position: absolute;
    bottom: -3px;
    width: 5px;
    height: 5px;
    background: #6f9f91;
    border-radius: 50%;
  }

  .radio-path i:nth-child(1) { left: 35%; }
  .radio-path i:nth-child(2) { left: 62%; }
  .radio-path i:nth-child(3) { right: 0; }

  .radio-path span,
  .weekly-note {
    color: #77817c;
    font: 500 0.52rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .radio-path span {
    position: absolute;
    top: 52px;
    right: 0;
  }

  .weekly-note {
    position: absolute;
    top: calc(54% - 136px);
    left: 78%;
    text-align: center;
    transform: translateX(-50%);
  }

  .weekly-note::after {
    display: block;
    width: 1px;
    height: 20px;
    margin: 6px auto 0;
    content: '';
    background: #bdc3c0;
  }

  .weekly-note span {
    display: block;
    margin-bottom: 0.24rem;
    color: var(--red);
    font-size: 0.47rem;
    font-weight: 600;
  }

  figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .close {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1060px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0.9rem 0 clamp(1.2rem, 3vh, 2.25rem);
    gap: 1.25rem;
  }

  .close > p {
    display: block;
    max-width: 25rem;
    margin: 0;
    color: #69736e;
    font: 500 0.6rem/1.5 'IBM Plex Mono', monospace;
  }

  .store {
    position: relative;
    display: grid;
    min-width: 158px;
    padding: 0.62rem 1.15rem 0.68rem;
    color: #fff;
    color: #303633;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid #b7bfbb;
    border-radius: 999px;
    line-height: 1;
    text-align: left;
    transition: transform 180ms ease, background 180ms ease;
  }

  a.store:hover {
    background: var(--red);
    color: #fff;
    border-color: var(--red);
    transform: translateY(-2px);
  }

  a.store:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 4px;
  }

  .store span {
    margin-bottom: 0.18rem;
    font-size: 0.55rem;
    font-weight: 500;
  }

  .store strong {
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .store-pending {
    color: #737b77;
    background: transparent;
    border-color: #cbd1ce;
    cursor: not-allowed;
  }

  .store-pending b {
    position: absolute;
    top: -8px;
    right: -6px;
    padding: 0.25rem 0.4rem;
    color: #fff;
    background: var(--red);
    border-radius: 999px;
    font: 600 0.44rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @keyframes seek {
    0%, 16% { transform: translateX(-16px); }
    84%, 100% { transform: translateX(18px); }
  }

  @media (max-width: 720px) {
    main {
      display: block;
      min-height: 100svh;
      padding-top: 42px;
    }

    .intro {
      width: calc(100% - 2.25rem);
      padding-top: 2.25rem;
    }

    .wordmark {
      position: static;
      justify-content: center;
      margin-bottom: 1.45rem;
    }

    h1 {
      font-size: clamp(2.55rem, 12vw, 4.1rem);
    }

    .lede {
      max-width: 32rem;
      font-size: 0.92rem;
    }

    .shelf-scene {
      height: clamp(530px, 69svh, 650px);
      min-height: 530px;
      margin-top: 0.25rem;
    }

    .rail {
      top: 4%;
      left: calc(50% - 3px);
      width: 7px;
      height: 92%;
      box-shadow:
        2px 0 0 #fff,
        7px 0 0 rgba(41, 48, 45, 0.1);
    }

    .rail::before,
    .rail::after {
      left: -5px;
      width: 17px;
      height: 3px;
    }

    .rail::before { top: 0; }
    .rail::after { top: auto; right: auto; bottom: 0; }

    .spines {
      top: 8%;
      right: auto;
      bottom: 8%;
      left: calc(50% - 103px);
      flex-direction: column;
      align-items: end;
      width: 103px;
      height: auto;
      padding: 0;
    }

    .spines i {
      width: var(--h);
      height: var(--w);
      border-radius: 2px 0 0 2px;
      box-shadow:
        inset 0 3px rgba(255, 255, 255, 0.22),
        inset 0 -2px rgba(30, 38, 34, 0.1);
    }

    .spines i::after {
      top: 3px;
      right: 9px;
      bottom: 3px;
      left: auto;
      width: 1px;
      height: auto;
    }

    .spines .playing {
      box-shadow:
        inset 0 3px rgba(255, 255, 255, 0.25),
        -5px 0 0 1px #fff,
        -7px 0 0 1px var(--red);
    }

    .weekly-spine { transform: translateX(-11px); }

    .weekly-spine::before { inset: -4px -15px -4px -4px; }

    .source {
      top: auto;
      left: calc(50% + 10px);
      flex-direction: row;
      justify-content: flex-start;
      width: 72px;
      height: 38px;
      padding-left: 0.45rem;
      border: 0;
      border-top: 3px solid #89918d;
      border-right: 3px solid #89918d;
      border-radius: 0 3px 0 0;
    }

    .source-plex { top: 7%; }
    .source-jellyfin { top: 45%; }
    .source-navidrome { top: 84%; right: auto; }

    .player {
      top: 34%;
      left: calc(50% + 20px);
      animation-name: seek-vertical;
    }

    .needle {
      top: 30px;
      left: -20px;
      width: 20px;
      height: 2px;
      transform: none;
    }

    .needle::after {
      right: auto;
      bottom: -3px;
      left: -3px;
    }

    .offline-path {
      top: 67%;
      left: calc(50% + 4px);
      width: 37px;
      height: 1px;
      border-top: 1px dashed #92a09a;
      border-left: 0;
    }

    .offline-pocket {
      top: calc(67% - 19px);
      left: calc(50% + 40px);
      transform: rotate(-90deg);
    }

    .offline-pocket span {
      top: 13px;
      left: 58px;
      transform: rotate(90deg);
      transform-origin: left center;
    }

    .radio-path {
      top: 21%;
      left: calc(50% - 46px);
      width: 46px;
      height: 75px;
      border: 0;
      border-top: 1px solid #9ba7a1;
      border-left: 1px solid #9ba7a1;
      border-radius: 24px 0 0;
    }

    .radio-path i {
      right: auto;
      bottom: auto;
      left: -3px;
    }

    .radio-path i:nth-child(1) { top: 35%; left: -3px; }
    .radio-path i:nth-child(2) { top: 65%; left: -3px; }
    .radio-path i:nth-child(3) { top: auto; right: auto; bottom: 0; left: -3px; }

    .radio-path span {
      top: auto;
      right: 54px;
      bottom: -3px;
    }

    .weekly-note {
      top: 77%;
      left: calc(50% - 90px);
      transform: none;
    }

    .weekly-note::after {
      position: absolute;
      top: 50%;
      left: calc(100% + 7px);
      width: 24px;
      height: 1px;
      margin: 0;
    }

    .close {
      grid-template-columns: 1fr;
      width: calc(100% - 2rem);
      padding: 0 0 2rem;
      gap: 0.9rem;
      text-align: center;
    }

    .close > p { margin-inline: auto; }

    .store {
      justify-self: center;
    }

  }

  @keyframes seek-vertical {
    0%, 16% { transform: translateY(-22px); }
    84%, 100% { transform: translateY(30px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .player {
      animation: none;
    }

    .store {
      transition: none;
    }
  }
</style>
