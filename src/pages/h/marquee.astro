---
/**
 * Marquee — four rows of album art drifting sideways behind one still phone.
 *
 * The covers are invented: every one is generated below as a small SVG over a
 * CSS gradient, so nothing on the page borrows a real record. The drift is a
 * single `translateX` on a duplicated track, slow enough to read as weather
 * rather than animation, and it stops dead under `prefers-reduced-motion`.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';

const BODY =
  'Mozz plays the library on your own Plex, Jellyfin, Navidrome or Subsonic server. Stream it at home, or download albums and take them with you.';

/* ---------------------------------------------------------------- artwork */

type Palette = [string, string, string, string];

interface Cover {
  k: string;
  p: Palette;
}

/** Twenty invented sleeves. Nothing here names a real artist or record. */
const COVERS: Cover[] = [
  { k: 'sun', p: ['#3b2270', '#8f6dff', '#ffd166', '#f2ede3'] },
  { k: 'rings', p: ['#0f3b4a', '#1d7d84', '#6ff0d4', '#0b1c24'] },
  { k: 'bars', p: ['#2a2035', '#57407f', '#ff8a52', '#f2ede3'] },
  { k: 'split', p: ['#d4102f', '#8a1030', '#f2ede3', '#ffb3a7'] },
  { k: 'dots', p: ['#f2ede3', '#ded1b8', '#16151b', '#c80028'] },
  { k: 'wave', p: ['#16255c', '#2f4a9e', '#a9cbff', '#f2ede3'] },
  { k: 'blocks', p: ['#f5b700', '#e0651f', '#16151b', '#f2ede3'] },
  { k: 'crescent', p: ['#241c30', '#453763', '#f2ede3', '#9b83ff'] },
  { k: 'stripes', p: ['#0d5240', '#17836a', '#f2e9c9', '#f5b700'] },
  { k: 'peaks', p: ['#4d1a44', '#96276f', '#ff8ab5', '#ffd166'] },
  { k: 'orbit', p: ['#221f3a', '#3b3663', '#9d86ff', '#5ee0c8'] },
  { k: 'arch', p: ['#e8dcc8', '#c9ac86', '#3a2a1f', '#c80028'] },
  { k: 'lines', p: ['#163040', '#245a70', '#f2ede3', '#ff7a45'] },
  { k: 'burst', p: ['#ffd166', '#f0862a', '#2a1206', '#c80028'] },
  { k: 'check', p: ['#24382a', '#3d6045', '#e8f0c8', '#f5b700'] },
  { k: 'spool', p: ['#2b2240', '#4c3a70', '#c9b8ff', '#7c5cff'] },
  { k: 'quarter', p: ['#f2ede3', '#d8ccb8', '#c80028', '#16151b'] },
  { k: 'band', p: ['#063240', '#0d5468', '#5ee0c8', '#f2ede3'] },
  { k: 'scatter', p: ['#37173a', '#6b2a5a', '#ff5d8f', '#ffd166'] },
  { k: 'eclipse', p: ['#14131f', '#2f2a4a', '#ff7a45', '#f2ede3'] },
];

/** Deterministic jitter, so the wall is varied but identical on every build. */
function seeded(seed: number) {
  let s = (seed * 1013904223 + 1664525) % 4294967296;
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

function art(k: string, p: Palette, uid: string): string {
  const [base, , ink, acc] = p;
  const rnd = seeded(uid.length + k.charCodeAt(0) * 31 + k.charCodeAt(1) * 7);

  switch (k) {
    case 'sun':
      return `<circle cx="50" cy="54" r="29" fill="${ink}"/>
        <g fill="${base}" opacity=".9"><rect x="0" y="50" width="100" height="2.6"/><rect x="0" y="58" width="100" height="2.6"/><rect x="0" y="66" width="100" height="2.6"/></g>
        <rect x="0" y="74" width="100" height="26" fill="${base}" opacity=".55"/>
        <rect x="12" y="86" width="34" height="3.4" rx="1.7" fill="${acc}" opacity=".85"/>`;
    case 'rings':
      return `<g fill="none" stroke="${ink}" stroke-width="2.3" opacity=".92">
          <circle cx="53" cy="47" r="10"/><circle cx="53" cy="47" r="19"/><circle cx="53" cy="47" r="28"/><circle cx="53" cy="47" r="37"/>
        </g><circle cx="53" cy="47" r="4.2" fill="${acc}"/>`;
    case 'bars': {
      const h = [30, 54, 18, 66, 38, 74, 26, 50];
      return h
        .map(
          (v, i) =>
            `<rect x="${8 + i * 11}" y="${80 - v}" width="6.6" height="${v}" rx="3.3" fill="${i % 3 === 0 ? acc : ink}" opacity="${i % 3 === 0 ? 1 : 0.92}"/>`,
        )
        .join('');
    }
    case 'split':
      return `<path d="M0 0 H100 L0 100 Z" fill="${ink}" opacity=".92"/>
        <circle cx="72" cy="70" r="17" fill="${acc}"/>`;
    case 'dots': {
      let out = '';
      for (let r = 0; r < 6; r += 1)
        for (let c = 0; c < 6; c += 1)
          out += `<circle cx="${12 + c * 15.2}" cy="${12 + r * 15.2}" r="${1.4 + r * 0.8}" fill="${r === 4 && c % 3 === 1 ? acc : ink}"/>`;
      return out;
    }
    case 'wave': {
      let out = '';
      for (let j = 0; j < 4; j += 1)
        out += `<path d="M0 ${28 + j * 15} C 18 ${14 + j * 15} 32 ${44 + j * 15} 50 ${28 + j * 15} S 82 ${12 + j * 15} 100 ${28 + j * 15}" fill="none" stroke="${j === 2 ? acc : ink}" stroke-width="2.4" opacity="${0.55 + j * 0.14}"/>`;
      return out;
    }
    case 'blocks':
      return `<circle cx="69" cy="31" r="23" fill="${ink}"/>
        <path d="M10 54 A44 44 0 0 1 54 10 L54 54 Z" fill="${ink}" opacity=".28"/>
        <rect x="12" y="56" width="44" height="32" fill="${acc}"/>`;
    case 'crescent':
      return `<mask id="mk${uid}"><rect width="100" height="100" fill="#fff"/><circle cx="63" cy="41" r="26" fill="#000"/></mask>
        <circle cx="50" cy="50" r="31" fill="${ink}" mask="url(#mk${uid})"/>
        <circle cx="76" cy="76" r="5" fill="${acc}"/>`;
    case 'stripes': {
      let out = '<g transform="rotate(-32 50 50)">';
      for (let i = -3; i < 9; i += 1)
        out += `<rect x="${-20 + i * 16}" y="-50" width="7" height="200" fill="${i === 3 ? acc : ink}" opacity="${i === 3 ? 1 : 0.82}"/>`;
      return `${out}</g>`;
    }
    case 'peaks':
      return `<circle cx="70" cy="28" r="12" fill="${ink}" opacity=".75"/>
        <path d="M0 100 L28 44 L56 100 Z" fill="${ink}"/>
        <path d="M34 100 L68 32 L100 100 Z" fill="${acc}" opacity=".95"/>`;
    case 'orbit':
      return `<g fill="none" stroke="${ink}" stroke-width="2.2" opacity=".9">
          <ellipse cx="50" cy="50" rx="38" ry="14" transform="rotate(-22 50 50)"/>
          <ellipse cx="50" cy="50" rx="38" ry="14" transform="rotate(38 50 50)"/>
        </g><circle cx="50" cy="50" r="7.5" fill="${acc}"/>`;
    case 'arch':
      return `<path d="M28 82 V44 a22 22 0 0 1 44 0 V82 Z" fill="${ink}"/>
        <circle cx="50" cy="46" r="8" fill="${acc}"/>
        <rect x="0" y="82" width="100" height="18" fill="${acc}" opacity=".85"/>`;
    case 'lines': {
      const w = [64, 40, 78, 30, 88, 52, 70, 24, 60, 84, 36, 46];
      return w
        .map(
          (v, i) =>
            `<rect x="9" y="${13 + i * 6.3}" width="${v}" height="2.4" rx="1.2" fill="${i === 4 ? acc : ink}" opacity="${i === 4 ? 1 : 0.72}"/>`,
        )
        .join('');
    }
    case 'burst': {
      let out = '';
      for (let i = 0; i < 14; i += 1)
        out += `<rect x="49.1" y="3" width="1.8" height="44" fill="${ink}" transform="rotate(${(i * 360) / 14} 50 50)"/>`;
      return `${out}<circle cx="50" cy="50" r="9.5" fill="${acc}"/>`;
    }
    case 'check': {
      let out = '';
      for (let r = 0; r < 4; r += 1)
        for (let c = 0; c < 4; c += 1)
          if ((r + c) % 2 === 0)
            out += `<rect x="${c * 25}" y="${r * 25}" width="25" height="25" fill="${r === 2 && c === 1 ? acc : ink}" opacity=".92"/>`;
      return out;
    }
    case 'spool':
      return `<g fill="none" stroke="${ink}" stroke-width="4.5"><circle cx="31" cy="43" r="17"/><circle cx="70" cy="43" r="17"/></g>
        <circle cx="31" cy="43" r="4" fill="${acc}"/><circle cx="70" cy="43" r="4" fill="${acc}"/>
        <rect x="0" y="70" width="100" height="12" fill="${ink}" opacity=".45"/>`;
    case 'quarter':
      return `<path d="M0 100 A100 100 0 0 0 100 0 L100 100 Z" fill="${ink}"/>
        <g fill="${acc}"><rect x="10" y="14" width="42" height="4" rx="2"/><rect x="10" y="24" width="28" height="4" rx="2"/></g>`;
    case 'band':
      return `<rect x="0" y="33" width="100" height="34" fill="${ink}"/>
        <circle cx="50" cy="50" r="12" fill="${acc}"/>
        <g fill="${ink}" opacity=".55"><rect x="0" y="20" width="100" height="3"/><rect x="0" y="77" width="100" height="3"/></g>`;
    case 'scatter': {
      let out = '';
      for (let i = 0; i < 20; i += 1)
        out += `<circle cx="${(rnd() * 88 + 6).toFixed(1)}" cy="${(rnd() * 88 + 6).toFixed(1)}" r="${(rnd() * 5 + 1.4).toFixed(1)}" fill="${i % 5 === 0 ? acc : ink}" opacity="${(0.5 + rnd() * 0.5).toFixed(2)}"/>`;
      return out;
    }
    case 'eclipse':
    default:
      return `<circle cx="50" cy="47" r="27" fill="${base}"/>
        <circle cx="50" cy="47" r="27" fill="none" stroke="${ink}" stroke-width="4"/>
        <circle cx="50" cy="47" r="34" fill="none" stroke="${acc}" stroke-width="1.2" opacity=".55"/>
        <rect x="0" y="88" width="100" height="3.4" fill="${acc}" opacity=".8"/>`;
  }
}

function sleeve(c: Cover, uid: string): string {
  const [a, b] = c.p;
  return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">
    <defs><linearGradient id="bg${uid}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/>
    </linearGradient></defs>
    <rect width="100" height="100" fill="url(#bg${uid})"/>
    ${art(c.k, c.p, uid)}
  </svg>`;
}

/* The record held still, in front. Warmer and more detailed than the wall. */
const NOW_PLAYING_ART = `<svg viewBox="0 0 100 100" focusable="false" aria-hidden="true">
  <defs>
    <linearGradient id="npbg" x1="0" y1="0" x2="0.7" y2="1">
      <stop offset="0" stop-color="#3a1a6e"/><stop offset="0.55" stop-color="#7c5cff"/><stop offset="1" stop-color="#c2417f"/>
    </linearGradient>
    <linearGradient id="npsun" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe9a8"/><stop offset="1" stop-color="#ff8f5c"/>
    </linearGradient>
  </defs>
  <rect width="100" height="100" fill="url(#npbg)"/>
  <circle cx="50" cy="52" r="27" fill="url(#npsun)"/>
  <g fill="#3a1a6e" opacity=".62">
    <rect x="0" y="48" width="100" height="2.4"/><rect x="0" y="55" width="100" height="2.4"/>
    <rect x="0" y="62" width="100" height="2.4"/><rect x="0" y="69" width="100" height="2.4"/>
  </g>
  <rect x="0" y="76" width="100" height="24" fill="#2a1150" opacity=".55"/>
  <circle cx="50" cy="52" r="35" fill="none" stroke="#ffe9a8" stroke-width="0.8" opacity=".5"/>
  <circle cx="83" cy="18" r="4.4" fill="#c80028"/>
  <g fill="#ffe9a8" opacity=".9"><rect x="10" y="85" width="30" height="2.6" rx="1.3"/><rect x="10" y="91" width="18" height="2.6" rx="1.3"/></g>
</svg>`;

/* ------------------------------------------------------------------ rows */

const ROWS = [
  { size: 1.14, dur: 78, rev: false, tier: 'far', shift: 0.22 },
  { size: 1.5, dur: 96, rev: true, tier: 'near', shift: 0.55 },
  { size: 1.34, dur: 64, rev: false, tier: 'near', shift: 0.08 },
  { size: 1.06, dur: 108, rev: true, tier: 'far', shift: 0.4 },
];

const PER_ROW = 9;
const rowCovers = (r: number) =>
  Array.from({ length: PER_ROW }, (_, i) => COVERS[(i * 7 + r * 3) % COVERS.length]);
---

<Layout
  title={`${NAME} — a free player for your self-hosted music`}
  description="Mozz plays the music on your own Plex, Jellyfin, Navidrome or Subsonic server, on iPhone and iPad. Stream at home or download albums for offline listening."
  themeColor="#16151b"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="marquee" />

  <main class="stage">
    <div class="wall" aria-hidden="true">
      <div class="wall-inner">
        {ROWS.map((row, r) => (
          <div
            class={`row is-${row.tier}`}
            style={`--size:${row.size};--dur:${row.dur}s;--shift:${row.shift}`}
          >
            <div class={`track${row.rev ? ' is-rev' : ''}`}>
              {[0, 1].map((copy) =>
                rowCovers(r).map((c, i) => (
                  <span class="cover" set:html={sleeve(c, `${r}${i}${copy}`)} />
                )),
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <p class="eyebrow">
        <Mark size={22} decorative />
        <span class="word">Mozz</span>
        <span class="rule"></span>
        <span class="kind">self-hosted music player</span>
      </p>

      <h1>
        A free player for <em>your self-hosted music.</em>
      </h1>

      <div class="mid">
        <div
          class="phone"
          role="img"
          aria-label="The Mozz now playing screen on an iPhone: album artwork, a track downloaded for offline listening, a progress bar and playback controls."
        >
          <div class="screen">
            <span class="island" aria-hidden="true"></span>
            <div class="status">
              <span>9:41</span>
              <span class="status-icons">
                <svg viewBox="0 0 30 10" aria-hidden="true" focusable="false">
                  <rect x="0" y="5" width="2" height="4" rx="0.6" />
                  <rect x="3.4" y="3.4" width="2" height="5.6" rx="0.6" />
                  <rect x="6.8" y="1.8" width="2" height="7.2" rx="0.6" />
                  <rect x="10.2" y="0.6" width="2" height="8.4" rx="0.6" />
                  <rect x="16" y="1.4" width="11" height="6.4" rx="2" opacity="0.5" />
                  <rect x="17.2" y="2.6" width="7.4" height="4" rx="1.1" />
                </svg>
              </span>
            </div>

            <div class="chrome">
              <svg class="glyph" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                <path d="M4 7l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="from">From your server</span>
              <svg class="glyph" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                  <path d="M3 5h12M3 9h12M3 13h8" />
                </g>
              </svg>
            </div>

            <div class="artwork" set:html={NOW_PLAYING_ART}></div>

            <div class="meta">
              <p class="track-title">Copper Weather</p>
              <p class="track-artist">Iona Petrel</p>
              <p class="chip">
                <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                  <circle cx="7" cy="7" r="6.2" fill="currentColor" opacity="0.2" />
                  <path d="M7 3.6v5.2M4.8 6.9L7 9.1l2.2-2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Downloaded
              </p>
            </div>

            <div class="progress">
              <span class="bar"><span class="fill"></span><span class="knob"></span></span>
              <span class="times"><span>1:47</span><span>-2:25</span></span>
            </div>

            <div class="controls">
              <svg class="ctl" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 5h3.2l9 9H18M2 14h3.2l9-9H18" />
                  <path d="M15.4 2.6L18 5l-2.6 2.4M15.4 12.6L18 15l-2.6 2.4" />
                </g>
              </svg>
              <svg class="ctl big" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M15.6 3.6v12.8L5.8 10z" fill="currentColor" />
                <rect x="3" y="3.6" width="2.2" height="12.8" rx="1.1" fill="currentColor" />
              </svg>
              <span class="play">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <rect x="7.4" y="5.6" width="3.4" height="12.8" rx="1.4" fill="currentColor" />
                  <rect x="13.2" y="5.6" width="3.4" height="12.8" rx="1.4" fill="currentColor" />
                </svg>
              </span>
              <svg class="ctl big" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M4.4 3.6v12.8L14.2 10z" fill="currentColor" />
                <rect x="14.8" y="3.6" width="2.2" height="12.8" rx="1.1" fill="currentColor" />
              </svg>
              <svg class="ctl" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 6h10a3 3 0 0 1 3 3v1M15 14H5a3 3 0 0 1-3-3V10" />
                  <path d="M12.6 3.6L15 6l-2.4 2.4M7.4 11.6L5 14l2.4 2.4" />
                </g>
              </svg>
            </div>

            <div class="foot">
              <svg viewBox="0 0 20 14" aria-hidden="true" focusable="false">
                <path d="M3 2h14a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-3M6 9H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                <path d="M10 8l4 5H6z" fill="currentColor" />
              </svg>
              <span class="vol"><span class="vol-fill"></span></span>
              <svg viewBox="0 0 20 14" aria-hidden="true" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                  <path d="M3 3.5h9M3 7h9M3 10.5h6" />
                </g>
                <circle cx="16" cy="7" r="2" fill="currentColor" />
              </svg>
            </div>

            <span class="home-bar"></span>
          </div>
        </div>
      </div>

      <div class="dock">
        <p class="body">{BODY}</p>

        <div class="line">
          <div class="actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
            ) : (
              <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
            )}
            <a class="ghost" href={GITHUB_URL}>Read the source</a>
          </div>

          <p class="works">
            <span class="works-label">Works with</span>
            <ServerLogo name="Plex" size={17} />
            <ServerLogo name="Jellyfin" size={17} />
            <ServerLogo name="Navidrome" size={17} />
            <span class="works-label">and any Subsonic server</span>
          </p>
        </div>

        <p class="support">{HERO_COPY.support}</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .stage {
    --ink: #16151b;
    --paper: #f2ede3;
    --violet: #7c5cff;
    --violet-lift: #bcaaff;
    --red: #c80028;
    --u: clamp(102px, 19.4svh, 194px);
    --phone-h: clamp(300px, 50svh, 476px);

    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100svh;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    font-family: 'Manrope', 'Helvetica Neue', Arial, sans-serif;
  }

  /* ------------------------------------------------------------- the wall */

  .wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .wall-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 0.09);
  }

  .row {
    --edge: calc(var(--u) * var(--size));
    height: var(--edge);
    margin-left: calc(var(--edge) * var(--shift) * -1);
    overflow: hidden;
  }

  .row.is-far {
    filter: blur(2px) saturate(1.05);
    opacity: 0.66;
  }

  .row.is-near {
    filter: blur(0.4px) saturate(1.08);
    opacity: 1;
  }

  .track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
    animation: drift var(--dur) linear infinite;
  }

  .track.is-rev {
    animation-direction: reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .cover {
    display: block;
    flex: none;
    width: var(--edge);
    height: var(--edge);
    /* Margin, not gap: a duplicated track only loops seamlessly when every
       item occupies exactly the same pitch, including the last one. */
    margin-right: calc(var(--edge) * 0.1);
    border-radius: calc(var(--edge) * 0.028);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.07) inset,
      0 14px 30px rgba(0, 0, 0, 0.42);
  }

  .cover :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        38% 30% at 50% 51%,
        rgba(16, 14, 22, 0.92) 0%,
