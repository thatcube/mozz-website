---
/**
 * Eclipse — MOZZ set enormous and cropped by the page, with the app standing
 * in front of it. Everything the phone passes over turns red, the way light
 * changes when something crosses in front of it.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

const HEADLINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT =
  'Point it at Plex, Jellyfin or Navidrome. Listen at home, or keep an album on the phone and play it with no signal at all.';
const SERVERS = ['Plex', 'Jellyfin', 'Navidrome'];
---

<Layout
  title={`${NAME} — a free player for the music on your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Point it at your own Plex, Jellyfin or Navidrome server, listen at home, or download an album and play it offline."
  themeColor="#eeeae2"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="eclipse" />

  <main class="eclipse">
    <div class="frame">
      <header class="top">
        <span class="lockup">
          <Mark size={24} decorative />
          <b>Mozz</b>
          <i></i>
          <span>self-hosted music player</span>
        </span>
        <span class="fine">free forever · gpl-3.0 · no account</span>
      </header>

      <section class="mid">
        <div class="say">
          <h1>{HEADLINE}</h1>
          <p>{SUPPORT}</p>
        </div>

        <div class="works">
          <span class="tag">works with</span>
          <ul role="list">
            {SERVERS.map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="word" aria-hidden="true">
          <span class="w">MOZZ</span>
          <span class="w lit">MOZZ</span>
        </div>

        <div
          class="phone"
          role="img"
          aria-label="The Mozz now playing screen: an album streaming from your own server, already downloaded to the phone."
        >
          <div class="screen">
            <div class="island"></div>

            <div class="status">
              <span>9:41</span>
              <span class="glyphs">
                <svg viewBox="0 0 16 16" aria-hidden="true"
                  ><path
                    d="M1.6 7.5 14.3 2.1a.42.42 0 0 1 .55.55L9.45 15.35a.42.42 0 0 1-.78.02L6.35 10.4 1.58 8.28a.42.42 0 0 1 .02-.78z"
                    fill="currentColor"></path></svg
                >
                <svg viewBox="0 0 26 12" aria-hidden="true"
                  ><rect
                    x="0.7"
                    y="0.7"
                    width="21"
                    height="10.6"
                    rx="3.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"></rect><rect
                    x="2.6"
                    y="2.6"
                    width="14"
                    height="6.8"
                    rx="1.8"
                    fill="currentColor"></rect><path
                    d="M23.6 4.2v3.6a2.1 2.1 0 0 0 0-3.6z"
                    fill="currentColor"></path></svg
                >
              </span>
            </div>

            <div class="scr-head">
              <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  d="M3 6l5 5 5-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              <span class="from">playing from your server</span>
              <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>

            <div class="art">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <defs>
                  <clipPath id="eclipse-disc"><circle cx="60" cy="54" r="33"></circle></clipPath>
                </defs>
                <rect width="120" height="120" fill="#d8002d"></rect>
                <circle
                  cx="60"
                  cy="54"
                  r="40"
                  fill="none"
                  stroke="#fdf6ec"
                  stroke-width="1.4"
                  opacity="0.34"></circle>
                <circle cx="60" cy="54" r="33" fill="#f6ece0"></circle>
                <g clip-path="url(#eclipse-disc)">
                  <circle class="umbra" cx="42" cy="51" r="31" fill="#1a0812"></circle>
                </g>
                <circle cx="60" cy="54" r="3.6" fill="#d8002d"></circle>
                <rect x="18" y="104" width="26" height="3" fill="#fdf6ec" opacity="0.5"></rect>
              </svg>
            </div>

            <div class="meta">
              <strong>Umbra</strong>
              <span>Sable Field · Long Shadow</span>
            </div>

            <div class="bar"><span></span></div>
            <div class="times"><span>1:47</span><span>−2:25</span></div>

            <div class="ctrls">
              <svg viewBox="0 0 20 20" aria-hidden="true"
                ><path d="M17 3.5v13L7.5 10z" fill="currentColor"></path><rect
                  x="3"
                  y="3.5"
                  width="2.4"
                  height="13"
                  rx="1"
                  fill="currentColor"></rect></svg
              >
              <span class="play"
                ><svg viewBox="0 0 20 20" aria-hidden="true"
                  ><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.2" fill="currentColor"
                  ></rect><rect
                    x="11.1"
                    y="4.4"
                    width="3.3"
                    height="11.2"
                    rx="1.2"
                    fill="currentColor"></rect></svg
                ></span
              >
              <svg viewBox="0 0 20 20" aria-hidden="true"
                ><path d="M3 3.5v13L12.5 10z" fill="currentColor"></path><rect
                  x="14.6"
                  y="3.5"
                  width="2.4"
                  height="13"
                  rx="1"
                  fill="currentColor"></rect></svg
              >
            </div>

            <div class="vol">
              <svg viewBox="0 0 16 16" aria-hidden="true"
                ><path d="M4 6h2.4L9.4 3.4v9.2L6.4 10H4z" fill="currentColor"></path></svg
              >
              <span class="track"><i></i></span>
              <svg viewBox="0 0 16 16" aria-hidden="true"
                ><path d="M2.5 6h2.4L7.9 3.4v9.2L4.9 10H2.5z" fill="currentColor"></path><path
                  d="M10.4 5.6a3.4 3.4 0 0 1 0 4.8M12.4 3.4a6.4 6.4 0 0 1 0 9.2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"></path></svg
              >
            </div>

            <div class="dl">
              <svg viewBox="0 0 16 16" aria-hidden="true"
                ><circle cx="8" cy="8" r="7" fill="#d8002d"></circle><path
                  d="M4.8 8.2 7 10.4l4-4.6"
                  fill="none"
                  stroke="#fdf6ec"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              <span>downloaded · plays offline</span>
            </div>

            <div class="home"></div>
          </div>
        </div>

        <p class="note a">
          <span class="dot"
            ><svg viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M4 8h8M8.6 4.4 12.2 8l-3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            ></span
          >
          <span>your library<br />lives on your box</span>
        </p>

        <p class="note b">
          <span class="dot"
            ><svg viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M12 8H4M7.4 4.4 3.8 8l3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            ></span
          >
          <span>downloaded once<br />plays with no signal</span>
        </p>
      </section>

      <footer class="bot">
        <div class="actions">
          <a class="btn" href={GITHUB_URL}>Source on GitHub</a>
          {
            APP_STORE_URL ? (
              <a class="btn ghost" href={APP_STORE_URL}>
                Download on the App Store
              </a>
            ) : (
              <span class="btn ghost pending" aria-disabled="true">
                Coming to the App Store
              </span>
            )
          }
        </div>
        <span class="ref"><em class="mob">free forever · gpl-3.0 · </em>mz–04 · eclipse</span>
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  body {
    background: #eeeae2;
  }
</style>

<style>
  .eclipse {
    --paper: #eeeae2;
    --ink: #14101a;
    --red: #d8002d;
    --deep: #7d0019;
    --cream: #fdf6ec;
    --pw: 292px;
    --band: calc(var(--pw) * 2);
    --pad: clamp(20px, 4.4vw, 64px);

    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
  }

  .eclipse::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 54%;
    width: min(1240px, 132vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(216, 0, 45, 0.1), rgba(216, 0, 45, 0) 58%);
    pointer-events: none;
  }

  .frame {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding: calc(42px + clamp(14px, 1.6vw, 22px)) var(--pad) clamp(16px, 2.2vh, 26px);
  }

  /* ---------- top strip ---------- */

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: clamp(12px, 1vw, 13.5px);
  }

  .lockup b {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    font-size: 1.25em;
  }

  .lockup i {
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }

  .lockup span {
    opacity: 0.62;
  }

  .fine {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: clamp(10px, 0.85vw, 11.5px);
    letter-spacing: 0.02em;
    opacity: 0.5;
  }

  /* ---------- middle stage ---------- */

  .mid {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: clamp(10px, 2.4vh, 26px);
  }

  .say {
    position: relative;
    z-index: 3;
    max-width: 27ch;
  }

  .say h1 {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 100%;
    font-size: clamp(25px, 2.55vw, 37px);
    line-height: 1.04;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  .say p {
    max-width: 34ch;
    margin-top: 0.85em;
    font-size: clamp(13px, 1.02vw, 14.5px);
    line-height: 1.5;
    opacity: 0.66;
  }

  .works {
    position: relative;
    z-index: 3;
    text-align: right;
    flex: none;
  }

  .works .tag {
    display: block;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .works ul {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.3rem;
  }

  .works li {
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-stretch: 105%;
    font-size: clamp(15px, 1.35vw, 20px);
    letter-spacing: -0.015em;
    line-height: 1.15;
    padding-top: 0.3rem;
    border-top: 1px solid rgba(20, 16, 26, 0.18);
  }

  .works li:first-child {
    border-top-color: var(--red);
  }

  /* ---------- the enormous word ---------- */

  .word {
    position: absolute;
    left: 50%;
    bottom: -0.06em;
    transform: translateX(-50%);
    z-index: 1;
    white-space: nowrap;
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: 34vw;
    line-height: 0.74;
    letter-spacing: -0.028em;
    pointer-events: none;
    user-select: none;
  }

  .w {
    display: block;
    color: var(--ink);
  }

  .w.lit {
    position: absolute;
    inset: 0;
    color: var(--red);
    clip-path: inset(0 calc(50% - var(--band) / 2) 0 calc(50% - var(--band) / 2));
    animation: umbra 26s ease-in-out infinite;
  }

  @keyframes umbra {
    0%,
    100% {
      clip-path: inset(0 calc(50% - var(--band) / 2) 0 calc(50% - var(--band) / 2));
    }
    50% {
      clip-path: inset(0 calc(50% - var(--band) * 0.585) 0 calc(50% - var(--band) * 0.585));
    }
  }

  /* ---------- the phone ---------- */

  .phone {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    width: var(--pw);
    aspect-ratio: 1 / 2.06;
    transform: translateX(-50%);
    padding: calc(var(--pw) * 0.031);
    border-radius: calc(var(--pw) * 0.155);
    background: #100c14;
    box-shadow:
      0 0 0 clamp(7px, 0.85vw, 12px) var(--paper),
      0 0 0 calc(clamp(7px, 0.85vw, 12px) + 1px) rgba(20, 16, 26, 0.14),
      0 42px 70px -34px rgba(20, 16, 26, 0.6);
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 calc(var(--pw) * 0.055);
    border-radius: calc(var(--pw) * 0.126);
    overflow: hidden;
    background: #191320;
    color: var(--cream);
    font-size: calc(var(--pw) / 20);
  }

  .island {
    position: absolute;
    left: 50%;
    top: 0.62em;
    width: 30%;
    height: 1.1em;
    border-radius: 999px;
    background: #0a070d;
    transform: translateX(-50%);
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.72em 0.35em 0;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.62em;
    letter-spacing: 0.01em;
    opacity: 0.72;
  }

  .glyphs {
    display: flex;
    align-items: center;
    gap: 0.45em;
  }

  .glyphs svg:first-child {
    width: 0.85em;
    height: 0.85em;
  }

  .glyphs svg:last-child {
    width: 1.5em;
    height: 0.7em;
  }

  .scr-head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.5em;
    padding: 0 0.2em;
  }

  .chev {
    width: 0.95em;
    height: 0.95em;
    opacity: 0.75;
    flex: none;
  }

  .from {
    flex: 1;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.53em;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.62;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .eq {
    display: flex;
    align-items: flex-end;
    gap: 0.14em;
    height: 0.8em;
    flex: none;
  }

  .eq i {
    width: 0.14em;
    background: var(--red);
    border-radius: 1px;
    animation: level 1.1s ease-in-out infinite;
  }

  .eq i:nth-child(1) {
    height: 55%;
    animation-delay: -0.35s;
  }
  .eq i:nth-child(2) {
    height: 100%;
  }
  .eq i:nth-child(3) {
    height: 38%;
    animation-delay: -0.7s;
  }

  @keyframes level {
    0%,
    100% {
      transform: scaleY(0.42);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .art {
    margin-top: 1.05em;
  }

  .art svg {
    width: 100%;
    height: auto;
    border-radius: 0.35em;
    display: block;
  }

  .umbra {
    animation: cross 30s ease-in-out infinite;
  }

  @keyframes cross {
    0%,
    100% {
      transform: translateX(-6px);
    }
    50% {
      transform: translateX(30px);
    }
  }

  .meta {
    margin-top: 1.15em;
    padding: 0 0.15em;
  }

  .meta strong {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.12em;
    letter-spacing: -0.02em;
  }

  .meta span {
    display: block;
    margin-top: 0.2em;
    font-size: 0.66em;
    opacity: 0.55;
  }

  .bar {
    margin: 1.1em 0.15em 0;
    height: 0.22em;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.18);
    overflow: hidden;
  }

  .bar span {
    display: block;
    width: 42%;
    height: 100%;
    border-radius: 999px;
    background: var(--red);
  }

  .times {
    display: flex;
    justify-content: space-between;
    margin: 0.5em 0.15em 0;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.55em;
    opacity: 0.5;
  }

  .ctrls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.35em;
    margin-top: 0.95em;
  }

  .ctrls > svg {
    width: 1.15em;
    height: 1.15em;
    opacity: 0.85;
  }

  .play {
    display: grid;
    place-items: center;
    width: 2.35em;
    height: 2.35em;
    border-radius: 999px;
    background: var(--red);
    color: #150009;
  }

  .play svg {
    width: 1.15em;
    height: 1.15em;
  }

  .vol {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin: 1.5em 0.35em 0;
    opacity: 0.42;
  }

  .vol svg {
    width: 0.72em;
    height: 0.72em;
    flex: none;
  }

  .vol .track {
    position: relative;
    flex: 1;
    height: 0.16em;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.28);
  }

  .vol .track i {
    position: absolute;
    inset: 0 42% 0 0;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.85);
  }

  .dl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    margin-top: auto;
    margin-bottom: 0.7em;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.52em;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .dl svg {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }

  .home {
    width: 32%;
    height: 0.2em;
    margin: 0 auto 0.6em;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.5);
  }

  /* ---------- the small marks ---------- */

  .note {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10.5px;
    line-height: 1.45;
    letter-spacing: 0.02em;
    opacity: 0.78;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 999px;
    background: var(--red);
    color: var(--cream);
  }

  .dot svg {
    width: 13px;
    height: 13px;
  }

  .note.a {
    top: 38%;
    left: calc(50% - var(--pw) / 2 - 168px);
  }

  .note.b {
    top: 26%;
    left: calc(50% + var(--pw) / 2 + 30px);
    flex-direction: row-reverse;
  }

  /* ---------- bottom strip ---------- */

  .bot {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(10px, 1.6vh, 18px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.66rem 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: clamp(12px, 0.95vw, 13.5px);
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-style: dashed;
    border-color: rgba(20, 16, 26, 0.34);
  }

  .btn.pending {
    opacity: 0.72;
    cursor: default;
  }

  .btn.pending::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--red);
  }

  a.btn:hover {
    background: var(--red);
    border-color: var(--red);
  }

  a.btn:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  .ref {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.42;
    white-space: nowrap;
  }

  .ref .mob {
    display: none;
    font-style: normal;
  }

  /* ---------- narrow ---------- */

  @media (max-width: 1180px) {
    .note.a {
      left: calc(50% - var(--pw) / 2 - 150px);
    }
  }

  @media (max-width: 900px) {
    .eclipse {
      /* The phone takes the leftover height, so the annotation always sits a
         fixed 30px under the copy instead of floating in whatever is spare. */
      --pw: clamp(138px, min(56vw, calc((100vh - 454px) / 2.06)), 208px);
