---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';
---

<Layout
  title={`${NAME} — fill the room with your own music`}
  description="Mozz is a free, open source player for music on your own server. Stream on iPhone and iPad or download albums for offline listening."
  themeColor="#f7ead6"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="speaker" />

  <main class="hero">
    <div class="sunwash" aria-hidden="true"></div>

    <div class="illustration">
      <svg
        viewBox="0 0 1440 900"
        role="img"
        aria-label="A large wood-cased hi-fi speaker playing in a warm room, beside a houseplant and a leaning record sleeve."
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <linearGradient id="speaker-wall" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f7ead6" />
            <stop offset=".54" stop-color="#f0c99f" />
            <stop offset="1" stop-color="#d98e62" />
          </linearGradient>
          <linearGradient id="speaker-wood" x1="0" y1="0" x2="1" y2=".2">
            <stop offset="0" stop-color="#572519" />
            <stop offset=".18" stop-color="#934126" />
            <stop offset=".48" stop-color="#c16838" />
            <stop offset=".72" stop-color="#8a3923" />
            <stop offset="1" stop-color="#4b2118" />
          </linearGradient>
          <linearGradient id="speaker-metal" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#7b7368" />
            <stop offset=".18" stop-color="#f0dfc4" />
            <stop offset=".42" stop-color="#a69a87" />
            <stop offset=".68" stop-color="#fff1d9" />
            <stop offset="1" stop-color="#746a5d" />
          </linearGradient>
          <radialGradient id="woofer-cone" cx=".42" cy=".36" r=".7">
            <stop offset="0" stop-color="#8d3c2d" />
            <stop offset=".44" stop-color="#4b211e" />
            <stop offset=".78" stop-color="#251518" />
            <stop offset="1" stop-color="#100d0d" />
          </radialGradient>
          <radialGradient id="woofer-cap" cx=".36" cy=".3" r=".7">
            <stop offset="0" stop-color="#d76647" />
            <stop offset=".62" stop-color="#8d2d27" />
            <stop offset="1" stop-color="#4b1718" />
          </radialGradient>
          <radialGradient id="tweeter-dome" cx=".34" cy=".28" r=".72">
            <stop offset="0" stop-color="#fff0bf" />
            <stop offset=".44" stop-color="#c89d54" />
            <stop offset="1" stop-color="#4c3729" />
          </radialGradient>
          <pattern id="speaker-weave" width="12" height="12" patternUnits="userSpaceOnUse">
            <rect width="12" height="12" fill="#a53c2b" />
            <path d="M0 2h12M0 8h12" stroke="#d86b4c" stroke-width="2" opacity=".7" />
            <path d="M2 0v12M8 0v12" stroke="#64251f" stroke-width="2" opacity=".72" />
            <path d="M0 0l12 12M12 0L0 12" stroke="#ef9a70" stroke-width=".8" opacity=".28" />
          </pattern>
          <pattern id="speaker-brush" width="3" height="12" patternUnits="userSpaceOnUse">
            <rect width="3" height="12" fill="url(#speaker-metal)" />
            <path d="M1 0v12" stroke="#fff8e9" stroke-width=".5" opacity=".36" />
          </pattern>
          <filter id="speaker-shadow" x="-30%" y="-30%" width="160%" height="180%">
            <feDropShadow dx="12" dy="18" stdDeviation="14" flood-color="#4e2019" flood-opacity=".34" />
          </filter>
        </defs>

        <rect width="1440" height="900" fill="url(#speaker-wall)" />
        <path d="M1282 0H1440V900H1326Q1294 643 1282 0Z" fill="#3f6b5c" />
        <path d="M1321 0H1360V900H1326Q1300 468 1321 0Z" fill="#294c42" opacity=".72" />

        <circle cx="314" cy="236" r="310" fill="#f7c768" opacity=".28" />
        <path d="M0 94L770 0H1112L0 338Z" fill="#fff3cf" opacity=".3" />
        <path d="M0 410L928 0H1060L0 568Z" fill="#eaa45c" opacity=".16" />

        <g class="air" fill="none" stroke-linecap="round" aria-hidden="true">
          <path d="M612 278C795 203 940 239 1084 173" stroke="#fff0b7" stroke-width="18" opacity=".56" />
          <path d="M656 382C828 319 964 359 1132 287" stroke="#b5462f" stroke-width="11" opacity=".2" />
          <path d="M658 518C821 456 971 507 1120 435" stroke="#fff1bd" stroke-width="15" opacity=".42" />
        </g>

        <g class="plant" aria-hidden="true">
          <path d="M94 700C136 577 156 435 181 279" stroke="#31594c" stroke-width="20" fill="none" />
          <path d="M166 382C71 345 42 284 54 225C133 244 185 297 166 382Z" fill="#3f6b5c" />
          <path d="M176 315C189 213 244 165 310 160C302 244 254 300 176 315Z" fill="#568a70" />
          <path d="M140 493C58 476 12 423 5 362C90 368 141 414 140 493Z" fill="#2f5b4d" />
          <path d="M159 545C208 459 279 443 335 465C294 535 228 566 159 545Z" fill="#4f8068" />
          <path d="M74 665H202L184 784H92Z" fill="#b5462f" />
          <path d="M83 686H193L185 706H88Z" fill="#d56a45" opacity=".72" />
        </g>

        <g transform="translate(704 562) rotate(7 118 118)" filter="url(#speaker-shadow)" aria-hidden="true">
          <rect width="236" height="236" rx="3" fill="#315c4d" />
          <rect x="16" y="16" width="204" height="204" fill="#3f6b5c" stroke="#f4c66f" stroke-width="3" />
          <circle cx="118" cy="116" r="70" fill="#ebae51" />
          <circle cx="118" cy="116" r="42" fill="#b5462f" />
          <circle cx="118" cy="116" r="12" fill="#f7ead6" />
          <path d="M32 188H204" stroke="#f7ead6" stroke-width="8" />
          <text x="32" y="207" fill="#f7ead6" font-family="'DM Sans', sans-serif" font-size="12" font-weight="700" letter-spacing="3">SIDE A · HOME</text>
        </g>

        <ellipse cx="474" cy="817" rx="330" ry="45" fill="#4b2118" opacity=".34" />

        <g class="speaker" filter="url(#speaker-shadow)">
          <rect x="162" y="78" width="552" height="724" rx="24" fill="#3b1915" />
          <rect x="174" y="88" width="518" height="700" rx="18" fill="url(#speaker-wood)" />
          <path d="M671 101L692 88V788L671 772Z" fill="#3f1813" opacity=".72" />

          <g fill="none" stroke-linecap="round" opacity=".42" aria-hidden="true">
            <path d="M188 125C250 105 312 148 374 125S498 102 561 126S634 142 677 122" stroke="#ef9b5c" stroke-width="4" />
            <path d="M184 180C246 159 316 197 384 179S510 158 579 181S638 187 679 173" stroke="#592117" stroke-width="6" />
            <path d="M184 718C253 691 328 736 395 712S525 694 590 717S642 726 680 708" stroke="#e5814b" stroke-width="5" />
            <path d="M190 758C276 735 331 778 419 750S591 747 676 756" stroke="#4f1c16" stroke-width="4" />
          </g>

          <rect x="221" y="126" width="388" height="619" rx="9" fill="#58231f" />
          <rect x="232" y="137" width="366" height="597" rx="5" fill="url(#speaker-weave)" />
          <rect x="610" y="126" width="42" height="619" rx="4" fill="url(#speaker-brush)" />
          <rect x="619" y="149" width="24" height="66" rx="12" fill="#5e574d" opacity=".82" />
          <circle cx="631" cy="175" r="5" fill="#f7d391" />
          <text x="633" y="698" text-anchor="middle" fill="#3e352d" font-family="'DM Sans', sans-serif" font-size="11" font-weight="700" transform="rotate(-90 633 698)" letter-spacing="2.2">MOZZ · MZ 01</text>

          <circle cx="415" cy="274" r="92" fill="#221519" />
          <circle cx="415" cy="274" r="79" fill="#6d3029" />
          <circle cx="415" cy="274" r="63" fill="#201719" />
          <circle cx="415" cy="274" r="39" fill="url(#tweeter-dome)" />
          <circle cx="399" cy="257" r="9" fill="#fff5d6" opacity=".48" />

          <circle cx="415" cy="522" r="171" fill="#211417" />
          <circle cx="415" cy="522" r="154" fill="#71302a" />
          <circle class="woofer" cx="415" cy="522" r="137" fill="url(#woofer-cone)" />
          <circle class="woofer-cap" cx="415" cy="522" r="57" fill="url(#woofer-cap)" />
          <ellipse cx="380" cy="477" rx="43" ry="23" fill="#f39a6f" opacity=".16" transform="rotate(-25 380 477)" />

          <circle cx="245" cy="151" r="5" fill="#f6d38e" />
          <circle cx="585" cy="151" r="5" fill="#f6d38e" />
          <circle cx="245" cy="720" r="5" fill="#f6d38e" />
          <circle cx="585" cy="720" r="5" fill="#f6d38e" />
        </g>

        <rect y="786" width="1440" height="20" fill="#4b2118" />
        <rect y="806" width="1440" height="94" fill="#7a3523" />
        <path d="M0 816H1440" stroke="#c46a3d" stroke-width="8" opacity=".62" />
        <path d="M16 866C189 834 332 892 509 856S820 888 1000 852S1267 874 1440 844" fill="none" stroke="#4c2019" stroke-width="7" opacity=".42" />
      </svg>
    </div>

    <a class="wordmark" href="/" aria-label="Mozz home">
      <Mark size={31} decorative />
      <span>{NAME}</span>
    </a>

    <section class="copy" aria-labelledby="speaker-title">
      <p class="category">A self-hosted music player</p>
      <h1 id="speaker-title">
        <span>Fill the room</span>
        <span class="accent">with your own music.</span>
      </h1>
      <p class="lede">
        Mozz is a free player for the music on your own server. Stream on iPhone
        and iPad, or download albums before you head out.
      </p>

      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View the source</a>
      </div>

      <div class="compatibility" aria-label="Compatible servers">
        <span class="works">Works with</span>
        <span class="server"><ServerLogo name="Plex" size={22} brand /> Plex</span>
        <span class="server"><ServerLogo name="Jellyfin" size={22} brand /> Jellyfin</span>
        <span class="server"><ServerLogo name="Navidrome" size={22} brand /> Navidrome</span>
        <span class="subsonic">+ Subsonic</span>
      </div>
    </section>

    <p class="ownership">Free forever <span>·</span> Open source</p>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f7ead6;
  }

  :global(body) {
    margin: 0;
    overflow: hidden;
  }

  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 660px;
    overflow: hidden;
    color: #291914;
    background: #f7ead6;
    font-family: 'DM Sans', 'Avenir Next', sans-serif;
    isolation: isolate;
  }

  .sunwash {
    position: absolute;
    inset: 42px 0 0;
    z-index: 1;
    background:
      radial-gradient(circle at 68% 38%, rgba(255, 238, 166, 0.64), transparent 30%),
      linear-gradient(118deg, transparent 42%, rgba(255, 240, 192, 0.24) 43%, transparent 70%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .illustration {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .illustration svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wordmark {
    position: absolute;
    top: 68px;
    left: clamp(2rem, 4.5vw, 4.5rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    color: #291914;
    text-decoration: none;
  }

  .wordmark span {
    font: 400 clamp(1.35rem, 2vw, 1.75rem)/1 'Bowlby One', 'Arial Black', sans-serif;
    letter-spacing: -0.03em;
  }

  .wordmark:focus-visible,
  .source:focus-visible,
  .store:focus-visible {
    outline: 3px solid #c80028;
    outline-offset: 4px;
  }

  .copy {
    position: absolute;
    top: clamp(8.7rem, 19vh, 11rem);
    right: clamp(2.5rem, 6.2vw, 6.5rem);
    z-index: 3;
    width: min(42vw, 560px);
  }

  .category {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.15rem;
    color: #3f6b5c;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .category::before {
    width: 2.4rem;
    height: 0.48rem;
    background: #3f6b5c;
    border-radius: 1rem;
    content: '';
  }

  h1 {
    margin: 0;
    font: 400 clamp(3.9rem, 5.6vw, 5.6rem)/0.93 'Bowlby One', 'Arial Black', sans-serif;
    letter-spacing: -0.055em;
  }

  h1 span {
    display: block;
  }

  h1 .accent {
    max-width: 9ch;
    margin-top: 0.12em;
    color: #b5462f;
  }

  .lede {
    max-width: 31rem;
    margin: 1.45rem 0 0;
    color: #4d2e24;
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.48;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.55rem;
  }

  .store,
  .source {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.15rem;
    border: 2px solid #291914;
    border-radius: 0.45rem;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .store {
    color: #fff8ed;
    background: #291914;
  }

  .store.is-pending {
    cursor: default;
  }

  .source {
    color: #291914;
    background: rgba(247, 234, 214, 0.52);
  }

  .source:hover {
    color: #fff8ed;
    background: #b5462f;
    border-color: #b5462f;
  }

  .compatibility {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
    margin-top: 1.35rem;
    color: #4c3329;
    font-size: 0.73rem;
    font-weight: 650;
  }

  .works {
    color: #7b5946;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .server {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .subsonic {
    color: #7b5946;
  }

  .ownership {
    position: absolute;
    right: clamp(2.5rem, 6.2vw, 6.5rem);
    bottom: 2rem;
    z-index: 3;
    margin: 0;
    color: #f7ead6;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .ownership span {
    padding: 0 0.45rem;
    color: #efb650;
  }

  .air {
    animation: drift 6s ease-in-out infinite alternate;
  }

  .woofer,
  .woofer-cap {
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 3.8s ease-in-out infinite;
  }

  .plant {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: sway 7s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from { transform: translateX(-7px); opacity: 0.78; }
    to { transform: translateX(11px); opacity: 1; }
  }

  @keyframes breathe {
    0%, 100% { transform: scale(1); }
    52% { transform: scale(1.012); }
  }

  @keyframes sway {
    from { transform: rotate(-0.7deg); }
    to { transform: rotate(1.2deg); }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 620px;
    }

    .sunwash {
      background: radial-gradient(circle at 50% 72%, rgba(255, 233, 147, 0.72), transparent 42%);
    }

    .wordmark {
      top: 57px;
      left: 1.25rem;
      gap: 0.58rem;
    }

    .wordmark span {
      font-size: 1.26rem;
    }

    .copy {
      top: 6.45rem;
      right: auto;
      left: 1.25rem;
      width: calc(100% - 2.5rem);
    }

    .category {
      margin-bottom: 0.7rem;
      font-size: 0.65rem;
    }

    .category::before {
      width: 1.65rem;
      height: 0.36rem;
    }

    h1 {
      max-width: 9ch;
      font-size: clamp(2.65rem, 12.2vw, 3.4rem);
      line-height: 0.94;
    }

    h1 .accent {
      max-width: 9ch;
    }

    .lede {
      max-width: 35rem;
      margin-top: 0.78rem;
      font-size: 0.9rem;
      line-height: 1.38;
    }

    .actions {
      gap: 0.48rem;
      margin-top: 0.86rem;
    }

    .store,
    .source {
      min-height: 42px;
      padding: 0.58rem 0.78rem;
      font-size: 0.75rem;
    }

    .compatibility {
      gap: 0.45rem 0.72rem;
      margin-top: 0.72rem;
      font-size: 0.67rem;
    }

    .works {
      width: 100%;
      font-size: 0.58rem;
    }

    .compatibility :global(.server-logo) {
      width: 18px;
      height: 18px;
    }

    .illustration {
      top: 52%;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .illustration svg {
      position: absolute;
      left: 50%;
      width: auto;
      max-width: none;
      height: 100%;
      transform: translateX(-38%);
    }

    .ownership {
      right: 1rem;
      bottom: 0.78rem;
      font-size: 0.58rem;
    }
  }

  @media (max-width: 430px) and (max-height: 740px) {
    .copy {
      top: 5.9rem;
    }

    h1 {
      font-size: 2.35rem;
    }

    .lede {
      font-size: 0.82rem;
    }

    .compatibility {
      display: none;
    }

    .illustration {
      top: 46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .air,
    .woofer,
    .woofer-cap,
    .plant {
      animation: none;
    }
  }
</style>
