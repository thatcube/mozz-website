---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';
---

<Layout
  title={`${NAME} — free music from your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Stream from your own server or download albums for offline listening."
  themeColor="#3d1020"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="crop" />

  <main class="stage">
    <div
      class="album"
      role="img"
      aria-label="Abstract coral and peach album artwork for the fictional album Glasswork by Cinder Atlas"
    >
      <span class="album-block"></span>
      <span class="album-disc"></span>
      <span class="album-core"></span>
      <span class="album-cut"></span>
      <span class="album-credit">Cinder Atlas<br />Glasswork</span>
    </div>

    <section class="intro" aria-labelledby="site-title">
      <div class="brand">
        <Mark size={25} decorative />
        <strong>{NAME}</strong>
        <span>Self-hosted music player</span>
      </div>

      <h1 id="site-title">Free music from your own server.</h1>
      <p>Stream on iPhone and iPad, or download albums for offline listening.</p>

      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View on GitHub</a>
      </div>

      <div class="works" aria-label="Works with Plex, Jellyfin, Navidrome and Subsonic">
        <span class="works-label">Works with</span>
        <span class="server"><ServerLogo name="Plex" size={16} />Plex</span>
        <span class="server"><ServerLogo name="Jellyfin" size={16} />Jellyfin</span>
        <span class="server"><ServerLogo name="Navidrome" size={16} />Navidrome</span>
        <span class="server subsonic">Subsonic</span>
      </div>
    </section>

    <section class="player" aria-labelledby="track-title">
      <div class="track-copy">
        <span class="now-playing">Now playing · downloaded</span>
        <h2 id="track-title">A room left warm</h2>
        <p>Cinder Atlas <span>·</span> Glasswork</p>
      </div>

      <div class="scrubber" aria-label="Track progress, 2 minutes 18 seconds of 4 minutes 52 seconds">
        <span class="elapsed">2:18</span>
        <span class="rail" aria-hidden="true"><i></i><b></b></span>
        <span class="duration">−2:34</span>
      </div>

      <div class="controls" aria-hidden="true">
        <span class="skip back"></span>
        <span class="play"><i></i></span>
        <span class="skip next"></span>
      </div>

      <div class="player-foot" aria-hidden="true">
        <span>Lossless</span>
        <span class="queue-bars"><i></i><i></i><i></i><i></i></span>
        <span>Playing offline</span>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html),
  :global(body) {
    width: 100%;
    overflow: hidden;
    background: #3d1020;
  }

  .stage {
    --wine: #3d1020;
    --wine-deep: #1b0710;
    --coral: #ff5a5f;
    --peach: #ffd9c0;
    --cream: #fff5ed;
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    overflow: clip;
    color: var(--cream);
    background:
      radial-gradient(circle at 62% 14%, rgba(255, 90, 95, 0.19), transparent 33%),
      linear-gradient(147deg, #4b1025 0%, var(--wine) 43%, var(--wine-deep) 100%);
    font-family: 'IBM Plex Sans', 'Helvetica Neue', Arial;
  }

  .stage::after {
    position: absolute;
    inset: 42px 0 auto;
    z-index: 1;
    height: 38%;
    background: linear-gradient(to bottom, rgba(27, 7, 16, 0.16), transparent);
    content: '';
    pointer-events: none;
  }

  .album {
    position: absolute;
    top: clamp(-510px, -34vw, -230px);
    left: 50%;
    z-index: 0;
    width: clamp(680px, 78vw, 1120px);
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--wine);
    background: var(--coral);
    box-shadow: 0 70px 120px rgba(18, 1, 7, 0.44);
    transform: translateX(-50%) rotate(-7deg);
  }

  .album-block {
    position: absolute;
    inset: 0 auto 0 0;
    width: 33%;
    background: var(--wine);
  }

  .album-disc {
    position: absolute;
    right: -4%;
    bottom: -11%;
    width: 78%;
    aspect-ratio: 1;
    border: clamp(75px, 9vw, 138px) solid var(--peach);
    border-radius: 50%;
    background: var(--wine);
  }

  .album-core {
    position: absolute;
    right: 19%;
    bottom: 12%;
    width: 32%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--coral);
  }

  .album-cut {
    position: absolute;
    bottom: -9%;
    left: 10%;
    width: 22%;
    height: 88%;
    background: var(--peach);
    transform: rotate(34deg);
    transform-origin: bottom;
  }

  .album-credit {
    position: absolute;
    top: 14%;
    right: 9%;
    color: var(--peach);
    font: 600 clamp(11px, 1vw, 15px)/1.15 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
    transform: rotate(7deg);
  }

  .intro {
    position: absolute;
    top: 74px;
    right: clamp(22px, 4vw, 64px);
    z-index: 5;
    width: min(390px, calc(100% - 44px));
    padding: 21px 23px 20px;
    color: var(--cream);
    background: rgba(32, 5, 16, 0.88);
    border: 1px solid rgba(255, 217, 192, 0.18);
    border-radius: 18px;
    box-shadow: 0 24px 65px rgba(18, 1, 7, 0.28);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 15px;
  }

  .brand strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand > span:last-child {
    margin-left: auto;
    color: rgba(255, 245, 237, 0.64);
    font: 500 9px/1 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro h1 {
    max-width: 340px;
    font-size: clamp(25px, 2.1vw, 31px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .intro > p {
    max-width: 350px;
    margin-top: 10px;
    color: rgba(255, 245, 237, 0.74);
    font-size: 14px;
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-top: 15px;
  }

  .store,
  .source {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }

  .store {
    color: var(--wine-deep);
    background: var(--peach);
  }

  .store.is-pending {
    color: rgba(255, 245, 237, 0.7);
    background: rgba(255, 245, 237, 0.1);
    border: 1px solid rgba(255, 245, 237, 0.2);
  }

  .source {
    color: var(--cream);
    border: 1px solid rgba(255, 245, 237, 0.32);
  }

  .source:hover {
    background: rgba(255, 245, 237, 0.1);
  }

  .source:focus-visible,
  .store:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 3px;
  }

  .works {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 16px;
    color: rgba(255, 245, 237, 0.62);
    font-size: 9px;
    white-space: nowrap;
  }

  .works-label {
    color: var(--peach);
    font: 600 8px/1 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .server {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .subsonic {
    padding-left: 1px;
  }

  .player {
    position: absolute;
    inset: 42px 0 0;
    z-index: 2;
  }

  .track-copy {
    position: absolute;
    top: 38%;
    left: clamp(24px, 6vw, 90px);
    width: calc(100% - clamp(24px, 6vw, 90px));
  }

  .now-playing {
    display: block;
    margin: 0 0 14px 6px;
    color: var(--coral);
    font: 600 clamp(9px, 0.8vw, 12px)/1 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .track-copy h2 {
    margin: 0;
    color: var(--peach);
    font: italic 400 clamp(84px, 11.6vw, 176px)/0.78 'Instrument Serif', Georgia;
    letter-spacing: -0.055em;
    -webkit-text-stroke: clamp(1.5px, 0.18vw, 3px) rgba(27, 7, 16, 0.78);
    paint-order: stroke fill;
    white-space: nowrap;
    text-shadow: 0 14px 45px rgba(20, 1, 7, 0.28);
  }

  .track-copy p {
    margin: 20px 0 0 7px;
    color: rgba(255, 245, 237, 0.7);
    font: 500 clamp(11px, 1vw, 15px)/1 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.04em;
  }

  .track-copy p span {
    padding: 0 6px;
    color: var(--coral);
  }

  .scrubber {
    position: absolute;
    top: 63%;
    right: clamp(24px, 6vw, 90px);
    left: clamp(24px, 6vw, 90px);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 17px;
    color: rgba(255, 245, 237, 0.7);
    font: 500 clamp(10px, 0.8vw, 12px)/1 'IBM Plex Mono', 'Courier New';
  }

  .rail {
    position: relative;
    display: block;
    height: 8px;
    overflow: visible;
    border-radius: 999px;
    background: rgba(255, 217, 192, 0.2);
  }

  .rail i {
    position: absolute;
    inset: 0 52% 0 0;
    border-radius: inherit;
    background: var(--peach);
  }

  .rail b {
    position: absolute;
    top: 50%;
    left: 48%;
    width: 24px;
    height: 24px;
    border: 6px solid var(--peach);
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 8px rgba(255, 90, 95, 0.13);
    transform: translate(-50%, -50%);
    animation: breathe 2.8s ease-in-out infinite;
  }

  .controls {
    position: absolute;
    top: 70%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: clamp(28px, 5vw, 76px);
    transform: translateX(-50%);
  }

  .play {
    position: relative;
    display: block;
    width: clamp(142px, 14vw, 206px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 32px 80px rgba(20, 1, 7, 0.32);
  }

  .play i {
    position: absolute;
    inset: 34% 33%;
    border-right: 15px solid var(--wine-deep);
    border-left: 15px solid var(--wine-deep);
  }

  .skip {
    position: relative;
    display: block;
    width: clamp(54px, 5vw, 72px);
    aspect-ratio: 1;
  }

  .skip::before,
  .skip::after {
    position: absolute;
    top: 50%;
    content: '';
    transform: translateY(-50%);
  }

  .skip::before {
    left: 13%;
    border-top: 20px solid transparent;
    border-right: 31px solid var(--peach);
    border-bottom: 20px solid transparent;
  }

  .skip::after {
    left: 10%;
    width: 7px;
    height: 42px;
    border-radius: 4px;
    background: var(--peach);
  }

  .skip.next {
    transform: rotate(180deg);
  }

  .player-foot {
    position: absolute;
    right: clamp(24px, 6vw, 90px);
    bottom: 20px;
    left: clamp(24px, 6vw, 90px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    color: rgba(255, 245, 237, 0.44);
    font: 600 9px/1 'IBM Plex Mono', 'Courier New';
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .queue-bars {
    display: flex;
    height: 19px;
    align-items: flex-end;
    gap: 4px;
  }

  .queue-bars i {
    width: 4px;
    border-radius: 3px;
    background: var(--coral);
  }

  .queue-bars i:nth-child(1) { height: 8px; }
  .queue-bars i:nth-child(2) { height: 17px; }
  .queue-bars i:nth-child(3) { height: 12px; }
  .queue-bars i:nth-child(4) { height: 5px; }

  @keyframes breathe {
    50% { box-shadow: 0 0 0 13px rgba(255, 90, 95, 0.04); }
  }

  @media (max-width: 700px) {
    .stage {
      min-height: 680px;
    }

    .stage::after {
      height: 48%;
    }

    .album {
      top: -330px;
      width: 670px;
    }

    .intro {
      top: 57px;
      right: 16px;
      width: calc(100% - 32px);
      padding: 15px 16px 14px;
      border-radius: 15px;
    }

    .brand {
      margin-bottom: 10px;
    }

    .brand strong {
      font-size: 17px;
    }

    .brand > span:last-child {
      font-size: 7px;
    }

    .intro h1 {
      max-width: none;
      font-size: 23px;
    }

    .intro > p {
      margin-top: 7px;
      font-size: 12px;
      line-height: 1.35;
    }

    .actions {
      gap: 7px;
      margin-top: 10px;
    }

    .store,
    .source {
      min-height: 32px;
      padding: 0 11px;
      font-size: 10px;
    }

    .works {
      justify-content: space-between;
      gap: 5px;
      margin-top: 11px;
      font-size: 7px;
    }

    .works-label {
      font-size: 7px;
    }

    .server {
      gap: 2px;
    }

    .server :global(svg) {
      width: 11px;
      height: 11px;
    }

    .track-copy {
      top: 36%;
      left: 20px;
      width: calc(100% - 20px);
    }

    .now-playing {
      margin: 0 0 11px 3px;
      font-size: 8px;
    }

    .track-copy h2 {
      width: 430px;
      font-size: 79px;
      line-height: 0.76;
      white-space: normal;
    }

    .track-copy p {
      margin: 14px 0 0 4px;
      font-size: 9px;
    }

    .scrubber {
      top: 61%;
      right: 20px;
      left: 20px;
      gap: 9px;
      font-size: 8px;
    }

    .rail {
      height: 6px;
    }

    .rail b {
      width: 18px;
      height: 18px;
      border-width: 5px;
    }

    .controls {
      top: 68%;
      gap: 23px;
    }

    .play {
      width: 132px;
    }

    .play i {
      border-right-width: 11px;
      border-left-width: 11px;
    }

    .skip {
      width: 48px;
    }

    .skip::before {
      border-top-width: 15px;
      border-right-width: 24px;
      border-bottom-width: 15px;
    }

    .skip::after {
      width: 5px;
      height: 32px;
    }

    .player-foot {
      right: 20px;
      bottom: 15px;
      left: 20px;
      font-size: 7px;
    }
  }

  @media (max-height: 720px) {
    .intro {
      top: 54px;
    }

    .track-copy {
      top: 37%;
    }

    .scrubber {
      top: 62%;
    }

    .controls {
      top: 69%;
    }

    .player-foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail b {
      animation: none;
    }
  }
</style>
