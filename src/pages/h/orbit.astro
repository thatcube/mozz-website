---
/**
 * HERO STUDY — ORBIT
 *
 * THESIS: one player, your own server, on or off the network. Said plainly.
 *
 * OWN WORLD: a pale daytime field, not space. The hero is a single thin
 * orbital plate drawn the way a diagram is drawn — hairlines, upright labels,
 * no shading, no glow. Three colours carry it: a near-white ground, slate-blue
 * ink for every line and label, and brand red for the record at the centre.
 *
 * WHAT IT MEANS: the record is Mozz. The phone runs it. The solid orbit is
 * playing from your server; the dotted marker docked to the phone is the same
 * music downloaded, still playing with the network gone. That is the whole
 * claim, and the drawing says nothing the sentence does not.
 *
 * WHAT IT DELIBERATELY DOES NOT MEAN: it is not three sources converging.
 * Almost everyone runs one server. Plex, Jellyfin and Navidrome are therefore
 * a compatibility checklist, set as quiet marks under the sentence — proof
 * that your server is supported, not a feature about merging libraries.
 *
 * COMPOSITION: the plate is centred and fills the viewport; the words live in
 * the emptiness above and below it, never beside it. Two geometries are
 * authored — a wide plate for landscape, a rounder one for portrait — so the
 * diagram is re-composed on narrow screens rather than shrunk into illegibility.
 *
 * MOTION: the orbits draw themselves once, faintly staggered, and then stop.
 * Nothing loops. Under prefers-reduced-motion they are simply already drawn.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { APP_STORE_URL, GITHUB_URL, NAME, SERVERS } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';

const rad = (deg: number) => (deg * Math.PI) / 180;

/** The phone's position on its orbit. One angle serves both plates. */
const PHONE_ANGLE = 166;

const STREAMS = ['streams from', 'your server'];
const OFFLINE = 'downloaded · plays offline';
const CENTRE = 'your library';

interface PlateConfig {
  id: string;
  /** viewBox, authored tight to the drawing so the plate renders as large as the row allows. */
  w: number;
  h: number;
  cx: number;
  cy: number;
  /** Flattening of the orbital plane: 1 would be a plan view, 0 an edge-on line. */
  k: number;
  /** Concentric hairlines. They read as orbits and as the record's own grooves. */
  rings: number[];
  /** Which radius the phone sits on. */
  phoneR: number;
  record: number;
  discLabel: number;
  mark: number;
  phoneW: number;
  phoneH: number;
  moonR: number;
  moonDx: number;
  moonDy: number;
  font: number;
  fontSm: number;
  hair: number;
}

const LAND: PlateConfig = {
  id: 'land',
  w: 1600, h: 640, cx: 800, cy: 320, k: 0.38,
  rings: [212, 330, 448, 566, 684],
  phoneR: 330,
  record: 124, discLabel: 48, mark: 36,
  phoneW: 66, phoneH: 122,
  moonR: 30, moonDx: 72, moonDy: 60,
  font: 21, fontSm: 18, hair: 1.6,
};

const PORT: PlateConfig = {
  id: 'port',
  w: 760, h: 620, cx: 380, cy: 310, k: 0.68,
  rings: [150, 200, 252, 304, 352],
  phoneR: 200,
  record: 104, discLabel: 44, mark: 33,
  phoneW: 58, phoneH: 108,
  moonR: 27, moonDx: 66, moonDy: 58,
  font: 25, fontSm: 21, hair: 2.8,
};

function compose(c: PlateConfig) {
  /** A point on a tilted orbit: the ellipse is a circle, seen from above at an angle. */
  const at = (r: number, deg: number) => ({
    x: c.cx + r * Math.cos(rad(deg)),
    y: c.cy + r * c.k * Math.sin(rad(deg)),
  });

  const phone = at(c.phoneR, PHONE_ANGLE);
  const moon = { x: phone.x - c.moonDx, y: phone.y + c.moonDy };

  /* Mono labels are wider than they look; clamp them so neither plate clips one. */
  const fit = (text: string, size: number, x: number) => {
    const half = text.length * size * 0.3;
    return Math.min(Math.max(x, half + c.font), c.w - half - c.font);
  };

  return {
    c,
    phone,
    moon,
    streamsX: fit(STREAMS[0], c.font, phone.x),
    offlineX: fit(OFFLINE, c.fontSm, moon.x),
  };
}

const PLATES = [compose(LAND), compose(PORT)];

const SCENE =
  'A thin orbital diagram on a pale field: a red Mozz record labelled “your library” at the centre, ringed by hairline orbits, with a phone travelling one of them. The phone streams from your server, and a dotted marker docked beside it stands for a downloaded album that keeps playing offline.';
---

<Layout
  title={`Orbit — a ${NAME} hero study`}
  description={HERO_COPY.body}
  themeColor="#f7f8f5"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
    <link href="https://api.fontshare.com/v2/css?f[]=gambetta@400,500&display=swap" rel="stylesheet" />
  </Fragment>

  <HeroBar slug="orbit" />

  <main class="orb">
    <div class="stage">
      <div class="meta">
        <a class="lockup" href="/" aria-label={`${NAME} home`}>
          <Mark size={30} decorative />
          <span>{NAME}</span>
        </a>
      </div>

      <h1>{HERO_COPY.headline}</h1>

      <div class="field">
        {PLATES.map((p) => (
          <svg
            class={`plate is-${p.c.id}`}
            viewBox={`0 0 ${p.c.w} ${p.c.h}`}
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label={SCENE}
          >
            <defs>
              <linearGradient id={`${p.c.id}-wax`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#d2102f" />
                <stop offset="1" stop-color="#a80020" />
              </linearGradient>
            </defs>

            {/* the orbits — hairlines that double as the record's grooves */}
            <g class="orbits">
              {p.c.rings.map((r, i) => (
                <ellipse
                  cx={p.c.cx} cy={p.c.cy}
                  rx={r} ry={r * p.c.k}
                  pathLength="1000"
                  stroke-width={p.c.hair}
                  style={`animation-delay:${(0.15 + i * 0.11).toFixed(2)}s`}
                />
              ))}
            </g>

            {/* the centre: the player itself */}
            <g class="record">
              <ellipse
                cx={p.c.cx} cy={p.c.cy}
                rx={p.c.record} ry={p.c.record * p.c.k}
                fill={`url(#${p.c.id}-wax)`}
              />
              {[0.88, 0.76, 0.64, 0.52].map((g) => (
                <ellipse
                  class="groove"
                  cx={p.c.cx} cy={p.c.cy}
                  rx={p.c.record * g} ry={p.c.record * g * p.c.k}
                  stroke-width={p.c.hair * 0.7}
                />
              ))}
              <ellipse
                class="rim"
                cx={p.c.cx} cy={p.c.cy}
                rx={p.c.record} ry={p.c.record * p.c.k}
                stroke-width={p.c.hair * 0.8}
              />
              <ellipse
                class="disc-label"
                cx={p.c.cx} cy={p.c.cy}
                rx={p.c.discLabel} ry={p.c.discLabel * p.c.k}
              />
              <foreignObject
                x={p.c.cx - p.c.mark / 2}
                y={p.c.cy - p.c.mark / 2}
                width={p.c.mark}
                height={p.c.mark}
              >
                <Mark size={p.c.mark} decorative />
              </foreignObject>
            </g>

            {/* the phone, on an orbit of its own */}
            <g class="phone" transform={`translate(${p.phone.x.toFixed(1)} ${p.phone.y.toFixed(1)})`}>
              <rect
                class="shell"
                x={-p.c.phoneW / 2} y={-p.c.phoneH / 2}
                width={p.c.phoneW} height={p.c.phoneH}
                rx={p.c.phoneW * 0.22}
                stroke-width={p.c.hair}
              />
              <rect
                class="cover"
                x={-p.c.phoneW * 0.28} y={-p.c.phoneH * 0.3}
                width={p.c.phoneW * 0.56} height={p.c.phoneW * 0.56}
                rx={p.c.phoneW * 0.08}
              />
              <path
                class="rule"
                d={`M${-p.c.phoneW * 0.28} ${p.c.phoneH * 0.06} H${p.c.phoneW * 0.28} M${-p.c.phoneW * 0.28} ${p.c.phoneH * 0.15} H${p.c.phoneW * 0.1}`}
                stroke-width={p.c.hair}
              />
              <path
                class="rule"
                d={`M${-p.c.phoneW * 0.28} ${p.c.phoneH * 0.3} H${p.c.phoneW * 0.28}`}
                stroke-width={p.c.hair * 1.6}
              />
              <path
                class="played"
                d={`M${-p.c.phoneW * 0.28} ${p.c.phoneH * 0.3} H${-p.c.phoneW * 0.02}`}
                stroke-width={p.c.hair * 1.6}
              />
            </g>

            {/* the downloaded album, docked to the phone */}
            <g class="moon">
              <path
                class="dock"
                d={`M${(p.phone.x - p.c.phoneW / 2).toFixed(1)} ${(p.phone.y + p.c.phoneH * 0.28).toFixed(1)} L${(p.moon.x + p.c.moonR * 0.9).toFixed(1)} ${(p.moon.y - p.c.moonR * 0.5).toFixed(1)}`}
                stroke-width={p.c.hair}
              />
              <circle class="moon-ring" cx={p.moon.x} cy={p.moon.y} r={p.c.moonR} stroke-width={p.c.hair} />
              <path
                class="down"
                d={`M${p.moon.x} ${p.moon.y - p.c.moonR * 0.42} V${p.moon.y + p.c.moonR * 0.24} M${p.moon.x - p.c.moonR * 0.3} ${p.moon.y - p.c.moonR * 0.06} L${p.moon.x} ${p.moon.y + p.c.moonR * 0.24} L${p.moon.x + p.c.moonR * 0.3} ${p.moon.y - p.c.moonR * 0.06}`}
                stroke-width={p.c.hair}
              />
            </g>

            {/* three plain annotations: what it is, and the two ways it plays */}
            <g class="labels">
              <text
                class="lbl"
                x={p.c.cx + p.c.record + p.c.font * 1.1}
                y={p.c.cy + p.c.font * 0.34}
                font-size={p.c.font}
                text-anchor="start"
              >
                {CENTRE}
              </text>
              <text
                class="lbl"
                x={p.streamsX}
                y={p.phone.y - p.c.phoneH / 2 - p.c.font * 0.85}
                font-size={p.c.font}
                text-anchor="middle"
              >
                <tspan x={p.streamsX} dy={-p.c.font * 1.15}>{STREAMS[0]}</tspan>
                <tspan x={p.streamsX} dy={p.c.font * 1.15}>{STREAMS[1]}</tspan>
              </text>
              <text
                class="lbl sm"
                x={p.offlineX}
                y={p.moon.y + p.c.moonR + p.c.fontSm * 1.6}
                font-size={p.c.fontSm}
                text-anchor="middle"
              >
                {OFFLINE}
              </text>
            </g>
          </svg>
        ))}
      </div>

      <div class="say">
        <p class="lede">{HERO_COPY.body}</p>

        <p class="works">
          <span class="works-label">Works with</span>
          {SERVERS.map((s) => (
            <span class="chip">
              <ServerLogo name={s.name} size={17} brand />
            </span>
          ))}
        </p>

        <div class="actions">
          {
            APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL} aria-label={`Download ${NAME} on the App Store`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.1 12.7c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.1-2.8.9-3.5.9-.8 0-1.9-.9-3.1-.9a4.6 4.6 0 0 0-3.9 2.4c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 3 2.3 1.2 0 1.6-.7 3.1-.7 1.4 0 1.8.7 3.1.7 1.3 0 2.1-1.1 2.9-2.3.9-1.3 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-3.8ZM14.8 5.9c.6-.8 1-1.9.9-2.9-1 0-2.2.7-2.9 1.4-.6.7-1.1 1.8-1 2.8 1.1.1 2.3-.5 3-1.3Z" />
                </svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store pending" aria-disabled="true" aria-label="App Store download coming soon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.1 12.7c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.1-2.8.9-3.5.9-.8 0-1.9-.9-3.1-.9a4.6 4.6 0 0 0-3.9 2.4c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 3 2.3 1.2 0 1.6-.7 3.1-.7 1.4 0 1.8.7 3.1.7 1.3 0 2.1-1.1 2.9-2.3.9-1.3 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-3.8ZM14.8 5.9c.6-.8 1-1.9.9-2.9-1 0-2.2.7-2.9 1.4-.6.7-1.1 1.8-1 2.8 1.1.1 2.3-.5 3-1.3Z" />
                </svg>
                <span><small>Coming soon to the</small>App Store</span>
              </span>
            )
          }

          <a class="src" href={GITHUB_URL}>
            Read the source
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" /></svg>
          </a>
        </div>

        <p class="fine">{HERO_COPY.support}</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .orb {
    --field: #f7f8f5;
    --ink: #232a33;
    --body: #444e5e;
    --slate: #4b5f86;
    --line: #9fb2d2;
    --red: #c80028;

    min-height: 100svh;
    display: grid;
    padding:
      calc(42px + clamp(0.7rem, 2.2vh, 1.5rem))
      clamp(1rem, 4vw, 3.2rem)
      clamp(1.1rem, 2.6vh, 2.1rem);
    background:
      radial-gradient(130% 96% at 50% 44%, #ffffff 0%, #fcfcfa 46%, var(--field) 100%);
    color: var(--body);
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .stage {
    width: min(1560px, 100%);
    margin-inline: auto;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    row-gap: clamp(0.7rem, 2.2vh, 1.6rem);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 500;
    font-size: 1.16rem;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  h1 {
    max-width: 20ch;
    margin-inline: auto;
    font-family: 'Gambetta', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(1.95rem, min(4.2vw, 6vh), 3.05rem);
    line-height: 1.06;
    letter-spacing: -0.012em;
    text-align: center;
    text-wrap: balance;
    color: var(--ink);
  }

  /* The plate takes every pixel the two text blocks leave behind. Absolute so
     the SVG's own intrinsic ratio can never push the hero past a viewport:
     the row decides the size, not the drawing. */
  .field {
    position: relative;
    min-height: clamp(230px, 40vh, 620px);
  }

  .plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .is-port { display: none; }

  /* --- the diagram's own ink ------------------------------------------- */

  .orbits ellipse {
    fill: none;
    stroke: var(--line);
    opacity: 0.85;
    stroke-dasharray: 1000;
    animation: orb-draw 1.9s cubic-bezier(0.16, 0.8, 0.3, 1) both;
  }

  .groove {
    fill: none;
    stroke: #ffffff;
    opacity: 0.16;
  }

  .rim {
    fill: none;
    stroke: #7a0018;
    opacity: 0.25;
  }

  .disc-label { fill: #ffffff; }

  .phone .shell {
    fill: #ffffff;
    stroke: #6a7c9e;
  }

  .phone .cover { fill: var(--red); opacity: 0.9; }
  .phone .rule { fill: none; stroke: var(--line); stroke-linecap: round; }
  .phone .played { fill: none; stroke: var(--red); stroke-linecap: round; }

  .moon-ring,
  .dock {
    fill: none;
    stroke: #7185a8;
    stroke-linecap: round;
    stroke-dasharray: 0.1 7;
  }

  .down {
    fill: none;
    stroke: #7185a8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lbl {
    fill: var(--slate);
    font-family: 'DM Mono', ui-monospace, monospace;
    letter-spacing: 0.02em;
    /* a paper halo so a label never fights the hairline it crosses */
    paint-order: stroke fill;
    stroke: var(--paper);
    stroke-width: 7;
    stroke-linejoin: round;
  }

  .lbl.sm { opacity: 0.72; }

  /* --- the words, in the space the plate leaves -------------------------- */

  .say {
    display: grid;
    justify-items: center;
    row-gap: clamp(0.55rem, 1.6vh, 1.1rem);
    text-align: center;
  }

  .lede {
    max-width: 56ch;
    font-size: clamp(0.95rem, 1.15vw, 1.09rem);
    line-height: 1.55;
  }

  /* The compatibility checklist: quiet marks, not a feature. */
  .works {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem 0.55rem;
    color: var(--slate);
  }

  .works-label {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    opacity: 0.78;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    opacity: 0.9;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem 1.1rem;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.62rem 1.15rem;
    border-radius: 12px;
    background: var(--ink);
    color: #fbfbf9;
    line-height: 1.05;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .store svg { width: 21px; height: 21px; fill: currentColor; }
  .store span { display: grid; font-size: 1.02rem; font-weight: 500; }
  .store small {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  a.store:hover { transform: translateY(-1px); background: #101820; }

  .store.pending {
    background: transparent;
    color: var(--slate);
    border: 1px dashed rgba(75, 95, 134, 0.5);
    cursor: default;
  }

  .src {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.94rem;
    color: var(--slate);
    border-bottom: 1px solid rgba(75, 95, 134, 0.28);
    padding-bottom: 1px;
  }

  .src svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .src:hover { color: var(--red); border-bottom-color: currentColor; }

  .fine {
    max-width: 48ch;
    font-size: 0.79rem;
    line-height: 1.5;
    color: var(--slate);
    opacity: 0.72;
  }

  :where(a, span).store:focus-visible,
  .src:focus-visible,
  .lockup:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* --- motion ------------------------------------------------------------ */

  @keyframes orb-draw {
    from { stroke-dashoffset: 1000; }
    to { stroke-dashoffset: 0; }
  }

  /* --- portrait: the same system, re-composed rather than shrunk --------- */

  @media (max-width: 880px) {
    .is-land { display: none; }
    .is-port { display: block; }

    .stage { row-gap: clamp(0.6rem, 1.8vh, 1.1rem); }
    h1 { max-width: 15ch; }
    .field {
      min-height: clamp(300px, 38vh, 460px);
      max-inline-size: 660px;
      margin-inline: auto;
      inline-size: 100%;
    }
    .lede { max-width: 42ch; }
  }

  @media (max-width: 420px) {
    .actions { flex-direction: column; gap: 0.75rem; }
    .fine { font-size: 0.74rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbits ellipse {
      animation: none;
      stroke-dashoffset: 0;
    }

    a.store:hover { transform: none; }
  }
</style>
