---
/**
 * Split — two flat fields meeting at a hard edge.
 *
 * The left field is the app itself, drawn at poster scale and running off the
 * top and bottom of the window: no device, no shadow, no white space around it.
 * The right field is one plane of yellow carrying the sentence. The wordmark
 * straddles the seam, so the two halves are one picture rather than two columns.
 *
 * Every record named here is invented.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

const NOW = {
  title: 'Slow Kettle',
  artist: 'Halden Rill',
  album: 'Paper Weather',
  elapsed: '1:47',
  remaining: '-2:25',
  next: 'Harbour Light',
};

const COPY = {
  headline: ['Your server has the music.', `${NAME} is the player.`],
  body: 'Free and open source. Point it at Plex, Jellyfin, Navidrome or any Subsonic server, then stream at home — or download an album and play it with no signal at all.',
  support: 'Radio and Mozz Weekly are included. No account, no tracking, no subscription.',
};

const SCREEN_LABEL = `The ${NAME} now playing screen at full height: an album cover, the track title ${NOW.title} by ${NOW.artist}, a progress bar and the play controls.`;
---

<Layout
  title={`${NAME} — a free player for your self-hosted music`}
  description="Mozz is a free, open source music player for iPhone and iPad. It plays the library on your own Plex, Jellyfin, Navidrome or Subsonic server, at home or downloaded for offline."
  themeColor="#134e4a"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="split" />

  <main class="split">
    <!-- FIELD ONE: the interface, floor to ceiling. -->
    <section class="field field--app">
      <div class="screen" role="img" aria-label={SCREEN_LABEL}>
        <header class="bar">
          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 9.5 12 15.5 18 9.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="source">Now playing</p>
          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="5" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="19" cy="12" r="1.7" />
          </svg>
        </header>

        <div class="art">
          <svg class="cover" viewBox="0 0 300 300" aria-hidden="true">
            <defs>
              <linearGradient id="sp-sky" x1="0" y1="0" x2="0.25" y2="1">
                <stop offset="0" stop-color="#0a2b2a" />
                <stop offset="52%" stop-color="#14514a" />
                <stop offset="100%" stop-color="#8f2412" />
              </linearGradient>
              <linearGradient id="sp-sun" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffe27a" />
                <stop offset="46%" stop-color="#f5b700" />
                <stop offset="100%" stop-color="#c80028" />
              </linearGradient>
              <clipPath id="sp-disc"><circle cx="120" cy="176" r="96" /></clipPath>
            </defs>
            <rect width="300" height="300" fill="url(#sp-sky)" />
            <circle cx="120" cy="176" r="96" fill="url(#sp-sun)" />
            <g clip-path="url(#sp-disc)" fill="#0a2b2a" opacity="0.9">
              <rect x="0" y="198" width="300" height="10" />
              <rect x="0" y="220" width="300" height="14" />
              <rect x="0" y="246" width="300" height="19" />
            </g>
            <path d="M0 272h300" stroke="#f6f4ee" stroke-width="2" opacity="0.45" />
            <g fill="#f6f4ee" font-family="'Schibsted Grotesk', system-ui" font-size="12.5" letter-spacing="1.6">
              <text x="26" y="44">HALDEN RILL</text>
              <text x="274" y="292" text-anchor="end" opacity="0.7">PAPER WEATHER</text>
            </g>
          </svg>
        </div>

        <div class="meta">
          <p class="track">{NOW.title}</p>
          <p class="by">{NOW.artist} — {NOW.album}</p>
          <p class="cue">
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
            From Jellyfin
            <span class="chip"><span class="tick" aria-hidden="true"></span>Downloaded</span>
          </p>
        </div>

        <div class="scrub">
          <div class="rail"><span class="fill"></span><span class="knob"></span></div>
          <p class="times"><span>{NOW.elapsed}</span><span>{NOW.remaining}</span></p>
        </div>

        <div class="transport">
          <svg class="small" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6h4l10 12h4M17 4l3.5 2L17 8M17 16l3.5 2L17 20M3 18h4l2.4-2.9" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="step" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 5 9 12l11 7z" /><rect x="4" y="5" width="2.8" height="14" rx="1.2" />
          </svg>
          <span class="play">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.4 19 12 8 18.6z" /></svg>
          </span>
          <svg class="step" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 5 15 12 4 19z" /><rect x="17.2" y="5" width="2.8" height="14" rx="1.2" />
          </svg>
          <svg class="small" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 7h11a3 3 0 0 1 3 3v1M18 17H7a3 3 0 0 1-3-3v-1M8.5 4.5 6 7l2.5 2.5M15.5 14.5 18 17l-2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="vol">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6.5 9H3v6h3.5L11 19z" /></svg>
          <div class="rail rail--vol"><span class="fill"></span><span class="knob"></span></div>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11 5 6.5 9H3v6h3.5L11 19z" />
            <path d="M14.5 8.6a4.6 4.6 0 0 1 0 6.8M17.4 5.8a8.6 8.6 0 0 1 0 12.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </div>

        <p class="upnext"><span>Up next</span> {NOW.next} — {NOW.artist}</p>
      </div>

      <span class="seam seam--app" aria-hidden="true"><span class="seam-word">{NAME}</span></span>
    </section>

    <!-- FIELD TWO: flat colour and the sentence. -->
    <section class="field field--say">
      <span class="seam seam--say" aria-hidden="true"><span class="seam-word">{NAME}</span></span>

      <div class="say">
        <p class="eyebrow"><Mark size={24} decorative /><span>Self-hosted music player<span class="eyebrow-tail"> for iPhone and iPad</span></span></p>

        <h1>{COPY.headline[0]}<br />{COPY.headline[1]}</h1>

        <p class="lede">{COPY.body}</p>
        <p class="support">{COPY.support}</p>

        <div class="actions">
          <a class="btn" href={GITHUB_URL}>Source on GitHub</a>
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
          ) : (
            <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
          )}
        </div>
      </div>

      <p class="works">
        <span class="works-label">Works with</span>
        <ServerLogo name="Plex" size={19} />
        <ServerLogo name="Jellyfin" size={19} />
        <ServerLogo name="Navidrome" size={19} />
        <span class="sub">Subsonic</span>
      </p>
    </section>
  </main>
</Layout>

<style>
  .split {
    --ink: #0d3a36;
    --green: #134e4a;
    --deep: #0c322f;
    --yellow: #f5b700;
    --cream: #f6f4ee;
    --red: #c80028;
    --seam: 44%;
    --sw: 8rem;

    position: relative;
    display: grid;
    grid-template-columns: var(--seam) 1fr;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: var(--yellow);
    color: var(--ink);
    font-family: 'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif;
  }

  .field {
    position: relative;
    overflow: hidden;
  }

  /* ---------- field one: the interface ---------- */

  .field--app {
    background: var(--green);
    background-image: radial-gradient(135% 78% at 26% 30%, #17605a 0%, var(--green) 52%, var(--deep) 100%);
    color: var(--cream);
  }

  .screen {
    container-type: inline-size;
    position: absolute;
    inset-inline: 0;
    top: 50%;
    transform: translateY(calc(-50% + var(--nudge, -4rem)));
    padding-inline: 6%;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding-bottom: 5cqw;
  }

  .bar .glyph {
    width: 6.4cqw;
    height: 6.4cqw;
    opacity: 0.72;
    flex: none;
  }

  .source {
    flex: 1;
    text-align: center;
    font-size: 3.2cqw;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
    white-space: nowrap;
  }

  .eq {
    display: flex;
    align-items: flex-end;
    gap: 0.7cqw;
    height: 3.6cqw;
  }

  .eq i {
    display: block;
    width: 0.8cqw;
    height: 40%;
    background: var(--yellow);
    border-radius: 0.4cqw;
    animation: sp-eq 1.1s ease-in-out infinite alternate;
  }

  .eq i:nth-child(2) { animation-delay: 0.22s; height: 100%; }
  .eq i:nth-child(3) { animation-delay: 0.44s; height: 65%; }

  @keyframes sp-eq {
    from { transform: scaleY(0.42); }
    to { transform: scaleY(1); }
  }


  .cover {
    width: 100%;
    height: auto;
    border-radius: 1.8cqw;
    box-shadow: 0 3cqw 8cqw rgba(4, 18, 16, 0.42);
  }

  .cue {
    display: flex;
    align-items: center;
    gap: 2.2cqw;
    padding-top: 3.4cqw;
    font-size: 3.3cqw;
    font-weight: 500;
    opacity: 0.72;
    white-space: nowrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 1.4cqw;
    margin-left: 1cqw;
    padding: 1.1cqw 2.6cqw;
    border-radius: 99cqw;
    background: rgba(246, 244, 238, 0.14);
    font-size: 3cqw;
    font-weight: 600;
  }

  .tick {
    width: 2.6cqw;
    height: 2.6cqw;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: inset 0 0 0 0.7cqw var(--deep);
  }

  .meta {
    padding-top: 6.5cqw;
  }

  .track {
    font-family: 'Bricolage Grotesque', 'Schibsted Grotesk', system-ui, sans-serif;
    font-size: 9.4cqw;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .by {
    padding-top: 1.8cqw;
    font-size: 4.4cqw;
    opacity: 0.66;
  }

  .scrub {
    padding-top: 7cqw;
  }

  .rail {
    position: relative;
    height: 1.1cqw;
    border-radius: 99cqw;
    background: rgba(246, 244, 238, 0.24);
  }

  .rail .fill {
    position: absolute;
    inset: 0 58% 0 0;
    border-radius: inherit;
    background: var(--cream);
  }

  .rail .knob {
    position: absolute;
    top: 50%;
    left: 42%;
    width: 3.1cqw;
    height: 3.1cqw;
    margin: -1.55cqw 0 0 -1.55cqw;
    border-radius: 50%;
    background: var(--cream);
  }

  .times {
    display: flex;
    justify-content: space-between;
    padding-top: 2.6cqw;
    font-size: 3.2cqw;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .transport {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 6.5cqw;
  }

  .transport svg { fill: currentColor; }
  .transport .small { width: 6.2cqw; height: 6.2cqw; opacity: 0.68; }
  .transport .step { width: 10cqw; height: 10cqw; }

  .play {
    display: grid;
    place-items: center;
    width: 21cqw;
    height: 21cqw;
    border-radius: 50%;
    background: var(--cream);
    color: var(--deep);
  }

  .play svg {
    width: 9cqw;
    height: 9cqw;
    margin-left: 0.8cqw;
    fill: currentColor;
  }

  .vol {
    display: flex;
    align-items: center;
    gap: 3.4cqw;
    padding-top: 7cqw;
    opacity: 0.55;
  }

  .vol svg { width: 5cqw; height: 5cqw; flex: none; fill: currentColor; }
  .rail--vol { flex: 1; }
  .rail--vol .fill { inset: 0 34% 0 0; }
  .rail--vol .knob { left: 66%; }

  .upnext {
    display: flex;
    align-items: baseline;
    gap: 2.4cqw;
    padding-top: 7cqw;
    font-size: 3.5cqw;
    opacity: 0.62;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .upnext span {
    font-size: 2.8cqw;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  /* ---------- the wordmark sitting on the seam ---------- */

  .seam {
    position: absolute;
    top: 0;
    height: 100%;
    width: var(--sw);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .seam--app { right: calc(var(--sw) / -2); color: var(--cream); }
  .seam--say { left: calc(var(--sw) / -2); color: var(--ink); }

  .seam-word {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: 7rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  /* ---------- field two: the sentence ---------- */

  .field--say {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding: 3.5rem clamp(1.5rem, 3.2vw, 3.6rem) 2.2rem clamp(2rem, 5.6vw, 6.5rem);
  }

  .say {
    max-width: 33rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 86%, var(--yellow));
  }

  h1 {
    padding-top: 1.4rem;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: clamp(2.2rem, 3.7vw, 3.6rem);
    font-weight: 800;
    line-height: 0.99;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  .lede {
    max-width: 30rem;
    padding-top: 1.35rem;
    font-size: clamp(0.98rem, 1.06vw, 1.1rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 92%, var(--yellow));
  }

  .support {
    padding-top: 0.75rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
    color: color-mix(in srgb, var(--ink) 84%, var(--yellow));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    padding-top: 1.7rem;
  }

  .btn,
  .store {
    display: inline-flex;
    align-items: center;
    height: 3rem;
    padding: 0 1.25rem;
    border-radius: 0.2rem;
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0.005em;
  }

  .btn {
    background: var(--red);
    color: var(--cream);
    transition: background-color 0.18s ease;
  }

  .btn:hover { background: var(--ink); color: var(--yellow); }

  .store.is-pending {
    border: 1.5px dashed color-mix(in srgb, var(--ink) 52%, var(--yellow));
    color: color-mix(in srgb, var(--ink) 86%, var(--yellow));
    cursor: default;
  }

  .works {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: color-mix(in srgb, var(--ink) 84%, var(--yellow));
  }

  .works-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .works :global(.server-logo) { opacity: 0.82; }

  .sub {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    opacity: 0.82;
  }

  a:focus-visible {
    outline: 2.5px solid var(--red);
    outline-offset: 3px;
  }

  .field--app a:focus-visible { outline-color: var(--yellow); }

  /* ---------- narrow: the split turns horizontal ---------- */

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      --nudge: -5rem;
    }

    .seam { display: none; }

    .field--say {
      order: -1;
      grid-template-rows: auto auto;
      align-items: start;
      padding: 3.4rem 1.35rem 1.3rem;
    }

    .say { max-width: none; }

    .eyebrow { font-size: 0.72rem; }
    .eyebrow-tail { display: none; }

    h1 {
      padding-top: 1rem;
      font-size: clamp(1.9rem, 7.9vw, 2.5rem);
    }

    .lede {
      max-width: none;
      padding-top: 0.8rem;
      font-size: 0.9rem;
      line-height: 1.42;
    }

    .support {
      padding-top: 0.5rem;
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .actions { padding-top: 1.1rem; gap: 0.45rem; flex-wrap: nowrap; }
    .btn, .store { height: 2.5rem; padding: 0 0.8rem; font-size: 0.78rem; white-space: nowrap; }
    .works { padding-top: 1.15rem; gap: 0.5rem; }

    .screen { padding-inline: 7%; }
    .cover { box-shadow: 0 3cqw 7cqw rgba(4, 20, 18, 0.45); }
  }

  @media (max-width: 420px) {
    .field--say { padding-inline: 1.15rem; }
    .works-label { font-size: 0.64rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq i { animation: none; }
  }
</style>
