---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
---

<Layout
  title="Mozz — a free player for the music on your own server"
  description="Mozz is a free, open source music player for iPhone and iPad. Play from Plex, Jellyfin or Navidrome, or download albums and listen offline."
  themeColor="#fdf6ec"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;600&family=Bowlby+One+SC&family=Familjen+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="penumbra" />

  <main class="penumbra">
    <header class="mast">
      <a class="brand" href="/" aria-label="Mozz home">
        <Mark size={34} decorative />
        <span>
          <b>Mozz</b>
          <small>Self-hosted music player</small>
        </span>
      </a>
      <span class="edition">Free forever · GPL-3.0</span>
    </header>

    <section class="intro" aria-labelledby="penumbra-title">
      <p class="kicker">For iPhone and iPad</p>
      <h1 id="penumbra-title">Mozz is a free player for the music on your own server.</h1>
      <p class="dek">
        Play from <strong>Plex</strong>, <strong>Jellyfin</strong> or <strong>Navidrome</strong>.
        Stream at home, or download albums and listen with no signal.
      </p>
      <div class="actions">
        <a href="https://github.com/thatcube/Mozz">
          View on GitHub
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 11 11 5M6 5h5v5" />
          </svg>
        </a>
        <span aria-disabled="true"><i></i>Coming to the App Store</span>
      </div>
    </section>

    <section class="stage" aria-label="Mozz app preview">
      <div class="red-field" aria-hidden="true">
        <div class="wordmark">MOZZ</div>
        <span class="rule rule-a"></span>
        <span class="rule rule-b"></span>
      </div>

      <div class="aside aside-left" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" />
        </svg>
        <span><b>Keep an album</b><small>Play it anywhere</small></span>
      </div>

      <div class="aside aside-right" aria-hidden="true">
        <span><b>Your music</b><small>Your server</small></span>
        <svg viewBox="0 0 24 24">
          <rect x="4" y="3" width="16" height="18" rx="3" />
          <path d="M8 8h8M8 12h8" />
          <circle cx="9" cy="17" r="1" />
        </svg>
      </div>

      <div
        class="phone"
        role="img"
        aria-label="An iPhone showing Penumbra by Sable Atlas playing in Mozz and saved for offline listening"
      >
        <span class="phone-key key-one"></span>
        <span class="phone-key key-two"></span>
        <span class="phone-key key-three"></span>
        <div class="screen">
          <div class="island"></div>
          <div class="status">
            <span>9:41</span>
            <span class="status-icons">
              <svg viewBox="0 0 17 12" aria-hidden="true">
                <path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z" />
              </svg>
              <svg viewBox="0 0 24 12" aria-hidden="true">
                <rect x="1" y="1" width="19" height="10" rx="3" />
                <path d="M22 4v4" />
                <rect x="3" y="3" width="13" height="6" rx="1.5" />
              </svg>
            </span>
          </div>

          <div class="app-head">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="m4 8 6 6 6-6" />
            </svg>
            <span><small>PLAYING FROM</small><b>Your library</b></span>
            <span class="mini-mark"><Mark size={20} decorative /></span>
          </div>

          <div class="album">
            <span class="album-moon"></span>
            <span class="album-block"></span>
            <span class="album-stripe stripe-one"></span>
            <span class="album-stripe stripe-two"></span>
            <span class="album-stripe stripe-three"></span>
            <b>PEN<br />UMBRA</b>
            <small>SA–06</small>
          </div>

          <div class="track-copy">
            <span><strong>Penumbra</strong><small>Sable Atlas</small></span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.8 4.8a5.5 5.5 0 0 0-7.8 0L12 5.9l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.9 8.6 8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>
          </div>

          <div class="progress"><i></i></div>
          <div class="time"><span>1:24</span><span>−3:11</span></div>

          <div class="controls" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M18 5v14M6 12l10-7v14z" /></svg>
            <span>
              <svg viewBox="0 0 24 24"><path d="m9 6 10 6-10 6z" /></svg>
            </span>
            <svg viewBox="0 0 24 24"><path d="M6 5v14m12-7L8 5v14z" /></svg>
          </div>

          <div class="offline">
            <svg viewBox="0 0 18 18" aria-hidden="true">
              <circle cx="9" cy="9" r="8" />
              <path d="m5.5 9 2.2 2.3 4.9-5" />
            </svg>
            Downloaded for offline
          </div>
          <span class="home"></span>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>No account</span><i></i><span>No tracking</span><i></i><span>No subscription</span>
    </footer>
  </main>
</Layout>

<style is:global>
  body {
    background: #fdf6ec;
  }
</style>

<style>
  .penumbra {
    --paper: #fdf6ec;
    --soft: #eeeae2;
    --red: #d8002d;
    --deep-red: #7d0019;
    --ink: #191320;
    --black: #0a070d;
    --phone-w: clamp(248px, 20vw, 286px);

    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 650px;
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
    font-family: 'Familjen Grotesk', 'Avenir Next', Arial, sans-serif;
  }

  .penumbra::before {
    content: '';
    position: absolute;
    inset: 42px 0 auto;
    height: 4px;
    background: var(--red);
  }

  .mast {
    position: absolute;
    z-index: 10;
    top: calc(42px + clamp(17px, 2.4vh, 24px));
    right: clamp(20px, 3.4vw, 50px);
    left: clamp(20px, 3.4vw, 50px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .brand > span {
    display: grid;
    gap: 1px;
  }

  .brand b {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .brand small,
  .edition {
    color: rgba(25, 19, 32, 0.58);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .edition {
    padding-bottom: 7px;
    border-bottom: 2px solid var(--red);
  }

  .intro {
    position: absolute;
    z-index: 8;
    top: clamp(100px, 12.5vh, 122px);
    left: 50%;
    width: min(850px, calc(100% - 40px));
    text-align: center;
    transform: translateX(-50%);
  }

  .kicker {
    margin: 0 0 8px;
    color: var(--red);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 20ch;
    margin: 0 auto;
    font-size: clamp(32px, 3.3vw, 48px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .dek {
    max-width: 57ch;
    margin: 13px auto 0;
    color: rgba(25, 19, 32, 0.68);
    font-size: clamp(12px, 0.98vw, 14px);
    line-height: 1.42;
    text-wrap: balance;
  }

  .dek strong {
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 15px;
  }

  .actions a,
  .actions > span {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 14px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .actions a {
    color: var(--paper);
    background: var(--ink);
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .actions a svg {
    width: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .actions a:hover {
    color: var(--paper);
    background: var(--red);
    border-color: var(--red);
    transform: translateY(-2px);
  }

  .actions > span {
    border-color: rgba(25, 19, 32, 0.36);
    color: rgba(25, 19, 32, 0.66);
  }

  .actions > span i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
  }

  a:focus-visible {
    border-radius: 5px;
    outline: 3px solid var(--red);
    outline-offset: 4px;
  }

  .stage {
    position: absolute;
    z-index: 2;
    inset: clamp(300px, 35.5vh, 326px) 0 0;
  }

  .red-field {
    position: absolute;
    z-index: 1;
    top: clamp(46px, 8vh, 74px);
    right: 0;
    left: 0;
    height: clamp(330px, 44vh, 400px);
    overflow: hidden;
    background: var(--red);
    clip-path: polygon(0 6%, 100% 0, 100% 92%, 0 100%);
  }

  .red-field::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0 14%, rgba(125, 0, 25, 0.52) 14% 14.4%, transparent 14.4% 85.6%, rgba(125, 0, 25, 0.52) 85.6% 86%, transparent 86%),
      linear-gradient(180deg, rgba(253, 246, 236, 0.08), transparent 24%, transparent 76%, rgba(10, 7, 13, 0.12));
  }

  .wordmark {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--paper);
    font-family: 'Bowlby One SC', 'Arial Black', Impact, sans-serif;
    font-size: clamp(320px, 31.5vw, 460px);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.72;
    white-space: nowrap;
    transform: translate(-50%, -49%) scaleX(1.13);
    transform-origin: center;
    user-select: none;
  }

  .rule {
    position: absolute;
    width: 74px;
    height: 8px;
    background: var(--ink);
  }

  .rule-a {
    top: 17%;
    left: 4%;
  }

  .rule-b {
    right: 4%;
    bottom: 15%;
  }

  .phone {
    position: absolute;
    z-index: 5;
    top: 18px;
    left: 58%;
    width: var(--phone-w);
    aspect-ratio: 1 / 2.05;
    padding: calc(var(--phone-w) * 0.031);
    border: 1px solid rgba(253, 246, 236, 0.22);
    border-radius: calc(var(--phone-w) * 0.155);
    color: var(--paper);
    background: var(--black);
    box-shadow:
      0 0 0 2px var(--ink),
      -24px 34px 0 rgba(125, 0, 25, 0.54),
      -35px 50px 70px rgba(10, 7, 13, 0.28);
    transform: translateX(-50%) rotate(5.5deg);
  }

  .phone-key {
    position: absolute;
    left: -5px;
    width: 4px;
    border-radius: 4px 0 0 4px;
    background: var(--black);
  }

  .key-one {
    top: 19%;
    height: 6%;
  }

  .key-two {
    top: 28%;
    height: 11%;
  }

  .key-three {
    top: 41%;
    height: 11%;
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--phone-w) * 0.125);
    color: var(--paper);
    background:
      radial-gradient(circle at 90% 12%, rgba(125, 0, 25, 0.32), transparent 31%),
      var(--ink);
    font-family: 'Familjen Grotesk', 'Avenir Next', Arial, sans-serif;
  }

  .screen::after {
    content: '';
    position: absolute;
    z-index: 20;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(108deg, rgba(253, 246, 236, 0.08), transparent 20%, transparent 76%, rgba(253, 246, 236, 0.035));
  }

  .island {
    position: absolute;
    z-index: 4;
    top: calc(var(--phone-w) * 0.024);
    left: 50%;
    width: 31%;
    height: calc(var(--phone-w) * 0.071);
    border-radius: 999px;
    background: var(--black);
    transform: translateX(-50%);
  }

  .status {
    display: flex;
    height: calc(var(--phone-w) * 0.115);
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--phone-w) * 0.026) calc(var(--phone-w) * 0.06) 0;
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: calc(var(--phone-w) * 0.026);
    font-weight: 600;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: calc(var(--phone-w) * 0.015);
  }

  .status-icons svg {
    width: calc(var(--phone-w) * 0.038);
    height: calc(var(--phone-w) * 0.027);
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.1;
  }

  .status-icons svg:last-child {
    width: calc(var(--phone-w) * 0.052);
  }

  .app-head {
    display: grid;
    grid-template-columns: 1fr 4fr 1fr;
    align-items: center;
    padding: 0 calc(var(--phone-w) * 0.044);
    text-align: center;
  }

  .app-head > svg {
    width: calc(var(--phone-w) * 0.048);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .app-head > span {
    display: grid;
  }

  .app-head small {
    color: rgba(238, 234, 226, 0.48);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: calc(var(--phone-w) * 0.014);
    letter-spacing: 0.08em;
  }

  .app-head b {
    margin-top: 2px;
    font-size: calc(var(--phone-w) * 0.026);
    font-weight: 500;
  }

  .mini-mark {
    justify-self: end;
    line-height: 0;
  }

  .album {
    position: relative;
    width: 80%;
    aspect-ratio: 1;
    margin: calc(var(--phone-w) * 0.075) auto 0;
    overflow: hidden;
    border: 1px solid rgba(253, 246, 236, 0.16);
    border-radius: calc(var(--phone-w) * 0.018);
    background: var(--black);
    box-shadow: 0 calc(var(--phone-w) * 0.052) calc(var(--phone-w) * 0.09) rgba(10, 7, 13, 0.38);
  }

  .album::after {
    content: '';
    position: absolute;
    inset: 7%;
    border: 1px solid rgba(253, 246, 236, 0.36);
  }

  .album-moon {
    position: absolute;
    top: -13%;
    right: -14%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
  }

  .album-block {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48%;
    height: 58%;
    background: var(--red);
  }

  .album-stripe {
    position: absolute;
    left: -8%;
    width: 65%;
    height: 9%;
    background: var(--deep-red);
    transform: skewX(-26deg);
  }

  .stripe-one {
    bottom: 14%;
  }

  .stripe-two {
    bottom: 28%;
  }

  .stripe-three {
    bottom: 42%;
  }

  .album b {
    position: absolute;
    z-index: 2;
    top: 11%;
    left: 10%;
    color: var(--paper);
    font-family: 'Bowlby One SC', 'Arial Black', Impact, sans-serif;
    font-size: calc(var(--phone-w) * 0.086);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.78;
  }

  .album small {
    position: absolute;
    z-index: 2;
    right: 9%;
    bottom: 8%;
    color: var(--paper);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: calc(var(--phone-w) * 0.018);
    letter-spacing: 0.08em;
  }

  .track-copy {
    display: flex;
    width: 80%;
    align-items: center;
    justify-content: space-between;
    margin: calc(var(--phone-w) * 0.052) auto 0;
  }

  .track-copy > span {
    display: grid;
  }

  .track-copy strong {
    font-size: calc(var(--phone-w) * 0.043);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .track-copy small {
    margin-top: 2px;
    color: rgba(238, 234, 226, 0.5);
    font-size: calc(var(--phone-w) * 0.028);
  }

  .track-copy svg {
    width: calc(var(--phone-w) * 0.052);
    fill: none;
    stroke: var(--red);
    stroke-width: 1.7;
  }

  .progress {
    position: relative;
    width: 80%;
    height: 3px;
    margin: calc(var(--phone-w) * 0.043) auto 0;
    border-radius: 99px;
    background: rgba(238, 234, 226, 0.18);
  }

  .progress::before {
    content: '';
    display: block;
    width: 38%;
    height: 100%;
    border-radius: inherit;
    background: var(--red);
  }

  .progress i {
    position: absolute;
    top: 50%;
    left: 38%;
    width: calc(var(--phone-w) * 0.021);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .time {
    display: flex;
    width: 80%;
    justify-content: space-between;
    margin: calc(var(--phone-w) * 0.016) auto 0;
    color: rgba(238, 234, 226, 0.45);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: calc(var(--phone-w) * 0.018);
  }

  .controls {
    display: flex;
    width: 68%;
    align-items: center;
    justify-content: space-between;
    margin: calc(var(--phone-w) * 0.027) auto 0;
  }

  .controls > svg {
    width: calc(var(--phone-w) * 0.06);
    fill: currentColor;
  }

  .controls > span {
    display: grid;
    width: calc(var(--phone-w) * 0.12);
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    color: var(--paper);
    background: var(--red);
  }

  .controls > span svg {
    width: 58%;
    fill: currentColor;
  }

  .offline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--phone-w) * 0.018);
    margin-top: calc(var(--phone-w) * 0.04);
    color: rgba(238, 234, 226, 0.62);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: calc(var(--phone-w) * 0.018);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offline svg {
    width: calc(var(--phone-w) * 0.035);
    fill: var(--red);
  }

  .offline path {
    fill: none;
    stroke: var(--paper);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .home {
    position: absolute;
    bottom: calc(var(--phone-w) * 0.019);
    left: 50%;
    width: 34%;
    height: 4px;
    border-radius: 99px;
    background: rgba(238, 234, 226, 0.6);
    transform: translateX(-50%);
  }

  .aside {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 11px;
    border: 2px solid var(--ink);
    color: var(--ink);
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--deep-red);
    transform: rotate(-3deg);
  }

  .aside svg {
    width: 25px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .aside span {
    display: grid;
  }

  .aside b {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.1;
  }

  .aside small {
    margin-top: 3px;
    color: rgba(25, 19, 32, 0.58);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: 7px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .aside-left {
    top: 29%;
    left: 5.5%;
  }

  .aside-right {
    top: 56%;
    right: 5%;
    color: var(--paper);
    background: var(--ink);
    box-shadow: 6px 6px 0 var(--deep-red);
    transform: rotate(3deg);
  }

  .aside-right small {
    color: rgba(238, 234, 226, 0.58);
  }

  .foot {
    position: absolute;
    z-index: 7;
    right: clamp(20px, 3.4vw, 50px);
    bottom: clamp(13px, 2.2vh, 22px);
    left: clamp(20px, 3.4vw, 50px);
    display: flex;
    align-items: center;
    gap: 9px;
    color: rgba(25, 19, 32, 0.58);
    font-family: 'Azeret Mono', 'SFMono-Regular', Consolas, monospace;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .foot i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--red);
  }

  @media (max-width: 760px) {
    .penumbra {
