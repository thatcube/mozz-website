---
/**
 * Schematic — the product drawn the way a part gets drawn.
 *
 * Near-black ground, a faint plotter grid, and one object rendered in hairline:
 * an iPhone at its real body ratio, dimensioned, leadered and numbered, with a
 * proper title block in the corner holding the actions.
 *
 * The gesture is the drawing convention itself. The dimension lines measure
 * things a caliper cannot — every record you own, at home or offline — and that
 * is the only joke on the page. Exactly one element is red: the play button at
 * the centre of the part.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

const LEFT = [
  { n: '01', text: 'Points at the server you already run — Plex, Jellyfin or Navidrome.' },
  { n: '02', text: 'No Mozz account, no tracking, no subscription. Optional enrichment stays optional.' },
];

const RIGHT = [
  { n: '03', text: 'Streams over your own network, at full quality, from your own files.' },
  { n: '04', text: 'Downloads a record and plays it with no signal at all.' },
];
---

<Layout
  title={`${NAME} — a free player for the music on your own server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Navidrome server you already run, listen at home, or download an album and play it offline."
  themeColor="#0a0a0c"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Azeret+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="schematic" />

  <main class="plan">
    <div class="grid" aria-hidden="true"></div>

    <header class="title">
      <h1>Mozz is a free player for the music on your own server.</h1>
      <p>Drawing 01 &mdash; self&#8209;hosted music player for iPhone and iPad.</p>
    </header>

    <div class="body">
      <ol class="side left" role="list">
        {
          LEFT.map((note) => (
            <li>
              <b>{note.n}</b>
              <span>{note.text}</span>
            </li>
          ))
        }
      </ol>

      <figure class="part">
        <span class="dim across" aria-hidden="true"><i>every record you own</i></span>
        <span class="dim down" aria-hidden="true"><i>at home, or offline</i></span>

        <div
          class="device"
          role="img"
          aria-label="A hairline technical drawing of an iPhone running Mozz, with the play control picked out in red."
        >
          <span class="island" aria-hidden="true"></span>

          <div class="screen" aria-hidden="true">
            <svg class="art" viewBox="0 0 100 100" preserveAspectRatio="none">
              <rect x="0.5" y="0.5" width="99" height="99" />
              <path d="M0.5 0.5 99.5 99.5M99.5 0.5 0.5 99.5" />
            </svg>

            <span class="line w1"></span>
            <span class="line w2"></span>

            <span class="track"><i></i></span>

            <span class="row">
              <s></s>
              <span class="play"></span>
              <s></s>
            </span>
          </div>

          <span class="home" aria-hidden="true"></span>
        </div>
        <figcaption>fig. a &mdash; the part you hold</figcaption>
      </figure>

      <ol class="side right" role="list">
        {
          RIGHT.map((note) => (
            <li>
              <b>{note.n}</b>
              <span>{note.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <footer class="block">
      <span class="cell name">
        <b>Mozz</b>
        <i>self&#8209;hosted music player</i>
      </span>
      <span class="cell"><i>licence</i><b>GPL&#8209;3.0</b></span>
      <span class="cell"><i>price</i><b>free forever</b></span>
      <span class="cell"><i>sheet</i><b>1 of 1</b></span>

      <span class="acts">
        <a class="btn go" href={GITHUB_URL}>Source on GitHub</a>
        {
          APP_STORE_URL ? (
            <a class="btn wait" href={APP_STORE_URL}>
              Download on the App Store
            </a>
          ) : (
            <span class="btn wait" aria-disabled="true">
              Coming to the App Store
            </span>
          )
        }
      </span>
    </footer>
  </main>
</Layout>

<style is:global>
  body {
    background: #0a0a0c;
  }
</style>

<style>
  .plan {
    --void: #0a0a0c;
    --line: #d9d5cc;
    --dim: rgba(217, 213, 204, 0.4);
    --red: #d8002d;

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(56px, 7vh, 84px) clamp(16px, 3.2vw, 48px) clamp(14px, 2.4vh, 26px);
    overflow: hidden;
    background: var(--void);
    color: var(--line);
    font-family: 'Azeret Mono', ui-monospace, monospace;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(90deg, rgba(217, 213, 204, 0.055) 0 1px, transparent 1px 48px),
      repeating-linear-gradient(0deg, rgba(217, 213, 204, 0.055) 0 1px, transparent 1px 48px);
    pointer-events: none;
  }

  .title,
  .body,
  .block {
    position: relative;
    z-index: 1;
    width: min(94rem, 100%);
    margin-inline: auto;
  }

  h1 {
    max-width: 20ch;
    font-family: 'Archivo', 'Helvetica Neue', system-ui, sans-serif;
    font-size: clamp(26px, 3.4vw, 50px);
    font-weight: 800;
    font-variation-settings: 'wdth' 92;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .title p {
    margin-top: 0.7rem;
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* ---- the sheet --------------------------------------------------------- */

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    flex: 1 1 auto;
    gap: clamp(1rem, 3vw, 3.4rem);
    padding: clamp(0.8rem, 2.2vh, 1.6rem) 0;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 3.4vh, 2.4rem);
    margin: 0;
    padding: 0;
  }

  .side li {
    position: relative;
    display: flex;
    gap: 0.7rem;
    max-width: 21rem;
    font-size: clamp(10px, 0.8vw, 12px);
    line-height: 1.6;
    color: rgba(217, 213, 204, 0.72);
  }

  .side b {
    flex: none;
    width: 1.9rem;
    padding-top: 0.05em;
    font-weight: 700;
    color: var(--red);
  }

  /* The leader: a hairline that runs from the note toward the part. */
  .side li::after {
    content: '';
    position: absolute;
    top: 0.62em;
    height: 1px;
    background: rgba(217, 213, 204, 0.28);
  }

  .left {
    align-items: flex-end;
    text-align: right;
  }

  .left li {
    flex-direction: row-reverse;
    padding-right: clamp(1.2rem, 3vw, 3.4rem);
  }

  .left li::after {
    right: 0;
    width: clamp(0.9rem, 2.4vw, 2.8rem);
  }

  .right li {
    padding-left: clamp(1.2rem, 3vw, 3.4rem);
  }

  .right li::after {
    left: 0;
    width: clamp(0.9rem, 2.4vw, 2.8rem);
  }

  /* ---- the part ---------------------------------------------------------- */

  .part {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: clamp(22px, 3.4vh, 40px) 0 0 clamp(24px, 2.6vw, 46px);
  }

  figcaption {
    margin-top: 0.9rem;
    font-size: clamp(8.5px, 0.66vw, 10px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* Dimension lines with the usual arrow terminators. */
  .dim {
    position: absolute;
    color: var(--dim);
  }

  .dim i {
    position: absolute;
    font-style: normal;
    font-size: clamp(8px, 0.64vw, 9.5px);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--void);
  }

  .dim::before,
  .dim::after {
    content: '';
    position: absolute;
    border: 4px solid transparent;
  }

  .across {
    top: clamp(12px, 1.8vh, 22px);
    left: clamp(28px, 3vw, 52px);
    right: 0;
    height: 1px;
    background: currentColor;
  }

  .across::before {
    left: 0;
    top: -3.5px;
    border-right-color: var(--dim);
    border-left-width: 0;
  }

  .across::after {
    right: 0;
    top: -3.5px;
    border-left-color: var(--dim);
    border-right-width: 0;
  }

  .across i {
    left: 50%;
    top: -0.62em;
    padding: 0 0.5em;
    transform: translateX(-50%);
  }

  .down {
    left: clamp(12px, 1.4vw, 22px);
    top: clamp(28px, 4vh, 46px);
    bottom: 2.4rem;
    width: 1px;
    background: currentColor;
  }

  .down::before {
    top: 0;
    left: -3.5px;
    border-bottom-color: var(--dim);
    border-top-width: 0;
  }

  .down::after {
    bottom: 0;
    left: -3.5px;
    border-top-color: var(--dim);
    border-bottom-width: 0;
  }

  .down i {
    top: 50%;
    left: 0.5em;
    padding: 0.5em 0;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
  }

  /* Real hardware ratio, never a tall rectangle guessed at. */
  .device {
    position: relative;
    width: clamp(140px, min(16vw, 23vh), 260px);
    aspect-ratio: 71.6 / 147.6;
    padding: clamp(7px, 0.8vw, 12px);
    border: 1px solid var(--line);
    border-radius: clamp(20px, 2.4vw, 38px);
  }

  .island {
    position: absolute;
    left: 50%;
    top: clamp(12px, 1.4vw, 21px);
    width: 30%;
    height: clamp(9px, 1vw, 15px);
    transform: translateX(-50%);
    border: 1px solid rgba(217, 213, 204, 0.5);
    border-radius: 999px;
  }

  .screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(16px, 1.9vw, 30px) clamp(9px, 1vw, 16px) clamp(11px, 1.2vw, 19px);
    border: 1px dashed rgba(217, 213, 204, 0.34);
    border-radius: clamp(14px, 1.7vw, 27px);
  }

  .art {
    width: 100%;
    aspect-ratio: 1;
    margin-top: auto;
    fill: none;
    stroke: rgba(217, 213, 204, 0.62);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .line {
    display: block;
    height: 1px;
    margin-top: clamp(9px, 1vw, 15px);
    background: rgba(217, 213, 204, 0.55);
  }

  .w1 {
    width: 76%;
  }

  .w2 {
    width: 46%;
    margin-top: clamp(5px, 0.6vw, 9px);
    background: rgba(217, 213, 204, 0.3);
  }

  .track {
    display: block;
    height: 1px;
    margin-top: clamp(11px, 1.3vw, 20px);
    background: rgba(217, 213, 204, 0.3);
  }

  .track i {
    display: block;
    width: 44%;
    height: 100%;
    background: var(--line);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.2vw, 19px);
    margin-top: auto;
    padding-bottom: clamp(6px, 0.8vw, 12px);
  }

  .row s {
    display: block;
    width: clamp(7px, 0.8vw, 12px);
    height: clamp(7px, 0.8vw, 12px);
    border: 1px solid rgba(217, 213, 204, 0.55);
    border-radius: 1px;
  }

  /* The single red object on the sheet. */
  .play {
    display: block;
    width: clamp(20px, 2.3vw, 36px);
    height: clamp(20px, 2.3vw, 36px);
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 22px 2px rgba(216, 0, 45, 0.42);
  }

  .home {
    position: absolute;
    left: 50%;
    bottom: clamp(5px, 0.6vw, 9px);
    width: 32%;
    height: 2px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: rgba(217, 213, 204, 0.45);
  }

  /* ---- title block ------------------------------------------------------- */

  .block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(0.8rem, 2vw, 2rem);
    padding-top: clamp(0.7rem, 1.8vh, 1.1rem);
    border-top: 1px solid rgba(217, 213, 204, 0.28);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: 0.35rem 0;
  }

  .cell i {
    font-style: normal;
    font-size: clamp(7.5px, 0.6vw, 9px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .cell b {
    font-size: clamp(10px, 0.8vw, 12px);
    font-weight: 700;
  }

  .name b {
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: clamp(15px, 1.3vw, 20px);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .name i {
    letter-spacing: 0.14em;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 1rem;
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: clamp(11px, 0.86vw, 13px);
    font-weight: 700;
    white-space: nowrap;
  }

  .go {
    background: var(--red);
    color: #fff;
    transition: background 160ms ease;
  }

  .go:hover {
    background: #f10233;
  }

  .wait {
    border: 1px dashed rgba(217, 213, 204, 0.4);
    color: rgba(217, 213, 204, 0.72);
  }

  a:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  /* ---- narrow ------------------------------------------------------------ */

  @media (max-width: 66rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 1.6rem;
    }

    .side {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem 1.4rem;
      width: 100%;
      max-width: 40rem;
    }

    /* Leaders only make sense when they point at something. */
    .side li::after {
      display: none;
    }

    .left {
      order: 2;
      align-items: stretch;
      text-align: left;
    }

    .left li {
      flex-direction: row;
      padding-right: 0;
    }

    .right {
      order: 3;
    }

    .right li {
      padding-left: 0;
    }

    .side li {
      max-width: none;
    }

    .part {
      order: 1;
    }
  }

  @media (max-width: 40rem) {
    h1 {
      max-width: 15ch;
      font-size: clamp(25px, 7.4vw, 34px);
    }

    .device {
      width: clamp(120px, min(34vw, 26vh), 168px);
    }

    .side {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }

    .side li {
      font-size: 10.5px;
      line-height: 1.5;
    }

    .part {
      padding-left: 22px;
    }

    figcaption {
      margin-top: 0.5rem;
    }

    .cell:nth-child(3),
    .cell:nth-child(4) {
      display: none;
    }

    .across i,
    .down i {
      font-size: 7.5px;
    }

    .acts {
      width: 100%;
      margin-left: 0;
      margin-top: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .go {
      transition: none;
    }
  }
</style>
