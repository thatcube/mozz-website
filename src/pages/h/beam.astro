---
import Mark from '../../components/Mark.astro';

const github = 'https://github.com/thatcube/Mozz';
const headline = 'Mozz is a free player for the music on your server.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Mozz is a free, open source self-hosted music player for iPhone and iPad. Play music from Plex, Jellyfin or Navidrome."
    />
    <meta name="theme-color" content="#191320" />
    <title>Mozz — a free player for your self-hosted music</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,700..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="hero">
      <header class="mast">
        <a class="brand" href={github} aria-label="Mozz on GitHub">
          <Mark size={41} class="brand__mark" decorative />
          <span>Mozz</span>
        </a>

        <p class="compatibility">
          <span>Plays from</span>
          Plex · Jellyfin · Navidrome
        </p>
      </header>

      <section class="statement">
        <p class="eyebrow">Self-hosted music player · iPhone + iPad</p>
        <h1>{headline}</h1>
      </section>

      <div class="world" aria-hidden="true">
        <svg class="signal signal--desktop" viewBox="0 0 1440 900" preserveAspectRatio="none">
          <path
            class="signal__outside"
            pathLength="1000"
            d="M-100 790 C255 748 380 620 586 652 C782 682 850 804 1036 654 C1176 541 1206 386 1540 368"
          />
          <path
            class="signal__inside"
            pathLength="1000"
            d="M-100 790 C255 748 380 620 586 652 C782 682 850 804 1036 654 C1176 541 1206 386 1540 368"
          />
          <path
            class="signal__pulse"
            pathLength="1000"
            d="M-100 790 C255 748 380 620 586 652 C782 682 850 804 1036 654 C1176 541 1206 386 1540 368"
          />
        </svg>

        <svg class="signal signal--mobile" viewBox="0 0 390 844" preserveAspectRatio="none">
          <path
            class="signal__outside"
            pathLength="1000"
            d="M-78 784 C50 736 63 634 151 602 C226 575 240 629 302 563 C343 520 351 456 450 420"
          />
          <path
            class="signal__inside"
            pathLength="1000"
            d="M-78 784 C50 736 63 634 151 602 C226 575 240 629 302 563 C343 520 351 456 450 420"
          />
          <path
            class="signal__pulse"
            pathLength="1000"
            d="M-78 784 C50 736 63 634 151 602 C226 575 240 629 302 563 C343 520 351 456 450 420"
          />
        </svg>

        <svg class="home" viewBox="0 0 220 190">
          <path d="M8 82 110 5l102 77v101H8z" fill="#fdf6ec" />
          <rect x="68" y="65" width="84" height="118" rx="9" fill="#0a070d" />
          <rect x="78" y="76" width="64" height="25" rx="4" fill="#d8002d" />
          <rect x="78" y="109" width="64" height="25" rx="4" fill="#7d0019" />
          <rect x="78" y="142" width="64" height="25" rx="4" fill="#eeeae2" />
          <circle cx="130" cy="88.5" r="4.2" fill="#0a070d" />
          <circle cx="130" cy="121.5" r="4.2" fill="#fdf6ec" />
          <circle cx="130" cy="154.5" r="4.2" fill="#0a070d" />
          <path
            d="M26 146h18m-9-9v18"
            stroke="#d8002d"
            stroke-width="6"
            stroke-linecap="round"
          />
        </svg>

        <div class="phone">
          <div class="phone__screen">
            <div class="phone__bar">
              <span>Now playing</span>
              <i></i>
            </div>
            <div class="album">
              <svg class="album__mark" viewBox="0 0 180 180" role="presentation">
                <circle cx="90" cy="90" r="76" fill="#d8002d" />
                <path
                  d="M49 58h35v14L68 88h17v15H48V89l17-16H49zm47 0h35v14l-16 16h17v15H95V89l17-16H96z"
                  fill="#fdf6ec"
                />
                <path
                  d="M57 116c7 22 26 32 33 32s26-10 33-32"
                  fill="none"
                  stroke="#fdf6ec"
                  stroke-linecap="round"
                  stroke-width="13"
                />
              </svg>
            </div>
            <div class="track">
              <strong>From the windows</strong>
              <span>Evening Index</span>
            </div>
            <div class="progress"><i></i></div>
            <div class="controls">
              <span>◀</span>
              <b>▶</b>
              <span>▶</span>
            </div>
          </div>
        </div>
      </div>

      <footer class="foot">
        <div class="promise">
          <strong>Free forever.</strong>
          <span>No account · no tracking · open source</span>
        </div>
        <div class="actions">
          <a href={github}>View on GitHub <span aria-hidden="true">↗</span></a>
          <span class="pending" aria-disabled="true">App Store · coming soon</span>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ground: #191320;
    --red: #d8002d;
    --red-deep: #7d0019;
    --paper: #fdf6ec;
    --offwhite: #eeeae2;
    --ink: #0a070d;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--ground);
  }

  body {
    color: var(--paper);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    background: var(--ground);
  }

  .mast {
    position: relative;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 2.7vw, 2.5rem) clamp(1.25rem, 3.4vw, 3.4rem) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: 'Anybody', 'Arial Black', Arial, sans-serif;
    font-size: 1.2rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  .brand__mark {
    width: 2.55rem;
    height: 2.55rem;
    filter: drop-shadow(0.26rem 0.26rem 0 var(--ink));
  }

  .compatibility {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-size: clamp(0.67rem, 0.78vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  .compatibility span {
    color: var(--red);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .statement {
    position: relative;
    z-index: 5;
    width: min(89vw, 82rem);
    margin: clamp(2rem, 5.3vh, 4.6rem) 0 0 clamp(1.25rem, 3.4vw, 3.4rem);
  }

  .eyebrow {
    margin: 0 0 clamp(0.8rem, 1.7vh, 1.3rem);
    color: var(--red);
    font-size: clamp(0.64rem, 0.75vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12.5em;
    margin: 0;
    color: var(--paper);
    font-family: 'Anybody', 'Arial Black', Arial, sans-serif;
    font-size: clamp(4.15rem, 7.45vw, 7.2rem);
    font-stretch: 111%;
    font-weight: 850;
    line-height: 0.82;
    letter-spacing: -0.068em;
    text-wrap: balance;
  }

  h1::first-letter {
    color: var(--red);
  }

  .world {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .signal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .signal path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .signal__outside {
    stroke: var(--red);
    stroke-width: 230;
  }

  .signal__inside {
    stroke: var(--offwhite);
    stroke-width: 68;
  }

  .signal__pulse {
    stroke: var(--ink);
    stroke-width: 8;
    stroke-dasharray: 3 30;
    animation: travel 4.5s linear infinite;
  }

  .signal--mobile {
    display: none;
  }

  .home {
    position: absolute;
    bottom: -0.35rem;
    left: clamp(1.2rem, 3.4vw, 3.4rem);
    width: clamp(9rem, 14.5vw, 13rem);
    height: auto;
    filter: drop-shadow(0.65rem 0.65rem 0 rgba(10, 7, 13, 0.32));
  }

  .phone {
    position: absolute;
    right: clamp(2.7rem, 7vw, 7rem);
    bottom: -4.5rem;
    width: clamp(14rem, 20.6vw, 18.5rem);
    aspect-ratio: 0.52;
    padding: 0.78rem;
    border: 0.55rem solid var(--ink);
    border-radius: 2.6rem;
    background: var(--paper);
    box-shadow: 1rem 1rem 0 rgba(10, 7, 13, 0.42);
    transform: rotate(5deg);
  }

  .phone::before {
    position: absolute;
    top: 0.38rem;
    left: 50%;
    width: 34%;
    height: 1.25rem;
    border-radius: 0 0 0.9rem 0.9rem;
    background: var(--ink);
    content: '';
    transform: translateX(-50%);
    z-index: 2;
  }

  .phone__screen {
    height: 100%;
    padding: 1.8rem 1rem 1rem;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--ink);
    color: var(--paper);
  }

  .phone__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: clamp(0.43rem, 0.65vw, 0.62rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .phone__bar i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--red);
  }

  .album {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    margin-top: clamp(1rem, 2.5vh, 1.75rem);
    border-radius: 0.5rem;
    background: var(--offwhite);
  }

  .album__mark {
    display: block;
    width: 72%;
    height: 72%;
  }

  .track {
    display: grid;
    gap: 0.25rem;
    padding-top: clamp(0.85rem, 1.7vh, 1.2rem);
  }

  .track strong {
    overflow: hidden;
    font-family: 'Anybody', 'Arial Black', Arial, sans-serif;
    font-size: clamp(0.8rem, 1.35vw, 1.16rem);
    font-weight: 780;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track span {
    font-size: clamp(0.5rem, 0.68vw, 0.64rem);
    opacity: 0.64;
  }

  .progress {
    height: 0.22rem;
    margin-top: clamp(0.9rem, 2vh, 1.3rem);
    border-radius: 4rem;
    background: rgba(253, 246, 236, 0.22);
  }

  .progress i {
    display: block;
    width: 41%;
    height: 100%;
    border-radius: inherit;
    background: var(--red);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 1.6vw, 1.45rem);
    padding-top: clamp(0.9rem, 2vh, 1.4rem);
    color: var(--paper);
    font-size: clamp(0.58rem, 0.9vw, 0.82rem);
  }

  .controls b {
    display: grid;
    place-items: center;
    width: clamp(2rem, 3.5vw, 3rem);
    aspect-ratio: 1;
    padding-left: 0.15em;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9em;
  }

  .foot {
    position: absolute;
    z-index: 7;
    bottom: clamp(1.25rem, 2.8vw, 2.6rem);
    left: clamp(12rem, 20vw, 19rem);
    display: flex;
    align-items: flex-end;
    gap: clamp(1.5rem, 4.5vw, 4.5rem);
  }

  .promise {
    display: grid;
    gap: 0.28rem;
    color: var(--paper);
  }

  .promise strong {
    font-family: 'Anybody', 'Arial Black', Arial, sans-serif;
    font-size: clamp(1.1rem, 1.7vw, 1.55rem);
    font-weight: 820;
    letter-spacing: -0.035em;
  }

  .promise span {
    font-size: clamp(0.52rem, 0.63vw, 0.65rem);
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .actions a,
  .pending {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0 1rem;
    border: 0.16rem solid var(--ink);
    border-radius: 3rem;
    background: var(--ink);
    color: var(--paper);
    font-size: clamp(0.6rem, 0.69vw, 0.7rem);
    font-weight: 600;
    white-space: nowrap;
  }

  .actions a {
    gap: 0.65rem;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .actions a:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .pending {
    border-color: var(--paper);
    background: transparent;
    color: var(--paper);
  }

  a:focus-visible {
    outline: 0.22rem solid var(--red);
    outline-offset: 0.25rem;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: -165;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
    }

    .mast {
      align-items: flex-start;
      gap: 0.8rem;
      padding: 1rem 1rem 0;
    }

    .brand {
      gap: 0.55rem;
      font-size: 1rem;
    }

    .brand__mark {
      width: 2.15rem;
      height: 2.15rem;
      filter: drop-shadow(0.2rem 0.2rem 0 var(--ink));
    }

    .compatibility {
      display: grid;
      gap: 0.2rem;
      max-width: 15rem;
      padding-top: 0.15rem;
      font-size: clamp(0.5rem, 2.45vw, 0.65rem);
      text-align: right;
    }

    .compatibility span {
      font-size: 0.5rem;
    }

    .statement {
      width: calc(100% - 2rem);
      margin: clamp(2rem, 6vh, 3rem) 1rem 0;
    }

    .eyebrow {
      margin-bottom: 0.75rem;
      font-size: clamp(0.5rem, 2.2vw, 0.62rem);
      letter-spacing: 0.09em;
    }

    h1 {
      max-width: 6.6em;
      font-size: clamp(3.35rem, 15.6vw, 4.3rem);
      font-stretch: 105%;
      line-height: 0.83;
      letter-spacing: -0.068em;
      text-wrap: wrap;
    }

    .signal--desktop {
      display: none;
    }

    .signal--mobile {
      display: block;
    }

    .signal__outside {
      stroke-width: 145;
    }

    .signal__inside {
      stroke-width: 45;
    }

    .signal__pulse {
      stroke-width: 6;
      stroke-dasharray: 3 35;
    }

    .home {
      bottom: -0.3rem;
      left: -0.2rem;
      width: clamp(7.4rem, 35vw, 9rem);
    }

    .phone {
      right: -1.4rem;
      bottom: -2.8rem;
      width: clamp(10.5rem, 47vw, 12rem);
      padding: 0.48rem;
      border-width: 0.36rem;
      border-radius: 1.8rem;
      box-shadow: 0.55rem 0.55rem 0 rgba(10, 7, 13, 0.42);
      transform: rotate(5deg);
    }

    .phone::before {
      top: 0.2rem;
      height: 0.82rem;
    }

    .phone__screen {
      padding: 1.3rem 0.7rem 0.7rem;
      border-radius: 1.06rem;
    }

    .phone__bar {
      font-size: 0.39rem;
    }

    .album {
      margin-top: 0.8rem;
    }

    .track {
      padding-top: 0.65rem;
    }

    .track strong {
      font-size: 0.72rem;
    }

    .track span {
      font-size: 0.45rem;
    }

    .progress {
      margin-top: 0.7rem;
    }

    .controls {
      gap: 0.75rem;
      padding-top: 0.7rem;
      font-size: 0.52rem;
    }

    .controls b {
      width: 1.8rem;
    }

    .foot {
      top: 51.5%;
      right: auto;
      bottom: auto;
      left: 1rem;
      display: grid;
      gap: 0.75rem;
      align-items: start;
    }

    .promise {
      color: var(--paper);
    }

    .promise strong {
      font-size: 1.08rem;
    }

    .promise span {
      max-width: 18rem;
      font-size: 0.52rem;
    }

    .actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }

    .actions a,
    .pending {
      min-height: 2.2rem;
      padding: 0 0.8rem;
      border-width: 0.12rem;
      font-size: 0.55rem;
    }

    .actions a {
      background: var(--red);
      color: var(--paper);
    }

    .pending {
      border-color: var(--paper);
      color: var(--paper);
    }
  }

  @media (max-width: 370px) {
    h1 {
      font-size: 3.15rem;
    }

    .foot {
      top: 50.5%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal__pulse {
      animation: none;
    }

    .actions a {
      transition: none;
    }
  }
</style>
