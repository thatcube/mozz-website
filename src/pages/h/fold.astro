---
/**
 * Hero study — FOLD.
 *
 * One sheet of paper, folded once. The crease steps up in three places: the
 * server you run, the music kept on it, and the phone it plays on. It stays
 * one sheet the whole way, which is the plain point — the same player whether
 * the track is coming off the server or already sitting on the phone.
 *
 * The server is one server, not three. Plex, Jellyfin and Navidrome appear
 * only as a small line of supported marks under the buttons, in the page's own
 * ink rather than their brand colours, because that is a compatibility note
 * and not the idea.
 *
 * Drawn once and rendered twice (landscape / portrait) from the same markup.
 * The stage's aspect-ratio matches each viewBox exactly, so the words always
 * land in the white of the sheet, at any size.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import HeroBar from '../../components/HeroBar.astro';
import { NAME, SERVERS, GITHUB_URL, APP_STORE_URL } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';

interface Box {
  x: number;
  y: number;
  w: number;
}

interface SheetLayout {
  key: string;
  w: number;
  h: number;
  /** the sheet itself: top and bottom edge, and how far each is inset */
  top: number;
  topInset: number;
  bottom: number;
  bottomInset: number;
  /** where the paper folds toward you between the three steps */
  crease: number;
  server: Box;
  sleeve: Box;
  phone: Box;
  disc: { cx: number; cy: number; r: number };
  notes: { x: number; label: string }[];
  noteSize: number;
  /** viewBox units that render as about one pixel at this layout's usual size */
  hair: number;
}

const LAYOUTS: SheetLayout[] = [
  {
    key: 'wide',
    w: 1440,
    h: 900,
    top: 84,
    topInset: 104,
    bottom: 772,
    bottomInset: 44,
    crease: 612,
    server: { x: 198, y: 552, w: 208 },
    sleeve: { x: 596, y: 500, w: 272 },
    phone: { x: 1136, y: 506, w: 158 },
    disc: { cx: 916, cy: 636, r: 98 },
    notes: [
      { x: 302, label: 'your server' },
      { x: 732, label: 'your library' },
      { x: 916, label: 'radio' },
      { x: 1215, label: 'streamed or offline' },
    ],
    noteSize: 15,
    hair: 1.15,
  },
  {
    key: 'tall',
    w: 780,
    h: 1240,
    top: 80,
    topInset: 58,
    bottom: 1102,
    bottomInset: 14,
    crease: 980,
    server: { x: 84, y: 918, w: 152 },
    sleeve: { x: 292, y: 862, w: 240 },
    phone: { x: 602, y: 876, w: 98 },
    disc: { cx: 412, cy: 796, r: 84 },
    notes: [
      { x: 160, label: 'your server' },
      { x: 400, label: 'library' },
      { x: 524, label: 'radio' },
      { x: 656, label: 'on your phone' },
    ],
    noteSize: 21,
    hair: 1.9,
  },
];

const round = (n: number) => Math.round(n * 10) / 10;

/** the sheet's silhouette: one trapezoid, a little wider along the near edge */
const outline = (s: SheetLayout) =>
  `M${s.topInset} ${s.top}H${s.w - s.topInset}L${s.w - s.bottomInset} ${s.bottom}H${s.bottomInset}Z`;

/** x of the sheet's left edge at any height */
const edgeAt = (s: SheetLayout, y: number) =>
  s.topInset + (s.bottomInset - s.topInset) * ((y - s.top) / (s.bottom - s.top));

/** one step of the crease: up around a state, then back down to the fold */
const step = (b: Box, crease: number, rTop: number) => {
  const r = Math.min(b.w * 0.07, 16);
  const right = b.x + b.w;
  return (
    `L${round(b.x - r)} ${round(crease)}` +
    `Q${round(b.x)} ${round(crease)} ${round(b.x)} ${round(crease - r)}` +
    `L${round(b.x)} ${round(b.y + rTop)}` +
    `Q${round(b.x)} ${round(b.y)} ${round(b.x + rTop)} ${round(b.y)}` +
    `L${round(right - rTop)} ${round(b.y)}` +
    `Q${round(right)} ${round(b.y)} ${round(right)} ${round(b.y + rTop)}` +
    `L${round(right)} ${round(crease - r)}` +
    `Q${round(right)} ${round(crease)} ${round(right + r)} ${round(crease)}`
  );
};

/** the whole crease, edge to edge, stepping up three times */
const skyline = (s: SheetLayout) =>
  `M${round(edgeAt(s, s.crease))} ${round(s.crease)}` +
  step(s.server, s.crease, 8) +
  step(s.sleeve, s.crease, 8) +
  step(s.phone, s.crease, s.phone.w * 0.17) +
  `L${round(s.w - edgeAt(s, s.crease))} ${round(s.crease)}`;

/** everything below the crease: the same paper, turned toward you */
const face = (s: SheetLayout) =>
  `${skyline(s)}L${round(s.w - s.bottomInset)} ${round(s.bottom)}H${round(s.bottomInset)}Z`;

const ART_LABEL =
  'A single folded sheet of paper. It steps up into a small server on the left, a record sleeve with the record half out of it in the middle, and a phone playing a track on the right.';

const STORE_PATH =
  'M12.1 5.6c.6 0 1.4-.4 1.8-.9.4-.5.7-1.2.6-1.9-.6 0-1.4.4-1.8.9-.4.4-.8 1.1-.6 1.9Zm.6 1c-1 0-1.9.6-2.4.6-.5 0-1.2-.5-2-.5A3 3 0 0 0 5.7 8.2c-1.1 1.9-.3 4.7.8 6.2.5.8 1.2 1.6 2 1.6.8 0 1.1-.5 2-.5.9 0 1.2.5 2 .5.9 0 1.4-.7 1.9-1.5.6-.9.9-1.7.9-1.8 0 0-1.7-.7-1.7-2.6 0-1.6 1.3-2.4 1.4-2.4a3 3 0 0 0-2.3-1.2Z';
---

<Layout
  title="Mozz — free self-hosted music player for iPhone and iPad"
  description={HERO_COPY.body}
  themeColor="#f5f4f0"
  noindex
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
  />

  <HeroBar slug="fold" />

  <main class="fold">
    <div class="stage">
      {LAYOUTS.map((g) => {
        const hair = g.hair;
        const lip = g.bottom - g.crease;
        const states = [g.server, g.sleeve, g.phone];
        return (
          <svg
            class={`art art--${g.key}`}
            viewBox={`0 0 ${g.w} ${g.h}`}
            role="img"
            aria-label={ART_LABEL}
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id={`${g.key}-page`} x1="0" y1={g.top} x2="0" y2={g.crease} gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="1" stop-color="#f7f9fc" />
              </linearGradient>
              <linearGradient id={`${g.key}-face`} x1="0" y1={g.sleeve.y} x2="0" y2={g.bottom} gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#edf1f8" />
                <stop offset="1" stop-color="#fafbfd" />
              </linearGradient>
              <filter id={`${g.key}-crease`} x="-10%" y="-10%" width="120%" height="120%">
                <feGaussianBlur stdDeviation={g.w / 190} />
              </filter>
              <filter id={`${g.key}-lift`} x="-20%" y="-20%" width="140%" height="150%">
                <feDropShadow
                  dx="0"
                  dy={g.w / 150}
                  stdDeviation={g.w / 110}
                  flood-color="#6f7d99"
                  flood-opacity="0.12"
                />
              </filter>
              <clipPath id={`${g.key}-face-clip`}>
                <path d={face(g)} />
              </clipPath>
            </defs>

            {/* the sheet */}
            <g filter={`url(#${g.key}-lift)`}>
              <path d={outline(g)} fill={`url(#${g.key}-page)`} />
            </g>

            {/* the near half of the same sheet, folded toward you */}
            <path d={face(g)} fill={`url(#${g.key}-face)`} />

            {/* the one shadow in the drawing: the one the fold casts */}
            <g clip-path={`url(#${g.key}-face-clip)`}>
              <path
                d={skyline(g)}
                fill="none"
                stroke="#5f7099"
                stroke-opacity="0.24"
                stroke-width={round(g.w / 105)}
                stroke-linejoin="round"
                filter={`url(#${g.key}-crease)`}
              />
            </g>
            <path
              d={skyline(g)}
              fill="none"
              stroke="#9caac4"
              stroke-opacity="0.8"
              stroke-width={hair}
              stroke-linejoin="round"
            />
            <path d={outline(g)} fill="none" stroke="#d4dbe8" stroke-width={hair} />

            {/* the side creases carry on down the near half */}
            <g stroke="#b7c3da" stroke-opacity="0.55" stroke-width={hair}>
              {states.map((b) => (
                <g>
                  <line x1={b.x} y1={g.crease} x2={b.x} y2={g.bottom} />
                  <line x1={b.x + b.w} y1={g.crease} x2={b.x + b.w} y2={g.bottom} />
                </g>
              ))}
            </g>

            {/* the machine in the cupboard: one server, three quiet bays */}
            <g>
              {[0, 1, 2].map((i) => {
                const row = (g.bottom - g.server.y) / 3.4;
                const bx = g.server.x + g.server.w * 0.12;
                const bw = g.server.w * 0.76;
                const by = g.server.y + row * 0.55 + i * row;
                return (
                  <g>
                    <rect
                      x={round(bx)}
                      y={round(by)}
                      width={round(bw)}
                      height={round(row * 0.6)}
                      rx={round(row * 0.12)}
                      fill="#ffffff"
                      fill-opacity="0.7"
                      stroke="#c2ccdf"
                      stroke-width={hair}
                    />
                    <circle
                      cx={round(bx + row * 0.34)}
                      cy={round(by + row * 0.3)}
                      r={round(row * 0.08)}
                      fill="#8f9fbc"
                    />
                    <line
                      x1={round(bx + row * 0.62)}
                      y1={round(by + row * 0.3)}
                      x2={round(bx + bw - row * 0.3)}
                      y2={round(by + row * 0.3)}
                      stroke="#b7c3da"
                      stroke-width={hair}
                    />
                  </g>
                );
              })}
            </g>

            {/* the record, half out of the sleeve */}
            <g>
              <circle cx={g.disc.cx} cy={g.disc.cy} r={g.disc.r} fill="#fbfcfe" stroke="#c2ccdf" stroke-width={hair} />
              {[0.74, 0.5].map((k) => (
                <circle
                  cx={g.disc.cx}
                  cy={g.disc.cy}
                  r={round(g.disc.r * k)}
                  fill="none"
                  stroke="#b7c3da"
                  stroke-opacity="0.7"
                  stroke-width={hair}
                />
              ))}
              <circle cx={g.disc.cx} cy={g.disc.cy} r={round(g.disc.r * 0.26)} fill="#c80028" />
              <circle cx={g.disc.cx} cy={g.disc.cy} r={round(g.disc.r * 0.06)} fill="#fbfcfe" />
            </g>

            {/* the sleeve it came out of */}
            <rect
              x={g.sleeve.x}
              y={g.sleeve.y}
              width={g.sleeve.w}
              height={round(g.bottom - g.sleeve.y)}
              fill={`url(#${g.key}-face)`}
            />
            <rect
              x={round(g.sleeve.x + g.sleeve.w * 0.08)}
              y={round(g.sleeve.y + g.sleeve.w * 0.1)}
              width={round(g.sleeve.w * 0.84)}
              height={round(g.bottom - g.sleeve.y - g.sleeve.w * 0.18)}
              fill="none"
              stroke="#c2ccdf"
              stroke-width={hair}
            />
            <line
              x1={g.sleeve.x + g.sleeve.w}
              y1={g.sleeve.y}
              x2={g.sleeve.x + g.sleeve.w}
              y2={g.bottom}
              stroke="#9caac4"
              stroke-opacity="0.8"
              stroke-width={hair}
            />

            {/* the phone, playing */}
            <g>
              <rect
                x={round(g.phone.x + g.phone.w * 0.12)}
                y={round(g.phone.y + g.phone.w * 0.14)}
                width={round(g.phone.w * 0.76)}
                height={round(g.phone.w * 0.76)}
                rx={round(g.phone.w * 0.03)}
                fill="#ffffff"
                stroke="#c2ccdf"
                stroke-width={hair}
              />
              <rect
                x={round(g.phone.x + g.phone.w * 0.12)}
                y={round(g.bottom - g.phone.w * 0.75)}
                width={round(g.phone.w * 0.46)}
                height={round(g.phone.w * 0.045)}
                rx={round(g.phone.w * 0.023)}
                fill="#9aa8c4"
                fill-opacity="0.8"
              />
              <line
                x1={round(g.phone.x + g.phone.w * 0.12)}
                y1={round(g.bottom - g.phone.w * 0.42)}
                x2={round(g.phone.x + g.phone.w * 0.88)}
                y2={round(g.bottom - g.phone.w * 0.42)}
                stroke="#b7c3da"
                stroke-width={round(hair * 1.4)}
                stroke-linecap="round"
              />
              <circle
                cx={round(g.phone.x + g.phone.w * 0.44)}
                cy={round(g.bottom - g.phone.w * 0.42)}
                r={round(g.phone.w * 0.062)}
                fill="#c80028"
              />
            </g>

            {/* small labels along the near edge */}
            <g class="notes">
              {g.notes.map((note) => (
                <g>
                  <line
                    x1={note.x}
                    y1={round(g.bottom + lip * 0.04)}
                    x2={note.x}
                    y2={round(g.bottom + lip * 0.18)}
                    stroke="#8f9fbc"
                    stroke-opacity="0.8"
                    stroke-width={hair}
                  />
                  <text x={note.x} y={round(g.bottom + lip * 0.34)} text-anchor="middle" font-size={g.noteSize}>
                    {note.label}
                  </text>
                </g>
              ))}
            </g>
          </svg>
        );
      })}

      <div class="words">
        <p class="lockup">
          <Mark size={24} decorative />
          <span>{NAME}</span>
        </p>
        <h1>{HERO_COPY.headline}</h1>
        <p class="lede">{HERO_COPY.body}</p>
        <p class="actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d={STORE_PATH} fill="currentColor" /></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store store--pending">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d={STORE_PATH} fill="currentColor" /></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="ghost" href={GITHUB_URL}>Read the source</a>
        </p>
        <p class="marks">
          {SERVERS.map((server) => (
            <ServerLogo name={server.name} size={18} />
          ))}
        </p>
        <p class="support">{HERO_COPY.support}</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .fold {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 92px 0 24px;
    background:
      radial-gradient(120% 90% at 50% 4%, #faf9f6 0%, #f5f4ef 48%, #eeece5 100%),
      #f5f4ef;
    color: #1b1d21;
    font-family: 'Satoshi', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .stage {
    position: relative;
    width: min(100%, calc((100svh - 116px) * 8 / 5));
    aspect-ratio: 1440 / 900;
    container-type: inline-size;
  }

  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .art--tall {
    display: none;
  }

  .notes text {
    fill: #5a6480;
    font-family: 'Satoshi', ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .words {
    position: absolute;
    left: 50%;
    top: 11%;
    translate: -50% 0;
    width: 60cqw;
    display: grid;
    justify-items: center;
    gap: 1.15cqw;
    text-align: center;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.65cqw;
    margin: 0;
    font-size: 1.4cqw;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #23262c;
  }

  .lockup :global(.mozz-mark) {
    width: 2.2cqw;
    height: 2.2cqw;
  }

  h1 {
    margin: 0;
    max-width: 20ch;
    font-size: 3.3cqw;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .lede {
    margin: 0;
    max-width: 54ch;
    font-size: 1.3cqw;
    line-height: 1.55;
    color: #4a4f59;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5cqw;
    margin: 0.4cqw 0 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.6cqw 1.2cqw;
    border-radius: 999px;
    border: 1px solid #d8d5cc;
    background: #fff;
    color: #1b1d21;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.3cqw;
    line-height: 1.05;
  }

  .store svg {
    width: 1.6cqw;
    height: 1.6cqw;
    flex: none;
  }

  .store small {
    display: block;
    font-size: 0.64em;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #6f747d;
  }

  .store--pending {
    background: #fbfaf7;
    color: #454a54;
  }

  .ghost {
    font-size: 1.3cqw;
    font-weight: 500;
    color: #454a54;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  .ghost:hover {
    color: #c80028;
  }

  .marks {
    display: flex;
    align-items: center;
    gap: 1.1cqw;
    margin: 0.3cqw 0 -0.75cqw;
    color: #99a0aa;
  }

  .support {
    margin: 0;
    font-size: 1.02cqw;
    color: #74797f;
  }

  .marks :global(.server-logo) {
    width: 1.35cqw;
    height: 1.35cqw;
  }

  @media (max-width: 820px), (max-aspect-ratio: 4 / 5) {
    .fold {
      padding: 84px 0 20px;
    }

    .stage {
      width: min(100%, calc((100svh - 108px) * 39 / 62));
      aspect-ratio: 780 / 1240;
    }

    .art--wide {
      display: none;
    }

    .art--tall {
      display: block;
    }

    .words {
      top: 12%;
      width: 82cqw;
      gap: 2.8cqw;
    }

    .lockup {
      font-size: 3.2cqw;
      gap: 1.6cqw;
    }

    .lockup :global(.mozz-mark) {
      width: 4.9cqw;
      height: 4.9cqw;
    }

    h1 {
      font-size: 7.4cqw;
      max-width: 16ch;
    }

    .lede {
      font-size: 3.1cqw;
      max-width: 38ch;
    }

    .actions {
      gap: 3cqw;
      margin-top: 1cqw;
    }

    .store {
      font-size: 3.1cqw;
      gap: 1.4cqw;
      padding: 1.6cqw 3cqw;
    }

    .store svg {
      width: 3.8cqw;
      height: 3.8cqw;
    }

    .ghost {
      font-size: 3cqw;
    }

    .marks {
      gap: 2.6cqw;
      margin: 0.6cqw 0 -1.4cqw;
    }

    .support {
      font-size: 2.5cqw;
    }

    .marks :global(.server-logo) {
      width: 3.4cqw;
      height: 3.4cqw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost {
      transition: none;
    }
  }
</style>
