---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { APP_STORE_URL, GITHUB_URL } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';
---

<Layout
  title="Garden — a Mozz hero study"
  description="Your own music library, growing into radio, offline listening and a fresh weekly mix with Mozz."
  themeColor="#f5f4e9"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="garden" />

  <main class="hero">
    <a class="wordmark" href="/" aria-label="Mozz home">
      <Mark size={34} decorative />
      <span>Mozz</span>
    </a>

    <header class="intro">
      <h1>{HERO_COPY.headline}</h1>
    </header>

    <figure class="plant" aria-labelledby="garden-caption">
      <div class="plant-art" aria-hidden="true">
        <svg class="stem" viewBox="0 0 480 630" focusable="false">
          <path
            d="M240 558 C240 514 205 500 237 462 C272 421 282 399 244 363 C202 324 204 292 246 258 C284 227 284 187 261 149 C250 130 260 111 289 92"
          />
          <path class="bud-stem" d="M261 149 C235 138 220 136 198 145" />
          <path class="radio-stem" d="M220 339 C188 324 164 317 137 319" />
          <path class="download-stem" d="M258 439 C288 422 315 413 340 417" />
        </svg>

        <div class="bloom">
          <span class="bloom-center">
            <Mark size={68} decorative />
          </span>
        </div>

        <div class="weekly-bud">
          <span>fresh</span>
          <strong>this week’s mix</strong>
        </div>

        <div class="radio-leaf">
          <svg viewBox="0 0 80 80" focusable="false">
            <circle cx="40" cy="40" r="5" />
            <path d="M29 51a16 16 0 0 1 0-22M51 29a16 16 0 0 1 0 22" />
            <path d="M20 60a28 28 0 0 1 0-40M60 20a28 28 0 0 1 0 40" />
          </svg>
          <span>radio</span>
        </div>

        <div class="download-leaf">
          <svg viewBox="0 0 64 64" focusable="false">
            <path d="M32 13v27M21 30l11 11 11-11M17 50h30" />
          </svg>
          <span>offline</span>
        </div>

        <div class="server-pot">
          <span class="pot-label">works with</span>
          <div class="server-row">
            <ServerLogo name="Plex" size={27} brand />
            <ServerLogo name="Jellyfin" size={27} brand />
            <ServerLogo name="Navidrome" size={27} brand />
          </div>
        </div>
      </div>
      <figcaption id="garden-caption">
        A musical stem grows from a home server library into radio, offline listening,
        a weekly mix and Mozz.
      </figcaption>
    </figure>

    <section class="story" aria-label="About Mozz">
      <p>{HERO_COPY.body}</p>
      <p class="discovery">{HERO_COPY.support}</p>
    </section>

    <div class="actions">
      <div class="action-row">
        {
          APP_STORE_URL ? (
            <a class="store-action" href={APP_STORE_URL}>
              <span>Download on the</span>
              <strong>App Store</strong>
            </a>
          ) : (
            <span
              class="store-action is-pending"
              aria-label="Download on the App Store, coming soon"
            >
              <span>Download on the</span>
              <strong>App Store</strong>
              <small>coming soon</small>
            </span>
          )
        }
        <a class="source-action" href={GITHUB_URL}>View source <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    color: #19332c;
    background: #f5f4e9;
    font-family: 'IBM Plex Sans', sans-serif;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: 42px;
    overflow: hidden;
    isolation: isolate;
  }

  .wordmark {
    position: absolute;
    z-index: 4;
    top: 70px;
    left: 5.5vw;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font: 700 1.25rem/1 'Syne', sans-serif;
    letter-spacing: -0.02em;
  }

  .wordmark:hover span {
    color: #c80028;
  }

  .intro {
    position: absolute;
    z-index: 2;
    top: clamp(9.5rem, 20vh, 13rem);
    left: 5.5vw;
    width: min(37vw, 34rem);
  }

  .pot-label,
  .radio-leaf span,
  .download-leaf span,
  .weekly-bud span {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h1 {
    max-width: 11ch;
    color: #19332c;
    font: 500 clamp(3.2rem, 5.6vw, 5.5rem) / 0.96 'IBM Plex Sans', sans-serif;
    letter-spacing: -0.06em;
  }

  .plant {
    position: absolute;
    z-index: 1;
    top: 52%;
    left: 51%;
    width: min(34vw, 26rem);
    aspect-ratio: 480 / 630;
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .plant-art {
    position: absolute;
    inset: 0;
  }

  .stem {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: #66895e;
    stroke-width: 18;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bud-stem,
  .radio-stem,
  .download-stem {
    stroke-width: 9;
  }

  .bloom {
    position: absolute;
    top: 0;
    left: 47%;
    display: grid;
    width: 32%;
    aspect-ratio: 1.07;
    place-items: center;
    background: #c80028;
    border-radius: 52% 48% 43% 57% / 56% 45% 55% 44%;
    transform: rotate(5deg);
  }

  .bloom-center {
    display: grid;
    width: 67%;
    aspect-ratio: 1;
    place-items: center;
    background: #f5f4e9;
    border-radius: 50%;
    transform: rotate(-5deg);
  }

  .weekly-bud {
    position: absolute;
    top: 17%;
    left: 6%;
    display: flex;
    width: 35%;
    min-height: 10%;
    padding: 0.7rem 1rem 0.75rem 1.25rem;
    flex-direction: column;
    justify-content: center;
    color: #19332c;
    background: #e5b75c;
    border-radius: 70% 28% 68% 32% / 58% 50% 50% 42%;
    transform: rotate(-3deg);
  }

  .weekly-bud span {
    font-size: clamp(0.52rem, 0.72vw, 0.64rem);
    font-weight: 600;
    opacity: 0.65;
  }

  .weekly-bud strong {
    margin-top: 0.12rem;
    font: 600 clamp(0.72rem, 1vw, 0.9rem) / 1.1 'Syne', sans-serif;
    letter-spacing: -0.03em;
  }

  .radio-leaf {
    position: absolute;
    top: 39%;
    left: 5%;
    display: grid;
    width: 21%;
    aspect-ratio: 1;
    place-items: center;
    color: #19332c;
    background: #e5b75c;
    border-radius: 50%;
  }

  .radio-leaf svg {
    width: 65%;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 4;
    stroke-linecap: round;
  }

  .radio-leaf path {
    fill: none;
  }

  .radio-leaf span,
  .download-leaf span {
    position: absolute;
    top: calc(100% + 0.45rem);
    font-size: clamp(0.5rem, 0.7vw, 0.62rem);
    font-weight: 600;
  }

  .download-leaf {
    position: absolute;
    top: 61%;
    right: 3%;
    display: grid;
    width: 27%;
    aspect-ratio: 1.55;
    place-items: center;
    color: #f5f4e9;
    background: #66895e;
    border-radius: 70% 30% 68% 32% / 62% 44% 56% 38%;
    transform: rotate(-8deg);
  }

  .download-leaf svg {
    width: 45%;
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .download-leaf span {
    right: 8%;
    color: #19332c;
    transform: rotate(8deg);
  }

  .server-pot {
    position: absolute;
    bottom: 0;
    left: 29.5%;
    display: flex;
    width: 41%;
    height: 18%;
    padding: 1.4rem 1.1rem 0.9rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #19332c;
    background: #dfb27c;
    clip-path: polygon(5% 0, 95% 0, 82% 100%, 18% 100%);
  }

  .server-pot::before {
    position: absolute;
    top: 0;
    right: 3%;
    left: 3%;
    height: 12px;
    content: '';
    background: #c67c5b;
    border-radius: 999px;
  }

  .pot-label {
    margin-bottom: 0.7rem;
    font-size: clamp(0.45rem, 0.65vw, 0.58rem);
    font-weight: 600;
  }

  .server-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.65rem, 1.2vw, 1rem);
  }

  figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .story {
    position: absolute;
    z-index: 2;
    top: clamp(12rem, 30vh, 20rem);
    right: 5.5vw;
    width: min(25vw, 21rem);
    color: #29463e;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.55;
  }

  .discovery {
    margin-top: 1.4rem;
    color: #66895e;
  }

  .actions {
    position: absolute;
    z-index: 3;
    bottom: clamp(2.5rem, 8vh, 5.5rem);
    left: 5.5vw;
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .store-action {
    position: relative;
    display: grid;
    min-width: 11.5rem;
    min-height: 3.65rem;
    padding: 0.55rem 1.2rem 0.62rem;
    align-content: center;
    color: #19332c;
    background: transparent;
    border: 1px solid rgba(25, 51, 44, 0.35);
    border-radius: 0.8rem;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  a.store-action:hover {
    color: #c80028;
    background: transparent;
    border-color: #c80028;
  }

  .store-action > span {
    font-size: 0.67rem;
    line-height: 1;
  }

  .store-action strong {
    margin-top: 0.15rem;
    font: 600 1.15rem/1 'Syne', sans-serif;
    letter-spacing: -0.03em;
  }

  .store-action small {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    color: #66895e;
    font: 600 0.5rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .is-pending {
    opacity: 0.78;
  }

  .source-action {
    padding: 0.75rem 0.25rem;
    font: 600 0.8rem/1 'IBM Plex Mono', monospace;
    border-bottom: 1px solid #66895e;
  }

  .source-action:hover {
    color: #c80028;
    border-color: #c80028;
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      min-height: auto;
      padding: 4.8rem clamp(1.25rem, 6vw, 3rem) 3.5rem;
      flex-direction: column;
      overflow: clip;
    }

    .wordmark,
    .intro,
    .plant,
    .story,
    .actions {
      position: relative;
      inset: auto;
      width: auto;
      transform: none;
    }

    .wordmark {
      align-self: flex-start;
    }

    .intro {
      margin-top: clamp(3.5rem, 9vw, 5.5rem);
    }

    h1 {
      max-width: 9.5ch;
      font-size: clamp(3rem, 11vw, 5.5rem);
    }

    .plant {
      width: min(90%, 24rem);
      margin: 0.5rem auto 0;
      flex: none;
    }

    .story {
      width: min(100%, 35rem);
      margin: 0.75rem auto 0;
      font-size: 1.05rem;
    }

    .actions {
      width: min(100%, 35rem);
      margin: 2.5rem auto 0;
    }

    .weekly-bud span {
      font-size: clamp(0.5rem, 1.6vw, 0.64rem);
    }

    .weekly-bud strong {
      font-size: clamp(0.68rem, 2.5vw, 0.9rem);
    }

    .radio-leaf span,
    .download-leaf span {
      font-size: clamp(0.48rem, 1.5vw, 0.62rem);
    }

    .pot-label {
      font-size: clamp(0.45rem, 1.4vw, 0.58rem);
    }
  }

  @media (max-width: 470px) {
    .hero {
      padding-inline: 1.15rem;
    }

    .plant {
      width: 100%;
    }

    .server-pot {
      padding-inline: 0.75rem;
    }

    .server-row {
      gap: 0.6rem;
    }

    .action-row {
      align-items: stretch;
      flex-direction: column;
    }

    .store-action {
      width: 100%;
    }

    .source-action {
      align-self: flex-start;
    }

  }

</style>
