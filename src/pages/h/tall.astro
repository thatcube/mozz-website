---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';
---

<Layout
  title={`${NAME} — a free player for your self-hosted music`}
  description="Mozz plays music from your own server on iPhone and iPad. Stream at home or download albums for offline listening."
  themeColor="#eae4d9"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="tall" />

  <main class="hero">
    <header class="intro">
      <div class="brand">
        <Mark size={25} decorative />
        <span>{NAME}</span>
      </div>

      <h1>Your music. Your server.<br />A free player.</h1>
      <p class="lede">
        Stream your library on iPhone and iPad, or download albums for offline listening.
      </p>

      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View on GitHub <span aria-hidden="true">↗</span></a>
      </div>

      <p class="compatibility">Works with Plex · Jellyfin · Navidrome · Subsonic</p>
    </header>

    <div
      class="phone"
      role="img"
      aria-label="An oversized iPhone showing the Mozz now playing screen with original abstract album artwork"
    >
      <span class="side side-left-one" aria-hidden="true"></span>
      <span class="side side-left-two" aria-hidden="true"></span>
      <span class="side side-right" aria-hidden="true"></span>

      <div class="screen">
        <div class="status" aria-hidden="true">
          <span>9:41</span>
          <span class="status-icons">
            <svg viewBox="0 0 20 14">
              <path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z" />
            </svg>
            <svg viewBox="0 0 20 14">
              <path d="M2 5.5C6.2 1.8 13.8 1.8 18 5.5l-1.7 1.8C13.2 4.6 6.8 4.6 3.7 7.3zm3.1 3.1C7.7 6.4 12.3 6.4 14.9 8.6l-1.8 1.8c-1.7-1.4-4.5-1.4-6.2 0zm3 3.1c1.1-.9 2.7-.9 3.8 0L10 13.5z" />
            </svg>
            <svg viewBox="0 0 28 14">
              <rect x="1" y="1" width="23" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M25 5h2v4h-2z" />
              <rect x="3.5" y="3.5" width="17" height="7" rx="1.4" />
            </svg>
          </span>
        </div>

        <div class="appbar">
          <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <small>PLAYING FROM ALBUM</small>
            <span>Color Before Dawn</span>
          </div>
          <svg class="more" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="5" cy="12" r="1.5" />
            <circle cx="12" cy="12" r="1.5" />
            <circle cx="19" cy="12" r="1.5" />
          </svg>
        </div>

        <div class="art" aria-hidden="true">
          <div class="sun"></div>
          <div class="blue-plane"></div>
          <div class="red-plane"></div>
          <div class="yellow-plane"></div>
          <div class="art-type">
            <span>COLOR</span>
            <span>BEFORE</span>
            <span>DAWN</span>
          </div>
          <span class="catalogue">MV—042</span>
        </div>

        <div class="track">
          <div class="track-copy">
            <strong>Lines in the Static</strong>
            <span>Morrow Circuit</span>
          </div>
          <svg class="heart" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.8-7.7 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" fill="none" stroke="currentColor" stroke-width="1.8" />
          </svg>
        </div>

        <div class="progress" aria-hidden="true">
          <div class="progress-line"><span></span><i></i></div>
          <div class="times"><span>1:42</span><span>−2:16</span></div>
        </div>

        <div class="controls" aria-hidden="true">
          <svg viewBox="0 0 28 28">
            <path d="M4 9h4.5c5 0 6.2 10 11.2 10H24m-4-4 4 4-4 4M4 19h4.5c2 0 3.3-1.7 4.6-3.7m3.4-5.5c1-1 2-1.8 3.2-1.8H24m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg viewBox="0 0 34 34">
            <path d="M8 8v18M27 8 11 17l16 9z" />
          </svg>
          <span class="play">
            <svg viewBox="0 0 44 44"><path d="m17 12 17 10-17 10z" /></svg>
          </span>
          <svg viewBox="0 0 34 34">
            <path d="M26 8v18M7 8l16 9-16 9z" />
          </svg>
          <svg viewBox="0 0 28 28">
            <path d="M5 9h14a5 5 0 0 1 5 5v1m-4-10 4 4-4 4M23 19H9a5 5 0 0 1-5-5v-1m4 10-4-4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="device-strip" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M8 21h8M12 17v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span>iPhone</span>
          <svg class="queue" viewBox="0 0 24 24">
            <path d="M4 7h12M4 12h12M4 17h8m7-2v6l4-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="home-indicator" aria-hidden="true"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  :global(html) {
    background: #eae4d9;
  }

  :global(body) {
    min-width: 0;
    overflow: hidden;
    color: #1f2124;
    background:
      radial-gradient(circle at 50% 88%, rgba(200, 0, 40, 0.07), transparent 34rem),
      #eae4d9;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .intro {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 66px 20px 0;
    text-align: center;
    animation: settle-copy 700ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-family: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  h1 {
    max-width: 900px;
    font-family: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(39px, 4.6vw, 66px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.062em;
  }

  .lede {
    max-width: 580px;
    margin-top: 12px;
    color: #56534f;
    font-size: 15px;
    line-height: 1.45;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 14px;
  }

  .store,
  .source {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 17px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.005em;
  }

  .store {
    color: #fff;
    background: #c80028;
    box-shadow: 0 8px 20px rgba(200, 0, 40, 0.16);
  }

  .store.is-pending {
    cursor: default;
  }

  .source {
    border: 1px solid rgba(31, 33, 36, 0.22);
    background: rgba(255, 255, 255, 0.24);
  }

  .source span {
    margin-left: 6px;
    font-size: 14px;
  }

  .source:focus-visible {
    outline: 3px solid #c80028;
    outline-offset: 3px;
  }

  .compatibility {
    margin-top: 10px;
    padding: 2px 9px 3px;
    border-radius: 999px;
    color: #716d66;
    background: rgba(234, 228, 217, 0.94);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .phone {
    --phone-w: clamp(450px, 37vw, 532px);
    position: absolute;
    z-index: 1;
    top: 315px;
    left: 50%;
    width: var(--phone-w);
    height: calc(var(--phone-w) * 2.04);
    padding: calc(var(--phone-w) * 0.025);
    transform: translateX(-50%);
    border: 2px solid #08090a;
    border-radius: calc(var(--phone-w) * 0.14);
    background: linear-gradient(115deg, #36383c 0%, #0c0d0f 20%, #050607 78%, #292b2f 100%);
    box-shadow:
      0 24px 65px rgba(39, 27, 24, 0.28),
      0 3px 0 rgba(255, 255, 255, 0.22) inset,
      0 0 0 1px rgba(0, 0, 0, 0.45);
    animation: rise-phone 900ms cubic-bezier(0.16, 0.84, 0.24, 1) both;
  }

  .phone::before {
    content: '';
    position: absolute;
    z-index: 5;
    top: calc(var(--phone-w) * 0.031);
    left: 50%;
    width: calc(var(--phone-w) * 0.27);
    height: calc(var(--phone-w) * 0.075);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #030405;
    box-shadow: 0 1px 1px rgba(255, 255, 255, 0.12) inset;
  }

  .phone::after {
    content: '';
    position: absolute;
    z-index: 6;
    top: calc(var(--phone-w) * 0.054);
    left: calc(50% + var(--phone-w) * 0.075);
    width: calc(var(--phone-w) * 0.022);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #091325;
    box-shadow: 0 0 0 2px #111824, 0 0 5px rgba(67, 113, 189, 0.55) inset;
  }

  .side {
    position: absolute;
    width: 4px;
    border-radius: 3px 0 0 3px;
    background: #17181b;
  }

  .side-left-one {
    top: 18%;
    left: -5px;
    height: 8%;
  }

  .side-left-two {
    top: 28%;
    left: -5px;
    height: 13%;
  }

  .side-right {
    top: 26%;
    right: -5px;
    height: 17%;
    border-radius: 0 3px 3px 0;
  }

  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--phone-w) * 0.115);
    color: #f8f5f0;
    background:
      linear-gradient(180deg, rgba(12, 19, 35, 0.2), #10131a 47%, #090b10 82%),
      #0d1017;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .screen::before {
    content: '';
    position: absolute;
    inset: 0 0 45%;
    background:
      radial-gradient(circle at 75% 5%, rgba(80, 119, 255, 0.46), transparent 38%),
      radial-gradient(circle at 20% 25%, rgba(230, 25, 63, 0.35), transparent 48%);
    filter: blur(calc(var(--phone-w) * 0.045));
    opacity: 0.8;
  }

  .status {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--phone-w) * 0.105);
    padding: calc(var(--phone-w) * 0.025) calc(var(--phone-w) * 0.07) 0;
    font-size: calc(var(--phone-w) * 0.025);
    font-weight: 600;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: calc(var(--phone-w) * 0.014);
  }

  .status-icons svg {
    width: calc(var(--phone-w) * 0.038);
    height: calc(var(--phone-w) * 0.027);
    color: #fff;
    fill: currentColor;
  }

  .status-icons svg:last-child {
    width: calc(var(--phone-w) * 0.052);
  }

  .appbar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 4fr 1fr;
    align-items: center;
    min-height: calc(var(--phone-w) * 0.11);
    padding: 0 calc(var(--phone-w) * 0.035);
    text-align: center;
  }

  .appbar svg {
    width: calc(var(--phone-w) * 0.045);
  }

  .appbar .more {
    justify-self: end;
    fill: currentColor;
  }

  .appbar small,
  .appbar span {
    display: block;
  }

  .appbar small {
    margin-bottom: 2px;
    color: rgba(255, 255, 255, 0.62);
    font-size: calc(var(--phone-w) * 0.014);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .appbar span {
    overflow: hidden;
    font-size: calc(var(--phone-w) * 0.024);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .art {
    position: relative;
    z-index: 2;
    width: 78%;
    aspect-ratio: 1;
    margin: calc(var(--phone-w) * 0.018) auto 0;
    overflow: hidden;
    border-radius: calc(var(--phone-w) * 0.014);
    color: #fff7db;
    background: #152b8e;
    box-shadow:
      0 calc(var(--phone-w) * 0.035) calc(var(--phone-w) * 0.09) rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .sun {
    position: absolute;
    top: -9%;
    right: -11%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffbd3d;
    box-shadow: 0 0 calc(var(--phone-w) * 0.08) rgba(255, 191, 61, 0.42);
  }

  .blue-plane,
  .red-plane,
  .yellow-plane {
    position: absolute;
    transform-origin: center;
  }

  .blue-plane {
    inset: 25% -12% -13% 42%;
    transform: rotate(19deg);
    border-radius: 46% 0 0;
    background: #305ce8;
  }

  .red-plane {
    inset: 48% 30% -19% -13%;
    transform: rotate(-12deg);
    border-radius: 0 58% 0 0;
    background: #db153a;
  }

  .yellow-plane {
    right: 13%;
    bottom: -19%;
    width: 37%;
    height: 71%;
    transform: rotate(37deg);
    border-radius: 999px 999px 0 0;
    background: #ffca3b;
  }

  .art-type {
    position: absolute;
    z-index: 2;
    top: 8%;
    left: 8%;
    display: flex;
    flex-direction: column;
    font-family: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: calc(var(--phone-w) * 0.068);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.07em;
    mix-blend-mode: screen;
  }

  .art-type span:nth-child(2) {
    margin-left: calc(var(--phone-w) * 0.09);
  }

  .art-type span:nth-child(3) {
    margin-left: calc(var(--phone-w) * 0.025);
  }

  .catalogue {
    position: absolute;
    z-index: 2;
    right: 6%;
    bottom: 5%;
    color: #131725;
    font-size: calc(var(--phone-w) * 0.016);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .track {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 78%;
    margin: calc(var(--phone-w) * 0.043) auto 0;
  }

  .track-copy strong,
  .track-copy span {
    display: block;
  }

  .track-copy strong {
    font-size: calc(var(--phone-w) * 0.038);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .track-copy span {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.58);
    font-size: calc(var(--phone-w) * 0.026);
  }

  .heart {
    width: calc(var(--phone-w) * 0.046);
  }

  .progress {
    position: relative;
    z-index: 2;
    width: 78%;
    margin: calc(var(--phone-w) * 0.037) auto 0;
  }

  .progress-line {
    position: relative;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
  }

  .progress-line span {
    display: block;
    width: 43%;
    height: 100%;
    border-radius: inherit;
    background: #f7f4ee;
  }

  .progress-line i {
    position: absolute;
    top: 50%;
    left: 43%;
    width: calc(var(--phone-w) * 0.018);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
  }

  .times {
    display: flex;
    justify-content: space-between;
    margin-top: calc(var(--phone-w) * 0.014);
    color: rgba(255, 255, 255, 0.5);
    font-size: calc(var(--phone-w) * 0.019);
    font-variant-numeric: tabular-nums;
  }

  .controls {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 78%;
    margin: calc(var(--phone-w) * 0.02) auto 0;
  }

  .controls > svg {
    width: calc(var(--phone-w) * 0.054);
    fill: currentColor;
  }

  .controls > svg:nth-child(2),
  .controls > svg:nth-child(4) {
    width: calc(var(--phone-w) * 0.067);
  }

  .controls .play {
    display: grid;
    place-items: center;
    width: calc(var(--phone-w) * 0.123);
    aspect-ratio: 1;
    border-radius: 50%;
    color: #0c0e13;
    background: #fff;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22);
  }

  .play svg {
    width: 58%;
    fill: currentColor;
  }

  .device-strip {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 78%;
    margin: calc(var(--phone-w) * 0.04) auto 0;
    color: #f0617e;
    font-size: calc(var(--phone-w) * 0.023);
    font-weight: 500;
  }

  .device-strip svg {
    width: calc(var(--phone-w) * 0.04);
    margin-right: 6px;
  }

  .device-strip .queue {
    margin-right: 0;
    margin-left: auto;
  }

  .home-indicator {
    position: absolute;
    bottom: calc(var(--phone-w) * 0.017);
    left: 50%;
    width: 34%;
    height: 4px;
    transform: translateX(-50%);
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.8);
  }

  @keyframes settle-copy {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @keyframes rise-phone {
    from {
      opacity: 0;
      transform: translate(-50%, 44px);
    }
  }

  @media (max-width: 600px) {
    .intro {
      padding: 59px 16px 0;
    }

    .brand {
      margin-bottom: 7px;
      font-size: 18px;
    }

    h1 {
      font-size: clamp(36px, 10.4vw, 43px);
      line-height: 0.91;
    }

    .lede {
      max-width: 355px;
      margin-top: 10px;
      font-size: 13px;
      line-height: 1.35;
    }

    .actions {
      gap: 7px;
      margin-top: 12px;
    }

    .store,
    .source {
      min-height: 35px;
      padding: 0 13px;
      font-size: 10.5px;
    }

    .compatibility {
      margin-top: 8px;
      font-size: 8px;
      letter-spacing: 0.045em;
    }

    .phone {
      --phone-w: 446px;
      top: 302px;
      box-shadow:
        0 20px 48px rgba(39, 27, 24, 0.23),
        0 3px 0 rgba(255, 255, 255, 0.22) inset,
        0 0 0 1px rgba(0, 0, 0, 0.45);
    }

    .art {
      width: 86%;
    }

    .track,
    .progress,
    .controls,
    .device-strip {
      width: 86%;
    }
  }

  @media (max-width: 360px) {
    h1 {
      font-size: 35px;
    }

    .phone {
      top: 306px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .phone {
      animation: none;
    }
  }
</style>
