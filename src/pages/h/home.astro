---
/**
 * Home — art set.
 *
 * A painted dusk valley. The library lives in the house on the left, warm light
 * pouring out of its windows; the listener is further down the valley on a
 * bench, the same gold light in their hand. No interface, no arrows, no labels:
 * the colour does the connecting.
 */
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

/** Warm motes carried down the valley on the evening air. Deterministic, so the
 *  server render and the client render agree. */
const drift = Array.from({ length: 56 }, (_, i) => {
  const t = i / 55;
  const wob = Math.sin(i * 2.399);
  const wob2 = Math.cos(i * 1.712);
  return {
    x: +(686 + t * 442 + wob * 38).toFixed(1),
    y: +(320 - Math.sin(t * Math.PI) * 92 + t * 126 + wob2 * 42).toFixed(1),
    r: +(1.1 + Math.abs(Math.sin(i * 0.97)) * 2.2).toFixed(2),
    o: +(0.2 + Math.abs(Math.cos(i * 1.31)) * 0.6).toFixed(2),
    d: +((i % 11) * 0.63).toFixed(2),
    s: +(6.4 + (i % 7) * 0.9).toFixed(1),
  };
});

/** A thinner scatter over the rest of the valley, so the air is never empty. */
const ambient = Array.from({ length: 30 }, (_, i) => ({
  x: +(150 + ((i * 173) % 1360)).toFixed(1),
  y: +(248 + ((i * 61) % 190)).toFixed(1),
  r: +(0.8 + (i % 3) * 0.45).toFixed(2),
  o: +(0.1 + (i % 4) * 0.07).toFixed(2),
  d: +((i % 9) * 0.71).toFixed(2),
  s: +(8 + (i % 5) * 1.3).toFixed(1),
}));

const stars = Array.from({ length: 46 }, (_, i) => ({
  x: +(((i * 211) % 1580) + 10).toFixed(1),
  y: +(((i * 97) % 392) + 8).toFixed(1),
  r: +(0.7 + (i % 3) * 0.45).toFixed(2),
  o: +(0.16 + (i % 5) * 0.1).toFixed(2),
  d: +((i % 8) * 0.9).toFixed(2),
}));

/** Grass along the very front of the frame, in clumps so it reads drawn, not combed. */
const blades = [70, 240, 430, 640, 880, 1050, 1290, 1480].flatMap((cx, ci) =>
  Array.from({ length: 6 }, (_, j) => {
    const k = ci * 7 + j;
    const x = cx + (j - 2.5) * 17 + Math.sin(k * 2.7) * 6;
    const h = 16 + Math.abs(Math.sin(k * 1.9)) * 26;
    const lean = Math.sin(k * 1.31) * 15;
    const base = 594 + Math.sin(ci * 1.3) * 7;
    return {
      d: `M${x.toFixed(1)} ${base.toFixed(1)} Q ${(x + lean * 0.32).toFixed(1)} ${(base - h * 0.64).toFixed(1)} ${(x + lean).toFixed(1)} ${(base - h).toFixed(1)}`,
      w: +(2.2 + (k % 4) * 0.8).toFixed(1),
    };
  })
);
---

<Layout
  title={`${NAME} — a free player for your self-hosted music`}
  description="Mozz plays the music on your own Plex, Jellyfin, Navidrome or Subsonic server, on iPhone and iPad. Stream it from anywhere or download albums and listen with no signal."
  themeColor="#0a1c28"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Karla:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="home" />

  <div class="stage">
    <svg class="stars" viewBox="0 0 1600 460" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
      {stars.map((s) => (
        <circle class="star" cx={s.x} cy={s.y} r={s.r} fill="#dfeaf0" opacity={s.o} style={`--d:${s.d}s`} />
      ))}
    </svg>

    <svg
      class="moon"
      viewBox="0 0 420 420"
      role="img"
      aria-label="A moon low in the evening sky with the grooves and centre label of a record"
