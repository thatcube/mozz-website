      <defs>
        <radialGradient id="homeMoonHalo">
          <stop offset="0.42" stop-color="#ffe0ac" stop-opacity="0.34" />
          <stop offset="0.72" stop-color="#ffc857" stop-opacity="0.1" />
          <stop offset="1" stop-color="#ffc857" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="homeMoonFace" cx="0.38" cy="0.32" r="0.82">
          <stop offset="0" stop-color="#fdf1d8" />
          <stop offset="0.62" stop-color="#f0dcb4" />
          <stop offset="1" stop-color="#cbaf82" />
        </radialGradient>
        <linearGradient id="homeMoonShade" x1="0.1" y1="0" x2="0.9" y2="1">
          <stop offset="0.35" stop-color="#132a3a" stop-opacity="0" />
          <stop offset="1" stop-color="#132a3a" stop-opacity="0.42" />
        </linearGradient>
      </defs>

      <circle cx="210" cy="210" r="208" fill="url(#homeMoonHalo)" />
      <circle cx="210" cy="210" r="152" fill="url(#homeMoonFace)" />
      <g fill="none" stroke="#132a3a" stroke-opacity="0.1">
        <circle cx="210" cy="210" r="52" stroke-width="1.4" />
        <circle cx="210" cy="210" r="66" stroke-width="1.6" />
        <circle cx="210" cy="210" r="80" stroke-width="1.3" />
        <circle cx="210" cy="210" r="94" stroke-width="1.7" />
        <circle cx="210" cy="210" r="108" stroke-width="1.3" />
        <circle cx="210" cy="210" r="122" stroke-width="1.6" />
        <circle cx="210" cy="210" r="136" stroke-width="1.3" />
        <circle cx="210" cy="210" r="147" stroke-width="1.5" />
      </g>
      <circle cx="210" cy="210" r="40" fill="#c80028" />
      <circle cx="210" cy="210" r="40" fill="none" stroke="#8d0020" stroke-width="1.6" stroke-opacity="0.55" />
      <circle cx="210" cy="210" r="5" fill="#1a3346" />
      <circle cx="210" cy="210" r="152" fill="url(#homeMoonShade)" />
    </svg>

    <svg
      class="land"
      viewBox="0 0 1600 620"
      role="img"
      aria-label="A house on a hillside at dusk with its windows lit gold and a hi-fi glowing in one room, while warm specks of light drift down the valley to a person on a bench wearing headphones, a phone glowing in their hand"
