          <stop offset="0.78" stop-color="#040e16" stop-opacity="0.25" />
          <stop offset="1" stop-color="#03090f" stop-opacity="0.75" />
        </linearGradient>
        <filter id="homeSoft" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
        <filter id="homeSofter" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="26" />
        </filter>
        <filter id="homeSmoke" x="-60%" y="-30%" width="220%" height="180%">
          <feGaussianBlur stdDeviation="7" />
        </filter>
      </defs>

