        </radialGradient>
        <radialGradient id="homeHouseGlow">
          <stop offset="0" stop-color="#ffc857" stop-opacity="0.36" />
          <stop offset="0.4" stop-color="#ffb43a" stop-opacity="0.15" />
          <stop offset="1" stop-color="#ffb43a" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="homePhoneGlow">
          <stop offset="0" stop-color="#ffd97e" stop-opacity="0.62" />
          <stop offset="0.5" stop-color="#ffc857" stop-opacity="0.2" />
          <stop offset="1" stop-color="#ffc857" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="homeGround" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0f3242" />
          <stop offset="0.55" stop-color="#0a2331" />
          <stop offset="1" stop-color="#061621" />
        </linearGradient>
        <linearGradient id="homeWindow" x1="0" y1="0" x2="0.3" y2="1">
