      />
      <g fill="#ffc857" opacity="0.5">
        <circle cx="178" cy="207" r="1.9" />
        <circle cx="212" cy="211" r="1.6" />
        <circle cx="262" cy="203" r="1.7" />
        <circle cx="1298" cy="192" r="1.6" />
        <circle cx="1338" cy="196" r="1.5" />
      </g>

      <path
        d="M0 272 C 160 252 280 266 420 248 C 560 230 700 254 840 246 C 980 238 1120 266 1260 252 C 1400 238 1500 262 1600 250 L1600 620 L0 620 Z"
