      />

      <ellipse cx="640" cy="286" rx="820" ry="86" fill="#4ea699" opacity="0.13" filter="url(#homeSofter)" />

      <path
        d="M0 336 C 180 324 320 310 470 302 C 600 295 700 304 820 318 C 980 336 1160 348 1330 340 C 1440 335 1520 340 1600 334 L1600 620 L0 620 Z"
        fill="url(#homeGround)"
      />

      <ellipse cx="500" cy="356" rx="680" ry="120" fill="#2f7d75" opacity="0.16" filter="url(#homeSofter)" />

      <g fill="#0a2833">
        <path d="M362 320 l-15 0 l15 -42 l15 42 z" />
        <path d="M396 322 l-12 0 l12 -32 l12 32 z" />
        <path d="M806 328 l-16 0 l16 -46 l16 46 z" />
        <path d="M846 330 l-13 0 l13 -36 l13 36 z" />
        <path d="M884 331 l-11 0 l11 -28 l11 28 z" />
      </g>

      <g class="homestead" transform="translate(-16 32) translate(570 348) scale(1.1) translate(-570 -348)">
        <ellipse cx="580" cy="300" rx="440" ry="260" fill="url(#homeHouseGlow)" class="breathe" />
        <ellipse cx="588" cy="376" rx="250" ry="52" fill="#ffb43a" opacity="0.14" filter="url(#homeSoft)" />

        <path
          d="M470 328 L560 328 L664 442 L426 442 Z"
          fill="url(#homeSpill)"
          filter="url(#homeSoft)"
          opacity="0.8"
        />
        <path
          d="M646 348 L684 348 L752 434 L636 434 Z"
          fill="url(#homeSpill)"
          filter="url(#homeSoft)"
          opacity="0.65"
        />

        <g class="house">
        <path d="M652 190 h28 v66 h-28 z" fill="#091a22" />
        <path
          d="M660 186 C 648 160 676 152 664 128 C 656 110 678 100 672 84"
          fill="none"
          stroke="#cfe0e4"
          stroke-opacity="0.13"
          stroke-width="9"
          stroke-linecap="round"
          filter="url(#homeSmoke)"
        />
        <path d="M430 258 L570 168 L742 258 Z" fill="#0a1c24" />
        <path d="M446 256 h250 v92 h-250 z" fill="#0d2530" />
        <path d="M446 256 h34 v92 h-34 z" fill="#081820" />

        <rect x="492" y="272" width="88" height="60" rx="2" fill="url(#homeWindow)" />
        <g class="hifi">
          <rect x="504" y="284" width="21" height="38" rx="2.5" fill="#0d2a2c" />
          <circle cx="514.5" cy="292" r="2.3" fill="#4ea699" />
          <circle cx="514.5" cy="300" r="2.3" fill="#4ea699" opacity="0.75" />
          <circle cx="514.5" cy="308" r="2.3" fill="#c80028" />
          <circle cx="551" cy="304" r="12" fill="#0d2a2c" />
          <circle cx="551" cy="304" r="5" fill="#1d4a44" />
          <path d="M566 322 v-16 a7 7 0 0 1 12 -5" fill="none" stroke="#0d2a2c" stroke-width="3.4" />
        </g>
        <path d="M536 272 v60 M492 304 h88" stroke="#0d2530" stroke-width="3.4" opacity="0.65" />

        <rect x="600" y="278" width="40" height="36" rx="2" fill="#ffc857" opacity="0.9" />
        <path d="M620 278 v36" stroke="#0d2530" stroke-width="3" opacity="0.55" />
        <rect x="656" y="300" width="34" height="48" rx="1.5" fill="#ffbe4d" opacity="0.86" />
        <path d="M446 254 L570 174 L742 254" fill="none" stroke="#ffc857" stroke-width="2.6" opacity="0.24" />
        </g>
      </g>

      <g fill="none" stroke="#ffc857" filter="url(#homeSofter)" class="ripples">
        <ellipse cx="560" cy="300" rx="190" ry="150" stroke-opacity="0.07" stroke-width="9" />
        <ellipse cx="560" cy="300" rx="292" ry="216" stroke-opacity="0.05" stroke-width="11" />
        <ellipse cx="560" cy="300" rx="404" ry="286" stroke-opacity="0.035" stroke-width="13" />
      </g>

      <g class="motes">
        {ambient.map((m) => (
          <circle class="mote" cx={m.x} cy={m.y} r={m.r} fill="#ffdf9d" opacity={m.o} style={`--d:${m.d}s;--s:${m.s}s`} />
        ))}
        {drift.map((m) => (
          <circle class="mote" cx={m.x} cy={m.y} r={m.r} fill="#ffcf72" opacity={m.o} style={`--d:${m.d}s;--s:${m.s}s`} />
        ))}
      </g>

      <path
        d="M0 492 C 200 474 360 490 520 500 C 700 511 860 498 1020 502 C 1200 507 1400 496 1600 486 L1600 620 L0 620 Z"
        fill="#03101a"
      />

      <ellipse class="faraway" cx="1152" cy="430" rx="150" ry="128" fill="url(#homePhoneGlow)" filter="url(#homeSoft)" />

      <g class="faraway" fill="#030d16">
        <rect x="962" y="404" width="12" height="146" rx="3" />
        <rect x="1172" y="404" width="12" height="140" rx="3" />
        <rect x="946" y="402" width="238" height="12" rx="4" />
        <rect x="946" y="426" width="238" height="12" rx="4" />
        <rect x="936" y="456" width="258" height="15" rx="4" />
      </g>

      <g class="figure faraway" fill="#020a11">
        <path d="M1092 394 C 1116 398 1140 410 1152 428 L1136 444 C 1122 428 1104 418 1084 414 Z" />
        <path d="M1030 470 C 1024 434 1032 400 1048 382 C 1062 366 1090 366 1100 382 C 1110 398 1108 434 1102 470 Z" />
        <path d="M1064 448 C 1094 450 1122 456 1132 466 C 1141 480 1143 514 1140 542 L1112 542 C 1114 512 1110 492 1100 484 C 1088 476 1070 472 1058 470 Z" />
        <ellipse cx="1126" cy="546" rx="24" ry="9" />
        <circle cx="1074" cy="350" r="34" />
        <path d="M1044 340 A 34 34 0 0 1 1106 336" fill="none" stroke="#020a11" stroke-width="9" stroke-linecap="round" />
        <ellipse cx="1046" cy="354" rx="11" ry="14" />
      </g>

      <g class="faraway" fill="none" stroke="#ffc857" stroke-linecap="round">
        <path d="M1096 327 A 34 34 0 0 1 1101 368" stroke-width="3.6" stroke-opacity="0.5" />
        <path d="M1100 386 C 1107 406 1107 436 1101 462" stroke-width="3" stroke-opacity="0.3" />
        <path d="M1122 424 C 1132 428 1140 434 1146 442" stroke-width="3" stroke-opacity="0.35" />
      </g>

      <g class="faraway">
        <g transform="rotate(-16 1154 428)">
          <rect x="1143" y="408" width="22" height="40" rx="5" fill="url(#homePhone)" />
          <rect x="1147" y="413" width="14" height="30" rx="3" fill="#fff6de" opacity="0.55" />
        </g>
      </g>

      <g fill="#010810">
        <path d="M0 548 C 180 556 330 586 470 582 C 640 576 780 592 940 586 C 1120 579 1300 594 1440 578 C 1520 568 1570 574 1600 566 L1600 620 L0 620 Z" />
        <ellipse cx="126" cy="566" rx="96" ry="28" />
        <ellipse cx="1512" cy="566" rx="84" ry="24" />
        <ellipse cx="712" cy="590" rx="58" ry="16" />
      </g>
      <ellipse cx="1180" cy="548" rx="640" ry="104" fill="#4ea699" opacity="0.1" filter="url(#homeSofter)" />
      <ellipse class="faraway" cx="1230" cy="534" rx="300" ry="78" fill="url(#homePhoneGlow)" opacity="0.42" filter="url(#homeSoft)" />
      <g fill="none" stroke="#164049" stroke-linecap="round" opacity="0.5">
        {blades.map((b) => (
          <path d={b.d} stroke-width={b.w} transform="translate(-4 -3)" />
        ))}
      </g>
      <g fill="none" stroke="#010810" stroke-linecap="round">
        {blades.map((b) => (
          <path d={b.d} stroke-width={b.w} />
        ))}
      </g>

      <rect x="0" y="330" width="1600" height="290" fill="url(#homeVignette)" />
    </svg>

    <div class="scrim" aria-hidden="true"></div>

    <main class="copy">
      <p class="brand">
        <Mark size={26} decorative />
        <span>{NAME}</span>
      </p>

      <h1>
        Your server stays home.<br />
        <em>Your music comes with you.</em>
      </h1>

      <p class="lede">
        Mozz is a free music player for iPhone and iPad. It plays the library on your own Plex, Jellyfin,
        Navidrome or Subsonic server — stream it from wherever you are, or download albums and listen with
        no signal at all.
      </p>

      <p class="support">Radio and Mozz Weekly included. Free forever. Open source.</p>

      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View the source <span aria-hidden="true">↗</span></a>
      </div>

      <p class="works">
        <span class="works-label">Works with</span>
        <span class="chip"><ServerLogo name="Plex" size={15} />Plex</span>
        <span class="chip"><ServerLogo name="Jellyfin" size={15} />Jellyfin</span>
        <span class="chip"><ServerLogo name="Navidrome" size={15} />Navidrome</span>
        <span class="chip">Subsonic</span>
      </p>
    </main>
  </div>
</Layout>

<style>
  .stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 74% at 34% 78%, rgba(210, 118, 62, 0.24) 0%, rgba(210, 118, 62, 0) 62%),
      linear-gradient(180deg, #060f18 0%, #0a1c28 26%, #10303f 52%, #17414a 72%, #2a5551 88%, #43655a 100%);
    color: #f6ead7;
    font-family: 'Karla', system-ui;
  }

  .stars {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 62%;
    z-index: 0;
  }

  .star {
    animation: twinkle 5.5s ease-in-out infinite alternate;
    animation-delay: var(--d);
  }

  @keyframes twinkle {
    from { opacity: 0.15; }
    to { opacity: 0.85; }
  }

  .moon {
    position: absolute;
    z-index: 0;
    width: clamp(200px, 21vw, 316px);
    height: auto;
    right: clamp(-46px, -1.4vw, 0px);
    top: clamp(34px, 6vh, 74px);
  }

  .land {
    position: absolute;
    z-index: 1;
    bottom: 0;
    left: 0;
    width: 100%;
    height: auto;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(5, 14, 22, 0.68) 0%, rgba(5, 14, 22, 0.3) 34%, rgba(5, 14, 22, 0) 58%);
  }

  .breathe {
    animation: breathe 9s ease-in-out infinite alternate;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes breathe {
    from { opacity: 0.82; }
    to { opacity: 1.12; }
  }

  .mote {
    transform-box: fill-box;
    transform-origin: center;
    animation: float var(--s, 8s) ease-in-out infinite alternate;
    animation-delay: var(--d, 0s);
  }

  @keyframes float {
    from { transform: translate(0, 5px); opacity: 0.35; }
    to { transform: translate(9px, -8px); opacity: 1; }
  }

  .copy {
    position: relative;
    z-index: 3;
    max-width: 830px;
    margin: 0 auto;
    padding: clamp(58px, 7.4vh, 84px) 24px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffc857;
    margin: 0 0 clamp(12px, 2vh, 20px);
  }

  h1 {
    font-family: 'Newsreader', 'Iowan Old Style', Georgia;
    font-weight: 400;
    font-size: clamp(2.3rem, 5.6vw, 4.3rem);
    line-height: 1.04;
    letter-spacing: -0.014em;
    margin: 0;
    text-wrap: balance;
    text-shadow: 0 2px 26px rgba(4, 12, 20, 0.7);
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
    color: #ffc857;
  }

  .lede {
    margin: clamp(14px, 2.2vh, 20px) 0 0;
    max-width: 56ch;
    font-size: clamp(0.99rem, 1.15vw, 1.1rem);
    line-height: 1.58;
    color: rgba(238, 228, 210, 0.84);
    text-shadow: 0 1px 16px rgba(4, 12, 20, 0.6);
  }

  .support {
    margin: 10px 0 0;
    font-size: 0.88rem;
    letter-spacing: 0.01em;
    color: rgba(120, 214, 194, 0.92);
    text-shadow: 0 1px 14px rgba(4, 12, 20, 0.7);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
