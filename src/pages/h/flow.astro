---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';
---

<Layout
  title={`${NAME} — a free player for your self-hosted music`}
  description="Mozz is a free, open source music player for iPhone and iPad. Stream from your own Plex, Jellyfin or Navidrome server, or download albums for offline listening."
  themeColor="#1b1a2e"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="flow" />

  <main class="flow">
    <div class="glow" aria-hidden="true"></div>

    <header class="intro">
      <a class="wordmark" href={GITHUB_URL} aria-label="Mozz on GitHub">
        <Mark size={25} decorative />
        <span>Mozz</span>
        <i>for iPhone + iPad</i>
      </a>
      <h1>Your records.<br /><em>Right here.</em></h1>
      <p>
        A free player for the music on your own server. Stream it at home or
        download albums for when you are offline.
      </p>
    </header>

    <section
      class="carousel"
      role="img"
      aria-label="A row of colourful album covers receding into space around the Mozz now-playing screen"
    >
      <div class="floor" aria-hidden="true"></div>
      <div class="rail" aria-hidden="true">
        <div class="album album-a">
          <div class="cover cover-a">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <path d="M-8 20C18 2 32 44 54 25S88 5 112 29" />
              <path d="M-8 43C18 25 32 67 54 48S88 28 112 52" />
              <path d="M-8 66C18 48 32 90 54 71S88 51 112 75" />
            </svg>
            <span class="catalogue">MZ 014</span>
          </div>
        </div>

        <div class="album album-b">
          <div class="cover cover-b">
            <span class="sun"></span>
            <span class="arch arch-1"></span>
            <span class="arch arch-2"></span>
            <span class="catalogue">MZ 027</span>
          </div>
        </div>

        <div class="album album-c">
          <div class="cover cover-c">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <rect x="9" y="9" width="34" height="34" rx="17" />
              <rect x="57" y="9" width="34" height="34" rx="17" />
              <rect x="9" y="57" width="34" height="34" rx="17" />
              <rect x="57" y="57" width="34" height="34" rx="17" />
              <circle cx="50" cy="50" r="9" />
            </svg>
            <span class="catalogue">MZ 039</span>
          </div>
        </div>

        <div class="album album-featured">
          <div class="cover cover-featured">
            <span class="orbit orbit-1"></span>
            <span class="orbit orbit-2"></span>
            <span class="orbit orbit-3"></span>
            <span class="core"></span>
            <span class="catalogue">MZ 052</span>
          </div>
          <div class="player">
            <div class="playing">
              <span class="mini-mark"><Mark size={20} decorative /></span>
              <span><b>NOW PLAYING</b><strong>From your library</strong></span>
              <span class="air">LOSSLESS</span>
            </div>
            <div class="scrub"><span></span></div>
            <div class="transport" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 6h2v12H7zm3 6 8-6v12z" /></svg>
              <span class="play">
                <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5z" /></svg>
              </span>
              <svg viewBox="0 0 24 24"><path d="M15 6h2v12h-2zm-9 0 8 6-8 6z" /></svg>
            </div>
          </div>
        </div>

        <div class="album album-d">
          <div class="cover cover-d">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <path d="M-6 91 31 8l18 83L67 23l39 68" />
              <path d="m-4 67 32-38 21 45 22-55 34 49" />
            </svg>
            <span class="catalogue">MZ 063</span>
          </div>
        </div>

        <div class="album album-e">
          <div class="cover cover-e">
            <span class="moon"></span>
            <span class="horizon"></span>
            <span class="catalogue">MZ 078</span>
          </div>
        </div>

        <div class="album album-f">
          <div class="cover cover-f">
            <span class="stripe stripe-1"></span>
            <span class="stripe stripe-2"></span>
            <span class="stripe stripe-3"></span>
            <span class="catalogue">MZ 091</span>
          </div>
        </div>
      </div>
    </section>

    <footer class="details">
      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View source <span aria-hidden="true">↗</span></a>
      </div>

      <div class="works">
        <span>Works with</span>
        <span class="server"><ServerLogo name="Plex" size={18} />Plex</span>
        <span class="server"><ServerLogo name="Jellyfin" size={18} />Jellyfin</span>
        <span class="server"><ServerLogo name="Navidrome" size={18} />Navidrome</span>
        <span class="server text-server">+ Subsonic</span>
      </div>

      <p class="promise">No account · No tracking · Free forever</p>
    </footer>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #1b1a2e;
  }

  .flow {
    --ink: #fffaf4;
    --muted: #aaa9c6;
    --indigo: #1b1a2e;
    --orange: #ff8a3d;
    --peri: #c3d9ff;
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(280px, 1fr) auto;
    min-height: 100svh;
    padding: 68px clamp(22px, 4vw, 64px) 25px;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(circle at 50% 54%, rgba(92, 86, 154, 0.29), transparent 31%),
      linear-gradient(180deg, #1b1a2e 0%, #161527 62%, #10101d 100%);
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .flow::before {
    position: absolute;
    inset: 42px 0 auto;
    height: 1px;
    content: '';
    background: linear-gradient(90deg, transparent, rgba(195, 217, 255, 0.22), transparent);
  }

  .glow {
    position: absolute;
    top: 42%;
    left: 50%;
    width: min(900px, 86%);
    aspect-ratio: 2.3;
    border-radius: 50%;
    background: rgba(149, 139, 255, 0.09);
    filter: blur(50px);
    transform: translate(-50%, -50%);
  }

  .intro {
    position: relative;
    z-index: 10;
    width: min(900px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark i {
    margin-left: 5px;
    padding-left: 14px;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--muted);
    font-size: 10px;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: 'Archivo Black', Impact, ui-sans-serif, sans-serif;
    font-size: clamp(2.75rem, 5.1vw, 5.35rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  h1 em {
    color: var(--orange);
    font-style: normal;
  }

  .intro > p {
    width: min(630px, 92%);
    margin: 15px auto 0;
    color: #c7c5dc;
    font-size: clamp(0.88rem, 1.2vw, 1rem);
    line-height: 1.5;
  }

  .carousel {
    position: relative;
    z-index: 2;
    min-height: 300px;
    perspective: 1100px;
    perspective-origin: 50% 43%;
    isolation: isolate;
  }

  .rail {
    position: absolute;
    top: 47%;
    left: 50%;
    width: 100%;
    height: 300px;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
    animation: breathe 9s ease-in-out infinite alternate;
  }

  .floor {
    position: absolute;
    top: 65%;
    left: 50%;
    width: min(1100px, 95%);
    height: 180px;
    border-radius: 50%;
    background:
      radial-gradient(ellipse, rgba(255, 138, 61, 0.11) 0%, rgba(102, 94, 170, 0.1) 32%, transparent 68%);
    transform: translateX(-50%) rotateX(76deg);
    transform-origin: center top;
    filter: blur(3px);
  }

  .album {
    --size: clamp(160px, 18vw, 255px);
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--size);
    transform-style: preserve-3d;
    transition: transform 500ms ease;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #222;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 5px;
    box-shadow:
      0 24px 44px rgba(2, 2, 14, 0.44),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    backface-visibility: hidden;
  }

  .cover::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.22), transparent 18%, transparent 74%, rgba(0, 0, 0, 0.24));
    mix-blend-mode: soft-light;
  }

  .catalogue {
    position: absolute;
    right: 10px;
    bottom: 9px;
    z-index: 2;
    color: rgba(255, 255, 255, 0.76);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .album-a {
    z-index: 1;
    transform: translate(-50%, -50%) translateX(-590px) translateZ(-240px) rotateY(68deg);
  }

  .album-b {
    z-index: 2;
    transform: translate(-50%, -50%) translateX(-410px) translateZ(-130px) rotateY(54deg);
  }

  .album-c {
    z-index: 3;
    transform: translate(-50%, -50%) translateX(-238px) translateZ(-45px) rotateY(31deg);
  }

  .album-featured {
    --size: clamp(200px, 20vw, 285px);
    z-index: 10;
    transform: translate(-50%, -53%) translateZ(105px);
  }

  .album-d {
    z-index: 3;
    transform: translate(-50%, -50%) translateX(238px) translateZ(-45px) rotateY(-31deg);
  }

  .album-e {
    z-index: 2;
    transform: translate(-50%, -50%) translateX(410px) translateZ(-130px) rotateY(-54deg);
  }

  .album-f {
    z-index: 1;
    transform: translate(-50%, -50%) translateX(590px) translateZ(-240px) rotateY(-68deg);
  }

  .cover-a {
    background: linear-gradient(145deg, #5536a8, #1d153e 64%, #ec6b91);
  }

  .cover-a svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #c3d9ff;
    stroke-width: 5;
  }

  .cover-b {
    background: linear-gradient(180deg, #ffcb78 0 44%, #e55f3f 44% 100%);
  }

  .sun {
    position: absolute;
    top: 15%;
    left: 50%;
    width: 35%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff1c4;
    transform: translateX(-50%);
  }

  .arch {
    position: absolute;
    left: 50%;
    border: 13px solid #562654;
    border-bottom: 0;
    border-radius: 90px 90px 0 0;
    transform: translateX(-50%);
  }

  .arch-1 {
    bottom: 0;
    width: 70%;
    height: 46%;
  }

  .arch-2 {
    bottom: 0;
    width: 38%;
    height: 25%;
    border-color: #ffcf77;
  }

  .cover-c {
    background: #c3d9ff;
  }

  .cover-c svg {
    width: 100%;
    height: 100%;
    fill: #2c2a62;
  }

  .cover-c svg circle {
    fill: #ff6d45;
  }

  .cover-featured {
    background:
      radial-gradient(circle at 50% 50%, #ffcf8d 0 9%, transparent 9.5%),
      radial-gradient(circle at 50% 50%, transparent 0 28%, #fa7446 28.5% 31%, transparent 31.5%),
      linear-gradient(145deg, #2b2764 0%, #6960c4 52%, #20204d 100%);
    box-shadow:
      0 30px 60px rgba(4, 3, 19, 0.6),
      0 0 55px rgba(195, 217, 255, 0.13);
  }

  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 3px solid rgba(195, 217, 255, 0.77);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-24deg);
  }

  .orbit-1 {
    width: 116%;
    height: 30%;
  }

  .orbit-2 {
    width: 78%;
    height: 20%;
    transform: translate(-50%, -50%) rotate(38deg);
  }

  .orbit-3 {
    width: 48%;
    height: 48%;
    border-color: rgba(255, 138, 61, 0.88);
  }

  .core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff5dc;
    box-shadow: 0 0 26px rgba(255, 226, 163, 0.8);
    transform: translate(-50%, -50%);
  }

  .cover-d {
    background: linear-gradient(155deg, #bf305f, #ff7d65);
  }

  .cover-d svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #ffd7aa;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .cover-e {
    background: linear-gradient(180deg, #152f4b 0 58%, #2c8e84 58% 100%);
  }

  .moon {
    position: absolute;
    top: 17%;
    left: 19%;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #e7efff;
    box-shadow: 0 0 28px rgba(195, 217, 255, 0.45);
  }

  .horizon {
    position: absolute;
    inset: 58% 0 auto;
    height: 5px;
    background: #ff9c54;
    box-shadow: 0 12px 0 rgba(255, 156, 84, 0.45), 0 24px 0 rgba(255, 156, 84, 0.2);
  }

  .cover-f {
    background: #c80028;
  }

  .stripe {
    position: absolute;
    top: -20%;
    width: 17%;
    height: 140%;
    background: #211d39;
    transform: rotate(27deg);
  }

  .stripe-1 { left: 12%; }
  .stripe-2 { left: 43%; background: #ffb26f; }
  .stripe-3 { left: 74%; background: #c3d9ff; }

  .player {
    position: relative;
    width: 112%;
    margin: -1px -6% 0;
    padding: 12px 15px 11px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0 0 17px 17px;
    background: rgba(15, 14, 30, 0.88);
    box-shadow: 0 20px 42px rgba(2, 2, 14, 0.46);
    backdrop-filter: blur(18px);
  }

  .playing {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mini-mark {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 7px;
    background: #f0eaff;
  }

  .playing > span:nth-child(2) {
    display: grid;
    gap: 2px;
  }

  .playing b {
    color: #8e8aa9;
    font-size: 7px;
    letter-spacing: 0.16em;
  }

  .playing strong {
    font-size: 11px;
    font-weight: 600;
  }

  .air {
    margin-left: auto;
    color: var(--peri);
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .scrub {
    height: 2px;
    margin: 10px 0 7px;
    background: rgba(255, 255, 255, 0.18);
  }

  .scrub span {
    display: block;
    width: 42%;
    height: 100%;
    background: var(--orange);
    box-shadow: 0 0 8px rgba(255, 138, 61, 0.55);
  }

  .transport {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 21px;
  }

  .transport svg {
    width: 14px;
    height: 14px;
    fill: #eeeafa;
  }

  .play {
    display: grid;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    place-items: center;
    background: var(--ink);
  }

  .play svg {
    fill: #1b1a2e;
  }

  .details {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 28px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .store,
  .source {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 41px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .store {
    padding: 0 18px;
    color: #1b1a2e;
    background: var(--ink);
  }

  .store.is-pending {
    color: #b7b5cc;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.13);
  }

  .source {
    padding: 0 15px;
    color: var(--ink);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .source span {
    margin-left: 7px;
    color: var(--orange);
  }

  .works {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: #c1bfd4;
    font-size: 10px;
  }

  .works > span:first-child {
    color: #77748f;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .server {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .text-server {
    opacity: 0.72;
  }

  .promise {
    margin: 0;
    color: #8f8ca6;
    font-size: 10px;
    white-space: nowrap;
  }

  a:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 4px;
  }

  @keyframes breathe {
    from { transform: translate(-50%, -50%) rotateY(-1.2deg); }
    to { transform: translate(-50%, -50%) rotateY(1.2deg); }
  }

  @media (max-width: 820px) {
    .flow {
      grid-template-rows: auto minmax(265px, 1fr) auto;
      padding: 61px 18px 18px;
    }

    .wordmark {
      margin-bottom: 10px;
    }

    h1 {
      font-size: clamp(2.5rem, 12vw, 4rem);
      line-height: 0.9;
    }

    .intro > p {
      max-width: 420px;
      margin-top: 11px;
      font-size: 0.82rem;
      line-height: 1.42;
    }

    .carousel {
      min-height: 270px;
      perspective: 720px;
    }

    .rail {
      top: 48%;
      height: 225px;
    }

    .album {
      --size: 132px;
    }

    .album-featured {
      --size: 180px;
      transform: translate(-50%, -54%) translateZ(70px);
    }

    .album-a {
      transform: translate(-50%, -50%) translateX(-285px) translateZ(-150px) rotateY(70deg);
    }

    .album-b {
      transform: translate(-50%, -50%) translateX(-205px) translateZ(-95px) rotateY(57deg);
    }

    .album-c {
      transform: translate(-50%, -50%) translateX(-121px) translateZ(-35px) rotateY(34deg);
    }

    .album-d {
      transform: translate(-50%, -50%) translateX(121px) translateZ(-35px) rotateY(-34deg);
    }

    .album-e {
      transform: translate(-50%, -50%) translateX(205px) translateZ(-95px) rotateY(-57deg);
    }

    .album-f {
      transform: translate(-50%, -50%) translateX(285px) translateZ(-150px) rotateY(-70deg);
    }

    .player {
      padding: 9px 11px 8px;
      border-radius: 0 0 13px 13px;
    }

    .mini-mark {
      width: 24px;
      height: 24px;
    }

    .scrub {
      margin: 7px 0 5px;
    }

    .transport {
      gap: 17px;
    }

    .play {
      width: 23px;
      height: 23px;
    }

    .details {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 10px;
    }

    .actions {
      order: 1;
    }

    .works {
      order: 2;
      gap: 9px;
    }

    .promise {
      order: 3;
    }

    .works .server {
      font-size: 0;
    }

    .works .text-server {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .wordmark i {
      display: none;
    }

    .floor {
      top: 70%;
      width: 130%;
    }

    .store,
    .source {
      min-height: 38px;
      font-size: 11px;
    }
  }

  @media (max-height: 760px) {
    .flow {
      grid-template-rows: auto minmax(235px, 1fr) auto;
      padding-top: 58px;
    }

    h1 {
      font-size: clamp(2.25rem, 8vh, 4.3rem);
    }

    .intro > p {
      margin-top: 8px;
    }

    .album {
      --size: 140px;
    }

    .album-featured {
      --size: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail {
      animation: none;
    }

    .album {
      transition: none;
    }
  }
</style>
