---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { NAME, GITHUB_URL, APP_STORE_URL } from '../../data/site';

const albums = [
  { title: 'Low Sun', artist: 'Glass Arcade', art: 'sun' },
  { title: 'Soft Static', artist: 'North Window', art: 'static' },
  { title: 'Night Geometry', artist: 'Kindred Lines', art: 'geometry' },
  { title: 'Open Water', artist: 'June Current', art: 'water' },
  { title: 'Red Thread', artist: 'Paper Cinema', art: 'thread' },
  { title: 'Borrowed Light', artist: 'Field Assembly', art: 'light' },
  { title: 'Afterimage', artist: 'Quiet Motor', art: 'after' },
  { title: 'Blue Hours', artist: 'Common Weather', art: 'hours' },
];
---

<Layout
  title={`${NAME} — your music on iPhone and iPad`}
  description="Mozz is a free, open source player for music on your own Plex, Jellyfin, Navidrome or Subsonic server, built for iPhone and iPad."
  themeColor="#f3efe6"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="pair" />

  <main class="pair-page">
    <header class="intro">
      <div class="lockup">
        <Mark size={25} decorative />
        <span>{NAME}</span>
      </div>

      <h1>Your music, made for both screens.</h1>
      <p class="lede">
        Mozz is a free player for music on your own server. Stream your library
        on iPhone and iPad, or download albums for offline listening.
      </p>

      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>Download on the App Store</a>
        ) : (
          <span class="store is-pending" aria-disabled="true">Coming to the App Store</span>
        )}
        <a class="source" href={GITHUB_URL}>View on GitHub</a>
      </div>

      <div class="works" aria-label="Works with Plex, Jellyfin, Navidrome and Subsonic">
        <span class="works-label">Works with</span>
        <span class="server"><ServerLogo name="Plex" size={17} brand /><span>Plex</span></span>
        <span class="server"><ServerLogo name="Jellyfin" size={17} brand /><span>Jellyfin</span></span>
        <span class="server"><ServerLogo name="Navidrome" size={17} brand /><span>Navidrome</span></span>
        <span class="server text-only">Subsonic</span>
      </div>
    </header>

    <figure
      class="device-stage"
      role="img"
      aria-label="An iPad showing a wide Mozz album library beside an iPhone playing Low Sun by Glass Arcade"
    >
      <div class="sun-disc" aria-hidden="true"></div>
      <div class="floor" aria-hidden="true"></div>

      <div class="tablet" aria-hidden="true">
        <div class="tablet-camera"></div>
        <div class="tablet-screen">
          <aside class="app-sidebar">
            <div class="app-brand">
              <Mark size={20} decorative />
              <span>Mozz</span>
            </div>
            <nav class="app-nav">
              <span class="selected">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M3 4.5h5l1.4 1.7H17v9.3H3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
                Library
              </span>
              <span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7" />
                  <path d="m8 7 5 3-5 3z" fill="currentColor" />
                </svg>
                Radio
              </span>
              <span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 3v9m0 0L6.5 8.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Downloads
              </span>
              <span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 5h12M4 10h12M4 15h8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
                Playlists
              </span>
            </nav>
            <div class="weekly">
              <span class="weekly-art">W</span>
              <span><b>Mozz Weekly</b><small>Updated today</small></span>
            </div>
            <div class="connected"><i></i>Your server is online</div>
          </aside>

          <section class="library">
            <div class="library-top">
              <div>
                <span class="overline">Your collection</span>
                <h2>Albums</h2>
              </div>
              <div class="library-tools">
                <span class="search">
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="8.5" cy="8.5" r="4.8" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <path d="m12 12 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                  Search
                </span>
                <span class="avatar">BM</span>
              </div>
            </div>

            <div class="album-grid">
              {albums.map((album) => (
                <div class:list={['album', { active: album.art === 'sun' }]}>
                  <div class:list={['cover', album.art]}>
                    {album.art === 'sun' && <span class="cover-word">LOW<br />SUN</span>}
                    {album.art === 'static' && <span class="bars"></span>}
                    {album.art === 'geometry' && <span class="diamond"></span>}
                    {album.art === 'water' && <span class="horizon"></span>}
                    {album.art === 'thread' && <span class="loop"></span>}
                    {album.art === 'light' && <span class="beam"></span>}
                    {album.art === 'after' && <span class="echo">A</span>}
                    {album.art === 'hours' && <span class="moon"></span>}
                    {album.art === 'sun' && <span class="playing-dot">▶</span>}
                  </div>
                  <strong>{album.title}</strong>
                  <small>{album.artist}</small>
                </div>
              ))}
            </div>

            <div class="mini-player">
              <div class="mini-cover sun"><span class="mini-word">LS</span></div>
              <span class="mini-title"><b>Low Sun</b><small>Glass Arcade</small></span>
              <span class="mini-source">Playing from your server</span>
              <span class="mini-controls">‹ &nbsp; ▶ &nbsp; ›</span>
            </div>
          </section>
        </div>
      </div>

      <div class="phone" aria-hidden="true">
        <div class="phone-screen">
          <div class="island"></div>
          <div class="phone-top">
            <span>‹</span>
            <span>NOW PLAYING</span>
            <span>•••</span>
          </div>
          <div class="playing-art sun">
            <span class="playing-sun"></span>
            <span class="playing-lines"></span>
            <span class="playing-word">LOW<br />SUN</span>
          </div>
          <div class="track-meta">
            <div><strong>Low Sun</strong><small>Glass Arcade</small></div>
            <span class="heart">♡</span>
          </div>
          <div class="progress"><i></i></div>
          <div class="times"><span>1:42</span><span>−2:16</span></div>
          <div class="transport">
            <span>
              <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M7 7v14M21 7 10 14l11 7z" fill="currentColor" /></svg>
            </span>
            <span class="play">
              <svg viewBox="0 0 38 38" aria-hidden="true"><path d="m14 10 15 9-15 9z" fill="currentColor" /></svg>
            </span>
            <span>
              <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M21 7v14M7 7l11 7-11 7z" fill="currentColor" /></svg>
            </span>
          </div>
          <div class="volume">
            <span>◖</span><i></i><span>◗</span>
          </div>
          <div class="phone-actions"><span>⌁</span><span>☷</span></div>
          <div class="home-indicator"></div>
        </div>
      </div>
    </figure>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f3efe6;
  }

  :global(body) {
    overflow-x: hidden;
    color: #142932;
    background: #f3efe6;
    font-family: 'IBM Plex Sans', ui-sans-serif, sans-serif;
  }

  .pair-page {
    --paper: #f3efe6;
    --ink: #142932;
    --slate: #2f4858;
    --red: #c80028;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100svh;
    max-height: 100svh;
    padding-top: 58px;
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 14%, rgba(255, 255, 255, 0.8) 0 7%, transparent 23%),
      linear-gradient(115deg, #f8f4eb 0%, var(--paper) 58%, #ebe3d5 100%);
  }

  .pair-page::before {
    position: absolute;
    inset: 42px 0 auto;
    height: 6px;
    content: '';
    background: linear-gradient(90deg, var(--red) 0 16%, #ed9a33 16% 29%, #1f9ca3 29% 45%, var(--slate) 45% 100%);
  }

  .intro {
    position: relative;
    z-index: 5;
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    width: min(1040px, calc(100% - 40px));
    margin: 0 auto;
    text-align: center;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--red);
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  h1 {
    max-width: 980px;
    margin-top: 0.25rem;
    color: var(--ink);
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: clamp(2.65rem, 4.6vw, 4.8rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 720px;
    margin-top: 0.65rem;
    color: #40545d;
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    line-height: 1.48;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .store,
  .source {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.05rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
  }

  .store {
    color: #fff;
    background: var(--red);
    box-shadow: 0 7px 18px rgba(200, 0, 40, 0.16);
  }

  .store.is-pending {
    cursor: default;
  }

  .source {
    color: var(--ink);
    border: 1.5px solid rgba(20, 41, 50, 0.45);
    background: rgba(255, 255, 255, 0.45);
  }

  .source:hover {
    background: #fff;
  }

  .source:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  .works {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 0.72rem;
    color: #66747a;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.65rem;
  }

  .works-label {
    color: #859096;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .server {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .server.text-only {
    padding-left: 0.1rem;
  }

  .device-stage {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 430px;
    margin: 0;
    overflow: visible;
    pointer-events: none;
  }

  .sun-disc {
    position: absolute;
    left: calc(50% + 275px);
    bottom: 360px;
    width: 220px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ef9b30;
    box-shadow: 0 0 0 18px rgba(239, 155, 48, 0.13);
  }

  .floor {
    position: absolute;
    inset: auto 0 0;
    height: 155px;
    background: var(--slate);
  }

  .floor::before {
    position: absolute;
    top: -13px;
    left: 0;
    width: 38%;
    height: 13px;
    content: '';
    background: var(--red);
  }

  .tablet {
    position: absolute;
    bottom: -35px;
    left: 50%;
    width: min(860px, 72vw);
    aspect-ratio: 1.49;
    padding: 11px;
    border: 2px solid #14242d;
    border-radius: 35px;
    background: #263b47;
    box-shadow:
      0 30px 50px rgba(22, 36, 43, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    transform: translateX(-57%) rotate(-1.2deg);
    transform-origin: 50% 100%;
    animation: tablet-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .tablet-camera {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 4px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #090e11;
    box-shadow: 0 0 0 1px #4a606b;
  }

  .tablet-screen {
    display: grid;
    grid-template-columns: 22% 78%;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 25px;
    background: #f9f6f0;
  }

  .app-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 5.2% 8% 4%;
    color: #dfe8e7;
    background:
      radial-gradient(circle at 15% 92%, rgba(200, 0, 40, 0.65), transparent 33%),
      linear-gradient(160deg, #2f4858, #1b303b 68%);
  }

  .app-brand {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #fff;
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: clamp(0.72rem, 1.2vw, 1rem);
    font-weight: 750;
  }

  .app-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 13%;
  }

  .app-nav > span {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.55rem 0.6rem;
    border-radius: 9px;
    color: #adbdc4;
    font-size: clamp(0.45rem, 0.72vw, 0.7rem);
    font-weight: 500;
  }

  .app-nav svg {
    width: 15px;
    flex: none;
  }

  .app-nav .selected {
    color: #fff;
    background: rgba(255, 255, 255, 0.13);
  }

  .weekly {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: rgba(5, 17, 23, 0.2);
  }

  .weekly-art {
    display: grid;
    width: 29px;
    aspect-ratio: 1;
    flex: none;
    place-items: center;
    color: #fff;
    border-radius: 5px;
    background: linear-gradient(135deg, #f1ae32 0 44%, #c80028 44% 72%, #32a4a5 72%);
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-weight: 800;
  }

  .weekly span:last-child {
    display: grid;
    min-width: 0;
  }

  .weekly b {
    overflow: hidden;
    font-size: clamp(0.42rem, 0.65vw, 0.62rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .weekly small {
    margin-top: 0.1rem;
    color: #9dafb6;
    font-size: clamp(0.35rem, 0.5vw, 0.48rem);
  }

  .connected {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: 0.65rem;
    color: #92a6ad;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: clamp(0.35rem, 0.5vw, 0.48rem);
  }

  .connected i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #55d39c;
    box-shadow: 0 0 0 3px rgba(85, 211, 156, 0.12);
  }

  .library {
    position: relative;
    padding: 4.2% 4.5% 12%;
    overflow: hidden;
    color: var(--ink);
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.85), transparent 45%),
      #f3efe6;
  }

  .library-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .overline {
    color: var(--red);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: clamp(0.34rem, 0.5vw, 0.48rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .library h2 {
    margin-top: 0.08rem;
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: clamp(1.05rem, 2.2vw, 2rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .library-tools {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .search {
    display: flex;
    width: clamp(86px, 13vw, 145px);
    align-items: center;
    gap: 0.3rem;
    padding: 0.42rem 0.55rem;
    color: #849097;
    border: 1px solid #d9d7d0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.38rem, 0.6vw, 0.56rem);
  }

  .search svg {
    width: 12px;
  }

  .avatar {
    display: grid;
    width: 28px;
    aspect-ratio: 1;
    place-items: center;
    color: #fff;
    border-radius: 50%;
    background: var(--red);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: clamp(0.34rem, 0.5vw, 0.48rem);
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.35rem, 1vw, 0.8rem);
    margin-top: 3.3%;
  }

  .album {
    min-width: 0;
  }

  .album .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: clamp(5px, 0.7vw, 9px);
    box-shadow: 0 7px 14px rgba(24, 37, 43, 0.14);
  }

  .album strong,
  .album small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .album strong {
    margin-top: 0.38rem;
    font-size: clamp(0.42rem, 0.72vw, 0.67rem);
    font-weight: 600;
  }

  .album small {
    margin-top: 0.08rem;
    color: #6f7b80;
    font-size: clamp(0.34rem, 0.55vw, 0.5rem);
  }

  .cover.sun,
  .playing-art.sun,
  .mini-cover.sun {
    background:
      radial-gradient(circle at 70% 29%, #ffc94a 0 13%, transparent 13.5%),
      linear-gradient(160deg, transparent 0 55%, rgba(99, 0, 24, 0.45) 55.5% 57%, transparent 57.5%),
      linear-gradient(145deg, #f26a3d, #c80028 65%, #7d0020);
  }

  .cover-word {
    position: absolute;
    bottom: 9%;
    left: 8%;
    color: #fff5d9;
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: clamp(0.55rem, 1vw, 0.9rem);
    font-weight: 800;
    line-height: 0.75;
    letter-spacing: -0.08em;
  }

  .playing-dot {
    position: absolute;
    right: 7%;
    bottom: 7%;
    display: grid;
    width: 23px;
    aspect-ratio: 1;
    place-items: center;
    color: var(--red);
    border-radius: 50%;
    background: #fff;
    font-size: 0.45rem;
    box-shadow: 0 4px 10px rgba(87, 0, 21, 0.25);
  }

  .cover.static {
    background: linear-gradient(135deg, #171530, #5743d0);
  }

  .bars {
    position: absolute;
    inset: 17%;
    background: repeating-linear-gradient(90deg, #ffdd35 0 9%, transparent 9% 18%);
    transform: skewY(-11deg);
  }

  .cover.geometry {
    background: linear-gradient(145deg, #dff55f, #52b8a2);
  }

  .diamond {
    position: absolute;
    inset: 24%;
    border: 8px solid #402857;
    transform: rotate(45deg);
  }

  .cover.water {
    background: linear-gradient(#69c3dc 0 50%, #153f67 50%);
  }

  .horizon {
    position: absolute;
    inset: 36% -10% auto;
    height: 26%;
    border-radius: 50%;
    background: #ff7448;
  }

  .cover.thread {
    background: #f7c847;
  }

  .loop {
    position: absolute;
    inset: 18%;
    border: 9px solid #c80028;
    border-radius: 50% 20% 50% 25%;
    transform: rotate(22deg);
  }

  .cover.light {
    background: #141d3b;
  }

  .beam {
    position: absolute;
    top: -8%;
    left: 35%;
    width: 30%;
    height: 120%;
    background: linear-gradient(90deg, #ff6f91, #ffdb63);
    transform: rotate(27deg);
  }

  .cover.after {
    background:
      radial-gradient(circle at 70% 35%, #ff714d 0 9%, transparent 9.5%),
      linear-gradient(130deg, #273f88, #8f4eb5);
  }

  .echo {
    position: absolute;
    bottom: -18%;
    left: 5%;
    color: rgba(255, 255, 255, 0.78);
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-size: clamp(2.4rem, 6vw, 5.8rem);
    font-weight: 800;
  }

  .cover.hours {
    background: linear-gradient(155deg, #092c49, #0d6b7b);
  }

  .moon {
    position: absolute;
    top: 17%;
    right: 17%;
    width: 36%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #f6e7a5;
    box-shadow: -22px 32px 0 7px #ef6c51;
  }

  .mini-player {
    position: absolute;
    inset: auto 3.5% 2.8%;
    display: flex;
    align-items: center;
    gap: 0.52rem;
    padding: 0.52rem 0.65rem;
    border: 1px solid rgba(39, 61, 72, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 8px 22px rgba(29, 44, 52, 0.12);
    backdrop-filter: blur(14px);
  }

  .mini-cover {
    position: relative;
    width: 29px;
