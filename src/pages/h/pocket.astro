---
import Layout from '../../layouts/Layout.astro';
import HeroBar from '../../components/HeroBar.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import { APP_STORE_URL, GITHUB_URL, SERVERS } from '../../data/site';
import { HERO_COPY } from '../../data/hero-copy';
---

<Layout
  title="Pocket — a Mozz hero study"
  description="Your whole Plex, Jellyfin or Navidrome music library, ready to stream or download with Mozz."
  themeColor="#f5f0e7"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <HeroBar slug="pocket" />

  <main class="pocket-hero">
    <a class="wordmark" href="/" aria-label="Mozz home">
      <Mark size={34} decorative />
      <span>Mozz</span>
    </a>

    <section class="intro" aria-labelledby="pocket-title">
      <h1 id="pocket-title">{HERO_COPY.headline}</h1>
      <p class="body-copy">{HERO_COPY.body}</p>
      <p class="support">{HERO_COPY.support}</p>

      <div class="actions">
        {
          APP_STORE_URL ? (
            <a class="store-button" href={APP_STORE_URL} aria-label="Download Mozz on the App Store">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.1 12.7c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.1-2.8.9-3.5.9-.8 0-1.9-.9-3.1-.9a4.6 4.6 0 0 0-3.9 2.4c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 3 2.3 1.2 0 1.6-.7 3.1-.7 1.4 0 1.8.7 3.1.7 1.3 0 2.1-1.1 2.9-2.3.9-1.3 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-3.8ZM14.8 5.9c.6-.8 1-1.9.9-2.9-1 0-2.2.7-2.9 1.4-.6.7-1.1 1.8-1 2.8 1.1.1 2.3-.5 3-1.3Z" />
              </svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span
              class="store-button pending"
              aria-label="App Store download coming soon"
              aria-disabled="true"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.1 12.7c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.1-2.8.9-3.5.9-.8 0-1.9-.9-3.1-.9a4.6 4.6 0 0 0-3.9 2.4c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 3 2.3 1.2 0 1.6-.7 3.1-.7 1.4 0 1.8.7 3.1.7 1.3 0 2.1-1.1 2.9-2.3.9-1.3 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-3.8ZM14.8 5.9c.6-.8 1-1.9.9-2.9-1 0-2.2.7-2.9 1.4-.6.7-1.1 1.8-1 2.8 1.1.1 2.3-.5 3-1.3Z" />
              </svg>
              <span><small>Coming soon to the</small>App Store</span>
            </span>
          )
        }

        <a class="github-link" href={GITHUB_URL}>
          View on GitHub
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3h8v8M13 3 3 13" />
          </svg>
        </a>
      </div>
    </section>

    <figure
      class="pocket-scene"
      aria-label="Albums from Plex, Jellyfin and Navidrome descend from a shelf into a Mozz player tucked inside a pocket."
    >
      <div class="server-source">
        <span>WORKS WITH</span>
        <div class="server-marks">
          {SERVERS.map((server) => <ServerLogo name={server.name} size={24} />)}
        </div>
      </div>

      <svg class="artboard" viewBox="0 0 800 420" role="presentation" aria-hidden="true">
        <path class="shelf" d="M88 69H551" />
        <path class="route" d="M519 69c74 0 78 48 27 71l-82 37" />

        <g class="album album-a">
          <rect x="211" y="19" width="31" height="49" rx="2" />
          <path d="M217 51h18M217 57h13" />
        </g>
        <g class="album album-c">
          <rect x="251" y="15" width="34" height="53" rx="2" />
          <path d="m257 53 8-12 6 7 8-11" />
        </g>
        <g class="album album-e">
          <rect x="294" y="18" width="32" height="50" rx="2" />
          <circle cx="310" cy="42" r="10" />
        </g>
        <g class="album album-g">
          <rect x="335" y="21" width="32" height="47" rx="2" />
          <path d="M342 35h18M342 42h18M342 49h12" />
        </g>

        <g class="falling falling-one">
          <rect x="505" y="84" width="29" height="39" rx="2" transform="rotate(26 519.5 103.5)" />
          <path d="M515 98h11M512 105h14" transform="rotate(26 519.5 103.5)" />
        </g>
        <g class="falling falling-three">
          <rect x="451" y="149" width="38" height="49" rx="4" transform="rotate(58 470 173.5)" />
          <path d="m460 184 10-24 10 24" transform="rotate(58 470 173.5)" />
        </g>

        <path
          class="pocket-fill"
          d="M173 203c74 24 137 28 207 28s133-4 207-28l-30 169c-60 29-118 42-177 42s-117-13-177-42Z"
        />

        <g class="phone">
          <rect class="phone-body" x="305" y="123" width="150" height="254" rx="28" />
          <rect class="phone-screen" x="316" y="137" width="128" height="226" rx="19" />
          <path class="speaker" d="M360 146h40" />

          <rect class="now-cover" x="330" y="166" width="44" height="44" rx="8" />
          <circle class="record" cx="352" cy="188" r="13" />
          <circle class="record-hole" cx="352" cy="188" r="3" />
          <path class="track-line" d="M385 178h44M385 187h34" />
          <path class="play" d="m400 199 9 6-9 6Z" />

          <g class="phone-tab">
            <rect x="328" y="228" width="51" height="23" rx="11.5" />
            <text x="353.5" y="243" text-anchor="middle">Radio</text>
          </g>
          <g class="phone-tab">
            <rect x="383" y="228" width="53" height="23" rx="11.5" />
            <text x="409.5" y="243" text-anchor="middle">Weekly</text>
          </g>

          <g class="offline">
            <circle cx="338" cy="273" r="10" />
            <path d="m333 273 3.5 3.5 6.5-7" />
            <text x="354" y="277">Downloaded</text>
          </g>
        </g>

        <path class="pocket-edge" d="M173 203c74 24 137 28 207 28s133-4 207-28" />
        <path
          class="pocket-outline"
          d="m173 203 30 169c60 29 118 42 177 42s117-13 177-42l30-169"
        />
        <path class="stitch stitch-left" d="M191 226l25 134c52 24 106 35 164 35" />
        <path class="stitch stitch-right" d="M569 226l-25 134c-52 24-106 35-164 35" />
      </svg>
    </figure>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f5f0e7;
  }

  :global(body) {
    overflow: hidden;
    color: #183236;
    background: #f5f0e7;
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }

  :global(.hero-bar) {
    color: #183236;
    background: color-mix(in srgb, #f5f0e7 90%, transparent);
    border-bottom-color: rgba(24, 50, 54, 0.12);
  }

  .pocket-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    height: calc(100svh - 42px);
    margin-top: 42px;
    overflow: hidden;
    isolation: isolate;
  }

  .wordmark {
    position: absolute;
    top: clamp(1rem, 2.8vh, 1.65rem);
    left: clamp(1rem, 3.3vw, 3rem);
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    color: #183236;
    font-size: 1.24rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .wordmark::after {
    content: none;
  }

  .intro {
    z-index: 5;
    width: min(720px, calc(100% - 2rem));
    margin-inline: auto;
    padding-top: clamp(3.8rem, 8vh, 5.2rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(2.45rem, 5vw, 4.45rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .body-copy {
    max-width: 620px;
    margin: clamp(0.9rem, 2vh, 1.3rem) auto 0;
    color: #4f615f;
    font-size: clamp(0.94rem, 1.4vw, 1.08rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  .support {
    margin-top: 0.42rem;
    color: #73817e;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: clamp(0.68rem, 1vw, 0.76rem);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(1rem, 2.2vh, 1.45rem);
  }

  .store-button {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    min-height: 46px;
    padding: 0.42rem 1rem 0.48rem 0.82rem;
    color: #fdfbf6;
    background: #183236;
    border: 1px solid #183236;
    border-radius: 13px;
    font-size: 1.01rem;
    font-weight: 600;
    line-height: 1.04;
    text-align: left;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .store-button:not(.pending):hover {
    background: #c80028;
    border-color: #c80028;
    transform: translateY(-2px);
  }

  .store-button svg {
    width: 23px;
    height: 23px;
    fill: currentColor;
  }

  .store-button span {
    display: grid;
    gap: 0.08rem;
  }

  .store-button small {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .store-button.pending {
    color: #677573;
    background: transparent;
    border-color: #9aa5a0;
    cursor: not-allowed;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 44px;
    color: #183236;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #abb4ad;
    text-underline-offset: 4px;
  }

  .github-link:hover {
    color: #c80028;
    text-decoration-color: currentColor;
  }

  .github-link svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .pocket-scene {
    position: relative;
    align-self: end;
    justify-self: center;
    width: min(900px, 122vw);
    height: 100%;
    max-height: 405px;
    min-height: 205px;
    margin: 0;
  }

  .artboard {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .server-source {
    position: absolute;
    top: 5.5%;
    left: 9.5%;
    z-index: 4;
    display: grid;
    gap: 0.42rem;
    color: #183236;
  }

  .server-source > span {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: clamp(0.44rem, 0.8vw, 0.58rem);
    font-weight: 500;
    letter-spacing: 0.13em;
  }

  .server-marks {
    display: flex;
    align-items: center;
    gap: clamp(0.45rem, 1vw, 0.75rem);
  }

  .server-marks :global(.server-logo) {
    width: clamp(17px, 2.6vw, 24px);
    height: clamp(17px, 2.6vw, 24px);
  }

  .shelf,
  .route,
  .album rect,
  .album path,
  .album circle,
  .falling rect,
  .falling path,
  .falling circle,
  .phone-body,
  .phone-screen,
  .speaker,
  .track-line,
  .phone-tab rect,
  .offline circle,
  .offline path,
  .pocket-edge,
  .pocket-outline,
  .stitch {
    vector-effect: non-scaling-stroke;
  }

  .shelf {
    fill: none;
    stroke: #183236;
    stroke-linecap: round;
    stroke-width: 2.1;
  }

  .route {
    fill: none;
    stroke: #83948c;
    stroke-linecap: round;
    stroke-width: 1.35;
  }

  .album rect,
  .falling rect {
    fill: #f5f0e7;
    stroke: #183236;
    stroke-width: 1.6;
  }

  .album path,
  .album circle,
  .falling path,
  .falling circle {
    fill: none;
    stroke: #6f8f84;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
  }

  .album-e circle,
  .falling circle {
    fill: #d8aa58;
    stroke: #183236;
  }

  .album-c path,
  .falling-three path {
    stroke: #c80028;
  }

  .pocket-fill {
    fill: #e9c8b5;
  }

  .pocket-edge,
  .pocket-outline {
    fill: none;
    stroke: #183236;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.35;
  }

  .stitch {
    fill: none;
    stroke: #b9856d;
    stroke-dasharray: 3 8;
    stroke-linecap: round;
    stroke-width: 1.35;
  }

  .phone {
    filter: drop-shadow(0 12px 16px rgba(36, 53, 52, 0.12));
  }

  .phone-body {
    fill: #183236;
    stroke: #183236;
    stroke-width: 1.5;
  }

  .phone-screen {
    fill: #fffdf8;
    stroke: #183236;
    stroke-width: 1;
  }

  .speaker {
    fill: none;
    stroke: #72817e;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .now-cover {
    fill: #bfd2c7;
  }

  .record {
    fill: #c80028;
  }

  .record-hole {
    fill: #fffdf8;
  }

  .track-line {
    fill: none;
    stroke: #7c8c89;
    stroke-linecap: round;
    stroke-width: 2.2;
  }

  .play {
    fill: #183236;
  }

  .phone-tab rect {
    fill: #edf1eb;
    stroke: #c8d2cb;
    stroke-width: 0.8;
  }

  .phone-tab text,
  .offline text {
    fill: #183236;
    font-family: 'DM Sans', ui-sans-serif, sans-serif;
  }

  .phone-tab text {
    font-size: 8px;
    font-weight: 600;
  }

  .offline circle {
    fill: #6f8f84;
    stroke: #6f8f84;
    stroke-width: 1;
  }

  .offline path {
    fill: none;
    stroke: #fffdf8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .offline text {
    font-size: 9px;
    font-weight: 600;
  }

  @media (max-width: 620px) {
    .wordmark {
      top: 0.78rem;
      left: 1rem;
      gap: 0.48rem;
      font-size: 1.08rem;
    }

    .intro {
      width: min(calc(100% - 2.5rem), 460px);
      padding-top: 3.6rem;
    }

    h1 {
      max-width: 21rem;
      margin-inline: auto;
      font-size: clamp(2.15rem, 9vw, 3.1rem);
      line-height: 1.02;
      letter-spacing: -0.05em;
    }

    .body-copy {
      max-width: 370px;
      font-size: 0.9rem;
      line-height: 1.43;
    }

    .support {
      max-width: 350px;
      margin-inline: auto;
      font-size: 0.64rem;
    }

    .actions {
      gap: 0.75rem;
      margin-top: 0.95rem;
    }

    .store-button {
      min-height: 43px;
      padding: 0.38rem 0.76rem 0.43rem 0.68rem;
      border-radius: 11px;
      font-size: 0.88rem;
    }

    .store-button svg {
      width: 20px;
      height: 20px;
    }

    .store-button small {
      font-size: 0.49rem;
    }

    .github-link {
      font-size: 0.78rem;
    }

    .pocket-scene {
      width: 122vw;
      max-height: 355px;
      min-height: 190px;
    }
  }

  @media (max-height: 700px) {
    .intro {
      padding-top: 3.35rem;
    }

    h1 {
      font-size: clamp(2.3rem, 8vh, 3.7rem);
    }

    .body-copy {
      margin-top: 0.65rem;
      font-size: 0.88rem;
      line-height: 1.38;
    }

    .actions {
      margin-top: 0.7rem;
    }

    .pocket-scene {
      max-height: 315px;
    }
  }

  @media (max-height: 570px) {
    .intro {
      width: min(760px, calc(100% - 7rem));
      padding-top: 0.8rem;
    }

    .wordmark {
      top: 0.85rem;
    }

    h1 {
      font-size: clamp(2.1rem, 8vh, 3rem);
    }

    .body-copy {
      max-width: 680px;
      white-space: nowrap;
    }

    .actions {
      margin-top: 0.45rem;
    }

    .store-button {
      min-height: 40px;
    }

    .pocket-scene {
      max-height: 245px;
      min-height: 160px;
    }
  }

</style>
