---
/**
 * VARIANT — IMPRINT
 *
 * The next generation of the Cover hero study.
 *
 * Cover hid half the wordmark behind the thing that plays it. Imprint keeps the
 * idea — a solid object interrupting a wordmark set at poster scale — but stops
 * hiding anything. A column of red ink is laid across the page, and every mark
 * that falls inside it reverses: black letters on paper become cream letters on
 * red at a hard, unblurred edge. The phone stands inside the column, so the
 * middle of the word really is gone, and the two states of the same letterform
 * are the whole composition.
 *
 * Everything the page claims comes from src/data/site.ts. Only the hero
 * headline, the hero support line and the meta description live here.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'The music is already yours. This is the player.';
const SUPPORT =
  'Point Mozz at the server in your own house, press play, and nothing in the middle takes a cut.';

/** Invented sleeves. Nothing here names a real record or artist. */
const DRIFT = [
  { title: 'First Proof', artist: 'Halden Rill', art: 'slug' },
  { title: 'Register', artist: 'Paper Cinema', art: 'rule' },
  { title: 'Solid Set', artist: 'North Window', art: 'block' },
  { title: 'Reversed Out', artist: 'Quiet Motor', art: 'knock' },
  { title: 'Second Pass', artist: 'Field Assembly', art: 'stripe' },
  { title: 'Full Bleed', artist: 'June Current', art: 'slug' },
  { title: 'Trim Line', artist: 'Glass Arcade', art: 'block' },
  { title: 'Dry Ink', artist: 'Common Weather', art: 'rule' },
] as const;

const WALL = [
  'slug', 'rule', 'block', 'knock', 'stripe', 'slug', 'block', 'rule',
  'knock', 'stripe', 'block', 'slug', 'rule', 'knock', 'stripe', 'block',
  'rule', 'slug', 'stripe', 'knock', 'block', 'rule', 'slug', 'knock',
];
---

<Layout
  title={`${NAME} — the music is already yours, this is the player`}
  description="Mozz is a free, open source music player for iPhone and iPad. Connect Plex, Jellyfin or a Subsonic server such as Navidrome, stream at home, and download albums to play with no connection at all."
  themeColor="#f3ede2"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Azeret+Mono:wght@400;500&family=Familjen+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <VariantBar slug="imprint" tone="warm" />

  <main class="im">
    <!-- ================================================================ --
      -- HERO — one column of ink, and everything inside it reverses      --
      -- ================================================================ -->
    <section class="hero" aria-labelledby="im-h1">
      <div class="press" aria-hidden="true">
        <span class="slab"></span>

        <div class="word base"><span>MOZZ</span></div>
        <div class="word knock"><span>MOZZ</span></div>

        <span class="crop crop-tl"></span>
        <span class="crop crop-tr"></span>
        <span class="crop crop-bl"></span>
        <span class="crop crop-br"></span>
      </div>

      <header class="top">
        <a class="lockup" href="/" aria-label={`${NAME} home`}>
          <Mark size={26} decorative />
          <b>{NAME}</b>
          <i aria-hidden="true"></i>
          <span>self&#8209;hosted music player</span>
        </a>
        <span class="fine">free forever &middot; gpl&#8209;3.0 &middot; no account</span>
      </header>

      <div class="say">
        <p class="eyebrow">For iPhone and iPad</p>
        <h1 id="im-h1">{HEADLINE}</h1>
        <p class="support">{SUPPORT}</p>

        <p class="works">
          <span class="works-tag">plays from</span>
          {SERVERS.map((s) => (
            <span class="works-one"><ServerLogo name={s.name} size={15} />{s.name}</span>
          ))}
          <span class="works-one">Subsonic</span>
        </p>

        <div class="actions">
          {APP_STORE_URL ? (
            <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
          ) : (
            <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
          )}
          <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
        </div>
      </div>

      <div
        class="phone hero-phone"
        role="img"
        aria-label="An iPhone running Mozz, playing a downloaded album from a home server."
      >
        <div class="screen">
          <span class="island" aria-hidden="true"></span>

          <div class="status" aria-hidden="true">
            <span>9:41</span>
            <span class="glyphs">
              <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              <svg viewBox="0 0 26 12">
                <rect x="1" y="1" width="20" height="10" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                <rect x="3" y="3" width="14" height="6" rx="1.4"></rect>
                <path d="M23 4.3v3.4a1.9 1.9 0 0 0 0-3.4z"></path>
              </svg>
            </span>
          </div>

          <div class="scr-head" aria-hidden="true">
            <svg class="chev" viewBox="0 0 16 16"
              ><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
            <span>playing from your server</span>
            <span class="eq"><i></i><i></i><i></i></span>
          </div>

          <div class="art" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <rect width="120" height="120" fill="#121011"></rect>
              <rect x="0" y="0" width="120" height="52" fill="#c80028"></rect>
              <rect x="14" y="26" width="92" height="52" fill="#f3ede2"></rect>
              <rect x="14" y="26" width="92" height="8" fill="#121011"></rect>
              <circle cx="60" cy="58" r="15" fill="#c80028"></circle>
              <rect x="14" y="90" width="60" height="4" fill="#f3ede2" opacity="0.75"></rect>
              <rect x="14" y="99" width="34" height="4" fill="#f3ede2" opacity="0.4"></rect>
            </svg>
          </div>

          <div class="meta">
            <strong>First Proof</strong>
            <span>Halden Rill &middot; Paper Weather</span>
          </div>

          <div class="bar" aria-hidden="true"><i></i></div>
          <div class="times" aria-hidden="true"><span>1:47</span><span>&minus;2:25</span></div>

          <div class="ctrl" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M17.4 3.4v13.2L7.6 10z"></path><rect x="2.6" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
            <span class="play"><svg viewBox="0 0 20 20"><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.3"></rect><rect x="11.1" y="4.4" width="3.3" height="11.2" rx="1.3"></rect></svg></span>
            <svg viewBox="0 0 20 20"><path d="M2.6 3.4v13.2L12.4 10z"></path><rect x="14.8" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
          </div>

          <div class="pill" aria-hidden="true">
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#f3ede2" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>downloaded &middot; plays offline</span>
          </div>

          <span class="home" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- SERVERS — three impressions of the same plate                    --
      -- ================================================================ -->
    <section class="band servers" aria-labelledby="im-servers">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Sources</p>
            <h2 id="im-servers">Three servers take the same impression.</h2>
          </div>
          <p class="lede">
            Mozz signs in to the one you already run and mirrors its catalog into a database
            on the device, so the library is there whether or not the server answers.
          </p>
        </div>

        <ol class="plates" role="list">
          {SERVERS.map((s, i) => (
            <li>
              <span class="plate-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="plate-logo"><ServerLogo name={s.name} size={34} /></span>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </li>
          ))}
          <li class="plate-extra">
            <span class="plate-no">&mdash;</span>
            <h3>Any other OpenSubsonic server</h3>
            <p>
              Navidrome is the tested OpenSubsonic target. Other compatible servers are
              best&#8209;effort, and the source is there if yours needs a look.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- SPLIT PAYOFF — the sheet, half inked and half not. The split is  --
      -- against the press, never against a player.                       --
      -- ================================================================ -->
    <section class="band split" aria-labelledby="im-split">
      <div class="split-grid">
        <div class="half inked">
          <p class="kicker"><span class="tick"></span>Inked</p>
          <h2 id="im-split">Offline</h2>
          <p>
            Downloads are part of the design, not bolted on afterwards. A record on the
            device behaves exactly the way it does at home, with nothing to reconnect to.
          </p>
          <ol class="marks" role="list">
            <li><b>01</b> Browsing and search answer with the server unreachable</li>
            <li><b>02</b> Mozz Weekly is built on the device, so it travels</li>
            <li><b>03</b> No degraded mode and no reconnect prompt</li>
          </ol>
        </div>

        <div class="seam" aria-hidden="true"></div>

        <div class="half plain">
          <p class="kicker"><span class="tick"></span>Plain paper</p>
          <h2>Streaming</h2>
          <p>
            At home, Mozz reads from the Plex, Jellyfin or OpenSubsonic server on your own
            network — your own files, over a wire nobody else owns.
          </p>
          <ol class="marks" role="list">
            <li><b>01</b> The whole catalog indexed on the device</li>
            <li><b>02</b> Gapless queue, so an album runs as one piece</li>
            <li><b>03</b> Seventy-five milliseconds from tap to first note</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- MARQUEE PAYOFF — a drifting strip that passes through the ink    --
      -- band and reverses as it crosses. Featured, not hero.             --
      -- ================================================================ -->
    <section class="band feature" aria-labelledby="im-feature">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Featured</p>
            <h2 id="im-feature">A new mix every week, pressed from your own library.</h2>
          </div>
          <p class="lede">
            Mozz Weekly builds a fresh set out of music you already have. It runs on the
            device and stays available offline, so discovery never needs a subscription.
          </p>
        </div>
      </div>

      <div class="drift" aria-hidden="true">
        <span class="drift-band"></span>

        <div class="drift-layer">
          <div class="drift-track">
            {[0, 1].map(() => (
              <>
                {DRIFT.map((d) => (
                  <figure class="sleeve">
                    <span class={`sleeve-art art-${d.art}`}></span>
                    <figcaption><b>{d.title}</b><span>{d.artist}</span></figcaption>
                  </figure>
                ))}
              </>
            ))}
          </div>
        </div>

        <!-- the same strip again, reversed, showing only inside the ink -->
        <div class="drift-layer is-knocked">
          <div class="drift-track">
            {[0, 1].map(() => (
              <>
                {DRIFT.map((d) => (
                  <figure class="sleeve">
                    <span class={`sleeve-art art-${d.art}`}></span>
                    <figcaption><b>{d.title}</b><span>{d.artist}</span></figcaption>
                  </figure>
                ))}
              </>
            ))}
          </div>
        </div>
      </div>

      <div class="shell">
        <p class="drift-note">
          Radio, shuffle and mixes can be sharpened by MusicBrainz and ListenBrainz when
          enrichment is enabled. Switch it off and local, genre&#8209;based recommendations
          still work.
        </p>
      </div>
    </section>

    <!-- ================================================================ --
      -- PAIR PAYOFF — iPhone and iPad, settling into register on scroll  --
      -- ================================================================ -->
    <section class="band pair" aria-labelledby="im-pair">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Carried over</p>
            <h2 id="im-pair">Lift it from one, it prints on the other.</h2>
          </div>
          <p class="lede">{CONTINUITY.body}</p>
        </div>
      </div>

      <div class="rig" role="img" aria-label="An iPad and an iPhone side by side, both running Mozz.">
        <div class="tablet">
          <div class="tab-screen">
            <div class="tab-side" aria-hidden="true">
              <span class="tab-lock"><Mark size={16} decorative /><b>Mozz</b></span>
              <span class="tab-nav is-on">Library</span>
              <span class="tab-nav">Albums</span>
              <span class="tab-nav">Artists</span>
              <span class="tab-nav">Downloads</span>
              <span class="tab-nav">Mozz Weekly</span>
              <span class="tab-nav">Radio</span>
            </div>
            <div class="tab-main" aria-hidden="true">
              <span class="tab-title">Albums</span>
              <div class="tab-grid">
                {['slug', 'rule', 'block', 'knock', 'stripe', 'slug', 'block', 'rule', 'knock', 'stripe', 'block', 'slug', 'rule', 'knock', 'stripe', 'block', 'slug', 'rule', 'stripe', 'knock', 'slug', 'block', 'rule', 'stripe'].map((k) => (
                  <span class={`tile art-${k}`}></span>
                ))}
              </div>
              <div class="tab-now">
                <span class="tab-now-art art-knock"></span>
                <span class="tab-now-txt"><b>First Proof</b><span>Halden Rill</span></span>
                <span class="tab-now-bar"><i></i></span>
                <span class="tab-now-eq"><i></i><i></i><i></i></span>
              </div>
            </div>
          </div>
        </div>

        <div class="phone pair-phone">
          <div class="screen">
            <span class="island" aria-hidden="true"></span>
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="glyphs">
                <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              </span>
            </div>
            <div class="scr-head" aria-hidden="true">
              <svg class="chev" viewBox="0 0 16 16"><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <span>downloads</span>
              <span class="eq"><i></i><i></i><i></i></span>
            </div>
            <ul class="list" aria-hidden="true">
              {DRIFT.slice(0, 5).map((d) => (
                <li>
                  <span class={`row-art art-${d.art}`}></span>
                  <span class="row-txt"><b>{d.title}</b><span>{d.artist}</span></span>
                  <svg class="row-tick" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#f3ede2" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </li>
              ))}
            </ul>
            <span class="home" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <!--
        New with the Siri work: the app reaches past the phone. Kept to the
        claim — one handler behind the Siri button, CarPlay and Shortcuts, and
        a HomePod that has no apps and hands the request back to the iPhone.
      -->
      <div class="shell">
        <div class="beyond">
          <div class="beyond-head">
            <h3>And it reaches past the phone.</h3>
            <p>
              Siri plays a song, album, artist, playlist, genre, liked songs or a mix
              straight from your own library. Plays you start in the app are donated, so
              asking plainly for music learns to reach it.
            </p>
          </div>

          <ul class="beyond-list" role="list">
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <path d="M30 8V3M21.5 10.4 19 6M38.5 10.4 41 6" fill="none" stroke="var(--red)" stroke-width="2.2" stroke-linecap="round"></path>
                <rect x="19" y="13" width="22" height="37" rx="11" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <ellipse cx="30" cy="19.5" rx="7.5" ry="3" fill="var(--red)"></ellipse>
                <g stroke="currentColor" stroke-width="1.5" opacity="0.42">
                  <path d="M22.5 31h15M22.5 39h15"></path>
                </g>
              </svg>
              <h4>HomePod</h4>
              <p>
                It has no apps of its own, so it hands the request to your iPhone, which
                plays it and AirPlays it back.
              </p>
            </li>
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <rect x="6" y="15" width="48" height="29" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <rect x="11" y="20" width="15" height="19" rx="2" fill="var(--red)"></rect>
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5">
                  <path d="M31 24h18M31 30h18M31 36h11"></path>
                </g>
                <path d="M17 50h26" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.35"></path>
              </svg>
              <h4>CarPlay</h4>
              <p>
                Behind the same intent handler as the Siri button, so asking in the car
                reaches the same library.
              </p>
            </li>
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <rect x="13" y="10" width="34" height="40" rx="8" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <path d="M32 17 21 33h8l-1.5 11L39 28h-8.5L32 17Z" fill="var(--red)"></path>
              </svg>
              <h4>Shortcuts</h4>
              <p>
                The same handler again, so a shortcut can start a song, album, artist,
                playlist, genre or a mix.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- WHAT IT DOES                                                     --
      -- ================================================================ -->
    <section class="band does" aria-labelledby="im-does">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>The app</p>
            <h2 id="im-does">Everything it does, set plainly.</h2>
          </div>
          <p class="lede">
            No feature here is aspirational and none of it is held behind a tier, because
            there is no tier to hold it behind.
          </p>
        </div>

        <ol class="does-list" role="list">
          {FEATURES.map((f, i) => (
            <li>
              <span class="does-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- TRUST — printed white on the ink, over the wall as decoration    --
      -- ================================================================ -->
    <section class="band trust" aria-labelledby="im-trust">
      <div class="wall" aria-hidden="true">
        {WALL.map((k) => <span class={`wall-tile art-${k}`}></span>)}
      </div>

      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>What is not here</p>
            <h2 id="im-trust">Four things Mozz does not have.</h2>
          </div>
          <p class="lede">
            The argument for owning your music is mostly an argument about what is missing
            from the app that plays it.
          </p>
        </div>

        <div class="own">
          {OWNERSHIP.map((o) => (
            <article>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </article>
          ))}
        </div>

        <dl class="stats">
          {STATS.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================================================================ --
      -- FAQ                                                              --
      -- ================================================================ -->
    <section class="band faq" aria-labelledby="im-faq">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Questions</p>
            <h2 id="im-faq">Plain answers.</h2>
          </div>
          <p class="lede">
            If something is missing from this list, the source and the docs are public and
            the issue tracker is open.
          </p>
        </div>

        <div class="faq-list">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}<span class="sign" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- CLOSE                                                            --
      -- ================================================================ -->
    <!--
      The last impression. The page's own device — a block of ink with the type
      knocked out of it — applied to the closing call, rather than reprinting
      the wordmark at billboard size a second time.
    -->
    <footer class="close" aria-labelledby="im-close">
      <div class="shell">
        <div class="final">
          <div class="final-say">
            <h2 id="im-close">{TAGLINE}</h2>
            <p class="close-sub">{SUBLINE}</p>
          </div>

          <div class="final-do">
            <div class="actions">
              {APP_STORE_URL ? (
                <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
              ) : (
                <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
              )}
              <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
            </div>
            <p class="final-fine">
              Free forever, open source under GPL&#8209;3.0. No account, no tracking, and
              no part of it held back.
            </p>
          </div>
        </div>

        <p class="colophon">
          <span>iPhone and iPad &middot; iOS 17 or later</span>
          <span>Plex &middot; Jellyfin &middot; Subsonic &middot; OpenSubsonic</span>
        </p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .im {
    --paper: #f3ede2;
    --paper-2: #e9e1d3;
    --ink: #121011;
    --red: #c80028;
    --dim: rgba(18, 16, 17, 0.68);
    --faint: rgba(18, 16, 17, 0.44);
    --hair: rgba(18, 16, 17, 0.18);

    /* the column of ink: where it starts and how wide it is */
    --slab-x: 52%;
    --slab-w: 30%;

    position: relative;
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Familjen Grotesk', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  /* ================================ hero ================================ */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    padding: clamp(56px, 6vh, 78px) clamp(18px, 4vw, 60px) clamp(180px, 30vh, 300px);
  }

  .press {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .slab {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--slab-x);
    width: var(--slab-w);
    background: var(--red);
  }

  .word {
    position: absolute;
    inset: 0;
  }

  .word span {
    position: absolute;
    left: 50%;
    bottom: -5.5%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: 'Archivo', 'Arial Black', system-ui;
    font-variation-settings: 'wdth' 125, 'wght' 900;
    font-weight: 900;
    font-size: 33vw;
    line-height: 0.74;
    letter-spacing: -0.035em;
  }

  .word.base span { color: var(--ink); }
  .word.knock span { color: var(--paper); }

  /* The knocked-out copy exists only inside the ink. One hard edge, no blur —
     that edge is the whole point of the page. */
  .word.knock {
    clip-path: inset(0 calc(100% - var(--slab-x) - var(--slab-w)) 0 var(--slab-x));
  }

  .crop {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid var(--red);
  }

  .crop-tl { top: clamp(26px, 2.6vh, 34px); left: clamp(18px, 4vw, 60px); border-top-width: 2px; border-left-width: 2px; }
  .crop-tr { top: clamp(26px, 2.6vh, 34px); right: clamp(18px, 4vw, 60px); border-top-width: 2px; border-right-width: 2px; }
  .crop-bl { bottom: clamp(26px, 2.6vh, 34px); left: clamp(18px, 4vw, 60px); border-bottom-width: 2px; border-left-width: 2px; }
  .crop-br { bottom: clamp(26px, 2.6vh, 34px); right: clamp(18px, 4vw, 60px); border-bottom-width: 2px; border-right-width: 2px; }

  /* --- the words on top ---------------------------------------------- */

  .top {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--ink);
  }

  .lockup {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    font-size: 13px;
  }

  .lockup b {
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 110, 'wght' 800;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .lockup i {
    width: 1px;
    height: 13px;
    background: var(--faint);
  }

  .lockup span { color: var(--dim); }

  .fine,
  .works-tag,
  .eyebrow {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* It sits on the ink column, so it is printed on its own patch of paper
     rather than losing half of itself to the red. */
  .fine {
    padding: 0.34rem 0.6rem;
    background: var(--paper);
  }

  .say {
    position: relative;
    z-index: 3;
    align-self: center;
    max-width: 30rem;
    padding: clamp(14px, 3vh, 36px) 0;
  }

  .eyebrow { margin-bottom: 0.9rem; }

  h1 {
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 800;
    font-size: clamp(29px, 3.7vw, 52px);
    line-height: 1.03;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .support {
    max-width: 32ch;
    margin-top: 1.05rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.15vw, 17px);
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.95rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .works-one {
    display: inline-flex;
    gap: 0.34rem;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--dim);
  }

  .works-one :global(.server-logo) { color: var(--red); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.15rem;
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .btn.go {
    background: var(--red);
    color: var(--paper);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .btn.go:hover { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--ink); }

  .btn.go.is-pending {
    background: transparent;
    border: 2px dashed var(--red);
    color: var(--red);
    box-shadow: none;
  }

  .btn.go.is-pending:hover { transform: none; box-shadow: none; }

  .btn.src {
    border: 2px solid var(--ink);
    color: var(--ink);
  }

  .btn.src:hover { box-shadow: 5px 5px 0 var(--red); transform: translate(-1px, -1px); }

  a:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  /* --- the phone, standing in the ink --------------------------------- */

  .phone {
    width: var(--pw, clamp(196px, 17.5vw, 300px));
    aspect-ratio: 71.6 / 147.6;
    padding: 0.7%;
    border-radius: clamp(24px, 2.4vw, 40px);
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1px rgba(243, 237, 226, 0.2),
      0 34px 74px -30px rgba(18, 16, 17, 0.6);
  }

  .hero-phone {
    position: absolute;
    z-index: 2;
    left: calc(var(--slab-x) + var(--slab-w) / 2);
    bottom: -7%;
    --pw: clamp(180px, 15.5vw, 262px);
    transform: translateX(-50%);
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 7.4% 6.4% 4.6%;
    border-radius: clamp(21px, 2.1vw, 35px);
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    container-type: inline-size;
  }

  .island {
    position: absolute;
    top: 3.1%;
    left: 50%;
    width: 30%;
    height: 3.1%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--ink);
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 3.4cqw;
    font-weight: 600;
  }

  .glyphs {
    display: inline-flex;
    gap: 3%;
    align-items: center;
  }

  .glyphs svg {
    height: 3.1cqw;
    width: auto;
    fill: currentColor;
  }

  .scr-head {
    display: flex;
    gap: 3%;
    align-items: center;
    margin-top: 7%;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 2.7cqw;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .chev { width: 3.6cqw; flex: none; }
  .scr-head span:not(.eq) { flex: 1; }

  .eq {
    display: inline-flex;
    gap: 0.8cqw;
    align-items: flex-end;
    height: 3.4cqw;
  }

  .eq i {
    width: 1.1cqw;
    background: var(--red);
    animation: eq 1.15s ease-in-out infinite;
  }

  .eq i:nth-child(1) { height: 55%; }
  .eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .eq i:nth-child(3) { height: 72%; animation-delay: 0.36s; }

  @keyframes eq {
    0%, 100% { transform: scaleY(0.45); }
    50% { transform: scaleY(1); }
  }

  .art {
    margin-top: 6%;
    overflow: hidden;
  }

  .art svg { width: 100%; height: auto; }

  .meta { margin-top: 7%; }

  .meta strong {
    display: block;
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 105, 'wght' 800;
    font-size: 5.6cqw;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .meta span {
    display: block;
    margin-top: 1.4%;
    font-size: 3.5cqw;
    color: var(--faint);
  }

  .bar {
    margin-top: 6.5%;
    height: 0.9cqw;
    background: rgba(18, 16, 17, 0.16);
  }

  .bar i {
    display: block;
    width: 46%;
    height: 100%;
    background: var(--red);
  }

  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 2.4%;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 2.7cqw;
    color: var(--faint);
  }

  .ctrl {
    display: flex;
    gap: 9%;
    align-items: center;
    justify-content: center;
    margin-top: 6.5%;
  }

  .ctrl svg {
    width: 6.4cqw;
    fill: var(--ink);
  }

  .play {
    display: inline-grid;
    place-items: center;
    width: 14cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  .play svg { width: 6.4cqw; fill: var(--paper); }

  .pill {
    display: flex;
    gap: 2.6%;
    align-items: center;
    margin-top: auto;
    padding: 2.6% 3.4%;
    background: var(--paper-2);
    font-size: 3.1cqw;
    color: var(--dim);
  }

  .pill svg { width: 4cqw; flex: none; }

  .home {
    width: 34%;
    height: 0.9cqw;
    margin: 4% auto 0;
    border-radius: 999px;
    background: rgba(18, 16, 17, 0.4);
  }

  /* ============================== bands ================================= */

  .band {
    position: relative;
    padding: clamp(66px, 9vh, 128px) 0;
    border-top: 2px solid var(--ink);
  }

  .shell {
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin-inline: auto;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(18px, 4vw, 68px);
    align-items: end;
  }

  .kicker {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tick {
    width: 10px;
    height: 10px;
    background: var(--red);
  }

  h2 {
    max-width: 15ch;
    margin-top: 0.85rem;
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 800;
    font-size: clamp(26px, 3.3vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    max-width: 46ch;
    padding-bottom: 0.4rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
  }

  h3 {
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.18;
    letter-spacing: -0.015em;
  }

  /* --- servers -------------------------------------------------------- */

  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(228px, 1fr));
    gap: 0;
    margin-top: clamp(28px, 4vh, 48px);
    border: 2px solid var(--ink);
  }

  .plates li {
    padding: clamp(20px, 2.4vw, 32px);
    border-right: 2px solid var(--ink);
  }

  .plates li:last-child { border-right: 0; }

  .plate-extra { background: var(--ink); color: var(--paper); }
  .plate-extra .plate-no { color: var(--red); }
  .plate-extra p { color: rgba(243, 237, 226, 0.72); }

  .plate-no {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--red);
  }

  .plate-logo {
    display: block;
    margin: 0.9rem 0 1rem;
    color: var(--ink);
  }

  .plates h3 { margin-bottom: 0.45rem; }
  .plate-extra h3 { margin-top: 0.9rem; }

  .plates p {
    color: var(--dim);
    font-size: 14.5px;
  }

  /* --- split payoff --------------------------------------------------- */

  .split { padding-block: 0; }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
  }

  .half { padding: clamp(52px, 8vh, 108px) clamp(24px, 4.4vw, 76px); }

  .plain { background: var(--paper); }
  .seam { background: var(--ink); }

  .half h2 {
    max-width: none;
    margin-top: 0.6rem;
    font-size: clamp(34px, 4.6vw, 62px);
  }

  .half > p {
    max-width: 36ch;
    margin-top: 1rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
  }

  .marks {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 2px solid currentColor;
  }

  .marks li {
    display: flex;
    gap: 0.75rem;
    font-size: 14.5px;
    color: var(--dim);
  }

  .marks b {
    flex: none;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.85;
    color: var(--red);
  }

  /* The inked half reverses everything, and must come after .half so the
     shared ink colours do not win. */
  .inked {
    background: var(--red);
    color: var(--paper);
  }

  .inked .kicker { color: rgba(243, 237, 226, 0.72); }
  .inked .tick { background: var(--paper); }
  .inked > p,
  .inked .marks li { color: rgba(243, 237, 226, 0.86); }
  .inked .marks b { color: var(--paper); }

  /* --- marquee payoff -------------------------------------------------- */

  .drift {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: clamp(32px, 5vh, 56px) 0;
    padding: clamp(16px, 2.4vh, 26px) 0;
  }

  /* the band of ink the strip travels through */
  .drift-band {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 34%;
    width: 32%;
    background: var(--red);
  }

  .drift-layer { position: relative; }

  .drift-layer.is-knocked {
    position: absolute;
    inset: clamp(16px, 2.4vh, 26px) 0;
    color: var(--paper);
    clip-path: inset(0 34% 0 34%);
  }

  /*
   * Inside the ink every value flips, so the artwork reverses with the type
   * instead of only the captions changing colour. Swapping the three custom
   * properties the sleeves are drawn from does the whole job at once.
   */
  .drift-layer.is-knocked {
    --paper: #c80028;
    --ink: #f3ede2;
    --red: #121011;
  }

  .drift-layer.is-knocked .sleeve-art { border-color: rgba(243, 237, 226, 0.55); }
  .drift-layer.is-knocked figcaption b { color: #f3ede2; }
  .drift-layer.is-knocked figcaption span { color: rgba(243, 237, 226, 0.72); }

  .drift-track {
    display: flex;
    gap: clamp(14px, 1.6vw, 24px);
    width: max-content;
    animation: drift 68s linear infinite;
  }

  @keyframes drift {
    to { transform: translateX(-50%); }
  }

  .drift:hover .drift-track { animation-play-state: paused; }

  .sleeve {
    width: clamp(140px, 14vw, 200px);
    flex: none;
  }

  .sleeve-art {
    display: block;
    aspect-ratio: 1;
    border: 2px solid rgba(18, 16, 17, 0.5);
  }

  .sleeve figcaption {
    display: block;
    margin-top: 0.6rem;
    font-size: 12.5px;
    line-height: 1.35;
  }

  .sleeve figcaption b { display: block; font-weight: 600; }
  .sleeve figcaption span { display: block; color: var(--faint); }

  .drift-note {
    max-width: 58ch;
    color: var(--faint);
    font-size: 13.5px;
  }

  /* the invented sleeve artwork: red, paper, ink and nothing else */
  .art-slug {
    background:
      linear-gradient(180deg, var(--ink) 0 34%, transparent 34%),
      linear-gradient(90deg, transparent 0 22%, var(--red) 22% 62%, transparent 62%),
      var(--paper);
  }

  .art-rule {
    background:
      repeating-linear-gradient(180deg, var(--ink) 0 3px, transparent 3px 14px),
      linear-gradient(90deg, var(--red) 0 26%, transparent 26%),
      var(--paper);
  }

  .art-block {
    background:
      linear-gradient(135deg, var(--red) 0 48%, transparent 48%),
      linear-gradient(180deg, var(--paper) 0 62%, var(--ink) 62%);
  }

  .art-knock {
    background:
      radial-gradient(circle at 50% 50%, var(--paper) 0 26%, transparent 26%),
      linear-gradient(90deg, var(--ink) 0 30%, var(--red) 30%);
  }

  .art-stripe {
    background:
      repeating-linear-gradient(90deg, var(--red) 0 12px, transparent 12px 30px),
      linear-gradient(180deg, var(--paper) 0 70%, var(--ink) 70%);
  }

  /* --- pair payoff ----------------------------------------------------- */

  .rig {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin: clamp(30px, 4vh, 52px) auto 0;
  }

  .tablet {
    width: clamp(310px, 52vw, 720px);
    aspect-ratio: 248 / 179;
    flex: none;
    padding: 1.1%;
    border-radius: clamp(16px, 1.8vw, 28px);
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1px rgba(243, 237, 226, 0.18),
      0 40px 84px -36px rgba(18, 16, 17, 0.55);
  }

  .tab-screen {
    display: grid;
    grid-template-columns: 27% 1fr;
    height: 100%;
    border-radius: clamp(11px, 1.3vw, 20px);
    overflow: hidden;
    background: var(--paper);
    container-type: inline-size;
  }

  .tab-side {
    display: flex;
    flex-direction: column;
    gap: 1.8cqw;
    padding: 3cqw 2.4cqw;
    border-right: 2px solid var(--ink);
    background: var(--paper-2);
  }

  .tab-lock {
    display: flex;
    gap: 1.1cqw;
    align-items: center;
    margin-bottom: 1.2cqw;
    font-size: 1.9cqw;
  }

  .tab-lock b {
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 108, 'wght' 800;
  }

  .tab-nav {
    font-size: 1.6cqw;
    color: var(--dim);
  }

  .tab-nav.is-on {
    position: relative;
    color: var(--ink);
    font-weight: 600;
  }

  .tab-nav.is-on::before {
    content: '';
    position: absolute;
    left: -2.2cqw;
    top: 0.35em;
    width: 0.7cqw;
    height: 0.7cqw;
    background: var(--red);
  }

  .tab-main {
    display: flex;
    flex-direction: column;
    padding: 3cqw 2.6cqw 2.4cqw;
  }

  .tab-title {
    display: block;
    margin-bottom: 2.2cqw;
    font-family: 'Archivo', system-ui;
    font-variation-settings: 'wdth' 105, 'wght' 800;
    font-size: 3.2cqw;
  }

  .tab-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.8cqw;
  }

  .tile {
    aspect-ratio: 1;
    border: 1px solid var(--hair);
  }

  .tab-now {
    display: flex;
    gap: 1.6cqw;
    align-items: center;
    margin-top: auto;
    padding-top: 2.2cqw;
    border-top: 2px solid var(--ink);
  }

  .tab-now-art { width: 4cqw; aspect-ratio: 1; flex: none; }
  .tab-now-txt { flex: none; }
  .tab-now-txt b { display: block; font-size: 1.7cqw; font-weight: 600; }
  .tab-now-txt > span { display: block; font-size: 1.4cqw; color: var(--faint); }

  .tab-now-bar {
    flex: 1;
    height: 0.4cqw;
    background: rgba(18, 16, 17, 0.16);
  }

  .tab-now-bar i { display: block; width: 38%; height: 100%; background: var(--red); }

  .tab-now-eq {
    display: inline-flex;
    gap: 0.4cqw;
    align-items: flex-end;
    height: 1.9cqw;
    flex: none;
  }

  .tab-now-eq i {
    width: 0.55cqw;
    background: var(--red);
    animation: eq 1.15s ease-in-out infinite;
  }

  .tab-now-eq i:nth-child(1) { height: 55%; }
  .tab-now-eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .tab-now-eq i:nth-child(3) { height: 72%; animation-delay: 0.36s; }

  .pair-phone {
    --pw: clamp(150px, 19.5vw, 272px);
    position: relative;
    z-index: 2;
    margin-left: clamp(-56px, -3.4vw, -18px);
    margin-bottom: clamp(-24px, -1.6vw, -8px);
  }

  .list {
    display: grid;
    gap: 3.4%;
    margin-top: 7%;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: flex;
    gap: 3.4%;
    align-items: center;
  }

  .row-art {
    width: 15%;
    aspect-ratio: 1;
    flex: none;
    border: 1px solid var(--hair);
  }

  .row-txt { flex: 1; min-width: 0; }

  .row-txt b {
    display: block;
    font-size: 3.6cqw;
    font-weight: 600;
