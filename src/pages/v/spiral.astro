<Layout
  title={`${NAME} — one continuous line, drawn as country`}
  description="A free, open source music app for Plex, Jellyfin and Navidrome. A disc holds one unbroken spiral from the centre out — here it is an isometric landscape at dusk, and the page is a journey along it."
  themeColor="#1d2233"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=supreme@400,500&f[]=khand@500,600,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="sp">
    <!--
      THESIS: A compact disc is one single continuous spiral from the centre out.
      This page reads that literally — the spiral becomes an amber causeway
      winding across the disc's surface, drawn as isometric country at dusk, and
      you travel along it as you scroll. Stations along the route are the content.
      OWN-WORLD: Deep twilight-blue ground, a low amber sun, pale-teal light and
      brand red for beacons. Flat screen-print colour, one hard value step per
      face, one outline weight, un-erased construction rings on the pressing, a
      light riso grain. A single marching flowline never breaks — gapless.
      FIRST VIEWPORT: the spiral landscape, wordmark + headline beside it.
      AI-ART DROP-IN: /hero/spiral.jpg layers over --hero-plate; absent, the CSS
      dusk sky + the drawn landscape stand alone with nothing broken.
    -->

    <VariantBar slug="spiral" tone="neutral" />

    <!-- HERO ---------------------------------------------------------------- -->
    <header class="hero">
      <div class="hero-copy">
        <div class="lockup">
          <Mark size={26} decorative />
          <span class="wordmark">{NAME}</span>
          <span class="lockup-tick">one line, centre → out</span>
        </div>
        <h1>{TAGLINE}</h1>
        <p class="lede">
          {SUBLINE} A disc is one unbroken spiral from the middle out — every
          track the same line. Mozz plays your own Plex, Jellyfin or Navidrome
          library along it, drawn here as country you travel at dusk.
        </p>
        <div class="actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="ghost" href={GITHUB_URL}>Read the source →</a>
        </div>
      </div>

      <figure class="stage">
        <div class="plate" aria-hidden="true"></div>
        <svg class="art hero-art" viewBox={heroVB} role="img"
             aria-label="An isometric compact disc drawn as land at dusk: its single continuous spiral is a raised amber road winding from the front edge inward to a small lit hub tower, a laser sled travels the outer road reading it with a red beam, under a low amber sun and a twilight sky.">
          <defs>
            <clipPath id="sp-sky"><rect x={hb[0]} y={r2(hb[1] - skyH)} width={hb[2]} height={r2(skyH + hb[3])} /></clipPath>
            {/* Radial fade so the sky has NO hard rectangle — it glows around the
               low sun and dissolves into the page's dusk gradient on every edge. */}
            <radialGradient id="sp-skyfade" cx="0.3" cy="0.34" r="0.86">
              <stop offset="0" stop-color="#fff" /><stop offset="0.5" stop-color="#fff" />
              <stop offset="0.82" stop-color="#fff" stop-opacity="0.55" /><stop offset="1" stop-color="#000" />
            </radialGradient>
            <mask id="sp-skymask">
              <rect x={hb[0]} y={r2(hb[1] - skyH)} width={hb[2]} height={r2(skyH + hb[3])} fill="url(#sp-skyfade)" />
            </mask>
            <linearGradient id="sp-band-purple" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#1d2233" /><stop offset="0.24" stop-color="#3a2f45" />
              <stop offset="0.76" stop-color="#3a2f45" /><stop offset="1" stop-color="#1d2233" />
            </linearGradient>
            <linearGradient id="sp-band-brown" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#1d2233" /><stop offset="0.2" stop-color="#7a4a2e" />
              <stop offset="0.8" stop-color="#7a4a2e" /><stop offset="1" stop-color="#1d2233" />
            </linearGradient>
          </defs>
          <g clip-path="url(#sp-sky)" mask="url(#sp-skymask)">
            <rect x={hb[0]} y={r2(hb[1] - skyH)} width={hb[2]} height={r2(skyH + hb[3])} fill="#1d2233" />
            <rect x={hb[0]} y={r2(hb[1] - skyH * 0.42)} width={hb[2]} height={r2(skyH * 0.42 + hb[3] * 0.5)} fill="url(#sp-band-purple)" />
            <rect x={hb[0]} y={r2(hb[1] - skyH * 0.16)} width={hb[2]} height={r2(skyH * 0.16 + hb[3] * 0.5)} fill="url(#sp-band-brown)" />
            <circle cx={r2(sun.cx)} cy={r2(sun.cy)} r={r2(sun.r)} fill="#e8a13a" />
            <circle cx={r2(sun.cx)} cy={r2(sun.cy)} r={r2(sun.r * 1.5)} fill="none" stroke="#e8a13a" stroke-opacity="0.3" stroke-width="1.2" />
            {/* dusk haze bands crossing the sun's base so it sets into the horizon
               rather than floating like a sticker */}
            <rect x={hb[0]} y={r2(sun.cy + sun.r * 0.16)} width={hb[2]} height={r2(sun.r * 0.34)} fill="#2b2436" opacity="0.7" />
            <rect x={hb[0]} y={r2(sun.cy + sun.r * 0.62)} width={hb[2]} height={r2(sun.r * 0.26)} fill="#241d2e" opacity="0.85" />
          </g>
          {hero.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {hero.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
          <path d={heroFlow} class="flowline" />
        </svg>
      </figure>
    </header>

    <!-- SERVERS ------------------------------------------------------------- -->
    <section class="scene servers" aria-labelledby="srv-h">
      <div class="scene-head">
        <h2 id="srv-h">Three depots on the one line.</h2>
        <p>Point Mozz at a machine you already own. Plex, Jellyfin and Navidrome patch onto the same route — add more than one and the whole catalogue reads as a single road.</p>
      </div>
      <figure class="band-art">
        <svg class="art" viewBox={depots.vb(6)} role="img"
             aria-label="Three different isometric depot buildings at dusk — a tall stepped Plex tower, a wide low Jellyfin hall, and a Navidrome cube with a rooftop dish — each labelled with its server logo and joined by a short teal spur to one long amber road.">
          {depots.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {depots.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
          {depotBadges.map((b) => (
            <svg class="depot-logo" x={r2(b.x - b.side / 2)} y={r2(b.y - b.side / 2)} width={r2(b.side)} height={r2(b.side)}
                 viewBox={SERVER_LOGOS[b.key].viewBox} fill={b.color} stroke="none" style={`color:${b.color}`} set:html={SERVER_LOGOS[b.key].inner} />
          ))}
        </svg>
      </figure>
      <ul class="server-list" role="list">
        {SERVERS.map((sv) => (
          <li>
            <span class="server-logo-wrap"><ServerLogo name={sv.name} size={28} brand /></span>
            <div>
              <h3>{sv.name}</h3>
              <p>{sv.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- FEATURES ------------------------------------------------------------ -->
    <section class="scene route-sec" aria-labelledby="feat-h">
      <div class="scene-head">
        <h2 id="feat-h">Six waypoints down the route.</h2>
        <p>Everything Mozz does, marked the way a road marks its miles — numbered stones you pass, not a wall of cards.</p>
      </div>
      <figure class="band-art">
        <svg class="art" viewBox={route.vb(6)} role="img"
             aria-label="A single tall isometric fingerpost at dusk: six large direction boards mounted up the pole, alternating left and right, each numbered and naming one feature, with a lamp on top and a bench, crates, route stones, a signal box and a lamp post grouped at its foot.">
          {route.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {route.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <ol class="parts-list" role="list">
        {FEATURES.map((ft, i) => (
          <li>
            <span class="part-num">{i + 1}</span>
            <div>
              <h3>{ft.title}</h3>
              <p>{ft.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- PITS / MECHANISM ---------------------------------------------------- -->
    <section class="scene pits-sec" aria-labelledby="pit-h">
      <figure class="band-art">
        <svg class="art" viewBox={pits.vb(6)} role="img"
             aria-label="The disc surface drawn at magnification as a canyon: a channel floor of rectangular pits between two raised banks, with a gantry-mounted laser reader striking the floor with a red beam, and a green readout showing sixteen milliseconds across a hundred thousand tracks and seventy-five milliseconds to first note.">
          {pits.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {pits.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <div class="scene-head narrow">
        <h2 id="pit-h">Close up, the line is pits and lands.</h2>
        <p>Zoom into the road and it is the mechanism itself — pits read by a laser. Mozz mirrors the whole catalogue into an on-device database, so the reader never stalls.</p>
        <div class="spec-plates">
          <div class="plate-chip"><b>{specA.value}</b><span>{specA.label}</span></div>
          <div class="plate-chip"><b>{specB.value}</b><span>{specB.label}</span></div>
        </div>
      </div>
    </section>

    <!-- ADAPTIVE COLOUR / SKIES + PHONE ------------------------------------- -->
    <section class="scene skies" aria-labelledby="sky-h">
      <div class="scene-head">
        <h2 id="sky-h">Every cover paints its own sky.</h2>
        <p>Mozz repaints its whole interface from the artwork of the current record. Along the route that reads as weather — a new light over the land for whatever is playing.</p>
      </div>

      <div class="skies-grid">
        <figure class="billboard">
          <div class="bb-sky" aria-hidden="true"></div>
          <div class="bb-phone">
            <Phone name="mozz-nowplaying" width={224} priority sizes="(max-width: 720px) 60vw, 224px"
                   class="sp-phone" alt="The Mozz now-playing screen, its interface tinted violet to match the album art." />
          </div>
          <figcaption><span class="sky-tag" style="--sky:#7a3bd6">Violet nightfall</span></figcaption>
        </figure>

        <ul class="sky-strip" role="list">
          {SKIES.map((k) => (
            <li class="sky-card" style={`--sky:${k.sky}; --sky-ink:${k.ink}`}>
              <div class="sky-band" aria-hidden="true">
                <svg viewBox="0 0 60 34" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                  <circle cx="44" cy="12" r="6" fill="var(--sky-ink)" opacity="0.35" />
                  <path d="M0 34 L18 20 L30 26 L46 16 L60 24 L60 34 Z" fill="var(--sky-ink)" opacity="0.28" />
                </svg>
              </div>
              <div class="sky-shot">
                <Shot name={k.shot} sizes="(max-width: 720px) 42vw, 150px" class="sky-img" />
              </div>
              <span class="sky-tag">{k.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- OWNERSHIP / OFF-GRID ------------------------------------------------ -->
    <section class="scene own" aria-labelledby="own-h">
      <div class="scene-head">
        <h2 id="own-h">The road can leave the server behind.</h2>
        <p>Download a record and it stays played — the catalogue rides along, the server's lights small in the distance. This one is actually yours.</p>
      </div>
      <figure class="band-art">
        <svg class="art" viewBox={offgrid.vb(0.8)} role="img"
            aria-label="A wide isometric view at dusk of the end of the line. At the far north-west the origin server stands small in the distance, a few windows still lit. An amber track leaves it as a broken, dashed run whose gaps widen — the connection being left behind — then rises into a solid raised causeway that runs east and off the south-east edge of the ground. On the near apron a low bench sits beside a crate, and on the crate a phone lies face-up, its amber screen still lit with a now-playing bar: off the server, still playing. A route marker post, a low stack of crates and a bollard stand about the yard. There is no figure.">    
          {offgrid.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {offgrid.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <ul class="own-list" role="list">
        {OWNERSHIP.map((o) => (<li><h3>{o.title}</h3><p>{o.body}</p></li>))}
      </ul>
    </section>

    <!-- FAQ ----------------------------------------------------------------- -->
    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Notes from the roadside</h2>
      <dl>
        {FAQS.map((qa) => (
          <div class="faq-row"><dt>{qa.q}</dt><dd>{qa.a}</dd></div>
        ))}
      </dl>
    </section>

    <!-- FOOTER -------------------------------------------------------------- -->
    <footer class="foot">
      <div class="foot-rule" aria-hidden="true"></div>
      <div class="foot-grid">
        <div class="foot-disc" aria-hidden="true">
          <svg viewBox="0 0 120 120" role="presentation">
            <circle cx="60" cy="60" r="52" fill="#161d31" stroke="#28324e" stroke-width="2" />
            {[46, 38, 30, 22, 14].map((rr, i) => (
              <circle cx="60" cy="60" r={rr} fill="none" stroke={i % 2 ? '#5fc9c0' : '#e8a13a'} stroke-opacity="0.5" stroke-width="1" />
            ))}
            <circle cx="60" cy="60" r="7" fill="#1d2233" stroke="#5fc9c0" stroke-width="1.4" />
            <circle cx="60" cy="60" r="2.4" fill="#c80028" />
          </svg>
        </div>
        <div class="foot-body">
          <div class="foot-mark">
            <Mark size={22} decorative />
            <span class="wordmark">{NAME}</span>
            <span class="foot-legend">End of the line · one spiral, middle out</span>
          </div>
          <p class="foot-line">{TAGLINE} {SUBLINE}</p>
          <p class="foot-meta">
            Free forever · GPL-3.0 with an App Store Exception · <a href={GITHUB_URL}>source on GitHub</a>
          </p>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .sp {
    --twilight: #1d2233;
    --twi-2: #171d2c;
    --twi-3: #131826;
    --amber: #e8a13a;
    --teal: #5fc9c0;
    --red: #c80028;
    --ink: #f2ede1;
    --body: #c7cede;
    --muted: #93a0ba;
    --line: rgba(140, 158, 196, 0.24);
    --shadow: rgba(6, 9, 18, 0.5);
    --guide: rgba(120, 150, 200, 0.24);

    --hero-plate: url('/hero/spiral.jpg');

    background:
      linear-gradient(#12172400, #12172400),
      radial-gradient(120% 80% at 78% -6%, #2a3350 0%, var(--twilight) 46%, var(--twi-3) 100%);
    color: var(--body);
    font-family: 'Supreme', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.62;
    overflow-x: clip;
    position: relative;
    isolation: isolate;
  }

  /* riso grain over the dusk flats */
  .sp::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.4;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='150'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.7'/></feComponentTransfer></filter><rect width='150' height='150' filter='url(%23n)'/></svg>");
    background-size: 150px 150px;
  }

  /* one outline weight everywhere, in screen pixels */
  .art { width: 100%; height: auto; overflow: visible; display: block; }
  .art path, .art circle, .art ellipse, .art line, .art rect {
    vector-effect: non-scaling-stroke;
    stroke: #0c1120;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .art .flat { stroke: none; }
  .art .edge { fill: none; }
  .art .guide { stroke: var(--guide); stroke-width: 1; fill: none; }
  .art .guide-ring { stroke: rgba(95, 201, 192, 0.22); stroke-width: 1; fill: none; }
  .art .seam-d { stroke: rgba(6,9,18,0.6); stroke-width: 1.1; }
  .art .seam-l { stroke: rgba(255,240,210,0.35); stroke-width: 1.1; }
  .art .screw { stroke: rgba(6,9,18,0.7); stroke-width: 1.1; }
  .art .lit { fill: currentColor; stroke: rgba(6,9,18,0.45); stroke-width: 0.7; }
  .art .beam { stroke: #ff3d5c; stroke-width: 2.4; fill: none; opacity: 0.92; }
  .art .band { stroke: #cdd4e2; stroke-width: 2.6; fill: none; stroke-linecap: round; }
  .art .ghostline { fill: none; stroke: #5a6486; stroke-width: 1.8; stroke-dasharray: 2.4 3.2; stroke-linecap: round; opacity: 0.55; }
  .art .notestem { stroke: #5fc9c0; stroke-width: 1; fill: none; stroke-linecap: round; }
  .art .strapline { stroke: #7a0f22; stroke-width: 2.2; fill: none; stroke-linecap: round; }
  .art .bird { stroke: #0c1120; stroke-width: 1.4; fill: none; }
  .art .flowline { fill: none; stroke: #8ff0e6; stroke-width: 1.8; stroke-dasharray: 1.6 6; stroke-linecap: round; animation: march 5.5s linear infinite; }
  .art text { fill: var(--ink); font-family: 'Khand', sans-serif; letter-spacing: 0.02em; }
  .art .lcd { fill: #7fe6c4; font-family: 'Khand', sans-serif; letter-spacing: 0.06em; }
  .art .legend-tick { fill: #0c1120; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  .art .legend-road { fill: #e8a13a; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }
  .art .stone-num { fill: #231404; font-weight: 700; }
  .art .sign-name { fill: #241a08; font-weight: 600; font-family: 'Khand', sans-serif; letter-spacing: 0.02em; }
  .art .bird-sil { stroke: none; }
  .art .cable { fill: none; stroke: #0c1120; stroke-width: 1.3; opacity: 0.7; }
  .art .clamp { fill: none; stroke: rgba(95, 201, 192, 0.4); stroke-width: 1; }
  .art .hubring { fill: none; stroke: #c3cbdc; stroke-width: 0.9; opacity: 0.85; }
  .art .sign-plate { stroke: #0c1120; stroke-width: 1.4; stroke-linejoin: round; }
  /* face-on depot marks — real server logos, unskewed, sitting on the roof signs */
  .depot-logo { overflow: visible; }
  .art .depot-logo path, .art .depot-logo g, .art .depot-logo circle, .art .depot-logo rect, .art .depot-logo polygon {
    stroke: none;
    fill: currentColor;
  }

  @keyframes march { to { stroke-dashoffset: -76; } }

  h1, h2, h3 { font-family: 'Clash Display', ui-sans-serif, sans-serif; font-weight: 600; letter-spacing: -0.02em; line-height: 1.04; color: var(--ink); }

  /* ── hero ── */
  .hero {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3.4vw, 3rem) clamp(1.25rem, 4vw, 3rem) clamp(0.5rem, 2vw, 1.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    min-height: min(88vh, 820px);
  }
  .lockup { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.4rem; }
  .wordmark { font-family: 'Clash Display', sans-serif; font-weight: 700; font-size: 1.35rem; letter-spacing: -0.03em; color: var(--ink); }
  .lockup-tick {
    font-family: 'Khand', sans-serif; text-transform: uppercase; letter-spacing: 0.14em;
    font-size: 0.7rem; color: var(--muted); border-left: 1px solid var(--line);
    padding-left: 0.6rem; margin-left: 0.2rem;
  }
  .hero h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); max-width: 14ch; margin-bottom: 1rem; font-weight: 600; }
  .lede { max-width: 42ch; color: var(--body); font-size: 1.06rem; }
  .actions { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; margin-top: 1.9rem; }
  .store {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--amber); color: #201203;
    padding: 0.7rem 1.15rem; border-radius: 12px; font-weight: 600;
    box-shadow: 4px 5px 0 rgba(6, 9, 18, 0.5);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .store:hover { transform: translate(-1px, -1px); box-shadow: 5px 6px 0 rgba(6, 9, 18, 0.55); }
  .store svg { width: 22px; height: 22px; fill: currentColor; }
  .store span { display: flex; flex-direction: column; line-height: 1.05; font-size: 1.02rem; }
  .store small { font-size: 0.64rem; font-weight: 600; opacity: 0.78; text-transform: uppercase; letter-spacing: 0.06em; }
  .store.is-pending { background: #2b3653; color: var(--ink); box-shadow: 4px 5px 0 rgba(6, 9, 18, 0.45); cursor: default; }
  .store.is-pending small::after { content: ' · pending'; opacity: 0.7; }
  .ghost { font-weight: 600; color: var(--teal); border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .ghost:hover { color: var(--amber); }

  .stage { position: relative; margin: 0; min-width: 0; }
  .stage .plate {
    position: absolute; inset: 4% 2%; z-index: -1;
    background-image: var(--hero-plate);
    background-size: cover; background-position: center; background-repeat: no-repeat;
    border-radius: 20px; opacity: 0.85;
  }
  .hero-art { filter: drop-shadow(0 30px 46px rgba(6, 9, 18, 0.55)); }

  /* ── generic scene ── */
  .scene {
    max-width: 1180px;
    margin: clamp(2rem, 5vw, 4rem) auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 2rem);
    align-items: center;
  }
  .scene-head h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); max-width: 17ch; margin-bottom: 0.7rem; }
  .scene-head p { max-width: 50ch; color: var(--body); }
  .scene-head.narrow p { max-width: 46ch; }
  .band-art { margin: 0; width: 100%; }
  .band-art .art { filter: drop-shadow(0 22px 34px rgba(6, 9, 18, 0.45)); }

  /* ── servers ── */
