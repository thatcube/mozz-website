  .slot-note { color: var(--dim); text-wrap: pretty; }

  /* ------------------------------------- illustration: on-device catalog */
  .illo .band-sub { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .catalog {
    --c: 10px;
    --c2: 20px;
    background: var(--ground-2);
