  .tint-screen {
    display: block;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5);
  }
  /* The Shot <img> keeps its own scope, so it is reached through :global from
     the wrapper this file owns. Kept crisp — never image-rendering: pixelated. */
  .tint-screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ------------------------------------------------------------- sections */
  .band {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
    border-top: 1px solid var(--line);
  }

  .band h2 {
    font-size: clamp(1.85rem, 4vw, 2.85rem);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .h-mark {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    background: var(--red);
