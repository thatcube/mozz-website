  .wrap-narrow { max-width: 46rem; }

  /* --------------------------------------------------------- site header */
  .site-head {
    position: relative;
    z-index: 1;
    max-width: 74rem;
    margin-inline: auto;
    padding: 1.15rem 1.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
