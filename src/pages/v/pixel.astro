  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* -------------------------------------------------------------- buttons */
  .btn {
    --c: 6px;
    --c2: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    font-family: 'Pixelify Sans', sans-serif;
    font-weight: 600;
