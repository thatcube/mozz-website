    --red: #c80028;
    --red-bright: #d6002b;
    --line: rgba(244, 244, 245, 0.10);
    --line-2: rgba(244, 244, 245, 0.16);
    /* Solid offset shadow. On a near-black ground a black shadow is invisible,
       so the "hard shadow" is drawn in brand red — the only ink that reads. */
    --shadow: #c80028;
