      </div>
    </section>

    <!-- ========================== FOOTER =========================== -->
    <footer class="foot">
      <Mark size={32} decorative />
      <p>
        {NAME} is free forever and open source under GPL-3.0.
        <a href={GITHUB_URL}>See it on GitHub</a>
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* ---------------------------------------------------------------- tokens */
  .px {
