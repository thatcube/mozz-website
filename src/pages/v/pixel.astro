    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* One reusable stepped "pixel corner". Two-notch staircase, tuned by --c/--c2
     so it is the same physical size on a button or a full-width panel. */
  .pix {
    --c: 8px;
    --c2: 16px;
    clip-path: polygon(
      0 var(--c2), var(--c) var(--c2), var(--c) var(--c), var(--c2) var(--c), var(--c2) 0,
      calc(100% - var(--c2)) 0, calc(100% - var(--c2)) var(--c), calc(100% - var(--c)) var(--c), calc(100% - var(--c)) var(--c2), 100% var(--c2),
      100% calc(100% - var(--c2)), calc(100% - var(--c)) calc(100% - var(--c2)), calc(100% - var(--c)) calc(100% - var(--c)), calc(100% - var(--c2)) calc(100% - var(--c)), calc(100% - var(--c2)) 100%,
      var(--c2) 100%, var(--c2) calc(100% - var(--c)), var(--c) calc(100% - var(--c)), var(--c) calc(100% - var(--c2)), 0 calc(100% - var(--c2))
    );
  }

  /* Hard offset shadow that follows the clipped pixel corners (0 blur = solid
     block, never a soft drop). filter runs after clip-path, so the shadow is
     the stepped silhouette, in brand red so it reads on the near-black ground. */
  .raise {
    filter: drop-shadow(6px 6px 0 var(--shadow));
  }

  h1, h2, h3 {
    font-family: 'Pixelify Sans', ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    line-height: 1;
