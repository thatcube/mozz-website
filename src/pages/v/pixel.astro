  .cv-flag.np i {
    width: 3px;
    height: 100%;
    background: var(--red);
    transform-origin: bottom;
    transform: scaleY(0.5);
    animation: eq-level 0.85s steps(5) infinite alternate;
  }
  .cv-flag.np i:nth-child(2) { animation-duration: 1.1s; animation-delay: 0.08s; }
  .cv-flag.np i:nth-child(3) { animation-duration: 0.72s; animation-delay: 0.03s; }

  /* -------------------------------- illustration: server → device → ears */
  .chain {
    margin: clamp(0.5rem, 2vw, 1rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
    background: var(--ground-2);
    padding: clamp(1rem, 3vw, 1.75rem);
    box-shadow: inset 0 0 0 2px var(--line-2);
  }
  .chain-svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 620px;
    margin: 0 auto;
  }
  .chain-svg text { shape-rendering: geometricPrecision; }
  .chain-cap {
    font-family: 'Silkscreen', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
    fill: var(--dim);
  }
  .chain-cap.no { fill: #ff6f88; }

  /* ---------------------------------------------------- features: a list */
  .feat {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    list-style: none;
    padding: 0;
    display: grid;
  }
  .feat li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .feat li:first-child { border-top: 0; }
  .feat-bullet { color: var(--red); }
  .feat-bullet .glyph { width: 2rem; height: 2.2rem; }
  .feat-text { min-width: 0; }
  .feat h3 { font-size: 1.5rem; margin-bottom: 0.4rem; }
  .feat p { color: var(--dim); max-width: 68ch; text-wrap: pretty; }

  .glyph {
    image-rendering: pixelated;
    shape-rendering: crispEdges;
    display: block;
  }

  /* ------------------------------------------------------- stats: meters */
  .levels {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--ground-2);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
  }
  .ch { display: grid; justify-items: start; gap: 0.75rem; }
  .ch-val {
    font-family: 'Pixelify Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    color: var(--red-bright);
    line-height: 1;
  }
  .meter {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
    width: 100%;
    max-width: 4rem;
  }
  .cell {
    height: 10px;
    background: var(--ground-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cell.on { background: var(--red); box-shadow: none; }
  .cell.peak { animation: peak 0.9s steps(2) infinite alternate; }
  @keyframes peak {
    from { background: var(--red); }
    to   { background: var(--ground-3); }
  }
  .ch-label {
    font-size: 0.86rem;
    color: var(--dim);
    text-wrap: pretty;
  }

  /* -------------------------------------------------- ownership: 1 panel */
  .own {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--ground-2);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .own-row {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-content: start;
    gap: 0.35rem 0.85rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
  }
  .own-row > h3, .own-row > p { grid-column: 2; }
  .own-row:nth-child(2), .own-row:nth-child(4) { border-left: 1px solid var(--line); }
  .own-row:nth-child(3), .own-row:nth-child(4) { border-top: 1px solid var(--line); }
  .own-mark { grid-row: 1; grid-column: 1; color: var(--red); align-self: center; }
  .own-mark .glyph { width: 1.35rem; height: 0.55rem; }
  .own h3 { font-size: 1.45rem; align-self: center; }
  .own p { color: var(--dim); text-wrap: pretty; }

  .fineprint {
    margin-top: 1.5rem;
    color: var(--dim-2);
    font-size: 0.95rem;
    max-width: 70ch;
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------- faq */
  .faq { margin-top: clamp(1.5rem, 3vw, 2rem); }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    font-family: 'Pixelify Sans', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline: 2px solid var(--red-bright); outline-offset: 3px; }

  .faq-mark { flex: none; color: var(--red); }
  .faq-mark .glyph { width: 1.6rem; }
  .faq-mark .zz { height: 0.8rem; }
  .faq-mark .sm { height: 0.64rem; display: none; }
  .faq details[open] .zz { display: none; }
  .faq details[open] .sm { display: block; }

  .faq p {
    padding: 0 0 1.3rem;
    color: var(--dim);
    max-width: 70ch;
    text-wrap: pretty;
  }

  /* ----------------------------------------------------------- footer */
  .foot {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line-2);
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    text-align: center;
    color: var(--dim);
    font-size: 0.95rem;
  }
  .foot a {
    color: var(--red-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 0.4rem;
  }
  .foot a:hover { color: var(--ink); }

  /* ---------------------------------------------------------- responsive */
  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: clamp(1.5rem, 4vw, 2.5rem);
    }
    .hero-copy { order: 1; }
    .hero-visual { order: 2; margin-top: 0.5rem; }
