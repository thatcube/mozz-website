  .cat-title {
    --c: 5px;
    --c2: 10px;
    font-family: 'Silkscreen', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink);
    background: var(--red);
    padding: 0.45rem 0.7rem;
  }
  .cat-badges { display: inline-flex; align-items: center; gap: 0.65rem; }
  .badge {
    --c: 4px;
    --c2: 8px;
    font-family: 'Silkscreen', sans-serif;
    font-size: 0.56rem;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.5rem;
    color: var(--dim);
    background: var(--ground-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .badge.off { color: var(--ink); }
  .cat-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 16px; }
  .cat-eq i {
    width: 3px;
