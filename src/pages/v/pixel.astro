  /* Each screenshot rides in the same flat 8-bit slab as the hero phone —
     chunky near-black bezel, thin cold rim, hard red offset shadow via .raise. */
  .tint {
    --c: 8px;
    --c2: 16px;
    margin: 0;
    padding: clamp(6px, 1.4vw, 9px);
    background: #050507;
    box-shadow: inset 0 0 0 1px #26262f;
