  }

  a.btn:hover {
    translate: -2px -2px;
    filter: drop-shadow(7px 7px 0 var(--shadow));
  }
  a.btn:active {
    translate: 3px 3px;
    filter: drop-shadow(2px 2px 0 var(--shadow));
  }

  /* clip-path would swallow an outline, so the focus ring is drawn inside. */
  .btn:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ground), inset 0 0 0 5px var(--ink);
  }

  .btn-primary {
    background: var(--red);
    color: var(--ink);
    /* deep red so the shadow reads under the bright-red fill */
    --shadow: var(--shadow-deep);
  }
  .btn-primary svg { width: 22px; height: 22px; fill: currentColor; }
  .btn-primary span { display: grid; line-height: 1.05; text-align: left; }
  .btn-primary small {
    font-family: 'Silkscreen', sans-serif;
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.82);
  }

  .btn-primary.is-pending {
    background: var(--ground-3);
    color: var(--dim);
    cursor: default;
    filter: drop-shadow(5px 5px 0 rgba(200, 0, 40, 0.3));
  }
  .btn-primary.is-pending small { color: var(--dim-2); }

  .btn-ghost {
    background: var(--ground-2);
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--line-2);
  }
  .btn-ghost:hover { background: var(--ground-3); }

  /* ----------------------------------------------------- hero visual/phone */
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 21rem;
    margin-inline: auto;
    padding: clamp(0.75rem, 2.5vw, 1.75rem);
  }
  /* Flat "device plate" the phone rests on — gives the split hero its
     product-shot depth with no image required. */
  .stage {
    --c: 10px;
    --c2: 20px;
    position: absolute;
    inset: clamp(0.25rem, 2vw, 1.25rem);
    z-index: 0;
    background: var(--ground-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .hero-phone {
    position: relative;
    z-index: 1;
    /* Dress the shared <Phone> frame as a flat 8-bit slab: a chunky near-black
       bezel, a thin cold rim, and a hard red offset shadow (0 blur) in place of
       the default soft drop — the era lives in the hardware, the screenshot
       stays crisp. Custom properties inherit into the component. */
    --phone-bezel: #050507;
    --phone-bezel-w: 0.05;
    --phone-rim: #26262f;
    --phone-shadow: 8px 8px 0 var(--red);
  }

  /* Shared step-quantised "playing" bounce, used by the on-device catalog bars. */
  @keyframes eq-level {
    from { transform: scaleY(0.18); }
    to   { transform: scaleY(1); }
  }

  /* ----------------------------------- adaptive-colour strip: real shots */
  .tints {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.9rem, 2.2vw, 1.6rem);
