---
/**
 * VARIANT — PIXEL
 * The 8-bit mark, all the way up: it is the design system, not decoration.
 * See the design contract in the HTML comment at the top of <main>.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import VariantBar from '../../components/VariantBar.astro';
import Phone from '../../components/Phone.astro';
import Shot from '../../components/Shot.astro';
import {
  NAME, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Press play on music you already own';

// Real Mozz screenshots replace the old hand-drawn phone. The hero shows the
// deep-red album page; the strip below shows the same interface recoloured by
// four other records, so the adaptive tint reads at a glance.
const TINTS = ['mozz-nowplaying', 'mozz-album-warm', 'mozz-artist', 'mozz-playlist'];

// VU-style meter fill (lit cells out of 12) that stands in for each stat.
const METER = [9, 7, 12, 11];

// On-device catalog illustration: a wall of distinct 8×8 pixel covers. Each is an
// abstract 2-tone motif drawn from the variant palette — never a real album cover.
// [base, ink] per tile, then a motif index into WALL_MOTIF.
const WALL_PALETTE: [string, string][] = [
  ['#c80028', '#f4f4f5'],
  ['#17171e', '#c80028'],
  ['#f4f4f5', '#c80028'],
  ['#1f1f28', '#f4f4f5'],
  ['#8f0018', '#f4f4f5'],
  ['#101014', '#e5a00d'],
];
// Each motif is a list of [x,y,w,h] accent blocks laid on an 8×8 field.
const WALL_MOTIF: [number, number, number, number][][] = [
  [[1, 1, 3, 3], [4, 4, 3, 3]],
  [[0, 0, 8, 3], [0, 6, 8, 1]],
  [[2, 0, 4, 8]],
  [[1, 1, 6, 6], [3, 3, 2, 2]],
  [[0, 2, 8, 1], [0, 4, 8, 1], [0, 6, 8, 1]],
  [[0, 5, 1, 3], [1, 3, 1, 5], [2, 4, 1, 4], [3, 2, 1, 6], [4, 4, 1, 4], [5, 1, 1, 7], [6, 3, 1, 5], [7, 5, 1, 3]],
  [[0, 0, 4, 4], [4, 4, 4, 4]],
  [[3, 0, 2, 8], [0, 3, 8, 2]],
];
// Twelve covers: cycle motif and palette so no two neighbours match. Flags mark a
// few as downloaded-for-offline; one tile is the "now playing" record.
const WALL = Array.from({ length: 12 }, (_, i) => ({
  motif: WALL_MOTIF[i % WALL_MOTIF.length],
  pal: WALL_PALETTE[(i * 5) % WALL_PALETTE.length],
  down: [0, 2, 3, 5, 6, 8, 9, 11].includes(i),
  playing: i === 4,
}));
---

<Layout
  title={`${NAME} — press play on music you already own`}
  description="A free, open source music app for Plex, Jellyfin and Navidrome. Your library, your server, your files. No account, no tracking, no subscription."
  themeColor="#101014"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Silkscreen:wght@400;700&family=Archivo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="px">
    <!--
    THESIS: The mark is the whole system, not a logo dropped on a page. Every
    shape is drawn from the 8-bit face — stepped corners, hard red offset
    shadows, an 8px grid, and the ZZ eyes and smile reused as marks. A boot
    screen for a library you already own.
    OWN-WORLD: Near-black #101014, off-white #f4f4f5, one brand red. Zero
    gradients, zero radius, zero blur: flat fills and solid offset shadows only.
    Pixelify Sans and Silkscreen display over Archivo body.
    STORY: Point Mozz at your server, press play, and it is yours — no account,
    no tracking, no rent.
    FIRST VIEWPORT: Split hero — headline, lede and actions left; a real Mozz
    screenshot in an 8-bit slab phone frame right, on a flat plate over the grid.
    FORM: Fifth of seven; the arcade / boot-screen framing is native to a
    pixel-art mark rather than a costume borrowed from outside the product.
  -->

  <VariantBar slug="pixel" tone="neutral" />

    <svg class="grid-bg" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
      <defs>
        <pattern id="px-minor" width="8" height="8" patternUnits="userSpaceOnUse">
          <path d="M8 0H0V8" fill="none" stroke="rgba(244,244,245,0.035)" stroke-width="1" />
        </pattern>
        <pattern id="px-major" width="64" height="64" patternUnits="userSpaceOnUse">
          <rect width="64" height="64" fill="url(#px-minor)" />
          <path d="M64 0H0V64" fill="none" stroke="rgba(244,244,245,0.07)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#px-major)" />
    </svg>

    <!-- ============================ HEADER ========================== -->
    <div class="site-head">
      <a class="wordmark" href={GITHUB_URL} aria-label={`${NAME} on GitHub`}>
        <Mark size={28} decorative />
        <span>{NAME}</span>
      </a>
      <a class="src-tag" href={GITHUB_URL}>
        <span>GPL-3.0</span>
        <span class="src-sep" aria-hidden="true"></span>
        <span>OPEN SOURCE</span>
      </a>
    </div>

    <!-- ============================ HERO ============================ -->
    <!-- HERO ART PLATE: drop AI-generated artwork at /public/hero/pixel.jpg and
         it fills the hero behind this content via --hero-plate. With no file
         present the layer is simply empty and the flat CSS pixel mosaic below
         shows through — never a broken-image box or a grey rectangle. -->
    <header class="hero">
      <svg class="hero-art" aria-hidden="true" viewBox="0 0 160 120" preserveAspectRatio="xMidYMax slice" shape-rendering="crispEdges">
        <g fill="#c80028" opacity="0.09">
          <rect x="8" y="14" width="8" height="8" /><rect x="28" y="6" width="8" height="8" />
          <rect x="132" y="20" width="8" height="8" /><rect x="150" y="10" width="8" height="8" />
          <rect x="120" y="34" width="8" height="8" /><rect x="16" y="34" width="8" height="8" />
        </g>
        <g fill="#f4f4f5" opacity="0.05">
          <rect x="20" y="22" width="8" height="8" /><rect x="140" y="30" width="8" height="8" />
          <rect x="108" y="14" width="8" height="8" /><rect x="4" y="46" width="8" height="8" />
        </g>
        <g fill="#c80028" opacity="0.11">
          <rect x="0" y="104" width="8" height="16" /><rect x="10" y="92" width="8" height="28" />
          <rect x="20" y="100" width="8" height="20" /><rect x="30" y="84" width="8" height="36" />
          <rect x="40" y="96" width="8" height="24" /><rect x="50" y="76" width="8" height="44" />
          <rect x="60" y="88" width="8" height="32" /><rect x="70" y="100" width="8" height="20" />
          <rect x="80" y="80" width="8" height="40" /><rect x="90" y="94" width="8" height="26" />
          <rect x="100" y="86" width="8" height="34" /><rect x="110" y="98" width="8" height="22" />
          <rect x="120" y="82" width="8" height="38" /><rect x="130" y="92" width="8" height="28" />
          <rect x="140" y="100" width="8" height="20" /><rect x="150" y="88" width="8" height="32" />
        </g>
      </svg>
      <div class="hero-plate" aria-hidden="true"></div>

      <div class="hero-copy">
        <h1>{HEADLINE}</h1>
        <p class="lede">
          Mozz plays what is already on your own Plex, Jellyfin or Navidrome
          server. No account to make, nothing to subscribe to, nothing watching
          what you listen to.
        </p>

        <div class="actions">
          {APP_STORE_URL ? (
            <a class="btn btn-primary pix" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>DOWNLOAD ON THE</small>App Store</span>
            </a>
          ) : (
            <span class="btn btn-primary pix is-pending" role="note" aria-label="Coming to the App Store">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>COMING TO THE</small>App Store</span>
            </span>
          )}
          <a class="btn btn-ghost pix" href={GITHUB_URL}>Read the source</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="stage pix" aria-hidden="true"></div>
        <div class="hero-phone">
          <Phone name="mozz-album-red" width={244} priority sizes="220px" />
        </div>
      </div>
    </header>

    <!-- ====================== ADAPTIVE COLOUR ====================== -->
    <section class="band" aria-labelledby="px-tint">
      <div class="wrap">
        <h2 id="px-tint"><span class="h-mark smile"></span>It takes the colour of the record</h2>
        <p class="band-sub">
          Mozz recolours its whole interface to match the artwork of whatever is
          playing — the same app, a different palette for every record.
        </p>

        <div class="tints">
          {TINTS.map((name) => (
            <figure class="tint pix raise">
              <span class="tint-screen"><Shot name={name} sizes="(max-width: 60rem) 46vw, 240px" /></span>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================== SERVERS ========================== -->
    <section class="band" aria-labelledby="px-servers">
      <div class="wrap">
        <h2 id="px-servers"><span class="h-mark smile"></span>Point it at your server</h2>
        <p class="band-sub">
          Mozz is the player. Your server is the library. Sign in once and every
          record you already keep is right there to play.
        </p>

        <div class="bay pix raise">
          {SERVERS.map((s, i) => (
            <div class={`slot ${i > 0 ? 'ruled' : ''}`}>
              <span class="slot-logo pix" aria-hidden="true"><ServerLogo name={s.name} size={30} brand /></span>
              <span class="slot-name">{s.name}</span>
              <p class="slot-note">{s.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================= FEATURES ========================== -->
    <section class="band" aria-labelledby="px-features">
      <div class="wrap">
        <h2 id="px-features"><span class="h-mark smile"></span>Everything, in the free app</h2>
        <p class="band-sub">There is no paid tier holding a feature hostage — because there is no other kind.</p>

        <ul class="feat" role="list">
          {FEATURES.map((f) => (
            <li>
              <span class="feat-bullet" aria-hidden="true">
                <svg viewBox="11 11 10 11" class="glyph" shape-rendering="crispEdges"><path d="M15 13H14V14H13V15H15V16H11V14H12V13H13V12H11V11H15V13Z M21 13H20V14H19V15H21V16H17V14H18V13H19V12H17V11H21V13Z M12 19H13V20H19V19H20V18H21V20H20V21H19V22H13V21H12V20H11V18H12V19Z" fill="currentColor"/></svg>
              </span>
              <div class="feat-text">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ====================== ON-DEVICE CATALOG ===================== -->
    <section class="band illo" aria-labelledby="px-catalog">
      <div class="wrap">
        <h2 id="px-catalog"><span class="h-mark smile"></span>Your whole library, on the device</h2>
        <p class="band-sub">
          Downloads are part of the design, not a bolt-on. Pull records onto the
          device and the catalog plays the same on a plane as it does at home.
        </p>

        <!-- Illustration: the library screen, rendered as a framed device panel. -->
        <div class="catalog pix raise" role="img" aria-label="Illustration of the Mozz library screen: a wall of downloaded albums, playing offline.">
          <div class="catalog-bar">
            <span class="cat-title pix">YOUR LIBRARY</span>
            <span class="cat-badges">
              <span class="badge pix off">OFFLINE</span>
              <span class="cat-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            </span>
          </div>
          <div class="wall">
            {WALL.map((t) => (
              <div class={`cvr pix${t.playing ? ' playing' : ''}`}>
                <svg viewBox="0 0 8 8" shape-rendering="crispEdges" preserveAspectRatio="none">
                  <rect width="8" height="8" fill={t.pal[0]} />
                  {t.motif.map(([x, y, w, h]) => (
                    <rect x={x} y={y} width={w} height={h} fill={t.pal[1]} />
                  ))}
                </svg>
                {t.down && !t.playing && (
                  <span class="cv-flag dl" aria-hidden="true">
                    <svg viewBox="0 0 8 8" shape-rendering="crispEdges"><path d="M3 0H5V3H7L4 7L1 3H3V0Z" fill="currentColor"/></svg>
                  </span>
                )}
                {t.playing && (
                  <span class="cv-flag np" aria-hidden="true"><i></i><i></i><i></i></span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- =========================== STATS =========================== -->
    <section class="band" aria-labelledby="px-stats">
      <div class="wrap">
        <h2 id="px-stats"><span class="h-mark smile"></span>Fast is a feature you can feel</h2>
        <p class="band-sub">Measured on device, not in a press release. It does not get slower as the library gets bigger.</p>

        <div class="levels pix raise">
          {STATS.map((s, i) => (
            <div class="ch">
              <span class="ch-val">{s.value}</span>
              <div class="meter" aria-hidden="true">
                {Array.from({ length: 12 }).map((_, c) => (
                  <span class={`cell${c < METER[i] ? ' on' : ''}${c === METER[i] - 1 ? ' peak' : ''}`}></span>
                ))}
              </div>
              <span class="ch-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================= OWNERSHIP ========================= -->
    <section class="band" aria-labelledby="px-own">
      <div class="wrap">
        <h2 id="px-own"><span class="h-mark smile"></span>It's actually yours</h2>
        <p class="band-sub">The whole point of the app: this one is really yours, on hardware you control.</p>

        <!-- Illustration: the whole signal path, and what isn't in it. -->
        <div class="chain pix raise" role="img" aria-label="Diagram of the signal path: your server sends music straight to your phone and your headphones. A cloud in the middle is crossed out — nothing else sits between you and your files.">
          <svg class="chain-svg" viewBox="0 0 680 214" shape-rendering="crispEdges" aria-hidden="true">
            <!-- SERVER -->
            <g>
              <rect x="44" y="54" width="96" height="120" fill="#c80028" />
              <rect x="36" y="46" width="96" height="120" fill="#17171e" />
              <rect x="36" y="46" width="96" height="120" fill="none" stroke="#3a3a46" stroke-width="2" />
              <rect x="36" y="46" width="96" height="14" fill="#1f1f28" />
              <rect x="120" y="50" width="6" height="6" fill="#c80028" />
              <rect x="48" y="70" width="72" height="16" fill="#101014" stroke="#2a2a34" stroke-width="1" />
              <rect x="52" y="74" width="8" height="8" fill="#3a3a46" />
              <rect x="108" y="75" width="8" height="6" fill="#c80028" />
              <rect x="48" y="92" width="72" height="16" fill="#101014" stroke="#2a2a34" stroke-width="1" />
              <rect x="52" y="96" width="8" height="8" fill="#3a3a46" />
              <rect x="108" y="97" width="8" height="6" fill="#f4f4f5" />
              <rect x="48" y="114" width="72" height="16" fill="#101014" stroke="#2a2a34" stroke-width="1" />
              <rect x="52" y="118" width="8" height="8" fill="#3a3a46" />
              <rect x="108" y="119" width="8" height="6" fill="#c80028" />
              <rect x="48" y="136" width="72" height="16" fill="#101014" stroke="#2a2a34" stroke-width="1" />
              <rect x="52" y="140" width="8" height="8" fill="#3a3a46" />
              <rect x="108" y="141" width="8" height="6" fill="#c80028" />
              <text x="84" y="192" text-anchor="middle" class="chain-cap">YOUR SERVER</text>
            </g>
            <!-- ARROW 1 -->
            <g fill="#c80028">
              <rect x="146" y="112" width="12" height="12" />
              <rect x="166" y="112" width="12" height="12" />
              <rect x="186" y="112" width="12" height="12" />
              <rect x="206" y="112" width="12" height="12" />
              <rect x="226" y="112" width="12" height="12" />
              <rect x="246" y="112" width="12" height="12" />
              <rect x="266" y="112" width="12" height="12" />
              <rect x="286" y="112" width="12" height="12" />
              <path d="M300 104 L322 118 L300 132 Z" />
            </g>
            <!-- CROSSED CLOUD -->
            <g>
              <rect x="210" y="72" width="78" height="12" fill="#2a2a34" />
              <rect x="218" y="62" width="62" height="12" fill="#2a2a34" />
              <rect x="230" y="54" width="14" height="10" fill="#2a2a34" />
              <rect x="248" y="50" width="16" height="14" fill="#2a2a34" />
              <rect x="266" y="56" width="12" height="8" fill="#2a2a34" />
              <path d="M214 48 L286 86" stroke="#c80028" stroke-width="8" />
              <path d="M286 48 L214 86" stroke="#c80028" stroke-width="8" />
              <text x="249" y="104" text-anchor="middle" class="chain-cap no">NO CLOUD</text>
            </g>
            <!-- PHONE -->
            <g>
              <rect x="346" y="74" width="72" height="122" fill="#c80028" />
              <rect x="338" y="66" width="72" height="122" fill="#1f1f28" />
              <rect x="338" y="66" width="72" height="122" fill="none" stroke="#3a3a46" stroke-width="2" />
              <rect x="348" y="82" width="52" height="88" fill="#101014" />
              <rect x="362" y="70" width="24" height="5" fill="#0c0c10" />
              <path d="M366 108 L366 140 L392 124 Z" fill="#c80028" />
              <g fill="#3a3a46">
                <rect x="352" y="150" width="4" height="10" />
                <rect x="358" y="146" width="4" height="14" />
                <rect x="364" y="152" width="4" height="8" />
                <rect x="370" y="144" width="4" height="16" />
                <rect x="376" y="150" width="4" height="10" />
                <rect x="382" y="148" width="4" height="12" />
                <rect x="388" y="152" width="4" height="8" />
                <rect x="394" y="150" width="4" height="10" />
              </g>
              <rect x="360" y="180" width="28" height="3" fill="#3a3a46" />
              <text x="374" y="206" text-anchor="middle" class="chain-cap">YOUR PHONE</text>
            </g>
            <!-- ARROW 2 -->
            <g fill="#c80028">
              <rect x="424" y="112" width="12" height="12" />
              <rect x="444" y="112" width="12" height="12" />
              <rect x="464" y="112" width="12" height="12" />
              <rect x="484" y="112" width="12" height="12" />
              <path d="M492 104 L514 118 L492 132 Z" />
            </g>
            <!-- HEADPHONES -->
            <g>
              <rect x="516" y="70" width="108" height="12" fill="#3a3a46" />
              <rect x="516" y="80" width="12" height="26" fill="#3a3a46" />
              <rect x="612" y="80" width="12" height="26" fill="#3a3a46" />
              <rect x="514" y="112" width="30" height="56" fill="#c80028" />
              <rect x="506" y="104" width="30" height="56" fill="#1f1f28" />
              <rect x="506" y="104" width="30" height="56" fill="none" stroke="#3a3a46" stroke-width="2" />
              <rect x="512" y="110" width="18" height="44" fill="#2a2a34" />
              <rect x="519" y="126" width="4" height="12" fill="#8e8e9c" />
              <rect x="606" y="112" width="30" height="56" fill="#c80028" />
              <rect x="598" y="104" width="30" height="56" fill="#1f1f28" />
              <rect x="598" y="104" width="30" height="56" fill="none" stroke="#3a3a46" stroke-width="2" />
              <rect x="604" y="110" width="18" height="44" fill="#2a2a34" />
              <rect x="611" y="126" width="4" height="12" fill="#8e8e9c" />
              <text x="571" y="206" text-anchor="middle" class="chain-cap">YOUR EARS</text>
            </g>
          </svg>
        </div>

        <div class="own pix raise">
          {OWNERSHIP.map((o) => (
            <div class="own-row">
              <span class="own-mark" aria-hidden="true">
                <svg viewBox="11 18 10 4" class="glyph" shape-rendering="crispEdges"><path d="M12 19H13V20H19V19H20V18H21V20H20V21H19V22H13V21H12V20H11V18H12V19Z" fill="currentColor"/></svg>
              </span>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </div>
          ))}
        </div>

        <p class="fineprint">
          The one honest caveat: recommendations ask MusicBrainz and ListenBrainz
          what sounds similar to an artist and title. That request carries no
          name, no server address, no account — and you can switch it off in
          Settings.
        </p>
      </div>
    </section>

    <!-- ============================ FAQ ============================ -->
    <section class="band" aria-labelledby="px-faq">
      <div class="wrap wrap-narrow">
        <h2 id="px-faq"><span class="h-mark smile"></span>Questions, answered</h2>
        <div class="faq">
          {FAQS.map((f) => (
            <details>
              <summary>
                <span class="q">{f.q}</span>
                <span class="faq-mark" aria-hidden="true">
                  <svg viewBox="11 11 10 5" class="glyph zz" shape-rendering="crispEdges"><path d="M15 13H14V14H13V15H15V16H11V14H12V13H13V12H11V11H15V13Z M21 13H20V14H19V15H21V16H17V14H18V13H19V12H17V11H21V13Z" fill="currentColor"/></svg>
                  <svg viewBox="11 18 10 4" class="glyph sm" shape-rendering="crispEdges"><path d="M12 19H13V20H19V19H20V18H21V20H20V21H19V22H13V21H12V20H11V18H12V19Z" fill="currentColor"/></svg>
                </span>
