  }
  .cv-flag.dl {
    width: 15px;
    height: 15px;
    padding: 2px;
    color: var(--ink);
    background: var(--ground);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .cv-flag.dl svg { width: 100%; height: 100%; }
  .cv-flag.np {
    left: 4px;
    right: auto;
    top: 4px;
    bottom: auto;
    gap: 2px;
    align-items: flex-end;
    height: 12px;
    padding: 2px 3px;
    background: var(--ground);
    box-shadow: inset 0 0 0 1px var(--line-2);
