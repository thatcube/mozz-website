<script is:inline>
  (() => {
    const root = document.querySelector('[data-tuner-page]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const links = Array.from(root.querySelectorAll('[data-station-link]'));
    const sections = Array.from(root.querySelectorAll('[data-station]'));
    let ticking = false;

    const updateNeedle = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / max));
      root.style.setProperty('--tune-progress', progress.toFixed(4));
      ticking = false;
    };

    const requestNeedle = () => {
      if (reduce) {
        updateNeedle();
        return;
      }
      if (!ticking) {
        window.requestAnimationFrame(updateNeedle);
        ticking = true;
      }
    };

    updateNeedle();
    window.addEventListener('scroll', requestNeedle, { passive: true });
    window.addEventListener('resize', requestNeedle);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const station = entry.target.getAttribute('data-station');
          links.forEach((link) => link.classList.toggle('is-current', link.getAttribute('data-station-link') === station));
        });
      }, { rootMargin: '-42% 0px -50% 0px', threshold: 0.01 });
      sections.forEach((section) => observer.observe(section));
    }
  })();
</script>
