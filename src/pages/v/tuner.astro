---
/**
 * VARIANT — TUNER
 *
 * The page is a warm analogue tuning dial: your own servers are the stations and
 * the red needle follows the reader through them. Every section is laid out like
 * a calibrated instrument face, with mono frequencies and engraved tick marks.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, STATS, FAQS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Tune it to your own server.';
const HERO_LINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT = 'Stream at home from the server you already run, then download records for the places with no signal at all.';

const STATIONS = [
  { id: 'sources', label: 'SOURCES', short: 'SRC', x: 0, freq: '88.1' },
  { id: 'stream', label: 'STREAM', short: 'STR', x: 20, freq: '91.4' },
  { id: 'offline', label: 'OFFLINE', short: 'OFF', x: 40, freq: '95.9' },
  { id: 'app', label: 'APP', short: 'APP', x: 60, freq: '100.7' },
  { id: 'free', label: 'FREE', short: 'GPL', x: 80, freq: '104.8' },
  { id: 'asked', label: 'ASKED', short: 'FAQ', x: 100, freq: '108.0' },
];

const SOURCE_FREQS = ['88.1', '91.9', '96.3'];
const TICKS = Array.from({ length: 61 }, (_, i) => ({ x: (i / 60) * 100, major: i % 10 === 0, mid: i % 5 === 0 }));
const KNURLS = Array.from({ length: 48 }, (_, i) => i * 7.5);
const STREAM_PAIR = [
  {
    id: 'stream',
    eyebrow: '02 STREAM',
    title: 'Home signal, full strength.',
    body: 'Point Mozz at the server on your own network and it behaves like the receiver was built into the house. The phone is only the front panel; the library stays where you keep it.',
    badge: 'playing from your server',
    signal: 'strong',
    meter: 'SIGNAL 5/5',
    side: 'left',
  },
  {
    id: 'offline',
    eyebrow: '03 OFFLINE',
    title: 'No signal, same record.',
    body: 'Download the album before you leave and the shape does not change. The signal meter drops to zero while the music meter stays pinned, because offline is the same promise with the aerial unplugged.',
    badge: 'downloaded · plays offline',
    signal: 'zero',
    meter: 'SIGNAL 0/5',
    side: 'right',
  },
];

const meterAngles = ['-42', '-26', '10', '36'];
---

<Layout
  title={`${NAME} — tune it to your own server`}
  description="A free player for the music on your own Plex, Jellyfin or Navidrome server. Stream at home, download for offline, and keep your library yours."
  themeColor="#f4f2ec"
  noindex
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <main class="tuner" data-tuner-page>
    <VariantBar slug="tuner" tone="cool" />

    <nav class="tune-scale" aria-label="Tuning scale">
      <div class="scale-shell">
        <div class="scale-rule" aria-hidden="true">
          {TICKS.map((tick) => (
            <span class={tick.major ? 'tick major' : tick.mid ? 'tick mid' : 'tick'} style={`--x:${tick.x}%`}></span>
          ))}
          <span class="needle" aria-hidden="true"></span>
        </div>
        <ol class="station-nav" role="list">
          {STATIONS.map((station, i) => (
            <li style={`--x:${station.x}%`}>
              <a class={i === 0 ? 'station-link is-current' : 'station-link'} href={`#tuner-${station.id}`} data-station-link={station.id}>
                <span class="long">{station.label}</span>
                <span class="short">{station.short}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <header class="hero section-station" id="tuner-top" data-station="sources">
      <div class="hero-top wrap">
        <a class="lockup" href="/" aria-label="Mozz home">
          <Mark size={30} decorative />
          <span>{NAME}</span>
        </a>
        <p class="top-readout">FM 88–108 · OWNED LIBRARY BAND</p>
      </div>

      <div class="hero-copy wrap">
        <p class="kicker">Analogue receiver for self-hosted music</p>
        <h1>{HEADLINE}</h1>
        <p class="hero-line">{HERO_LINE}</p>
        <p class="support">{SUPPORT}</p>
        <div class="actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <figure class="dial-face wrap" aria-label="A warm receiver dial tuned to sources">
        <div class="dial-plate">
          <div class="dial-row frequencies" aria-hidden="true">
            {STATIONS.map((station) => (
              <span style={`--x:${station.x}%`}>{station.freq}</span>
            ))}
          </div>
          <div class="dial-track" aria-hidden="true">
            {TICKS.map((tick) => (
              <span class={tick.major ? 'hero-tick major' : tick.mid ? 'hero-tick mid' : 'hero-tick'} style={`--x:${tick.x}%`}></span>
            ))}
            <span class="hero-needle"></span>
          </div>
          <div class="dial-row station-row" aria-hidden="true">
            {STATIONS.map((station) => (
              <span style={`--x:${station.x}%`}>{station.label}</span>
            ))}
          </div>
          <svg class="knob-art" viewBox="0 0 180 180" role="img" aria-label="A drawn tuning knob with many small radial knurls">
            <circle cx="90" cy="90" r="76" fill="none" stroke="#191817" stroke-width="1.5" opacity="0.35" />
            <circle cx="90" cy="90" r="62" fill="none" stroke="#191817" stroke-width="1" opacity="0.35" />
            <circle cx="90" cy="90" r="36" fill="#e7e3d8" stroke="#191817" stroke-width="1.5" />
            {KNURLS.map((angle) => (
              <line x1="90" y1="12" x2="90" y2="23" transform={`rotate(${angle} 90 90)`} stroke="#191817" stroke-width="1.4" opacity="0.56" />
            ))}
            <line x1="90" y1="48" x2="90" y2="64" stroke="#c80028" stroke-width="3" stroke-linecap="round" />
          </svg>
          <div class="signal-meter" aria-hidden="true">
            <span class="meter-label">SIGNAL</span>
            <span class="meter-arc"><i></i></span>
            <span class="meter-bars"><b></b><b></b><b></b><b></b><b></b></span>
          </div>
        </div>
      </figure>
    </header>

    <section class="station-section sources section-station" id="tuner-sources" data-station="sources" aria-labelledby="tuner-sources-title">
      <div class="wrap">
        <div class="section-head">
          <p class="station-kicker">01 SOURCES · preset bank</p>
          <h2 id="tuner-sources-title">Your servers are the stations.</h2>
          <p>Point Mozz at the Plex, Jellyfin or Navidrome library you already run. Each preset lands on the same owned collection, just through a different door.</p>
        </div>
        <div class="preset-bank">
          {SERVERS.map((server, i) => (
            <article class="preset-row">
              <div class="preset-button" aria-hidden="true">
                <span>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="preset-logo"><ServerLogo name={server.name} size={44} /></div>
              <div class="preset-copy">
                <h3>{server.name}</h3>
                <p>{server.note}</p>
              </div>
              <div class="preset-frequency">
                <span>{SOURCE_FREQS[i]}</span>
                <small>MHz</small>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {STREAM_PAIR.map((mode) => (
      <section class={`listen-mode ${mode.side} section-station`} id={`tuner-${mode.id}`} data-station={mode.id} aria-labelledby={`tuner-${mode.id}-title`}>
        <div class="wrap listen-grid">
          <div class="listen-copy">
            <p class="station-kicker">{mode.eyebrow}</p>
            <h2 id={`tuner-${mode.id}-title`}>{mode.title}</h2>
            <p>{mode.body}</p>
            <div class={`analog-meter ${mode.signal}`} aria-label={mode.meter}>
              <span>{mode.meter}</span>
              <div class="meter-lines" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div>
            </div>
          </div>
          <div class="phone-stage">
            <div class="phone" style="--pw:clamp(216px, 23vw, 316px)" role="img" aria-label={`An iPhone in Mozz with badge ${mode.badge}`}>
              <span class="phone-key key-one"></span>
              <span class="phone-key key-two"></span>
              <div class="phone-screen">
                <div class="island"></div>
                <div class="status"><span>9:41</span><span>LTE</span></div>
                <div class="screen-head"><span>{mode.badge}</span><Mark size={18} decorative /></div>
                <svg class="album-art" viewBox="0 0 220 220" aria-hidden="true">
                  <rect x="0" y="0" width="220" height="220" fill="#f4f2ec" />
                  <circle cx="110" cy="110" r="88" fill="#191817" />
                  <circle cx="110" cy="110" r="44" fill="#f4f2ec" />
                  <path d="M24 150 C70 88 142 186 196 78" fill="none" stroke="#c80028" stroke-width="18" stroke-linecap="round" />
                  <path d="M42 54 H180" stroke="#c80028" stroke-width="8" stroke-linecap="round" />
                  <circle cx="110" cy="110" r="12" fill="#c80028" />
                </svg>
                <div class="track">
                  <strong>Owned Frequency</strong>
                  <span>Local Library Ensemble</span>
                </div>
                <div class="scrub"><i></i></div>
                <div class="time"><span>1:24</span><span>-3:11</span></div>
                <div class="transport" aria-hidden="true"><span>‹‹</span><b>▶</b><span>››</span></div>
                <div class="level-stack">
                  <span>music</span><i class="full"></i>
                  <span>signal</span><i class={mode.signal === 'zero' ? 'empty' : 'full'}></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="station-section app section-station" id="tuner-app" data-station="app" aria-labelledby="tuner-app-title">
      <div class="wrap">
        <div class="section-head wide">
          <p class="station-kicker">04 APP · controls and readouts</p>
          <h2 id="tuner-app-title">Every useful switch is on the front panel.</h2>
          <p>The app experience is laid out like a bank of controls: each capability has a key, a state, and a plain label. No locked bank, no hidden paid mode.</p>
        </div>
        <div class="control-bank">
          {FEATURES.map((feature, i) => (
            <article class="control-row">
              <span class="control-key">CH {String(i + 1).padStart(2, '0')}</span>
              <span class="toggle-light" aria-hidden="true"></span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="instrument-faces" aria-label="Measured Mozz readouts">
          {STATS.map((stat, i) => (
            <article class="face">
              <svg viewBox="0 0 180 112" aria-hidden="true">
                <path d="M28 92 A62 62 0 0 1 152 92" fill="none" stroke="#a9a396" stroke-width="1.5" />
                {Array.from({ length: 11 }, (_, n) => (
                  <line x1="90" y1="30" x2="90" y2="42" transform={`rotate(${-70 + n * 14} 90 92)`} stroke="#191817" stroke-width={n % 5 === 0 ? '2' : '1'} opacity="0.5" />
                ))}
                <line x1="90" y1="92" x2="90" y2="42" transform={`rotate(${meterAngles[i]} 90 92)`} stroke="#c80028" stroke-width="3" stroke-linecap="round" />
                <circle cx="90" cy="92" r="6" fill="#191817" />
              </svg>
              <span class="face-value">{stat.value}</span>
              <p>{stat.label}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="station-section free section-station" id="tuner-free" data-station="free" aria-labelledby="tuner-free-title">
      <div class="wrap free-grid">
        <div class="section-head">
          <p class="station-kicker">05 FREE · engraved ownership plate</p>
          <h2 id="tuner-free-title">The signal does not pass through Mozz.</h2>
          <p>There is no account to tune, no subscription to renew, and no tracking carrier wave under the music. The license is GPL-3.0, plainly.</p>
        </div>
        <div class="ownership-plates">
          {OWNERSHIP.map((item) => (
            <article class="ownership-plate">
              <span class="indicator" aria-hidden="true"></span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="station-section asked section-station" id="tuner-asked" data-station="asked" aria-labelledby="tuner-asked-title">
      <div class="wrap manual">
        <div class="section-head">
          <p class="station-kicker">06 ASKED · service manual</p>
          <h2 id="tuner-asked-title">Questions from the bench.</h2>
        </div>
        <div class="qa-list">
          {FAQS.map((faq, i) => (
            <details>
              <summary><span>Q{String(i + 1).padStart(2, '0')}</span>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <footer class="finale section-station" id="tuner-finale" data-station="asked">
      <div class="wrap finale-grid">
        <div>
          <a class="lockup foot-lockup" href="/" aria-label="Mozz home">
            <Mark size={34} decorative />
            <span>{NAME}</span>
          </a>
          <h2>{TAGLINE}</h2>
          <p class="subline">{SUBLINE}</p>
          <p class="fine">MetaBrainz note: {FAQS[3].a}</p>
        </div>
        <div class="footer-tune" aria-hidden="true">
          <span class="end-needle"></span>
          <span>108.0</span>
          <b>ASKED</b>
        </div>
        <div class="actions footer-actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  :global(html) {
    background: #f4f2ec;
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f4f2ec;
    color: #191817;
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .tuner {
    --cream: #f4f2ec;
    --plate: #e7e3d8;
    --ink: #191817;
    --red: #c80028;
    --engraved: #a9a396;
    --line: rgba(25, 24, 23, 0.18);
    --tune-progress: 0;
    position: relative;
    min-height: 100vh;
    overflow-x: clip;
    background:
      repeating-linear-gradient(90deg, rgba(25,24,23,0.025) 0 1px, transparent 1px 9px),
      var(--cream);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.58;
  }

  .wrap {
    width: min(1180px, 100% - 2.5rem);
    margin-inline: auto;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    color: inherit;
    text-decoration: none;
  }
  .lockup span {
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: -0.03em;
  }
  .station-kicker, .top-readout, .preset-frequency, .control-key, .face-value, .fine, .station-link, .meter-label, .analog-meter, .footer-tune, summary span { font-family: 'DM Mono', ui-monospace, monospace; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 {
    letter-spacing: -0.045em;
    line-height: 0.94;
  }
  a:focus-visible, summary:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  .tune-scale {
    position: sticky;
    top: 42px;
    z-index: 90;
    height: 54px;
    display: grid;
    align-items: center;
    background: rgba(244, 242, 236, 0.97);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 1px 0 rgba(255,255,255,0.65) inset;
  }

  .scale-shell {
    position: relative;
    width: min(980px, 100% - 2rem);
    height: 36px;
    margin-inline: auto;
  }
  .scale-rule {
    position: absolute;
    inset: 2px 0 14px;
    border-bottom: 1px solid var(--engraved);
  }
  .tick {
    position: absolute;
    bottom: 0;
    left: var(--x);
    width: 1px;
    height: 8px;
    background: var(--engraved);
    transform: translateX(-50%);
  }
  .tick.mid { height: 13px; }
  .tick.major {
    height: 20px;
    background: var(--ink);
    opacity: 0.5;
  }
  .needle {
    position: absolute;
    left: calc(var(--tune-progress) * 100%);
    top: -2px;
    bottom: -12px;
    width: 2px;
    background: var(--red);
    transform: translateX(-1px);
    transition: left 160ms ease-out;
  }
  .needle::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    transform: translateX(-50%);
  }
  .station-nav {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .station-nav li {
    position: absolute;
    left: var(--x);
    bottom: -2px;
    transform: translateX(-50%);
  }
  .station-link {
    color: rgba(25,24,23,0.62);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
  }
  .station-link.is-current {
    color: var(--red);
    font-weight: 500;
  }
  .station-link .short { display: none; }

  .section-station { scroll-margin-top: 132px; }
  .hero {
    min-height: calc(100svh - 42px);
    padding: 1.1rem 0 4rem;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: clamp(1.2rem, 3vw, 2rem);
  }
  .top-readout {
    color: var(--engraved);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .hero-copy { padding-top: clamp(2rem, 4.8vw, 4.8rem); }
  .kicker {
    color: var(--red);
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 16ch;
    margin-top: 0.42rem;
    font-size: clamp(3.6rem, 9vw, 8.2rem);
    line-height: 0.86;
  }
  .hero-line {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: clamp(1.2rem, 1.75vw, 1.7rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .support {
    margin-top: 0.65rem;
    max-width: 58ch;
    color: rgba(25,24,23,0.72);
    font-size: clamp(0.98rem, 1.15vw, 1.1rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
    margin-top: 1.25rem;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 48px;
    padding: 0.68rem 1.05rem;
    border: 1px solid var(--ink);
    color: var(--cream);
