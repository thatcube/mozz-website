---
/**
 * VARIANT — COVER SITE
 *
 * A direct extension of the hero study at /h/cover, not a new idea.
 *
 * The hero is kept exactly as it was composed: the copy centred at the top of
 * a black frame, MOZZ printed enormous in red behind everything, the phone
 * tilted eleven degrees in front of it, a halo ring around the whole thing and
 * two small sparks off to the sides.
 *
 * The page then carries on in that art department's language — square sleeves,
 * catalogue numbers, halo rings, hard red on black — without ever reprinting
 * the wordmark again. The enormous type is a hero gesture; it appears once at
 * the top and once at the very bottom, and every section in between holds its
 * own attention with structure, a chapter mark and a drawing that means
 * something for that section.
 *
 * No photography: every sleeve on this page is generated below as SVG.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  DONATE_URL,
  APP_STORE_URL,
} from '../../data/site';

/* The only hardcoded copy on the page. */
const HEADLINE = 'Mozz is a free player for the music on your server.';
const SUMMARY = 'Stream your library at home or download albums and listen with no signal.';
const META =
  'Mozz is a free, open source player for the music on your Plex, Jellyfin or Navidrome server. Stream it at home, or download an album and play it offline.';

const PARITY = [FEATURES[0], FEATURES[1]];
const WEEKLY = FEATURES[5];
const ALOUD = FEATURES[7];
const REST = [FEATURES[2], FEATURES[3], FEATURES[4], FEATURES[6]];

/* ------------------------------------------------------------------ sleeves */

/**
 * Invented sleeves, drawn in the hero album's own vocabulary — a flat ground,
 * a disc, an arch, a set of skewed steps, a rule cutting across. Nothing here
 * borrows a real record, and the set is deterministic so a rebuild never
 * reshuffles the wall.
 */
const BLACK = '#0a070d';
const NEAR = '#191320';
const PAPER = '#fdf6ec';
const SOFT = '#eeeae2';
const RED = '#d8002d';
const DEEP = '#7d0019';

type Trio = [string, string, string];

const GROUNDS: Trio[] = [
  [RED, PAPER, BLACK],
  [BLACK, RED, SOFT],
  [SOFT, BLACK, RED],
  [DEEP, PAPER, RED],
  [PAPER, RED, BLACK],
  [NEAR, SOFT, RED],
  [BLACK, PAPER, RED],
];

const FORMS = [
  'arch',
  'sun',
  'steps',
  'rule',
  'halo',
  'wedge',
  'tower',
  'eclipse',
  'grid',
  'ring',
  'split',
  'bars',
] as const;

function form(kind: string, g: string, f: string, a: string): string {
  switch (kind) {
    case 'arch':
      return `<circle cx="72" cy="24" r="22" fill="${f}"/>
        <path d="M26 100V56a24 24 0 0 1 48 0v44Z" fill="${a}"/>
        <rect x="12" y="6" width="4" height="52" fill="${f}" transform="rotate(28 14 6)"/>`;
    case 'sun':
      return `<circle cx="50" cy="42" r="27" fill="${f}"/>
        <g fill="${a}"><rect y="72" width="100" height="6"/><rect y="84" width="100" height="6"/><rect y="96" width="100" height="4"/></g>`;
    case 'steps':
      return `<g fill="${a}" transform="skewX(-22)">
          <rect x="22" y="30" width="62" height="13"/><rect x="14" y="52" width="76" height="13"/><rect x="6" y="74" width="90" height="13"/>
        </g><circle cx="74" cy="18" r="13" fill="${f}"/>`;
    case 'rule': {
      let out = `<rect x="0" y="0" width="46" height="100" fill="${f}"/>`;
      for (let i = 0; i < 5; i += 1)
        out += `<rect x="54" y="${16 + i * 15}" width="${38 - (i % 3) * 10}" height="5" fill="${
          i === 2 ? a : f
        }"/>`;
      return out;
    }
    case 'halo':
      return `<g fill="none" stroke="${f}" stroke-width="3"><circle cx="50" cy="48" r="34"/><circle cx="50" cy="48" r="23"/></g>
        <circle cx="50" cy="48" r="10" fill="${a}"/>`;
    case 'wedge':
      return `<path d="M0 100 100 0v100Z" fill="${f}"/>
        <circle cx="26" cy="26" r="14" fill="${a}"/>`;
    case 'tower': {
      let out = '';
      for (let i = 0; i < 4; i += 1)
        out += `<rect x="${12 + i * 21}" y="${18 + (i % 2) * 22}" width="14" height="${
          72 - (i % 2) * 22
        }" fill="${i === 1 ? a : f}"/>`;
      return out;
    }
    case 'eclipse':
      return `<circle cx="46" cy="48" r="31" fill="${f}"/>
        <circle cx="62" cy="41" r="29" fill="${g}"/>
        <rect y="88" width="100" height="5" fill="${a}"/>`;
    case 'grid': {
      let out = '';
      for (let r = 0; r < 4; r += 1)
        for (let c = 0; c < 4; c += 1)
          out += `<rect x="${10 + c * 21}" y="${10 + r * 21}" width="13" height="13" fill="${
            r === 2 && c === 1 ? a : f
          }"/>`;
      return out;
    }
    case 'ring':
      return `<g fill="none" stroke="${f}" stroke-width="2.4"><circle cx="50" cy="50" r="40"/></g>
        <path d="M50 10a40 40 0 0 1 0 80Z" fill="${a}"/>
        <circle cx="50" cy="50" r="8" fill="${g}"/>`;
    case 'split':
      return `<rect width="50" height="100" fill="${f}"/>
        <circle cx="50" cy="50" r="26" fill="${a}"/>
        <rect x="8" y="86" width="26" height="6" fill="${g}"/>`;
    case 'bars':
    default: {
      const h = [30, 58, 22, 74, 44, 66];
      return h
        .map(
          (v, i) =>
            `<rect x="${8 + i * 15}" y="${88 - v}" width="10" height="${v}" fill="${
              i % 3 === 1 ? a : f
            }"/>`,
        )
        .join('');
    }
  }
}

function sleeve(index: number): string {
  const kind = FORMS[index % FORMS.length];
  const [g, f, a] = GROUNDS[(index * 5 + 2) % GROUNDS.length];
  return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">
    <rect width="100" height="100" fill="${g}"/>${form(kind, g, f, a)}</svg>`;
}

const DRIFT_A = Array.from({ length: 10 }, (_, i) => i);
const DRIFT_B = Array.from({ length: 12 }, (_, i) => i + 5);
const WALL = Array.from({ length: 60 }, (_, i) => i * 5 + 3);
/* Hand-shuffled rather than a stride, so no two rows of the grid repeat. */
const PAD_TILES = [3, 9, 1, 7, 11, 5, 0, 6, 10, 2, 8, 4, 7, 2, 11, 4, 9, 0, 5, 10, 3, 8, 1, 6];
---

<Layout title={`${NAME} — a free player for your self-hosted music`} description={META} themeColor="#0a070d">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,700..900&family=Geologica:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  <VariantBar slug="cover-site" tone="neutral" />

  <main class="cover">
    <!-- ============================================================== HERO
         The study at /h/cover, preserved: centred copy, the wordmark printed
         at 37vw behind everything, and the phone tilted in front of it. -->
    <section class="hero" aria-labelledby="cv-hero">
      <div class="halo" aria-hidden="true"></div>
      <svg class="spark spark-one" viewBox="0 0 70 70" aria-hidden="true">
        <path d="M35 3v64M3 35h64M12.4 12.4l45.2 45.2M57.6 12.4 12.4 57.6"></path>
      </svg>
      <svg class="spark spark-two" viewBox="0 0 70 70" aria-hidden="true">
        <path d="M35 3v64M3 35h64"></path>
      </svg>

      <header class="topbar">
        <a class="identity" href="#cv-hero" aria-label={`${NAME} home`}>
          <span class="brand-mark"><Mark size={38} decorative /></span>
          <span>
            <strong>{NAME}</strong>
            <small>Self-hosted music player</small>
          </span>
        </a>

        <div class="topbar-actions">
          {
            APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                Download on the App Store
              </a>
            ) : (
              <span class="store" aria-disabled="true">
                Coming to the App Store
              </span>
            )
          }
          <a class="source" href={GITHUB_URL}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <div class="copy">
        <p class="eyebrow-c">For iPhone and iPad</p>
        <h1 id="cv-hero">{HEADLINE}</h1>
        <p class="summary">{SUMMARY}</p>
        <p class="compatibility">
          <span>Plays from</span>
          {
            SERVERS.map((s, i) => (
              <>
                {i > 0 && <i aria-hidden="true" />}
                <strong>{s.name}</strong>
              </>
            ))
          }
        </p>
      </div>

      <div class="wordmark" aria-hidden="true">MOZZ</div>

      <div
        class="phone"
        role="img"
        aria-label="An angled iPhone showing the Mozz now playing screen for Half-light by Air Index"
      >
        <span class="side side-one" aria-hidden="true"></span>
        <span class="side side-two" aria-hidden="true"></span>
        <span class="side side-three" aria-hidden="true"></span>

        <div class="screen">
          <div class="status">
            <span>9:41</span>
            <span class="status-icons" aria-hidden="true">
              <svg viewBox="0 0 18 12">
                <path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path>
              </svg>
              <svg viewBox="0 0 20 12">
                <path
                  d="M1 4.5c4.5-4 13.5-4 18 0l-2 2c-3.4-3-10.6-3-14 0zm4 3.2c2.5-2.2 7.5-2.2 10 0l-2 2c-1.5-1.2-4.5-1.2-6 0zM9 11h2v1H9z"
                ></path>
              </svg>
              <svg viewBox="0 0 26 12">
                <rect x="1" y="1" width="21" height="10" rx="2.5" fill="none" stroke="currentColor"></rect>
                <path d="M23 4h2v4h-2z"></path>
                <rect x="3" y="3" width="15" height="6" rx="1"></rect>
              </svg>
            </span>
          </div>

          <div class="appbar">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m15 5-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"></path>
            </svg>
            <div>
              <small>PLAYING FROM YOUR LIBRARY</small>
              <span>Quiet Geometry</span>
            </div>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5" cy="12" r="1.5"></circle>
              <circle cx="12" cy="12" r="1.5"></circle>
              <circle cx="19" cy="12" r="1.5"></circle>
            </svg>
          </div>

          <div class="album" aria-hidden="true">
            <span class="album-sun"></span>
            <span class="album-arch"></span>
            <span class="album-step step-one"></span>
            <span class="album-step step-two"></span>
            <span class="album-step step-three"></span>
            <span class="album-rule"></span>
            <span class="album-title">QUIET<br />GEOMETRY</span>
            <span class="album-code">AI–008</span>
          </div>

          <div class="track">
            <span>
              <strong>Half-light</strong>
              <small>Air Index</small>
            </span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.8 4.7a5.4 5.4 0 0 0-7.7 0L12 5.8l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.6a5.4 5.4 0 0 0 0-7.7Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"></path>
            </svg>
          </div>

          <div class="progress" aria-hidden="true">
            <span class="progress-line"><i></i></span>
            <span class="times"><b>1:46</b><b>−2:28</b></span>
          </div>

          <div class="controls" aria-hidden="true">
            <svg viewBox="0 0 28 28">
              <path
                d="M4 9h4c5 0 6 10 11 10h5m-4-4 4 4-4 4M4 19h4c2 0 3-1.5 4.5-3.5M17 9c1-1 2-1 3-1h4m-4-4 4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.6"></path>
            </svg>
            <svg viewBox="0 0 32 32"><path d="M7 7v18M26 7 10 16l16 9z"></path></svg>
            <span class="play">
              <svg viewBox="0 0 36 36"><path d="m13 8 17 10-17 10z"></path></svg>
            </span>
            <svg viewBox="0 0 32 32"><path d="M25 7v18M6 7l16 9-16 9z"></path></svg>
            <svg viewBox="0 0 28 28">
              <path
                d="M5 9h14a5 5 0 0 1 5 5v1m-4-10 4 4-4 4M23 19H9a5 5 0 0 1-5-5v-1m4 10-4-4 4-4"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.6"></path>
            </svg>
          </div>

          <div class="output">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
              <path d="M8 21h8M12 17v4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
            </svg>
            <span>This iPhone</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 7h12M4 12h12M4 17h8m7-2v6l4-3z"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7"></path>
            </svg>
          </div>

          <span class="home-indicator" aria-hidden="true"></span>
        </div>
      </div>

      <footer class="footnote">
        <span>Free forever</span>
        <span aria-hidden="true">◆</span>
        <span>Open source</span>
        <span aria-hidden="true">◆</span>
        <span>No account or tracking</span>
      </footer>
    </section>

    <!-- ========================================================== SERVERS -->
    <section class="band servers" id="cv-servers" aria-labelledby="cv-servers-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>01</b>Where the music already is</p>
        <h2 id="cv-servers-t">Point it at the machine you already own.</h2>

        <ul class="sleeves" role="list">
          {
            SERVERS.map((s, i) => (
              <li class="sleeve-card reveal" style={`--i:${i}`}>
                <span class="sleeve-ring">
                  <ServerLogo name={s.name} size={30} />
                </span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
                <span class="cat">MZ–{String(i + 1).padStart(3, '0')}</span>
              </li>
            ))
          }
        </ul>

        <p class="aside">{FAQS[0].a}</p>
      </div>
    </section>

    <!-- ================================================= STREAMING / OFFLINE -->
    <section class="band parity" aria-labelledby="cv-parity-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>02</b>Two sides, same record</p>
        <h2 id="cv-parity-t">At home, or nowhere near it.</h2>

        <div class="gatefold">
          {
            PARITY.map((f, i) => (
              <article class={`leaf ${i === 0 ? 'is-red' : 'is-black'} reveal`} style={`--i:${i}`}>
                <span class="leaf-tag">{i === 0 ? 'Streaming' : 'Offline'}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <svg class="leaf-illo" viewBox="0 0 132 68" aria-hidden="true">
                  {i === 0 ? (
                    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <rect x="3" y="16" width="26" height="36" rx="3" />
                      <path d="M10 45h5" />
                      <path d="M41 25a16 16 0 0 1 0 18" />
                      <path d="M52 17a28 28 0 0 1 0 34" opacity="0.6" />
                      <path d="M63 9a40 40 0 0 1 0 50" opacity="0.34" />
                      <rect x="99" y="11" width="28" height="46" rx="6" />
                      <circle cx="113" cy="34" r="6" fill="currentColor" stroke="none" />
                    </g>
                  ) : (
                    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <path d="M3 34h46" opacity="0.45" stroke-dasharray="4 7" />
                      <path d="M59 23 77 45M77 23 59 45" />
                      <rect x="99" y="11" width="28" height="46" rx="6" />
                      <circle cx="113" cy="34" r="6" fill="currentColor" stroke="none" />
                    </g>
                  )}
                </svg>
              </article>
            ))
          }
        </div>

        <ul class="stats" role="list">
          {
            STATS.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <b>{s.value}</b>
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ========================================================== MARQUEE
         /h/marquee, recoloured and re-executed: one wide band of sleeves
         drifting on the same eleven-degree tilt the hero phone sits at, with
         a halo ring standing over the middle of it. Decoration for the
         weekly mixes, and nothing more. -->
    <section class="band weekly" aria-labelledby="cv-weekly-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>03</b>Featured</p>
        <h2 id="cv-weekly-t">{WEEKLY.title}</h2>
        <p class="lede">{WEEKLY.body}</p>
      </div>

      <div class="tiltbox" aria-hidden="true">
        <div class="tilt">
          <div class="tilt-row">
            <div class="tilt-track">
              {[0, 1].map(() => DRIFT_A.map((n) => <span class="cell" set:html={sleeve(n)} />))}
            </div>
          </div>
          <div class="tilt-row is-small">
            <div class="tilt-track is-rev">
              {[0, 1].map(() => DRIFT_B.map((n) => <span class="cell" set:html={sleeve(n)} />))}
            </div>
          </div>
        </div>
        <span class="tilt-halo"></span>
        <span class="tilt-fade tilt-fade-l"></span>
        <span class="tilt-fade tilt-fade-r"></span>
      </div>
    </section>

    <!-- ========================================================= FEATURES -->
    <section class="band does" aria-labelledby="cv-does-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>04</b>What it does with them</p>
        <h2 id="cv-does-t">Everything it does, in the free app.</h2>

        <ul class="cards" role="list">
          {
            REST.map((f, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <span class="cat">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================ ALOUD -->
    <section class="band aloud" aria-labelledby="cv-aloud-t">
      <div class="wrap aloud-grid">
        <div>
          <p class="chapter"><i aria-hidden="true"></i><b>05</b>Past the phone</p>
          <h2 id="cv-aloud-t">{ALOUD.title}</h2>
          <p class="lede">{ALOUD.body}</p>
        </div>

        <svg
          class="aloud-illo"
          viewBox="0 0 440 210"
          role="img"
          aria-label="A HomePod handing a request to an iPhone, which plays it and AirPlays the sound back."
        >
          <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <rect x="34" y="52" width="86" height="122" rx="42"></rect>
            <ellipse cx="77" cy="66" rx="30" ry="10" opacity="0.5"></ellipse>
            <path d="M52 96h50M52 110h50M52 124h50M58 138h38" opacity="0.4"></path>
            <rect x="330" y="38" width="74" height="140" rx="16"></rect>
            <rect x="342" y="56" width="50" height="104" rx="6" opacity="0.45"></rect>
            <circle cx="367" cy="108" r="13" fill="currentColor" stroke="none"></circle>
            <path d="M136 78C196 52 268 50 316 62"></path>
            <path d="M304 52l14 10-13 11"></path>
            <path d="M316 158C258 180 190 178 138 160" opacity="0.75"></path>
            <path d="M150 150l-14 10 13 11" opacity="0.75"></path>
          </g>
          <g class="aloud-label" font-size="11" letter-spacing="1.6">
            <text x="77" y="196" text-anchor="middle">HOMEPOD</text>
            <text x="367" y="196" text-anchor="middle">IPHONE</text>
            <text x="226" y="46" text-anchor="middle">REQUEST</text>
            <text x="226" y="186" text-anchor="middle">AIRPLAY BACK</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- ============================================================ SPLIT
         /h/split, kept off the hero and turned against a drawing rather than
         a device: a twelve-inch sleeve with the disc half out of it on one
         side, the ownership argument on the other. The seam carries the
         chapter mark, not another copy of the logo. -->
    <section class="split" aria-labelledby="cv-own-t">
      <div class="field field-record">
        <svg class="record" viewBox="0 0 420 320" role="img" aria-label="A record half out of its sleeve.">
          <g class="disc">
            <circle cx="286" cy="160" r="126" fill="#0a070d"></circle>
            <g fill="none" stroke="#fdf6ec" stroke-width="1.2" opacity="0.28">
              <circle cx="286" cy="160" r="112"></circle>
              <circle cx="286" cy="160" r="98"></circle>
              <circle cx="286" cy="160" r="84"></circle>
              <circle cx="286" cy="160" r="70"></circle>
            </g>
            <circle cx="286" cy="160" r="46" fill="#d8002d"></circle>
            <circle cx="286" cy="160" r="6" fill="#fdf6ec"></circle>
          </g>
          <g class="jacket">
            <rect x="24" y="34" width="252" height="252" fill="#fdf6ec"></rect>
            <circle cx="212" cy="94" r="46" fill="#0a070d"></circle>
            <path d="M78 286V186a46 46 0 0 1 92 0v100Z" fill="#d8002d"></path>
            <rect x="46" y="52" width="6" height="86" fill="#0a070d" transform="rotate(26 49 52)"></rect>
            <rect x="24" y="268" width="252" height="6" fill="#0a070d" opacity="0.25"></rect>
          </g>
        </svg>
        <p class="field-note"><span class="dot" aria-hidden="true"></span>{TAGLINE}</p>
      </div>

      <div class="field field-own">
        <span class="seam-mark" aria-hidden="true">
          <i></i>
          <span>06 &middot; nobody in between</span>
        </span>
        <div class="own">
          <p class="chapter on-black"><i aria-hidden="true"></i><b>06</b>Why it is built this way</p>
