    margin-top: 0.85rem;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(29px, 4.1vw, 62px);
    font-stretch: 98%;
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .lede {
    max-width: 52ch;
    margin-top: 1.1rem;
    color: rgba(238, 234, 226, 0.68);
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
  }

  .reveal {
    opacity: 1;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.22, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  :global(html.js) .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------------ servers */

  .sleeves {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .sleeve-card {
    position: relative;
    padding: clamp(22px, 2.4vw, 34px) clamp(20px, 2.2vw, 32px) clamp(30px, 3vw, 42px);
    border: 1px solid rgba(238, 234, 226, 0.16);
    border-radius: 3px;
    background: linear-gradient(155deg, rgba(216, 0, 45, 0.14), rgba(10, 7, 13, 0) 58%), var(--near-black);
  }

  .sleeve-ring {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 2px solid rgba(238, 234, 226, 0.22);
    color: var(--paper);
  }

  .sleeve-ring::after {
    content: '';
    position: absolute;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    border: 1px solid rgba(216, 0, 45, 0.4);
  }

  .sleeve-card h3 {
    margin-top: 1.15rem;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(20px, 1.75vw, 27px);
    font-stretch: 104%;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .sleeve-card p {
    margin-top: 0.55rem;
    color: rgba(238, 234, 226, 0.62);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.55;
  }

  .cat {
    position: absolute;
    right: clamp(16px, 1.8vw, 24px);
    bottom: clamp(11px, 1.3vw, 17px);
    color: rgba(238, 234, 226, 0.38);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .aside {
    max-width: 62ch;
    margin-top: clamp(22px, 3vh, 34px);
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    color: rgba(238, 234, 226, 0.6);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.6;
  }

  /* ------------------------------------------------- streaming / offline */

  .gatefold {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .leaf {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.8vw, 42px);
    border-radius: 3px;
    min-height: clamp(280px, 34vh, 380px);
  }

  .leaf.is-red {
    background: var(--red);
    color: var(--paper);
  }

  .leaf.is-black {
    background: var(--near-black);
    border: 1px solid rgba(238, 234, 226, 0.16);
  }

  .leaf-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .leaf h3 {
    margin-top: 0.85rem;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(21px, 2.2vw, 33px);
    font-stretch: 100%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .leaf p {
    margin-top: 0.8rem;
    max-width: 42ch;
    font-size: clamp(13px, 1.02vw, 15.5px);
    line-height: 1.58;
    opacity: 0.78;
  }

  .leaf-illo {
    width: min(220px, 62%);
    height: auto;
    margin-top: auto;
    padding-top: 1.6rem;
    opacity: 0.82;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 24px);
    margin-top: clamp(26px, 3.6vh, 42px);
  }

  .stats li {
    padding-top: clamp(10px, 1.4vh, 16px);
    border-top: 1px solid rgba(238, 234, 226, 0.2);
  }

  .stats li:first-child {
    border-top-color: var(--red);
  }

  .stats b {
    display: block;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(30px, 3.6vw, 56px);
    font-stretch: 108%;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .stats li:first-child b {
    color: var(--red);
  }

  .stats span {
    display: block;
    margin-top: 0.5rem;
    color: rgba(238, 234, 226, 0.55);
    font-size: clamp(11.5px, 0.9vw, 13.5px);
    line-height: 1.4;
  }

  /* ------------------------------------------------------------ marquee */

  .tiltbox {
    position: relative;
    margin-top: clamp(34px, 5vh, 64px);
    padding-block: clamp(30px, 5vw, 70px);
    overflow: hidden;
  }

  /* Wider than the frame, so the eleven-degree tilt never shows a corner. */
  .tilt {
    width: 128%;
    margin-left: -14%;
    transform: rotate(-5deg);
  }

  .tilt-row {
    overflow: hidden;
  }

  .tilt-row.is-small {
    margin-top: clamp(10px, 1.2vw, 18px);
    opacity: 0.5;
  }

  .tilt-track {
    display: flex;
    width: max-content;
    gap: clamp(10px, 1.2vw, 18px);
    will-change: transform;
    animation: drift 70s linear infinite;
  }

  .tilt-row.is-small .tilt-track {
    animation-duration: 104s;
  }

  .tilt-track.is-rev {
    animation-direction: reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - clamp(5px, 0.6vw, 9px)), 0, 0);
    }
  }

  .cell {
    display: block;
    flex: none;
    width: clamp(120px, 15vw, 216px);
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .tilt-row.is-small .cell {
    width: clamp(66px, 8vw, 118px);
  }

  .cell :global(svg),
  .pad-tile :global(svg),
  .pad-now-art :global(svg),
  .mini-art :global(svg),
  .wall-tile :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The halo from the hero, standing over the middle of the band. */
  .tilt-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(34vw, 380px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 2px solid rgba(253, 246, 236, 0.6);
    border-radius: 50%;
    pointer-events: none;
  }

  .tilt-halo::after {
    content: '';
    position: absolute;
    inset: 14%;
    border: 1px solid rgba(216, 0, 45, 0.75);
    border-radius: 50%;
  }

  .tilt-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(50px, 12vw, 200px);
    pointer-events: none;
  }

  .tilt-fade-l {
    left: 0;
    background: linear-gradient(to right, var(--black), rgba(10, 7, 13, 0));
  }

  .tilt-fade-r {
    right: 0;
    background: linear-gradient(to left, var(--black), rgba(10, 7, 13, 0));
  }

  /* ----------------------------------------------------------- features */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(30px, 5vh, 58px);
    background: rgba(238, 234, 226, 0.14);
    border: 1px solid rgba(238, 234, 226, 0.14);
  }

  .card {
    position: relative;
    padding: clamp(24px, 2.8vw, 44px);
    background: var(--black);
  }

  .card .cat {
    position: static;
    display: block;
    color: var(--red);
  }

  .card h3 {
    margin-top: 0.9rem;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(19px, 1.8vw, 28px);
    font-stretch: 100%;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  .card p {
    margin-top: 0.7rem;
    max-width: 44ch;
    color: rgba(238, 234, 226, 0.62);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.58;
  }

  /* -------------------------------------------------------------- aloud */

  .aloud-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .aloud-illo {
    width: 100%;
    height: auto;
    padding: clamp(18px, 2.4vw, 38px);
    border: 1px solid rgba(238, 234, 226, 0.16);
    border-radius: 3px;
    background: radial-gradient(90% 120% at 24% 42%, rgba(216, 0, 45, 0.18), rgba(10, 7, 13, 0) 66%), var(--near-black);
    color: var(--paper);
  }

  .aloud-label {
    fill: var(--red);
    font-family: 'Geologica', system-ui, sans-serif;
    font-weight: 600;
  }

  /* -------------------------------------------------------------- split */

  .split {
    position: relative;
    display: grid;
    grid-template-columns: 50% 1fr;
    min-height: clamp(560px, 92svh, 900px);
    border-top: 1px solid rgba(238, 234, 226, 0.1);
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: clamp(40px, 6vh, 90px) clamp(22px, 4vw, 70px);
  }

  .field-record {
    background: var(--red);
  }

  .record {
    width: min(100%, 500px);
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.4));
  }

  .record .disc {
    transform-origin: 286px 160px;
    animation: spin 22s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .field-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: clamp(22px, 3vh, 38px);
    color: rgba(253, 246, 236, 0.86);
    font-size: clamp(10.5px, 0.9vw, 12.5px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field-note .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--black);
  }

  .field-own {
    background: var(--black);
  }

  .seam-mark {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(22px, 4vh, 48px);
    pointer-events: none;
  }

  .seam-mark i {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgba(253, 246, 236, 0) 0%,
      rgba(253, 246, 236, 0.45) 22%,
      rgba(253, 246, 236, 0.45) 78%,
      rgba(253, 246, 236, 0) 100%
    );
  }

  .seam-mark span {
    flex: none;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(253, 246, 236, 0.55);
    writing-mode: vertical-rl;
  }

  .own {
    position: relative;
    z-index: 2;
    width: min(100%, 640px);
  }

  .chapter.on-black {
    color: rgba(238, 234, 226, 0.55);
  }

  .own h2 {
    max-width: 14ch;
    margin-top: 0.85rem;
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(34px, 4.4vw, 68px);
    font-stretch: 104%;
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .own ul {
    margin-top: clamp(22px, 3vh, 36px);
  }

  .own li {
    padding-block: clamp(14px, 1.8vh, 22px);
    border-top: 1px solid rgba(238, 234, 226, 0.2);
  }

  .own li:last-child {
    border-bottom: 1px solid rgba(238, 234, 226, 0.2);
  }

  .own h3 {
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(17px, 1.5vw, 23px);
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .own p {
    margin-top: 0.4rem;
    max-width: 48ch;
    color: rgba(238, 234, 226, 0.66);
    font-size: clamp(12.5px, 0.98vw, 14.5px);
    line-height: 1.55;
  }

  /* --------------------------------------------------------------- pair */

  .pair {
    overflow: hidden;
  }

  .rig {
    position: relative;
    width: min(100% - var(--pad) * 2, 1000px);
    margin: clamp(34px, 6vh, 74px) auto 0;
    padding-bottom: 7%;
  }

  .pad {
    width: 100%;
    aspect-ratio: 1.43;
    padding: clamp(8px, 0.9vw, 14px);
    border: 1px solid rgba(238, 234, 226, 0.2);
    border-radius: clamp(16px, 1.9vw, 30px);
    background: linear-gradient(135deg, #191320 0%, #0a070d 30%, #030204 76%, #191320 100%);
    box-shadow: 0 44px 80px -40px rgba(0, 0, 0, 0.9);
  }

  .pad-screen {
    display: grid;
    grid-template-columns: clamp(120px, 19%, 190px) 1fr;
    height: 100%;
    border-radius: clamp(10px, 1.3vw, 20px);
    overflow: hidden;
    background: var(--black);
  }

  .pad-side {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(12px, 1.5vw, 22px);
    background: rgba(25, 19, 32, 0.75);
    border-right: 1px solid rgba(238, 234, 226, 0.09);
    font-size: clamp(9.5px, 0.86vw, 12.5px);
  }

  .pad-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .pad-brand b {
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: 1.15em;
    font-stretch: 110%;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .pad-nav {
    padding: 0.34rem 0.5rem;
    border-radius: 3px;
    color: rgba(238, 234, 226, 0.55);
  }

  .pad-nav.is-on {
    background: var(--red);
    color: var(--paper);
  }

  .pad-weekly {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(238, 234, 226, 0.12);
    color: rgba(238, 234, 226, 0.66);
  }

  .pad-weekly i {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
  }

  .pad-main {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 1.5vw, 22px);
    min-width: 0;
  }

  .pad-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(10px, 1.2vw, 16px);
  }

  .pad-h {
    font-family: 'Anybody', 'Arial Black', system-ui, sans-serif;
    font-size: clamp(13px, 1.4vw, 22px);
    font-stretch: 104%;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .pad-search {
    width: clamp(70px, 22%, 190px);
    height: clamp(14px, 1.5vw, 22px);
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.1);
  }

  .pad-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(6px, 0.8vw, 12px);
    align-content: start;
    min-height: 0;
  }

  .pad-tile {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .pad-now {
    display: grid;
    grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1.6fr) auto;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
    margin-top: auto;
    padding-top: clamp(10px, 1.2vw, 18px);
    border-top: 1px solid rgba(238, 234, 226, 0.12);
  }

  .pad-now-art {
    display: block;
    width: clamp(26px, 3.4vw, 46px);
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .pad-now-meta {
    display: grid;
    min-width: 0;
    font-size: clamp(9px, 0.82vw, 12px);
  }

  .pad-now-meta b {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pad-now-meta i {
    font-style: normal;
    color: rgba(238, 234, 226, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pad-now-bar {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.18);
  }

  .pad-now-bar i {
    display: block;
    width: 46%;
    height: 100%;
    border-radius: 999px;
    background: var(--red);
  }

  .pad-now-play {
    width: clamp(18px, 2.2vw, 30px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  .mini {
    position: absolute;
    right: 1.5%;
    bottom: 0;
    width: 18.5%;
    min-width: 84px;
    aspect-ratio: 71.6 / 147.6;
    padding: clamp(4px, 0.5vw, 8px);
    border: 1px solid rgba(238, 234, 226, 0.24);
    border-radius: clamp(14px, 1.7vw, 26px);
    background: linear-gradient(135deg, #191320 0%, #0a070d 30%, #030204 78%, #191320 100%);
    box-shadow: 0 30px 60px -26px rgba(0, 0, 0, 0.95);
    transform: rotate(4deg);
    transform-origin: 50% 100%;
  }

  .mini-screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(6px, 0.7vw, 11px);
    border-radius: clamp(10px, 1.3vw, 20px);
    background: var(--black);
    overflow: hidden;
    font-size: clamp(6px, 0.62vw, 9px);
  }

  .mini-island {
    width: 34%;
    height: 0.9em;
    margin: 0.2em auto 0.7em;
    border-radius: 999px;
    background: #030204;
  }

  .mini-art {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .mini-title {
    margin-top: 0.8em;
    font-weight: 600;
    font-size: 1.15em;
    letter-spacing: -0.02em;
  }

  .mini-sub {
    color: rgba(238, 234, 226, 0.55);
  }

  .mini-bar {
    display: block;
    height: 0.28em;
    margin-top: 0.7em;
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.2);
  }

  .mini-bar i {
    display: block;
    width: 46%;
    height: 100%;
    border-radius: 999px;
    background: var(--paper);
  }

  .mini-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9em;
    margin-top: auto;
  }

  .mini-ctrl i {
    width: 0.7em;
    height: 0.7em;
    background: rgba(238, 234, 226, 0.7);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .mini-ctrl i:first-child {
    transform: scaleX(-1);
  }

  .mini-ctrl b {
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    background: var(--paper);
  }

  .mini-chip {
    margin-top: 0.7em;
    text-align: center;
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(238, 234, 226, 0.6);
  }

  .mini-home {
    width: 32%;
    height: 0.25em;
    margin: 0.6em auto 0;
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.5);
  }

  :global(html.js) .rig .pad,
  :global(html.js) .rig .mini {
    opacity: 0;
    transition:
      opacity 0.75s cubic-bezier(0.2, 0.75, 0.2, 1),
      transform 0.75s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  :global(html.js) .rig .pad {
    transform: translateY(58px);
  }

  :global(html.js) .rig .mini {
    transform: translateY(78px) rotate(11deg);
    transition-delay: 160ms;
  }

  :global(html.js) .rig.is-in .pad {
    opacity: 1;
    transform: none;
  }

  :global(html.js) .rig.is-in .mini {
    opacity: 1;
    transform: rotate(4deg);
  }

  /* ---------------------------------------------------------------- faq */

  .faq {
    position: relative;
    overflow: hidden;
  }

  .wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2px;
    opacity: 0.1;
    pointer-events: none;
