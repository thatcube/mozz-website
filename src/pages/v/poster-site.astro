---
/**
 * VARIANT — POSTER SITE
 *
 * A direct extension of the hero study at /h/poster, not a new idea.
 *
 * The hero is kept: cream stock, a screenprinted concentric cone bleeding off
 * the right edge, halftone and grain over the whole sheet, the bill of fare
 * ruled top and bottom, and MOZZ set in condensed display type stretched to
 * the full measure of the page.
 *
 * One deliberate change from the study: the second plate is black rather than
 * blue, so the whole site prints in red, white and black. Everything still
 * overprints — the ink layer multiplies over the red, so where they cross you
 * get the darker mix a two-colour press would actually give you.
 *
 * The enormous wordmark is a hero gesture and is used as one: once at the top,
 * once at the very bottom, and nowhere in between. Each section below is
 * marked by its chapter number, a rule, or a change of plate.
 *
 * No photography anywhere — every sleeve is generated below as SVG.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  SITE,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  APPLE_CONTINUITY,
  SYNC,
  RESUME,
  DISCOVERY,
  OWNERSHIP,
  FAQS,
  GITHUB_URL,
  DONATE_URL,
  RELEASES_URL,
  DOWNLOAD_LABEL,
  PLATFORMS,
  PLATFORM_LINE,
} from '../../data/site';

/* The only copy written on this page. Everything else comes from site.ts. */
const HEADLINE = 'A free player for the music on your own server.';
const BODY =
  'Point Mozz at Plex, Jellyfin or Navidrome. Stream it at home, or download an album and play it with no signal at all.';
const META = `Mozz is a free, open source music player for the music on your own Plex, Jellyfin or Navidrome server, at home or offline. ${PLATFORM_LINE}`;

const domain = SITE.replace(/^https?:\/\//, '');

/* The bill of fare is the feature set itself, so it can never drift from it
   and never needs a number written into the prose. */
const BILL = FEATURES.map((f) => f.title);

const PARITY = [FEATURES[0], FEATURES[1]];
const ALOUD = FEATURES[7];
const REST = [FEATURES[2], FEATURES[3], FEATURES[4], FEATURES[6]];

/* ------------------------------------------------------------------ prints */

const STOCK = '#f5efe2';
const RED = '#e03e2d';
const INK = '#141110';

type Trio = [string, string, string];

/** Two plates and the bare stock, in every arrangement a press could give. */
const PLATES: Trio[] = [
  [STOCK, RED, INK],
  [RED, STOCK, INK],
  [INK, STOCK, RED],
  [STOCK, INK, RED],
  [RED, INK, STOCK],
  [INK, RED, STOCK],
  [STOCK, RED, RED],
];

const CUTS = [
  'cone',
  'target',
  'wedge',
  'stack',
  'burst',
  'arch',
  'ladder',
  'moon',
  'dot',
  'column',
  'cross',
  'sweep',
] as const;

function cut(kind: string, g: string, a: string, b: string): string {
  switch (kind) {
    case 'cone':
      return `<g fill="none" stroke="${a}" stroke-width="6"><circle cx="50" cy="50" r="42"/><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="18"/></g>
        <circle cx="50" cy="50" r="8" fill="${b}"/>`;
    case 'target':
      return `<circle cx="50" cy="50" r="44" fill="${a}"/>
        <circle cx="50" cy="50" r="30" fill="${g}"/>
        <circle cx="50" cy="50" r="16" fill="${b}"/>`;
    case 'wedge':
      return `<path d="M0 0H100L0 100Z" fill="${a}"/>
        <circle cx="70" cy="70" r="18" fill="${b}"/>`;
    case 'stack': {
      let out = '';
      for (let i = 0; i < 5; i += 1)
        out += `<rect x="8" y="${12 + i * 16}" width="${84 - i * 6}" height="9" fill="${
          i === 2 ? b : a
        }"/>`;
      return out;
    }
    case 'burst': {
      let out = '';
      for (let i = 0; i < 12; i += 1)
        out += `<rect x="48.6" y="2" width="2.8" height="46" fill="${a}" transform="rotate(${
          (i * 360) / 12
        } 50 50)"/>`;
      return `${out}<circle cx="50" cy="50" r="11" fill="${b}"/>`;
    }
    case 'arch':
      return `<path d="M22 96V52a28 28 0 0 1 56 0v44Z" fill="${a}"/>
        <circle cx="50" cy="50" r="11" fill="${b}"/>
        <rect y="90" width="100" height="10" fill="${b}"/>`;
    case 'ladder': {
      let out = '';
      for (let i = 0; i < 7; i += 1)
        out += `<rect x="10" y="${10 + i * 12}" width="80" height="6" fill="${
          i === 3 ? b : a
        }"/>`;
      return out;
    }
    case 'moon':
      return `<circle cx="44" cy="50" r="34" fill="${a}"/>
        <circle cx="62" cy="44" r="32" fill="${g}"/>
        <circle cx="20" cy="18" r="6" fill="${b}"/>`;
    case 'dot': {
      let out = '';
      for (let r = 0; r < 5; r += 1)
        for (let c = 0; c < 5; c += 1)
          out += `<circle cx="${14 + c * 18}" cy="${14 + r * 18}" r="${
            2.4 + ((r + c) % 3) * 2.2
          }" fill="${r === 2 && c === 2 ? b : a}"/>`;
      return out;
    }
    case 'column': {
      let out = '';
      for (let i = 0; i < 5; i += 1)
        out += `<rect x="${10 + i * 17}" y="${14 + (i % 2) * 20}" width="11" height="${
          72 - (i % 2) * 20
        }" fill="${i === 2 ? b : a}"/>`;
      return out;
    }
    case 'cross':
      return `<rect x="42" y="6" width="16" height="88" fill="${a}"/>
        <rect x="6" y="42" width="88" height="16" fill="${a}"/>
        <circle cx="50" cy="50" r="10" fill="${b}"/>`;
    case 'sweep':
    default:
      return `<path d="M0 100A100 100 0 0 1 100 0v100Z" fill="${a}"/>
        <rect x="8" y="10" width="46" height="7" fill="${b}"/>
        <rect x="8" y="24" width="30" height="7" fill="${b}"/>`;
  }
}

function print(index: number): string {
  const kind = CUTS[index % CUTS.length];
  const [g, a, b] = PLATES[(index * 3 + 1) % PLATES.length];
  return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">
    <rect width="100" height="100" fill="${g}"/>${cut(kind, g, a, b)}</svg>`;
}

const STRIP_A = Array.from({ length: 10 }, (_, i) => i);
const STRIP_B = Array.from({ length: 12 }, (_, i) => i + 4);
const PASTE = Array.from({ length: 60 }, (_, i) => i * 5 + 2);
/* Hand-shuffled rather than a stride, so no two rows of the grid repeat. */
const PAD_TILES = [3, 9, 1, 7, 11, 5, 0, 6, 10, 2, 8, 4, 7, 2, 11, 4, 9, 0, 5, 10, 3, 8, 1, 6];
---

<Layout title={`${NAME} — a free player for your self-hosted music`} description={META} themeColor="#f5efe2">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  <VariantBar slug="poster-site" tone="cool" />

  <main class="poster">
    <!-- ============================================================== HERO
         The study at /h/poster, preserved — with the blue plate swapped for
         black so the sheet prints in red, white and black. -->
    <section class="sheet" aria-labelledby="po-hero">
      <div class="press" aria-hidden="true">
        <svg class="cone" viewBox="0 0 400 400">
          <defs>
            <pattern id="pos-dots" width="9" height="9" patternUnits="userSpaceOnUse">
              <circle cx="4.5" cy="4.5" r="2.6" fill="#e03e2d"></circle>
            </pattern>
          </defs>
          <circle cx="188" cy="186" r="196" fill="url(#pos-dots)" opacity="0.85"></circle>
          <g fill="none" stroke="#e03e2d">
            <circle cx="200" cy="200" r="192" stroke-width="12"></circle>
            <circle cx="200" cy="200" r="171" stroke-width="20"></circle>
          </g>
          <circle cx="200" cy="200" r="152" fill="#e03e2d"></circle>
          <g fill="none" stroke="#f5efe2" stroke-width="5">
            <circle cx="200" cy="200" r="136"></circle>
            <circle cx="200" cy="200" r="118"></circle>
            <circle cx="200" cy="200" r="99"></circle>
            <circle cx="200" cy="200" r="79"></circle>
          </g>
          <circle cx="200" cy="200" r="58" fill="#f5efe2"></circle>
          <circle cx="200" cy="200" r="48" fill="#e03e2d"></circle>
          <g fill="#e03e2d">
            <circle cx="200" cy="16" r="11"></circle>
            <circle cx="200" cy="384" r="11"></circle>
            <circle cx="16" cy="200" r="11"></circle>
            <circle cx="384" cy="200" r="11"></circle>
          </g>
        </svg>

        <svg class="bars" viewBox="0 0 120 20" preserveAspectRatio="none">
          <g fill="#e03e2d">
            <rect x="0" y="11" width="4" height="9"></rect>
            <rect x="6" y="6" width="4" height="14"></rect>
            <rect x="12" y="14" width="4" height="6"></rect>
            <rect x="18" y="3" width="4" height="17"></rect>
            <rect x="24" y="9" width="4" height="11"></rect>
            <rect x="30" y="16" width="4" height="4"></rect>
            <rect x="36" y="7" width="4" height="13"></rect>
            <rect x="42" y="12" width="4" height="8"></rect>
            <rect x="48" y="2" width="4" height="18"></rect>
            <rect x="54" y="10" width="4" height="10"></rect>
            <rect x="60" y="15" width="4" height="5"></rect>
            <rect x="66" y="5" width="4" height="15"></rect>
            <rect x="72" y="13" width="4" height="7"></rect>
            <rect x="78" y="8" width="4" height="12"></rect>
            <rect x="84" y="1" width="4" height="19"></rect>
            <rect x="90" y="11" width="4" height="9"></rect>
            <rect x="96" y="6" width="4" height="14"></rect>
            <rect x="102" y="14" width="4" height="6"></rect>
            <rect x="108" y="4" width="4" height="16"></rect>
            <rect x="114" y="10" width="4" height="10"></rect>
          </g>
        </svg>

        <span class="halftone"></span>
        <span class="grain"></span>
      </div>

      <div class="ink">
        <header class="billing">
          <a class="bill-mark" href="#po-hero">
            <Mark size={22} decorative /> Self-hosted music player
          </a>
          <span class="bill-fine">{SUBLINE}</span>
        </header>

        <div class="word">
          <svg class="wordmark" viewBox="0 0 1000 214" role="img" aria-label={NAME}>
            <text x="500" y="196" text-anchor="middle" textLength="1000" lengthAdjust="spacingAndGlyphs">
              MOZZ
            </text>
          </svg>
        </div>

        <ul class="bill-list" role="list">
          {BILL.map((item) => <li>{item}</li>)}
        </ul>

        <p class="runs">
          <span class="runs-tag">Runs on</span>
          {PLATFORMS.map((platform) => <span class="runs-on">{platform.short}</span>)}
        </p>

        <div class="say">
          <h1 id="po-hero">{HEADLINE}</h1>
          <p>{BODY}</p>
        </div>

        <div class="foot">
          <div class="actions">
            <a class="store" href={RELEASES_URL} rel="noopener">{DOWNLOAD_LABEL}</a>
            <a class="source" href={GITHUB_URL}>Get the source on GitHub</a>
          </div>

          <div class="works">
            <span class="works-label">Works with</span>
            {
              SERVERS.map((s) => (
                <span class="server">
                  <ServerLogo name={s.name} size={15} />
                  {s.name}
                </span>
              ))
            }
          </div>
        </div>

        <footer class="colophon">
          <span>No account · no tracking · GPL-3.0</span>
          <span>{domain}</span>
        </footer>
      </div>
    </section>

    <!-- ========================================================== SERVERS -->
    <section class="band servers" aria-labelledby="po-servers-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>01</b>Where the music already is</p>
        <h2 id="po-servers-t">Point it at the machine you already own.</h2>

        <ul class="panels" role="list">
          {
            SERVERS.map((s, i) => (
              <li class="panel reveal" style={`--i:${i}`}>
                <span class="panel-mark">
                  <ServerLogo name={s.name} size={28} />
                </span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </li>
            ))
          }
        </ul>

        <p class="aside">{FAQS[0].a}</p>
      </div>
    </section>

    <!-- ================================================= STREAMING / OFFLINE -->
    <section class="band parity" aria-labelledby="po-parity-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>02</b>Two plates, equal weight</p>
        <h2 id="po-parity-t">At home, or nowhere near it.</h2>

        <div class="halves">
          {
            PARITY.map((f, i) => (
              <article class={`half ${i === 0 ? 'is-red' : 'is-ink'} reveal`} style={`--i:${i}`}>
                <span class="half-tag">{i === 0 ? 'Streaming' : 'Offline'}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <svg class="half-illo" viewBox="0 0 132 68" aria-hidden="true">
                  {i === 0 ? (
                    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                      <rect x="3" y="16" width="26" height="36" rx="3" />
                      <path d="M10 45h5" />
                      <path d="M41 25a16 16 0 0 1 0 18" />
                      <path d="M52 17a28 28 0 0 1 0 34" opacity="0.6" />
                      <path d="M63 9a40 40 0 0 1 0 50" opacity="0.34" />
                      <rect x="99" y="11" width="28" height="46" rx="6" />
                      <circle cx="113" cy="34" r="6" fill="currentColor" stroke="none" />
                    </g>
                  ) : (
                    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                      <path d="M3 34h46" opacity="0.45" stroke-dasharray="4 7" />
                      <path d="M59 23 77 45M77 23 59 45" />
                      <rect x="99" y="11" width="28" height="46" rx="6" />
                      <circle cx="113" cy="34" r="6" fill="currentColor" stroke="none" />
                    </g>
                  )}
                </svg>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========================================================== MARQUEE
         /h/marquee, printed rather than projected: a run of two-colour
         miniatures drifting past on the press, with the halftone laid over
         the top so it reads as one sheet coming off the roller. -->
    <section class="band weekly" aria-labelledby="po-weekly-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>03</b>Featured</p>
        <h2 id="po-weekly-t">{DISCOVERY.title}</h2>
        <p class="lede">{DISCOVERY.lede}</p>

        <ul class="trio" role="list">
          {
            DISCOVERY.steps.map((step, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <b>{step.key}</b>
                <strong>{step.title}</strong>
                <span>{step.body}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="roller" aria-hidden="true">
        <div class="roll-row">
          <div class="roll-track">
            {[0, 1].map(() => STRIP_A.map((n) => <span class="chip" set:html={print(n)} />))}
          </div>
        </div>
        <div class="roll-row is-small">
          <div class="roll-track is-rev">
            {[0, 1].map(() => STRIP_B.map((n) => <span class="chip" set:html={print(n)} />))}
          </div>
        </div>
        <span class="roll-screen"></span>
        <span class="roll-fade roll-fade-l"></span>
        <span class="roll-fade roll-fade-r"></span>
      </div>
    </section>

    <!-- ========================================================= FEATURES -->
    <section class="band does" aria-labelledby="po-does-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>04</b>What it does with them</p>
        <h2 id="po-does-t">Everything it does, in the free app.</h2>

        <ul class="cards" role="list">
          {
            REST.map((f, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <span class="card-no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================ ALOUD -->
    <section class="band aloud" aria-labelledby="po-aloud-t">
      <div class="wrap aloud-grid">
        <div>
          <p class="chapter"><i aria-hidden="true"></i><b>05</b>Past the phone</p>
          <h2 id="po-aloud-t">{ALOUD.title}</h2>
          <p class="lede">{ALOUD.body}</p>
        </div>

        <svg
          class="aloud-illo"
          viewBox="0 0 440 210"
          role="img"
          aria-label="A HomePod handing a request to an iPhone, which plays it and AirPlays the sound back."
        >
          <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
            <rect x="34" y="52" width="86" height="122" rx="42"></rect>
            <ellipse cx="77" cy="66" rx="30" ry="10" opacity="0.5"></ellipse>
            <path d="M52 96h50M52 110h50M52 124h50M58 138h38" opacity="0.4"></path>
            <rect x="330" y="38" width="74" height="140" rx="16"></rect>
            <rect x="342" y="56" width="50" height="104" rx="6" opacity="0.45"></rect>
            <circle cx="367" cy="108" r="13" fill="currentColor" stroke="none"></circle>
            <path d="M136 78C196 52 268 50 316 62"></path>
            <path d="M304 52l14 10-13 11"></path>
            <path d="M316 158C258 180 190 178 138 160" opacity="0.75"></path>
            <path d="M150 150l-14 10 13 11" opacity="0.75"></path>
          </g>
          <g class="aloud-label" font-size="12" letter-spacing="1.8">
            <text x="77" y="197" text-anchor="middle">HOMEPOD</text>
            <text x="367" y="197" text-anchor="middle">IPHONE</text>
            <text x="226" y="44" text-anchor="middle">REQUEST</text>
            <text x="226" y="188" text-anchor="middle">AIRPLAY BACK</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- ============================================================ SPLIT
         /h/split, off the hero and set against the press rather than a
         device: the cone reversed out of the black plate on one side, the
         ownership argument on the other. -->
    <section class="split" aria-labelledby="po-own-t">
      <div class="field field-press">
        <svg class="reverse-cone" viewBox="0 0 400 400" role="img" aria-label="The Mozz cone, reversed out of the black plate.">
          <g fill="none" stroke="#e03e2d">
            <circle cx="200" cy="200" r="192" stroke-width="10"></circle>
            <circle cx="200" cy="200" r="173" stroke-width="18"></circle>
          </g>
          <circle cx="200" cy="200" r="152" fill="#e03e2d"></circle>
          <g fill="none" stroke="#141110" stroke-width="6">
            <circle cx="200" cy="200" r="136"></circle>
            <circle cx="200" cy="200" r="118"></circle>
            <circle cx="200" cy="200" r="99"></circle>
            <circle cx="200" cy="200" r="79"></circle>
          </g>
          <circle cx="200" cy="200" r="58" fill="#f5efe2"></circle>
          <g transform="translate(174 174) scale(1.62)">
            <path
              d="M12 3H20V4H22V5H24V6H25V7H26V8H27V10H28V12H29V20H28V22H27V24H26V25H25V26H24V27H22V28H20V29H12V28H10V27H8V26H7V25H6V24H5V22H4V20H3V12H4V10H5V8H6V7H7V6H8V5H10V4H12V3Z"
              fill="#e03e2d"
              shape-rendering="crispEdges"></path>
            <path
              d="M12 12h3v1h-3zm5 0h3v1h-3zm-4 1h2v1h-2zm5 0h2v1h-2zm-6 1h2v1h-2zm5 0h2v1h-2zm-5 1h3v1h-3zm5 0h3v1h-3zm-4 3h1v1h-1zm5 0h1v1h-1zm-4 1h4v1h-4z"
              fill="#f5efe2"
              shape-rendering="crispEdges"></path>
          </g>
        </svg>
        <p class="field-note"><span class="dot" aria-hidden="true"></span>{TAGLINE}</p>
      </div>

      <div class="field field-own">
        <span class="seam-mark" aria-hidden="true">
          <i></i>
          <span>06 &middot; nobody in between</span>
        </span>
        <div class="own">
          <p class="chapter"><i aria-hidden="true"></i><b>06</b>Why it is built this way</p>
          <h2 id="po-own-t">Nothing in the middle.</h2>
          <ul role="list">
            {
              OWNERSHIP.map((o, i) => (
                <li class="reveal" style={`--i:${i}`}>
                  <h3>{o.title}</h3>
                  <p>{o.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============================================================= PAIR -->
    <section class="band pair" aria-labelledby="po-pair-t">
      <div class="wrap">
        <p class="chapter"><i aria-hidden="true"></i><b>07</b>Handover</p>
        <h2 id="po-pair-t">{CONTINUITY.title}</h2>
        <p class="lede">{CONTINUITY.body}</p>

        <ul class="trio trio--pair" role="list">
          <li class="reveal" style="--i:0">
            <b>A</b>
            <strong>{SYNC.title}</strong>
            <span>{SYNC.body}</span>
          </li>
          <li class="reveal" style="--i:1">
            <b>B</b>
            <strong>{RESUME.title}</strong>
            <span>{RESUME.body}</span>
          </li>
        </ul>

        <p class="aside">{APPLE_CONTINUITY.title}: {APPLE_CONTINUITY.body}</p>
      </div>

      <div class="rig" role="img" aria-label="An iPad showing the Mozz library beside an iPhone playing a downloaded album.">
        <div class="pad">
          <div class="pad-screen">
            <aside class="pad-side">
              <span class="pad-brand"><Mark size={16} decorative /><b>{NAME}</b></span>
              <span class="pad-nav is-on">Library</span>
              <span class="pad-nav">Radio</span>
              <span class="pad-nav">Downloads</span>
              <span class="pad-nav">Playlists</span>
              <span class="pad-weekly"><i aria-hidden="true"></i>Mozz Weekly</span>
            </aside>
            <div class="pad-main">
              <div class="pad-top">
                <span class="pad-h">Albums</span>
                <span class="pad-search"></span>
              </div>
              <div class="pad-grid">
