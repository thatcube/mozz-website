  /* Every mark of black is one plate, printed on top — so where it crosses
     the red it overprints instead of hiding it. The blend is set per line of
     the column rather than on the column itself, because the lines that cross
     the red plate need to knock out of it (below) and a group blend would
     swallow the bone trap that does the knocking. */
  .ink > * {
    mix-blend-mode: multiply;
  }

  /* These three carry a bone trap, so they print rather than overprint: the
     spread cuts the rings away from the letterforms and the type stays crisp
     wherever the plate runs underneath it. On bare stock the trap is bone on
     bone and disappears. */
  .word,
  .bill-list,
  .runs,
  .say {
    mix-blend-mode: normal;
  }

  /* The trap for running type. Eight hard offsets read as a printed spread,
