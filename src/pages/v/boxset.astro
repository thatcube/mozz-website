// exact screen positions of the three printed logo wells, so the real ServerLogo
// marks drop dead-centre into each frame regardless of viewBox
const reqWells = (() => {
  const b = back.bounds();
  const pad = 6;
  const W = b.maxX - b.minX + pad * 2, H = b.maxY - b.minY + pad * 2;
  const ox = b.minX - pad, oy = b.minY - pad;
  return [0, 1, 2].map((i) => {
    // mean of the 34×34 panel's model corners → true parallelogram centre
    const [sx, sy] = back.proj(25 + i * 39, 31, 6.03);
    return { left: r2(((sx - ox) / W) * 100), top: r2(((sy - oy) / H) * 100), size: r2((14 / W) * 100) };
  });
})();

