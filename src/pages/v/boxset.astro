/* small nested-helper factories used only inside hero -------------------------- */
function seamStep(s: any, tx: number, ty: number, tw: number, td: number, th: number) {
  s.seam([tx, ty, th], [tx + tw, ty, th], 'y', 0.6);
  s.seam([tx, ty, th], [tx, ty + td, th], 'x', 0.6);
  flute(s, tx, ty, 0, th, 'x', 0.7, 5);
}
function recess(s: any, x: number, y: number, w: number, d: number, th: number) {
  const fz = th - 1.6;
  s.quad(x, y, w, d, fz, '#b9b4a9', 'flat');
  s.faceX(x, y, y + d, fz, th, '#e4dfd5', 'flat');   // lit draft angle (far wall)
  s.faceY(y, x, x + w, fz, th, '#cdc8be', 'flat');
  s.line([x, y, fz], [x + w, y, fz], 'seam-d');
  s.line([x, y, fz], [x, y + d, fz], 'seam-d');
}
function mediaCase(s: any, x: number, y: number, pal: string[], label: string) {
  const CASE = { top: '#2c2b34', left: '#232229', right: '#17161c' };
  s.box(x, y, 5.4, 22, 12, 1.2, CASE);
  s.quad(x + 1, y + 1, 20, 10, 6.61, '#1b1a22', 'flat');
  s.fan(x + 7, y + 6, 6.62, 4.4, pal, 22, x);
  s.quad(x + 13, y + 2, 8, 8, 6.62, 'none', 'edge');
  s.text(x + 17, y + 4, 6.62, label, 1.9, 'print-w', 'top', 'middle', 'central');
}
function quickStart(s: any, x: number, y: number) {
  // three-panel accordion, standing in a shallow tent
  const panelW = 12, h = 14;
  const cols = ['#f6ecdb', '#efe2c8', '#f6ecdb'];
  for (let i = 0; i < 3; i++) {
    const px = x + i * panelW;
    const up = i % 2 === 0;
    const z0 = up ? 0 : 6, z1 = up ? 6 : 0;
    // slanted panel between (px,z0)…(px+panelW,z1)
    s.raw(`M${s.P(px, y, z0)}L${s.P(px + panelW, y, z1)}L${s.P(px + panelW, y + h, z1)}L${s.P(px, y + h, z0)}Z`, cols[i], 'flat');
    s.raw(`M${s.P(px, y, z0)}L${s.P(px + panelW, y, z1)}L${s.P(px + panelW, y + h, z1)}L${s.P(px, y + h, z0)}Z`, 'none', 'edge');
  }
  s.text(x + 6, y + 4, 3.2, 'QUICK', 2, 'print-tick', 'top', 'middle', 'central');
  s.text(x + 6, y + 8, 3.2, 'START', 2, 'print-tick', 'top', 'middle', 'central');
  s.text(x + 30, y + 4, 3.2, '1 · 2 · 3', 1.9, 'print-tick', 'top', 'middle', 'central');
}
function rectDie(s: any, x: number, y: number, w: number, d: number, z: number) {
  return `M${s.P(x, y, z)}L${s.P(x + w, y, z)}L${s.P(x + w, y + d, z)}L${s.P(x, y + d, z)}Z`;
}

/* ══ SYSTEM REQUIREMENTS — the back of the box, servers printed on board ═════ */
const back = makeScene();
{
