/* ══ QUICK-START — the folded card, unfolding, for the FAQ ═══════════════════ */
const foldcard = makeScene();
{
  const s = foldcard;
  grid(s, -8, 120, -10, 40, 16, 12);
  // four accordion panels unfolding across the table
  const n = 4, pw = 26, h = 30;
  // cast shadow: the folded panel silhouette dropped to the table along the light
  // (peaks throw further than valleys), sized to the concertina's own footprint —
  // a flat, hard-edged zigzag, not an oval
  {
    const Lx = 0.62, Ly = 0.82, ox = 1.6, oy = 2.1;
    const gp = (gx: number, gy: number, gz: number) => s.P(gx + gz * Lx + ox, gy + gz * Ly + oy, 0);
    const xs = [0, pw, 2 * pw, 3 * pw, 4 * pw];
    const zs = [0, 7, 0, 7, 0];
    let d = 'M' + gp(xs[0], 0, zs[0]);
    for (let k = 1; k < xs.length; k++) d += 'L' + gp(xs[k], 0, zs[k]);
    d += 'L' + gp(xs[xs.length - 1], h, zs[xs.length - 1]);
    for (let k = xs.length - 2; k >= 0; k--) d += 'L' + gp(xs[k], h, zs[k]);
    s.raw(d + 'Z', 'var(--shadow)', 'flat');
  }
  // a point on panel i's slanted surface, given local u,v in 0..1
  const pp = (px: number, z0: number, z1: number, u: number, v: number) =>
    [px + u * pw, v * h, z0 + u * (z1 - z0)] as [number, number, number];
  const pPoly = (px: number, z0: number, z1: number, uv: number[][], fill: string, cls: string) =>
    s.raw(uv.map((p, k) => `${k ? 'L' : 'M'}${s.P(...pp(px, z0, z1, p[0], p[1]))}`).join('') + 'Z', fill, cls);
  const pRing = (px: number, z0: number, z1: number, cu: number, cv: number, ru: number, rv: number, fill: string, cls: string) => {
    let d = '';
    for (let k = 0; k <= 24; k++) { const a = (k / 24) * Math.PI * 2; d += (k ? 'L' : 'M') + s.P(...pp(px, z0, z1, cu + ru * Math.cos(a), cv + rv * Math.sin(a))); }
    s.raw(d + 'Z', fill, cls);
  };
  // a stroke that lies in the panel's own (ramped) plane, so it never leaves the panel
  const pLine = (px: number, z0: number, z1: number, u0: number, v0: number, u1: number, v1: number, cls: string) =>
    s.raw(`M${s.P(...pp(px, z0, z1, u0, v0))}L${s.P(...pp(px, z0, z1, u1, v1))}`, 'none', cls);
  // a legend skewed into the panel's ramped plane (u,v in 0..1), centred on that point
  const panelText = (px: number, z0: number, z1: number, u: number, v: number, str: string, size: number, cls: string) => {
    const dzdu = (z1 - z0) / pw;
    const [ox, oy] = s.proj(px + u * pw, v * h, z0 + u * (z1 - z0));
    const tr = `matrix(${r2(IC)} ${r2(IS - dzdu)} ${r2(-IC)} ${r2(IS)} ${r2(ox)} ${r2(oy)})`;
    s.texts.push({ tr, s: str, size, cls, anchor: 'middle', base: 'central' });
  };
  for (let i = 0; i < n; i++) {
    const px = i * pw;
    const up = i % 2 === 0;
    const z0 = up ? 0 : 7, z1 = up ? 7 : 0;
    s.raw(`M${s.P(px, 0, z0)}L${s.P(px + pw, 0, z1)}L${s.P(px + pw, h, z1)}L${s.P(px, h, z0)}Z`, i % 2 ? '#efe2c8' : '#f6ecdb', 'flat');
    s.raw(`M${s.P(px, 0, z0)}L${s.P(px + pw, 0, z1)}L${s.P(px + pw, h, z1)}L${s.P(px, h, z0)}Z`, 'none', 'edge');
    panelText(px, z0, z1, 0.5, 0.17, `STEP ${i + 1}`, 3.6, 'step-label');
    // a small printed diagram in each panel's own plane
    if (i === 0) {                       // phone — install the app
      pPoly(px, z0, z1, [[0.40, 0.30], [0.60, 0.30], [0.60, 0.80], [0.40, 0.80]], 'none', 'diagram');
      pPoly(px, z0, z1, [[0.44, 0.37], [0.56, 0.37], [0.56, 0.70], [0.44, 0.70]], 'none', 'diagram');
      pRing(px, z0, z1, 0.5, 0.755, 0.02, 0.02, 'var(--ink)', 'diagram');
    } else if (i === 1) {                // server box — point it at your machine
      pPoly(px, z0, z1, [[0.28, 0.36], [0.72, 0.36], [0.72, 0.74], [0.28, 0.74]], 'none', 'diagram');
      pLine(px, z0, z1, 0.28, 0.50, 0.72, 0.50, 'diagram');
      pLine(px, z0, z1, 0.28, 0.62, 0.72, 0.62, 'diagram');
      pRing(px, z0, z1, 0.64, 0.43, 0.028, 0.028, 'var(--red)', 'diagram');
    } else if (i === 2) {                // disc — your library
      pRing(px, z0, z1, 0.5, 0.55, 0.23, 0.23, 'none', 'diagram');
      pRing(px, z0, z1, 0.5, 0.55, 0.07, 0.07, 'none', 'diagram');
    } else {                            // earbuds — listen
      s.raw(`M${s.P(...pp(px, z0, z1, 0.30, 0.66))}Q${s.P(...pp(px, z0, z1, 0.5, 0.30))} ${s.P(...pp(px, z0, z1, 0.70, 0.66))}`, 'none', 'diagram');
      pRing(px, z0, z1, 0.30, 0.70, 0.075, 0.075, 'none', 'diagram');
      pRing(px, z0, z1, 0.70, 0.70, 0.075, 0.075, 'none', 'diagram');
    }
    pLine(px, z0, z1, 0.15, 0.9, 0.85, 0.9, 'faint');
  }
}
