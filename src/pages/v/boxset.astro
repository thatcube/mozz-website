          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="ghost" href={GITHUB_URL}>Read the source →</a>
        </div>
      </div>

      <!-- Hero plate layers over the drawing; absent /hero/boxset.jpg never paints. -->
      <figure class="stage">
        <div class="plate" aria-hidden="true"></div>
        <svg class="art" viewBox={hero.vb(10)} role="img"
             aria-label="The full contents of a Mozz box set laid out flat in isometric on a cream table: a printed kraft carton with a red disc and a FREE FOREVER spot, a moulded plastic tray with a phone-shaped void, an owner's manual, a folded quick-start card, a registration card, two media cases in album colours, a coiled cable, a sticker sheet, a silica-gel packet and a craft knife.">
          {hero.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {hero.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
        <figcaption class="knoll-cap">Everything in the box · nothing sold separately</figcaption>
      </figure>
    </header>

    <!-- SPECIFICATIONS: the numbers, printed on the side of the box ---------- -->
    <section class="spec" aria-labelledby="spec-h">
      <div class="spec-panel">
        <div class="spec-top">
          <h2 id="spec-h">Specifications</h2>
        </div>
        <dl class="spec-rows">
          {STATS.map((st) => (
            <div class="spec-row"><dt>{st.value}</dt><dd>{st.label}</dd></div>
          ))}
        </dl>
        <div class="spec-foot">
          <svg class="spec-barcode" viewBox="0 0 120 34" role="img" aria-label="Barcode reading MOZZ FREE FOREVER.">
            {[2,1,1,3,1,1,2,1,1,2,3,1,1,2,1,1,1,3,2,1,1,2,1,1,3,1,2,1,1,2].reduce((acc: any, w, i) => {
              const bar = i % 2 === 0
                ? <rect x={acc.x} y="0" width={w * 1.4} height="26" fill="var(--ink)"/>
                : null;
              acc.x += w * 1.4 + 0.6;
              acc.bars.push(bar);
              return acc;
            }, { x: 2, bars: [] as any[] }).bars}
            <text x="60" y="33" text-anchor="middle" font-size="7" class="spec-barnum">MOZZ · FREE FOREVER · $0</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- SYSTEM REQUIREMENTS: back-of-box requirements as printed carton copy -- -->
    <section class="scene servers" aria-labelledby="srv-h">
      <div class="scene-head">
        <h2 id="srv-h">System requirements, on the back of the box.</h2>
        <p>Point Mozz at a machine you already own. It supports three server families, and the box only needs one of them to work.</p>
      </div>
      <figure class="band-art back-art">
        <svg class="art" viewBox={back.vb(6)} role="img"
             aria-label="A printed kraft carton back panel reading SYSTEM REQUIREMENTS with three blank logo wells.">
          {back.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {back.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
        <ul class="req-logos" role="list" aria-hidden="true">
          {SERVERS.map((sv, i) => (
            <li style={`left:${reqWells[i].left}%; top:${reqWells[i].top}%; width:${reqWells[i].size}%`}>
              <ServerLogo name={sv.name} size={44} brand />
            </li>
          ))}
        </ul>
      </figure>
      <div class="req-table">
        <div class="req-row req-row--head" aria-hidden="true">
          <span>Compatible with</span>
          <span>What the carton needs</span>
        </div>
        {SERVERS.map((sv) => (
          <div class="req-row">
            <span class="req-col-a">
              <span class="req-mark"><ServerLogo name={sv.name} size={26} brand /></span>
              <b>{sv.name}</b>
            </span>
            <span class="req-col-b">{sv.note}</span>
          </div>
        ))}
        <p class="req-foot">Any one is enough. Its catalog is mirrored onto the device for fast browsing and search.</p>
      </div>
    </section>

    <!-- FEATURES: the opened manual ----------------------------------------- -->
    <section class="scene manual-sec" aria-labelledby="feat-h">
      <div class="scene-head">
        <h2 id="feat-h">The manual, opened.</h2>
        <p>Six things Mozz does, called out the way a manual calls out the parts of a product — a numbered leader line to each one.</p>
      </div>

      <figure class="manual-art">
        <svg class="art" viewBox="0 0 640 430" role="img" aria-label="An owner's manual lying open: the left page an exploded diagram of the box's six parts — carton, tray, disc, cable, the phone-shaped void and earbuds — each numbered; the right page a matching numbered parts key." preserveAspectRatio="xMidYMid meet">
          <path d="M286 110 L60 142 L82 378 L286 392 L542 380 L562 138 Z" class="book-fill" style="fill:var(--shadow)"/>

          <!-- paper thickness stacked under the open book -->
          <path d="M300 362 L96 350 L96 360 L300 374 Z" class="book-fill" style="fill:#d8caa9"/>
          <path d="M300 362 L556 352 L556 362 L300 374 Z" class="book-fill" style="fill:#d8caa9"/>
          <path d="M300 366 L120 356" class="key-line"/>
          <path d="M300 366 L540 357" class="key-line"/>

          <!-- two facing pages -->
          <path d="M300 92 L74 124 L96 350 L300 362 Z" class="book-fill" style="fill:#efe5d1"/>
          <path d="M300 92 L576 120 L556 352 L300 362 Z" class="book-fill" style="fill:#fbf3e5"/>
          <!-- gutter valley + fold -->
          <path d="M292 94 L300 92 L300 362 L293 360 Z" class="book-fill" style="fill:#e3d6bb"/>
          <path d="M300 92 L300 362" class="fold"/>
          <!-- page outlines, one ink weight -->
          <path d="M300 92 L74 124 L96 350 L300 362" class="book"/>
          <path d="M300 92 L576 120 L556 352 L300 362" class="book"/>
          <!-- lifted, curled outer corners -->
          <path d="M96 350 L114 343 L107 327 L89 335 Z" class="curl"/>
          <path d="M556 352 L538 344 L545 328 L563 337 Z" class="curl"/>

          <!-- LEFT PAGE: six distinct exploded parts along a dashed assembly axis -->
          <line x1="136" y1="126" x2="136" y2="348" class="asm-axis"/>
          <g class="assembly">
            <!-- 1 · carton -->
            <g transform="translate(104 146)">
              <path d="M0 0 L26 -15 L44 -5 L18 10 Z" style="fill:#e7c89c" class="flat"/>
              <path d="M0 0 L18 10 L18 22 L0 12 Z" style="fill:#d3ac7c" class="flat"/>
              <path d="M18 10 L44 -5 L44 7 L18 22 Z" style="fill:#bd9463" class="flat"/>
              <circle cx="15" cy="-1" r="4.6" style="fill:#c80028" class="flat"/>
            </g>
            <!-- 2 · moulded tray -->
            <g transform="translate(100 184)">
              <path d="M0 0 L30 -17 L50 -6 L20 11 Z" style="fill:#d5d0c6" class="flat"/>
              <path d="M0 0 L20 11 L20 17 L0 6 Z" style="fill:#bcb7ac" class="flat"/>
              <path d="M20 11 L50 -6 L50 0 L20 17 Z" style="fill:#a19c92" class="flat"/>
              <path d="M9 -1 L25 -10 L34 -5 L18 4 Z" style="fill:#b4afa4" class="flat"/>
            </g>
            <!-- 3 · disc -->
            <g transform="translate(108 221)">
              <path d="M0 0 L32 -18 L50 -8 L18 10 Z" style="fill:#2c2b34" class="flat"/>
              <ellipse cx="24" cy="-3" rx="9" ry="5.2" style="fill:#c80028" class="flat"/>
              <ellipse cx="24" cy="-3" rx="2.4" ry="1.4" style="fill:#f7ede0" class="flat"/>
            </g>
            <!-- 4 · coiled cable -->
            <g transform="translate(112 257)">
              <ellipse cx="20" cy="-2" rx="17" ry="8.5" style="fill:none" class="flat"/>
              <ellipse cx="20" cy="-2" rx="10" ry="4.8" style="fill:none" class="flat"/>
              <path d="M35 -4 L44 -9 L48 -6 L39 -1 Z" style="fill:#2f3e4e" class="flat"/>
            </g>
            <!-- 5 · the phone-shaped void -->
            <g transform="translate(112 292)">
              <path d="M6 1 L30 -13 L44 -5 L20 9 Z" style="fill:none" class="ghost2"/>
              <path d="M13 0 L30 -10 L37 -6 L20 4 Z" style="fill:none" class="ghost2"/>
            </g>
            <!-- 6 · earbuds -->
            <g transform="translate(112 330)">
              <path d="M6 5 Q23 -16 42 3" style="fill:none" class="flat"/>
              <ellipse cx="7" cy="6" rx="4.4" ry="3.4" style="fill:#f0e6d2" class="flat"/>
              <ellipse cx="42" cy="4" rx="4.4" ry="3.4" style="fill:#f0e6d2" class="flat"/>
            </g>
          </g>

          <!-- left-page callouts: near-horizontal leaders to numbered dots, none cross -->
          {[146, 185, 221, 257, 292, 330].map((cy, i) => (
            <g class="tag">
              <line x1="170" y1={cy} x2="221" y2={cy} class="leader"/>
              <circle cx="232" cy={cy} r="11" class="tag-dot"/>
              <text x="232" y={cy + 4} text-anchor="middle" font-size="12" class="tag-num">{i + 1}</text>
            </g>
          ))}

          <!-- RIGHT PAGE: the printed parts key, numbers matching the diagram -->
          <text x="330" y="120" font-size="14" class="page-h">PARTS KEY</text>
          {[[152,540,470],[188,512,436],[224,536,486],[260,496,452],[296,528,470],[332,470,412]].map(([ky, e1, e2], i) => (
            <g class="keyrow">
              <circle cx="338" cy={ky} r="9" class="key-num"/>
              <text x="338" y={ky + 4} text-anchor="middle" font-size="11" class="key-numt">{i + 1}</text>
              <line x1="356" y1={ky - 2} x2={e1} y2={ky - 2} class="key-rule"/>
              <line x1="356" y1={ky + 5} x2={e2} y2={ky + 5} class="key-rule"/>
            </g>
          ))}
        </svg>
      </figure>

      <div class="parts-key">
        <span class="parts-key-tag">Parts key · Model M-01</span>
        <ol class="parts-list" role="list">
          {FEATURES.map((ft, i) => (
            <li>
              <span class="part-ref">{i + 1}</span>
              <p><b class="part-name">{ft.title}.</b> {ft.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- OWNERSHIP: the warranty card ---------------------------------------- -->
    <section class="scene own" aria-labelledby="own-h">
      <div class="scene-head">
        <h2 id="own-h">The warranty card you never post back.</h2>
        <p>Every box came with a card to fill in and mail. This one has nothing on it, because there is nobody to send it to.</p>
      </div>
      <figure class="band-art">
        <svg class="art" viewBox={warranty.vb(6)} role="img"
             aria-label="An oversized guarantee and ownership card drawn in isometric, its mail-back lines all crossed out, stamped with a red YOURS · GPL-3.0 · FOREVER seal.">
          {warranty.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {warranty.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <div class="guarantee">
        <span class="guarantee-tag">The guarantee, in full</span>
        <ul class="own-list" role="list">
          {OWNERSHIP.map((o) => (
            <li><h3>{o.title}</h3><p>{o.body}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ADAPTIVE COLOUR: the printed colour chart + the real screen ---------- -->
    <section class="scene now" aria-labelledby="now-h">
      <div class="scene-head">
        <h2 id="now-h">One product, recoloured by what is playing.</h2>
        <p>Mozz repaints its whole interface from the artwork of the current record — printed here as the colour-selection chart off the back of the box, with the real screen doing it live alongside.</p>
      </div>

      <div class="now-grid">
        <figure class="chart-art">
          <svg class="art" viewBox={swatch.vb(6)} role="img"
               aria-label="A printed colour-selection chart on kraft card: a two-by-three grid of six swatch chips — violet, red, warm, cool, sepia and silver — each a small Mozz disc on a colour block, titled COLOUR CHART, MOZZ REPRINTS ITSELF FROM THE RECORD.">
            {swatch.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
            {swatch.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
          </svg>
        </figure>

        <figure class="chart-phone">
          <Phone name="mozz-nowplaying" width={224} priority sizes="224px"
                 class="bx-phone" alt="The Mozz now-playing screen, its interface tinted violet to match the album art." />
          <figcaption class="chart-cap">The real screen, tinting itself live from the album art.</figcaption>
        </figure>
      </div>
    </section>

    <!-- FAQ: the quick-start card ------------------------------------------- -->
    <section class="faq" aria-labelledby="faq-h">
      <div class="faq-head">
        <h2 id="faq-h">The quick-start card, unfolded</h2>
      </div>
      <figure class="band-art fold-band" aria-hidden="true">
        <svg class="art" viewBox={foldcard.vb(6)}>
          {foldcard.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {foldcard.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <p class="faq-tag">Troubleshooting · from the manual</p>
      <dl class="faq-manual">
        {FAQS.map((qa, i) => (
          <div class="faq-item">
            <dt><span class="faq-num">{`0${i + 1}`}</span><span class="faq-q">{qa.q}</span></dt>
            <dd>{qa.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- FOOTER --------------------------------------------------------------- -->
    <footer class="foot">
      <div class="foot-mark">
        <Mark size={22} decorative />
        <span class="wordmark">{NAME}</span>
      </div>
      <p class="foot-line">{TAGLINE} {SUBLINE}</p>
      <p class="foot-meta">
        Free forever · GPL-3.0 with an App Store Exception · <a href={GITHUB_URL}>source on GitHub</a>
      </p>
      <div class="foot-stamp" aria-hidden="true">
        <svg viewBox="0 0 128 128" role="img">
          <defs>
            <path id="stamp-top" d="M 16 64 A 48 48 0 0 1 112 64"/>
            <path id="stamp-bot" d="M 18 64 A 46 46 0 0 0 110 64"/>
          </defs>
          <g class="stamp">
            <circle cx="64" cy="64" r="54" class="stamp-ring"/>
            <circle cx="64" cy="64" r="46" class="stamp-ring stamp-ring--thin"/>
            <text class="stamp-arc"><textPath href="#stamp-top" startOffset="50%">PRINTED IN THE OPEN</textPath></text>
            <text class="stamp-arc stamp-arc--bot"><textPath href="#stamp-bot" startOffset="50%">FREE FOREVER</textPath></text>
            <line x1="30" y1="64" x2="40" y2="64" class="stamp-rule"/>
            <line x1="88" y1="64" x2="98" y2="64" class="stamp-rule"/>
            <text x="64" y="58" class="stamp-mid">M-01</text>
            <text x="64" y="74" class="stamp-sub">GPL-3.0</text>
          </g>
        </svg>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .bx {
    --cream: #f7ede0;
    --cream-hi: #fdf7ee;
    --card: #d3ac7c;
    --card-ink: #8a6a44;
    --slate: #2f3e4e;
    --slate-hi: #3c4f63;
    --red: #c80028;
    --gold: #e0a94e;
    --ink: #2b2117;
    --ink-soft: #6a584a;
    --hole: #efe2cd;
    --shadow: rgba(70, 52, 34, 0.15);
    --guide: rgba(120, 92, 60, 0.32);

    --hero-plate: url('/hero/boxset.jpg');

    background:
      radial-gradient(128% 92% at 82% 4%, #fef8ee 0%, var(--cream) 46%, #eddfc9 100%);
    color: var(--ink);
    font-family: 'Satoshi', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.62;
    overflow-x: clip;
    position: relative;
    isolation: isolate;
  }

  /* riso grain */
  .bx::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.8;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='150'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.6'/></feComponentTransfer></filter><rect width='150' height='150' filter='url(%23n)'/></svg>");
    background-size: 150px 150px;
  }

  /* one outline weight everywhere */
  .art { width: 100%; height: auto; overflow: visible; }
  .art path, .art circle, .art ellipse, .art line, .art rect {
    vector-effect: non-scaling-stroke;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .art .flat { stroke: none; }
  .art .edge { fill: none; }
  .art .guide { stroke: var(--guide); stroke-width: 1; }
  .art .faint { stroke: rgba(43,33,23,0.3); stroke-width: 1.1; }
  .art .seam-d { stroke: rgba(10,8,5,0.4); stroke-width: 1.2; }
  .art .seam-l { stroke: rgba(255,250,240,0.5); stroke-width: 1.2; }
  .art .screw { stroke: rgba(20,14,8,0.6); stroke-width: 1.1; }
  .art .flute { stroke: rgba(43,33,23,0.42); stroke-width: 1.05; }
  .art .cable { stroke: var(--slate); stroke-width: 3; fill: none; }
  .art .tape { stroke: rgba(120,92,60,0.5); stroke-width: 1; }
  .art .blade { stroke: var(--ink); }
  .art .diagram { stroke: rgba(43,33,23,0.85); stroke-width: 2.1; fill: none; }
  .art .burst { stroke: #7a0018; stroke-width: 1.6; }
  .art .diecut { stroke: rgba(43,33,23,0.4); stroke-width: 1; stroke-dasharray: 3 3; fill: none; }
  .art .perf { stroke: rgba(43,33,23,0.35); stroke-width: 1; }
  .art .strike { stroke: rgba(120,20,30,0.6); stroke-width: 1.6; fill: none; }
  .art .seal { stroke: rgba(255,245,235,0.6); stroke-width: 1.4; fill: none; }
  .art .ghost { stroke: rgba(43,33,23,0.35); stroke-width: 1.3; fill: none; }
  .art .fold { stroke: rgba(43,33,23,0.35); stroke-width: 1.2; fill: none; }
  .art .asm-axis { stroke: rgba(43,33,23,0.4); stroke-width: 1.1; stroke-dasharray: 4 4; }
  .art .ghost2 { stroke: rgba(43,33,23,0.4); stroke-width: 1.4; stroke-dasharray: 4 3; fill: none; }

  /* printed type on surfaces */
  .art text { fill: var(--ink); font-family: 'Khand', sans-serif; letter-spacing: 0.03em; }
  .art .print-mark { fill: var(--red); font-family: 'Clash Display', sans-serif; font-weight: 700; letter-spacing: -0.01em; }
  .art .print-hero-w { fill: #fdf3ea; font-family: 'Clash Display', sans-serif; font-weight: 700; letter-spacing: 0em; }
  .art .print-w { fill: #fdf3ea; font-family: 'Clash Display', sans-serif; font-weight: 700; }
  .art .print-body { fill: #fdf3ea; text-transform: uppercase; letter-spacing: 0.04em; }
  .art .print-tick { fill: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.1em; }
  .art .step-label { fill: var(--ink); font-family: 'Khand', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .art .print-tiny { fill: var(--card-ink); text-transform: uppercase; letter-spacing: 0.08em; }
  .art .burst-t { fill: #fdf3ea; font-family: 'Clash Display', sans-serif; font-weight: 700; text-transform: uppercase; }
  .art .seal-t { fill: #fdf3ea; text-transform: uppercase; letter-spacing: 0.06em; }
  .art .ghost-t { fill: rgba(43,33,23,0.45); text-transform: uppercase; letter-spacing: 0.1em; }

  h1, h2, h3 { font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
  h1, h2 { font-family: 'Clash Display', 'Satoshi', sans-serif; }

  /* ── hero ── */
  .hero {
    max-width: 1300px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(1rem, 2vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
  }
  .lockup { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.4rem; }
  .wordmark { font-weight: 900; font-size: 1.35rem; letter-spacing: -0.03em; font-family: 'Clash Display', sans-serif; }
  .lockup-tick {
    font-family: 'Khand', sans-serif; text-transform: uppercase; letter-spacing: 0.14em;
    font-size: 0.7rem; color: var(--ink-soft); border-left: 1px solid var(--guide);
    padding-left: 0.6rem; margin-left: 0.2rem;
  }
  .hero h1 { font-size: clamp(2.4rem, 5.4vw, 4.3rem); max-width: 15ch; margin-bottom: 1rem; }
  .lede { max-width: 42ch; color: #4a3a2c; font-size: 1.06rem; }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .store {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--slate); color: var(--cream-hi);
    padding: 0.7rem 1.15rem; border-radius: 12px; font-weight: 600;
    box-shadow: 4px 5px 0 rgba(47, 62, 78, 0.28);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
