  s.line([bx + 6, by + 10, bh], [bx + 70, by + 10, bh], 'faint');
  // three printed panels, one per server (logo drawn by the real component beneath)
  for (let i = 0; i < 3; i++) {
    const px = bx + 8 + i * 39;
    s.quad(px, by + 14, 34, 34, bh + 0.01, '#fbf3e5', 'flat');
