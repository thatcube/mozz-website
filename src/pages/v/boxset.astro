  for (let j = 0; j <= 7; j++) { s.ring(sx0, sy0 + (j / 7) * sd, 1.32, 0.3, 'none', 'perf', 6); s.ring(sx0 + sw, sy0 + (j / 7) * sd, 1.32, 0.3, 'none', 'perf', 6); }
  s.fan(sx0 + sw / 2, sy0 + sd * 0.42, 1.33, 3, FAN_RED, 20, 0.3);
