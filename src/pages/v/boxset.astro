---
/**
 * VARIANT — BOX SET
 *
 * Mozz drawn as a physical product it never was: a boxed piece of 1994 consumer
 * electronics. Everything comes in the one carton — the argument for "every
 * feature is in the free app, there is no paid tier".
 *
 * Illustration-led, and it inherits diorama's craft exactly: one true-axonometric
 * projection (makeScene → P), a single non-scaling outline weight everywhere, flat
 * screen-print colour with one hard value step per face, construction guide lines
 * left un-erased, and a light riso grain. New primitives here are printed-carton
 * detail: barcodes, edge fluting on cut board, die-cut sticker sheets, moulded
 * tray recesses with lit draft angles, and legends baked flat into each surface.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const R6 = Math.PI / 6;
const IC = Math.cos(R6);
const IS = Math.sin(R6);
const r2 = (n: number) => Math.round(n * 100) / 100;

type Part = { d: string; fill: string; cls?: string };
type Txt = { tr: string; s: string; size: number; cls: string; anchor: string; base: string };

function makeScene() {
  let minX = 1e9, minY = 1e9, maxX = -1e9, maxY = -1e9;
  const parts: Part[] = [];
  const texts: Txt[] = [];

  const proj = (x: number, y: number, z: number): [number, number] => {
    const sx = (x - y) * IC;
    const sy = (x + y) * IS - z;
    if (sx < minX) minX = sx; if (sx > maxX) maxX = sx;
    if (sy < minY) minY = sy; if (sy > maxY) maxY = sy;
    return [sx, sy];
  };
  const P = (x: number, y: number, z: number) => {
    const [sx, sy] = proj(x, y, z);
    return `${r2(sx)} ${r2(sy)}`;
  };
  const path = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${P(p[0], p[1], p[2])}`).join('') + 'Z';
  const poly = (pts: number[][], fill: string, cls?: string) => parts.push({ d: path(pts), fill, cls });

  const box = (x: number, y: number, z: number, w: number, d: number, h: number,
    c: { top: string; left: string; right: string }, cls?: string) => {
    poly([[x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]], c.top, cls);
    poly([[x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]], c.left, cls);
    poly([[x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]], c.right, cls);
  };
  const quad = (x: number, y: number, w: number, d: number, z: number, fill: string, cls?: string) =>
    poly([[x, y, z], [x + w, y, z], [x + w, y + d, z], [x, y + d, z]], fill, cls);
  const faceX = (x: number, y0: number, y1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x, y0, z0], [x, y1, z0], [x, y1, z1], [x, y0, z1]], fill, cls);
  const faceY = (y: number, x0: number, x1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x0, y, z0], [x1, y, z0], [x1, y, z1], [x0, y, z1]], fill, cls);

  const ring = (cx: number, cy: number, z: number, r: number, fill: string, cls?: string, n = 48) => {
    let d = '';
    for (let i = 0; i <= n; i++) { const a = (i / n) * Math.PI * 2; d += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z); }
    parts.push({ d: d + 'Z', fill, cls });
  };

  // the stylised diffraction disc — the 8-bit red CD, printed flat as a fan of wedges
  const fan = (cx: number, cy: number, z: number, r: number, palette: string[], seg = 32, spin = 0) => {
    const c = P(cx, cy, z);
    for (let i = 0; i < seg; i++) {
      const a0 = spin + (i / seg) * Math.PI * 2, a1 = spin + ((i + 1) / seg) * Math.PI * 2;
      const pa = P(cx + r * Math.cos(a0), cy + r * Math.sin(a0), z);
      const pb = P(cx + r * Math.cos(a1), cy + r * Math.sin(a1), z);
      parts.push({ d: `M${c}L${pa}L${pb}Z`, fill: palette[i % palette.length], cls: 'flat' });
    }
    ring(cx, cy, z, r, 'none', 'edge');
    ring(cx, cy, z, r * 0.30, '#f7ede0', 'edge');
    ring(cx, cy, z, r * 0.18, 'rgba(0,0,0,0.06)', 'flat');
    ring(cx, cy, z, r * 0.11, 'var(--hole)', 'edge');
  };

  const line = (a: number[], b: number[], cls = 'guide') =>
    parts.push({ d: `M${P(a[0], a[1], a[2])}L${P(b[0], b[1], b[2])}`, fill: 'none', cls });

  const seam = (a: number[], b: number[], dir: 'z' | 'x' | 'y' = 'z', off = 0.5) => {
    line(a, b, 'seam-d');
    const o = dir === 'z' ? [0, 0, off] : dir === 'x' ? [off, 0, 0] : [0, off, 0];
    line([a[0] + o[0], a[1] + o[1], a[2] + o[2]], [b[0] + o[0], b[1] + o[1], b[2] + o[2]], 'seam-l');
  };

  const screw = (cx: number, cy: number, z: number, r = 1.1) => {
    ring(cx, cy, z, r, 'rgba(0,0,0,0.10)', 'flat', 12);
    ring(cx, cy, z, r, 'none', 'screw', 12);
    line([cx - r * 0.6, cy - r * 0.6, z], [cx + r * 0.6, cy + r * 0.6, z], 'screw');
  };

  const cyl = (cx: number, cy: number, z: number, r: number, h: number, cTop: string, cBody: string, cls?: string) => {
    const aL = 3 * Math.PI / 4, aR = -Math.PI / 4, step = Math.PI / 20;
    let d = 'M' + P(cx + r * Math.cos(aL), cy + r * Math.sin(aL), z + h);
    for (let a = aL; a >= aR - 1e-6; a -= step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h);
    d += 'L' + P(cx + r * Math.cos(aR), cy + r * Math.sin(aR), z);
    for (let a = aR; a <= aL + 1e-6; a += step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z);
    parts.push({ d: d + 'Z', fill: cBody, cls });
    let t = '';
    for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; t += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h); }
    parts.push({ d: t + 'Z', fill: cTop, cls });
  };

  const raw = (d: string, fill: string, cls?: string) => parts.push({ d, fill, cls });

  // Legend printed flat on a face; skewed into that face's isometric plane.
  const text = (x: number, y: number, z: number, s: string, size: number,
    cls = 'legend', plane: 'top' | 'topL' | 'left' | 'right' = 'top',
    anchor = 'middle', base = 'auto') => {
    const [sx, sy] = proj(x, y, z);
    let a = IC, b = IS, c = -IC, d = IS;
    if (plane === 'topL') { a = -IC; b = IS; c = IC; d = IS; }
    else if (plane === 'left') { a = IC; b = IS; c = 0; d = 1; }
    else if (plane === 'right') { a = -IC; b = IS; c = 0; d = 1; }
    const tr = `matrix(${r2(a)} ${r2(b)} ${r2(c)} ${r2(d)} ${r2(sx)} ${r2(sy)})`;
    texts.push({ tr, s, size, cls, anchor, base });
  };

  const vb = (pad = 6) => `${r2(minX - pad)} ${r2(minY - pad)} ${r2(maxX - minX + pad * 2)} ${r2(maxY - minY + pad * 2)}`;
  const bounds = () => ({ minX, minY, maxX, maxY });

  return { parts, texts, poly, box, quad, faceX, faceY, ring, fan, line, seam, screw, cyl, raw, text, vb, bounds, proj, P };
}

/* ── flat palettes — disciplined: cardboard tan, warm grey, slate blue, red ── */
const CARD  = { top: '#e7c89c', left: '#d3ac7c', right: '#bd9463' }; // kraft carton
const CARD2 = { top: '#dcb987', left: '#c69f6b', right: '#ae8654' }; // darker board
const CREAMB = { top: '#fbf3e5', left: '#ecdec7', right: '#dccbad' }; // printed paper
const REDB  = { top: '#d6002b', left: '#ad0021', right: '#800016' };
const TRAY  = { top: '#d5d0c6', left: '#bcb7ac', right: '#a19c92' };  // moulded warm grey
const TRAY2 = { top: '#c7c2b7', left: '#ada89d', right: '#928d83' };
const PAPER = { top: '#f3ead6', left: '#e2d6bd', right: '#cebf9f' };
const WHITEB = { top: '#f5efe4', left: '#e3dbcb', right: '#d3c8b3' };
const DARK  = { top: '#2a2932', left: '#201f27', right: '#14131a' };

const FAN_RED   = ['#c80028', '#e8703a', '#f3e2c4', '#a30220', '#e0a94e', '#d6486a'];
const FAN_WARM  = ['#e9b25a', '#e8703a', '#f3e2c4', '#d98f34', '#f0d49a', '#e57d3f', '#c99a45'];
const FAN_COOL  = ['#49a08d', '#3b6ea5', '#e79bb0', '#63b39c', '#8fb2d8', '#cfd9a6', '#4f96b3'];
const FAN_SILV  = ['#c6ccd4', '#9aa4b0', '#e7ebef', '#aeb7c2', '#dfe4ea', '#8b96a4'];
const FAN_SEPIA = ['#c98b4e', '#9c6233', '#e7c79a', '#b5793f', '#dcb583', '#8a5a30'];
const FAN_VIOLET = ['#7a3bd6', '#b25be0', '#efe0f6', '#5c2ba0', '#c98fe6', '#8f4de0'];

/* ── shared scene helpers ─────────────────────────────────────────────────── */
const grid = (s: any, x0: number, x1: number, y0: number, y1: number, stepX: number, stepY: number, z = 0) => {
  for (let y = y0; y <= y1 + 1e-6; y += stepY) s.line([x0, y, z], [x1, y, z]);
  for (let x = x0; x <= x1 + 1e-6; x += stepX) s.line([x, y0, z], [x, y1, z]);
};
const shadow = (s: any, cx: number, cy: number, r: number, ry = 1) => {
  let d = '';
  for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; d += (i ? 'L' : 'M') + s.P(cx + r * Math.cos(a), cy + r * ry * Math.sin(a), -0.2); }
  s.raw(d + 'Z', 'var(--shadow)', 'flat');
};
// corrugated fluting on a cut cardboard edge: short ticks along an edge in the +z run
const flute = (s: any, x: number, y: number, z0: number, z1: number, plane: 'x' | 'y', len: number, n: number, dir = 1) => {
  for (let i = 0; i < n; i++) {
    const z = z0 + ((i + 0.5) / n) * (z1 - z0);
    if (plane === 'x') s.line([x, y, z], [x, y + len * dir, z], 'flute');
    else s.line([x, y, z], [x + len * dir, y, z], 'flute');
  }
};
// printed barcode on a horizontal (top) plane, bars running along +y
const barcodeTop = (s: any, x0: number, y0: number, y1: number, z: number, units: number) => {
  const pat = [2, 1, 1, 2, 1, 3, 1, 1, 2, 1, 1, 1, 3, 1, 2, 1, 1, 2, 1, 1, 3, 1, 1, 2, 1, 2, 1, 1, 1, 2];
  let x = x0, i = 0;
  while (x < x0 + units && i < pat.length) {
    const w = pat[i] * 0.35;
    if (i % 2 === 0) s.raw(`M${s.P(x, y0, z)}L${s.P(x + w, y0, z)}L${s.P(x + w, y1, z)}L${s.P(x, y1, z)}Z`, 'var(--ink)', 'flat');
    x += w + 0.18; i++;
  }
};
// printed barcode on a right-facing (x=const) plane, bars running along +z
const barcodeRight = (s: any, x: number, y0: number, z0: number, z1: number, units: number) => {
  const pat = [2, 1, 1, 2, 1, 3, 1, 1, 2, 1, 1, 3, 1, 2, 1, 1, 2, 1, 1, 3, 1, 1, 2, 1, 2, 1];
  let y = y0, i = 0;
  while (y < y0 + units && i < pat.length) {
    const w = pat[i] * 0.34;
    if (i % 2 === 0) s.raw(`M${s.P(x, y, z0)}L${s.P(x, y + w, z0)}L${s.P(x, y + w, z1)}L${s.P(x, y, z1)}Z`, 'var(--ink)', 'flat');
    y += w + 0.17; i++;
  }
};
// a "FREE FOREVER" price-spot starburst on a face
const burst = (s: any, cx: number, cy: number, z: number, r: number, plane: 'top' | 'left' | 'right') => {
  const n = 12; let d = '';
  for (let i = 0; i <= n * 2; i++) {
    const a = (i / (n * 2)) * Math.PI * 2;
    const rr = i % 2 ? r * 0.72 : r;
    let px = cx, py = cy, pz = z;
    if (plane === 'top') { px = cx + rr * Math.cos(a); py = cy + rr * Math.sin(a); }
    else if (plane === 'left') { px = cx + rr * Math.cos(a); pz = z + rr * Math.sin(a); }
    else { py = cy + rr * Math.cos(a); pz = z + rr * Math.sin(a); }
    d += (i ? 'L' : 'M') + s.P(px, py, pz);
  }
  s.raw(d + 'Z', '#c80028', 'burst');
};

/* ══ HERO — the whole box, opened, its contents knolled on the table ═════════ */
const hero = makeScene();
{
  const s = hero;
  grid(s, -30, 210, -28, 156, 22, 16);

  /* cast shadows for the whole layout */
  shadow(s, 34, 40, 44, 0.92);
  shadow(s, 120, 44, 52, 0.9);
  shadow(s, 30, 110, 24); shadow(s, 70, 116, 20); shadow(s, 104, 116, 16);
  shadow(s, 150, 118, 22); shadow(s, 188, 120, 14);

  /* ── THE CARTON (closed, printed) — the product package ── */
  const cx = 6, cy = 6, cw = 52, cd = 44, ch = 50;
  s.box(cx, cy, 0, cw, cd, ch, CARD);
  flute(s, cx, cy, 0, ch, 'x', 1.1, 26);            // fluting on the cut left corner
  // top: red header, disc mark, wordmark, small barcode
  s.quad(cx, cy, cw, cd, ch, '#f4ecdd', 'flat');
  s.faceY(cy + 0.02, cx, cx + cw, ch, ch, 'none', 'edge');
  s.fan(cx + 12, cy + 12, ch, 8, FAN_RED, 26, 0.2);
  s.text(cx + 24, cy + 8, ch, 'MOZZ', 6, 'print-mark', 'top', 'start', 'central');
  s.text(cx + 24, cy + 14.5, ch, 'MUSIC PLAYER · MODEL M-01', 1.9, 'print-tick', 'top', 'start', 'central');
  barcodeTop(s, cx + 34, cy + 34, cy + 41, ch, 15);
  s.text(cx + 34, cy + 42.4, ch, 'MOZZ · FREE · 0000', 1.5, 'print-tick', 'top', 'start', 'central');
  // front face (left, faces lower-left): big printing + FREE FOREVER spot
  const fy = cy + cd;
  s.faceY(fy + 0.02, cx, cx + cw, ch - 15, ch, REDB.left, 'flat');
  s.text(cx + cw / 2, fy + 0.04, ch - 7.5, 'MOZZ', 9, 'print-hero-w', 'left', 'middle', 'central');
  s.text(cx + cw / 2, fy + 0.04, ch - 20, 'One app for your music,', 2.4, 'print-body', 'left', 'middle', 'central');
  s.text(cx + cw / 2, fy + 0.04, ch - 24, 'wherever it lives.', 2.4, 'print-body', 'left', 'middle', 'central');
  s.fan(cx + 12, fy + 0.05, 12, 7, FAN_RED, 24, 0.5);   // printed disc on front
  burst(s, cx + 40, fy + 0.06, 11, 8, 'left');
  s.text(cx + 40, fy + 0.08, 12.6, 'FREE', 2.4, 'burst-t', 'left', 'middle', 'central');
  s.text(cx + 40, fy + 0.08, 9.6, 'FOREVER', 1.7, 'burst-t', 'left', 'middle', 'central');
  // right face (side): spec strip + vertical barcode
  const rx = cx + cw;
  s.faceX(rx + 0.02, cy, cy + cd, 0, 12, '#f4ecdd', 'flat');
  s.text(rx + 0.04, cy + 3, 9, 'SPECIFICATIONS', 1.9, 'print-tick', 'right', 'start', 'central');
  s.text(rx + 0.04, cy + 3, 6.3, 'PLEX · JELLYFIN · NAVIDROME', 1.7, 'print-tiny', 'right', 'start', 'central');
  s.text(rx + 0.04, cy + 3, 3.6, 'iOS · SwiftUI · GPL-3.0', 1.7, 'print-tiny', 'right', 'start', 'central');
  barcodeRight(s, rx + 0.04, cy + 30, 2, 10, 12);

  /* ── THE MOULDED TRAY — a recess shaped for each item, incl. a phone void ── */
  const tx = 74, ty = 4, tw = 92, td = 74, th = 7;
  s.box(tx, ty, 0, tw, td, th, TRAY);
  seamStep(s, tx, ty, tw, td, th);
  // recesses
  recess(s, tx + 5, ty + 5, 30, 30, th);       // media well
  recess(s, tx + 40, ty + 5, 20, 30, th);      // small parts
  recess(s, tx + 5, ty + 40, 26, 28, th);      // manual well
  recess(s, tx + 64, ty + 5, 22, 62, th);      // cable channel
  // the phone-shaped void — the good gag: the box holds software
  const px0 = tx + 36, py0 = ty + 40, pw = 22, pd = 44;
  s.quad(px0, py0, pw, pd, th - 1.4, '#b9b4a9', 'flat');
  s.faceX(px0, py0, py0 + pd, th - 1.4, th, TRAY2.right, 'flat');
  s.faceY(py0, px0, px0 + pw, th - 1.4, th, TRAY2.left, 'flat');
  s.ring(px0 + pw / 2, py0 + 8, th - 1.38, 3, 'none', 'ghost');     // speaker slot ghost
  s.text(px0 + pw / 2, py0 + pd / 2, th - 1.36, 'YOUR PHONE', 2.1, 'ghost-t', 'top', 'middle', 'central');
  s.text(px0 + pw / 2, py0 + pd / 2 + 5, th - 1.36, 'GOES HERE', 2.1, 'ghost-t', 'top', 'middle', 'central');

  /* items sitting in / around the tray recesses --------------------------- */
  // media cases in the media well — the adaptive album colour
  mediaCase(s, tx + 7, ty + 7, FAN_RED, 'ALBUM');
  mediaCase(s, tx + 9, ty + 20, FAN_WARM, 'RADIO');

  /* ── LOWER ROW: manual, quick-start, warranty, stickers, cable, sundries ── */
  // the manual (a real booklet, printed cover)
  const mx = 6, my = 96, mw = 34, md = 44;
  s.box(mx, my, 0, mw, md, 4, CREAMB);
  s.seam([mx, my, 4], [mx, my + md, 4], 'x', 0.5);       // spine
  for (let i = 0; i < 5; i++) s.line([mx + 1.4 + i * 0.5, my, 4 - 0.4 - i * 0.5], [mx + 1.4 + i * 0.5, my + md, 4 - 0.4 - i * 0.5], 'faint'); // page block
  s.quad(mx + 6, my + 5, 22, 12, 4.01, 'none', 'edge');
  s.fan(mx + 12, my + 11, 4.02, 5, FAN_RED, 22, 0.3);
  s.text(mx + 22, my + 8, 4.02, 'MOZZ', 3.4, 'print-mark', 'top', 'start', 'central');
  s.text(mx + 20, my + 22, 4.02, 'OWNER\u2019S MANUAL', 2.2, 'print-tick', 'top', 'middle', 'central');
  s.text(mx + 20, my + 27, 4.02, 'READ ME FIRST', 1.7, 'print-tick', 'top', 'middle', 'central');
  flute(s, mx + mw, my, 0, 4, 'x', 0.7, 6, -1);

  // folded quick-start card (accordion), tented open
  const qx = 48, qy = 100;
  quickStart(s, qx, qy);

  // warranty / registration card
  const wx = 92, wy = 100, ww = 30, wd = 22;
  s.box(wx, wy, 0, ww, wd, 0.8, PAPER);
  s.quad(wx, wy, ww, wd, 0.81, 'none', 'edge');
  s.text(wx + 2, wy + 4, 0.82, 'REGISTRATION CARD', 1.9, 'print-tick', 'top', 'start', 'central');
  s.line([wx + 2, wy + 9, 0.82], [wx + ww - 2, wy + 9, 0.82], 'faint');
  s.line([wx + 2, wy + 13, 0.82], [wx + ww - 2, wy + 13, 0.82], 'faint');
  s.box(wx + ww - 8, wy + wd - 8, 0.8, 6, 6, 0.3, WHITEB);   // stamp box
  s.text(wx + ww - 5, wy + wd - 5, 1.12, 'NO\nACCT', 1.4, 'print-tiny', 'top', 'middle', 'central');
  s.text(wx + 2, wy + 18, 0.82, 'NOTHING TO REGISTER', 1.5, 'print-tick', 'top', 'start', 'central');

  // sticker sheet (always a sticker sheet) — die-cut discs + ZZ + wordmark
  const kx = 126, ky = 96, kw = 34, kd = 30;
  s.box(kx, ky, 0, kw, kd, 0.6, WHITEB);
  s.quad(kx + 1, ky + 1, kw - 2, kd - 2, 0.61, 'none', 'diecut');
  s.fan(kx + 8, ky + 9, 0.62, 5.5, FAN_RED, 22, 0.2); s.ring(kx + 8, ky + 9, 0.62, 6.4, 'none', 'diecut');
  s.fan(kx + 22, ky + 8, 0.62, 4, FAN_COOL, 20, 0.6); s.ring(kx + 22, ky + 8, 0.62, 4.8, 'none', 'diecut');
  s.text(kx + 26, ky + 20, 0.62, 'MOZZ', 3, 'print-mark', 'top', 'middle', 'central'); s.raw(rectDie(s, kx + 18, ky + 16, 16, 8, 0.62), 'none', 'diecut');
  s.text(kx + 8, ky + 22, 0.62, 'ZZ', 3.2, 'print-mark', 'top', 'middle', 'central');
  s.text(kx + 2, ky - 1.4, 0.6, 'STICKERS', 1.5, 'print-tick', 'top', 'start', 'central');

  // coiled cable with a tie (curves with weight, connects to a jack)
  let cab = 'M' + s.P(150, 12, 4);
  for (let i = 1; i <= 90; i++) {
    const t = i / 90;
    const ang = t * Math.PI * 7;
    const rad = 9 * (1 - t * 0.5);
    const xx = 150 + Math.cos(ang) * rad;
    const yy = 40 + Math.sin(ang) * rad * 0.9 + t * 2;
    cab += 'L' + s.P(xx, yy, 1.2);
  }
  s.raw(cab, 'none', 'cable');
  s.box(148, 44, 0.4, 3, 3, 1.8, DARK);                 // cable tie
  s.box(158, 10, 0, 4, 3, 3, DARK);                     // 3.5mm jack barrel
