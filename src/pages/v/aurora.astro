---
/**
 * VARIANT — AURORA
 * See the design contract in the HTML comment at the top of <main>.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import {
  NAME, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Your whole library, in a better light.';

// The interface takes its colour from the artwork of whatever is playing, so a
// fanned spectrum of real screens is the clearest way to show that adaptive tint.
const SPECTRUM = [
  'mozz-nowplaying',
  'mozz-album-red',
  'mozz-album-warm',
  'mozz-artist',
  'mozz-playlist',
];

// Stats, pulled from the single source and woven into context rather than
// lined up as a metric row.
const perfSearch = STATS[0]; // 16ms — search across 100,000 tracks
const perfStart = STATS[1];  // 75ms — from tap to first note
const serverStat = STATS[2]; // 3 — compatible server families
const freeStat = STATS[3];   // $0 — forever, and open source
---

<Layout
  title={`${NAME} — your whole library, in a better light`}
  description="A free, open source music app for Plex, Jellyfin and Navidrome. Your library, your server, your files — offline or on, with no account and nothing tracking you."
  themeColor="#f2eefc"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="au">
    <!--
      THESIS: Morning light through glass. The set's calm, premium counterweight —
      genuine serenity earned with air, real material and one precise warm note,
      not a pastel SaaS wash.
      OWN-WORLD: Near-white violet ground under a layered, colour-mixing mesh of
      periwinkle, lilac and warm blush. Panels are real glass — edge highlight,
      thickness, offset cast shadow — floating over colour worth refracting. Brand
      red is the single saturated note, so it lands every time.
      STORY: The music is already yours, on your own server; Mozz brings the whole
      catalogue into the light, offline or on, with nobody in the loop.
      FIRST VIEWPORT: An asymmetric hero — a real album screen on a phone and a
      glass library card on the right, the wordmark, headline, lede and a red call
      to action on the left, all over the mesh.
      FORM: Bright room, soft light on a pale surface, and a great deal of air.
    -->

    <VariantBar slug="aurora" tone="cool" />

    <div class="field" aria-hidden="true"></div>

    <!-- HERO ---------------------------------------------------------------- -->
    <header class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="lockup">
            <Mark size={26} decorative />
            <span class="wordmark">{NAME}</span>
          </div>

          <h1>{HEADLINE}</h1>

          <p class="lede">
            Mozz plays the music already sitting on your own Plex, Jellyfin or
            Navidrome server — every track, offline or on. No account to make,
            nothing to subscribe to, and nothing watching what you play.
          </p>

          <div class="actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="ghost" href={GITHUB_URL}>Read the source</a>
          </div>
        </div>

        <!--
          The stage floats a real screenshot and a glass library card over the
          local light. It also layers a hero plate: if /hero/aurora.jpg is
          supplied later it enriches the light; with no file it simply never
          paints and the composed scene stands on its own.
        -->
        <div class="stage" aria-hidden="true">
          <div class="hero-device">
            <Phone
              name="mozz-album-warm"
              width={280}
              priority
              class="hero-phone"
              sizes="280px"
              ariaHidden
            />
          </div>

          <div class="lib">
            <div class="lib-top">
              <span class="lib-title">Your library</span>
              <span class="lib-chip">Albums</span>
            </div>
            <div class="tiles">
              <span class="tile t1"></span>
              <span class="tile t2"></span>
              <span class="tile t3"></span>
              <span class="tile t4"></span>
              <span class="tile t5"></span>
              <span class="tile t6"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ADAPTIVE COLOUR — the record, refracted ----------------------------- -->
    <section class="spectrum" aria-labelledby="au-spectrum">
      <div class="spectrum-head">
        <h2 id="au-spectrum">It takes the colour of the record.</h2>
        <p>
          Play anything and Mozz tints its whole interface — every screen, edge
          to edge — from that record's own artwork. One app, refracted into
          whatever you happen to be listening to.
        </p>
      </div>

      <figure class="fan">
        <span class="fan-bloom" aria-hidden="true"></span>
        <span class="fan-beam" aria-hidden="true"></span>
        <div class="rays">
          {SPECTRUM.map((n) => (
            <Phone class="ray" name={n} width={168} sizes="(max-width: 40rem) 33vw, 168px" />
          ))}
        </div>
      </figure>
    </section>

    <!-- SERVERS ------------------------------------------------------------- -->
    <section class="connect" aria-labelledby="au-servers">
      <div class="connect-head">
        <h2 id="au-servers">Point Mozz at the server you already run.</h2>
        <p>
          {serverStat.value} {serverStat.label}. Pick the one you already run;
          its catalog is mirrored onto the device.
        </p>
      </div>

      <div class="rail">
        {SERVERS.map((s) => (
          <div class="srv">
            <span class="srv-logo"><ServerLogo name={s.name} size={30} brand /></span>
            <span class="srv-name">{s.name}</span>
            <p class="srv-note">{s.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- HOW IT WORKS — mechanism illustration ------------------------------- -->
    <section class="path" aria-labelledby="au-path">
      <div class="path-copy">
        <h2 id="au-path">From your shelf to your ears — and no one in between.</h2>
        <p>
          Mozz mirrors the whole catalogue into a database on the device, so the
          only things in the chain are your server, your phone and your
          headphones. Browsing and search stay instant whether the server is
          reachable or not.
        </p>
      </div>

      <figure class="diagram" aria-hidden="true">
        <svg viewBox="0 0 1040 470" role="img" width="1040" height="470">
          <defs>
            <linearGradient id="au-beam" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#8fa6f0" />
              <stop offset="0.5" stop-color="#b9a8f0" />
              <stop offset="1" stop-color="#f4c4d0" />
            </linearGradient>
            <linearGradient id="au-glass" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.9" />
              <stop offset="1" stop-color="#eef0fb" stop-opacity="0.55" />
            </linearGradient>
            <radialGradient id="au-screen" cx="0.5" cy="0.4" r="0.8">
              <stop offset="0" stop-color="#d9def9" />
              <stop offset="1" stop-color="#efe6f4" />
            </radialGradient>
            <filter id="au-soft" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
            <filter id="au-cast" x="-50%" y="-50%" width="200%" height="200%">
              <feDropShadow dx="14" dy="20" stdDeviation="18" flood-color="#514a86" flood-opacity="0.32" />
            </filter>
          </defs>

          <!-- luminous connecting beam -->
          <path d="M250 250 C 350 250 360 250 460 258 S 640 258 800 250"
                stroke="url(#au-beam)" stroke-width="16" fill="none" stroke-linecap="round"
                opacity="0.5" filter="url(#au-soft)" />
          <path d="M250 250 C 350 250 360 250 460 258 S 640 258 800 250"
                stroke="url(#au-beam)" stroke-width="5" fill="none" stroke-linecap="round" />

          <!-- server -->
          <g filter="url(#au-cast)">
            <rect x="70" y="122" width="176" height="238" rx="26" fill="url(#au-glass)" stroke="#ffffff" stroke-width="1.5"/>
          </g>
          <rect x="70" y="122" width="176" height="238" rx="26" fill="none" stroke="#c7cdf0" stroke-width="1"/>
          <path d="M112 160h92l-46 -30z" fill="#8fa6f0" opacity="0.85"/>
          <rect x="98" y="196" width="120" height="20" rx="10" fill="#ffffff" opacity="0.85"/>
          <rect x="98" y="230" width="120" height="20" rx="10" fill="#ffffff" opacity="0.85"/>
          <rect x="98" y="264" width="120" height="20" rx="10" fill="#ffffff" opacity="0.85"/>
          <circle cx="118" cy="318" r="7" fill="#c80028"/>
          <circle cx="142" cy="318" r="7" fill="#b9a8f0"/>

          <!-- phone -->
          <g filter="url(#au-cast)">
            <rect x="452" y="120" width="150" height="248" rx="30" fill="url(#au-glass)" stroke="#ffffff" stroke-width="1.5"/>
          </g>
          <rect x="466" y="136" width="122" height="216" rx="20" fill="url(#au-screen)"/>
          <rect x="512" y="146" width="30" height="8" rx="4" fill="#c3c9ee"/>
          <circle cx="527" cy="238" r="34" fill="#ffffff" opacity="0.75"/>
          <path d="M517 220l26 18-26 18z" fill="#c80028"/>

          <!-- headphones -->
          <path d="M812 268v-14a72 72 0 0 1 144 0v14" fill="none" stroke="#8fa6f0" stroke-width="12" stroke-linecap="round"/>
          <g filter="url(#au-cast)">
            <rect x="800" y="252" width="34" height="70" rx="16" fill="url(#au-glass)" stroke="#ffffff" stroke-width="1.5"/>
            <rect x="934" y="252" width="34" height="70" rx="16" fill="url(#au-glass)" stroke="#ffffff" stroke-width="1.5"/>
          </g>
          <circle cx="817" cy="287" r="7" fill="#b9a8f0"/>
          <circle cx="951" cy="287" r="7" fill="#f4c4d0"/>

          <!-- 'nothing else in the loop' -->
          <g opacity="0.6">
            <path d="M470 66c-14 0-22 10-22 20 0 12 10 18 22 18h74c12 0 20-8 20-18 0-12-10-16-18-17-2-13-13-21-27-21-11 0-20 7-25 18z"
                  fill="none" stroke="#8b86ad" stroke-width="2.5" stroke-dasharray="2 7" stroke-linecap="round"/>
            <line x1="452" y1="118" x2="560" y2="56" stroke="#c80028" stroke-width="2.5" stroke-linecap="round"/>
          </g>
          <text x="506" y="42" text-anchor="middle" class="d-note">no cloud · no account</text>

          <!-- stat annotations -->
          <g class="d-pill">
            <rect x="286" y="300" width="150" height="58" rx="16" fill="#ffffff" stroke="#dfe2f6"/>
            <text x="304" y="329" class="d-big">{perfSearch.value}</text>
            <text x="304" y="347" class="d-sub">search · 100,000 tracks</text>
          </g>
          <g class="d-pill">
            <rect x="628" y="316" width="150" height="58" rx="16" fill="#ffffff" stroke="#dfe2f6"/>
            <text x="646" y="345" class="d-big">{perfStart.value}</text>
            <text x="646" y="363" class="d-sub">tap to first note</text>
          </g>

          <text x="158" y="392" text-anchor="middle" class="d-label">Your server</text>
          <text x="527" y="392" text-anchor="middle" class="d-label">Your iPhone</text>
          <text x="884" y="392" text-anchor="middle" class="d-label">Your headphones</text>
        </svg>
      </figure>
    </section>

    <!-- FEATURES ------------------------------------------------------------ -->
    <section class="features" aria-labelledby="au-features">
      <div class="features-head">
        <h2 id="au-features">Everything is in the free app.</h2>
        <p>Because there is no other kind. Everything it does, plainly.</p>
      </div>

      <div class="sheet">
        {FEATURES.map((f) => (
          <div class="feat">
            <h3><span class="spark" aria-hidden="true"></span>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- OFFLINE — prism illustration ---------------------------------------- -->
    <section class="offline" aria-labelledby="au-offline">
      <figure class="prism" aria-hidden="true">
        <svg viewBox="0 0 1040 470" role="img" width="1040" height="470">
          <defs>
            <linearGradient id="au-prism-glass" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"/>
              <stop offset="1" stop-color="#d7dcf7" stop-opacity="0.6"/>
            </linearGradient>
            <linearGradient id="au-phone-glass" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.92"/>
              <stop offset="1" stop-color="#ece6f5" stop-opacity="0.7"/>
            </linearGradient>
            <filter id="au-soft2" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="9"/>
            </filter>
            <filter id="au-cast2" x="-50%" y="-50%" width="200%" height="200%">
              <feDropShadow dx="16" dy="22" stdDeviation="20" flood-color="#4b4682" flood-opacity="0.3"/>
            </filter>
            <radialGradient id="au-bloom" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#b9a8f0" stop-opacity="0.5"/>
              <stop offset="1" stop-color="#b9a8f0" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- soft light bloom anchoring the composition -->
          <ellipse cx="600" cy="250" rx="360" ry="210" fill="url(#au-bloom)"/>

          <!-- incoming white light -->
          <line x1="120" y1="70" x2="404" y2="228" stroke="#ffffff" stroke-width="11" stroke-linecap="round" filter="url(#au-soft2)"/>
          <line x1="120" y1="70" x2="404" y2="228" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round"/>

          <!-- dispersed spectrum pouring toward the device -->
          <g filter="url(#au-soft2)" opacity="0.95">
            <path d="M470 250 L720 172 L720 212 Z" fill="#8fa6f0" opacity="0.72"/>
            <path d="M470 258 L720 212 L720 252 Z" fill="#b9a8f0" opacity="0.72"/>
            <path d="M470 266 L720 252 L720 292 Z" fill="#f4c4d0" opacity="0.72"/>
            <path d="M470 274 L720 292 L720 332 Z" fill="#f7d9c9" opacity="0.66"/>
          </g>

          <!-- glass prism -->
          <g filter="url(#au-cast2)">
            <path d="M430 150 L520 300 L360 300 Z" fill="url(#au-prism-glass)" stroke="#ffffff" stroke-width="2"/>
          </g>
          <path d="M430 150 L520 300 L360 300 Z" fill="none" stroke="#c4cbef" stroke-width="1"/>
          <path d="M430 150 L448 300 L360 300 Z" fill="#ffffff" opacity="0.35"/>

          <!-- dormant server link -->
          <g opacity="0.55">
            <rect x="120" y="330" width="120" height="86" rx="18" fill="#ffffff" stroke="#d3d7f0"/>
            <rect x="140" y="352" width="80" height="12" rx="6" fill="#c7cdf0"/>
            <rect x="140" y="374" width="80" height="12" rx="6" fill="#c7cdf0"/>
            <path d="M240 360 C 420 360 560 340 700 300" fill="none" stroke="#9b96bd" stroke-width="2.5" stroke-dasharray="3 9" stroke-linecap="round"/>
          </g>
          <text x="180" y="440" text-anchor="middle" class="d-label">Server switched off</text>

          <!-- phone with glowing downloads -->
          <g filter="url(#au-cast2)">
            <rect x="700" y="96" width="176" height="300" rx="34" fill="url(#au-phone-glass)" stroke="#ffffff" stroke-width="2"/>
          </g>
          <rect x="716" y="112" width="144" height="268" rx="24" fill="#f6f1fb"/>
          <text x="740" y="150" class="d-screen">Downloaded</text>
          {[0,1,2,3].map((i) => (
            <g transform={`translate(736, ${170 + i*48})`}>
              <rect x="0" y="0" width="104" height="34" rx="10" fill="#ffffff" stroke="#e6e2f4"/>
              <circle cx="20" cy="17" r="11" fill="#e8ecfb"/>
              <path d="M15 17l4 4 7-8" fill="none" stroke="#c80028" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="40" y="11" width="52" height="6" rx="3" fill="#c9cff0"/>
              <rect x="40" y="22" width="34" height="5" rx="2.5" fill="#ddd7ee"/>
            </g>
          ))}
        </svg>
      </figure>

      <div class="offline-copy">
        <h2 id="au-offline">Take the whole record underground.</h2>
        <p>
          Downloads are part of the design, not an afterthought bolted on later.
          Pull a record onto the phone and it plays with the server switched off —
          browsing, searching and gapless playback, exactly as they behave at home.
        </p>
      </div>
    </section>

    <!-- OWNERSHIP — windowpane ---------------------------------------------- -->
    <section class="own" aria-labelledby="au-own">
      <div class="own-head">
        <h2 id="au-own">It's yours, all the way down.</h2>
        <p>
          <span class="own-free">{freeStat.value}</span> {freeStat.label}. No
          Mozz account, because there is no Mozz server. No analytics, no telemetry;
          optional enrichment can be switched off.
        </p>
      </div>

      <div class="pane">
        <span class="pane-leak" aria-hidden="true"></span>
        {OWNERSHIP.map((o) => (
          <div class="quad">
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </div>
        ))}
      </div>

      <p class="honest">
        The one honest caveat: turn on recommendations and Mozz asks MusicBrainz
        and ListenBrainz what sounds similar to an artist and title. That request
        carries no name, no server address and no account — and it switches off in
        Settings.
      </p>
    </section>

    <!-- FAQ ----------------------------------------------------------------- -->
    <section class="faq" aria-labelledby="au-faq">
      <h2 id="au-faq">Questions, answered plainly.</h2>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <span class="faq-mark" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- FOOTER -------------------------------------------------------------- -->
    <footer class="foot">
      <div class="foot-lockup">
        <Mark size={30} decorative />
        <span class="wordmark">{NAME}</span>
      </div>
      <p>Free forever, and open source under GPL-3.0.</p>
      <a class="foot-gh" href={GITHUB_URL}>See it on GitHub</a>
    </footer>
  </main>
</Layout>

<style>
  .au {
    --ground: #f6f3ff;
    --ink: #211a33;
    --ink-body: #45405e;
    --ink-muted: #5b5578;
    --peri: #8fa6f0;
    --lilac: #b9a8f0;
    --blush: #f4c4d0;
    --warm: #f7d9c9;
    --red: #c80028;
    --red-bright: #d6002b;

    --glass-line: rgba(120, 112, 168, 0.22);
    --edge: rgba(255, 255, 255, 0.72);

    /* Hero plate: layered over the CSS scene. If /hero/aurora.jpg is absent it
       simply never paints — no broken image, no grey box. */
    --hero-plate: url('/hero/aurora.jpg');

    position: relative;
    background: var(--ground);
    color: var(--ink-body);
    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    overflow-x: clip;
    isolation: isolate;
  }

  /* Fixed mesh field — several large, soft radials at different radii and
     opacities, mixing into one another. Radials, not a flat linear gradient,
     and kept in a fixed layer so nothing it draws can widen the page. */
  .field {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(48% 42% at 12% 6%, rgba(247, 217, 201, 0.55), transparent 70%),
      radial-gradient(52% 46% at 88% 4%, rgba(185, 168, 240, 0.55), transparent 72%),
      radial-gradient(46% 44% at 78% 40%, rgba(143, 166, 240, 0.5), transparent 70%),
      radial-gradient(40% 40% at 24% 46%, rgba(244, 196, 208, 0.4), transparent 72%),
      radial-gradient(42% 30% at 90% 62%, rgba(185, 168, 240, 0.3), transparent 72%),
      radial-gradient(40% 28% at 8% 64%, rgba(143, 166, 240, 0.26), transparent 74%),
      radial-gradient(60% 54% at 8% 92%, rgba(143, 166, 240, 0.45), transparent 72%),
      radial-gradient(52% 48% at 96% 96%, rgba(244, 196, 208, 0.4), transparent 72%),
      var(--ground);
  }

  /* A second, blurred field adds genuine softness and colour bleed without ever
     leaving its clipped layer. */
  .field::after {
    content: '';
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(38% 34% at 62% 18%, rgba(185, 168, 240, 0.5), transparent 70%),
      radial-gradient(34% 30% at 30% 74%, rgba(143, 166, 240, 0.42), transparent 72%);
    filter: blur(60px);
  }

  h1, h2, h3 {
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  section { position: relative; }

  /* ---------- hero ---------- */
  .hero {
    max-width: 78rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .hero-copy { min-width: 0; }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .wordmark {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.75rem);
    max-width: 15ch;
    margin: 0;
  }

  .lede {
    margin-top: clamp(1.1rem, 2.4vw, 1.6rem);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--ink-body);
    max-width: 42ch;
    text-wrap: pretty;
  }

  .actions {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
  }

  /* Primary action carries the one warm, saturated note. */
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.4rem;
    border-radius: 16px;
    background: linear-gradient(180deg, var(--red-bright), var(--red));
    color: #fff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35) inset,
      0 18px 34px -14px rgba(200, 0, 40, 0.6),
      0 6px 14px -8px rgba(120, 0, 24, 0.5);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.store:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.4) inset,
      0 24px 40px -14px rgba(200, 0, 40, 0.62),
      0 8px 18px -8px rgba(120, 0, 24, 0.5);
  }

  a.store:active { transform: translateY(0); }

  .store svg { width: 24px; height: 24px; fill: currentColor; }

  .store span {
    display: grid;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.05;
  }

  .store small {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.82;
  }

  /* Pending, not broken — glass and clearly not the live red. */
  .store.is-pending {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.62));
    color: var(--ink-muted);
    box-shadow:
      0 1px 0 var(--edge) inset,
      0 16px 30px -18px rgba(84, 74, 130, 0.5);
    cursor: default;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .store.is-pending svg { opacity: 0.7; }

  .ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-radius: 16px;
    border: 1px solid rgba(120, 112, 168, 0.32);
    background: rgba(255, 255, 255, 0.35);
    color: var(--ink);
    font-weight: 600;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .ghost:hover {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(120, 112, 168, 0.5);
    transform: translateY(-1px);
  }

  /* ---- hero stage: phone + library card ---- */
  .stage {
    position: relative;
    min-width: 0;
    min-height: clamp(30rem, 46vw, 38rem);
    /* layered plate over the local light; degrades silently with no file */
    background-image: var(--hero-plate);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 28px;
    animation: au-rise 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes au-rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  /* Real screenshot in an iPhone frame, sitting in the same slot the drawn
     mockup used to. It carries the composition; the library card overlaps it. */
  .hero-device {
    position: absolute;
    top: 50%;
    left: 42%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  /* Dress the shared frame for this pale, morning-light world: a brushed
     titanium bezel with a soft violet directional cast, not the default slab. */
  .hero-device :global(.hero-phone) {
    --phone-bezel: linear-gradient(155deg, #fdfcff, #d7d2e6 46%, #b9b4cc);
    --phone-bezel-w: 0.036;
    --phone-rim: rgba(255, 255, 255, 0.9);
    --phone-shadow:
      42px 46px 82px -34px rgba(84, 74, 130, 0.5),
      0 4px 12px -6px rgba(84, 74, 130, 0.4);
  }

  /* library card floating alongside the phone */
  .lib {
    position: absolute;
    right: -1%;
    bottom: 5%;
    width: clamp(11rem, 15vw, 12.75rem);
    z-index: 3;
    padding: 0.9rem;
    border-radius: 18px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.5));
    border: 1px solid var(--edge);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 -14px 30px -26px rgba(80, 70, 130, 0.6) inset,
      34px 40px 70px -34px rgba(84, 74, 130, 0.5);
  }

  .lib-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }

  .lib-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
  }

  .lib-chip {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(143, 166, 240, 0.22);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .tile {
    aspect-ratio: 1;
    border-radius: 8px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 4px 10px -6px rgba(84, 74, 130, 0.5);
  }

  .t1 { background: linear-gradient(145deg, #9fb1f2, #c8b8f2); }
  .t2 { background: linear-gradient(145deg, #f4c4d0, #f7d9c9); }
  .t3 { background: linear-gradient(145deg, #b9a8f0, #8fa6f0); }
  .t4 { background: linear-gradient(145deg, #cdd6fb, #f0d7e6); }
  .t5 { background: linear-gradient(145deg, #f7d9c9, #e6bfe0); }
  .t6 { background: linear-gradient(145deg, #8fa6f0, #b9c6f6); }

  /* ---------- adaptive colour: a spectrum fan of real screens ---------- */
  .spectrum {
    max-width: 74rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .spectrum-head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .spectrum-head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); }

  .spectrum-head p {
    margin-top: 0.9rem;
    margin-inline: auto;
    color: var(--ink-body);
    max-width: 52ch;
    text-wrap: pretty;
  }

  /*
    The screens are dispersed from a single point at the base, the way the prism
    below splits one white beam into a spectrum — here the spectrum is the app's
    own screens, each wearing the colour of a different record.
  */
  .fan {
    position: relative;
    margin: 0 auto;
    max-width: 60rem;
    /* min must clear the upright screen (168px wide → ~364px tall) at every width */
    height: clamp(24rem, 44vw, 27rem);
    /* guard: a rotated fan can never widen the page */
    overflow: clip;
  }

  .fan-bloom {
    position: absolute;
    left: 50%;
    bottom: -6%;
    width: min(92%, 44rem);
    height: 116%;
    transform: translateX(-50%);
    background: radial-gradient(50% 46% at 50% 70%, rgba(185, 168, 240, 0.4), transparent 70%);
    filter: blur(6px);
    pointer-events: none;
  }

  /* a thin shaft of white light entering toward the base of the fan */
  .fan-beam {
    position: absolute;
    left: 8%;
    bottom: 3%;
    width: 42%;
    height: 3px;
    transform-origin: left bottom;
    transform: rotate(-25deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.85));
    filter: blur(1px);
    pointer-events: none;
  }

  .rays {
    --ray-w: 168px;
    position: absolute;
    inset: 0;
  }

  .rays :global(.ray) {
    position: absolute;
    left: 50%;
    bottom: 0;
    margin-left: calc(var(--ray-w) / -2);
    transform-origin: center bottom;
    /* lighter frame than the hero so five overlapping bezels don't go muddy */
    --phone-bezel: linear-gradient(155deg, #fdfcff, #dad5e8 48%, #c1bcd2);
    --phone-bezel-w: 0.04;
    --phone-rim: rgba(255, 255, 255, 0.82);
    --phone-shadow: 16px 24px 44px -22px rgba(84, 74, 130, 0.5);
  }

  .rays :global(.ray):nth-child(1) { transform: rotate(-21deg); z-index: 1; }
  .rays :global(.ray):nth-child(2) { transform: rotate(-10.5deg); z-index: 2; }
  .rays :global(.ray):nth-child(3) { transform: rotate(0deg); z-index: 3; }
  .rays :global(.ray):nth-child(4) { transform: rotate(10.5deg); z-index: 2; }
  .rays :global(.ray):nth-child(5) { transform: rotate(21deg); z-index: 1; }

  /* ---------- servers ---------- */
  .connect {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .connect-head { max-width: 46rem; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }

  .connect-head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); }

  .connect-head p {
    margin-top: 0.85rem;
    color: var(--ink-body);
    max-width: 52ch;
  }

  /* one glass panel, subdivided by hairlines — not a grid of cards */
  .rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.44));
    border: 1px solid var(--edge);
    backdrop-filter: blur(22px) saturate(1.25);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 -18px 40px -30px rgba(80, 70, 130, 0.5) inset,
      40px 44px 80px -36px rgba(84, 74, 130, 0.42);
    overflow: hidden;
  }

  .srv {
    padding: clamp(1.4rem, 2.6vw, 2rem);
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .srv + .srv { border-left: 1px solid var(--glass-line); }

  .srv-logo {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 8px 18px -10px rgba(84, 74, 130, 0.5);
  }

  .srv-name {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
  }

  .srv-note { color: var(--ink-body); font-size: 0.96rem; text-wrap: pretty; }

  /* ---------- how it works ---------- */
  .path {
    max-width: 74rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-items: center;
    text-align: center;
  }

  .path-copy { max-width: 60ch; }

  .path-copy h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); max-width: 20ch; margin-inline: auto; }

  .path-copy p { margin-top: 0.9rem; color: var(--ink-body); }

  .diagram, .prism {
    margin: 0;
    width: 100%;
    max-width: 62rem;
  }

  .diagram svg, .prism svg { width: 100%; height: auto; display: block; }

  .d-label {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    font-weight: 600;
    fill: var(--ink-muted);
  }

  .d-note {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 600;
    fill: #6f6a90;
  }

  .d-big {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 22px;
    font-weight: 700;
    fill: var(--ink);
  }

  .d-sub { font-family: 'Manrope', sans-serif; font-size: 12px; fill: var(--ink-muted); }

  .d-screen {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 15px;
    font-weight: 700;
    fill: var(--ink);
  }

  /* ---------- features ---------- */
  .features {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .features-head { max-width: 46rem; margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .features-head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); }
  .features-head p { margin-top: 0.8rem; color: var(--ink-body); }

  /* one glass sheet holding an editorial list — hairline dividers, not cards */
  .sheet {
    border-radius: 24px;
    padding: clamp(0.5rem, 2vw, 1rem) clamp(1.25rem, 3vw, 2.5rem);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.46));
    border: 1px solid var(--edge);
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 -20px 44px -32px rgba(80, 70, 130, 0.5) inset,
      44px 48px 90px -38px rgba(84, 74, 130, 0.42);
  }

  .feat {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding: clamp(1.4rem, 2.6vw, 1.9rem) 0;
    border-top: 1px solid var(--glass-line);
  }

  .feat:first-child { border-top: 0; }

  .feat h3 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.3rem;
  }

  .spark {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--red);
    transform: rotate(45deg) translateY(-1px);
    box-shadow: 0 0 0 3px rgba(200, 0, 40, 0.12);
  }

  .feat p { color: var(--ink-body); max-width: 68ch; text-wrap: pretty; }

  /* ---------- offline ---------- */
  .offline {
    max-width: 74rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .offline-copy { min-width: 0; }
  .offline-copy h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); max-width: 16ch; }
  .offline-copy p { margin-top: 0.9rem; color: var(--ink-body); max-width: 52ch; }

  /* ---------- ownership ---------- */
  .own {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .own-head { max-width: 46rem; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
  .own-head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); }
  .own-head p { margin-top: 0.85rem; color: var(--ink-body); max-width: 54ch; }

  .own-free {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    color: var(--red);
  }

  /* a windowpane: one sheet of glass with hairline muntins */
  .pane {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.44));
    border: 1px solid var(--edge);
    backdrop-filter: blur(24px) saturate(1.25);
    -webkit-backdrop-filter: blur(24px) saturate(1.25);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 -22px 50px -34px rgba(80, 70, 130, 0.55) inset,
      46px 52px 96px -40px rgba(84, 74, 130, 0.44);
  }

  /* caustic light-leak drifting across the pane */
  .pane-leak {
    position: absolute;
    top: -40%;
    left: -10%;
    width: 55%;
    height: 180%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    transform: rotate(18deg);
    filter: blur(26px);
    pointer-events: none;
  }

  .quad {
    position: relative;
    z-index: 1;
    padding: clamp(1.6rem, 3vw, 2.4rem);
  }

  .quad:nth-child(2), .quad:nth-child(3) { border-top: 1px solid var(--glass-line); }
  .quad:nth-child(4), .quad:nth-child(5) { border-top: 1px solid var(--glass-line); }
  .quad:nth-child(odd) { border-right: 1px solid var(--glass-line); }

  .quad h3 { font-size: 1.35rem; margin-bottom: 0.5rem; }
  .quad p { color: var(--ink-body); text-wrap: pretty; }

  .honest {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: 0.98rem;
  }

  /* ---------- faq ---------- */
  .faq {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .faq h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .faq-list {
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.44));
    border: 1px solid var(--edge);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      40px 44px 84px -38px rgba(84, 74, 130, 0.4);
  }

  .faq details { border-top: 1px solid var(--glass-line); }
  .faq details:first-child { border-top: 0; }

  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 2.4vw, 1.5rem) clamp(1.25rem, 3vw, 2rem);
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
  }

  .faq summary::-webkit-details-marker { display: none; }

  .faq-mark {
    flex: none;
    position: relative;
    width: 16px;
    height: 16px;
  }

  .faq-mark::before, .faq-mark::after {
    content: '';
    position: absolute;
    background: var(--red);
    border-radius: 2px;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  }

  .faq-mark::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .faq-mark::after { top: 0; left: 7px; width: 2px; height: 16px; }

  .faq details[open] .faq-mark::after { transform: scaleY(0); opacity: 0; }

  .faq summary:hover { color: var(--red); }

  .faq p {
    padding: 0 clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 2.4vw, 1.5rem);
    color: var(--ink-body);
    max-width: 70ch;
    text-wrap: pretty;
  }

  /* ---------- footer ---------- */
  .foot {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    border-top: 1px solid var(--glass-line);
    color: var(--ink-body);
  }

  .foot-lockup { display: inline-flex; align-items: center; gap: 0.55rem; }
  .foot p { margin-right: auto; }

  .foot-gh {
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(200, 0, 40, 0.5);
    text-underline-offset: 4px;
  }

  .foot-gh:hover { color: var(--red); }

  /* ---------- responsive ---------- */
  @media (max-width: 60rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .stage {
      order: -1;
      min-height: clamp(28rem, 92vw, 34rem);
      background: none;
    }
    .hero-device { left: 34%; }
    .lib { right: 2%; bottom: 8%; }
    .offline { grid-template-columns: 1fr; }
    .prism { order: 2; }
    .rail { grid-template-columns: 1fr; }
    .srv + .srv { border-left: 0; border-top: 1px solid var(--glass-line); }
  }

  @media (max-width: 40rem) {
    .au { font-size: 16px; }
    .hero h1 { font-size: clamp(2.3rem, 10vw, 3rem); }
    .feat { grid-template-columns: 1fr; gap: 0.5rem; }
    .pane { grid-template-columns: 1fr; }
    .quad { border-right: 0 !important; }
    .quad:nth-child(n+2) { border-top: 1px solid var(--glass-line); }

    /* stack the phone and library card vertically on small screens */
    .stage { display: grid; place-items: center; min-height: auto; padding: 1rem 0; background: none; }
    .hero-device { position: relative; top: auto; left: auto; transform: none; }
    .lib { position: static; width: min(100%, 20rem); margin-top: 1.25rem; transform: none; }

    /* shrink the whole dispersion so all five 168px screens fit the phone width */
    .fan { height: 16rem; }
