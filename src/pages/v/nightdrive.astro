---
/**
 * VARIANT — NIGHT DRIVE
 *
 * The page is the drive away from home: one road, one vanishing point, and one
 * warm window shrinking behind the listener. Signal bars disappear by section,
 * but the phone keeps playing the downloaded record in the passenger seat.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';
const HEADLINE = 'No signal. Still playing.';
const PRODUCT_LINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT =
  'Stream at home over your own network, or download an album and play it with nothing at all.';
const HOME_POINTS = [
  'Your library stays on the machine you already run.',
  'Mozz talks across your own network while you are home.',
  'Add more than one server and browse them as one collection.',
];
const ROAD_POINTS = [
  'The phone leaves the driveway with the album already on it.',
  'The catalog lives on device, so search and browsing still answer.',
  'Gapless playback keeps the record together after the bars are gone.',
];
const SIGNAL_STEPS = [
  { label: 'At home', level: 5 },
  { label: 'Edge of town', level: 3 },
  { label: 'Out of range', level: 1 },
  { label: 'Offline', level: 0 },
];
---
<Layout
  title={`${NAME} — no signal, still playing`}
  description="Mozz is a free player for the music on your own server. Stream over your own network or download albums that keep playing when the signal runs out."
  themeColor="#070708"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Big+Shoulders+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <main class="nightdrive">
    <VariantBar slug="nightdrive" tone="neutral" />
    <aside class="signal-rail" aria-label="Signal strength over the drive">
      <p class="signal-rail__label">signal</p>
      <svg class="signal-rail__bars" data-signal-bars viewBox="0 0 42 34" aria-hidden="true">
        <rect x="1" y="25" width="5" height="8" rx="2" />
        <rect x="10" y="19" width="5" height="14" rx="2" />
        <rect x="19" y="13" width="5" height="20" rx="2" />
        <rect x="28" y="7" width="5" height="26" rx="2" />
        <rect x="37" y="1" width="5" height="32" rx="2" />
      </svg>
      <p class="signal-rail__status" data-signal-label>At home</p>
      <svg class="signal-rail__none" data-signal-none viewBox="0 0 40 40" aria-hidden="true">
        <path d="M8 28c6.6-6 17.4-6 24 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M14 22c3.4-3 8.6-3 12 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M18.6 16.8c.8-.5 1.9-.5 2.8 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M9 9 31 31M31 9 9 31" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      </svg>
    </aside>
    <header class="hero" data-signal-stage data-signal-level="5" data-signal-text="At home">
      <div class="hero__sky" aria-hidden="true"></div>
      <div class="headlight" aria-hidden="true"></div>
      <div class="tail-light" aria-hidden="true"></div>
      <svg
        class="road road--hero"
        viewBox="0 0 1600 960"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-label="A black highway narrowing to one warm lit house on the horizon. White center dashes travel toward the viewer."
      >
        <defs>
          <linearGradient id="nd-road-face" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#101011" />
            <stop offset="1" stop-color="#020203" />
          </linearGradient>
          <radialGradient id="nd-window" cx=".5" cy=".5" r=".5">
            <stop offset="0" stop-color="#f3f1ec" stop-opacity="1" />
            <stop offset=".42" stop-color="#f6c978" stop-opacity=".62" />
            <stop offset="1" stop-color="#f6c978" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="nd-shoulder" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#f3f1ec" stop-opacity="0" />
            <stop offset=".46" stop-color="#f3f1ec" stop-opacity=".22" />
            <stop offset="1" stop-color="#f3f1ec" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1600" height="960" fill="#070708" />
        <rect x="0" y="395" width="1600" height="2" fill="#2d2417" opacity=".7" />
        <g class="far-lights" fill="#d89b43">
          <circle cx="566" cy="390" r="2" opacity=".8" />
          <circle cx="610" cy="389" r="1.6" opacity=".55" />
          <circle cx="1038" cy="391" r="1.8" opacity=".6" />
          <circle cx="1086" cy="390" r="1.5" opacity=".48" />
        </g>
        <g class="house">
          <ellipse cx="800" cy="392" rx="80" ry="42" fill="url(#nd-window)" />
          <path d="M774 398V365L800 344L826 365V398Z" fill="#050506" />
          <path d="M767 365 800 338 833 365" fill="none" stroke="#050506" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="793" y="371" width="14" height="18" rx="1" fill="#f3f1ec" />
          <path d="M800 371v18M793 380h14" stroke="#80551e" stroke-width="1" />
        </g>
        <path class="road-face" d="M760 402H840L1518 960H82Z" fill="url(#nd-road-face)" />
        <path d="M760 402 82 960" stroke="url(#nd-shoulder)" stroke-width="2.6" />
        <path d="M840 402 1518 960" stroke="url(#nd-shoulder)" stroke-width="2.6" />
        <path class="road-edge" d="M717 424 0 960" fill="none" stroke="#f3f1ec" stroke-opacity=".18" stroke-width="1.6" />
        <path class="road-edge" d="M883 424 1600 960" fill="none" stroke="#f3f1ec" stroke-opacity=".18" stroke-width="1.6" />
        <path
          class="dash-line"
          d="M800 410L800 980"
          fill="none"
          stroke="#f3f1ec"
          stroke-width="11"
          stroke-linecap="round"
          stroke-dasharray="34 58"
        />
        <path
          class="dash-line dash-line--ghost"
          d="M800 410L800 980"
          fill="none"
          stroke="#f3f1ec"
          stroke-width="3"
          stroke-linecap="round"
          stroke-dasharray="18 74"
          opacity=".55"
        />
      </svg>
      <div class="hero__content">
        <div class="lockup hero__lockup">
          <Mark size={30} decorative />
          <span class="wordmark">{NAME}</span>
          <span class="lockup__rule" aria-hidden="true"></span>
          <span class="lockup__tag">night drive</span>
        </div>
        <section class="hero__copy">
          <p class="kicker">The house falls behind. The record does not.</p>
          <h1>{HEADLINE}</h1>
          <p class="product-line">{PRODUCT_LINE}</p>
          <p class="support">{SUPPORT}</p>
          <div class="actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </section>
        <figure class="phone phone--hero" aria-label="An iPhone on the passenger seat showing Mozz playing a downloaded album offline.">
          <div class="phone-screen">
            <span class="island" aria-hidden="true"></span>
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="status__glyphs">
                <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z" /></svg>
                <svg viewBox="0 0 26 12"><rect x="1" y="1" width="20" height="10" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2" /><rect x="3" y="3" width="14" height="6" rx="1.4" /><path d="M23 4.3v3.4a1.9 1.9 0 0 0 0-3.4z" /></svg>
              </span>
            </div>
            <div class="phone-head">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>downloaded · plays offline</span>
              <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
            <div class="album-art" aria-hidden="true">
              <svg viewBox="0 0 140 140">
                <rect width="140" height="140" fill="#f3f1ec" />
                <path d="M0 98 140 34v106H0Z" fill="#070708" />
                <path d="M28 86 70 38 112 86" fill="none" stroke="#c80028" stroke-width="8" stroke-linejoin="round" />
                <circle cx="70" cy="78" r="24" fill="none" stroke="#070708" stroke-width="10" />
                <rect x="18" y="114" width="42" height="5" fill="#c80028" />
                <rect x="18" y="124" width="26" height="4" fill="#070708" opacity=".6" />
              </svg>
            </div>
            <div class="track-meta">
              <strong>Driveway Light</strong>
              <span>Downloaded from your server</span>
            </div>
            <div class="scrub" aria-hidden="true"><i></i></div>
            <div class="times" aria-hidden="true"><span>1:52</span><span>&minus;2:14</span></div>
            <div class="controls" aria-hidden="true">
              <svg viewBox="0 0 20 20"><path d="M17.4 3.4v13.2L7.6 10z" /><rect x="2.6" y="3.4" width="2.6" height="13.2" rx="1.2" /></svg>
              <span><svg viewBox="0 0 20 20"><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.3" /><rect x="11.1" y="4.4" width="3.3" height="11.2" rx="1.3" /></svg></span>
              <svg viewBox="0 0 20 20"><path d="M2.6 3.4v13.2L12.4 10z" /><rect x="14.8" y="3.4" width="2.6" height="13.2" rx="1.2" /></svg>
            </div>
            <div class="download-badge">
              <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#c80028" /><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#f3f1ec" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>downloaded · plays offline</span>
            </div>
            <span class="home-indicator" aria-hidden="true"></span>
          </div>
        </figure>
      </div>
    </header>
    <div class="road-band" aria-hidden="true"><i></i></div>
    <section class="section home-section" data-signal-stage data-signal-level="5" data-signal-text="At home" aria-labelledby="nd-home">
      <div class="wrap split split--home">
        <div class="section-copy">
          <p class="eyebrow">Still at home · five bars</p>
          <h2 id="nd-home">Point Mozz at the server already humming in your house.</h2>
          <p>
            Streaming is not a cloud claim here. It is the familiar part of the
            drive: your phone on the same network as the machine that holds the
            records, reading the library you already built.
          </p>
          <ul class="plain-list">
            {HOME_POINTS.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="server-house" aria-label="Supported servers shown as lit windows">
          <svg class="server-house__roof" viewBox="0 0 520 220" aria-hidden="true">
            <path d="M36 194V92L260 26L484 92V194Z" fill="#050506" stroke="#30281c" stroke-width="2" />
            <path d="M16 96 260 18 504 96" fill="none" stroke="#f3f1ec" stroke-opacity=".18" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="240" y="126" width="40" height="68" fill="#100c08" />
          </svg>
          <div class="server-windows">
            {SERVERS.map((s) => (
              <article class="server-window">
                <span class="server-window__glow" aria-hidden="true"></span>
                <ServerLogo name={s.name} size={34} brand />
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="road-out" data-signal-stage data-signal-level="3" data-signal-text="Edge of town" aria-labelledby="nd-road-out">
      <div class="road-out__road" aria-hidden="true"><i></i></div>
      <div class="wrap road-out__copy">
        <p class="eyebrow">The road out · three bars</p>
        <h2 id="nd-road-out">The house gets smaller. The queue keeps moving.</h2>
      </div>
    </section>
    <section class="section offline-section" data-signal-stage data-signal-level="0" data-signal-text="Offline" aria-labelledby="nd-offline">
      <div class="wrap split split--offline">
        <div class="offline-panel" aria-hidden="true">
          <div class="offline-panel__top">
            <span>no service</span>
            <svg viewBox="0 0 44 44"><path d="M8 31c7.6-6.6 20.4-6.6 28 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><path d="M14 24c4.6-3.8 11.4-3.8 16 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><path d="M10 10 34 34M34 10 10 34" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" /></svg>
          </div>
          <div class="offline-shelf">
            {[0, 1, 2, 3].map((i) => (
              <span class="offline-record" style={`--r:${i}`}>
                <i></i>
              </span>
            ))}
          </div>
          <p>Downloaded before the drive.</p>
        </div>
        <div class="section-copy">
          <p class="eyebrow">Out of range · no bars</p>
          <h2 id="nd-offline">The downloaded album has the same weight as the stream.</h2>
          <p>
            Offline is not a rescue mode. Keep an album on the phone and it plays
            with the server unreachable: the catalog is there, search is there,
            and the queue still respects the record.
          </p>
          <ul class="plain-list">
            {ROAD_POINTS.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </section>
    <div class="road-band road-band--thin" aria-hidden="true"><i></i></div>
    <section class="section instrument" data-signal-stage data-signal-level="1" data-signal-text="One bar" aria-labelledby="nd-instrument">
      <div class="wrap">
        <div class="section-copy section-copy--wide">
          <p class="eyebrow">The instrument · one bar</p>
          <h2 id="nd-instrument">Everything in the app is tuned for a library you control.</h2>
          <p>
            Calm in the hand, fast under the thumb, and honest about where the
            music lives. The app is the instrument; your server and downloads are
            the sources.
          </p>
        </div>
        <div class="feature-grid">
          {FEATURES.map((f, i) => (
            <article class="feature-card">
              <span class="feature-card__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
        <dl class="mile-markers">
          {STATS.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
    <section class="section ownership" data-signal-stage data-signal-level="0" data-signal-text="No service" aria-labelledby="nd-costs">
      <div class="wrap">
        <div class="section-copy section-copy--wide">
          <p class="eyebrow">What it costs</p>
          <h2 id="nd-costs">Nothing hidden in the dark.</h2>
          <p>
            Free forever, open source under GPL-3.0, and built around the premise
            that the music is already yours.
          </p>
        </div>
        <div class="ownership-list">
          {OWNERSHIP.map((o) => (
            <article>
              <span aria-hidden="true"></span>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section faq" aria-labelledby="nd-faq">
      <div class="wrap faq__grid">
        <div class="section-copy">
          <p class="eyebrow">Questions at the shoulder</p>
          <h2 id="nd-faq">Before the road goes black.</h2>
        </div>
        <div class="faq-list">
          {FAQS.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <i aria-hidden="true"></i>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <footer class="final" data-signal-stage data-signal-level="0" data-signal-text="Offline" aria-labelledby="nd-final">
      <div class="tail-road" aria-hidden="true"><i></i></div>
      <div class="wrap final__inner">
        <div class="lockup final__lockup">
          <Mark size={34} decorative />
          <span class="wordmark">{NAME}</span>
        </div>
        <h2 id="nd-final">{TAGLINE}</h2>
        <p>{SUBLINE}</p>
        <div class="actions actions--center">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="fineprint">
          For recommendations, Mozz may ask MusicBrainz and ListenBrainz what sounds
          similar to an artist and title. That request carries no name, no server
          address, no account, and can be switched off in Settings.
        </p>
      </div>
    </footer>
  </main>
</Layout>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rail = document.querySelector('[data-signal-bars]');
  const label = document.querySelector('[data-signal-label]');
  const none = document.querySelector('[data-signal-none]');
  const stages = Array.from(document.querySelectorAll('[data-signal-stage]'));
  function setSignal(level, text) {
    if (!rail || !label || !none) return;
    rail.setAttribute('data-level', String(level));
    label.textContent = text;
    none.classList.toggle('is-visible', Number(level) === 0);
  }
  setSignal(5, 'At home');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      const target = visible.target;
      setSignal(target.getAttribute('data-signal-level') || '5', target.getAttribute('data-signal-text') || 'At home');
    }, { threshold: reduce ? 0.35 : [0.2, 0.45, 0.7] });
    stages.forEach((stage) => observer.observe(stage));
  }
</script>
<style>
  :global(html) {
    background: #070708;
    color-scheme: dark;
    overflow-x: clip;
  }
  :global(body) {
    margin: 0;
    background: #070708;
    color: #f3f1ec;
    font-family: 'Barlow', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .nightdrive {
    --night: #070708;
    --cream: #f3f1ec;
    --red: #c80028;
    --amber: #d89b43;
    --soft: rgba(243, 241, 236, 0.72);
    --dim: rgba(243, 241, 236, 0.46);
    --line: rgba(243, 241, 236, 0.16);
    --hard-line: rgba(243, 241, 236, 0.28);
    --wrap: min(1180px, 100% - 3rem);
    position: relative;
    min-height: 100svh;
    overflow-x: clip;
    background: var(--night);
    color: var(--cream);
    font-size: 17px;
    line-height: 1.62;
    isolation: isolate;
  }
  .wrap {
    width: var(--wrap);
    margin-inline: auto;
  }
  p,
  h1,
  h2,
  h3 {
    margin: 0;
  }
  h1,
  h2,
  h3,
  .wordmark,
  .mile-markers dt {
    font-family: 'Big Shoulders Display', Impact, 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.9;
