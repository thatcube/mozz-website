              ))}
              <circle cx="900" cy="176" r="13" fill="#04060b" stroke="#ff3d63" stroke-width="6" />
              <circle cx="470" cy="428" r="13" fill="#04060b" stroke="#4ee0a4" stroke-width="6" />
              <circle cx="1010" cy="428" r="13" fill="#04060b" stroke="#ffb347" stroke-width="6" />

              <text x="358" y="150" class="map__t map__t--big" fill="#ff3d63">Radio</text>
              <text x="924" y="182" class="map__t map__t--sm" fill="#7c879d">MusicBrainz + ListenBrainz</text>
              <text x="690" y="266" class="map__t map__t--sm" fill="#7c879d" text-anchor="middle">what you actually play</text>

              <text x="178" y="474" class="map__t map__t--big" fill="#4ee0a4">Downloads</text>
              <text x="178" y="502" class="map__t map__t--sm" fill="#7c879d">plays with the server unreachable</text>

              <text x="718" y="474" class="map__t map__t--big" fill="#ffb347">Weekly mixes</text>
              <text x="718" y="502" class="map__t map__t--sm" fill="#7c879d">a fresh route through your own records</text>
            </svg>
          </div>
          <figcaption class="map__cap">
            <strong>The one honest caveat.</strong> To work out what sounds
            similar, Mozz sends an artist name, a track title and sometimes a
            MusicBrainz ID to MetaBrainz. It carries no name, no server address
            and no account, and you can switch it off in Settings.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ====================================================================
         PASSENGER INFORMATION — the questions, on the panel by the door.
    ==================================================================== -->
    <section class="seg seg--info" aria-labelledby="s-info">
      <div class="wrap">
        <p class="seg__num">Passenger information</p>
        <h2 id="s-info">Before you board.</h2>
        <div class="info">
          {FAQS.map((f) => (
            <details class="info__q">
              <summary>
                <span>{f.q}</span>
                <span class="info__plus" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ====================================================================
         TERMINUS — the last panel on the last wall.
    ==================================================================== -->
    <section class="seg seg--term" aria-labelledby="s-term">
      <div class="wrap">
        <div class="term">
          <p class="term__eyebrow">Terminus · all change</p>
          <h2 id="s-term">End of the line. Start of the record.</h2>
          <p class="term__lede">
            Free forever, open source under GPL-3.0. No account to make, nothing
            to cancel, and nothing that stops working when the tunnel does.
          </p>
          <div class="board__actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="ghost" href={GITHUB_URL}>Read the source</a>
          </div>
          <p class="board__fine">
            The App Store listing does not exist yet, so this button is honest
            about it rather than pretending to work.
          </p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot__in">
        <span class="foot__mark"><Mark size={26} decorative /> Mozz</span>
        <p>One app for your music, wherever it lives. Free forever. Open source.</p>
        <a href={GITHUB_URL}>GPL-3.0 on GitHub</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* ==========================================================================
     SUBWAY — palette, type, and the two structural primitives: the full-bleed
     hero stage, and the `.wrap` column every station shares.
     ========================================================================== */
  :global(html) {
    background: #04060b;
    color-scheme: dark;
    overflow-x: clip;
  }
  :global(body) {
    background: #04060b;
  }

  .sub {
    --n0: #04060b;
    --n1: #080c15;
    --n2: #0d131f;
    --n3: #131b2b;
    --ink: #f0f4fc;
    --body: #b7c2d6;
    --muted: #8492a8;
    --amber: #ffb347;
    --amber2: #ffd9a0;
    --red: #c80028;
    --redL: #ff5a7a;
    --green: #4ee0a4;
    --line: rgba(150, 175, 215, 0.16);
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;

    font-family: 'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
    background: var(--n0);
    color: var(--body);
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    width: min(1160px, 100% - 3rem);
    margin-inline: auto;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  h1, h2, h3 {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0;
  }
  p { margin: 0; }

  /* ---------------------------------------------------------------- HERO -- */
  .hero {
    position: relative;
    min-height: calc(100svh - 2.6rem);
    display: flex;
    isolation: isolate;
  }
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .art--tall { display: none; }
  .stage__vig {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 100% at 64% 46%, rgba(4, 6, 11, 0) 26%, rgba(2, 4, 9, 0.78) 100%),
      linear-gradient(to top, rgba(2, 4, 9, 0.82), rgba(2, 4, 9, 0) 42%);
    pointer-events: none;
  }

  .hero__ui {
    position: relative;
    z-index: 1;
    flex: 0 1 auto;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 1.1rem 1.25rem;
    width: min(1440px, 100% - 4rem);
    margin-inline: auto;
    padding: clamp(1.9rem, 3.4vh, 3rem) 0 clamp(1.4rem, 2.6vh, 2rem);
  }

  /* carriage plate ------------------------------------------------------- */
  .lockup {
    grid-column: 1 / 5;
    grid-row: 1;
    align-self: start;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.9rem 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: linear-gradient(160deg, rgba(16, 24, 40, 0.78), rgba(5, 8, 14, 0.86));
    backdrop-filter: blur(6px);
    justify-self: start;
  }
  .lockup__name {
    color: var(--ink);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .lockup__rule {
    width: 1px;
    height: 18px;
    background: var(--line);
  }
  .lockup__tag {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
  }

  /* line diagram above the doors ----------------------------------------- */
  .route {
    grid-column: 8 / 13;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    max-width: 24rem;
    padding: 0.6rem 0.95rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: linear-gradient(160deg, rgba(14, 21, 36, 0.72), rgba(4, 7, 13, 0.8));
    backdrop-filter: blur(6px);
    transform: perspective(1400px) rotateY(-6deg);
    transform-origin: right center;
  }
  .route__hd {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }
  .route__lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .route__line { display: grid; grid-template-columns: auto 1fr; gap: 0.1rem 0.7rem; align-items: center; }
  .route__dots { display: inline-flex; align-items: center; gap: 0; }
  .route__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--n0);
    border: 2px solid currentColor;
    position: relative;
  }
  .route__dots i + i { margin-left: 14px; }
  .route__dots i + i::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: 14px;
    height: 2px;
    background: currentColor;
    transform: translateY(-1px);
  }
  .route__line--radio { color: var(--redL); }
  .route__line--mix { color: var(--amber); }
  .route__nm { color: var(--ink); font-weight: 600; font-size: 0.9rem; }
  .route__sub {
    grid-column: 2;
    color: var(--muted);
    font-size: 0.73rem;
    line-height: 1.3;
  }

  /* the interface, standing in the glass --------------------------------- */
  .np {
    grid-column: 1 / 8;
    grid-row: 2;
    align-self: center;
    margin: -2vh 0 0;
    padding: 0.7rem 0.7rem 0.4rem;
    border: 1px solid rgba(159, 196, 255, 0.24);
    border-top-color: rgba(200, 224, 255, 0.4);
    border-radius: 4px;
    background: linear-gradient(152deg, rgba(20, 31, 52, 0.68), rgba(5, 9, 17, 0.86));
    backdrop-filter: blur(10px) saturate(120%);
    box-shadow:
      0 34px 90px -34px rgba(0, 0, 0, 0.95),
      inset 0 1px 0 rgba(200, 224, 255, 0.16);
    transform: perspective(1600px) rotateY(-7deg);
    transform-origin: left center;
    position: relative;
    overflow: hidden;
  }
  .np::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgba(190, 215, 255, 0.15) 0 14%, rgba(190, 215, 255, 0) 38%);
    pointer-events: none;
  }
  .np__matrix {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0.6rem 0.55rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--amber);
    white-space: nowrap;
    overflow: hidden;
    border-bottom: 1px solid rgba(159, 196, 255, 0.14);
  }
  .np__matrix b { width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: 0.6; flex: none; }
  .np__body {
    display: grid;
    grid-template-columns: minmax(104px, 148px) 1fr;
    gap: clamp(0.9rem, 2.2vw, 1.7rem);
    align-items: center;
    padding: 0.85rem 0.5rem 0.7rem;
  }
  .np__art { position: relative; }
  .np__art svg {
    width: 100%;
    aspect-ratio: 1;
    display: block;
    border-radius: 2px;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.9);
  }
  .np__dl {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.24rem 0.5rem;
    border-radius: 2px;
    background: rgba(4, 6, 11, 0.78);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .np__dl i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .np__title {
    color: var(--ink);
    font-size: clamp(1.25rem, 2.1vw, 1.72rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .np__sub {
    margin-top: 0.4rem;
    color: var(--body);
    font-size: clamp(0.85rem, 1.1vw, 0.96rem);
    line-height: 1.45;
    max-width: 34ch;
  }
  .np__bar {
    margin-top: 0.85rem;
    height: 3px;
    background: rgba(190, 215, 255, 0.18);
    border-radius: 2px;
    overflow: hidden;
  }
  .np__bar i { display: block; height: 100%; width: 38%; background: var(--ink); }
  .np__tags {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .np__tags li {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--body);
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .np__transport {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 0.85rem;
    color: rgba(200, 220, 255, 0.72);
  }
  .np__transport svg { width: 20px; height: 20px; fill: currentColor; }
  .np__transport .is-play { width: 27px; height: 27px; fill: var(--amber2); }

  /* the platform, receding ----------------------------------------------- */
  .far {
    grid-column: 9 / 13;
    grid-row: 2;
    align-self: center;
    justify-self: end;
    max-width: 22rem;
    padding: 0.85rem 1rem 0.95rem;
    border: 1px solid rgba(255, 179, 71, 0.24);
    border-radius: 3px;
    background: linear-gradient(160deg, rgba(18, 15, 10, 0.8), rgba(4, 6, 11, 0.88));
    backdrop-filter: blur(6px);
    transform: perspective(1400px) rotateY(9deg) scale(0.97);
    transform-origin: right center;
  }
  .far__hd {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .far__servers { list-style: none; margin: 0.7rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .far__servers li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 0.1rem 0.6rem;
    align-items: center;
  }
  .far__nm { color: var(--ink); font-weight: 600; font-size: 0.92rem; }
  .far__note { grid-column: 2; color: var(--muted); font-size: 0.74rem; line-height: 1.3; }
  .far__signal {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    margin-top: 0.8rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 179, 71, 0.16);
  }
  .far__bars { display: inline-flex; align-items: flex-end; gap: 2px; }
  .far__bars i { width: 3px; background: var(--amber); border-radius: 1px; }
  .far__bars i:nth-child(1) { height: 5px; }
  .far__bars i:nth-child(2) { height: 9px; }
  .far__bars i:nth-child(3) { height: 13px; }
  .far__bars i:nth-child(4) { height: 17px; }
  .far__bars:nth-of-type(2) { opacity: 0.72; }
  .far__bars:nth-of-type(3) { opacity: 0.5; }
  .far__bars:nth-of-type(4) { opacity: 0.3; }
  .far__none {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .far__line {
    margin-top: 0.7rem;
    color: var(--amber2);
    font-size: 0.92rem;
    line-height: 1.32;
  }

  /* the illuminated panel ------------------------------------------------ */
  .board {
    grid-column: 1 / 8;
    grid-row: 3;
    align-self: end;
    position: relative;
    padding: clamp(1.1rem, 2vw, 1.35rem) clamp(1.4rem, 3vw, 2.4rem) clamp(1rem, 1.8vw, 1.25rem);
    border: 1px solid rgba(150, 175, 215, 0.22);
    border-top-color: rgba(205, 225, 255, 0.34);
    border-radius: 3px;
    background: linear-gradient(158deg, rgba(15, 23, 38, 0.9), rgba(4, 7, 13, 0.95));
    backdrop-filter: blur(8px);
    box-shadow:
      0 44px 100px -38px rgba(0, 0, 0, 0.95),
      0 0 120px -34px rgba(255, 179, 71, 0.22);
  }
  .board::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--red), var(--redL) 34%, rgba(255, 90, 122, 0) 88%);
  }
  .board::after {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -34px;
    height: 34px;
    background: linear-gradient(rgba(255, 214, 160, 0.14), rgba(255, 214, 160, 0));
    filter: blur(7px);
    pointer-events: none;
  }
  .board__eyebrow {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .board__h {
    margin-top: 0.7rem;
    font-size: clamp(2rem, 3.5vw, 3.05rem);
    line-height: 1.03;
    letter-spacing: -0.038em;
  }
  .board__h em { display: block; font-style: normal; color: var(--amber2); }
  .board__lede {
    margin-top: 0.85rem;
    max-width: 48ch;
    color: var(--body);
    font-size: clamp(0.96rem, 1.2vw, 1.04rem);
    line-height: 1.55;
  }
  .board__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }
  .board__fine {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* buttons -------------------------------------------------------------- */
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.5rem 0.85rem 1.2rem;
    border-radius: 3px;
    background: var(--red);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 20px 44px -20px rgba(200, 0, 40, 0.9);
  }
  .store svg { width: 24px; height: 24px; fill: currentColor; flex: none; }
  .store span { display: flex; flex-direction: column; line-height: 1.08; font-size: 1.1rem; font-weight: 600; letter-spacing: -0.01em; }
  .store small { font-size: 0.64rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
  .store.is-pending {
    background: rgba(200, 0, 40, 0.16);
    border: 1px solid rgba(255, 90, 122, 0.5);
    color: #ffc7d0;
    box-shadow: none;
    cursor: default;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.3rem;
    border: 1px solid rgba(160, 185, 225, 0.32);
    border-radius: 3px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .ghost:hover { border-color: var(--amber); color: var(--amber); }
</style>

<style>
  /* ==========================================================================
     STATIONS — every section is a place on the line, so they share a rhythm
     (number, name, then the thing itself) and never a card.
     ========================================================================== */
  .seg {
    position: relative;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    border-top: 1px solid var(--line);
  }
  .seg__num {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .seg h2 {
    margin-top: 0.9rem;
    font-size: clamp(1.85rem, 3.8vw, 2.9rem);
    line-height: 1.06;
  }
  .seg__lede {
    margin-top: 1.1rem;
    max-width: 54ch;
    color: var(--body);
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    line-height: 1.6;
  }

  /* platform ------------------------------------------------------------- */
  .plat__rails { display: block; width: 100%; height: 110px; margin-top: 3rem; opacity: 0.9; }
  .plat__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .plat__stop { padding: 1.8rem clamp(1rem, 2vw, 1.6rem) 1.6rem; border-left: 1px solid var(--line); }
  .plat__stop:first-child { border-left: 0; padding-left: 0; }
  .plat__logo { display: block; margin-bottom: 0.9rem; }
  .plat__stop h3 { font-size: 1.2rem; }
  .plat__stop p { margin-top: 0.5rem; color: var(--body); font-size: 0.95rem; line-height: 1.55; }
  .plat__foot {
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    max-width: 52ch;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* tunnel --------------------------------------------------------------- */
  .seg--tunnel { border-top: 0; overflow: hidden; background: #04060b; }
  .tun__ribs { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.85; }
