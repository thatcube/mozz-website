---
/**
 * VARIANT — SUBWAY  ·  "Offline Night Train"
 *
 * THESIS
 * Every other page argues about servers. This one argues about a moment: the
 * train pulls out of the station, the bars die, and the record keeps playing.
 * That is the whole product in one image, so the page is built as one image —
 * a night carriage in strong one-point perspective, drawn entirely in SVG,
 * with the interface printed into the carriage itself.
 *
 * COMPOSITION
 * The hero is a single cinematic plate that fills the viewport. One enormous
 * window runs three quarters of the way across it. Outside, the station the
 * listener just left is a shrinking rectangle of warm light; nearer the camera
 * the tunnel has already swallowed the signal. Inside, the downloaded records
 * are lit posters above the windows and a lamp run overhead. The playback UI
 * is not a phone pasted on the right — it is the size of a carriage door,
 * rendered as the reflection standing in the glass. The headline lives on an
 * illuminated transit panel bolted into the wall, not floating above the art.
 *
 * The rest of the page is the rest of the journey: platform, tunnel, the stops
 * along the line, the departure board, the notices by the doors, the network
 * map, passenger information, terminus. Sections are places, not cards.
 *
 * TRUTH
 * Every claim comes from src/data/site.ts. No invented artists, albums, track
 * times, ratings or counts appear anywhere — the album art on this page is
 * abstract on purpose, and the "now playing" title describes the idea rather
 * than pretending to be a record.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  APP_STORE_URL,
  GITHUB_URL,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
} from '../../data/site';

/* ---------------------------------------------------------------------------
   PERSPECTIVE
   One vanishing point, one helper. `on(nearY, x)` takes a height measured on
   the near plane (the left edge of the frame, x = 0) and returns where that
   same height sits at depth x. `band()` turns two near-plane heights into the
   quad they sweep out between two depths — which is every surface in the
   carriage: ceiling, poster rail, window, seat back, floor.
--------------------------------------------------------------------------- */
const R = (n: number) => Math.round(n * 10) / 10;

const VP = { x: 1370, y: 470 };
const on = (nearY: number, x: number) => R(nearY + (VP.y - nearY) * (x / VP.x));
const band = (a: number, b: number, x0 = -20, x1 = 1150) =>
  `${x0},${on(a, x0)} ${x1},${on(a, x1)} ${x1},${on(b, x1)} ${x0},${on(b, x0)}`;
/** How much a near-plane length has shrunk by the time it reaches depth x. */
const sc = (x: number) => R((VP.x - x) / VP.x * 100) / 100;

/** Near-plane heights, in viewBox units, measured at x = 0. */
const Y = {
  ceil: 100,
  postTop: 120,
  postBot: 248,
  winTop: 276,
  winBot: 760,
  seatTop: 806,
  seatBase: 952,
  floor: 1012,
};

const FAR = 1150;   // where the side wall meets the end vestibule
const END = 1292;   // the far face of the vestibule

/* The end wall and the near right-hand wall, which closes the composition. */
const endWall = `${FAR},${on(Y.ceil, FAR)} ${END},${on(Y.ceil, END)} ${END},${on(Y.floor, END)} ${FAR},${on(Y.floor, FAR)}`;
const rightWall = `${END},${on(Y.ceil, END)} 1620,140 1620,920 ${END},${on(Y.floor, END)}`;
const ceilZone = `-20,-40 1620,-40 1620,140 ${END},${on(Y.ceil, END)} -20,${on(Y.ceil, -20)}`;
const floorZone = `-20,1040 1620,1040 1620,920 ${END},${on(Y.floor, END)} -20,${on(Y.floor, -20)}`;

/* Downloaded records, lit like advertising above the windows. Widths decay
   with depth because the poster rail is running away from the camera. */
const POSTERS = [
  { x0: -20, x1: 250, c: 0 },
  { x0: 292, x1: 512, c: 1 },
  { x0: 548, x1: 726, c: 2 },
  { x0: 758, x1: 900, c: 3 },
  { x0: 928, x1: 1044, c: 4 },
];

/** Strip-light run down the middle of the ceiling. */
const LAMPS = [-30, 130, 300, 462, 606, 730, 838, 928, 1002, 1062];

/** Tunnel ribs, receding toward the mouth we came in by. */
const RIBS = [70, 130, 210, 310, 430, 570, 730, 910, 1110];

/** Mullions dividing the long window. */
const MULLIONS = [128, 372, 578, 752, 896, 1014];

/* ---------------------------------------------------------------------------
   COVER ART
   Abstract, generated, never a real record. Six palettes, six constructions.
--------------------------------------------------------------------------- */
type Kind = 'arc' | 'bars' | 'orbit' | 'wave' | 'grid' | 'split';

const COVERS: { kind: Kind; a: string; b: string }[] = [
  { kind: 'orbit', a: '#ffb347', b: '#2a1b3d' },
  { kind: 'bars', a: '#63d3ea', b: '#0d2733' },
  { kind: 'arc', a: '#ff5f7e', b: '#31121f' },
  { kind: 'wave', a: '#4ee0a4', b: '#0f2a24' },
  { kind: 'grid', a: '#c9d4ff', b: '#171a33' },
  { kind: 'split', a: '#ffd9a0', b: '#331f12' },
];

function cover(i: number): string {
  const { kind, a, b } = COVERS[i % COVERS.length];
  const base = `<rect width="100" height="100" fill="${b}"/>`;
  if (kind === 'orbit')
    return `${base}<circle cx="50" cy="50" r="31" fill="none" stroke="${a}" stroke-width="3" opacity=".85"/><circle cx="50" cy="50" r="19" fill="none" stroke="${a}" stroke-width="3" opacity=".5"/><circle cx="50" cy="50" r="6" fill="${a}"/>`;
  if (kind === 'bars')
    return `${base}<g fill="${a}"><rect x="16" y="52" width="9" height="30"/><rect x="30" y="34" width="9" height="48"/><rect x="44" y="20" width="9" height="62"/><rect x="58" y="42" width="9" height="40"/><rect x="72" y="60" width="9" height="22"/></g>`;
  if (kind === 'arc')
    return `${base}<path d="M8 84a42 42 0 0 1 84 0" fill="none" stroke="${a}" stroke-width="7"/><path d="M26 84a24 24 0 0 1 48 0" fill="none" stroke="${a}" stroke-width="4" opacity=".55"/>`;
  if (kind === 'wave')
    return `${base}<path d="M0 58q12-24 25 0t25 0 25 0 25 0" fill="none" stroke="${a}" stroke-width="4"/><path d="M0 74q12-24 25 0t25 0 25 0 25 0" fill="none" stroke="${a}" stroke-width="4" opacity=".45"/>`;
  if (kind === 'grid')
    return `${base}<g fill="${a}"><rect x="16" y="16" width="20" height="20"/><rect x="42" y="16" width="20" height="20" opacity=".45"/><rect x="68" y="16" width="14" height="20" opacity=".7"/><rect x="16" y="42" width="20" height="20" opacity=".6"/><rect x="42" y="42" width="40" height="20"/><rect x="16" y="68" width="66" height="14" opacity=".35"/></g>`;
  return `${base}<path d="M0 100 100 0v100Z" fill="${a}" opacity=".9"/><path d="M0 100 62 38 100 76v24Z" fill="${b}" opacity=".55"/>`;
}

/* ---------------------------------------------------------------------------
   THE SAME CARRIAGE, STOOD UP
   A phone is not a letterbox, so the portrait plate is a second drawing rather
   than the wide one squeezed. Same vanishing-point maths, taller near plane,
   fewer objects — the window still runs the width of the frame.
--------------------------------------------------------------------------- */
const VPT = { x: 330, y: 640 };
const onT = (nearY: number, x: number) => R(nearY + (VPT.y - nearY) * (x / VPT.x));
const bandT = (a: number, b: number, x0 = -20, x1 = 280) =>
  `${x0},${onT(a, x0)} ${x1},${onT(a, x1)} ${x1},${onT(b, x1)} ${x0},${onT(b, x0)}`;
const scT = (x: number) => R((VPT.x - x) / VPT.x * 100) / 100;

const T = {
  ceil: 150,
  postTop: 176,
  postBot: 322,
  winTop: 356,
  winBot: 986,
  seatTop: 1030,
  seatBase: 1210,
  floor: 1330,
};

const TFAR = 280;
const TEND = 322;
const tEndWall = `${TFAR},${onT(T.ceil, TFAR)} ${TEND},${onT(T.ceil, TEND)} ${TEND},${onT(T.floor, TEND)} ${TFAR},${onT(T.floor, TFAR)}`;
const tRightWall = `${TEND},${onT(T.ceil, TEND)} 580,430 580,1010 ${TEND},${onT(T.floor, TEND)}`;
const tCeilZone = `-20,-40 580,-40 580,430 ${TEND},${onT(T.ceil, TEND)} -20,${onT(T.ceil, -20)}`;
const tFloorZone = `-20,1540 580,1540 580,1010 ${TEND},${onT(T.floor, TEND)} -20,${onT(T.floor, -20)}`;

const TPOSTERS = [
  { x0: -20, x1: 112, c: 0 },
  { x0: 142, x1: 230, c: 2 },
  { x0: 248, x1: 278, c: 3 },
];
const TLAMPS = [-10, 88, 170, 232, 274, 302];
const TRIBS = [50, 100, 170, 260, 370, 500];
const TMULLIONS = [96, 200, 262];

/** Short, plain versions of the server notes, for the platform sign. */
const SERVER_LINE: Record<string, string> = {
  Plex: 'Sign in and pick a library',
  Jellyfin: 'Quick Connect or a password',
  Navidrome: 'Any Subsonic server works',
};
---

<Layout
  title="Mozz — the signal ends at the tunnel, your music doesn't"
  description="A free, open source music player for your own Plex, Jellyfin or Navidrome library. Download a record and it keeps playing when the bars run out. No account, no tracking, no subscription."
  themeColor="#04060b"
  noindex
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />
  </Fragment>

  <main class="sub">
    <VariantBar slug="subway" tone="neutral" />

    <!-- ====================================================================
         HERO — the carriage. One plate, drawn to the edges of the viewport.
         The interface is architecture here: signage, reflection, panel.
    ==================================================================== -->
    <header class="hero">
      <div class="hero__stage" aria-hidden="true">

        <!-- WIDE PLATE ------------------------------------------------- -->
        <svg class="art art--wide" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="sw-ceil" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#070b14" />
              <stop offset="1" stop-color="#111a2b" />
            </linearGradient>
            <linearGradient id="sw-floor" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#070a12" />
              <stop offset=".72" stop-color="#0e1522" />
              <stop offset="1" stop-color="#1a2437" />
            </linearGradient>
            <linearGradient id="sw-wall" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#0b111d" />
              <stop offset="1" stop-color="#162034" />
            </linearGradient>
            <linearGradient id="sw-seat" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#26314e" />
              <stop offset="1" stop-color="#0c1220" />
            </linearGradient>
            <linearGradient id="sw-night" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#010205" />
              <stop offset=".62" stop-color="#050a14" />
              <stop offset="1" stop-color="#0d1626" />
            </linearGradient>
            <radialGradient id="sw-station" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#ffd9a0" stop-opacity=".95" />
              <stop offset=".38" stop-color="#ffb347" stop-opacity=".38" />
              <stop offset="1" stop-color="#ffb347" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="sw-lamp" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#dbe8ff" stop-opacity=".55" />
              <stop offset="1" stop-color="#dbe8ff" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="sw-spill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffd9a0" stop-opacity=".22" />
              <stop offset="1" stop-color="#ffd9a0" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="sw-sheen" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#9fc4ff" stop-opacity=".16" />
              <stop offset=".45" stop-color="#9fc4ff" stop-opacity="0" />
              <stop offset="1" stop-color="#9fc4ff" stop-opacity=".07" />
            </linearGradient>
            <linearGradient id="sw-right" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#1a2740" />
              <stop offset=".45" stop-color="#0d1524" />
              <stop offset="1" stop-color="#060a12" />
            </linearGradient>
            <linearGradient id="sw-doorglass" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffd9a0" stop-opacity=".26" />
              <stop offset=".55" stop-color="#7fa6e0" stop-opacity=".14" />
              <stop offset="1" stop-color="#7fa6e0" stop-opacity=".03" />
            </linearGradient>
            {COVERS.map((c, i) => (
              <linearGradient id={'sw-p' + i} x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color={c.a} stop-opacity=".92" />
                <stop offset="1" stop-color={c.b} stop-opacity=".95" />
              </linearGradient>
            ))}
            <clipPath id="sw-win">
              <polygon points={band(Y.winTop, Y.winBot)} />
            </clipPath>
          </defs>

          <!-- night beyond every surface -->
          <rect width="1600" height="1000" fill="#04060b" />

          <!-- the long window, and the world going past it ---------------- -->
          <g clip-path="url(#sw-win)">
            <rect x="-20" y="200" width="1660" height="500" fill="url(#sw-night)" />
            <!-- tunnel wall: close, curved, lit only by us -->
            <path d="M-20 246 Q 420 320 1218 448 L1218 496 Q 420 640 -20 792 Z" fill="#0a1120" opacity=".9" />
            <path d="M-20 246 Q 420 320 1218 448" fill="none" stroke="#33456a" stroke-width="2.5" opacity=".7" />
            <path d="M-20 792 Q 420 640 1218 496" fill="none" stroke="#2a3a5c" stroke-width="2" opacity=".6" />
            <!-- the station we just left, shrinking -->
            <circle cx="1218" cy="472" r="190" fill="url(#sw-station)" />
            <rect x="1150" y="455" width="132" height="34" fill="#ffcf8a" opacity=".5" />
            <rect x="1150" y="447" width="132" height="5" fill="#fff0d4" opacity=".8" />
            <!-- tunnel ribs racing back toward it -->
            {RIBS.map((s, i) => (
              <path
                d={'M' + (1218 - s) + ',' + R(472 - s * 0.52) + ' Q' + R(1218 - s * 0.82) + ',472 ' + (1218 - s) + ',' + R(472 + s * 0.52)}
                fill="none"
                stroke="#6f89b8"
                stroke-width={R(1 + i * 0.55)}
                opacity={R(0.5 - i * 0.04)}
              />
            ))}
            <!-- cable runs and the odd safety lamp -->
            <path d="M-20 392 Q 500 430 1218 462" fill="none" stroke="#2b3a55" stroke-width="3" opacity=".7" />
            <path d="M-20 470 Q 520 486 1218 474" fill="none" stroke="#2b3a55" stroke-width="2.4" opacity=".55" />
            <path d="M-20 560 Q 540 528 1218 484" fill="none" stroke="#243149" stroke-width="2" opacity=".5" />
            {[40, 300, 600, 840, 1010].map((x, i) => (
              <circle cx={x} cy={R(430 + i * 9)} r={R(7 - i * 1.1)} fill="#ff9d2e" opacity=".8" />
            ))}
            <!-- speed streaks; motion only when motion is welcome -->
            <g class="streaks" stroke="#8fb4ee" stroke-linecap="round">
              {[318, 366, 512, 604, 652].map((y, i) => (
                <line
                  class={'streak streak--' + i}
                  x1={R(-300 + i * 268)} y1={y} x2={R(-20 + i * 268)} y2={R(y + 4)}
                  stroke-width={R(3 - i * 0.3)}
                  opacity={R(0.42 - i * 0.045)}
                />
              ))}
            </g>
            <!-- glass: sheen, and the lamp run standing in the reflection -->
            <polygon points={band(Y.winTop, Y.winBot)} fill="url(#sw-sheen)" />
            {LAMPS.map((x) => (
              <rect
                x={R(x - 62 * sc(x))} y={R(on(Y.winTop + 150, x) - 5 * sc(x))}
                width={R(124 * sc(x))} height={R(10 * sc(x))}
                rx={R(5 * sc(x))} fill="#cfe0ff" opacity=".13"
              />
            ))}
          </g>
          <polygon points={band(Y.winTop, Y.winBot)} fill="none" stroke="#3c4d6d" stroke-width="2" />

          <!-- mullions -->
          {MULLIONS.map((x) => (
            <rect
              x={R(x - 7 * sc(x))} y={on(Y.winTop, x)}
              width={R(14 * sc(x))} height={R(on(Y.winBot, x) - on(Y.winTop, x))}
              fill="#151d2e" stroke="#31405c" stroke-width="1"
            />
          ))}

          <!-- ceiling and floor close the box -->
          <polygon points={ceilZone} fill="url(#sw-ceil)" />
          <polygon points={floorZone} fill="url(#sw-floor)" />
          <polygon points={rightWall} fill="url(#sw-right)" />
          <!-- the doors on our own side, closed, station light still on them -->
          <polygon points="1344.5,399.6 1390.4,356.3 1390.4,626.7 1344.5,568" fill="#0f1828" stroke="#2c3c5c" stroke-width="1.4" />
          <polygon points="1400.2,347 1446.2,303.8 1446.2,698 1400.2,639.3" fill="#0f1828" stroke="#2c3c5c" stroke-width="1.4" />
          <polygon points="1351,415 1384,384 1384,497 1351,486" fill="url(#sw-doorglass)" />
          <polygon points="1406,362 1440,331 1440,566 1406,548" fill="url(#sw-doorglass)" />
          <!-- hand poles, catching the strip light -->
          <line x1="1488.8" y1="263.6" x2="1488.8" y2="751.4" stroke="#54688d" stroke-width="7" opacity=".55" />
          <line x1="1486" y1="263.6" x2="1486" y2="751.4" stroke="#a8c2ee" stroke-width="2" opacity=".38" />
          <line x1="1574.1" y1="183.3" x2="1574.1" y2="861.3" stroke="#54688d" stroke-width="9" opacity=".4" />
          <polygon points={rightWall} fill="none" stroke="#243252" stroke-width="1.5" />

          <!-- the vestibule at the end, doors lit from the platform -->
          <polygon points={endWall} fill="#0c1322" />
          <rect x="1176" y="424" width="38" height="118" rx="3" fill="#101a2c" stroke="#33456a" stroke-width="1.2" />
          <rect x="1222" y="424" width="38" height="118" rx="3" fill="#101a2c" stroke="#33456a" stroke-width="1.2" />
          <rect x="1180" y="430" width="30" height="54" fill="#ffcf8a" opacity=".3" />
          <rect x="1226" y="430" width="30" height="54" fill="#ffcf8a" opacity=".3" />
          <polygon points={endWall} fill="none" stroke="#2b3a58" stroke-width="1.5" />

          <!-- upper wall, poster rail, lower wall -->
          <polygon points={band(Y.ceil, Y.postTop)} fill="#0b111d" />
          <polygon points={band(Y.postTop, Y.postBot)} fill="url(#sw-wall)" />
          <polygon points={band(Y.postBot, Y.winTop)} fill="#0a1018" />
          <polygon points={band(Y.winBot, Y.floor)} fill="url(#sw-wall)" />
          <polygon points={band(Y.seatTop, Y.seatBase)} fill="url(#sw-seat)" />
          <polygon points={band(Y.seatTop, Y.seatTop + 12)} fill="#c80028" opacity=".5" />

          <!-- seat divisions, running away -->
          {[70, 300, 500, 664, 796, 900, 984].map((x) => (
            <line
              x1={x} y1={on(Y.seatTop, x)} x2={x} y2={on(Y.seatBase, x)}
              stroke="#050810" stroke-width={R(6 * sc(x))} opacity=".8"
            />
          ))}
          <!-- cushion lip, and the light the strip run drops on the floor -->
          <polygon points={band(Y.seatBase - 30, Y.seatBase)} fill="#2a3550" />
          <polygon points={band(Y.seatBase - 30, Y.seatBase - 22)} fill="#9fc4ff" opacity=".1" />
          {LAMPS.map((x) => (
            <ellipse
              cx={x} cy={on(Y.floor + 46, x)}
              rx={R(168 * sc(x))} ry={R(30 * sc(x))}
              fill="url(#sw-lamp)" opacity=".45"
            />
          ))}

          <!-- downloaded records, lit above the windows -->
          {POSTERS.map((p) => {
            const cx = (p.x0 + p.x1) / 2;
            const top = on(Y.postTop + 14, cx);
            const bot = on(Y.postBot - 14, cx);
            const rr = R(((bot - top) / 2) * 0.58);
            const tx = R(p.x1 - 30 * sc(p.x1));
            return (
              <g>
                <polygon points={band(Y.postBot - 14, Y.postBot + 52, p.x0 + 16, p.x1 - 16)} fill="url(#sw-spill)" />
                <polygon points={band(Y.postTop + 6, Y.postBot - 6, p.x0 + 8, p.x1 - 8)} fill="#060a12" stroke="#2c3b58" stroke-width="1.4" />
                <polygon points={band(Y.postTop + 14, Y.postBot - 14, p.x0 + 16, p.x1 - 16)} fill={'url(#sw-p' + p.c + ')'} />
                <circle cx={cx} cy={R((top + bot) / 2)} r={rr} fill="none" stroke="#04060b" stroke-width={R(rr * 0.22)} opacity=".55" />
                <circle cx={cx} cy={R((top + bot) / 2)} r={R(rr * 0.3)} fill="#04060b" opacity=".7" />
                <circle cx={tx} cy={R(bot - 16 * sc(p.x1))} r={R(11 * sc(p.x1))} fill="#4ee0a4" />
                <path
                  d={'M' + R(tx - 5 * sc(p.x1)) + ',' + R(bot - 16 * sc(p.x1)) + ' l' + R(3.5 * sc(p.x1)) + ',' + R(4 * sc(p.x1)) + ' l' + R(6 * sc(p.x1)) + ',-' + R(7.5 * sc(p.x1))}
                  fill="none" stroke="#04231a" stroke-width={R(2.6 * sc(p.x1))} stroke-linecap="round" stroke-linejoin="round"
                />
              </g>
            );
          })}

          <!-- strip lights -->
          {LAMPS.map((x) => (
            <g>
              <ellipse cx={x} cy={on(40, x)} rx={R(150 * sc(x))} ry={R(60 * sc(x))} fill="url(#sw-lamp)" />
              <rect
                x={R(x - 66 * sc(x))} y={R(on(40, x) - 8 * sc(x))}
                width={R(132 * sc(x))} height={R(16 * sc(x))}
                rx={R(8 * sc(x))} fill="#eef4ff" opacity=".9"
              />
            </g>
          ))}

          <!-- stanchions -->
          {[884, 1042].map((x) => (
            <rect
              x={R(x - 5 * sc(x))} y={on(Y.ceil + 10, x)}
              width={R(10 * sc(x))} height={R(on(Y.floor, x) - on(Y.ceil + 10, x))}
              fill="#2b3549" opacity=".9"
            />
          ))}
          <rect x="1466" y="-20" width="26" height="1040" fill="#141c2c" />
          <rect x="1466" y="-20" width="6" height="1040" fill="#28344c" />
        </svg>

        <!-- PORTRAIT PLATE ---------------------------------------------- -->
        <svg class="art art--tall" viewBox="0 0 560 1500" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="sw-t-ceil" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#070b14" />
              <stop offset="1" stop-color="#111a2b" />
            </linearGradient>
