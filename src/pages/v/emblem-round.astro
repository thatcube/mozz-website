---
/**
 * VARIANT — EMBLEM ROUND · the chosen direction
 *
 * The catalogue, stamped with the real face printed on a true circle — the
 * smooth outline those pixel steps were always approximating, so the plate
 * stays quiet and the pixels stay the only texture on it.
 *
 * This is the printing that ships. The homepage renders exactly this file with
 * `review={false}`, which drops the comparison bar and lets the page be
 * indexed; /v/emblem-round keeps both so the shortlist still reads as a
 * shortlist. There is no second copy of the page anywhere.
 */
import EmblemPage from '../../components/emblem/EmblemPage.astro';

export interface Props {
  /** True on the review route, false on the homepage. */
  review?: boolean;
}

const { review = true } = Astro.props;
---

<EmblemPage
  stamp="round"
  slug="emblem-round"
  label="Emblem Round — catalogue of the system"
  review={review}
/>
