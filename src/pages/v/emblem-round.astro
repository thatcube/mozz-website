---
/**
 * VARIANT — EMBLEM ROUND
 *
 * Emblem, with the real face on a true circle instead of a stepped one.
 *
 * Everything else is deliberately identical to /v/emblem so the two can be read
 * side by side: the same museum catalogue, the same accession numbers, the same
 * fixed left rail, the same stacked hairline rule for the register narrowing as
 * you type. The single difference is the stamp. Where emblem prints a red
 * square holding a bone circle with a centre dot, this prints the real Mozz
 * mark at plate scale — the pixel disc, the zz eyes and the smile — and repeats
 * it as the identifying stamp the same way.
 *
 * No oversized wordmark anywhere: this concept deliberately never shouts.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Sleeve from '../../components/sleeve/Sleeve.astro';
import MarkStamp from '../../components/sleeve/MarkStampRound.astro';
import SleeveWall from '../../components/sleeve/SleeveWall.astro';
import Narrowing from '../../components/sleeve/Narrowing.astro';
import Vesica from '../../components/sleeve/Vesica.astro';
import CutRing from '../../components/sleeve/CutRing.astro';
import Radiate from '../../components/sleeve/Radiate.astro';
import Gapless from '../../components/sleeve/Gapless.astro';
import Equalizer from '../../components/sleeve/Equalizer.astro';
import Weekly from '../../components/sleeve/Weekly.astro';
import Device from '../../components/sleeve/Device.astro';
import StoreButton from '../../components/sleeve/StoreButton.astro';
import { featureMark, termMark, CATALOG } from '../../data/sleeve-art';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  PLATFORMS,
  PLATFORM_LINE,
} from '../../data/site';

const HEADLINE = 'Every record, catalogued and in your hands.';
const SUPPORT =
  'A free, open source player for Plex, Jellyfin and Subsonic libraries. Stream it from the server, or take it with you.';

/** Accession numbers for the ruled rows. Purely typographic. */
const acc = (n: number) => `MZ.${String(n).padStart(3, '0')}`;
---

<Layout
  title={`${NAME} — every record, catalogued`}
  description={`Mozz is a free, open source music player that catalogues your own Plex, Jellyfin or Subsonic library on the device, so streaming and downloads behave the same. ${PLATFORM_LINE}`}
  themeColor="#eeeae2"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="emblem">
    <VariantBar slug="emblem-round" tone="warm" />

    <header class="masthead">
      <a class="lockup" href="/" aria-label={`${NAME} home`}>
        <Mark size={30} decorative />
        <span>{NAME}</span>
      </a>
      <p>Emblem Mark — catalogue of the system</p>
      <p class="mast-end">Plate 00 · GPL-3.0</p>
    </header>

    <section class="hero" aria-labelledby="emblem-hero">
      <div class="rail">
        <p class="acc">{acc(0)}</p>
        <p class="rail-note">Accession</p>
      </div>
      <div class="hero-body">
        <p class="kicker">Free forever · open source · no account</p>
        <h1 id="emblem-hero">{HEADLINE}</h1>
        <p class="hero-support">{SUPPORT}</p>

        <div class="editions">
          <p class="editions-cap">
            <span>{acc(10)}</span>Issued in {PLATFORMS.length} editions
          </p>
          <ul role="list">
            {PLATFORMS.map((platform) => (
              <li>{platform.short}</li>
            ))}
          </ul>
        </div>

        <div class="actions">
          <StoreButton />
          <a class="ghost" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="hero-stats">
          {STATS.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="hero-stamp">
        <MarkStamp ground="red" label="The Mozz face printed at plate scale on a true circle: the stamp on every entry in this catalogue" />
        <p class="stamp-note">The mark, stamped on every plate below</p>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-sources">
      <div class="rail">
        <p class="acc">{acc(1)}</p>
        <p class="rail-note">Sources</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-sources">Three ways in, one catalogue out.</h2>
        <p class="lede">{FAQS[0].a}</p>

        <ul class="plates" role="list">
          {SERVERS.map((server, i) => (
            <li>
              <span class="plate-no">{acc(101 + i)}</span>
              <span class="plate-logo"><ServerLogo name={server.name} size={38} /></span>
              <h3>{server.name}</h3>
              <p>{server.note}</p>
            </li>
          ))}
        </ul>

        <figure class="fig">
          <Radiate />
          <figcaption>
            <span>Plate {acc(110)}</span>
            <span>
              The catalogue leaves one machine you already own and reaches every
              device you carry. Nothing in the middle of this drawing belongs to us.
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="entry entry--wall" aria-labelledby="emblem-wall">
      <div class="rail">
        <p class="acc">{acc(2)}</p>
        <p class="rail-note">Holdings</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-wall">The holdings are already yours.</h2>
        <p class="lede">{FEATURES[0].body}</p>

        <div class="the-wall">
          <SleeveWall count={80} seed={41} min="52px" gap="6px" />
        </div>

        <ol class="ledger" role="list">
          {CATALOG.slice(0, 6).map((record, i) => (
            <li>
              <span>{acc(201 + i)}</span>
              <span class="ledger-title">{record.title}</span>
              <span class="ledger-artist">{record.artist}</span>
              <span class="ledger-year">{record.no}</span>
            </li>
          ))}
        </ol>
        <p class="ledger-note">
          Sleeves and titles shown are drawn placeholders. Your catalogue is
          whatever is already on your server.
        </p>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-search">
      <div class="rail">
        <p class="acc">{acc(3)}</p>
        <p class="rail-note">The register</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-search">{FEATURES[2].title}.</h2>
        <p class="lede">{FEATURES[2].body}</p>

        <figure class="fig fig--flush">
          <Narrowing />
          <figcaption>
            <span>Plate {acc(301)}</span>
            <span>
              Each column is the same register, one keystroke later. The rules
              are the results, and they shorten while you are still typing.
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-parity">
      <div class="rail">
        <p class="acc">{acc(4)}</p>
        <p class="rail-note">Two modes</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-parity">Streamed and downloaded, cataloged identically.</h2>

        <figure class="fig">
          <Vesica />
          <figcaption>
            <span>Plate {acc(401)}</span>
            <span>Streaming and downloads, drawn the same size. Neither is the main one.</span>
          </figcaption>
        </figure>

        <div class="two-up">
          <article>
            <p class="key">A — Streaming</p>
            <p>
              Play straight off the machine in the other room, over your own
              network. The interface does not change between server families,
              because the app is reading your catalogue rather than someone
              else's.
            </p>
          </article>
          <article>
            <p class="key">B — {FEATURES[1].title}</p>
            <p>{FEATURES[1].body}</p>
          </article>
        </div>

        <div class="cut-row">
          <figure class="fig fig--tall">
            <CutRing />
            <figcaption>
              <span>Plate {acc(402)}</span>
              <span>The notch is the tunnel. The record does not notice.</span>
            </figcaption>
          </figure>
          <div class="cut-copy">
            <p class="key">Downloads</p>
            <p>{FAQS[2].a}</p>
            <ul role="list">
              <li><i aria-hidden="true"></i>The catalogue is held on the device, not fetched on demand.</li>
              <li><i aria-hidden="true"></i>Search and browse with the server unreachable.</li>
              <li><i aria-hidden="true"></i>Come back into range and it is the same library.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-features">
      <div class="rail">
        <p class="acc">{acc(5)}</p>
        <p class="rail-note">Capabilities</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-features">The full list, with its marks.</h2>
        <p class="lede">
          Everything it does, entered one plate at a time. All of it is in the
          free app, because there is no other kind.
        </p>

        <ol class="rows" role="list">
          {FEATURES.map((feature, i) => (
            <li>
              <span class="row-no">{acc(501 + i)}</span>
              <span class="row-mark">
                {featureMark(i).kind === 'nowplaying' ? (
                  <MarkStamp ground="bone" frame />
                ) : (
                  <Sleeve kind={featureMark(i).kind} seed={i * 7 + 1} ground="bone" frame />
                )}
              </span>
              <span class="row-copy">
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </span>
              <span class="row-key">{featureMark(i).key}</span>
            </li>
          ))}
        </ol>

        <div class="fig-pair">
          <figure class="fig">
            <Gapless />
            <figcaption>
              <span>Plate {acc(520)}</span>
              <span>{FEATURES[3].title}</span>
            </figcaption>
          </figure>
          <figure class="fig">
            <Equalizer />
            <figcaption>
              <span>Plate {acc(521)}</span>
              <span>{FEATURES[6].title}</span>
            </figcaption>
          </figure>
        </div>

        <div class="fig-pair fig-pair--uneven">
          <figure class="fig fig--tall">
            <Weekly />
            <figcaption>
              <span>Plate {acc(522)}</span>
              <span>{FEATURES[5].title}</span>
            </figcaption>
          </figure>
          <div class="cut-copy">
            <p class="key">Radio</p>
            <p>{FEATURES[4].body}</p>
            <p class="key key--space">Voice</p>
            <p>{FEATURES[7] ? FEATURES[7].body : FEATURES[FEATURES.length - 1].body}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-hardware">
      <div class="rail">
        <p class="acc">{acc(6)}</p>
        <p class="rail-note">Transfer</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-hardware">Taken up again in the next case.</h2>
        <p class="lede">{CONTINUITY.body}</p>

        <div class="devices">
          <figure>
            <Device
              kind="ipad"
              screen="library"
              width="clamp(240px, 29vw, 400px)"
              label="iPad showing the album grid held on the device"
            />
            <figcaption>iPad — the catalogue, held on device</figcaption>
          </figure>
          <figure>
            <Device
              kind="iphone"
              screen="search"
              width="clamp(172px, 16vw, 236px)"
              label="iPhone searching the whole catalogue on device"
            />
            <figcaption>iPhone — the register, on device</figcaption>
          </figure>
          <figure>
            <Device
              kind="iphone"
              screen="nowplaying"
              width="clamp(172px, 16vw, 236px)"
              label="iPhone playing a downloaded record with no signal"
            />
            <figcaption>iPhone — playing with no signal</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-terms">
      <div class="rail">
        <p class="acc">{acc(7)}</p>
        <p class="rail-note">Conditions</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-terms">The conditions of the loan.</h2>
        <p class="lede">
          There isn't one. It is your library, on your hardware, and the app has
          no claim on it.
        </p>

        <div class="terms">
          {OWNERSHIP.map((term, i) => (
            <article>
              <span class="term-plate">
                {termMark(i).kind === 'nowplaying' ? (
                  <MarkStamp ground={termMark(i).red ? 'red' : 'bone'} frame />
                ) : (
                  <Sleeve kind={termMark(i).kind} seed={i * 9 + 2} ground={termMark(i).red ? 'red' : 'bone'} frame />
                )}
              </span>
              <span class="term-key">{acc(701 + i)} · {termMark(i).key}</span>
              <h3>{term.title}</h3>
              <p>{term.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="entry" aria-labelledby="emblem-faq">
      <div class="rail">
        <p class="acc">{acc(8)}</p>
        <p class="rail-note">Queries</p>
      </div>
      <div class="entry-body">
        <h2 id="emblem-faq">Questions, answered flat.</h2>
        <dl class="faq">
          {FAQS.map((faq, i) => (
            <div>
              <dt><span>{acc(801 + i)}</span>{faq.q}</dt>
              <dd>{faq.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="closing" aria-labelledby="emblem-close">
      <div class="rail rail--invert">
        <p class="acc">{acc(9)}</p>
        <p class="rail-note">Closing</p>
      </div>
      <div class="closing-body">
        <h2 id="emblem-close">{TAGLINE}</h2>
        <p class="closing-lede">
          Your files, on hardware you control, played by an app with no reason to
          know anything about you.
        </p>
        <div class="actions">
          <StoreButton />
          <a class="ghost ghost--invert" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="closing-stamp">
        <MarkStamp ground="red" />
      </div>
    </section>

    <footer class="colophon">
      <a class="lockup" href="/" aria-label={`${NAME} home`}>
        <Mark size={26} decorative />
        <span>{NAME}</span>
      </a>
      <p>{SUBLINE} GPL-3.0 with an App Store Exception.</p>
      <a class="ghost ghost--small" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </main>
</Layout>

<style>
  :global(html) { background: #eeeae2; }

  :global(body) {
    margin: 0;
    background: #eeeae2;
  }

  :global(*:focus-visible) {
    outline: 2px solid #c80028;
    outline-offset: 4px;
  }

  .emblem {
    --paper: #eeeae2;
    --ink: #1b1c1e;
    --red: #c80028;
    --rule: #cdc7b8;
    --rule-soft: #ddd7ca;
    --gut: clamp(1.15rem, 4.5vw, 3.5rem);
    --rail-w: clamp(4.5rem, 12vw, 11rem);
    --body: 'IBM Plex Sans', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --sl-ink: #1b1c1e;
    --sl-bone: #eeeae2;
    --sl-red: #c80028;
    --sl-rule: #cdc7b8;
    --sl-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --store-bg: #1b1c1e;
    --store-fg: #eeeae2;
    --store-bg-hover: #c80028;
    --store-pending-fg: #1b1c1e;
    --store-pending-border: rgba(27, 28, 30, 0.4);

    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  /* Masthead ----------------------------------------------------------- */
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gut);
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .mast-end { text-align: right; }

  @media (max-width: 48rem) {
    .masthead p:not(.mast-end) { display: none; }
  }

  /* The rail ------------------------------------------------------------ */
  .hero,
  .entry,
  .closing {
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.6rem);
    padding: clamp(2.4rem, 5vw, 4.6rem) var(--gut);
    border-bottom: 1px solid var(--rule);
  }

  .rail {
    align-self: start;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .acc {
    color: var(--red);
    font-weight: 600;
  }

  .rail-note {
    margin-top: 0.4rem;
    opacity: 0.55;
  }

  @media (max-width: 52rem) {
    .hero,
    .entry,
    .closing { grid-template-columns: 1fr; }

    .rail {
      position: static;
      display: flex;
      gap: 0.8rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail-note { margin-top: 0; }
  }

  /* Hero ---------------------------------------------------------------- */
  .hero {
    grid-template-columns: var(--rail-w) minmax(0, 1.5fr) minmax(0, 0.62fr);
    align-items: start;
    padding-top: clamp(2.6rem, 6vw, 5.4rem);
  }

  .kicker {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .hero h1 {
    margin-top: clamp(1rem, 2.4vw, 1.7rem);
    font-size: clamp(2.15rem, 4.8vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    font-weight: 600;
    max-width: 17ch;
    text-wrap: balance;
  }

  .hero-support {
    margin-top: clamp(1.1rem, 2vw, 1.6rem);
    max-width: 48ch;
    font-size: clamp(1rem, 1.25vw, 1.14rem);
    line-height: 1.6;
    opacity: 0.78;
  }

  /* Editions ------------------------------------------------------------ */
  /*
   * Where the catalogue is issued. A print catalogue gives the edition a ruled
   * line of its own rather than a badge, so the machines are set as a specimen
   * row in the same hairline vocabulary as the plates below — type only, since
   * six vendor logos would shout on a page that never shouts.
   */
  .editions {
    margin-top: clamp(1.5rem, 2.8vw, 2.1rem);
    max-width: 34rem;
  }

  .editions-cap {
    display: flex;
    gap: 0.7rem;
    color: rgba(27, 28, 30, 0.62);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .editions-cap span {
    color: var(--red);
    font-weight: 600;
  }

  .editions ul {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 0.5rem;
    border-top: 2px solid var(--ink);
    border-left: 1px solid var(--rule);
  }

  .editions li {
    padding: 0.62rem 0.45rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    margin-top: clamp(1.4rem, 3vw, 2.1rem);
  }

  .ghost {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--red);
  }

  .ghost:hover { color: var(--red); }
  .ghost--small { font-size: 0.64rem; }
  .ghost--invert { color: var(--paper); }
  .ghost--invert:hover { color: var(--paper); border-bottom-color: var(--paper); }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.8rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.3rem, 2.6vw, 2rem);
    border-top: 1px solid var(--rule);
    max-width: 34rem;
  }

  .hero-stats dt {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
    line-height: 1.5;
  }

  .hero-stats dd {
    margin: 0.4rem 0 0;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .hero-stats div:last-child dd { color: var(--red); }

  .hero-stamp :global(svg) { width: 100%; height: auto; display: block; }

  .stamp-note {
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  @media (max-width: 68rem) {
    .hero { grid-template-columns: var(--rail-w) minmax(0, 1fr); }
    .hero-stamp { grid-column: 2; max-width: 13rem; }
  }

  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; }
    .hero-stamp { grid-column: 1; max-width: 14rem; }

    /* Six cells across a phone would set every name in a column two letters
       wide, so the specimen row folds to two ruled rows of three. */
    .editions ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Entries ------------------------------------------------------------- */
  .entry-body h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 600;
    max-width: 21ch;
    text-wrap: balance;
  }

  .lede {
    margin-top: 1.1rem;
    max-width: 58ch;
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.62;
    opacity: 0.76;
  }

  /* Server plates ------------------------------------------------------- */
  .plates {
