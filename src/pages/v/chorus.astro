---
/**
 * VARIANT — CHORUS
 *
 * The synthesis that leads with COVER: the wordmark half-hidden behind the
 * thing that plays it, with a few very minimal drawn marks around it and
 * nothing else in the frame.
 *
 * UMBRA is not a device here, it is the whole document. The page begins at
 * ground black, lifts through deep red to full red, and then breaks at a hard
 * horizon into cream — one long fall of light from top to bottom, so where you
 * are on the page is the same question as how much light there is.
 *
 * ECLIPSE supplies the crossing in the hero — the object passing in front of
 * the type, and the type changing where it passes. Below the hero the chapters
 * are marked by a rule, a red tick and a great deal of air, because the
 * enormous wordmark is a hero gesture and reprinting it behind every heading
 * would turn it into wallpaper. POSTER prints the closing sheet — full-measure
 * wordmark, billing list, colophon — and that is its second and last outing.
 *
 * Payoffs: a marquee of sleeves for the weekly mix, a split against a drawn
 * pair of headphones rather than a player, iPhone and iPad moving with the
 * scroll, and a wall of sleeves as decoration behind the questions.
 *
 * Every claim comes from src/data/site.ts.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import SynPhone from '../../components/syn/SynPhone.astro';
import SynSlate from '../../components/syn/SynSlate.astro';
import SynMotion from '../../components/syn/SynMotion.astro';
import { sleeve, sleeveRun, INK_LIGHT, INK_DARK, INK_RED } from '../../data/syn-art';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
  SITE,
} from '../../data/site';

const HEADLINE = 'Mozz is a free player for the music on your server.';
const SUPPORT =
  'Stream your library at home from Plex, Jellyfin or Navidrome, or download albums and listen with no signal at all.';

const domain = SITE.replace(/^https?:\/\//, '');
const BILL = ['Streaming', 'Downloads', 'Radio', 'Mozz Weekly', 'iPhone and iPad'];

const HERO_ART = sleeve({ kind: 'halftone', ink: INK_RED, seed: 'chorus-hero' });
const OFF_ART = sleeve({ kind: 'grooves', ink: INK_DARK, seed: 'chorus-off' });
const PAIR_ART = sleeve({ kind: 'target', ink: INK_RED, seed: 'chorus-pair' });
const SLATE_COVERS = sleeveRun(12, INK_DARK, 'chorus-slate');
const MARQUEE_ROWS = [
  sleeveRun(10, INK_LIGHT, 'chorus-m1'),
  sleeveRun(10, INK_RED, 'chorus-m2'),
  sleeveRun(10, INK_DARK, 'chorus-m3'),
];
const WALL = sleeveRun(28, INK_LIGHT, 'chorus-wall');

const BOTH = [
  {
    tag: 'At home',
    title: 'Streaming',
    body: 'Your own network carries your own library. Mozz connects straight to the server you run and mirrors its catalog onto the device as it plays.',
  },
  {
    tag: 'Anywhere else',
    title: 'Downloads',
    body: 'A downloaded album is not a lesser mode of the app. Same shelf, same queue, same search — with nothing to connect to.',
  },
];
---

<Layout
  title={`${NAME} — a free player for the music on your server`}
  description="Mozz is a free, open source music player for iPhone and iPad. Stream the music on your own Plex, Jellyfin, Navidrome or Subsonic server, or download albums and play them offline."
  themeColor="#0a070d"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,600..900&family=Geologica:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SynMotion />

  <main class="chorus">
    <VariantBar slug="chorus" tone="neutral" />

    <!-- ==================================================================
         NIGHT — everything from here to the horizon sits in one long fall
         of light, black at the top and full red by the time it ends.
    =================================================================== -->
    <div class="dawn">
      <!-- HERO — cover: the word, and the thing that plays it in front. -->
      <header class="hero">
        <div class="halo" aria-hidden="true"></div>

        <div class="topbar">
          <span class="lockup">
            <Mark size={34} decorative />
            <span>
              <b>{NAME}</b>
              <small>Self-hosted music player</small>
            </span>
          </span>

          <div class="actions">
            {
              APP_STORE_URL ? (
                <a class="btn solid" href={APP_STORE_URL}>
                  Download on the App Store
                </a>
              ) : (
                <span class="btn solid is-pending" aria-disabled="true">
                  Coming to the App Store
                </span>
              )
            }
            <a class="btn ghost" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hero-copy">
          <p class="eyebrow">For iPhone and iPad</p>
          <h1>{HEADLINE}</h1>
          <p class="summary">{SUPPORT}</p>
          <p class="compat">
            <span>Plays from</span>
            <b>Plex</b>
            <i aria-hidden="true"></i>
            <b>Jellyfin</b>
            <i aria-hidden="true"></i>
            <b>Navidrome</b>
            <i aria-hidden="true"></i>
            <b>Subsonic</b>
          </p>
        </div>

        <div class="cover-stage">
          <span class="cover-word" aria-hidden="true">MOZZ</span>

          <svg class="spark spark-one" viewBox="0 0 70 70" aria-hidden="true">
            <path d="M35 3v64M3 35h64M12.4 12.4l45.2 45.2M57.6 12.4 12.4 57.6"></path>
          </svg>
          <svg class="spark spark-two" viewBox="0 0 70 70" aria-hidden="true">
            <path d="M35 3v64M3 35h64"></path>
          </svg>

          <svg class="arcs" viewBox="0 0 46 84" aria-hidden="true">
            <path
              d="M6 10a44 44 0 0 1 0 64M20 21a28 28 0 0 1 0 42M34 32a13 13 0 0 1 0 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"></path>
          </svg>

          <svg class="bars" viewBox="0 0 34 26" aria-hidden="true">
            <rect class="b1" x="0" y="6" width="6" height="20"></rect>
            <rect class="b2" x="10" y="0" width="6" height="26"></rect>
            <rect class="b3" x="20" y="11" width="6" height="15"></rect>
            <rect class="b4" x="30" y="17" width="4" height="9"></rect>
          </svg>

          <div class="hero-phone">
            <SynPhone
              width="clamp(210px, 21vw, 330px)"
              art={HERO_ART}
              title="Quiet Geometry"
              artist="Air Index"
              label="An iPhone in front of the Mozz wordmark, showing the now playing screen for an album streaming from a home server."
            />
          </div>
        </div>

        <p class="hero-foot">
          <span>{SUBLINE}</span>
          <span>{TAGLINE}</span>
        </p>
      </header>

      <!-- SERVERS -->
      <section class="chapter servers" aria-labelledby="ch-servers">
        <div class="chapter-head">
          <div class="chapter-title">
            <span class="eyebrow">Chapter one</span>
            <h2 id="ch-servers">Point it at what you already run</h2>
          </div>
        </div>

        <ol class="server-list" role="list">
          {
            SERVERS.map((server, i) => (
              <li data-syn-reveal style={`--syn-delay:${i * 90}ms`}>
                <ServerLogo name={server.name} size={30} />
                <h3>{server.name}</h3>
                <p>{server.note}</p>
              </li>
            ))
          }
          <li class="server-sub" data-syn-reveal style="--syn-delay:270ms">
            <span class="sub-glyph" aria-hidden="true">◇</span>
            <h3>Subsonic &amp; OpenSubsonic</h3>
            <p>
              Any compatible server connects the same way. Navidrome is the tested target; the rest
              are best-effort.
            </p>
          </li>
        </ol>
      </section>

      <!-- STREAMING AND OFFLINE -->
      <section class="chapter both" aria-labelledby="ch-both">
        <div class="chapter-head">
          <div class="chapter-title">
            <span class="eyebrow">Chapter two</span>
            <h2 id="ch-both">Two ways to listen, and neither is the lesser one</h2>
          </div>
        </div>

        <div class="both-row">
          <div class="both-cards">
            {
              BOTH.map((item, i) => (
                <article data-syn-reveal style={`--syn-delay:${i * 110}ms`}>
                  <span class="eyebrow">{item.tag}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))
            }
          </div>

          <div class="both-phone">
            <SynPhone
              width="clamp(180px, 17vw, 262px)"
              art={OFF_ART}
              title="No Signal"
              artist="Quiet Motor"
              source="Airplane mode"
              chip="Downloaded · plays offline"
              progress={73}
              elapsed="2:58"
              remaining="−1:04"
              label="An iPhone in airplane mode playing a downloaded album."
            />
          </div>
        </div>
      </section>

      <!-- SPLIT PAYOFF — against a drawn pair of headphones, not a player. -->
      <section class="split" aria-labelledby="ch-split">
        <div class="split-art">
          <svg viewBox="0 0 320 280" role="img" aria-label="A pair of over-ear headphones, drawn">
            <path
              d="M46 176v-30a114 114 0 0 1 228 0v30"
              fill="none"
              stroke="currentColor"
              stroke-width="17"
              stroke-linecap="round"></path>
            <rect x="16" y="160" width="70" height="112" rx="30" fill="currentColor"></rect>
            <rect x="234" y="160" width="70" height="112" rx="30" fill="currentColor"></rect>
            <rect x="34" y="182" width="34" height="68" rx="17" fill="#d8002d"></rect>
            <rect x="252" y="182" width="34" height="68" rx="17" fill="#d8002d"></rect>
            <circle cx="160" cy="120" r="26" fill="none" stroke="currentColor" stroke-width="7"
            ></circle>
            <circle cx="160" cy="120" r="7" fill="currentColor"></circle>
          </svg>
        </div>

        <div class="split-say">
          <div class="split-inner">
            <span class="eyebrow">The split</span>
            <h2 id="ch-split">What comes out of it is the file you own</h2>
            <p>{FEATURES[6].body}</p>
            <p class="split-second">{FEATURES[3].body}</p>
          </div>
        </div>
      </section>

      <!-- FEATURES -->
      <section class="chapter feats" aria-labelledby="ch-feats">
        <div class="chapter-head">
          <div class="chapter-title">
            <span class="eyebrow">Chapter three</span>
            <h2 id="ch-feats">Everything in it, and nothing held back</h2>
          </div>
        </div>

        <ol class="feat-grid" role="list">
          {
            FEATURES.map((feature, i) => (
              <li data-syn-reveal style={`--syn-delay:${(i % 3) * 80}ms`}>
                <span class="feat-no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ol>

        <dl class="stat-row">
          {
            STATS.map((stat) => (
              <div>
                <dt>{stat.value}</dt>
                <dd>{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <!-- ==================================================================
         THE HORIZON — the light breaks and the rest of the page is day.
    =================================================================== -->
    <div class="day">
      <!-- PAIR PAYOFF -->
      <section class="pair" aria-labelledby="ch-pair" data-syn-track>
        <div class="chapter-head">
          <div class="chapter-title">
            <span class="eyebrow">Chapter four</span>
            <h2 id="ch-pair">iPhone and iPad, the same library</h2>
          </div>
        </div>

        <p class="pair-lede">
          Same catalog, same downloads, same queue. iOS and iPadOS 17 or later, written in SwiftUI.
        </p>

        <div class="pair-stage">
          <div class="pair-slate">
            <SynSlate
              width="clamp(310px, 45vw, 700px)"
              covers={SLATE_COVERS}
              label="An iPad showing the Mozz library: albums, artists, playlists, downloads and Mozz Weekly beside a grid of covers."
            />
          </div>
          <div class="pair-phone">
            <SynPhone
              width="clamp(120px, 12.5vw, 198px)"
              art={PAIR_ART}
              title="Every Room"
              artist="June Current"
              progress={38}
              label="An iPhone playing the same library from the same server."
            />
          </div>
        </div>
      </section>

      <!-- MARQUEE PAYOFF -->
      <section class="marquee" aria-labelledby="ch-weekly">
        <div class="mq-rows" aria-hidden="true">
          {
            MARQUEE_ROWS.map((row, r) => (
              <div class={`mq-row mq-row-${r}`}>
                <div class="mq-track">
                  {[...row, ...row].map((art) => (
                    <span class="mq-cover" set:html={art} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="mq-say" data-syn-reveal>
          <span class="eyebrow">Featured</span>
          <h2 id="ch-weekly">{FEATURES[5].title}</h2>
          <p>{FEATURES[5].body}</p>
          <p class="mq-second">{FEATURES[4].body}</p>
        </div>
      </section>

      <!-- OWNERSHIP -->
      <section class="own" aria-labelledby="ch-own">
        <div class="chapter-head">
          <div class="chapter-title">
            <span class="eyebrow">Chapter five</span>
            <h2 id="ch-own">{SUBLINE}</h2>
          </div>
        </div>

        <ol class="own-grid" role="list">
          {
            OWNERSHIP.map((item, i) => (
              <li data-syn-reveal style={`--syn-delay:${i * 70}ms`}>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- FAQ over the wall -->
      <section class="faq" aria-labelledby="ch-faq">
        <div class="faq-wall" aria-hidden="true">
          {WALL.map((art) => <span class="wall-cover" set:html={art} />)}
        </div>

        <div class="faq-inner">
          <div class="chapter-head">
            <div class="chapter-title">
              <span class="eyebrow">Chapter six</span>
              <h2 id="ch-faq">Questions</h2>
            </div>
          </div>

          <div class="faq-list">
            {
              FAQS.map((item) => (
                <details>
                  <summary>
                    <span>{item.q}</span>
                    <i aria-hidden="true" />
                  </summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CLOSE — poster logic, printed at full measure. -->
      <footer class="close">
        <div class="close-bill">
          <span class="lockup lockup-small">
            <Mark size={20} decorative />
            <b>{NAME}</b>
          </span>
          <span class="close-fine">free forever · gpl-3.0 · no account · {domain}</span>
        </div>

        <svg class="close-word" viewBox="0 0 1000 214" role="img" aria-label={NAME}>
          <text
            x="500"
            y="196"
            text-anchor="middle"
            textLength="1000"
            lengthAdjust="spacingAndGlyphs">MOZZ</text
          >
        </svg>

        <ul class="bill-list" role="list">
          {BILL.map((item) => <li>{item}</li>)}
        </ul>

        <div class="close-say">
          <p>{TAGLINE}</p>
          <div class="actions">
            <a class="btn solid" href={GITHUB_URL}>Read the source</a>
            {
              APP_STORE_URL ? (
                <a class="btn ghost" href={APP_STORE_URL}>
                  Download on the App Store
                </a>
              ) : (
                <span class="btn ghost is-pending" aria-disabled="true">
                  Coming to the App Store
                </span>
              )
            }
          </div>
        </div>

        <p class="close-foot">
          Every sleeve on this page is invented artwork, drawn in the same two inks as the rest of
          it.
        </p>
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  body {
    background: #0a070d;
  }
</style>

<style>
  .chorus {
    --void: #0a070d;
    --ink: #14101a;
    --red: #d8002d;
    --deep: #7d0019;
    --paper: #eeeae2;
    --cream: #fdf6ec;
    --pad: clamp(18px, 4.4vw, 66px);

    position: relative;
    overflow-x: clip;
    font-family: 'Geologica', 'Helvetica Neue', Arial, sans-serif;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* One long fall of light: ground black at the top, full red by the end. */
  .dawn {
    background: linear-gradient(
      180deg,
      #0a070d 0%,
      #0a070d 22%,
      #23000b 40%,
      #5c0014 56%,
      #a10020 74%,
      #d8002d 100%
    );
    color: var(--cream);
  }

  /* The horizon. Everything past it is day. */
  .day {
    background: var(--paper);
    color: var(--ink);
    border-top: 6px solid var(--ink);
  }

  .eyebrow {
    display: block;
    font-size: clamp(10px, 0.86vw, 12px);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 500;
    white-space: nowrap;
    transition: transform 150ms ease;
  }

  .btn.solid {
    background: var(--red);
    color: var(--cream);
  }

  .btn.ghost {
    border: 1.5px solid currentColor;
  }

  .btn.is-pending {
    background: transparent;
    border: 1.5px dashed var(--red);
    color: inherit;
    opacity: 0.85;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  a:focus-visible,
  summary:focus-visible,
  [aria-disabled]:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  /* ---------------- hero ---------------- */

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(56px, 7vh, 80px) var(--pad) clamp(16px, 2.4vh, 30px);
    overflow: clip;
    isolation: isolate;
  }

  .halo {
    position: absolute;
    left: 56%;
    top: 46%;
    z-index: 0;
    width: min(1100px, 120vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(216, 0, 45, 0.28), rgba(216, 0, 45, 0) 62%);
    pointer-events: none;
  }

  .hero > *:not(.halo):not(.cover-stage) {
    position: relative;
    z-index: 2;
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.4rem;
    align-items: center;
    justify-content: space-between;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .lockup b {
    display: block;
    font-family: 'Anybody', 'Arial Black', sans-serif;
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .lockup small {
    display: block;
    margin-top: 0.2rem;
    font-size: clamp(10.5px, 0.86vw, 12px);
    opacity: 0.62;
  }

  .hero-copy {
    max-width: 29rem;
    margin-top: clamp(1.4rem, 4vh, 3rem);
    padding-bottom: clamp(2rem, 8vh, 6rem);
  }

  .hero-copy h1 {
    margin-top: 0.6rem;
    font-family: 'Anybody', 'Arial Black', sans-serif;
    font-weight: 800;
    font-stretch: 104%;
    font-size: clamp(27px, 3vw, 46px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .summary {
    max-width: 36ch;
    margin-top: 0.9rem;
    font-size: clamp(13px, 1.02vw, 15.5px);
    line-height: 1.55;
    opacity: 0.74;
  }

  .compat {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    align-items: center;
    margin-top: 1.2rem;
    font-size: clamp(12px, 0.96vw, 14px);
  }

  .compat span {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.82em;
    opacity: 0.5;
  }

  .compat b {
    font-weight: 600;
  }

  .compat i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--red);
  }

  /* The word and the thing that plays it own the whole frame; the sentence
     sits in front of them at the left, where the light has not reached. */
  .cover-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* The word, and the thing that plays it standing in front. */
  .cover-word {
    position: absolute;
    left: 66%;
    top: 58%;
    transform: translate(-50%, -52%);
    font-family: 'Anybody', 'Arial Black', sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(140px, 23vw, 390px);
    line-height: 0.74;
    letter-spacing: -0.06em;
    color: var(--red);
    white-space: nowrap;
    user-select: none;
  }

  .hero-phone {
    position: absolute;
    left: 66%;
    top: 58%;
    z-index: 3;
    transform: translate(-50%, -50%) rotate(-10deg);
    --syn-bezel: #191320;
    --syn-screen: #0a070d;
    --syn-fg: #fdf6ec;
    --syn-red: #d8002d;
    --syn-rim: rgba(253, 246, 236, 0.2);
    --syn-font: 'Geologica', 'Helvetica Neue', Arial, sans-serif;
    --syn-shadow: -22px 40px 88px rgba(0, 0, 0, 0.6);
  }

  /* The minimal marks: two sparks, three arcs, four bars. Nothing else. */
  .spark,
  .arcs,
  .bars {
    position: absolute;
    z-index: 2;
    height: auto;
    color: var(--cream);
  }

  .spark {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .spark-one {
    left: 45%;
    top: 15%;
    width: clamp(22px, 2.4vw, 38px);
    animation: ch-twinkle 6s ease-in-out infinite;
  }

  .spark-two {
    right: 12%;
    top: 20%;
    width: clamp(14px, 1.6vw, 24px);
    animation: ch-twinkle 8s ease-in-out infinite 1.4s;
  }

  .arcs {
    right: 7%;
    bottom: 18%;
    width: clamp(26px, 2.6vw, 42px);
    animation: ch-breathe 9s ease-in-out infinite;
  }

  .bars {
    left: 13%;
    bottom: 14%;
    width: clamp(26px, 2.4vw, 36px);
    fill: currentColor;
  }

  .bars .b2 {
    fill: var(--red);
  }

