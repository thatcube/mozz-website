---
/**
 * VARIANT — SYZYGY
 *
 * The next generation of the Umbra hero study, not a reprise of it.
 *
 * Umbra lit one colossal MOZZ from both edges of the frame and let a centred
 * phone eat a hole in the light, so the falloff ran left-to-right as a band.
 * Syzygy keeps the family: one wordmark at poster scale running off both edges,
 * one solid body interrupting it, cream falling to red falling to black. What
 * changes is the geometry of the light. Three bodies stand on a single vertical
 * axis — a cream disc, the Mozz mark eclipsing it, and the phone far below —
 * and the shadow is a wedge that opens downward. The word does not dim toward a
 * centre; it dims along the edge of a cone.
 *
 * Every claim on the page comes from src/data/site.ts. Only the hero headline,
 * the hero support line and the meta description are written here.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';

/*
 * The mark's own geometry, straight out of src/brand/mozz-logo.svg: the disc
 * silhouette, and the single path carrying both zz eyes and the smile. Held
 * here so the hero can draw the disc more than once — as the light and as the
 * body eclipsing it — without either copy being re-proportioned.
 */
const DISC =
  'M12 3H20V4H22V5H24V6H25V7H26L27 8V10H28V12H29V20H28V22H27V24H26V25H25V26H24V27H22V28H20V29H12V28H10V27H8V26H7V25H6V24H5V22H4V20H3V12H4V10H5V8H6V7H7V6H8V5H10V4H12V3Z';
const FACE =
  'M12 19H13V20H19V19H20V18H21V20H20V21H19V22H13V21H12V20H11V18H12V19ZM15 13H14V14H13V15H15V16H11V14H12V13H13V12H11V11H15V13ZM21 13H20V14H19V15H21V16H17V14H18V13H19V12H17V11H21V13Z';

const HEADLINE = 'Three things line up, and the music is yours.';
const SUPPORT =
  'Your server, this app, your headphones. Nothing sits in between them — not an account, not a subscription, not a company.';

/** Invented sleeves for the drifting band. Nothing here names a real record. */
const DRIFT = [
  { title: 'Second Shadow', artist: 'Halo North', art: 'ring' },
  { title: 'Occultation', artist: 'Field Assembly', art: 'crescent' },
  { title: 'Ground Black', artist: 'Nine Verticals', art: 'wedge' },
  { title: 'Corona', artist: 'Paper Cinema', art: 'dot' },
  { title: 'Totality', artist: 'Quiet Motor', art: 'bar' },
  { title: 'First Contact', artist: 'Common Weather', art: 'ring' },
  { title: 'Umbral', artist: 'Glass Arcade', art: 'wedge' },
  { title: 'Last Light', artist: 'June Current', art: 'crescent' },
] as const;

/** Small, low-contrast sleeves for the decorative wall behind the trust band. */
const WALL = [
  'ring', 'wedge', 'dot', 'bar', 'crescent', 'ring', 'bar', 'wedge',
  'dot', 'crescent', 'wedge', 'ring', 'bar', 'dot', 'crescent', 'wedge',
  'bar', 'ring', 'crescent', 'dot', 'wedge', 'bar', 'ring', 'dot',
];
---

<Layout
  title={`${NAME} — three things line up, and the music is yours`}
  description="Mozz is a free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Subsonic server you already run, stream it at home, or download an album and play it with no signal at all."
  themeColor="#08070a"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,600..900&family=DM+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <VariantBar slug="syzygy" tone="cool" />

  <main class="sz">
    <!-- ================================================================ --
      -- HERO — three bodies on one axis, and the shadow they throw       --
      -- ================================================================ -->
    <section class="hero" aria-labelledby="sz-h1">
      <div class="sky" aria-hidden="true">
        <!-- the shadow volume, thrown down the whole frame -->
        <span class="cone cone-pen"></span>
        <span class="cone cone-umb"></span>

        <!-- the light bloom, which is light and so has no edge to pixelate -->
        <span class="bloom"></span>

        <!--
          The eclipse, drawn as one picture on one grid.

          Both bodies are the *same* pixel-art disc from the mark, offset from
          each other by whole logo-pixels, so the crescent between them is built
          from the same stair-steps as the mark itself. A smooth circle behind a
          pixel circle reads as a rendering fault rather than a style, and two
          circles of different construction never nest, which is what made the
          crescent look ragged. shape-rendering keeps every step hard: an
          antialiased pixel edge is the other half of that problem.
        -->
        <svg class="eclipse" viewBox="-7 -7 46 46" aria-hidden="true" focusable="false">
          <!-- the light behind -->
          <path class="sun" d={DISC}></path>

          <!-- the body crossing it: the mark, in shadow but still lit -->
          <g transform="translate(-4 -3)">
            <path class="body" d={DISC}></path>
            <path class="face" d={FACE}></path>
          </g>
        </svg>

        <!-- 3. the wordmark, in three states of light -->
        <div class="word lit"><span>MOZZ</span></div>
        <div class="word pen"><span>MOZZ</span></div>
        <div class="word umb"><span>MOZZ</span></div>
      </div>

      <header class="top">
        <a class="lockup" href="/" aria-label={`${NAME} home`}>
          <Mark size={26} decorative />
          <b>{NAME}</b>
          <i aria-hidden="true"></i>
          <span>self&#8209;hosted music player</span>
        </a>
        <span class="fine">free forever &middot; gpl&#8209;3.0 &middot; no account</span>
      </header>

      <div class="say">
        <h1 id="sz-h1">{HEADLINE}</h1>
        <p class="support">{SUPPORT}</p>

        <p class="works">
          <span class="works-tag">plays from</span>
          {SERVERS.map((s) => (
            <span class="works-one"><ServerLogo name={s.name} size={15} />{s.name}</span>
          ))}
          <span class="works-one">Subsonic</span>
        </p>

        <div class="actions">
          {APP_STORE_URL ? (
            <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
          ) : (
            <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
          )}
          <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
        </div>
      </div>

      <!-- the third body: the phone, standing at the end of the cone -->
      <div
        class="phone hero-phone"
        role="img"
        aria-label="An iPhone running Mozz, playing a downloaded album from a home server."
      >
        <div class="screen">
          <span class="island" aria-hidden="true"></span>

          <div class="status" aria-hidden="true">
            <span>9:41</span>
            <span class="glyphs">
              <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              <svg viewBox="0 0 26 12">
                <rect x="1" y="1" width="20" height="10" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                <rect x="3" y="3" width="14" height="6" rx="1.4"></rect>
                <path d="M23 4.3v3.4a1.9 1.9 0 0 0 0-3.4z"></path>
              </svg>
            </span>
          </div>

          <div class="scr-head" aria-hidden="true">
            <svg class="chev" viewBox="0 0 16 16"
              ><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
            <span>playing from your server</span>
            <span class="eq"><i></i><i></i><i></i></span>
          </div>

          <div class="art" aria-hidden="true">
            <!-- The sleeve carries the same eclipse, built the same way: two
                 copies of the mark's disc a whole three units apart. A smooth
                 crescent this close to a pixel one is the mismatch again. -->
            <svg viewBox="0 0 120 120" shape-rendering="crispEdges">
              <rect width="120" height="120" fill="#efe9df"></rect>
              <g transform="translate(60 52) scale(2.615) translate(-16 -16)">
                <path d={DISC} fill="#c80028"></path>
                <path d={DISC} transform="translate(-4 -4)" fill="#efe9df"></path>
              </g>
              <rect x="18" y="99" width="46" height="3.4" fill="#12111a" opacity="0.6"></rect>
              <rect x="18" y="107" width="26" height="3.4" fill="#12111a" opacity="0.32"></rect>
            </svg>
          </div>

          <div class="meta">
            <strong>Second Shadow</strong>
            <span>Halo North &middot; Nightside</span>
          </div>

          <div class="bar" aria-hidden="true"><i></i></div>
          <div class="times" aria-hidden="true"><span>1:52</span><span>&minus;2:14</span></div>

          <div class="ctrl" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M17.4 3.4v13.2L7.6 10z"></path><rect x="2.6" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
            <span class="play"><svg viewBox="0 0 20 20"><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.3"></rect><rect x="11.1" y="4.4" width="3.3" height="11.2" rx="1.3"></rect></svg></span>
            <svg viewBox="0 0 20 20"><path d="M2.6 3.4v13.2L12.4 10z"></path><rect x="14.8" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
          </div>

          <div class="pill" aria-hidden="true">
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#efe9df" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>downloaded &middot; plays offline</span>
          </div>

          <span class="home" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- ALIGNMENT — the servers, as three bodies on the same axis        --
      -- ================================================================ -->
    <section class="band align" aria-labelledby="sz-align">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Alignment</p>
            <h2 id="sz-align">Point it at the server you already run.</h2>
          </div>
          <p class="lede">
            Three families, one app. Mozz signs in to yours and mirrors its catalog onto the
            device, so the library is on the phone whether or not the server is reachable.
          </p>
        </div>

        <ol class="axis" role="list">
          {SERVERS.map((s, i) => (
            <li>
              <span class="axis-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="axis-logo"><ServerLogo name={s.name} size={30} /></span>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- SPLIT PAYOFF — a hard edge, but split against the light itself,  --
      -- not against a player. Lit side streams; dark side does not need  --
      -- to. Neither half is the smaller half.                            --
      -- ================================================================ -->
    <section class="band split" aria-labelledby="sz-split">
      <div class="split-grid">
        <div class="half lit-half">
          <p class="kicker"><span class="tick"></span>In the light</p>
          <h2 id="sz-split">Streaming</h2>
          <p>
            At home, Mozz talks to the Plex, Jellyfin or OpenSubsonic server on your own
            network. Your files, at the quality you keep them, over a wire nobody else owns.
          </p>
          <ul role="list">
            <li>The whole catalog, indexed on the device</li>
            <li>Gapless queue, so an album runs as one piece</li>
            <li>Seventy-five milliseconds from tap to first note</li>
          </ul>
        </div>

        <div class="seam" aria-hidden="true"></div>

        <div class="half dark-half">
          <p class="kicker"><span class="tick"></span>In the shadow</p>
          <h2>Offline</h2>
          <p>
            Downloads are part of the design, not bolted on later. Take a record into a
            tunnel and it behaves exactly the way it does in your kitchen.
          </p>
          <ul role="list">
            <li>Browsing and search still answer with the server unreachable</li>
            <li>Mozz Weekly is built on the device, so it comes with you</li>
            <li>No degraded mode, no "reconnect to continue"</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- MARQUEE PAYOFF — the drifting band, recoloured and demoted from  --
      -- a hero to a featured strip: what the week made for you.          --
      -- ================================================================ -->
    <section class="band feature" aria-labelledby="sz-feature">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Featured</p>
            <h2 id="sz-feature">A new mix every week, out of music you already own.</h2>
          </div>
          <p class="lede">
            Mozz Weekly builds a fresh set from your own library. It runs on the device and
            stays available offline, so discovery never depends on somebody else&#39;s catalogue.
          </p>
        </div>
      </div>

      <div class="drift" aria-hidden="true">
        <div class="drift-track">
          {[0, 1].map(() => (
            <>
              {DRIFT.map((d) => (
                <figure class="sleeve">
                  <span class={`sleeve-art art-${d.art}`}></span>
                  <figcaption><b>{d.title}</b><span>{d.artist}</span></figcaption>
                </figure>
              ))}
            </>
          ))}
        </div>
        <span class="drift-fade drift-fade-l"></span>
        <span class="drift-fade drift-fade-r"></span>
      </div>

      <div class="shell">
        <p class="drift-note">
          Radio, shuffle and mixes can be sharpened by MusicBrainz and ListenBrainz when
          enrichment is on. Turn it off and local, genre-based recommendations still work.
        </p>
      </div>
    </section>

    <!-- ================================================================ --
      -- PAIR PAYOFF — iPhone and iPad, together, moving into alignment   --
      -- as you scroll. Resting state is the aligned state.               --
      -- ================================================================ -->
    <section class="band pair" aria-labelledby="sz-pair">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Both devices</p>
            <h2 id="sz-pair">One app, on the iPhone and the iPad.</h2>
          </div>
          <p class="lede">
            Written in SwiftUI for iOS and iPadOS 17 or later. The same library, the same
            downloads, the same player — laid out for whichever screen you picked up.
          </p>
        </div>
      </div>

      <div class="rig" role="img" aria-label="An iPad and an iPhone side by side, both running Mozz.">
        <div class="tablet">
          <div class="tab-screen">
            <div class="tab-side" aria-hidden="true">
              <span class="tab-lock"><Mark size={16} decorative /><b>Mozz</b></span>
              <span class="tab-nav is-on">Library</span>
              <span class="tab-nav">Albums</span>
              <span class="tab-nav">Artists</span>
              <span class="tab-nav">Downloads</span>
              <span class="tab-nav">Mozz Weekly</span>
              <span class="tab-nav">Radio</span>
            </div>
            <div class="tab-main" aria-hidden="true">
              <span class="tab-title">Albums</span>
              <div class="tab-grid">
                {['ring', 'wedge', 'dot', 'crescent', 'bar', 'ring', 'wedge', 'dot', 'crescent', 'bar', 'ring', 'wedge', 'dot', 'bar', 'crescent', 'ring', 'wedge', 'dot'].map((k) => (
                  <span class={`tile art-${k}`}></span>
                ))}
              </div>
              <div class="tab-now">
                <span class="tab-now-art art-crescent"></span>
                <span class="tab-now-txt"><b>Second Shadow</b><span>Halo North</span></span>
                <span class="tab-now-bar"><i></i></span>
                <span class="tab-now-eq"><i></i><i></i><i></i></span>
              </div>
            </div>
          </div>
        </div>

        <div class="phone pair-phone">
          <div class="screen">
            <span class="island" aria-hidden="true"></span>
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="glyphs">
                <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              </span>
            </div>
            <div class="scr-head" aria-hidden="true">
              <svg class="chev" viewBox="0 0 16 16"><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <span>downloads</span>
              <span class="eq"><i></i><i></i><i></i></span>
            </div>
            <ul class="list" aria-hidden="true">
              {DRIFT.slice(0, 5).map((d) => (
                <li>
                  <span class={`row-art art-${d.art}`}></span>
                  <span class="row-txt"><b>{d.title}</b><span>{d.artist}</span></span>
                  <svg class="row-tick" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#efe9df" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </li>
              ))}
            </ul>
            <span class="home" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <!--
        New with the Siri work: the app reaches past the phone. Kept to the
        claim — one handler behind the Siri button, CarPlay and Shortcuts, and
        a HomePod that has no apps and hands the request back to the iPhone.
      -->
      <div class="shell">
        <div class="beyond">
          <div class="beyond-head">
            <h3>And it reaches past the phone.</h3>
            <p>
              Siri plays a song, album, artist, playlist, genre, liked songs or a mix
              straight from your own library. Plays you start in the app are donated, so
              asking plainly for music learns to reach it.
            </p>
          </div>

          <ul class="beyond-list" role="list">
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <path d="M30 8V3M21.5 10.4 19 6M38.5 10.4 41 6" fill="none" stroke="var(--red)" stroke-width="2.2" stroke-linecap="round"></path>
                <rect x="19" y="13" width="22" height="37" rx="11" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <ellipse cx="30" cy="19.5" rx="7.5" ry="3" fill="var(--red)"></ellipse>
                <g stroke="currentColor" stroke-width="1.5" opacity="0.42">
                  <path d="M22.5 31h15M22.5 39h15"></path>
                </g>
              </svg>
              <h4>HomePod</h4>
              <p>
                It has no apps of its own, so it hands the request to your iPhone, which
                plays it and AirPlays it back.
              </p>
            </li>
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <rect x="6" y="15" width="48" height="29" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <rect x="11" y="20" width="15" height="19" rx="2" fill="var(--red)"></rect>
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5">
                  <path d="M31 24h18M31 30h18M31 36h11"></path>
                </g>
                <path d="M17 50h26" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.35"></path>
              </svg>
              <h4>CarPlay</h4>
              <p>
                Behind the same intent handler as the Siri button, so asking in the car
                reaches the same library.
              </p>
            </li>
            <li>
              <svg class="beyond-art" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
                <rect x="13" y="10" width="34" height="40" rx="8" fill="none" stroke="currentColor" stroke-width="2"></rect>
                <path d="M32 17 21 33h8l-1.5 11L39 28h-8.5L32 17Z" fill="var(--red)"></path>
              </svg>
              <h4>Shortcuts</h4>
              <p>
                The same handler again, so a shortcut can start a song, album, artist,
                playlist, genre or a mix.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- WHAT IT DOES                                                     --
      -- ================================================================ -->
    <section class="band does" aria-labelledby="sz-does">
      <div class="shell">
        <p class="kicker"><span class="tick"></span>The app</p>
        <h2 id="sz-does">Everything it does, with no ornament around it.</h2>
        <ol class="does-list" role="list">
          {FEATURES.map((f, i) => (
            <li>
              <span class="does-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- TRUST — ownership + measured numbers, over the wall used purely  --
      -- as decoration behind the type.                                   --
      -- ================================================================ -->
    <section class="band trust" aria-labelledby="sz-trust">
      <div class="wall" aria-hidden="true">
        {WALL.map((k) => <span class={`wall-tile art-${k}`}></span>)}
      </div>

      <div class="shell">
        <p class="kicker"><span class="tick"></span>What is not here</p>
        <h2 id="sz-trust">Nothing stands between the three of you.</h2>

        <div class="own">
          {OWNERSHIP.map((o) => (
            <article>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </article>
          ))}
        </div>

        <dl class="stats">
          {STATS.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================================================================ --
      -- FAQ                                                              --
      -- ================================================================ -->
    <section class="band faq" aria-labelledby="sz-faq">
      <div class="shell">
        <p class="kicker"><span class="tick"></span>Questions</p>
        <h2 id="sz-faq">Plain answers.</h2>
        <div class="faq-list">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}<span class="sign" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- CLOSE                                                            --
      -- ================================================================ -->
    <footer class="close" aria-labelledby="sz-close">
      <div class="shell">
        <div class="final">
          <div>
            <h2 id="sz-close">{TAGLINE}</h2>
            <p class="close-sub">{SUBLINE}</p>
          </div>

          <div>
            <div class="actions">
              {APP_STORE_URL ? (
                <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
              ) : (
                <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
              )}
              <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
            </div>
            <p class="final-fine">
              Free forever, open source under GPL&#8209;3.0. Every feature is in the free
              app, because there is no other kind.
            </p>
          </div>
        </div>
        <!--
          The page's own idea, stated once at the end and at the size of a
          diagram rather than a billboard: the three bodies, on their line.
        -->
        <figure class="axis-note">
          <svg viewBox="0 0 560 40" role="img" aria-label="Three bodies on one line: your server, Mozz, and you.">
            <line x1="8" y1="20" x2="552" y2="20" stroke="rgba(239,233,223,0.28)" stroke-width="1"></line>
            <circle cx="70" cy="20" r="11" fill="#efe9df"></circle>
            <circle cx="280" cy="20" r="11" fill="#c80028"></circle>
            <circle cx="490" cy="20" r="11" fill="none" stroke="#efe9df" stroke-width="2"></circle>
          </svg>
          <figcaption>
            <span>Your server</span>
            <span>Mozz</span>
            <span>You</span>
          </figcaption>
        </figure>

        <p class="colophon">
          <span>iPhone and iPad &middot; iOS 17 or later</span>
          <span>No account &middot; no tracking &middot; GPL&#8209;3.0</span>
        </p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .sz {
    --void: #08070a;
    --deep: #100e15;
    --red: #c80028;
    --red-lo: #7d0019;
    --cream: #efe9df;
    --dim: rgba(239, 233, 223, 0.62);
    --faint: rgba(239, 233, 223, 0.28);
    --hair: rgba(239, 233, 223, 0.14);

    /* the axis the three bodies stand on, and how the shadow opens */
    --axis: 66%;
    --sun: clamp(150px, 15vw, 250px);
    --pen: 25%;
    --umb: 11%;
    /* clear of the header rule, so nothing appears to slice the disc */
    --apex: 25%;

    position: relative;
    overflow-x: clip;
    background: var(--void);
    color: var(--cream);
    font-family: 'Schibsted Grotesk', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  /* ================================ hero ================================ */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    padding: clamp(56px, 6vh, 78px) clamp(18px, 4vw, 60px) clamp(190px, 31vh, 320px);
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  /* --- the eclipse ---------------------------------------------------- */

  .bloom {
    position: absolute;
    top: var(--apex);
    left: var(--axis);
    width: calc(var(--sun) * 4.6);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(216, 0, 44, 0.62) 0 11%,
      rgba(200, 0, 40, 0.3) 18%,
      rgba(150, 0, 30, 0.13) 30%,
      transparent 58%
    );
  }

  /*
   * The disc occupies 26 of the 46 units in this viewBox, so the svg is
   * 46/26 as wide as the disc we want. The second translate puts the
   * *eclipsing* body on the axis rather than the light behind it, because the
   * shadow has to leave from the thing casting it.
   *
   * The two discs are the same path at the same scale, moved apart by whole
   * units, so every step in the crescent lines up with a step in the mark.
   * Scaling one of them would put the two circles on different pitches and the
   * meeting edge would go ragged again.
   */
  .eclipse {
    position: absolute;
    top: var(--apex);
    left: var(--axis);
    width: calc(var(--sun) * 1.7695);
    height: auto;
    transform: translate(-50%, -50%) translate(8.7%, 6.52%);
    shape-rendering: crispEdges;
  }

  .eclipse .sun { fill: var(--cream); }

  /* In shadow, but never a hole: the disc keeps its colour and the face stays
     lit, so the mark still reads as the mark. */
  .eclipse .body { fill: #1b040a; }
  .eclipse .face { fill: #e4002f; }

  /* --- the shadow it throws ------------------------------------------ */

  .cone {
    position: absolute;
    inset: 0;
  }

  .cone-pen {
    background: linear-gradient(180deg, rgba(200, 0, 40, 0.4), rgba(200, 0, 40, 0.05) 62%, transparent 84%);
    clip-path: polygon(
      calc(var(--axis) - 2.4%) var(--apex),
      calc(var(--axis) + 2.4%) var(--apex),
      calc(var(--axis) + var(--pen)) 100%,
      calc(var(--axis) - var(--pen)) 100%
    );
  }

  .cone-umb {
    background: linear-gradient(180deg, rgba(4, 3, 6, 0.55), rgba(4, 3, 6, 0.94) 58%);
    clip-path: polygon(
      calc(var(--axis) - 1.4%) var(--apex),
      calc(var(--axis) + 1.4%) var(--apex),
      calc(var(--axis) + var(--umb)) 100%,
      calc(var(--axis) - var(--umb)) 100%
    );
  }

  /* --- the wordmark, in three states of light ------------------------- */

  .word {
    position: absolute;
    inset: 0;
  }

  .word span {
    position: absolute;
    left: 50%;
    bottom: -6%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: 'Anybody', 'Arial Black', system-ui;
    font-variation-settings: 'wdth' 125, 'wght' 900;
    font-weight: 900;
    font-size: 33vw;
    line-height: 0.74;
    letter-spacing: -0.03em;
  }

  .word.lit span { color: var(--cream); }
  .word.pen span { color: var(--red); }
  .word.umb span { color: #14111a; }

  /* The wedge is the whole idea: the falloff follows the edge of the cone,
     not a horizontal band. Each layer is clipped to a narrower wedge. */
  .word.pen {
    clip-path: polygon(
      calc(var(--axis) - 3.4%) var(--apex),
      calc(var(--axis) + 3.4%) var(--apex),
      calc(var(--axis) + var(--pen)) 100%,
      calc(var(--axis) - var(--pen)) 100%
    );
  }

  .word.umb {
    clip-path: polygon(
      calc(var(--axis) - 1.8%) var(--apex),
      calc(var(--axis) + 1.8%) var(--apex),
      calc(var(--axis) + var(--umb)) 100%,
      calc(var(--axis) - var(--umb)) 100%
    );
  }

  /* --- the words on top ---------------------------------------------- */

  .top {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--hair);
  }

  .lockup {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    font-size: 13px;
  }

  .lockup b {
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 110, 'wght' 800;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .lockup i {
    width: 1px;
    height: 13px;
    background: var(--faint);
  }

  .lockup span { color: var(--dim); }

  .fine,
  .works-tag {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .say {
    position: relative;
    z-index: 3;
    align-self: center;
    max-width: 31rem;
    padding: clamp(16px, 3vh, 40px) 0;
  }

  h1 {
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 800;
    font-size: clamp(29px, 3.7vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .support {
    max-width: 34ch;
    margin-top: 1.05rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.15vw, 17px);
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.95rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .works-one {
    display: inline-flex;
    gap: 0.34rem;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--dim);
  }

  .works-one :global(.server-logo) { color: var(--red); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.15rem;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: transform 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .btn.go {
    background: var(--red);
    color: #fff;
  }

  .btn.go.is-pending {
    background: transparent;
    border: 1px dashed rgba(200, 0, 40, 0.75);
    color: #ff6b86;
  }

  .btn.src {
    border: 1px solid var(--hair);
    color: var(--cream);
  }

  .btn:hover { transform: translateY(-2px); }
  .btn.src:hover { border-color: var(--faint); }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  /* --- the phone ------------------------------------------------------ */

  .phone {
    /* Real hardware proportions, and it grows with the viewport. */
    width: var(--pw, clamp(196px, 17.5vw, 300px));
    aspect-ratio: 71.6 / 147.6;
    padding: 0.7%;
    border-radius: clamp(24px, 2.4vw, 40px);
    background: linear-gradient(155deg, #2a2731, #0c0b10 62%);
    box-shadow:
      inset 0 0 0 1px rgba(239, 233, 223, 0.16),
      0 40px 90px -34px rgba(0, 0, 0, 0.95);
  }

  .hero-phone {
    position: absolute;
    z-index: 2;
    left: var(--axis);
    bottom: -7%;
    --pw: clamp(180px, 15.5vw, 262px);
    transform: translateX(-50%);
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 7.4% 6.4% 4.6%;
    border-radius: clamp(21px, 2.1vw, 35px);
    overflow: hidden;
    background: linear-gradient(180deg, #17141d, #0b0910 76%);
    color: var(--cream);
    container-type: inline-size;
  }

  .island {
    position: absolute;
    top: 3.1%;
    left: 50%;
    width: 30%;
    height: 3.1%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #05040a;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 3.4cqw;
    font-weight: 600;
  }

  .glyphs {
    display: inline-flex;
    gap: 3%;
    align-items: center;
  }

  .glyphs svg {
    height: 3.1cqw;
    width: auto;
    fill: currentColor;
  }

  .scr-head {
    display: flex;
    gap: 3%;
    align-items: center;
    margin-top: 7%;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 2.9cqw;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .chev { width: 3.6cqw; flex: none; }
  .scr-head span:not(.eq) { flex: 1; }

  .eq {
    display: inline-flex;
    gap: 0.8cqw;
    align-items: flex-end;
    height: 3.4cqw;
  }

  .eq i {
    width: 1.1cqw;
    background: var(--red);
    animation: eq 1.15s ease-in-out infinite;
  }

  .eq i:nth-child(1) { height: 55%; }
  .eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .eq i:nth-child(3) { height: 72%; animation-delay: 0.36s; }

  @keyframes eq {
    0%, 100% { transform: scaleY(0.45); }
    50% { transform: scaleY(1); }
  }

  .art {
    margin-top: 6%;
    border-radius: 3.2cqw;
    overflow: hidden;
  }

  .art svg { width: 100%; height: auto; }

  .meta { margin-top: 7%; }

  .meta strong {
    display: block;
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 105, 'wght' 800;
    font-size: 5.6cqw;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .meta span {
    display: block;
    margin-top: 1.4%;
    font-size: 3.5cqw;
    color: var(--faint);
  }

  .bar {
    margin-top: 6.5%;
    height: 0.9cqw;
    border-radius: 999px;
    background: rgba(239, 233, 223, 0.16);
  }

  .bar i {
    display: block;
    width: 46%;
    height: 100%;
    border-radius: 999px;
    background: var(--red);
  }

  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 2.4%;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 2.9cqw;
    color: var(--faint);
  }

  .ctrl {
    display: flex;
    gap: 9%;
    align-items: center;
    justify-content: center;
    margin-top: 6.5%;
  }

  .ctrl svg {
    width: 6.4cqw;
    fill: var(--cream);
  }

  .play {
    display: inline-grid;
    place-items: center;
    width: 14cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  .play svg { width: 6.4cqw; fill: #fff; }

  .pill {
    display: flex;
    gap: 2.6%;
    align-items: center;
    margin-top: auto;
    padding: 2.6% 3.4%;
    border-radius: 999px;
    background: rgba(239, 233, 223, 0.07);
    font-size: 3.1cqw;
    color: var(--dim);
  }

  .pill svg { width: 4cqw; flex: none; }

  .home {
    width: 34%;
    height: 0.9cqw;
    margin: 4% auto 0;
    border-radius: 999px;
    background: rgba(239, 233, 223, 0.4);
  }

  /* ============================== bands ================================= */

  .band {
    position: relative;
    padding: clamp(66px, 9vh, 128px) 0;
    border-top: 1px solid var(--hair);
  }

  .shell {
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin-inline: auto;
  }

  .kicker {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tick {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red);
  }

  h2 {
    max-width: 20ch;
    margin-top: 0.85rem;
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 800;
    font-size: clamp(26px, 3.3vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
  }

  /* A head with a lede runs as two columns, so the measure is used and the
     right-hand side is never a hole. */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(18px, 4vw, 68px);
    align-items: end;
  }

  .head .lede {
    margin-top: 0;
    padding-bottom: 0.4rem;
  }

  .head h2 { max-width: 15ch; }

  h3 {
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.18;
    letter-spacing: -0.012em;
  }

  /* --- alignment ------------------------------------------------------ */

  .axis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1px;
    margin-top: clamp(28px, 4vh, 48px);
    background: var(--hair);
    border: 1px solid var(--hair);
  }

  .axis li {
    padding: clamp(20px, 2.4vw, 32px);
    background: var(--void);
  }

  .axis-no {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--red);
  }

  .axis-logo {
    display: block;
    margin: 0.9rem 0 1rem;
    color: var(--cream);
  }

  .axis h3 { margin-bottom: 0.45rem; }

  .axis p {
    color: var(--dim);
    font-size: 14.5px;
  }

  /* --- split payoff --------------------------------------------------- */

  .split { padding-block: 0; }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
  }

  .half {
    padding: clamp(52px, 8vh, 108px) clamp(24px, 4.4vw, 76px);
  }

  .lit-half {
    background: var(--cream);
  }

  .seam { background: var(--red); }

  .dark-half {
    background: var(--void);
  }

  .half h2 {
    max-width: none;
    margin-top: 0.6rem;
    font-size: clamp(34px, 4.6vw, 62px);
  }

  .half > p {
    max-width: 38ch;
    margin-top: 1rem;
    font-size: clamp(14.5px, 1.05vw, 16.5px);
    color: var(--dim);
  }

  .half ul {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .half li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 14.5px;
    color: var(--dim);
  }

  .half li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
  }

  /* The lit half inverts the whole ink, so its overrides have to land after
     the shared .half rules or the dim cream wins and the copy disappears. */
  .lit-half {
    background: var(--cream);
    color: #131019;
  }

  .lit-half .kicker { color: rgba(19, 16, 25, 0.5); }
  .lit-half > p,
  .lit-half li { color: rgba(19, 16, 25, 0.72); }

  /* --- marquee payoff -------------------------------------------------- */

  .drift {
    position: relative;
    overflow: hidden;
    margin: clamp(32px, 5vh, 56px) 0;
    padding: 4px 0;
  }

  .drift-track {
    display: flex;
    gap: clamp(14px, 1.6vw, 24px);
    width: max-content;
    animation: drift 68s linear infinite;
  }

  @keyframes drift {
    to { transform: translateX(-50%); }
  }

  .drift:hover .drift-track { animation-play-state: paused; }

  .sleeve {
    width: clamp(140px, 14vw, 200px);
    flex: none;
  }

  .sleeve-art {
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--hair);
  }

  .sleeve figcaption {
    display: block;
    margin-top: 0.6rem;
    font-size: 12.5px;
    line-height: 1.35;
  }

  .sleeve figcaption b { display: block; }

  .sleeve figcaption span {
    display: block;
    color: var(--faint);
  }

  .drift-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(40px, 8vw, 130px);
    pointer-events: none;
  }

  .drift-fade-l { left: 0; background: linear-gradient(90deg, var(--void), transparent); }
  .drift-fade-r { right: 0; background: linear-gradient(270deg, var(--void), transparent); }

  .drift-note {
    max-width: 58ch;
    color: var(--faint);
    font-size: 13.5px;
  }

  /* the invented sleeve artwork: red, cream, black, drawn with gradients */
  .art-ring {
    background:
      radial-gradient(circle at 50% 46%, transparent 0 27%, var(--red) 27% 39%, transparent 39%),
      radial-gradient(circle at 50% 46%, transparent 0 52%, var(--cream) 52% 55%, transparent 55%),
      #131019;
  }

  .art-crescent {
    background:
      radial-gradient(circle at 62% 42%, var(--void) 0 38%, transparent 38%),
      radial-gradient(circle at 50% 50%, var(--cream) 0 44%, transparent 44%),
      var(--red);
  }

  .art-wedge {
    background:
      conic-gradient(from 200deg at 50% 8%, transparent 0 22deg, var(--red) 22deg 46deg, transparent 46deg),
      linear-gradient(180deg, var(--cream) 0 34%, #131019 34%);
  }

  .art-dot {
    background:
      radial-gradient(circle at 50% 50%, var(--red) 0 1.6px, transparent 1.7px) 0 0 / 9px 9px,
      radial-gradient(circle at 50% 50%, var(--cream) 0 30%, transparent 30%),
      #131019;
  }

  .art-bar {
    background:
      linear-gradient(90deg, transparent 0 14%, var(--red) 14% 26%, transparent 26% 42%, var(--cream) 42% 50%, transparent 50% 66%, var(--red) 66% 86%, transparent 86%),
      #131019;
  }

  /* --- pair payoff ----------------------------------------------------- */

  .rig {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin: clamp(30px, 4vh, 52px) auto 0;
  }

  .tablet {
    /* Landscape, because the sidebar layout is what an iPad actually shows. */
    width: clamp(310px, 52vw, 720px);
    aspect-ratio: 248 / 179;
    flex: none;
    padding: 1.1%;
    border-radius: clamp(16px, 1.8vw, 28px);
    background: linear-gradient(150deg, #3b3745, #16141c 66%);
    box-shadow:
      inset 0 0 0 1px rgba(239, 233, 223, 0.2),
      0 44px 90px -40px rgba(0, 0, 0, 0.95);
  }

  .tab-screen {
    display: grid;
    grid-template-columns: 27% 1fr;
    height: 100%;
    border-radius: clamp(11px, 1.3vw, 20px);
    overflow: hidden;
    background: #161320;
    container-type: inline-size;
  }

  .tab-side {
    display: flex;
    flex-direction: column;
    gap: 1.8cqw;
    padding: 3cqw 2.4cqw;
    border-right: 1px solid var(--hair);
    background: #1d1a29;
  }

  .tab-lock {
    display: flex;
    gap: 1.1cqw;
    align-items: center;
    margin-bottom: 1.2cqw;
    font-size: 1.9cqw;
  }

  .tab-lock b {
    font-family: 'Anybody', system-ui;
    font-variation-settings: 'wdth' 108, 'wght' 800;
  }

  .tab-nav {
    font-size: 1.6cqw;
    color: var(--dim);
  }

  .tab-nav.is-on {
    color: var(--cream);
    position: relative;
  }

  .tab-nav.is-on::before {
    content: '';
