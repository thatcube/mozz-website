  /* ---- ROOF : a true gable, CUT AWAY on the near slope so the WHOLE top storey is open
     to camera. We keep ONLY the far slope + a ridge beam, and set a half-gable END WALL
     (in wall material) under each rake so every roof edge rests ON a wall — never a flap
     floating over empty background. */
  const RZ = 62, RID = 94, RY = D / 2, EO = 2;
  const zf = (y: number) => RZ + (RID - RZ) * (y + EO) / (RY + EO);   // z of the far slope at a given y
  // half-gable END WALLS (cream) — drawn first so the slope reads as resting ON them
  s.poly([[0, -EO, RZ], [0, RY, RID], [0, RY, RZ]], '#e7d9bd', 'flat');
  s.poly([[0, -EO, RZ], [0, RY, RID], [0, RY, RZ]], 'none', 'edge');
  s.poly([[W, -EO, RZ], [W, RY, RID], [W, RY, RZ]], '#dcccac', 'flat');        // camera-facing right gable
  s.poly([[W, -EO, RZ], [W, RY, RID], [W, RY, RZ]], 'none', 'edge');
  s.line([W, RY, RZ], [W, RY, RID], 'seam-d');                                 // corner shade on the right gable
  // wall plate the back eave lands on
  s.box(0, -EO, RZ - 2.4, W, EO + 0.8, 2.4, WALLO);
  // the far/back slope — the one surface kept whole
  s.poly([[0, -EO, RZ], [W, -EO, RZ], [W, RY, RID], [0, RY, RID]], '#3a9080', 'flat');
  // verge / barge boards giving the gable rakes a visible roof thickness
  s.poly([[0, -EO, RZ], [0, RY, RID], [0, RY, RID - 1.8], [0, -EO, RZ - 1.8]], '#296a5e', 'flat');   // left rake
  s.poly([[W, -EO, RZ], [W, RY, RID], [W, RY, RID - 1.8], [W, -EO, RZ - 1.8]], '#173e37', 'flat');   // right rake
  // shingle courses on the far slope
  for (let i = 1; i < 5; i++) { const t = i / 5, yy = -EO + (RY + EO) * t, zz = RZ + (RID - RZ) * t; s.line([0, yy, zz], [W, yy, zz], 'shingle'); }
  // chimney — masonry stack seated INTO the far slope (base cut by the slope plane, no gap)
  const cX0 = 22, cX1 = 31, cY0 = 3, cY1 = 11, cZ = 100;
  s.poly([[cX0 - 2, cY0 - 2, zf(cY0 - 2) + 0.12], [cX1 + 2, cY0 - 2, zf(cY0 - 2) + 0.12], [cX1 + 2, cY1 + 2, zf(cY1 + 2) + 0.12], [cX0 - 2, cY1 + 2, zf(cY1 + 2) + 0.12]], '#7a0018', 'flat'); // flashing on the slope
  s.poly([[cX0, cY1, zf(cY1)], [cX1, cY1, zf(cY1)], [cX1, cY1, cZ], [cX0, cY1, cZ]], '#c80028', 'flat'); // downhill (front) face
  s.poly([[cX1, cY0, zf(cY0)], [cX1, cY1, zf(cY1)], [cX1, cY1, cZ], [cX1, cY0, cZ]], '#9c001f', 'flat'); // right face, slope-cut base
  s.poly([[cX0, cY0, cZ], [cX1, cY0, cZ], [cX1, cY1, cZ], [cX0, cY1, cZ]], '#e01234', 'flat');           // cap
  s.quad(cX0 + 1.6, cY0 + 1.6, (cX1 - cX0) - 3.2, (cY1 - cY0) - 3.2, cZ + 0.06, '#5a0011', 'flat');      // flue
  for (let i = 1; i < 3; i++) { const zz = zf(cY1) + (cZ - zf(cY1)) * i / 3; s.line([cX0, cY1, zz], [cX1, cY1, zz], 'seam-d'); } // brick courses
  // ridge beam — drawn last so it caps the ridge cleanly and reads as a beam
  s.box(0, RY - 0.9, RID - 1.8, W, 1.8, 1.8, { top: '#2b6f62', left: '#20544b', right: '#173e37' });
  // roof aerial — a slim mast on a bracket clamped to the ridge (an antenna, not a router)
  const aX = 132;
  s.box(aX - 1.4, RY - 1.2, RID - 0.8, 2.8, 2.4, 3, DARK2);                           // bracket on the ridge beam
  s.raw(`M${s.P(aX, RY, RID + 2)}L${s.P(aX, RY, RID + 18)}`, 'none', 'antenna');       // mast
  for (const zz of [RID + 8, RID + 11, RID + 14]) s.raw(`M${s.P(aX - 4, RY, zz)}L${s.P(aX + 4, RY, zz)}`, 'none', 'antenna-thin'); // dipole arms
  for (let i = 1; i <= 3; i++) s.ring(aX, RY, RID + 18, i * 2, 'none', 'wifi');        // signal

  /* ---- THE CABLE RUN — one clean trunk: server switch → wall riser → office router.
     Both ends plug into a DRAWN port; no stroke ends in the void. (The old room-branch
     drops ended at tiny occluded devices and read as floating, so they're removed.) */
  s.box(52, 8.6, -19, 4.4, 3, 1.6, { top: '#3a9384', left: '#2f7d6e', right: '#245f54' }); // patch port on the switch
  s.faceX(56.02, 9.1, 11.2, -18.4, -17.6, '#173a33', 'led');
