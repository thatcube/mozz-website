  trunk += 'L' + s.P(54, 4, -17.8);            // back to the wall
  trunk += 'L' + s.P(101, 4, -17.8);           // horizontal along the basement back wall
  trunk += 'L' + s.P(101, 4, 47);              // ONE vertical riser up through both floor slabs
  trunk += 'L' + s.P(99, 4, 47);               // into the office router's uplink port
  s.raw(trunk, 'none', 'cable-run');
  // grommets where the riser penetrates each floor slab (says "through the walls/floors")
  s.ring(101, 4, 0.1, 1.5, '#2a2932', 'edge'); s.ring(101, 4, 34.1, 1.5, '#2a2932', 'edge');
  s.box(97, 3, 46, 3, 2.4, 2.4, DARK2);        // uplink port block on the router where the trunk lands
  s.faceX(100, 3.4, 5, 46.6, 47.8, '#35e08f', 'led');
}

