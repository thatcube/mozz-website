---
/**
 * VARIANT — HOMELAB
 *
 * Illustration-led, in the same craft as /v/diorama: one true axonometric
 * projection (makeScene → P) shared by every scene, a single non-scaling stroke
 * for one line weight everywhere, flat screen-print colour with exactly one hard
 * value step per visible face (top light → left mid → right dark), un-erased
 * construction guides and a light riso grain. Legends are skewed into their
 * surface's own isometric plane so they lie on the object, never float.
 *
 * The concept: "homelab" is the self-hoster's word for the machine in the house.
 * So the whole page is that house — a giant cutaway with the server humming in
 * the basement, cables traced through the walls, and music in every room and out
 * the front door.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import Shot from '../../components/Shot.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const R6 = Math.PI / 6;
const IC = Math.cos(R6);
const IS = Math.sin(R6);
const r2 = (n: number) => Math.round(n * 100) / 100;

type Part = { d: string; fill: string; cls?: string };
type Txt = { tr: string; s: string; size: number; cls: string; anchor: string; base: string };

function makeScene() {
  let minX = 1e9, minY = 1e9, maxX = -1e9, maxY = -1e9;
  const parts: Part[] = [];
  const texts: Txt[] = [];

  const proj = (x: number, y: number, z: number): [number, number] => {
    const sx = (x - y) * IC;
    const sy = (x + y) * IS - z;
    if (sx < minX) minX = sx; if (sx > maxX) maxX = sx;
    if (sy < minY) minY = sy; if (sy > maxY) maxY = sy;
    return [sx, sy];
  };
  const P = (x: number, y: number, z: number) => {
    const [sx, sy] = proj(x, y, z);
    return `${r2(sx)} ${r2(sy)}`;
  };
  const path = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${P(p[0], p[1], p[2])}`).join('') + 'Z';
  const poly = (pts: number[][], fill: string, cls?: string) => parts.push({ d: path(pts), fill, cls });

  const box = (x: number, y: number, z: number, w: number, d: number, h: number,
    c: { top: string; left: string; right: string }, cls?: string) => {
    poly([[x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]], c.top, cls);
    poly([[x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]], c.left, cls);
    poly([[x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]], c.right, cls);
  };
  const quad = (x: number, y: number, w: number, d: number, z: number, fill: string, cls?: string) =>
    poly([[x, y, z], [x + w, y, z], [x + w, y + d, z], [x, y + d, z]], fill, cls);
  const faceX = (x: number, y0: number, y1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x, y0, z0], [x, y1, z0], [x, y1, z1], [x, y0, z1]], fill, cls);
  const faceY = (y: number, x0: number, x1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x0, y, z0], [x1, y, z0], [x1, y, z1], [x0, y, z1]], fill, cls);

  const ring = (cx: number, cy: number, z: number, r: number, fill: string, cls?: string, n = 48) => {
    let d = '';
    for (let i = 0; i <= n; i++) { const a = (i / n) * Math.PI * 2; d += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z); }
    parts.push({ d: d + 'Z', fill, cls });
  };

  // the stylised diffraction disc — a fan of hard flat wedges (the app's tint trick)
  const fan = (cx: number, cy: number, z: number, r: number, palette: string[], seg = 32, spin = 0) => {
    const c = P(cx, cy, z);
    for (let i = 0; i < seg; i++) {
      const a0 = spin + (i / seg) * Math.PI * 2, a1 = spin + ((i + 1) / seg) * Math.PI * 2;
      const pa = P(cx + r * Math.cos(a0), cy + r * Math.sin(a0), z);
      const pb = P(cx + r * Math.cos(a1), cy + r * Math.sin(a1), z);
      parts.push({ d: `M${c}L${pa}L${pb}Z`, fill: palette[i % palette.length], cls: 'flat' });
    }
    ring(cx, cy, z, r, 'none', 'edge');
    ring(cx, cy, z, r * 0.3, '#f4ead9', 'edge');
    ring(cx, cy, z, r * 0.12, 'var(--hole)', 'edge');
  };

  const line = (a: number[], b: number[], cls = 'guide') =>
    parts.push({ d: `M${P(a[0], a[1], a[2])}L${P(b[0], b[1], b[2])}`, fill: 'none', cls });

  const seam = (a: number[], b: number[], dir: 'z' | 'x' | 'y' = 'z', off = 0.5) => {
    line(a, b, 'seam-d');
    const o = dir === 'z' ? [0, 0, off] : dir === 'x' ? [off, 0, 0] : [0, off, 0];
    line([a[0] + o[0], a[1] + o[1], a[2] + o[2]], [b[0] + o[0], b[1] + o[1], b[2] + o[2]], 'seam-l');
  };

  const screw = (cx: number, cy: number, z: number, r = 1.1) => {
    ring(cx, cy, z, r, 'rgba(0,0,0,0.10)', 'flat', 12);
    ring(cx, cy, z, r, 'none', 'screw', 12);
    line([cx - r * 0.6, cy - r * 0.6, z], [cx + r * 0.6, cy + r * 0.6, z], 'screw');
  };

  const cyl = (cx: number, cy: number, z: number, r: number, h: number, cTop: string, cBody: string, cls?: string) => {
    const aL = 3 * Math.PI / 4, aR = -Math.PI / 4, step = Math.PI / 20;
    let d = 'M' + P(cx + r * Math.cos(aL), cy + r * Math.sin(aL), z + h);
    for (let a = aL; a >= aR - 1e-6; a -= step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h);
    d += 'L' + P(cx + r * Math.cos(aR), cy + r * Math.sin(aR), z);
    for (let a = aR; a <= aL + 1e-6; a += step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z);
    parts.push({ d: d + 'Z', fill: cBody, cls });
    let t = '';
    for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; t += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h); }
    parts.push({ d: t + 'Z', fill: cTop, cls });
  };

  const raw = (d: string, fill: string, cls?: string) => parts.push({ d, fill, cls });

  const text = (x: number, y: number, z: number, s: string, size: number,
    cls = 'legend', plane: 'top' | 'topL' | 'left' | 'right' = 'top',
    anchor = 'middle', base = 'auto') => {
    const [sx, sy] = proj(x, y, z);
    let a = IC, b = IS, c = -IC, d = IS;
    if (plane === 'topL') { a = -IC; b = IS; c = IC; d = IS; }
    else if (plane === 'left') { a = IC; b = IS; c = 0; d = 1; }
    else if (plane === 'right') { a = -IC; b = IS; c = 0; d = 1; }
    const tr = `matrix(${r2(a)} ${r2(b)} ${r2(c)} ${r2(d)} ${r2(sx)} ${r2(sy)})`;
    texts.push({ tr, s, size, cls, anchor, base });
  };

  const vb = (pad = 6) => `${r2(minX - pad)} ${r2(minY - pad)} ${r2(maxX - minX + pad * 2)} ${r2(maxY - minY + pad * 2)}`;
  const bounds = () => ({ minX, minY, maxX, maxY });

  return { parts, texts, poly, box, quad, faceX, faceY, ring, fan, line, seam, screw, cyl, raw, text, vb, bounds, P };
}

/* ── flat palettes (small, disciplined) ──────────────────────────────────────
   cream #f4ead9 · teal-green #2f7d6e · burnt orange #e8703a · mozz red #c80028 */
const CREAM  = { top: '#f7efe0', left: '#e9dcc2', right: '#d8c8a6' };
const WALL   = { top: '#efe3cc', left: '#ddccad', right: '#c9b58f' };  // interior wall
const WALLO  = { top: '#e7d6b8', left: '#d2bd97', right: '#bda279' };  // outer structure
const TEAL   = { top: '#3a9384', left: '#2f7d6e', right: '#245f54' };
const TEAL2  = { top: '#348476', left: '#2a6d60', right: '#1f5249' };
const TEALDK = { top: '#296a5e', left: '#20544b', right: '#173e37' };
const ORANGE = { top: '#f0854f', left: '#e8703a', right: '#c85a2b' };
const ORANG2 = { top: '#ec7a44', left: '#d9642f', right: '#b85326' };
const RED     = { top: '#e01234', left: '#c80028', right: '#9c001f' };
const WOOD   = { top: '#e5cfa2', left: '#d0b787', right: '#b89f6e' };
const WOOD2  = { top: '#d8bd8f', left: '#c2a674', right: '#a88d5e' };
const DARKB  = { top: '#34333c', left: '#26252d', right: '#191820' };
const DARK2  = { top: '#2a2932', left: '#201f27', right: '#14131a' };
const METAL  = { top: '#cdd2d8', left: '#b1b7bf', right: '#969da7' };
const STEEL  = { top: '#7f8a93', left: '#68727a', right: '#525a61' };
const PAPER  = { top: '#f4ecd9', left: '#e4d8bf', right: '#d0c1a0' };
const CREAMH = { top: '#fbf5ea', left: '#efe4cf', right: '#ddceb2' };
const SOIL   = { top: '#6f5a3d', left: '#5a4830', right: '#453722' };
const ROOF   = { top: '#347b6d', left: '#296257', right: '#1d463e' };
const SKIN   = { top: '#e7b587', left: '#d59f6e', right: '#bd8656' };
const SKIN2  = { top: '#d8a273', left: '#c48a5c', right: '#a97347' };

const FAN_WARM  = ['#e9b25a', '#e8703a', '#f4ead9', '#d98f34', '#f0d49a', '#e57d3f', '#c99a45'];
const FAN_RED   = ['#c80028', '#e8703a', '#f4ead9', '#a30220', '#e0a94e', '#d6486a'];
const FAN_TEAL  = ['#2f7d6e', '#49a08d', '#e8c98a', '#3d8f7f', '#8fc7b8', '#256257'];
const FAN_VIOL  = ['#7a4bd6', '#c455a8', '#f0d49a', '#5f3bb0', '#b58fe0', '#8e3fb0'];
const FAN_SILV  = ['#c6ccd4', '#9aa4b0', '#eef1f4', '#aeb7c2', '#dfe4ea', '#8b96a4'];
const FAN_SEPIA = ['#c98b4e', '#9c6233', '#e7c79a', '#b5793f', '#dcb583', '#8a5a30'];

/* ── shared scene helpers ─────────────────────────────────────────────────── */
const grid = (s: any, x0: number, x1: number, y0: number, y1: number, sx: number, sy: number, z = 0) => {
  for (let y = y0; y <= y1 + 1e-6; y += sy) s.line([x0, y, z], [x1, y, z]);
  for (let x = x0; x <= x1 + 1e-6; x += sx) s.line([x, y0, z], [x, y1, z]);
};
const shadow = (s: any, cx: number, cy: number, r: number, ry = 1, z = -0.2) => {
  let d = '';
  for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; d += (i ? 'L' : 'M') + s.P(cx + r * Math.cos(a), cy + r * ry * Math.sin(a), z); }
  s.raw(d + 'Z', 'var(--shadow)', 'flat');
};
const vents = (s: any, plane: 'x' | 'y', c: number, a0: number, a1: number, z0: number, z1: number, n: number) => {
  for (let i = 0; i < n; i++) {
    const z = z0 + ((i + 0.5) / n) * (z1 - z0);
    if (plane === 'y') s.line([a0, c, z], [a1, c, z], 'vent');
    else s.line([c, a0, z], [c, a1, z], 'vent');
  }
};

/* a person: head, torso, headphone band. seated=false stands with a stride. */
const person = (s: any, x: number, y: number, z: number, shirt: any, skin: any,
  opts: { seated?: boolean; band?: string } = {}) => {
  const band = opts.band ?? 'hp';
  if (opts.seated) {
    s.box(x, y, z, 7, 9, 6, shirt);                 // lap
    s.box(x - 5.5, y + 0.6, z + 6, 7, 7.6, 11, shirt); // torso, reclined back
    s.cyl(x - 2, y + 4.4, z + 17, 3.2, 4.2, skin.top, skin.left); // head
    s.raw(`M${s.P(x - 5.2, y + 4.4, 25)}Q${s.P(x - 2, y + 4.4, 27.6)} ${s.P(x + 1.2, y + 4.4, 25)}`, 'none', band);
  } else {
    // a single continuous figure: legs joined at a pelvis, torso up to the shoulders, head + headphones
    s.box(x + 0.3, y + 2, z, 2.2, 2.4, 6.6, shirt);              // back leg
    s.box(x + 0.3, y + 4.3, z, 2.2, 2.4, 6.6, shirt);           // front leg (side-by-side, joined — no stride gap)
    s.box(x - 0.2, y + 1.8, z + 6, 5, 4.8, 2.2, shirt);         // pelvis joining the legs
    s.box(x - 0.2, y + 2, z + 8, 5, 4.4, 7.4, shirt);           // torso, continuous
    s.box(x - 0.4, y + 2.2, z + 14.6, 5.4, 4, 1.6, shirt);      // shoulders
    s.cyl(x + 2.3, y + 4, z + 16.2, 3, 4, skin.top, skin.left); // head
    s.raw(`M${s.P(x - 0.5, y + 4, z + 18.4)}Q${s.P(x + 2.3, y + 4, z + 21.6)} ${s.P(x + 5.1, y + 4, z + 18.4)}`, 'none', band); // headphone band over the head
    s.raw(`M${s.P(x - 0.5, y + 4, z + 16.4)}L${s.P(x - 0.5, y + 4, z + 18.6)}`, 'none', band); // near earcup
  }
};

const potPlant = (s: any, x: number, y: number, z: number, r = 3.2, h = 4) => {
  s.cyl(x, y, z, r, h, '#c98b4e', '#a5672f');
  for (const [dx, dy, hh] of [[0, 0, 12], [-1.8, 0.6, 9], [1.8, -0.4, 10], [0.6, 1.6, 8]]) {
    s.raw(`M${s.P(x, y, z + h)}Q${s.P(x + dx * 1.4, y + dy * 1.4, z + h + hh * 0.6)} ${s.P(x + dx * 2.2, y + dy * 2.2, z + h + hh)}`, 'none', 'leaf');
  }
};

/* the footer mark — a small isometric enamel house-number plate that carries the
   Mozz red-CD mark: it belongs to a house and to nothing else on the site. Flat
   fills, hard edges, one outline weight, teal / cream / warm-red / orange only. */
const plateMark = (c: any) => {
  // the mounted plate — a thin slab with real thickness at the edges
  c.box(0, 0, 0, 30, 18, 2.4, { top: '#2f7d6e', left: '#276b5f', right: '#1f5249' });
  // recessed cream number panel
  c.quad(4, 3.2, 22, 11.6, 2.42, '#f4ead9');
  // two countersunk mounting screws, diagonally opposed, clear of the panel
  c.screw(2.4, 2.4, 2.42, 0.85);
  c.screw(27.6, 15.6, 2.42, 0.85);
  // the Mozz mark, printed on the panel — a compact red disc with a cream hub
  const mx = 15, my = 9, mz = 2.44;
  c.ring(mx, my, mz, 4.2, '#c80028', 'flat');   // red disc body
  c.ring(mx, my, mz, 1.4, '#f4ead9', 'flat');   // cream centre hub
  c.ring(mx, my, mz, 4.2, 'none', 'edge');      // disc rim
  c.ring(mx, my, mz, 3.4, 'none', 'cd-orange'); // warm-orange sheen ring
  c.ring(mx, my, mz, 2.3, 'none', 'seam-d');    // pressing groove
  c.ring(mx, my, mz, 1.4, 'none', 'edge');      // hub rim
};

/* ══ HERO — the cutaway house ════════════════════════════════════════════════
   Corner-open dollhouse: near walls (x=max, y=max) removed. Three interior
   floors stacked in z — basement (server), ground (living / hall+door / kitchen),
   upper (bedroom / office+router) — under a teal gable roof. A cable is traced
   from the basement switch up through the floors to every device. */
const hero = makeScene();
{
  const s = hero;
  const W = 176, D = 34;

  // ground plane + lawn tiles, and the shallow foundation the basement sits in
  grid(s, -30, W + 46, -12, D + 40, 22, 14, -34);
  s.box(-8, -8, -37, W + 20, D + 16, 3, SOIL);              // soil top slab (lawn cut edge)
  s.faceX(W + 12, -8, D + 8, -40, -34, '#5a4830', 'flat');  // foundation cross-section right (shallow)
  s.faceY(D + 8, -8, W + 12, -40, -34, '#4c3c28', 'flat');  // foundation cross-section front (shallow)
  s.quad(-8, -8, W + 20, D + 16, -34, '#7c6544', 'flat');   // soil top face

  /* ---- BASEMENT : z -34 .. -4 — lit like a room, the heart of the page --------- */
  const BFLOOR = { top: '#dcd2bd', left: '#c9bea3', right: '#b0a488' };
  s.box(0, 0, -34, W, D, 2, BFLOOR);                       // light poured-concrete floor slab
  s.faceX(0, 0, D, -32, -4, '#f3ecda', 'flat'); s.line([0, 0, -32], [0, D, -32], 'faint'); // back-right wall (bright)
  s.faceY(0, 0, W, -32, -4, '#ece2ca', 'flat');            // back-left wall (bright)
  // patch panel on the back-right wall
  s.faceX(0.2, 6, 22, -14, -6, '#2a2932', 'flat');
  for (let i = 0; i < 8; i++) s.faceX(0.4, 7.4 + i * 1.7, 8.6 + i * 1.7, -13, -11.6, i % 3 ? '#e0a94e' : '#35e08f', 'led');
  for (let i = 0; i < 8; i++) s.faceX(0.4, 7.4 + i * 1.7, 8.6 + i * 1.7, -9.4, -8, '#3b6ea5', 'led');

  // footprint shadows on the pale floor — one under each machine, offset in the light
  // direction so a grounding band reads on the near side (one shadow language page-wide)
  s.quad(20, 12, 20, 16, -31.9, 'var(--shadow)', 'flat'); s.quad(46, 12, 13, 15, -31.9, 'var(--shadow)', 'flat');
  s.quad(84, 10, 8, 18, -31.9, 'var(--shadow)', 'flat'); s.quad(124, 10, 12, 12, -31.9, 'var(--shadow)', 'flat');

  // ── THE SERVER — brightest, most detailed object on the page. It stands ON the
  //    basement floor against the back wall with clear headroom above it (so it can
  //    never read as "cut by the floor slab" the way a full-height tower did). ──────
  const SVR = { top: '#eef1f4', left: '#dbe0e6', right: '#cbd0d7' };
  s.box(20, 8, -32, 20, 16, 15, SVR);
  for (const [fx, fy] of [[20, 8], [20, 22.4], [38.4, 8], [38.4, 22.4]]) s.box(fx, fy, -33.4, 1.6, 1.6, 1.4, DARK2); // feet
  s.faceX(40, 9, 24, -31, -18, '#26252d', 'flat');         // dark faceplate on the viewer-facing (+x) face
  // four drive sleds, each a pale sled front with a lit activity LED
  for (let i = 0; i < 4; i++) {
    const z0 = -30.2 + i * 3.0;
    s.faceX(40.05, 10, 23, z0, z0 + 2.2, '#d3d8de', 'flat');                            // sled front (light)
    s.faceX(40.1, 11, 12.8, z0 + 0.55, z0 + 1.6, i % 2 ? '#35e08f' : '#e0a94e', 'led'); // activity LED
    s.line([40.05, 10, z0 + 2.4], [40.05, 23, z0 + 2.4], 'seam-d');
    s.screw(40, 22, z0 + 1.1, 0.55);
  }
  vents(s, 'x', 40.1, 17, 23, -17.4, -16.4, 3);            // vent slots along the faceplate top
  s.faceX(40.12, 10.4, 13.0, -17.4, -16.2, '#35e08f', 'led'); // glowing power LED
  // a small blank nameplate on the top face (the HOMELAB-01 text rendered ~5px and was
  // occluded by the ground-floor slab, so the wordmark lives in HTML — here just a plate)
  s.quad(19.8, 8.4, 20.4, 6.6, -16.98, '#f4ead9', 'flat'); s.quad(19.8, 8.4, 20.4, 6.6, -16.97, 'none', 'edge');
  s.line([21, 9.6, -16.95], [37.4, 9.6, -16.95], 'seam-d'); s.line([21, 13.4, -16.95], [31, 13.4, -16.95], 'seam-d');
  s.ring(32, 20.6, -16.9, 2.2, '#2f7d6e', 'edge'); s.ring(32, 20.6, -16.9, 1.1, '#2f7d6e', 'edge');

  // ── far-left laundry zone so the basement's lower-left isn't bare floor ──
  const APP = { top: '#eef0f2', left: '#dde0e4', right: '#ccd0d5' };
  const ydisc = (x: number, cy: number, cz: number, r: number, fill: string, cls?: string) => {
    let d = ''; for (let i = 0; i <= 24; i++) { const a = (i / 24) * Math.PI * 2; d += (i ? 'L' : 'M') + s.P(x, cy + r * Math.cos(a), cz + r * Math.sin(a)); }
    s.raw(d + 'Z', fill, cls);
  };
  s.quad(3, 12, 9, 13, -31.9, 'var(--shadow)', 'flat');
  s.box(3, 8, -32, 9, 13, 13, APP);                          // washing machine against the back-left wall
  s.faceX(12, 10, 20, -30, -20, '#dfe3e8', 'flat');          // front panel
  ydisc(12.06, 15, -25, 3.2, '#aab6c0', 'flat'); ydisc(12.08, 15, -25, 2.1, '#5f6f7a', 'edge'); // porthole door
  s.faceX(12.06, 10.6, 14, -18.9, -17.7, '#35e08f', 'led');  // control LED
  s.box(3, 8, -19, 9, 13, 3, DARK2);                         // shelf stacked on top
  s.box(4, 9, -16, 7, 5, 4, ORANGE); s.box(4, 15, -16, 7, 5, 4, TEAL); // stacked storage totes
  s.box(14, 24, -32, 7, 6, 6, PAPER);                        // laundry basket on the floor
  s.quad(14, 24, 7, 6, -26, '#e2d3b6', 'flat');              // folded laundry poking out
  s.box(46, 8, -32, 13, 15, 11, TEALDK);
  s.faceX(59, 10, 22, -30, -23, '#123a33', 'flat');
