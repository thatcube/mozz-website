    s.screw(45, 11, z0 + h / 2, 0.6); s.screw(45, 31, z0 + h / 2, 0.6);
  };
  blank(16, 2); blank(30, 2);
  unit(4, TEALDK, 'BAY 1');
  unit(18, DARK2, 'BAY 2');
  unit(32, TEALDK, 'BAY 3');
  blank(44, 5);
  // a floor PDU / power strip the loose patch cables plug into — no stroke ends in the void
  s.box(45, 34, 0, 16, 9, 3.4, DARK2);
  s.faceX(61, 35, 42, 0.7, 2.7, '#26252d', 'flat');                                   // PDU front strip
  for (let i = 0; i < 5; i++) s.faceX(61.06, 35.6 + i * 1.3, 36.6 + i * 1.3, 1.2, 2.2, i % 2 ? '#e0a94e' : '#35e08f', 'led'); // outlet LEDs
  // a bundled loom of cable dressed to the right upright
  for (let i = 0; i < 4; i++) s.raw(`M${s.P(45, 35, 6 + i * 0.6)}L${s.P(45, 35, 48)}`, 'none', i % 2 ? 'cable-o' : 'cable-t');
  // patch cables looping out the side and DOWN into the PDU
  for (let i = 0; i < 3; i++) s.raw(`M${s.P(45, 30, 10 + i * 14)}Q${s.P(60, 34, 12 + i * 14)} ${s.P(52, 39, 4)}`, 'none', i === 1 ? 'cable-o' : 'cable-t');
  s.box(49, 36.5, 3.4, 6, 5, 1.5, STEEL);                                             // plug block capping where the cables terminate
  for (let i = 0; i < 3; i++) s.screw(50.5 + i * 1.7, 37, 4.9, 0.5);                  // plug screws
}
// exact SVG-user-space centre of each bay-front panel (x=45, y=21, z=z0+6),
// emitted as a foreignObject inside the rack <svg> so the ServerLogo is locked to
// the drawing itself and can never drift off its bay (the HTML-overlay % maths did).
const FS = 8.4;
const rackFronts = [4, 18, 32].map((z0) => {
  const sx = (45 - 21) * IC;
  const sy = (45 + 21) * IS - (z0 + 6);
  return { x: r2(sx - FS / 2), y: r2(sy - FS / 2) };
});

/* ══ NOW-STAND — a drawn iso nightstand holding the phone (screenshot in HTML) ═ */
const stand = makeScene();
{
  const s = stand;
  // A low, WIDE media ledge the phone rests on. Broad enough that its whole silhouette
  // — all four corners and a continuous front edge — reads on both sides of the phone,
  // with the mug and plant relocated to the far ends so nothing hides behind the phone
  // (the old plant sat dead-centre and its teal leaf poked out behind the screen).
  s.quad(0, 7, 64, 28, -0.2, 'var(--shadow)', 'flat');    // flat parallelogram footprint shadow, offset near-front (matches train/house)
  s.box(0, 2, 0, 64, 28, 7, WOOD);                         // ledge slab — ONE clean top parallelogram, then front + end cap
  s.faceY(30, 0, 64, 5.2, 7, '#c2a674', 'flat');           // darker rail band, coplanar on the front face (never over the top)
  s.seam([0, 30, 4.9], [64, 30, 4.9], 'z', 0.35);          // groove line just under the rail band
  s.box(6, 6, 7, 52, 4, 1.8, WOOD2);                       // shallow back-lip the phone leans on
  s.cyl(6, 22, 7, 2, 3, '#f4ead9', '#e8703a');             // mug — far left, clear of the phone
  potPlant(s, 58, 10, 7, 2.4, 3);                          // plant — far right, clear of the phone
}

/* ══ COMMUTE — the offline story: a train car, the same listener, house switched off ══ */
const commute = makeScene();
{
  const s = commute;
  grid(s, -14, 156, -20, 60, 20, 12, 0);

  // ── real track. Drawn in RAW screen-space (not via proj) so the rail extent does NOT
  //    feed the auto-fit viewBox. That lets both ends project far outside the frame, so
  //    the viewBox itself clips them and no rail can end inside the picture. TX0/TX1 are
  //    computed to land well past the left and right frame edges at both rail depths. ──
  const RNEAR = 42, RFAR = 12, TX0 = -120, TX1 = 260;
  const pp = (x: number, y: number, z: number) => `${r2((x - y) * IC)} ${r2((x + y) * IS - z)}`;
  s.raw(`M${pp(TX0, RFAR - 3, 0.02)}L${pp(TX1, RFAR - 3, 0.02)}L${pp(TX1, RNEAR + 3, 0.02)}L${pp(TX0, RNEAR + 3, 0.02)}Z`, '#c8bfa6', 'flat'); // ballast bed (masks the grid)
  for (let x = TX0 + 4; x < TX1; x += 7) s.raw(`M${pp(x, RFAR - 2, 0.12)}L${pp(x, RNEAR + 2, 0.12)}`, 'none', 'tie'); // sleepers
  s.raw(`M${pp(TX0, RNEAR, 0.24)}L${pp(TX1, RNEAR, 0.24)}`, 'none', 'rail');   // near rail — wheels sit on this
  s.raw(`M${pp(TX0, RFAR, 0.24)}L${pp(TX1, RFAR, 0.24)}`, 'none', 'rail');     // far rail
  // flat, hard-edged cast shadow — a parallelogram of the carriage footprint, pushed far
  // enough in the light direction (+y) that a band of it reads along the carriage's near-front
  // edge to ground it, instead of hiding entirely underneath the car.
  s.quad(9, 20, 108, 34, 0.05, 'var(--shadow)', 'flat');
  // bottom-left: a colour-light signal + a distance-marker post fill the extended track
  s.quad(-27.2, 49, 3, 5, 0.03, 'var(--shadow)', 'flat');   // signal-post footprint shadow, cast forward in the light dir
  s.quad(-13.1, 48.4, 2, 3.6, 0.03, 'var(--shadow)', 'flat'); // marker-post footprint shadow
  s.box(-27, 47, 0, 2.4, 2.4, 20, { top: '#3a424a', left: '#2b3138', right: '#1d2228' }); // signal mast
  s.box(-28.6, 45.8, 13, 5, 4.6, 8, { top: '#20252b', left: '#191d22', right: '#12161a' }); // signal head
  s.faceY(50.42, -27.8, -25.6, 18.6, 20.8, '#c80028', 'led');    // red aspect
  s.faceY(50.42, -27.8, -25.6, 14.6, 16.8, '#2f7d6e', 'led');    // green aspect
  s.box(-13, 47, 0, 1.6, 1.6, 8, WOOD2);                         // distance-marker post
  s.faceX(-11.4, 46.4, 48.6, 5, 7.6, '#f4ead9', 'flat'); s.faceX(-11.35, 46.4, 48.6, 5, 7.6, 'none', 'edge'); // marker plate

  // the same house — off to the side, switched off (dark), the home the train is leaving.
  // Enlarged so the gable callback reads; its labels live in HTML, not as micro-type.
  {
    const hx = 114, hy = -24, hw = 22, hd = 14, hZ = 15, hRID = 26;
    const DK = { top: '#3a4a46', left: '#2f3d3a', right: '#232e2b' };
    s.quad(hx, hy + 2, hw, hd, -0.15, 'var(--shadow)', 'flat');              // flat parallelogram footprint shadow (matches the train)
    s.box(hx, hy, 0, hw, hd, hZ, DK);
    s.poly([[hx, hy, hZ], [hx + hw, hy, hZ], [hx + hw, hy + hd / 2, hRID], [hx, hy + hd / 2, hRID]], '#2a3936', 'flat');
    s.poly([[hx, hy + hd, hZ], [hx + hw, hy + hd, hZ], [hx + hw, hy + hd / 2, hRID], [hx, hy + hd / 2, hRID]], '#1f2b28', 'flat');
    s.line([hx, hy + hd / 2, hRID], [hx + hw, hy + hd / 2, hRID], 'seam-d');
    s.poly([[hx, hy, hZ], [hx, hy + hd / 2, hRID], [hx, hy + hd, hZ]], '#26332f', 'flat');
    s.box(hx + 3, hy + 4, hZ, 3, 3, 6, '#5a1119');                          // chimney (the callback mark)
    s.faceX(hx + hw, hy + 3.5, hy + 10.5, 3.5, 10, '#12181a', 'flat');       // dark window (off)
  }

  // a vertical wheel drawn in the x–z plane at fixed y (rings() are horizontal)
  const vwheel = (cx: number, y: number, z: number, r: number) => {
    let d = '';
    for (let i = 0; i <= 24; i++) { const a = (i / 24) * Math.PI * 2; d += (i ? 'L' : 'M') + s.P(cx + r * Math.cos(a), y, z + r * Math.sin(a)); }
    s.raw(d + 'Z', '#20252b', 'flat'); s.raw(d + 'Z', 'none', 'edge');
    s.ring(cx, y, z, r * 0.34, '#3a424a', 'flat', 10);
  };
  // two proper bogies — a frame box under the carriage with wheels seated in it, so the
  // running gear belongs to the vehicle instead of reading as loose blobs.
  const bogie = (x0: number) => {
    s.box(x0, 37.5, 3.6, 20, 6.5, 3.2, { top: '#2b3138', left: '#212730', right: '#161b21' }); // bogie frame
    s.faceX(x0 + 20, 38.5, 43.5, 3.9, 6.6, '#12171c', 'flat');                                  // frame end cap
    vwheel(x0 + 4, 42.05, 3.0, 3.0); vwheel(x0 + 16, 42.05, 3.0, 3.0);                          // two seated wheels
    s.line([x0 + 4, 42.06, 3.0], [x0 + 16, 42.06, 3.0], 'seam-d');                              // axle tie
  };
  bogie(12); bogie(80);

  // the train car body — its long flank (y=42) is the visible face, lifted to ride height
  s.box(6, 8, 7, 100, 34, 30, TEAL);
  s.box(6, 8, 7, 100, 34, 3, TEALDK);                     // skirt band
  s.seam([6, 42, 27], [106, 42, 27], 'x', 0.6);           // waistline groove on the flank
  // a rounded cab nose at the leading end — sloped windscreen so it reads as the front
  s.poly([[106, 8, 7], [120, 8, 7], [120, 8, 26], [106, 8, 37]], '#2a6d60', 'flat');   // near flank of the nose
  s.poly([[106, 42, 7], [120, 42, 7], [120, 42, 26], [106, 42, 37]], '#2f7d6e', 'flat'); // far flank (visible)
  s.poly([[106, 8, 37], [106, 42, 37], [120, 42, 26], [120, 8, 26]], '#245f54', 'flat'); // sloped windscreen roof
  s.faceX(120, 8, 42, 7, 26, '#1d463e', 'flat');          // blunt nose end
  s.faceY(42.03, 108, 118, 20, 25, '#cfe6df', 'flat');    // windscreen glass
  s.faceX(120.04, 15, 27, 12, 15, '#f0d49a', 'led');      // headlight

  // windows along the visible flank
  const wins = [12, 28, 44, 60, 76, 92];
  for (const fx of wins) {
    s.faceY(42.02, fx, fx + 12, 23, 33, '#cfe6df', 'flat');
    s.faceY(42.03, fx, fx + 12, 23, 33, 'none', 'edge');
    s.line([fx, 42.04, 23], [fx, 42.04, 33], 'seam-d');
  }
  // lit phone-glow / silhouettes in a couple of the other windows (carriage isn't empty)
  s.faceY(42.05, 62, 70, 24, 28, '#286156', 'flat');      // seated silhouette shoulders (window 4)
  s.ring(66, 42.06, 29.6, 1.8, '#20544b', 'flat', 18);      // its head
  s.faceY(42.05, 96, 99, 26, 30, '#f0d49a', 'led');         // phone glow (window 6)

  // the passenger behind window 2 — a readable seated figure: shoulders, head, headphones, glowing phone
  s.faceY(42.05, 30, 42, 24, 28, '#e07a3e', 'flat');                                   // shoulders (trapezoid-ish)
  s.faceY(42.06, 32, 40, 27, 28.8, '#d9642f', 'flat');
  s.ring(36, 42.07, 30.2, 2.3, SKIN.top, 'flat', 20);                                  // head (circle in the flank plane)
  s.raw(`M${s.P(33.4, 42.08, 30.2)}Q${s.P(36, 42.08, 32.9)} ${s.P(38.6, 42.08, 30.2)}`, 'none', 'hp'); // headphone band
  s.faceY(42.07, 41, 43.4, 25, 28, '#f0d49a', 'led');                                  // glowing phone in hand

  // (the roof "DOWNLOADED · PLAYS OFFLINE" micro-legend was removed — it rendered under
  //  the 9px floor; the section heading + the "still yours · powered down" line carry it.)
}

/* ══ PANEL — the ownership breaker box: four labelled breakers ════════════════ */
const panel = makeScene();
{
  const s = panel;
  s.quad(4, 10, 52, 36, -0.2, 'var(--shadow)', 'flat');   // flat parallelogram footprint shadow (matches ledge/house/machines)
  // the enclosure
  s.box(4, 6, 0, 52, 36, 10, METAL);
  s.faceX(56, 8, 40, 1, 9, '#8b93a0', 'flat');
  // the cover, hinged on the back-left edge and standing OPEN — so it reads as an open box
  s.box(1.4, 6, 10, 2.4, 36, 23, { top: '#c3c9d1', left: '#aeb5bf', right: '#9aa1ab' });
  s.faceX(4.02, 9, 39, 13.5, 30, '#dfe3e9', 'flat');                                   // inner schedule card
  for (let i = 0; i < 4; i++) s.line([4.03, 10, 16 + i * 3.2], [4.03, 38, 16 + i * 3.2], 'seam-d'); // schedule rows
  for (const hyy of [11, 24, 37]) s.box(4, hyy, 9.4, 1.6, 2, 1.4, DARK2);              // hinge knuckles on the edge
  // inner backplate
  s.quad(8, 10, 44, 28, 10.05, '#e7d9bd', 'flat');
  // two banks of breakers — four LIVE (teal, switched on) are the ownership guarantees
  const breaker = (bx: number, by: number, on: boolean) => {
    s.box(bx, by, 10.05, 7, 5, 2.4, on ? TEAL : DARK2);
    s.box(bx + 2.4, by + 1.4, 12.45, 2.2, 2.2, 1.6, on ? { top: '#f4ead9', left: '#e4d8bf', right: '#d0c1a0' } : { top: '#e8703a', left: '#d9642f', right: '#b85326' });
  };
  const rowY = [13, 20, 27, 34];
  rowY.forEach((by) => breaker(14, by, true));
  rowY.forEach((by) => breaker(40, by, false));
  // the main disconnect
  s.box(24, 6.4, 10.05, 8, 4, 3, RED);
  s.text(28, 8.4, 13.1, 'MAIN', 2.1, 'legend-lite', 'top', 'middle', 'central');
  // feed bus down the LEFT, stubbing into each live breaker (orthogonal)
  s.raw('M' + s.P(24, 8.4, 13.1) + 'L' + s.P(11, 8.4, 13.1) + 'L' + s.P(11, 36.5, 13.1), 'none', 'cable-t');
  rowY.forEach((by) => s.raw('M' + s.P(11, by + 2.5, 13.1) + 'L' + s.P(14, by + 2.5, 12.6), 'none', 'cable-o'));
  // feed bus down the RIGHT too, so the off breakers are wired (switched off, not dead)
  s.raw('M' + s.P(32, 8.4, 13.1) + 'L' + s.P(49, 8.4, 13.1) + 'L' + s.P(49, 36.5, 13.1), 'none', 'cable-t');
  rowY.forEach((by) => s.raw('M' + s.P(49, by + 2.5, 13.1) + 'L' + s.P(47, by + 2.5, 12.6), 'none', 'cable-o'));
  // number each live breaker (these map to the ownership list set in HTML beside the box)
  rowY.forEach((by, i) => {
    s.text(15, by + 2.5, 14.15, `0${i + 1}`, 2.1, 'plate', 'top', 'start', 'central');
  });
}

/* ══ PLAN — an architect's plan sheet in the iso plane: six rooms = six features ══ */
const plan = makeScene();
{
  const s = plan;
  const WALLC = { top: '#6a5f52', left: '#514739', right: '#413a2f' };
  const T = 1.8, WH = 2.6;
  // the drawing board / sheet (with thickness) + its face
  s.box(-8, -8, -1.6, 149, 148, 1.6, { top: '#f3ead6', left: '#e2d6bd', right: '#d3c6aa' });
  s.quad(-8, -8, 149, 148, 0.01, '#f3ead6', 'flat');
  // faint construction grid, left un-erased like the reference
  for (let gx = 0; gx <= 132; gx += 12) s.line([gx, -6, 0.02], [gx, 132, 0.02], 'faint');
  for (let gy = 0; gy <= 132; gy += 12) s.line([-6, gy, 0.02], [138, gy, 0.02], 'faint');

  // room floor tints — the light-spill idea carried onto the plan
  const room = (x0: number, y0: number, x1: number, y1: number, tint: string) => s.quad(x0, y0, x1 - x0, y1 - y0, 0.03, tint, 'flat');
  room(3, 3, 46, 50, 'rgba(232,112,58,0.13)');    // A living — amber
  room(46, 3, 92, 44, 'rgba(47,125,110,0.14)');   // B — teal
  room(92, 3, 129, 58, 'rgba(200,0,40,0.10)');    // C — crimson
  room(3, 50, 46, 93, 'rgba(122,75,214,0.12)');   // D — violet
  room(46, 44, 92, 93, 'rgba(47,125,110,0.13)');  // E — teal
  room(92, 58, 129, 93, 'rgba(232,112,58,0.12)'); // F — amber

  // walls with real thickness (low extrusions)
  const hw = (x0: number, x1: number, y: number) => s.box(x0, y - T / 2, 0, x1 - x0, T, WH, WALLC);
  const vw = (y0: number, y1: number, x: number) => s.box(x - T / 2, y0, 0, T, y1 - y0, WH, WALLC);
  hw(3, 129, 3); hw(3, 129, 93); vw(3, 93, 3); vw(3, 93, 129);   // envelope
  vw(3, 93, 46); vw(3, 93, 92);                                  // interior verticals
  hw(3, 46, 50); hw(46, 92, 44); hw(92, 129, 58);                // interior horizontals — irregular rooms

  // door swings — a quarter-circle leaf sweep, drawn in the sheet plane
  const swing = (hx: number, hy: number, r: number, a0: number, a1: number) => {
    let d = 'M' + s.P(hx, hy, WH + 0.1);
    for (let i = 0; i <= 10; i++) { const a = a0 + (a1 - a0) * i / 10; d += 'L' + s.P(hx + r * Math.cos(a), hy + r * Math.sin(a), WH + 0.1); }
    s.raw(d, 'none', 'pl-door');
  };
  swing(46, 16, 10, Math.PI, Math.PI * 1.5);      // A ↔ B
  swing(92, 22, 10, Math.PI, Math.PI * 1.5);      // B ↔ C
  swing(46, 70, 10, Math.PI * 1.5, Math.PI * 2);  // D ↔ E
  swing(92, 74, 10, Math.PI * 0.5, Math.PI);      // E ↔ F
  swing(24, 93, 11, Math.PI, Math.PI * 1.5);      // front door → D

  // room labels — a big letter tag INSIDE each room, in the sheet plane. The
  // feature *names* are set as real HTML type in the list beside the sheet (they
  // were unreadable at ~5px baked into the drawing), so the sheet stays legible.
  const rooms = [
    { c: [24.5, 26.5], n: 'A' },
    { c: [69, 23.5], n: 'B' },
    { c: [110.5, 30.5], n: 'C' },
    { c: [24.5, 71.5], n: 'D' },
    { c: [69, 68.5], n: 'E' },
    { c: [110.5, 75.5], n: 'F' },
  ];
  for (const r of rooms) {
    s.text(r.c[0], r.c[1], 0.1, r.n, 9, 'pl-tag', 'top', 'middle', 'central');
  }

  // title block: SERVER → WIFI → PHONE → EARS, with the middleman branch drawn broken
  const ty = 108;
  const node = (x: number, lab: string, lit: boolean, labY: number) => {
    s.ring(x, ty, 0.06, 4, lit ? '#c80028' : '#2f7d6e', 'flat'); s.ring(x, ty, 0.07, 4, 'none', 'edge');
    s.text(x, labY, 0.1, lab, 4.6, 'legend-tick', 'top', 'middle', 'central');
  };
  const chain: [number, string][] = [[12, 'SERVER'], [50, 'WIFI'], [88, 'PHONE'], [126, 'EARS']];
  for (let i = 0; i < chain.length - 1; i++) s.raw('M' + s.P(chain[i][0] + 4, ty, 0.08) + 'L' + s.P(chain[i + 1][0] - 4, ty, 0.08), 'none', 'cable-t');
  // PHONE's label sits ABOVE its node so it clears the downward dead-branch + X below it
  chain.forEach(([x, lab], i) => node(x, lab, i === 3, x === 88 ? ty - 9 : ty + 10));
  // the branch that never happens — a bold dead stub off PHONE, crossed out large,
  // with its NO MIDDLEMAN caption kept well inside the sheet and clear of EARS + the X
  s.raw('M' + s.P(88, ty + 4, 0.08) + 'L' + s.P(88, ty + 12, 0.08) + 'L' + s.P(108, ty + 12, 0.08), 'none', 'dead');
  s.raw('M' + s.P(94, ty + 7, 0.12) + 'L' + s.P(104, ty + 17, 0.12) + 'M' + s.P(104, ty + 7, 0.12) + 'L' + s.P(94, ty + 17, 0.12), 'none', 'wire-x');
  s.text(62, ty + 16, 0.1, 'NO MIDDLEMAN', 5, 'pl-tag', 'top', 'middle', 'central');
}

const specFor = (i: number) => STATS[i];
const roomFor = ['mozz-album-warm', 'mozz-album-red', 'mozz-artist', 'mozz-playlist'];
---

<Layout
  title={`${NAME} — the machine in your house`}
  description="A free, open source music app for Plex, Jellyfin and Navidrome, drawn as the place self-hosting actually happens: a cutaway house with the server in the basement, cables in the walls and music in every room."
  themeColor="#f4ead9"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://api.fontshare.com/v2/css?f[]=bespoke-slab@400,500,700&f[]=general-sans@400,500,600&f[]=khand@500,600,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="hl">
    <!--
      THESIS: Streaming has a data centre you'll never see; this has a box in the
      basement you named yourself. The page is one enormous cutaway house and a
      few smaller dioramas around it — the server humming downstairs, the cables
      traced through the walls, the music in every room and walking out the door.
      OWN-WORLD: warm cream ground, deep teal-green structure, burnt orange for
      warmth, mozz red for marks. Flat screen-print colour, one value step per
      face, one line weight, un-erased construction guides, light riso grain.
      DROP-IN: /hero/homelab.jpg layers over the drawn house; absent, it never paints.
    -->

    <VariantBar slug="homelab" tone="warm" />

    <!-- HERO ------------------------------------------------------------------ -->
    <header class="hero">
      <div class="hero-copy">
        <div class="lockup">
          <Mark size={26} decorative />
          <span class="wordmark">{NAME}</span>
          <span class="lockup-tick">self-hosted · #homelab</span>
        </div>
        <h1>{TAGLINE}</h1>
        <p class="lede">
          {SUBLINE} Streaming keeps your music in a data centre you'll never see.
          Mozz plays from the one in your house — your own Plex, Jellyfin or
          Navidrome server, humming in the basement.
        </p>
        <div class="actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="ghost" href={GITHUB_URL}>Read the source →</a>
        </div>
      </div>

      <figure class="stage">
        <div class="plate" aria-hidden="true"></div>
        <!-- Optional AI plate drop-in: public/hero/homelab.jpg (absent → the drawing carries it). -->
        <svg class="art house" viewBox={hero.vb(10)} role="img"
             aria-label="A giant isometric cutaway of a house with its front walls removed. In the basement a home server rack, a UPS, a network switch and a coil of ethernet; on the ground floor a living room with someone in an armchair wearing headphones, a hallway with the front door open and a figure stepping out, and a kitchen; upstairs a bedroom, an office with a router covered in cables, and a bathroom. A single cable is traced from the basement switch up through the floors to every device, and a teal roof carries a chimney and a broadcasting wifi antenna.">
          {hero.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {hero.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
    </header>

    <!-- SERVERS --------------------------------------------------------------- -->
    <section class="scene servers" aria-labelledby="srv-h">
      <div class="scene-head">
        <h2 id="srv-h">Point it at a machine you already own.</h2>
        <p>Three compatible server families — drawn as the three units on your basement shelf. Pick the one you already run and Mozz mirrors its catalog onto the device.</p>
      </div>
      <div class="rack-grid">
        <figure class="rack-fig">
          <svg class="art" viewBox={rack.vb(6)} role="img"
               aria-label="A three-bay home server rack drawn in isometric, its three units patched together with cables, each bay front printed with its server's logo.">
            {rack.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
            {rack.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
            {SERVERS.map((sv, i) => (
              <foreignObject x={rackFronts[i].x} y={rackFronts[i].y} width={FS} height={FS} aria-hidden="true">
                <div xmlns="http://www.w3.org/1999/xhtml" class="bay-logo"><ServerLogo name={sv.name} size={FS} brand /></div>
              </foreignObject>
            ))}
          </svg>
        </figure>
        <ul class="server-list" role="list">
          {SERVERS.map((sv) => (
            <li>
              <span class="server-logo-wrap"><ServerLogo name={sv.name} size={28} brand /></span>
              <div>
                <h3>{sv.name}</h3>
                <p>{sv.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FEATURES: the floor plan + wiring diagram ----------------------------- -->
    <section class="scene plan-sec" aria-labelledby="feat-h">
      <div class="scene-head">
        <h2 id="feat-h">Read it like a floor plan.</h2>
        <p>Everything Mozz does, laid out as the rooms of a house and labelled the way a drawing labels them. The signal starts at the server and reaches your ears; the branch that never happens is drawn broken.</p>
      </div>

      <figure class="plan-art">
        <svg class="art" viewBox={plan.vb(5)} role="img"
             aria-label="An isometric architect's plan sheet with six irregularly-shaped rooms, each labelled with one of the six features and a door swing, and a title-block wiring chain from server to wifi to phone to ears with the middleman branch drawn broken and crossed out.">
          {plan.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {plan.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>

      <ol class="parts-list" role="list">
        {FEATURES.map((ft, i) => (
          <li>
            <span class="part-num">{String.fromCharCode(65 + i)}</span>
            <div>
              <h3>{ft.title}</h3>
              <p>{ft.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- NOW PLAYING: drawn nightstand + real screenshot; rooms lit by what plays - -->
    <section class="scene now" aria-labelledby="now-h">
      <div class="scene-head">
        <h2 id="now-h">Every room in the colour of what's playing.</h2>
        <p>Mozz repaints its whole interface from the artwork of the current record — so the light spilling out of each room takes the colour of whatever it is playing.</p>
      </div>

      <div class="now-grid">
        <figure class="stand-fig">
          <svg class="art stand-art" viewBox={stand.vb(5)} role="presentation" preserveAspectRatio="xMidYMax meet">
            {stand.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          </svg>
          <div class="stand-phone">
            <Phone name="mozz-nowplaying" width={206} priority sizes="206px"
                   class="hl-phone" alt="The Mozz now-playing screen, its whole interface tinted violet to match the album art." />
          </div>
        </figure>

        <div class="rooms">
          <ul class="room-strip" role="list">
            {roomFor.map((nm, i) => (
              <li class="room-lit">
                <Shot name={nm} sizes="(max-width: 720px) 40vw, 150px"
                      class="room-shot" ariaHidden={true} />
                <span class="room-key">Room {i + 1}</span>
              </li>
            ))}
          </ul>
          <div class="meter">
            {STATS.map((st) => (
              <div class="meter-cell">
                <b>{st.value}</b><span>{st.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- OFFLINE: the commute ------------------------------------------------- -->
    <section class="scene commute-sec" aria-labelledby="off-h">
      <figure class="band-art">
        <svg class="art" viewBox={commute.vb(6)} role="img"
             aria-label="A teal commuter train drawn in isometric with the same listener seated at a window wearing headphones, a phone glowing in hand, and the house far away on a hill with its windows dark and its power switched off.">
          {commute.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
          {commute.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
        </svg>
      </figure>
      <div class="scene-head narrow">
        <h2 id="off-h">Take the house with you.</h2>
        <p>Downloads were designed in from the first day, not bolted on. Take a record on the train and it behaves exactly like it does at home — the catalog lives on the device, so browsing and search work with the server dark and unreachable.</p>
        <p class="lockup-tick tick-inline">still yours · powered down</p>
      </div>
    </section>

    <!-- OWNERSHIP: the breaker box ------------------------------------------- -->
    <section class="scene own" aria-labelledby="own-h">
      <div class="scene-head">
        <h2 id="own-h">The wiring is yours to the last breaker.</h2>
        <p>No login, because there is no Mozz server to log into. The four things that are switched on for good — and the ones that were never wired in.</p>
      </div>
      <div class="own-grid">
        <figure class="panel-fig">
          <svg class="art" viewBox={panel.vb(6)} role="img"
               aria-label="An open electrical breaker box drawn in isometric with a bank of four teal breakers switched on and a red main disconnect.">
            {panel.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />)}
            {panel.texts.map((t) => <text transform={t.tr} font-size={t.size} text-anchor={t.anchor} dominant-baseline={t.base} class={t.cls}>{t.s}</text>)}
          </svg>
        </figure>
        <ul class="own-list" role="list">
          {OWNERSHIP.map((o, i) => (
            <li>
              <span class="own-sw" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div><h3>{o.title}</h3><p>{o.body}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ: the homeowner's manual ------------------------------------------ -->
    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Homeowner's manual</h2>
      <dl>
        {FAQS.map((qa) => (
          <div class="faq-row"><dt>{qa.q}</dt><dd>{qa.a}</dd></div>
        ))}
      </dl>
    </section>

    <!-- FOOTER ---------------------------------------------------------------- -->
    <div class="foot-band">
      <footer class="foot">
        <div class="foot-mark">
          <Mark size={22} decorative />
          <span class="wordmark">{NAME}</span>
        </div>
        <p class="foot-line">{TAGLINE} {SUBLINE}</p>
        <p class="foot-meta">
          Free forever · GPL-3.0 with an App Store Exception · <a href={GITHUB_URL}>source on GitHub</a>
        </p>
        <div class="foot-disc" aria-hidden="true">
          <svg class="art" viewBox={(() => { const c = makeScene(); plateMark(c); return c.vb(3); })()}>
            {(() => { const c = makeScene(); plateMark(c); return c.parts.map((p) => <path d={p.d} style={`fill:${p.fill}`} class={p.cls} />); })()}
          </svg>
        </div>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .hl {
    --cream: #f4ead9;
    --cream-hi: #fbf5ea;
    --teal: #2f7d6e;
    --teal-dk: #1f5249;
    --orange: #e8703a;
    --red: #c80028;
    --ink: #26201a;
    --ink-soft: #6d5c48;
    --hole: #efe2cd;
    --shadow: rgba(60, 46, 30, 0.16);
    --guide: rgba(120, 92, 60, 0.32);

    --hero-plate: url('/hero/homelab.jpg');

    background:
      radial-gradient(128% 92% at 82% 4%, #fdf7ec 0%, var(--cream) 46%, #ecdec6 100%);
    color: var(--ink);
    font-family: 'General Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.62;
    overflow-x: clip;
    position: relative;
    isolation: isolate;
  }

  /* riso grain */
  .hl::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.8;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='150'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.6'/></feComponentTransfer></filter><rect width='150' height='150' filter='url(%23n)'/></svg>");
    background-size: 150px 150px;
  }

  /* one outline weight everywhere */
  .art { width: 100%; height: auto; overflow: visible; }
  .art path, .art circle, .art ellipse, .art line, .art rect {
    vector-effect: non-scaling-stroke;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .art .flat { stroke: none; }
  .art .edge { fill: none; }
  .art .cd-red { stroke: var(--red); stroke-width: 1.7; fill: none; }
  .art .cd-orange { stroke: var(--orange); stroke-width: 1.4; fill: none; }
  .art .part { stroke: none; }
  .art .guide { stroke: var(--guide); stroke-width: 1; }
  .art .faint { stroke: rgba(38,32,26,0.26); stroke-width: 1.05; }
  .art .seam-d { stroke: rgba(10,8,5,0.42); stroke-width: 1.2; }
  .art .seam-l { stroke: rgba(255,250,240,0.5); stroke-width: 1.2; }
  .art .screw { stroke: rgba(20,14,8,0.55); stroke-width: 1.1; }
  .art .vent  { stroke: rgba(10,8,5,0.5); stroke-width: 1.3; }
  .art .led   { stroke: rgba(10,8,5,0.4); stroke-width: 0.8; }
  .art .shingle { stroke: rgba(10,30,26,0.28); stroke-width: 1.1; }
  .art .cable-run { stroke: var(--teal-dk); stroke-width: 3; fill: none; }
  .art .cable-o { stroke: var(--orange); stroke-width: 2.2; fill: none; }
  .art .cable-t { stroke: var(--teal); stroke-width: 2.2; fill: none; }
  .art .antenna { stroke: #26201a; stroke-width: 2.2; fill: none; }
  .art .antenna-thin { stroke: #26201a; stroke-width: 1.5; fill: none; }
  .art .wifi { stroke: rgba(47,125,110,0.7); stroke-width: 1.6; fill: none; }
  .art .wheel { stroke: #26201a; stroke-width: 2.6; fill: none; }
  .art .frame { stroke: #6d5c48; stroke-width: 2.6; fill: none; }
  .art .rail { stroke: #8a8579; stroke-width: 2.4; fill: none; }
  .art .tie  { stroke: rgba(60,46,30,0.4); stroke-width: 2; }
  .art .leaf { stroke: var(--teal); stroke-width: 2.4; fill: none; }
  .art .tail { stroke: #241f1d; stroke-width: 3.2; fill: none; }
  .art .hp   { stroke: #26201a; stroke-width: 3.4; fill: none; }
  .art .hp2  { stroke: var(--red); stroke-width: 3.4; fill: none; }
  .art text { fill: var(--ink); font-family: 'Khand', sans-serif; letter-spacing: 0.03em; }
  .art .lcd { fill: #7fe6c4; font-family: 'Khand', sans-serif; letter-spacing: 0.06em; }
  .art .legend-lite { fill: #f7efe0; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
  .art .legend-tick { fill: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.09em; }
  .art .plate { fill: var(--ink); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .art .pl-name { fill: var(--ink); font-family: 'General Sans', sans-serif; font-weight: 600; letter-spacing: 0; }
  .art .pl-tag { fill: var(--red); font-weight: 700; letter-spacing: 0.02em; }
  .art .dead { stroke: rgba(200,0,40,0.85); stroke-width: 2.8; stroke-dasharray: 5 4; fill: none; }
  .art .wire-x { stroke: var(--red); stroke-width: 3.4; fill: none; stroke-linecap: round; }
  .art .pl-door { stroke: rgba(10,8,5,0.55); stroke-width: 1.6; fill: none; }

  h1, h2, h3 { font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
  .hero h1, .scene-head h2 { font-family: 'Bespoke Slab', Georgia, serif; }

  /* ── hero ── */
  .hero {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3.5vw, 3rem) clamp(1.25rem, 4vw, 3rem) clamp(0.5rem, 2vw, 1.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
  }
  .lockup { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.3rem; }
  .wordmark { font-weight: 600; font-size: 1.35rem; letter-spacing: -0.03em; font-family: 'Bespoke Slab', Georgia, serif; }
  .lockup-tick {
    font-family: 'Khand', sans-serif; text-transform: uppercase; letter-spacing: 0.13em;
    font-size: 0.7rem; color: var(--ink-soft); border-left: 1px solid var(--guide);
    padding-left: 0.6rem; margin-left: 0.2rem;
  }
  .tick-inline { display: inline-block; margin-top: 0.9rem; font-size: 0.78rem; }
  .hero h1 { font-size: clamp(2.3rem, 5vw, 4rem); max-width: 15ch; margin-bottom: 1rem; }
  .lede { max-width: 42ch; color: #4c3c2c; font-size: 1.05rem; }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.7rem; }
  .store {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--ink); color: var(--cream-hi);
    padding: 0.7rem 1.15rem; border-radius: 12px; font-weight: 600;
    box-shadow: 4px 5px 0 rgba(38, 32, 26, 0.18);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .store:hover { transform: translate(-1px, -1px); box-shadow: 5px 6px 0 rgba(38, 32, 26, 0.22); }
  .store svg { width: 22px; height: 22px; fill: currentColor; }
  .store span { display: flex; flex-direction: column; line-height: 1.05; font-size: 1.02rem; }
  .store small { font-size: 0.64rem; font-weight: 500; opacity: 0.82; text-transform: uppercase; letter-spacing: 0.06em; }
  .store.is-pending { background: #e7d6b8; color: var(--ink); box-shadow: 4px 5px 0 rgba(38, 32, 26, 0.14); cursor: default; }
  .store.is-pending small::after { content: ' · pending'; opacity: 0.7; }
  .ghost { font-weight: 600; color: var(--teal); border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .ghost:hover { color: var(--orange); }

  .stage { position: relative; margin: 0; min-width: 0; }
  .stage .plate {
    position: absolute; inset: 3%; z-index: -1;
    background-image: var(--hero-plate);
    background-size: cover; background-position: center; background-repeat: no-repeat;
    border-radius: 24px; opacity: 0.9;
  }
  .stage .house { filter: drop-shadow(0 30px 46px rgba(60, 46, 30, 0.18)); }

  /* ── generic scene ── */
  .scene {
    max-width: 1180px;
    margin: clamp(2.5rem, 7vw, 6rem) auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: center;
  }
  .scene-head h2 { font-size: clamp(1.7rem, 3.4vw, 2.6rem); max-width: 20ch; margin-bottom: 0.7rem; }
  .scene-head p { max-width: 52ch; color: #4c3c2c; }
  .scene-head.narrow p { max-width: 56ch; }

  .band-art { margin: 0.5rem 0 0; width: 100%; }

  /* ── servers rack ── */
  .servers { grid-template-columns: 1fr; }
  .rack-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .rack-fig { position: relative; margin: 0; max-width: 460px; }
  .rack-fig .art { filter: drop-shadow(0 18px 30px rgba(60, 46, 30, 0.14)); overflow: visible; }
  .rack-fig foreignObject { overflow: visible; }
  .bay-logo { width: 100%; height: 100%; display: grid; place-items: center; }
  .bay-logo .server-logo { width: 100%; height: 100%; }
  .server-list { display: grid; gap: 1.1rem; margin: 0; padding: 0; }
  .server-list li { display: flex; gap: 0.85rem; align-items: flex-start; }
  .server-logo-wrap {
    flex: none; width: 44px; height: 44px; border-radius: 10px;
    display: grid; place-items: center; background: var(--cream-hi);
    box-shadow: inset 0 0 0 1px rgba(38, 32, 26, 0.12), 3px 3px 0 rgba(38,32,26,0.08);
  }
  .server-list h3 { font-size: 1.08rem; margin-bottom: 0.12rem; }
  .server-list p { font-size: 0.93rem; color: #4c3c2c; }

  /* ── floor plan (isometric plan-sheet scene) ── */
  .plan-sec { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); align-items: start; }
  .plan-sec .scene-head { grid-column: 1 / -1; }
  .plan-art { margin: 0; }
  .plan-art .art { width: 100%; height: auto; filter: drop-shadow(0 18px 30px rgba(60, 46, 30, 0.14)); }

  .parts-list { display: grid; gap: 1rem; margin: 0; padding: 0; }
  .parts-list li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; }
  .part-num {
    font-family: 'Khand', sans-serif; font-weight: 700; font-size: 1.1rem;
    width: 30px; height: 30px; border-radius: 8px; flex: none;
    display: grid; place-items: center; color: var(--cream-hi); background: var(--teal);
  }
  .parts-list h3 { font-size: 1.05rem; margin-bottom: 0.1rem; }
  .parts-list p { font-size: 0.93rem; color: #4c3c2c; max-width: 52ch; }

  /* ── now playing ── */
  .now { grid-template-columns: 1fr; }
  .now-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .stand-fig { position: relative; margin: 0; display: grid; place-items: center; min-height: 380px; }
  .stand-art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stand-phone { position: relative; z-index: 2; transform: translateY(-9%); }
  .hl-phone {
    --phone-bezel: linear-gradient(#33302b, #1c1915);
    --phone-bezel-w: 0.04;
    --phone-rim: rgba(255, 240, 220, 0.2);
    /* no soft blur under the phone — it rests on the drawn ledge, which carries a flat
       hard-edged ground shadow like the rest of the page. */
    --phone-shadow: none;
  }
  .rooms { display: grid; gap: 1.4rem; }
  .room-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; margin: 0; padding: 0; }
  .room-lit { position: relative; margin: 0; }
  .room-lit :global(.room-shot) {
    display: block; width: 100%; height: auto; border-radius: 12px;
    box-shadow: 0 12px 22px -10px rgba(38,32,26,0.5), inset 0 0 0 1px rgba(38,32,26,0.1);
  }
  .room-key {
    position: absolute; left: 8px; bottom: 8px;
    font-family: 'Khand', sans-serif; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--cream-hi); background: rgba(38,32,26,0.62); padding: 0.1rem 0.4rem; border-radius: 5px;
  }
  .meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .meter-cell {
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.7rem 0.85rem; border-radius: 3px; background: var(--cream-hi);
    box-shadow: inset 0 0 0 1px rgba(38, 32, 26, 0.42);
  }
  .meter-cell b { font-family: 'Khand', sans-serif; font-size: 1.55rem; font-weight: 700; color: #b8531f; letter-spacing: -0.01em; }
  .meter-cell span { font-size: 0.72rem; color: #4c3c2c; text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.25; }

