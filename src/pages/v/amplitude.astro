<script is:inline>
  (() => {
    const root = document.querySelector('[data-amplitude-page]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const chunks = Array.from(root.querySelectorAll('[data-wave-chunk]'));
    if (reduce || !('IntersectionObserver' in window)) {
      chunks.forEach((chunk) => chunk.classList.add('is-hot'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-hot', entry.isIntersecting);
      });
    }, { rootMargin: '-38% 0px -38% 0px', threshold: 0.01 });
    chunks.forEach((chunk) => observer.observe(chunk));
  })();
</script>
