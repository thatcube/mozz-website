                <line x1="38" y1="40" x2="94" y2="40" /><line x1="36" y1="50" x2="96" y2="50" />
              </g>
              <circle cx="28" cy="62" r="2.6" fill="#7ce0b6" />
            </g>
          ))}
        </svg>

        <ol class="heads" role="list">
          {SERVERS.map((s, i) => (
            <li class="head">
              <span class="head__idx">{`P-0${i + 1}`}</span>
              <span class="head__logo"><ServerLogo name={s.name} size={30} brand /></span>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ======================================================================
         CATALOGUE — the star chart. Search as a reticle over the whole sky.
    ====================================================================== -->
    <section class="band band--chart" id="catalogue" aria-labelledby="h-chart">
      <div class="chart">
        <svg class="chart__plot" viewBox="0 0 1200 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <radialGradient id="cn-plotglow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#7fa8ff" stop-opacity="0.2" />
              <stop offset="1" stop-color="#7fa8ff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse cx="600" cy="170" rx="600" ry="170" fill="url(#cn-plotglow)" />
          <g stroke="#5f74d8" stroke-width="0.8" opacity="0.16">
            {Array.from({ length: 13 }, (_, i) => <line x1={i * 100} y1="0" x2={i * 100} y2="340" />)}
            {Array.from({ length: 5 }, (_, i) => <line x1="0" y1={i * 85} x2="1200" y2={i * 85} />)}
          </g>
          <g fill="#dfe8ff">
            {PLOT.map((p) => <circle cx={p.x} cy={p.y} r={p.r} opacity={p.o} />)}
          </g>
          <g class="finder">
            <circle cx="762" cy="128" r="52" fill="none" stroke="#7ce0b6" stroke-width="1.4" opacity="0.9" />
            <circle cx="762" cy="128" r="66" fill="none" stroke="#7ce0b6" stroke-width="0.8" opacity="0.4" stroke-dasharray="6 10" />
            <g stroke="#7ce0b6" stroke-width="1.2" opacity="0.85">
              <line x1="686" y1="128" x2="706" y2="128" /><line x1="818" y1="128" x2="838" y2="128" />
              <line x1="762" y1="52" x2="762" y2="72" /><line x1="762" y1="184" x2="762" y2="204" />
            </g>
            <circle cx="762" cy="128" r="3.4" fill="#dffff2" />
            <line x1="812" y1="90" x2="880" y2="46" stroke="#7ce0b6" stroke-width="0.9" opacity="0.5" />
            <text class="hud hud--green" x="888" y="42">FOUND · {sSearch.value}</text>
          </g>
        </svg>

        <div class="chart__legend">
          <p class="eyebrow">Star chart</p>
          <h2 id="h-chart">Every track you own, on one chart you can point at.</h2>
          <p>{FEATURES[2].body}</p>
          <p>
            The catalogue lives on the phone, not on the server, so the chart is
            still there with the house unplugged — you can browse and search a
            library whose files are three hundred miles away.
          </p>
          <dl class="legend__stat">
            <dt>{sSearch.value}</dt>
            <dd>{sSearch.label}</dd>
          </dl>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         RADIO — the azimuth dial.
    ====================================================================== -->
    <section class="band band--radio" id="radio" aria-labelledby="h-radio">
      <div class="duo">
        <div class="duo__text">
          <p class="eyebrow">Azimuth</p>
          <h2 id="h-radio">Radio that understands taste, drawn as a sweep.</h2>
          <p>{FEATURES[4].body}</p>
          <p>
            Point the line at anything in the sky and it keeps going in that
            direction: nearby records first, then the ones a little further out
            that still belong to the same weather.
          </p>
        </div>

        <div class="duo__art">
          <svg class="dial" viewBox="0 0 520 520" role="img" aria-label="A circular azimuth dial ringed with tick marks. A line sweeps out from the centre across a field of stars, with the nearest stars picked out as it passes.">
            <defs>
              <radialGradient id="cn-dialbg" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0" stop-color="#141c46" />
                <stop offset="1" stop-color="#070a20" />
              </radialGradient>
              <linearGradient id="cn-dialsweep" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#ff4062" stop-opacity="0" />
                <stop offset="1" stop-color="#ff4062" stop-opacity="0.34" />
              </linearGradient>
            </defs>
            <circle cx="260" cy="260" r="248" fill="url(#cn-dialbg)" stroke="#2c3878" stroke-width="1.4" />
            <circle cx="260" cy="260" r="212" fill="none" stroke="#2c3878" stroke-width="1" opacity="0.7" />
            <circle cx="260" cy="260" r="150" fill="none" stroke="#2c3878" stroke-width="0.9" opacity="0.5" />
            <circle cx="260" cy="260" r="86" fill="none" stroke="#2c3878" stroke-width="0.9" opacity="0.4" />

            <g stroke="#5f74d8" opacity="0.7">
              {Array.from({ length: 72 }, (_, i) => {
                const t = (i * 5 * Math.PI) / 180;
                const long = i % 6 === 0;
                return (
                  <line
                    x1={R(260 + Math.cos(t) * 248)} y1={R(260 + Math.sin(t) * 248)}
                    x2={R(260 + Math.cos(t) * (248 - (long ? 18 : 8)))} y2={R(260 + Math.sin(t) * (248 - (long ? 18 : 8)))}
                    stroke-width={long ? 1.8 : 0.9}
                  />
                );
              })}
            </g>
            <g class="hud" fill="#8189ad">
              <text x="260" y="46" text-anchor="middle">N</text>
              <text x="482" y="266" text-anchor="middle">E</text>
              <text x="260" y="490" text-anchor="middle">S</text>
              <text x="38" y="266" text-anchor="middle">W</text>
            </g>

            <g fill="#dfe8ff">
              {PLOT.slice(0, 190).map((p) => {
                const dx = (p.x - 600) * 0.38;
                const dy = (p.y - 170) * 1.28;
                if (dx * dx + dy * dy > 205 * 205) return null;
                return <circle cx={R(260 + dx)} cy={R(260 + dy)} r={R(p.r * 0.8)} opacity={R(p.o * 0.85)} />;
              })}
            </g>

            <g class="dial__arm">
              <path d="M260,260 L260,52 A208,208 0 0 1 407,113 Z" fill="url(#cn-dialsweep)" />
              <line x1="260" y1="260" x2="260" y2="48" stroke="#ff6a84" stroke-width="2" />
            </g>
            <circle cx="260" cy="260" r="10" fill="#0f1638" stroke="#ff6a84" stroke-width="1.6" />
            <circle cx="260" cy="260" r="3" fill="#ff9db2" />
          </svg>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         WEEKLY MIX — a constellation still being inked in.
    ====================================================================== -->
    <section class="band band--mix" id="mix" aria-labelledby="h-mix">
      <div class="duo duo--flip">
        <div class="duo__art">
          <svg class="newcon" viewBox="0 0 520 420" role="img" aria-label="A new constellation being drawn: seven stars joined by a bright line that is still being inked in, labelled this week’s mix.">
            <rect width="520" height="420" rx="18" fill="#070a20" stroke="#2c3878" stroke-width="1.2" />
            <g stroke="#5f74d8" stroke-width="0.7" opacity="0.14">
              {Array.from({ length: 11 }, (_, i) => <line x1={i * 52} y1="0" x2={i * 52} y2="420" />)}
              {Array.from({ length: 9 }, (_, i) => <line x1="0" y1={i * 52} x2="520" y2={i * 52} />)}
            </g>
            <g fill="#dfe8ff">
              {SKY_P.slice(0, 90).map((s) => (
                <circle cx={R((s.x / 800) * 520)} cy={R((s.y / 1240) * 420)} r={R(s.r * 0.8)} opacity={R(s.o * 0.7)} />
              ))}
            </g>

            <polyline
              class="con-ink"
              points="96,300 150,196 236,150 330,178 396,120 438,214 372,296 268,318 96,300"
              fill="none" stroke="url(#cn-freshline)" stroke-width="2.6"
              stroke-linecap="round" stroke-linejoin="round"
            />
            {[[96, 300], [150, 196], [236, 150], [330, 178], [396, 120], [438, 214], [372, 296], [268, 318]].map((p) => (
              <g>
                <circle cx={p[0]} cy={p[1]} r="9" fill="url(#cn-halo)" opacity="0.6" />
                <circle cx={p[0]} cy={p[1]} r="3.2" fill="#ffe9ee" />
              </g>
            ))}
            <text class="con-name con-name--fresh" x="88" y="360">This Week’s Mix</text>
            <text class="con-tag" x="88" y="384">✦ inked on Monday, from what you actually played</text>
          </svg>
        </div>

        <div class="duo__text">
          <p class="eyebrow">New this week</p>
          <h2 id="h-mix">Every week, a constellation you did not have before.</h2>
          <p>
            Weekly mixes join up records that were already yours in a shape you
            had not noticed: a run of late-night listening, a corner of the
            library that has gone quiet, a thread pulled from something you had
            on repeat.
          </p>
          <p>
            Nothing is recommended into your library from outside it. The mix is
            drawn out of files you already own, so every star in it is one you
            can actually play, offline, tonight.
          </p>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         OFFLINE — meteor trails into the phone.
    ====================================================================== -->
    <section class="band band--offline" id="offline" aria-labelledby="h-offline">
      <div class="fall">
        <svg class="fall__art" viewBox="0 0 1200 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="cn-trail" x1="0" y1="0" x2="0.4" y2="1">
              <stop offset="0" stop-color="#7ce0b6" stop-opacity="0" />
              <stop offset="0.6" stop-color="#7ce0b6" stop-opacity="0.55" />
              <stop offset="1" stop-color="#dffff2" stop-opacity="1" />
            </linearGradient>
          </defs>
          <g fill="#dfe8ff">
            {SKY_L.slice(0, 170).map((s) => (
              <circle cx={R((s.x / 1600) * 1200)} cy={R((s.y / 880) * 300)} r={R(s.r * 0.85)} opacity={R(s.o * 0.8)} />
            ))}
          </g>
          <g fill="none" stroke="url(#cn-trail)" stroke-linecap="round">
            <path class="trail" style="--d:0s"   d="M180,-30 Q 380,150 596,392" stroke-width="2.6" />
            <path class="trail" style="--d:1.4s" d="M420,-30 Q 500,160 598,392" stroke-width="1.8" />
            <path class="trail" style="--d:2.6s" d="M980,-30 Q 800,150 604,392" stroke-width="2.4" />
            <path class="trail" style="--d:3.6s" d="M700,-30 Q 660,170 600,392" stroke-width="1.5" />
            <path class="trail" style="--d:4.6s" d="M1120,-30 Q 880,170 608,392" stroke-width="1.9" />
          </g>
          <path d="M-20,404 C 300,376 470,368 600,368 C 730,368 900,376 1220,404 L1220,460 L-20,460 Z" fill="#05061a" />
          <path d="M-20,404 C 300,376 470,368 600,368 C 730,368 900,376 1220,404" fill="none" stroke="#2c3878" stroke-width="1.2" opacity="0.7" />
        </svg>

        <div class="fall__text">
          <p class="eyebrow">Meteor stream</p>
          <h2 id="h-offline">Pull a record out of the sky and it lands in your pocket.</h2>
          <p>{FEATURES[1].body}</p>
          <p>
            Downloaded tracks are indistinguishable from streamed ones in use —
            same queue, same gapless transitions, same equalizer. The only thing
            that changes is that the tunnel stops mattering.
          </p>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         FEATURES — the meridian catalogue.
    ====================================================================== -->
    <section class="band band--cat" id="features" aria-labelledby="h-cat">
      <div class="wrap">
        <p class="eyebrow">Catalogue</p>
        <h2 id="h-cat">Logged on the meridian</h2>
        <p class="band__lede">
          Six things the app does, written down the way an observatory writes
          things down — measured, dated, and boring on purpose. {sStart.value}
          {' '}{sStart.label}.
        </p>

        <ol class="meridian" role="list">
          {FEATURES.map((f, i) => (
            <li class="mline">
              <span class="mline__node" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="11" fill="none" stroke="#5f74d8" stroke-width="1" opacity="0.6" />
                  <path d="M12,3 L13,11 L21,12 L13,13 L12,21 L11,13 L3,12 L11,11 Z" fill="#cfe0ff" />
                </svg>
              </span>
              <span class="mline__idx">{`M-0${i + 1}`}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ======================================================================
         OWNERSHIP — the compass rose.
    ====================================================================== -->
    <section class="band band--rose" id="ownership" aria-labelledby="h-rose">
      <div class="wrap">
        <p class="eyebrow">Bearings</p>
        <h2 id="h-rose">Four directions this app will never travel in</h2>

        <div class="rose">
          <div class="rose__core">
            <svg viewBox="0 0 300 300" aria-hidden="true">
              <circle cx="150" cy="150" r="142" fill="#070a20" stroke="#2c3878" stroke-width="1.2" />
              <circle cx="150" cy="150" r="112" fill="none" stroke="#2c3878" stroke-width="0.9" opacity="0.6" />
              <g stroke="#5f74d8" opacity="0.6">
                {Array.from({ length: 48 }, (_, i) => {
                  const t = (i * 7.5 * Math.PI) / 180;
                  const long = i % 6 === 0;
                  return (
                    <line
                      x1={R(150 + Math.cos(t) * 142)} y1={R(150 + Math.sin(t) * 142)}
                      x2={R(150 + Math.cos(t) * (142 - (long ? 14 : 6)))} y2={R(150 + Math.sin(t) * (142 - (long ? 14 : 6)))}
                      stroke-width={long ? 1.6 : 0.8}
                    />
                  );
                })}
              </g>
              <path d="M150,30 L166,150 L150,270 L134,150 Z" fill="#1b2560" stroke="#5f74d8" stroke-width="1" />
              <path d="M30,150 L150,134 L270,150 L150,166 Z" fill="#141c46" stroke="#5f74d8" stroke-width="1" />
              <path d="M150,30 L158,150 L150,270 L142,150 Z" fill="#cfe0ff" opacity="0.55" />
              <circle cx="150" cy="150" r="34" fill="#0b1030" stroke="#5f74d8" stroke-width="1.2" />
            </svg>
            <span class="rose__stat">
              <b>{sFree.value}</b>
              <small>{sFree.label}</small>
            </span>
          </div>

          {OWNERSHIP.map((o, i) => (
            <div class={`rose__pt rose__pt--${i}`}>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </div>
          ))}
        </div>

        <p class="caveat">
          <b>One honest exception.</b> {FAQS[3].a}
        </p>
      </div>
    </section>

    <!-- ======================================================================
         FAQ — the observatory log.
    ====================================================================== -->
    <section class="band band--log" id="faq" aria-labelledby="h-log">
      <div class="wrap wrap--narrow">
        <p class="eyebrow">Log book</p>
        <h2 id="h-log">Questions from the floor</h2>
        <div class="log">
          {FAQS.map((f, i) => (
            <details class="entry" open={i === 0}>
              <summary>
                <span class="entry__idx">{`Q-0${i + 1}`}</span>
                <span class="entry__q">{f.q}</span>
                <span class="entry__mk" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================================================================
         CLOSE — the lights come up.
    ====================================================================== -->
    <section class="band band--close" aria-labelledby="h-close">
      <svg class="close__art" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#dfe8ff">
          {SKY_L.slice(120, 300).map((s) => (
            <circle cx={R((s.x / 1600) * 1200)} cy={R((s.y / 880) * 200)} r={R(s.r * 0.8)} opacity={R(s.o * 0.7)} />
          ))}
        </g>
        <path d="M-20,216 C 300,182 470,172 600,172 C 730,172 900,182 1220,216 L1220,300 L-20,300 Z" fill="#070920" />
        <path d="M-20,216 C 300,182 470,172 600,172 C 730,172 900,182 1220,216" fill="none" stroke="#3b4a92" stroke-width="1.4" opacity="0.6" />
        <g fill="#03040f">
          {SEATS_L.slice(0, 12).map((x) => {
            const px = R((x / 1600) * 1200);
            const k = Math.abs(px + 20 - 600) / 700;
            const y = R(242 + k * k * 34);
            return <path d={`M${px},${y + 60} L${px},${R(y + 10)} Q ${R(px + 34)},${R(y - 6)} ${R(px + 68)},${R(y + 10)} L${R(px + 68)},${y + 60} Z`} />;
          })}
        </g>
      </svg>

      <div class="close__plate">
        <h2 id="h-close">The doors are open. Bring your own sky.</h2>
        <p>
          {NAME} is free forever and open source under GPL-3.0, for iPhone and
          iPad running iOS or iPadOS 17 or later.
        </p>
        <div class="actions">
          {APP_STORE_URL ? (
            <a class="store" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store is-pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="ghost" href={GITHUB_URL}>Read the source</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot__in">
        <span class="lockup">
          <Mark size={22} decorative />
          <span class="wordmark">{NAME}</span>
        </span>
        <p>{FEATURES[0].title}. Free forever, open source under GPL-3.0.</p>
        <a href={GITHUB_URL}>github.com/thatcube/Mozz</a>
      </div>
    </footer>
  </main>
</Layout>
<style>
  /* ====================================================================
     CONSTELLATION — a listening planetarium.
     Palette is the inside of a dome at night: navy structure, warm brass
     instruments, one red for the radio sweep and one green for downloads.
  ==================================================================== */
  .cn {
    --void: #05061a;
    --dome-0: #0b1030;
    --dome-1: #141c46;
    --rim: #2c3878;
    --rim-hi: #5f74d8;
    --ink: #eef1ff;
    --body: #b9c1e0;
    --muted: #8189ad;
    --star: #dfe8ff;
    --gold: #f0c46a;
    --green: #7ce0b6;
    --red: #ff4062;
    --red-hi: #ff6a84;

    --display: 'Clash Display', 'Zodiak', Georgia, serif;
    --text: 'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace;

    background: var(--void);
    color: var(--body);
    font-family: var(--text);
    overflow-x: hidden;
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .wrap {
    width: min(1160px, 100% - 3rem);
    margin-inline: auto;
  }
  .wrap--narrow { width: min(760px, 100% - 3rem); }

  .cn h1,
  .cn h2,
  .cn h3 {
    font-family: var(--display);
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .cn p { margin: 0; }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  /* ------------------------------------------------------------ SVG type */
  .cn text { font-family: var(--text); }
  .hud {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    fill: #8fa8ff;
  }
  .hud--red { fill: #ff8ea3; }
  .hud--green { fill: var(--green); }
  .con-name {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.02em;
    fill: #cfdcff;
  }
  .con-name--fresh { fill: #ffd3dc; }
  .con-tag {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    fill: #ff9db2;
  }
  .mini {
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: 0.12em;
    fill: #8fa8ff;
  }

  /* ==================================================================== HERO */
  .hero {
    position: relative;
    min-height: calc(100svh - 34px);
    display: flex;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--rim);
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .sky--port { display: none; }

  .hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(1rem, 3vh, 2rem);
    padding: clamp(1rem, 2.6vh, 1.9rem) 0 0;
  }

  /* --------------------------------------------------------- dome plaque */
  .dome-head {
    width: min(1240px, 100% - 3rem);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .plaque {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rim);
    border-radius: 999px;
    padding: 0.34rem 0.8rem;
    background: rgba(7, 10, 32, 0.6);
  }
  .plaque__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(124, 224, 182, 0.16);
  }

  /* ------------------------------------------------- the projection plate */
  .plate {
    position: relative;
    z-index: 3;
    justify-self: center;
    align-self: center;
    width: min(41rem, 100% - 3rem);
    padding: clamp(1.4rem, 3vw, 2.4rem);
    background: rgba(8, 11, 34, 0.66);
    backdrop-filter: blur(12px) saturate(1.25);
    -webkit-backdrop-filter: blur(12px) saturate(1.25);
    border: 1px solid rgba(95, 116, 216, 0.34);
    border-radius: 4px;
    box-shadow:
      inset 0 0 0 1px rgba(207, 224, 255, 0.06),
      0 40px 90px -40px rgba(0, 0, 0, 0.9);
  }
  .plate__frame {
    position: absolute;
    inset: -9px;
    width: calc(100% + 18px);
    height: calc(100% + 18px);
    pointer-events: none;
  }

  .plate h1 {
    font-size: clamp(1.95rem, 4.1vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lede {
    margin-top: 1rem;
    font-size: clamp(0.95rem, 1.1vw, 1.06rem);
    line-height: 1.6;
    color: var(--body);
    max-width: 34rem;
  }

  .actions {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.62rem 1.15rem;
    border-radius: 10px;
    background: linear-gradient(180deg, #d6002b, #a80022);
    color: #fff;
    text-decoration: none;
    border: 1px solid #ff5f7c;
    box-shadow: 0 10px 30px -14px rgba(255, 64, 98, 0.8);
  }
  .store svg { width: 22px; height: 22px; fill: currentColor; flex: none; }
  .store span {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    font-weight: 600;
    font-size: 1rem;
  }
  .store small {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
    font-weight: 500;
  }
  .store.is-pending {
    background: rgba(15, 20, 56, 0.8);
    border-color: var(--rim);
    color: var(--body);
    box-shadow: none;
    cursor: default;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.66rem 1.05rem;
    border-radius: 10px;
    border: 1px solid var(--rim);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.94rem;
    background: rgba(11, 16, 48, 0.55);
  }
  .ghost:hover { border-color: var(--rim-hi); }

  .readout {
    margin: 1.4rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgba(95, 116, 216, 0.28);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .readout b {
    color: #8fa8ff;
    font-weight: 500;
    margin-right: 0.45rem;
  }

  /* ------------------------------------------------------------- console */
  .console {
    position: relative;
    z-index: 1;
    padding-top: 0.5rem;
  }
  .console__deck {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: clamp(90px, 15vh, 150px);
    z-index: -1;
  }
  .console__inner {
    position: relative;
    width: min(1240px, 100% - 3rem);
    margin-inline: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1rem, 4vw, 3.5rem);
    padding-bottom: clamp(1rem, 3vh, 2.2rem);
  }

  .rig {
    display: flex;
    align-items: flex-end;
    gap: clamp(1.2rem, 5vw, 4.5rem);
  }

  .proj {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .proj__beam {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 6px);
    transform: translateX(-50%);
    width: min(27vw, 340px);
    height: min(50vh, 500px);
    pointer-events: none;
    z-index: -1;
  }
  .proj__beam svg { width: 100%; height: 100%; display: block; }

  .proj__head {
    position: relative;
    display: block;
    width: clamp(74px, 8.5vw, 120px);
  }
  .proj__head > svg { width: 100%; height: auto; display: block; }
  .proj__logo {
    position: absolute;
    left: 50%;
    top: 56%;
    transform: translate(-50%, -50%);
    display: block;
    line-height: 0;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7));
  }
  .proj__name {
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------------------------------------------------------------- dock */
  .dock {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex: none;
  }
  .dock__fall {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 22px);
    transform: translateX(-50%);
    width: min(20vw, 190px);
    height: min(38vh, 340px);
    pointer-events: none;
    z-index: -1;
  }
  .dock__fall svg { width: 100%; height: 100%; display: block; }
  .dock__phone {
    width: clamp(74px, 8vw, 104px);
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 32px rgba(0, 0, 0, 0.75));
  }
  .dock__label {
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
  }

  /* ============================================================== BANDS */
  .band {
    position: relative;
    padding: clamp(3.5rem, 9vh, 7rem) 0;
    border-bottom: 1px solid rgba(44, 56, 120, 0.55);
  }
  .band--servers { background: linear-gradient(180deg, #05061a, #080c26); }
  .band--chart,
  .band--offline,
  .band--close { padding: 0; border-bottom: 1px solid rgba(44, 56, 120, 0.55); }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .band h2 {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.08;
    max-width: 22ch;
    text-wrap: balance;
  }
  .band__lede {
    margin-top: 1rem;
    max-width: 46ch;
    line-height: 1.65;
    font-size: 1.02rem;
  }

  /* ------------------------------------------------------ servers / rail */
  .rail {
    position: relative;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }
  .rail__art {
    display: block;
    width: 100%;
    height: clamp(240px, 38vh, 420px);
  }
  .heads {
    position: relative;
    width: min(1160px, 100% - 3rem);
    margin: -1.5rem auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .head {
    padding-top: 1.1rem;
    border-top: 1px solid var(--rim);
    display: grid;
    gap: 0.45rem;
    justify-items: start;
  }
  .head__idx {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .head__logo { line-height: 0; display: block; }
  .head h3 { font-size: 1.14rem; }
  .head p {
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--body);
    max-width: 26ch;
  }

  /* ------------------------------------------------------- chart section */
  .chart {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(420px, 62vh, 640px);
  }
  .chart__plot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .chart__legend {
    position: relative;
    width: min(1160px, 100% - 3rem);
    margin-inline: auto;
    max-width: min(38rem, 100% - 3rem);
    margin-left: max(calc(50% - 580px), 1.5rem);
    padding: clamp(1.3rem, 2.4vw, 2rem);
    background: rgba(6, 9, 28, 0.76);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(95, 116, 216, 0.3);
    border-radius: 4px;
    display: grid;
    gap: 0.9rem;
  }
  .chart__legend p { line-height: 1.62; }
  .legend__stat {
    margin: 0.3rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(95, 116, 216, 0.28);
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .legend__stat dt {
    font-family: var(--display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
  }
  .legend__stat dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* --------------------------------------------------------- duo layouts */
  .duo {
    width: min(1160px, 100% - 3rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 4.5rem);
  }
  .duo--flip .duo__art { order: -1; }
  .duo__text { display: grid; gap: 1rem; }
  .duo__text p { line-height: 1.65; max-width: 46ch; }
  .dial,
  .newcon {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.6));
  }

  /* --------------------------------------------------------- offline band */
  .fall {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(460px, 68vh, 700px);
  }
  .fall__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fall__text {
    position: relative;
    width: min(1160px, 100% - 3rem);
    margin-inline: auto;
    max-width: 38rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    padding: clamp(1.3rem, 2.4vw, 2rem);
    background: rgba(6, 9, 28, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(95, 116, 216, 0.3);
    border-radius: 4px;
    display: grid;
    gap: 0.9rem;
  }
  .fall__text p { line-height: 1.65; }

  /* --------------------------------------------------- meridian catalogue */
  .meridian {
    margin: clamp(2rem, 5vh, 3.2rem) 0 0;
    padding: 0 0 0 clamp(1.6rem, 4vw, 3rem);
    list-style: none;
    position: relative;
  }
  .meridian::before {
    content: '';
    position: absolute;
    left: clamp(0.45rem, 1.2vw, 0.9rem);
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--rim) 8%, var(--rim) 92%, transparent);
  }
  .mline {
    position: relative;
    padding: 1.4rem 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 2.4rem);
    row-gap: 0.4rem;
    border-bottom: 1px solid rgba(44, 56, 120, 0.4);
  }
  .mline:last-child { border-bottom: 0; }
  .mline__node {
    position: absolute;
    left: calc(-1 * clamp(1.6rem, 4vw, 3rem) + clamp(0.45rem, 1.2vw, 0.9rem) - 9px);
    top: 1.7rem;
    width: 18px;
    height: 18px;
    display: block;
    background: var(--void);
    border-radius: 50%;
  }
  .mline__node svg { width: 100%; height: 100%; display: block; }
  .mline__idx {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    grid-row: 1 / span 2;
    padding-top: 0.3rem;
  }
  .mline h3 { font-size: 1.22rem; }
  .mline p {
    line-height: 1.62;
    max-width: 56ch;
    color: var(--body);
  }

  /* ------------------------------------------------------- compass rose */
  .rose {
    margin-top: clamp(2rem, 5vh, 3.4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.6rem);
  }
  .rose__core {
    position: relative;
    grid-column: 2;
    grid-row: 1 / span 2;
    width: clamp(180px, 22vw, 300px);
  }
  .rose__core svg { width: 100%; height: auto; display: block; }
  .rose__stat {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.2rem;
  }
  .rose__stat b {
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    color: var(--gold);
    line-height: 1;
  }
  .rose__stat small {
    font-family: var(--mono);
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    max-width: 9ch;
    margin-inline: auto;
    line-height: 1.3;
  }
  .rose__pt { display: grid; gap: 0.4rem; }
  .rose__pt h3 { font-size: 1.14rem; }
  .rose__pt p { line-height: 1.6; font-size: 0.95rem; }
  .rose__pt--0 { grid-column: 1; grid-row: 1; text-align: right; justify-items: end; }
  .rose__pt--1 { grid-column: 3; grid-row: 1; }
  .rose__pt--2 { grid-column: 1; grid-row: 2; text-align: right; justify-items: end; }
  .rose__pt--3 { grid-column: 3; grid-row: 2; }
  .rose__pt--0 p, .rose__pt--2 p { max-width: 32ch; }
  .rose__pt--1 p, .rose__pt--3 p { max-width: 32ch; }

  .caveat {
    margin-top: clamp(2rem, 5vh, 3rem);
    padding: 1.1rem 1.3rem;
    border: 1px dashed rgba(95, 116, 216, 0.4);
    border-radius: 4px;
    font-size: 0.93rem;
    line-height: 1.62;
    color: var(--body);
    max-width: 70ch;
  }
  .caveat b { color: var(--ink); }

  /* ------------------------------------------------------------- log book */
  .log {
    margin-top: clamp(1.6rem, 4vh, 2.4rem);
    border-top: 1px solid rgba(44, 56, 120, 0.6);
  }
  .entry { border-bottom: 1px solid rgba(44, 56, 120, 0.6); }
  .entry summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0;
    cursor: pointer;
    list-style: none;
  }
  .entry summary::-webkit-details-marker { display: none; }
  .entry__idx {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    flex: none;
  }
  .entry__q {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.06rem;
    color: var(--ink);
    flex: 1;
  }
  .entry__mk {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .entry__mk::before,
  .entry__mk::after {
    content: '';
    position: absolute;
    background: var(--rim-hi);
    inset-inline: 0;
    top: 6px;
    height: 2px;
  }
  .entry__mk::after { transform: rotate(90deg); transition: transform 0.2s ease; }
  .entry[open] .entry__mk::after { transform: rotate(0deg); }
  .entry > p {
    padding: 0 0 1.15rem calc(0.64rem * 4 + 1rem);
    line-height: 1.65;
    max-width: 64ch;
    color: var(--body);
  }

  /* ----------------------------------------------------------- close band */
  .band--close { position: relative; display: grid; min-height: clamp(420px, 60vh, 600px); align-items: center; }
  .close__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .close__plate {
    position: relative;
    width: min(46rem, 100% - 3rem);
    margin-inline: auto;
    text-align: center;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    background: rgba(6, 9, 28, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(95, 116, 216, 0.3);
    border-radius: 4px;
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .close__plate h2 { max-width: 18ch; }
  .close__plate p { line-height: 1.65; max-width: 48ch; }
  .close__plate .actions { justify-content: center; margin-top: 0.4rem; }

  /* ---------------------------------------------------------------- foot */
  .foot { padding: 2.2rem 0 3rem; }
  .foot__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .foot a { color: var(--body); text-decoration: none; border-bottom: 1px solid var(--rim); }
  .foot a:hover { color: var(--ink); border-color: var(--rim-hi); }

  /* ---------------------------------------------------------- focus ring */
  .cn a:focus-visible,
  .cn summary:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ============================================================ MOTION */
  @keyframes cn-tw {
    0%, 100% { opacity: 0.22; }
    50% { opacity: 1; }
  }
  .tw {
    animation: cn-tw 4.6s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes cn-vu {
    0%, 100% { transform: scaleY(0.35); }
    30% { transform: scaleY(1); }
    55% { transform: scaleY(0.55); }
    78% { transform: scaleY(0.85); }
  }
  .vu {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: cn-vu 1.7s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes cn-azimuth {
    from { transform: rotate(-52deg); }
    to { transform: rotate(52deg); }
  }
  .sky--land .azimuth__arm {
    transform-box: view-box;
    transform-origin: 800px 1000px;
    animation: cn-azimuth 26s ease-in-out infinite alternate;
  }
  .sky--port .azimuth__arm {
    transform-box: view-box;
    transform-origin: 400px 1400px;
    animation: cn-azimuth 26s ease-in-out infinite alternate;
  }

  @keyframes cn-dial {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .dial__arm {
    transform-box: view-box;
    transform-origin: 260px 260px;
    animation: cn-dial 22s linear infinite;
  }

  @keyframes cn-ink {
    0% { stroke-dashoffset: 1000; }
    45% { stroke-dashoffset: 0; }
    92% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 1000; }
  }
  .con-ink {
    stroke-dasharray: 1000;
    animation: cn-ink 14s ease-in-out infinite;
  }

  @keyframes cn-fall {
    0% { stroke-dasharray: 0 1 60 900; stroke-dashoffset: 0; opacity: 0; }
    8% { opacity: 1; }
    70% { opacity: 1; }
    100% { stroke-dasharray: 0 1 60 900; stroke-dashoffset: -520; opacity: 0; }
  }
  .trail {
    animation: cn-fall 5.2s linear infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes cn-meteor {
    0% { stroke-dashoffset: 340; opacity: 0; }
    12% { opacity: 0.6; }
    60% { opacity: 0; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  .mt {
    stroke-dasharray: 44 340;
    animation: cn-meteor 9s linear infinite;
    animation-delay: var(--d, 0s);
  }

  /* ========================================================== RESPONSIVE */
  @media (max-width: 1100px) {
    .plate { width: min(38rem, 100% - 2.5rem); }
    .chart__legend { margin-left: 1.5rem; }
  }

  @media (max-width: 900px) {
    .sky--land { display: none; }
    .sky--port { display: block; }
    .hero__inner { gap: 1.4rem; padding-top: 1.2rem; }
    .plate { margin-block: 1rem; }
    .heads { grid-template-columns: 1fr; margin-top: 0; gap: 0; }
    .head { padding: 1.1rem 0; }
    .duo,
    .duo--flip { grid-template-columns: 1fr; gap: 2rem; }
    .duo--flip .duo__art { order: 0; }
    .duo__art { max-width: 420px; }
    .rose {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      justify-items: start;
      gap: 1.6rem;
    }
    .rose__core { grid-column: 1; grid-row: auto; margin-inline: auto; }
    .rose__pt,
    .rose__pt--0,
    .rose__pt--1,
