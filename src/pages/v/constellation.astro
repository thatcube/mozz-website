---
/**
 * VARIANT — CONSTELLATION
 *
 * THESIS: the page is the inside of a listening planetarium. You are sitting in
 *   the auditorium. Overhead, the dome is your own music library: every record
 *   you own is a star, and the ones you actually listen to have been joined up
 *   into named constellations. Three projectors on the console throw the sky —
 *   and the projectors are Plex, Jellyfin and Navidrome, because the sky is only
 *   ever made of files you already own.
 *
 * THE FOUR PRODUCT IDEAS, DRAWN AS OBSERVATORY INSTRUMENTS:
 *   servers   → three projection heads on the console, beams rising into the dome
 *   radio     → an azimuth line sweeping the sky from the console pivot
 *   mixes     → a constellation drawn fresh this week, still being inked in
 *   downloads → meteor trails falling out of the sky into the visitor's phone
 *
 * IMMERSIVE HERO: one full-bleed inline SVG authored at 1600×1000 and sliced to
 *   cover, with a companion portrait recomposition at 800×1400 for narrow
 *   screens. The headline is not floated over the art — it is the projection
 *   plate the beams land on, sitting inside the console's own optical path.
 *
 * CRAFT DEFENCE against gradient-slop: the dome is real drawn architecture —
 *   latitude rings and meridian seams converging on the zenith, panel rivets, a
 *   ribbed cornice at the springline and rows of seat backs cut by the bottom
 *   edge. Stars are authored geometry (cores, halos, spikes), album covers are
 *   little drawn sleeves with their own artwork, and every constellation is a
 *   real polyline through real nodes. Gradients appear only where the scene is
 *   literally light: beams, glows and the depth of the dome.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Your library is the sky. Mozz is how you play it.';

// Stats, woven into the prose of the section each one belongs to.
const sSearch = STATS[0];  // 16ms — search across 100,000 tracks
const sStart = STATS[1];   // 75ms — from tap to first note
const sServers = STATS[2]; // 3 — compatible server families
const sFree = STATS[3];    // $0 — forever, and open source

const R = (n: number) => Math.round(n * 10) / 10;

/** Deterministic PRNG, so the sky is identical on every build. */
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/* ---------------------------------------------------------------- star field
   Density is biased toward the zenith (a squared distribution on y) so the sky
   thins out as it approaches the springline, the way a real dome does. */
function field(seed: number, w: number, h: number, count: number, bleed: number) {
  const r = mulberry32(seed);
  return Array.from({ length: count }, () => {
    const yr = r();
    return {
      x: R(-bleed + r() * (w + bleed * 2)),
      y: R(-bleed + yr * yr * (h + bleed)),
      r: R(0.45 + r() * r() * 2.5),
      o: R(0.18 + r() * 0.72),
      tw: r() > 0.88,
      d: R(r() * 6),
    };
  });
}

const SKY_L = field(0xa17c0de, 1600, 880, 340, 140);
const SKY_P = field(0x51e11a2, 800, 1240, 230, 90);

/** The handful of naked-eye brights, drawn with four-point diffraction spikes. */
const BRIGHTS_L = [
  { x: 250, y: 116, s: 15 }, { x: 705, y: 62, s: 12 }, { x: 1148, y: 96, s: 17 },
  { x: 470, y: 372, s: 11 }, { x: 1462, y: 330, s: 13 }, { x: 92, y: 250, s: 10 },
  { x: 905, y: 296, s: 12 }, { x: 1330, y: 470, s: 10 },
];
const BRIGHTS_P = [
  { x: 150, y: 150, s: 13 }, { x: 610, y: 240, s: 15 },
  { x: 360, y: 520, s: 11 }, { x: 690, y: 720, s: 12 }, { x: 96, y: 830, s: 10 },
];

/* ------------------------------------------------------------- album sleeves
   Stars big enough to resolve turn out to be records. Each sleeve is drawn in a
   unit box from -8 to 8 and scaled, so the artwork stays hand-authored rather
   than a texture. */
const SLEEVE_ART: Record<string, string> = {
  ridge: 'M-8,3 L-3,-3 L0,0.6 L3.4,-4.6 L8,2 L8,8 L-8,8 Z',
  wedge: 'M-8,-8 L-0.6,-8 L8,8 L0.6,8 Z',
  bars: 'M-8,-2.6 h16 v2.2 h-16 Z M-8,2.4 h11 v2.2 h-11 Z M-8,-7 h6.5 v2 h-6.5 Z',
  orb: 'M0,-4.8 A4.8,4.8 0 1,1 -0.01,-4.8 Z',
  peak: 'M-8,8 L-1.2,-6 L8,8 Z',
  quad: 'M-8,-8 h7.4 v7.4 h-7.4 Z M0.6,0.6 h7.4 v7.4 h-7.4 Z',
  arc: 'M-8,7 A9.4,9.4 0 0,1 8,7 L8,8 L-8,8 Z M-4.2,-1.4 A4.6,4.6 0 0,1 4.2,-1.4 L4.2,-0.2 L-4.2,-0.2 Z',
};

interface Sleeve { x: number; y: number; s: number; rot: number; base: string; ink: string; art: string }

const SLEEVES_L: Sleeve[] = [
  { x: 560, y: 150, s: 30, rot: -7, base: '#2b3a72', ink: '#8fb6ff', art: 'ridge' },
  { x: 760, y: 140, s: 24, rot: 6, base: '#3a2a5c', ink: '#c79bf0', art: 'wedge' },
  { x: 1050, y: 124, s: 27, rot: -4, base: '#123c4c', ink: '#6fd7ee', art: 'arc' },
  { x: 330, y: 300, s: 34, rot: 9, base: '#4a1c2c', ink: '#ff8ea3', art: 'orb' },
  { x: 560, y: 262, s: 21, rot: -11, base: '#25304f', ink: '#9fb2e8', art: 'bars' },
  { x: 1160, y: 300, s: 26, rot: 5, base: '#3c3416', ink: '#f0c46a', art: 'peak' },
  { x: 1420, y: 280, s: 23, rot: -8, base: '#1d3b34', ink: '#71dfba', art: 'quad' },
  { x: 200, y: 430, s: 25, rot: 12, base: '#33224a', ink: '#b795ee', art: 'ridge' },
  { x: 1215, y: 440, s: 29, rot: -6, base: '#142b4e', ink: '#7fb0ff', art: 'wedge' },
  { x: 1400, y: 500, s: 20, rot: 8, base: '#3f1f28', ink: '#ff9db2', art: 'bars' },
  { x: 700, y: 270, s: 19, rot: -5, base: '#1b3348', ink: '#79c4e8', art: 'orb' },
  { x: 126, y: 530, s: 22, rot: -13, base: '#2c2338', ink: '#a99ae0', art: 'peak' },
];

const SLEEVES_P: Sleeve[] = [
  { x: 214, y: 214, s: 30, rot: -8, base: '#2b3a72', ink: '#8fb6ff', art: 'ridge' },
  { x: 470, y: 168, s: 24, rot: 7, base: '#3a2a5c', ink: '#c79bf0', art: 'wedge' },
  { x: 640, y: 400, s: 27, rot: -5, base: '#123c4c', ink: '#6fd7ee', art: 'arc' },
  { x: 168, y: 470, s: 31, rot: 10, base: '#4a1c2c', ink: '#ff8ea3', art: 'orb' },
  { x: 420, y: 640, s: 23, rot: -9, base: '#3c3416', ink: '#f0c46a', art: 'peak' },
  { x: 640, y: 830, s: 25, rot: 6, base: '#142b4e', ink: '#7fb0ff', art: 'quad' },
  { x: 150, y: 790, s: 21, rot: -12, base: '#1d3b34', ink: '#71dfba', art: 'bars' },
];

/* ------------------------------------------------------------- constellations
   Named for what a library actually contains — a long player, a queue that does
   not gap, the deep cuts. Never for an artist, because no artist has endorsed
   anything here. */
interface Con {
  name: string;
  pts: [number, number][];
  label: [number, number];
  anchor?: 'start' | 'middle' | 'end';
  fresh?: boolean;
  tag?: string;
}

const CONS_L: Con[] = [
  {
    name: 'The Gapless Queue',
    pts: [[560, 150], [660, 128], [760, 140], [858, 118], [956, 142], [1050, 124]],
    label: [805, 96],
    anchor: 'middle',
  },
  {
    name: 'The Long Player',
    pts: [[330, 300], [412, 246], [482, 302], [560, 262], [630, 316], [700, 270]],
    label: [272, 350],
  },
  {
    name: 'Deep Cuts',
    pts: [[1078, 250], [1160, 300], [1250, 262], [1332, 322], [1420, 280], [1510, 336]],
    label: [1180, 214],
  },
  {
    name: 'Late Rotation',
    pts: [[112, 470], [200, 430], [268, 486], [206, 552], [126, 530], [112, 470]],
    label: [104, 590],
  },
  {
    name: 'This Week’s Mix',
    pts: [[1215, 440], [1300, 396], [1400, 434], [1436, 520], [1352, 566], [1258, 528], [1215, 440]],
    label: [1206, 610],
    fresh: true,
    tag: 'drawn this week',
  },
];

const CONS_P: Con[] = [
  {
    name: 'The Gapless Queue',
    pts: [[120, 250], [214, 214], [310, 246], [400, 200], [478, 244]],
    label: [116, 296],
  },
  {
    name: 'The Long Player',
    pts: [[110, 470], [168, 470], [250, 528], [340, 486], [416, 548]],
    label: [106, 596],
  },
  {
    name: 'This Week’s Mix',
    pts: [[520, 760], [612, 716], [700, 772], [676, 866], [576, 878], [520, 760]],
    label: [512, 920],
    anchor: 'start',
    fresh: true,
    tag: 'drawn this week',
  },
];

/** Dome latitude rings, as seen from a seat: circles squashed into ellipses. */
const RINGS_L = [150, 268, 396, 534, 682, 840, 1010, 1195, 1390];
const RINGS_P = [130, 236, 352, 478, 614, 760, 918, 1090];

/** Dome meridian seams, radiating from the zenith to the springline. */
const MERIDIANS = Array.from({ length: 24 }, (_, i) => i * 15);

/** The seat backs at the very bottom — the auditorium you are sitting in. */
const SEATS_L = Array.from({ length: 15 }, (_, i) => R(-40 + i * 118));
const SEATS_P = Array.from({ length: 9 }, (_, i) => R(-30 + i * 100));

/* ------------------------------------------------- catalogue density plot
   The "hundred thousand tracks" section: a dot cloud with real falloff, not a
   blurred smear. */
const PLOT = (() => {
  const r = mulberry32(0x0ca7a106);
  return Array.from({ length: 620 }, () => {
    const a = r() * Math.PI * 2;
    const rad = Math.sqrt(r());
    return {
      x: R(600 + Math.cos(a) * rad * 560),
      y: R(170 + Math.sin(a) * rad * 148),
      r: R(0.6 + r() * r() * 2.2),
      o: R(0.16 + r() * 0.7),
    };
  });
})();

const heroLabel =
  'The inside of a planetarium dome. Meridian seams and latitude rings converge on the zenith overhead. The whole dome is a star field in which the larger stars resolve into small album sleeves, joined by drawn lines into named constellations — The Gapless Queue, The Long Player, Deep Cuts, Late Rotation, and This Week’s Mix, which is still being inked in. Three projectors on a console at the front of the auditorium throw broad beams of light up into the sky, and a long azimuth line sweeps slowly across the dome from the console. Meteor trails fall out of the sky into a phone resting in the console dock. Rows of seat backs are cut by the bottom edge of the frame.';
---

<Layout
  title={`${NAME} — your library is the sky`}
  description="A free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Navidrome server you already run and play everything you own — streamed or downloaded, with no account and nothing tracking you."
  themeColor="#070a1c"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=general-sans@400,500,600,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="cn">
    <VariantBar slug="constellation" tone="neutral" />

    <!-- Shared paint servers. Kept out of any one scene so the sections that
         reuse the sky's light (halos, constellation ink) resolve at every
         breakpoint, including when one of the two hero skies is hidden. -->
    <svg class="defs" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="cn-dome" cx="0.5" cy="0.14" r="0.92">
          <stop offset="0" stop-color="#1a2352" />
          <stop offset="0.42" stop-color="#101641" />
          <stop offset="0.74" stop-color="#090c28" />
          <stop offset="1" stop-color="#05061a" />
        </radialGradient>
        <radialGradient id="cn-pocket" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#03040f" stop-opacity="0.78" />
          <stop offset="0.62" stop-color="#03040f" stop-opacity="0.42" />
          <stop offset="1" stop-color="#03040f" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="cn-halo" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#cfe0ff" stop-opacity="0.62" />
          <stop offset="1" stop-color="#cfe0ff" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="cn-warm" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#ff5a78" stop-opacity="0.5" />
          <stop offset="1" stop-color="#ff5a78" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="cn-sweep" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#ff4062" stop-opacity="0.42" />
          <stop offset="0.55" stop-color="#ff4062" stop-opacity="0.14" />
          <stop offset="1" stop-color="#ff4062" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="cn-conline" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#7fa8ff" stop-opacity="0.15" />
          <stop offset="0.5" stop-color="#a9c8ff" stop-opacity="0.72" />
          <stop offset="1" stop-color="#7fa8ff" stop-opacity="0.15" />
        </linearGradient>
        <linearGradient id="cn-freshline" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff7a92" stop-opacity="0.5" />
          <stop offset="0.5" stop-color="#ffd3dc" stop-opacity="0.95" />
          <stop offset="1" stop-color="#ff7a92" stop-opacity="0.5" />
        </linearGradient>
      </defs>
    </svg>

    <!-- ======================================================================
         HERO — the auditorium. Sky above, console below, headline riding the
         projection plate in the middle of the optical path.
    ====================================================================== -->
    <header class="hero">
      <!-- LANDSCAPE SKY ------------------------------------------------- -->
      <svg
        class="sky sky--land"
        viewBox="0 0 1600 1000"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-label={heroLabel}
      >
        <!-- dome interior -->
        <rect x="-200" y="-200" width="2000" height="1400" fill="url(#cn-dome)" />

        <!-- latitude rings: the dome's own geometry, seen from a seat -->
        <g class="dome-grid" fill="none" stroke="#8fa8ff">
          {RINGS_L.map((r, i) => (
            <ellipse
              cx="800" cy="150" rx={r} ry={R(r * 0.62)}
              stroke-width={i % 3 === 0 ? 1.5 : 0.8}
              opacity={i % 3 === 0 ? 0.11 : 0.06}
            />
          ))}
        </g>

        <!-- meridian seams, with panel rivets down the structural ones -->
        <g class="dome-grid" stroke="#8fa8ff" fill="none">
          {MERIDIANS.map((deg, i) => {
            const t = (deg * Math.PI) / 180;
            const x2 = R(800 + Math.cos(t) * 1500);
            const y2 = R(150 + Math.sin(t) * 0.62 * 1500);
            return (
              <line
                x1="800" y1="150" x2={x2} y2={y2}
                stroke-width={i % 3 === 0 ? 1.4 : 0.7}
                opacity={i % 3 === 0 ? 0.1 : 0.05}
              />
            );
          })}
        </g>
        <g fill="#9fb6ff" opacity="0.16">
          {MERIDIANS.filter((_, i) => i % 3 === 0).map((deg) =>
            RINGS_L.slice(0, 6).map((r) => {
              const t = (deg * Math.PI) / 180;
              return (
                <circle
                  cx={R(800 + Math.cos(t) * r)}
                  cy={R(150 + Math.sin(t) * 0.62 * r)}
                  r="1.5"
                />
              );
            })
          )}
        </g>

        <!-- the star field -->
        <g class="stars" fill="#dfe8ff">
          {SKY_L.map((s) => (
            <circle
              cx={s.x} cy={s.y} r={s.r} opacity={s.o}
              class={s.tw ? 'tw' : undefined}
              style={s.tw ? `--d:${s.d}s` : undefined}
            />
          ))}
        </g>

        <!-- the brights: halo, core, and four drawn spikes -->
        <g class="brights">
          {BRIGHTS_L.map((b) => (
            <g>
              <circle cx={b.x} cy={b.y} r={b.s * 2.4} fill="url(#cn-halo)" opacity="0.5" />
              <path
                d={`M${b.x},${b.y - b.s} L${R(b.x + b.s * 0.14)},${b.y} L${b.x},${b.y + b.s} L${R(b.x - b.s * 0.14)},${b.y} Z
                    M${b.x - b.s},${b.y} L${b.x},${R(b.y - b.s * 0.14)} L${b.x + b.s},${b.y} L${b.x},${R(b.y + b.s * 0.14)} Z`}
                fill="#eaf1ff" opacity="0.85"
              />
              <circle cx={b.x} cy={b.y} r="2.1" fill="#ffffff" />
            </g>
          ))}
        </g>

        <!-- constellations: real polylines through real nodes -->
        <g class="cons">
          {CONS_L.map((c) => (
            <g class={c.fresh ? 'con con--fresh' : 'con'}>
              <polyline
                points={c.pts.map((p) => p.join(',')).join(' ')}
                fill="none"
                stroke={c.fresh ? 'url(#cn-freshline)' : 'url(#cn-conline)'}
                stroke-width={c.fresh ? 2.4 : 1.6}
                stroke-linecap="round"
                stroke-linejoin="round"
                class={c.fresh ? 'con-ink' : undefined}
              />
              {c.pts.map((p) => (
                <g>
                  <circle cx={p[0]} cy={p[1]} r="7" fill="url(#cn-halo)" opacity="0.55" />
                  <circle cx={p[0]} cy={p[1]} r="2.6" fill="#f2f6ff" />
                </g>
              ))}
              <text
                x={c.label[0]} y={c.label[1]}
                text-anchor={c.anchor ?? 'start'}
                class={c.fresh ? 'con-name con-name--fresh' : 'con-name'}
              >{c.name}</text>
              {c.tag && (
                <text x={c.label[0]} y={c.label[1] + 22} text-anchor={c.anchor ?? 'start'} class="con-tag">
                  ✦ {c.tag}
                </text>
              )}
            </g>
          ))}
        </g>

        <!-- album sleeves: the stars you can resolve turn out to be records -->
        <g class="sleeves">
          {SLEEVES_L.map((s) => (
            <g transform={`translate(${s.x} ${s.y}) rotate(${s.rot}) scale(${R(s.s / 16)})`}>
              <circle cx="0" cy="0" r="15" fill="url(#cn-halo)" opacity="0.5" />
              <rect x="-8" y="-8" width="16" height="16" rx="1.4" fill={s.base} />
              <path d={SLEEVE_ART[s.art]} fill={s.ink} opacity="0.92" />
              <rect
                x="-8" y="-8" width="16" height="16" rx="1.4"
                fill="none" stroke="#dce6ff" stroke-width="0.7" opacity="0.55"
              />
              <rect x="-8" y="-8" width="16" height="4.4" fill="#ffffff" opacity="0.08" />
            </g>
          ))}
        </g>

        <!-- NOW PLAYING reticle: one sleeve is currently on the transport -->
        <g class="reticle" transform="translate(330 300)">
          <circle r="46" fill="none" stroke="#ff8ea3" stroke-width="1.2" opacity="0.7" />
          <circle r="58" fill="none" stroke="#ff8ea3" stroke-width="0.7" opacity="0.35" stroke-dasharray="5 9" />
          <g stroke="#ff8ea3" stroke-width="1.4" opacity="0.8">
            <line x1="-58" y1="0" x2="-40" y2="0" /><line x1="40" y1="0" x2="58" y2="0" />
            <line x1="0" y1="-58" x2="0" y2="-40" /><line x1="0" y1="40" x2="0" y2="58" />
          </g>
          <g transform="translate(-70 -60)">
            <text class="hud" x="0" y="0" text-anchor="end">NOW PLAYING</text>
            <g transform="translate(-21 12)" fill="#ff9db2">
              <rect class="vu" style="--d:0s"    x="0"  y="-8" width="2.6" height="16" rx="1.2" />
              <rect class="vu" style="--d:-0.4s" x="5"  y="-8" width="2.6" height="16" rx="1.2" />
              <rect class="vu" style="--d:-0.8s" x="10" y="-8" width="2.6" height="16" rx="1.2" />
              <rect class="vu" style="--d:-1.2s" x="15" y="-8" width="2.6" height="16" rx="1.2" />
            </g>
          </g>
        </g>

        <!-- RADIO: the azimuth line, pivoting from the console -->
        <g class="azimuth">
          <g class="azimuth__arc" fill="none" stroke="#ff4062" opacity="0.28">
            <path d="M180,1000 A620,620 0 0 1 1420,1000" stroke-width="1.2" />
            {Array.from({ length: 25 }, (_, i) => {
              const deg = 180 + i * 7.5;
              const t = (deg * Math.PI) / 180;
              const long = i % 4 === 0;
              return (
                <line
                  x1={R(800 + Math.cos(t) * 620)} y1={R(1000 + Math.sin(t) * 620)}
                  x2={R(800 + Math.cos(t) * (620 - (long ? 22 : 11)))} y2={R(1000 + Math.sin(t) * (620 - (long ? 22 : 11)))}
                  stroke-width={long ? 1.8 : 1}
                />
              );
            })}
          </g>
          <g class="azimuth__arm">
            <path d="M800,1000 L672,236 L928,236 Z" fill="url(#cn-sweep)" />
            <line x1="800" y1="1000" x2="800" y2="230" stroke="#ff6a84" stroke-width="1.6" opacity="0.7" />
            <circle cx="800" cy="236" r="5" fill="#ff9db2" />
            <circle cx="800" cy="236" r="16" fill="url(#cn-warm)" />
          </g>
          <text class="hud hud--red" x="1180" y="700">RADIO · AZIMUTH SWEEP</text>
          <line x1="1176" y1="690" x2="1010" y2="656" stroke="#ff4062" stroke-width="0.9" opacity="0.4" stroke-dasharray="4 6" />
        </g>

        <!-- a few long meteors, independent of the dock stream -->
        <g class="meteors" stroke-linecap="round" fill="none">
          <path class="mt" style="--d:0s" d="M300,120 Q 430,240 520,392" stroke="#bcd6ff" stroke-width="2" opacity="0.5" />
          <path class="mt" style="--d:2.6s" d="M1500,140 Q 1420,270 1382,404" stroke="#bcd6ff" stroke-width="1.6" opacity="0.4" />
          <path class="mt" style="--d:4.4s" d="M980,60 Q 1050,190 1096,320" stroke="#bcd6ff" stroke-width="1.4" opacity="0.35" />
