---
/**
 * VARIANT — DIORAMA
 * See the design contract in the HTML comment at the top of <main>.
 *
 * Illustration-led. Every object is hand-authored isometric SVG, composed from a
 * single true-axonometric projection (makeScene → P). A shared non-scaling stroke
 * keeps one line weight everywhere; boxes carry one hard value step per face
 * (top light → left mid → right dark). Detail primitives — screws, seams, vents,
 * cylinders — let each scene get dense the way the reference drawings are dense.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const R6 = Math.PI / 6;
const IC = Math.cos(R6);
const IS = Math.sin(R6);
const r2 = (n: number) => Math.round(n * 100) / 100;

type Part = { d: string; fill: string; cls?: string };
type Txt = { tr: string; s: string; size: number; cls: string; anchor: string; base: string };

function makeScene() {
  let minX = 1e9, minY = 1e9, maxX = -1e9, maxY = -1e9;
  const parts: Part[] = [];
  const texts: Txt[] = [];

  const proj = (x: number, y: number, z: number): [number, number] => {
    const sx = (x - y) * IC;
    const sy = (x + y) * IS - z;
    if (sx < minX) minX = sx; if (sx > maxX) maxX = sx;
    if (sy < minY) minY = sy; if (sy > maxY) maxY = sy;
    return [sx, sy];
  };
  const P = (x: number, y: number, z: number) => {
    const [sx, sy] = proj(x, y, z);
    return `${r2(sx)} ${r2(sy)}`;
  };
  const path = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${P(p[0], p[1], p[2])}`).join('') + 'Z';
  const poly = (pts: number[][], fill: string, cls?: string) => parts.push({ d: path(pts), fill, cls });

  // cuboid, three shaded faces
  const box = (x: number, y: number, z: number, w: number, d: number, h: number,
    c: { top: string; left: string; right: string }, cls?: string) => {
    poly([[x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]], c.top, cls);
    poly([[x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]], c.left, cls);
    poly([[x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]], c.right, cls);
  };
  // horizontal panel on a plane z
  const quad = (x: number, y: number, w: number, d: number, z: number, fill: string, cls?: string) =>
    poly([[x, y, z], [x + w, y, z], [x + w, y + d, z], [x, y + d, z]], fill, cls);
  // vertical rectangle on plane x=const (a right-facing face)
  const faceX = (x: number, y0: number, y1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x, y0, z0], [x, y1, z0], [x, y1, z1], [x, y0, z1]], fill, cls);
  // vertical rectangle on plane y=const (a left-facing face)
  const faceY = (y: number, x0: number, x1: number, z0: number, z1: number, fill: string, cls?: string) =>
    poly([[x0, y, z0], [x1, y, z0], [x1, y, z1], [x0, y, z1]], fill, cls);

  const ring = (cx: number, cy: number, z: number, r: number, fill: string, cls?: string, n = 48) => {
    let d = '';
    for (let i = 0; i <= n; i++) { const a = (i / n) * Math.PI * 2; d += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z); }
    parts.push({ d: d + 'Z', fill, cls });
  };

  // the stylised diffraction disc — a fan of hard flat wedges
  const fan = (cx: number, cy: number, z: number, r: number, palette: string[], seg = 32, spin = 0) => {
    const c = P(cx, cy, z);
    for (let i = 0; i < seg; i++) {
      const a0 = spin + (i / seg) * Math.PI * 2, a1 = spin + ((i + 1) / seg) * Math.PI * 2;
      const pa = P(cx + r * Math.cos(a0), cy + r * Math.sin(a0), z);
      const pb = P(cx + r * Math.cos(a1), cy + r * Math.sin(a1), z);
      parts.push({ d: `M${c}L${pa}L${pb}Z`, fill: palette[i % palette.length], cls: 'flat' });
    }
    ring(cx, cy, z, r, 'none', 'edge');
    ring(cx, cy, z, r * 0.30, '#f7ede0', 'edge');
    ring(cx, cy, z, r * 0.18, 'rgba(0,0,0,0.06)', 'flat');
    ring(cx, cy, z, r * 0.11, 'var(--hole)', 'edge');
  };

  const line = (a: number[], b: number[], cls = 'guide') =>
    parts.push({ d: `M${P(a[0], a[1], a[2])}L${P(b[0], b[1], b[2])}`, fill: 'none', cls });

  // a panel seam: a groove plus a highlight offset along one axis
  const seam = (a: number[], b: number[], dir: 'z' | 'x' | 'y' = 'z', off = 0.5) => {
    line(a, b, 'seam-d');
    const o = dir === 'z' ? [0, 0, off] : dir === 'x' ? [off, 0, 0] : [0, off, 0];
    line([a[0] + o[0], a[1] + o[1], a[2] + o[2]], [b[0] + o[0], b[1] + o[1], b[2] + o[2]], 'seam-l');
  };

  // countersunk screw on a plane at height z
  const screw = (cx: number, cy: number, z: number, r = 1.1) => {
    ring(cx, cy, z, r, 'rgba(0,0,0,0.10)', 'flat', 12);
    ring(cx, cy, z, r, 'none', 'screw', 12);
    line([cx - r * 0.6, cy - r * 0.6, z], [cx + r * 0.6, cy + r * 0.6, z], 'screw');
  };

  // upright cylinder (mug, can, hinge) with a light top and mid body
  const cyl = (cx: number, cy: number, z: number, r: number, h: number, cTop: string, cBody: string, cls?: string) => {
    const aL = 3 * Math.PI / 4, aR = -Math.PI / 4, step = Math.PI / 20;
    let d = 'M' + P(cx + r * Math.cos(aL), cy + r * Math.sin(aL), z + h);
    for (let a = aL; a >= aR - 1e-6; a -= step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h);
    d += 'L' + P(cx + r * Math.cos(aR), cy + r * Math.sin(aR), z);
    for (let a = aR; a <= aL + 1e-6; a += step) d += 'L' + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z);
    parts.push({ d: d + 'Z', fill: cBody, cls });
    let t = '';
    for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; t += (i ? 'L' : 'M') + P(cx + r * Math.cos(a), cy + r * Math.sin(a), z + h); }
    parts.push({ d: t + 'Z', fill: cTop, cls });
  };

  const raw = (d: string, fill: string, cls?: string) => parts.push({ d, fill, cls });

  // Legend printed flat on a face: text is skewed into that face's isometric
  // plane via a matrix, so it lies on the surface and never reads as floating.
  //   plane 'top'  → lies on a horizontal (z=const) face, reads toward +x
  //   plane 'topL' → horizontal face, reads toward +y (lower-left)
  //   plane 'left' → vertical y=const face (faces lower-left), upright
  //   plane 'right'→ vertical x=const face (faces lower-right), upright
  const text = (x: number, y: number, z: number, s: string, size: number,
    cls = 'legend', plane: 'top' | 'topL' | 'left' | 'right' = 'top',
    anchor = 'middle', base = 'auto') => {
    const [sx, sy] = proj(x, y, z);
    let a = IC, b = IS, c = -IC, d = IS;
    if (plane === 'topL') { a = -IC; b = IS; c = IC; d = IS; }
    else if (plane === 'left') { a = IC; b = IS; c = 0; d = 1; }
    else if (plane === 'right') { a = -IC; b = IS; c = 0; d = 1; }
    const tr = `matrix(${r2(a)} ${r2(b)} ${r2(c)} ${r2(d)} ${r2(sx)} ${r2(sy)})`;
    texts.push({ tr, s, size, cls, anchor, base });
  };

  const vb = (pad = 6) => `${r2(minX - pad)} ${r2(minY - pad)} ${r2(maxX - minX + pad * 2)} ${r2(maxY - minY + pad * 2)}`;

  return { parts, texts, poly, box, quad, faceX, faceY, ring, fan, line, seam, screw, cyl, raw, text, vb, P, bounds: () => ({ minX, minY, maxX, maxY }) };
}

/* ── flat palettes (small, disciplined) ───────────────────────────────────── */
const SLATE  = { top: '#2f5a57', left: '#234643', right: '#1a3230' };
const SLATE2 = { top: '#274c49', left: '#1d3c39', right: '#152b29' };
const CREAMB = { top: '#fbf3e5', left: '#ecdec7', right: '#dccbad' };
const ORANGE = { top: '#ef7d47', left: '#d5622f', right: '#b64f24' };
const STEEL  = { top: '#4a7cb0', left: '#335f8f', right: '#264970' };
const STEEL2 = { top: '#5b8cc0', left: '#3f6f9e', right: '#2f567f' };
const STEELB = { top: '#4f83c4', left: '#3b6ea5', right: '#2c5480' };  // hero CD player body — blue, to read distinct from the teal walkman
const STEELD = { top: '#3b6ea5', left: '#2c5480', right: '#204066' };  // hero lid / darker blue
const TEAL   = { top: '#41938c', left: '#2f716b', right: '#215048' };
const WHITEB = { top: '#f5efe4', left: '#e3dbcb', right: '#d3c8b3' };
const DARKB  = { top: '#34333c', left: '#26252d', right: '#191820' };
const DARK2  = { top: '#2a2932', left: '#201f27', right: '#14131a' };
const GOLDB  = { top: '#e7b45c', left: '#cf9a42', right: '#b17f31' };
const REDB   = { top: '#d6002b', left: '#ad0021', right: '#800016' };
const WOOD   = { top: '#e7d3ad', left: '#d0b98d', right: '#b89f72' };
const WOOD2  = { top: '#dcc59b', left: '#c3aa7d', right: '#a98f64' };
const METAL  = { top: '#cdd2d8', left: '#b1b7bf', right: '#969da7' };
const PAPER  = { top: '#f3ead6', left: '#e2d6bd', right: '#cebf9f' };
// opaque MiniDisc cartridge shells (closed — no disc showing), one per label
const SH_JAZZ = { top: '#6bbcae', left: '#4f9d90', right: '#3c7c72' };
const SH_RARE = { top: '#6f9fd0', left: '#4f7fb0', right: '#3c6390' };
const SH_MIX  = { top: '#e7a9b0', left: '#cf8a92', right: '#b06d76' };

const FAN_WARM  = ['#e9b25a', '#e8703a', '#f3e2c4', '#d98f34', '#f0d49a', '#e57d3f', '#c99a45'];
const FAN_COOL  = ['#49a08d', '#3b6ea5', '#e79bb0', '#63b39c', '#8fb2d8', '#cfd9a6', '#4f96b3'];
const FAN_RED   = ['#c80028', '#e8703a', '#f3e2c4', '#a30220', '#e0a94e', '#d6486a'];
const FAN_SILV  = ['#c6ccd4', '#9aa4b0', '#e7ebef', '#aeb7c2', '#dfe4ea', '#8b96a4'];
const FAN_SEPIA = ['#c98b4e', '#9c6233', '#e7c79a', '#b5793f', '#dcb583', '#8a5a30'];

/* helpers used inside scenes */
const grid = (s: any, x0: number, x1: number, y0: number, y1: number, stepX: number, stepY: number, z = 0) => {
  for (let y = y0; y <= y1 + 1e-6; y += stepY) s.line([x0, y, z], [x1, y, z]);
  for (let x = x0; x <= x1 + 1e-6; x += stepX) s.line([x, y0, z], [x, y1, z]);
};
// light comes from the upper-right, so every cast shadow is a flat, hard-edged
// footprint pushed down and slightly left — one --shadow tone, no blur, no ramp.
const LSX = 1.0, LSY = 1.8;
// offset magnitude scales with object size (clamped) so the light *direction*
// stays fixed but big objects push their footprint far enough to show a sliver.
const lmag = (size: number) => Math.min(Math.max(size * 0.05, 1.2), 3.5);
const shadow = (s: any, cx: number, cy: number, r: number, ry = 1) => {
  const m = lmag(r);
  let d = '';
  for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; d += (i ? 'L' : 'M') + s.P(cx + LSX * m + r * Math.cos(a), cy + LSY * m + r * ry * Math.sin(a), -0.2); }
  s.raw(d + 'Z', 'var(--shadow)', 'flat');
};
// flat parallelogram footprint that traces a boxy object's base (x,y,w,d) on plane z
const foot = (s: any, x: number, y: number, w: number, d: number, z = -0.18) => {
  const m = lmag(Math.max(w, d));
  return s.quad(x + LSX * m, y + LSY * m, w, d, z, 'var(--shadow)', 'flat');
};
const vents = (s: any, plane: 'x' | 'y', c: number, a0: number, a1: number, z0: number, z1: number, n: number) => {
  for (let i = 0; i < n; i++) {
    const z = z0 + ((i + 0.5) / n) * (z1 - z0);
    if (plane === 'y') s.line([a0, c, z], [a1, c, z], 'vent');
    else s.line([c, a0, z], [c, a1, z], 'vent');
  }
};

/* ══ HERO — a full, open portable CD player on a busy desk ═══════════════════ */
const hero = makeScene();
{
  const s = hero;
  grid(s, -26, 118, -30, 96, 16, 12);

  foot(s, 0, 0, 68, 56);                             // player base
  foot(s, 4, -44, 64, 38);                           // open lid, folded flat behind
  foot(s, 80, 2, 20, 20); foot(s, 102, 4, 20, 20);   // two floppies
  foot(s, 100, 26, 24, 20);                          // open jewel case
  foot(s, 96, 56, 21, 18);                           // stack of CD cases
  foot(s, 96, 78, 12, 10);                           // juice carton
  foot(s, 4, 74, 26, 20);                            // notebook
  shadow(s, 30, 78, 8);                              // coffee mug (round)
  shadow(s, 113, 75, 8, 0.7);                        // coiled earbuds (round)

  // open lid, folded flat behind the base
  s.box(4, -44, 0, 64, 38, 3, STEELD);
  s.quad(10, -39, 52, 28, 3, '#12314d', 'flat');
  s.ring(34, -25, 3.1, 11, '#0e2438', 'edge'); s.ring(34, -25, 3.1, 3, '#3b6ea5', 'edge');
  s.text(34, -13, 3.2, 'COMPACT DISC · DIGITAL AUDIO', 1.7, 'legend-tick', 'top', 'middle', 'central');
  s.screw(9, -41, 3); s.screw(63, -41, 3); s.screw(9, -8, 3); s.screw(63, -8, 3);
  // hinge barrels
  s.cyl(10, -3, 2, 2.2, 4, '#5f88b8', '#2c5480'); s.cyl(58, -3, 2, 2.2, 4, '#5f88b8', '#2c5480');

  // base body
  s.box(0, 0, 0, 68, 56, 9, STEELB);
  s.seam([0, 0, 4.5], [68, 0, 4.5], 'z', 0.6);
  s.seam([68, 0, 4.5], [68, 56, 4.5], 'z', 0.6);
  // feet
  for (const [fx, fy] of [[3, 3], [63, 3], [3, 51], [63, 51]]) s.box(fx, fy, -1.4, 3, 3, 1.4, DARK2);

  // round top-load disc well + spindle + the warm diffraction fan
  s.quad(4, 5, 42, 46, 8.6, '#123049', 'flat');
  s.ring(25, 28, 8.55, 21, '#0e2438', 'edge');
  s.fan(25, 28, 8.6, 20, FAN_WARM, 34, 0.15);
  s.cyl(25, 28, 8.6, 1.7, 1.3, '#e7ecf2', '#9aa6b6');

  // cream control panel (raised)
  s.box(49, 5, 7.4, 16, 46, 2.2, CREAMB);
  s.screw(51, 7, 9.6); s.screw(63, 7, 9.6); s.screw(51, 49, 9.6); s.screw(63, 49, 9.6);
  // LCD — three readouts laid out flat inside the panel, along the +y axis
  s.box(51, 8, 9.6, 12, 12, 0.8, { top: '#173a33', left: '#12302a', right: '#0d211d' });
  s.text(52, 10.6, 10.42, 'TRACK 06', 1.9, 'lcd', 'top', 'start', 'central');
  s.text(52, 14, 10.42, '03:42', 2.7, 'lcd', 'top', 'start', 'central');
  s.text(52, 17.4, 10.42, 'REM 47:18', 1.6, 'lcd', 'top', 'start', 'central');
  // buttons in a grid, each with a lighter cap
  const btn = (bx: number, by: number) => {
    s.box(bx, by, 9.6, 5, 5, 1.3, { top: '#f0e2cb', left: '#dccbad', right: '#cbb894' });
    s.quad(bx + 0.8, by + 0.8, 3.4, 3.4, 10.9, '#fbf3e5', 'flat');
  };
  btn(51, 25); btn(58, 25);
  btn(51, 32); btn(58, 32);
  s.box(52.5, 40, 9.6, 8, 8, 1.6, REDB);
  s.text(56.5, 44, 11.3, 'OPEN', 1.9, 'legend-lite', 'top', 'middle', 'central');
  s.text(57, 22.3, 9.62, 'MODE', 1.4, 'legend-tick', 'top', 'middle', 'central');
  // headphone jack on the side
  s.ring(65.4, 30, 4, 1.4, '#14131a', 'edge', 14);

  // ── incidental desk objects ──
  // two floppies, WIN95
  const floppy = (fx: number, fy: number, c: any, l1: string, l2: string) => {
    s.box(fx, fy, 0, 20, 20, 1.6, c);
    s.quad(fx + 3, fy + 8, 14, 9.5, 1.6, '#f6f1ea', 'flat');      // label
    s.line([fx + 3, fy + 11, 1.61], [fx + 17, fy + 11, 1.61], 'faint');
    s.line([fx + 3, fy + 13.5, 1.61], [fx + 17, fy + 13.5, 1.61], 'faint');
    s.text(fx + 10, fy + 12, 1.62, l1, 2.2, 'legend-lite', 'top', 'middle', 'central');
    s.box(fx + 5.5, fy - 0.0, 1.6, 9, 5, 0.5, METAL);            // shutter
    s.box(fx + 15.5, fy + 1.5, 0.4, 2.2, 2.2, 1.2, DARK2);       // write-protect tab
  };
  floppy(80, 2, WHITEB, 'WIN95', '');
  floppy(102, 4, ORANGE, 'MIX 2', '');

  // open jewel case with a disc + booklet
  s.box(100, 26, 0, 24, 20, 1, DARK2);
  s.quad(102, 28, 20, 16, 1, '#1b1a22', 'flat');
  s.fan(112, 36, 1.05, 8, FAN_SILV, 22, 0.6);
  s.box(122, 26, 0, 2, 20, 7, DARK2);                            // upright lid
  s.faceX(124, 26, 46, 0, 7, '#20202a', 'flat');

  // stack of three CD cases
  for (let i = 0; i < 3; i++) s.box(96 + i * 0.6, 56 - i * 0.6, i * 1.4, 20, 17, 1.3, i % 2 ? STEEL2 : DARKB);
  s.text(107, 63, 4.15, 'B-SIDES', 1.7, 'legend-tick', 'top', 'middle', 'central');

  // coffee mug
  s.cyl(30, 78, 0, 7, 11, '#f0e2cb', '#e8703a');
  s.raw(`M${s.P(37, 74, 8)}Q${s.P(45, 74, 5)} ${s.P(37, 74, 2)}`, 'none', 'handle-mug');
  s.ring(30, 78, 11, 5.2, 'none', 'edge');                       // coffee surface rim
  s.ring(30, 78, 11, 4.2, '#5a3418', 'flat');

  // notebook + a marker pen resting on it (drawn as a body, not a bare stroke)
  s.box(4, 74, 0, 26, 20, 2.2, PAPER);
  s.line([4, 80, 2.21], [30, 80, 2.21], 'faint'); s.line([4, 85, 2.21], [30, 85, 2.21], 'faint'); s.line([4, 90, 2.21], [30, 90, 2.21], 'faint');
  s.box(6, 87, 2.2, 17, 2.6, 2.1, { top: '#4f83c4', left: '#3b6ea5', right: '#2c5480' });   // barrel
  s.box(23, 87, 2.2, 3, 2.6, 2.1, REDB);                                                     // red cap

  // juice carton + straw
  s.box(96, 78, 0, 12, 10, 22, STEEL);
  s.faceY(88, 97, 107, 3, 19, '#5b8cc0', 'flat');
  s.text(102, 88.05, 11, 'JUICE', 2.3, 'legend-lite', 'left', 'middle', 'central');
  s.raw(`M${s.P(104, 81, 22)}L${s.P(108, 79, 34)}`, 'none', 'straw');
  s.raw(`M${s.P(108, 79, 34)}L${s.P(110, 80, 36)}`, 'none', 'straw');

  // wired earbuds — a coiled cable from the jack to the buds, tied off
  let cab = 'M' + s.P(65.4, 30, 4);
  for (let i = 1; i <= 80; i++) {
    const t = i / 80;
    const x = 66 + t * 46 + Math.sin(t * 13) * 5;
    const y = 32 + t * 40 + Math.cos(t * 9) * 7;
    cab += 'L' + s.P(x, y, 0.5);
  }
  s.raw(cab, 'none', 'cable');
  s.box(88, 62, 0.4, 2.4, 2.4, 1.4, DARK2);                      // cable tie
  s.ring(112, 72, 0.6, 2.4, '#1b1a22', 'edge'); s.ring(112, 72, 0.6, 1, '#3b6ea5', 'flat');
  s.ring(118, 78, 0.6, 2.4, '#1b1a22', 'edge'); s.ring(118, 78, 0.6, 1, '#3b6ea5', 'flat');
}

/* ══ SERVERS — a home rack on a desk, cables tying three machines together ═══ */
const shelf = makeScene();
{
  const s = shelf;
  grid(s, -20, 150, -14, 64, 18, 12);

  // desk plank
  foot(s, 0, 0, 138, 42, -0.18);     // plank's own footprint on the ground grid
  s.box(0, 0, 0, 138, 42, 4, WOOD);
  s.seam([0, 0, 2], [138, 0, 2], 'z', 0.5);

  foot(s, 12, 8, 26, 22, 4.03);      // tower
  foot(s, 52, 8, 30, 22, 4.03);      // two-bay NAS
  foot(s, 98, 10, 20, 16, 4.03);     // small box
  foot(s, 120, 24, 16, 10, 4.03);    // switch
  foot(s, 4, 24, 12, 12, 4.03);      // mug
  foot(s, 84, 30, 12, 10, 4.03);     // sticky note
  foot(s, 121, 5, 14, 14, 4.03);     // stack of discs

  // ── machine 1 : tower (detail on the visible right face, plane x=38) ──
