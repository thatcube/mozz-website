        <p>Your collection stays yours, and the map has no route to an ad network.</p>
      </div>
      <ol class="charter-lines" role="list">
        {OWNERSHIP.map((item, index) => (
          <li>
            <span class="seal">{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{item.title}</h3><p>{item.body}</p></div>
          </li>
