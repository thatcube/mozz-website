---
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';

const radio = FEATURES.find((feature) => feature.title.startsWith('Radio'))!;
const offline = FEATURES.find((feature) => feature.title.includes('offline'))!;
const search = FEATURES.find((feature) => feature.title.includes('Search'))!;
const instant = FEATURES.find((feature) => feature.title.includes('Starts'))!;

const trees = [
  [84, 374], [116, 338], [144, 410], [176, 360], [205, 427], [244, 380],
  [320, 506], [363, 472], [420, 532], [514, 457], [549, 498], [610, 438],
  [714, 537], [760, 570], [817, 498], [888, 554], [976, 477], [1034, 516],
  [1107, 438], [1195, 477], [1304, 417], [1392, 466], [1462, 404],
];

const cityBlocks = [
  { x: 1125, y: 332, w: 92, h: 101, c: '#e9875d' },
  { x: 1235, y: 292, w: 70, h: 139, c: '#e4b253' },
  { x: 1325, y: 348, w: 94, h: 92, c: '#5f8f8d' },
  { x: 1090, y: 465, w: 76, h: 78, c: '#e0a25c' },
  { x: 1185, y: 445, w: 108, h: 113, c: '#d96d62' },
  { x: 1315, y: 470, w: 73, h: 83, c: '#6d9d91' },
  { x: 1410, y: 438, w: 86, h: 116, c: '#dda74f' },
];

const stationNotes = [
  'Hill FM · from a favorite track',
  'River Radio · familiar, then further',
  'Night Tower · listening similarity',
];
---

<Layout
  title={`${NAME} — your music has a whole country to cross`}
  description="A free, open source iPhone and iPad music app for your own Plex, Jellyfin and Navidrome library. Radio, weekly mixes and offline downloads, with no account or tracking."
  themeColor="#b9d7d1"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="radioland">
    <VariantBar slug="radioland" tone="cool" />

    <header class="hero" id="top">
      <div class="map-key">
        <Mark size={30} decorative />
        <span><b>{NAME}</b><small>RADIO LAND · LISTENER’S MAP</small></span>
      </div>

      <figure class="hero-map">
        <svg viewBox="0 0 1600 900" role="img" aria-labelledby="map-title map-desc" preserveAspectRatio="xMidYMid slice">
          <title id="map-title">Radio Land, a map of music travelling from a home server to a listening city</title>
          <desc id="map-desc">A high oblique illustrated landscape. Plex, Jellyfin and Navidrome sit on Server Hill. Roads, a river and radio waves carry music to Listening City. A pink weekly mix route winds through neighborhoods, and a red train carrying records continues beyond the coverage boundary for offline listening.</desc>
          <defs>
            <linearGradient id="radio-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#b9d7d1" />
              <stop offset="1" stop-color="#e8e2bd" />
            </linearGradient>
            <linearGradient id="radio-river" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#8ad0ca" />
              <stop offset="1" stop-color="#438f9d" />
            </linearGradient>
            <filter id="soft-shadow" x="-30%" y="-30%" width="160%" height="180%">
              <feDropShadow dx="0" dy="15" stdDeviation="12" flood-color="#173532" flood-opacity=".18" />
            </filter>
            <filter id="tiny-shadow" x="-40%" y="-40%" width="180%" height="200%">
              <feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#173532" flood-opacity=".22" />
            </filter>
            <clipPath id="land-clip">
              <path d="M-40 266 184 162 430 196 634 104 872 178 1077 132 1304 218 1646 148 1668 912-52 918Z" />
            </clipPath>
            <g id="fir-tree">
              <ellipse cx="0" cy="18" rx="17" ry="6" fill="#173532" opacity=".16" />
              <path d="M-3 17h6V-7h-6z" fill="#72513a" />
              <path d="m0-43-18 31h11l-16 26h46L7-12h11Z" fill="#315f4d" stroke="#173532" stroke-width="2" stroke-linejoin="round" />
              <path d="m0-43 0 57h23L7-12h11Z" fill="#234b42" opacity=".7" />
            </g>
            <g id="music-crate">
              <path d="m0 8 29-14 31 15-29 15Z" fill="#f6dfaa" stroke="#173532" stroke-width="2" />
              <path d="m0 8 31 16v20L0 28Z" fill="#d49955" stroke="#173532" stroke-width="2" />
              <path d="m31 24 29-15v20L31 44Z" fill="#b77843" stroke="#173532" stroke-width="2" />
              <path d="m8 3 22-10 22 10M9 16l42 6" fill="none" stroke="#173532" stroke-width="2" />
              <path d="M13-5v15m8-19V14m8-26V17m8-25v29m8-24v27" stroke="#c80028" stroke-width="3" />
            </g>
          </defs>

          <rect width="1600" height="900" fill="url(#radio-sky)" />
          <circle cx="1360" cy="94" r="48" fill="#f6d66d" opacity=".78" />
          <g class="clouds" fill="#f7f1d7" opacity=".74">
            <path d="M68 123c18-31 65-26 74 5 27-20 70 0 63 32H45c-4-18 7-33 23-37Z" />
            <path d="M1086 82c17-23 53-18 61 7 24-18 59 1 55 27h-137c-2-17 7-29 21-34Z" />
            <path d="M1457 173c12-18 41-14 47 6 18-13 46 1 41 22h-106c-2-13 6-23 18-28Z" />
          </g>

          <g class="far-ridges">
            <path d="m0 273 190-112 190 78 224-130 210 102 256-96 250 124 280-91v245H0Z" fill="#6e9875" />
            <path d="m0 290 230-75 178 62 235-102 192 80 239-70 252 105 274-78v183H0Z" fill="#8bae73" />
            <path d="m185 163 29 55-24-9-27 13Zm419-54 34 73-34-15-28 17Zm466 6 29 73-27-13-31 14Zm250 124 26 52-25-10-22 9Z" fill="#f4e8c3" opacity=".9" />
          </g>

          <path d="M-40 266 184 162 430 196 634 104 872 178 1077 132 1304 218 1646 148 1668 912-52 918Z" fill="#aabd69" stroke="#173532" stroke-width="4" />
          <path d="M-50 867 1609 807 1668 912-52 918Z" fill="#7c8f52" />

          <g clip-path="url(#land-clip)">
            <g class="fields" stroke="#79944f" stroke-width="3">
              <path d="M-40 434 174 340l158 79-220 105Z" fill="#c8c875" />
              <path d="m112 524 220-105 177 88-222 110Z" fill="#a4bd62" />
              <path d="m287 617 222-110 170 85-219 111Z" fill="#d3c66c" />
              <path d="m922 254 190-85 159 79-193 93Z" fill="#becb6c" />
              <path d="m1078 341 193-93 174 87-195 95Z" fill="#98b45d" />
              <path d="m1250 430 195-95 198 99-196 96Z" fill="#c7c86a" />
              <path d="m950 607 242-119 195 98-240 118Z" fill="#d2c773" />
              <path d="m1147 704 240-118 223 111-242 119Z" fill="#a3bb63" />
              <path d="M-10 690 158 608l122 61-171 84Z" fill="#8fae5a" />
            </g>
            <g class="crop-lines" fill="none" stroke="#eef0b4" stroke-width="5" opacity=".56">
              <path d="m-13 449 159-70m-113 96 159-70m-109 95 159-70m-97 87 145-65" />
              <path d="m975 633 167-81m-126 109 167-81m-122 109 167-81m-122 108 167-81" />
              <path d="m1277 450 138-67m-102 94 138-67m-98 91 138-67" />
            </g>

            <path d="M681 96c-67 127 30 171 1 281-31 117-156 105-133 236 15 84 116 129 122 308" fill="none" stroke="#d9e7bd" stroke-width="106" stroke-linecap="round" />
            <path d="M681 96c-67 127 30 171 1 281-31 117-156 105-133 236 15 84 116 129 122 308" fill="none" stroke="url(#radio-river)" stroke-width="82" stroke-linecap="round" />
            <path d="M665 108c-42 103 23 158-3 255-24 91-119 109-99 228" fill="none" stroke="#bfebe1" stroke-width="8" stroke-linecap="round" opacity=".7" />

            <g class="roads" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M178 477C402 375 479 397 653 476s277 54 465-18 304-53 503 40" stroke="#f2e1b1" stroke-width="38" />
              <path d="M178 477C402 375 479 397 653 476s277 54 465-18 304-53 503 40" stroke="#665f4a" stroke-width="3" stroke-dasharray="16 18" />
              <path d="M802 142c-13 148 45 229 126 309s122 174 89 326" stroke="#f2e1b1" stroke-width="26" />
              <path d="M802 142c-13 148 45 229 126 309s122 174 89 326" stroke="#665f4a" stroke-width="2" stroke-dasharray="12 16" />
            </g>

            <g class="bridge" filter="url(#tiny-shadow)">
              <path d="m570 448 84 41 58-28-84-42Z" fill="#d69a5d" stroke="#173532" stroke-width="3" />
              <path d="m570 448 84 41v16l-84-41Zm84 41 58-28v16l-58 28Z" fill="#a56542" stroke="#173532" stroke-width="3" />
              <path d="m578 443 84 41m-68-49 84 41m-86-29v27m18-36v27m19-36v27m19-35v26" stroke="#f6e2b0" stroke-width="4" />
            </g>
          </g>

          <g class="world-detail">
            {trees.map(([x, y], index) => (
              <use href="#fir-tree" x={x} y={y} transform={`scale(${index % 3 === 0 ? 1.15 : index % 3 === 1 ? .82 : 1})`} />
            ))}
          </g>

          <g class="server-district" filter="url(#soft-shadow)">
            <ellipse cx="258" cy="371" rx="181" ry="85" fill="#759755" stroke="#173532" stroke-width="4" />
            <ellipse cx="258" cy="344" rx="143" ry="66" fill="#91b25f" stroke="#173532" stroke-width="3" />
            <path d="M173 334 284 280l115 57-112 56Z" fill="#d9c99a" stroke="#173532" stroke-width="3" />
            <path d="m173 334 114 59v80l-114-58Z" fill="#cf8158" stroke="#173532" stroke-width="3" />
            <path d="m287 393 112-56v79l-112 57Z" fill="#a95a49" stroke="#173532" stroke-width="3" />
            <path d="m198 323 82-39 83 41-82 42Z" fill="#f1dfb0" stroke="#173532" stroke-width="3" />
            <path d="m198 323 83 44v47l-83-43Z" fill="#355d55" stroke="#173532" stroke-width="3" />
            <path d="m281 367 82-42v47l-82 42Z" fill="#214940" stroke="#173532" stroke-width="3" />
            <g fill="#d9e96e" stroke="#173532" stroke-width="2">
              <circle cx="219" cy="347" r="5" /><circle cx="235" cy="355" r="5" /><circle cx="251" cy="363" r="5" />
            </g>
            <path d="m312 354 30-15v18l-30 15Z" fill="#172a2a" stroke="#173532" stroke-width="2" />
            <path d="M246 285v-50m-11 3 11-17 11 17m-22 12h22" fill="none" stroke="#173532" stroke-width="5" stroke-linecap="round" />
            <circle cx="246" cy="221" r="7" fill="#c80028" stroke="#173532" stroke-width="3" />

            <g class="source-logos">
              <g transform="translate(134 283)">
                <path d="M-33-17 0-33l35 18L1 2Z" fill="#fff7d6" stroke="#173532" stroke-width="2" />
                <g transform="translate(-10 -27) scale(.72)"><ServerLogo name={SERVERS[0].name} size={28} brand /></g>
              </g>
              <g transform="translate(348 254)">
                <path d="M-33-17 0-33l35 18L1 2Z" fill="#fff7d6" stroke="#173532" stroke-width="2" />
                <g transform="translate(-10 -27) scale(.72)"><ServerLogo name={SERVERS[1].name} size={28} brand /></g>
              </g>
              <g transform="translate(416 331)">
                <path d="M-33-17 0-33l35 18L1 2Z" fill="#fff7d6" stroke="#173532" stroke-width="2" />
                <g transform="translate(-10 -27) scale(.72)"><ServerLogo name={SERVERS[2].name} size={28} brand /></g>
              </g>
            </g>
            <text x="249" y="499" class="map-label" text-anchor="middle">SERVER HILL</text>
            <text x="249" y="519" class="map-note" text-anchor="middle">your library begins here</text>
          </g>

          <g class="broadcast-district">
            <g class="signal signal-one" fill="none" stroke="#fff1bd" stroke-width="5" opacity=".72">
              <ellipse cx="809" cy="297" rx="72" ry="38" />
              <ellipse cx="809" cy="297" rx="125" ry="67" />
              <ellipse cx="809" cy="297" rx="183" ry="99" />
            </g>
            <path d="M808 293 756 472h104Z" fill="#f4d477" stroke="#173532" stroke-width="4" />
            <path d="M808 293 782 472m26-179 26 179M771 420h75m-63-42h51m-39-39h26" fill="none" stroke="#173532" stroke-width="6" />
            <circle cx="808" cy="292" r="11" fill="#c80028" stroke="#173532" stroke-width="4" />
            <path d="m735 475 73-36 77 39-74 37Z" fill="#e3b85c" stroke="#173532" stroke-width="3" />
            <path d="m735 475 76 40v20l-76-39Zm76 40 74-37v20l-74 37Z" fill="#bd7d4c" stroke="#173532" stroke-width="3" />
            <text x="806" y="562" class="map-label" text-anchor="middle">RADIO RIDGE</text>
            <text x="806" y="582" class="map-note" text-anchor="middle">stations from songs you love</text>
          </g>

          <g class="city-district" filter="url(#tiny-shadow)">
            <ellipse cx="1290" cy="512" rx="250" ry="130" fill="#809e65" stroke="#173532" stroke-width="4" />
            {cityBlocks.map((block, index) => (
              <g>
                <path d={`M${block.x} ${block.y}l${block.w / 2} -25 ${block.w / 2} 25 -${block.w / 2} 25Z`} fill="#f3dba3" stroke="#173532" stroke-width="3" />
                <path d={`M${block.x} ${block.y}l${block.w / 2} 25v${block.h}l-${block.w / 2} -25Z`} fill={block.c} stroke="#173532" stroke-width="3" />
                <path d={`M${block.x + block.w / 2} ${block.y + 25}l${block.w / 2} -25v${block.h}l-${block.w / 2} 25Z`} fill={index % 2 ? '#315c55' : '#315f69'} stroke="#173532" stroke-width="3" />
                <g fill="#f5df7c">
                  <rect x={block.x + 12} y={block.y + 27} width="10" height="12" transform={`skewY(26) translate(0 ${index * -1})`} />
                  <rect x={block.x + 31} y={block.y + 37} width="10" height="12" transform={`skewY(26) translate(0 ${index * -1})`} />
                </g>
              </g>
            ))}
            <path d="m1476 382 28-14 30 15-29 15Z" fill="#fff0b9" stroke="#173532" stroke-width="3" />
            <path d="m1476 382 29 16v112l-29-15Z" fill="#c80028" stroke="#173532" stroke-width="3" />
            <path d="m1505 398 29-15v111l-29 16Z" fill="#8b2435" stroke="#173532" stroke-width="3" />
            <g transform="translate(1480 411) scale(.68)"><Mark size={28} decorative /></g>
            <text x="1292" y="681" class="map-label" text-anchor="middle">LISTENING CITY</text>
            <text x="1292" y="701" class="map-note" text-anchor="middle">iPhone + iPad · in your pocket</text>
          </g>

          <g class="mix-route">
            <path d="M306 442C477 340 623 577 796 481s260-16 354 42 195 12 284-70" fill="none" stroke="#fff3c4" stroke-width="19" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M306 442C477 340 623 577 796 481s260-16 354 42 195 12 284-70" fill="none" stroke="#dd315c" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="22 12" />
            <g transform="translate(955 451)" filter="url(#tiny-shadow)">
              <path d="m-73-30 133-2 15 55-134 2Z" fill="#fff1bd" stroke="#173532" stroke-width="3" />
              <text x="0" y="-6" class="route-label" text-anchor="middle">THIS WEEK’S MIX</text>
              <text x="0" y="12" class="route-note" text-anchor="middle">a new way through old streets</text>
            </g>
          </g>

          <g class="boundary">
            <path d="M74 660C318 614 437 674 542 778" fill="none" stroke="#fff3c4" stroke-width="5" stroke-dasharray="14 12" />
            <text x="83" y="641" class="map-note">COVERAGE ENDS</text>
          </g>

          <g class="offline-train" filter="url(#tiny-shadow)">
            <path d="M-30 805 570 653" stroke="#313d36" stroke-width="7" />
            <path d="M-23 825 577 673" stroke="#313d36" stroke-width="7" />
            <path d="m6 807 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19m32-31 17 19" stroke="#655d47" stroke-width="6" />
            <g class="train">
              <path d="m173 695 104-26 57 28-106 27Z" fill="#f4dc9e" stroke="#173532" stroke-width="3" />
              <path d="m173 695 55 29v61l-55-29Z" fill="#c80028" stroke="#173532" stroke-width="3" />
              <path d="m228 724 106-27v61l-106 27Z" fill="#952033" stroke="#173532" stroke-width="3" />
              <path d="m188 718 22 11v18l-22-11Zm58 18 26-7v21l-26 6Zm42-11 26-6v20l-26 7Z" fill="#bce5df" stroke="#173532" stroke-width="2" />
              <circle cx="213" cy="777" r="12" fill="#263b38" stroke="#f2d996" stroke-width="4" />
              <circle cx="291" cy="758" r="12" fill="#263b38" stroke="#f2d996" stroke-width="4" />
              <g transform="translate(232 667) scale(.72)"><use href="#music-crate" /></g>
              <g transform="translate(275 657) scale(.72)"><use href="#music-crate" /></g>
              <text x="151" y="815" class="map-label">OFFLINE LINE</text>
              <text x="151" y="835" class="map-note">records ride past the signal</text>
            </g>
          </g>

          <g class="small-stories">
            <g transform="translate(1012 626)">
              <ellipse cx="0" cy="24" rx="30" ry="9" fill="#173532" opacity=".13" />
              <path d="M-30 13 0-2l31 15L1 29Z" fill="#e46e61" stroke="#173532" stroke-width="2" />
              <circle cx="-5" cy="-16" r="9" fill="#d59a68" stroke="#173532" stroke-width="2" />
              <path d="M-15-8 6 2 4 18-17 8Z" fill="#2f6159" stroke="#173532" stroke-width="2" />
              <path d="M3-19q12-11 20 1M3-18q12 9 20 0" fill="none" stroke="#173532" stroke-width="3" />
              <path d="M34-10q12-12 0-23m0 23q15-4 21-15" fill="none" stroke="#c80028" stroke-width="3" stroke-linecap="round" />
            </g>
            <g transform="translate(445 319)">
              <circle cx="0" cy="0" r="10" fill="#f8ead0" stroke="#173532" stroke-width="2" />
              <circle cx="19" cy="8" r="9" fill="#f8ead0" stroke="#173532" stroke-width="2" />
              <path d="M-4-10v-11m19 20 5-11" stroke="#173532" stroke-width="2" />
            </g>
          </g>
        </svg>
      </figure>

      <div class="hero-sign">
        <span class="sign-route">ROUTE MZ · ALL MUSIC WELCOME</span>
        <h1>{TAGLINE}</h1>
        <p>{SUBLINE} Point {NAME} at the music on your own server, then listen from iPhone or iPad—at home, across town, or beyond the signal.</p>
        <div class="sign-actions">
          {APP_STORE_URL ? (
            <a class="store-link" href={APP_STORE_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Download on the</small>App Store</span>
            </a>
          ) : (
            <span class="store-link pending" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              <span><small>Coming to the</small>App Store</span>
            </span>
          )}
          <a class="source-link" href={GITHUB_URL}>Inspect the source ↗</a>
        </div>
      </div>

      <a class="scout" href="#server-hill"><span>Start at</span> Server Hill <b>↓</b></a>
    </header>

    <section class="atlas-intro" aria-labelledby="atlas-heading">
      <p class="coordinates">FIELD GUIDE · 01 / 04</p>
      <h2 id="atlas-heading">Look closer.<br />Every district does a job.</h2>
      <p>The landscape is not a metaphor pasted on afterward. It is how Mozz works: your server remains the source, the phone carries the catalog, and every road stays open.</p>
    </section>

    <section class="district server-zoom" id="server-hill" aria-labelledby="server-heading">
      <figure class="district-map server-map">
        <svg viewBox="0 0 900 700" role="img" aria-label="A close view of Server Hill, where three branded source buildings feed one river">
          <defs>
            <filter id="zoom-shadow" x="-30%" y="-30%" width="160%" height="180%">
              <feDropShadow dx="0" dy="13" stdDeviation="9" flood-color="#173532" flood-opacity=".22" />
            </filter>
          </defs>
          <rect width="900" height="700" fill="#94b661" />
          <path d="M-80 184 238 29l290 147L918-16v724H-80Z" fill="#b9c76d" />
          <path d="M618-30c-85 147 69 208-20 354-83 137-44 236 37 398" fill="none" stroke="#dbebbd" stroke-width="148" />
          <path d="M618-30c-85 147 69 208-20 354-83 137-44 236 37 398" fill="none" stroke="#56a6ad" stroke-width="112" />
          <g fill="none" stroke="#edf1b1" stroke-width="8" opacity=".65">
            <path d="M-20 544 305 385m-260 197 325-159m-261 197 325-159" />
          </g>
          <ellipse cx="337" cy="313" rx="262" ry="143" fill="#749852" stroke="#173532" stroke-width="5" />
