        <span>Free forever · GPL-3.0 with an App Store Exception</span>
        <a href="#top">Return to the overlook ↑</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .radioland {
    --sky: #b9d7d1;
    --water: #4c9ca7;
    --meadow: #aabd69;
    --meadow-dark: #779852;
    --paper: #fff0bd;
    --road: #f2e1b1;
    --ink: #173532;
    --ink-soft: #496158;
    --route: #da315b;
    --red: #c80028;
    --gold: #edc86a;
    --line: 3px solid var(--ink);
    background: var(--meadow);
    color: var(--ink);
    font-family: 'Atkinson Hyperlegible', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.55;
    overflow: clip;
  }

  .hero {
    position: relative;
    min-height: calc(100svh - 45px);
    height: 900px;
    max-height: 1050px;
    overflow: hidden;
    isolation: isolate;
    background: var(--sky);
    border-bottom: 4px solid var(--ink);
  }

  .hero-map {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .hero-map > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-key {
    position: absolute;
    z-index: 4;
    top: 28px;
    left: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 13px 8px 9px;
    background: rgba(255, 240, 189, .93);
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 rgba(23, 53, 50, .2);
    transform: rotate(-1deg);
  }

  .map-key span {
    display: grid;
    line-height: 1;
  }

  .map-key b {
    font: 800 1.05rem/1 'Bricolage Grotesque', sans-serif;
  }

  .map-key small {
    margin-top: 4px;
    font: 600 .56rem/1 'IBM Plex Mono', monospace;
    letter-spacing: .12em;
  }

  .hero-sign {
    position: absolute;
    z-index: 5;
    top: clamp(88px, 11vh, 132px);
    left: 34%;
    width: min(510px, 35vw);
    padding: 22px 26px 24px;
    background: var(--paper);
    border: 4px solid var(--ink);
    border-radius: 3px;
    box-shadow: 12px 15px 0 rgba(23, 53, 50, .22);
    transform: perspective(700px) rotateX(2deg) rotateZ(-1.5deg);
  }

  .hero-sign::before,
  .hero-sign::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc(100% + 3px);
    width: 12px;
    height: 145px;
    background: #754d37;
    border: 3px solid var(--ink);
  }

  .hero-sign::before { left: 46px; }
  .hero-sign::after { right: 46px; }

  .sign-route,
  .coordinates {
    display: block;
    margin: 0 0 11px;
    color: #785f3f;
    font: 600 .68rem/1.3 'IBM Plex Mono', monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero-sign h1,
  .district-copy h2,
  .atlas-intro h2,
  .charter h2,
  .ranger-copy h2 {
    margin: 0;
    font-family: 'Bricolage Grotesque', ui-sans-serif, sans-serif;
    font-weight: 800;
    font-stretch: condensed;
    letter-spacing: -.055em;
    line-height: .93;
  }

  .hero-sign h1 {
    max-width: 11ch;
    font-size: clamp(2.5rem, 4.3vw, 4.8rem);
  }

  .hero-sign > p {
    max-width: 51ch;
    margin: 16px 0 18px;
    font-size: clamp(.92rem, 1.18vw, 1.08rem);
    line-height: 1.4;
  }

  .sign-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
  }

  .store-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 49px;
    padding: 7px 15px 7px 12px;
    color: #fff8dd;
    background: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 5px;
    box-shadow: 3px 3px 0 rgba(23, 53, 50, .23);
    font: 700 .98rem/1 'Atkinson Hyperlegible', sans-serif;
    text-decoration: none;
    transition: transform .16s ease, box-shadow .16s ease;
  }

  .store-link svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .store-link span { display: grid; }
  .store-link small { font-size: .61rem; font-weight: 500; line-height: 1.2; }
  .store-link.pending { cursor: not-allowed; background: #53665f; color: #eee7c9; }

  .source-link {
    color: var(--ink);
    font: 700 .77rem/1 'IBM Plex Mono', monospace;
    text-underline-offset: 4px;
  }

  .store-link[href]:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 rgba(23, 53, 50, .23);
  }

  a:focus-visible {
    outline: 4px solid #fff;
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--red);
  }

  .scout {
    position: absolute;
    z-index: 5;
    right: 30px;
    bottom: 26px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    color: var(--ink);
    background: rgba(255, 240, 189, .92);
    border: 2px solid var(--ink);
    font: 600 .72rem/1 'IBM Plex Mono', monospace;
    text-decoration: none;
    transform: rotate(1deg);
  }

  .scout span { opacity: .65; }
  .scout b { color: var(--red); font-size: 1rem; }

  .map-label,
  .zoom-label {
    fill: var(--ink);
    font: 700 17px 'IBM Plex Mono', monospace;
    letter-spacing: .12em;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 7px;
    stroke-linejoin: round;
  }

