    <footer class="terminus">
      <div class="terminus-sign">
        <div class="terminus-mark"><Mark size={42} decorative /><span>{NAME}</span></div>
        <p>{TAGLINE}<br /><b>{SUBLINE}</b></p>
        <div class="sign-actions">
