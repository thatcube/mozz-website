---
/**
 * VARIANT — LEDGER
 *
 * Mozz as a printed catalogue index: ruled paper, folios, tabular numbers and
 * an archival reading line. The only moving thing is a red fixed hairline whose
 * bullet and active index row follow the reader through the continuous sheet.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Every record you own, indexed.';
const SUPPORT = 'Mozz is a free player for the music on your own server.';

const INDEX_ROWS = [
  { no: '0001', artist: 'Sable Atlas', title: 'Penumbra Rooms', source: 'Plex', state: 'stream' },
  { no: '0002', artist: 'Low Orchard', title: 'Glasshouse Sunday', source: 'Jellyfin', state: 'downloaded' },
  { no: '0003', artist: 'Mara Vale', title: 'Quarter-inch Weather', source: 'Navidrome', state: 'stream' },
  { no: '0004', artist: 'The Foundry Choir', title: 'Night Receipt', source: 'Plex', state: 'downloaded' },
  { no: '0005', artist: 'Golden Index', title: 'Shelf Register', source: 'Jellyfin', state: 'stream' },
  { no: '0006', artist: 'Aster House', title: 'Private Wing', source: 'Navidrome', state: 'downloaded' },
  { no: '0007', artist: 'North Annex', title: 'Catalog Light', source: 'Plex', state: 'stream' },
  { no: '0008', artist: 'Vera Signal', title: 'Plain Copy', source: 'Jellyfin', state: 'downloaded' },
  { no: '0009', artist: 'Paper Channel', title: 'Third Drawer', source: 'Navidrome', state: 'stream' },
  { no: '0010', artist: 'Rook & Rail', title: 'Platform Ledger', source: 'Plex', state: 'downloaded' },
  { no: '0011', artist: 'Clerk of Waves', title: 'Filed Under Home', source: 'Jellyfin', state: 'stream' },
  { no: '0012', artist: 'The Quiet Archive', title: 'Building Copy', source: 'Navidrome', state: 'downloaded' },
  { no: '0013', artist: 'Mica Register', title: 'Stamped Copy', source: 'Plex', state: 'stream' },
  { no: '0014', artist: 'After Annex', title: 'Dust Jacket', source: 'Jellyfin', state: 'downloaded' },
  { no: '0015', artist: 'Catalog Clerk', title: 'Red Pencil', source: 'Navidrome', state: 'stream' },
  { no: '0016', artist: 'Private Stacks', title: 'Overleaf', source: 'Plex', state: 'downloaded' },
];

const FEATURE_KEYS = ['SRC', 'OFF', 'FTS', 'START', 'RADIO', 'WEEK', 'EQ'];
const TERMS = OWNERSHIP.map((item, index) => ({ ...item, no: `0${index + 1}` }));
---

<Layout
  title={`${NAME} — Every record you own, indexed`}
  description="A free, open source music player for iPhone and iPad. Point Mozz at Plex, Jellyfin or Navidrome, then stream at home or download for anywhere."
  themeColor="#f2efe6"
  noindex
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </Fragment>

  <main class="ledger">
    <VariantBar slug="ledger" tone="cool" />

    <div class="reading-line" aria-hidden="true">
      <span class="reading-line__rule"></span>
      <span class="reading-line__bullet"></span>
    </div>

    <header class="hero sheet" aria-labelledby="ledger-title">
      <div class="hero__topbar">
        <a class="lockup" href="/" aria-label="Mozz home">
          <Mark size={30} decorative />
          <span>{NAME}</span>
        </a>
        <p class="folio-label">Catalogue index / private library</p>
      </div>

      <div class="hero__grid">
        <div class="hero__copy">
          <p class="kicker">Folio 00 / Opening register</p>
          <h1 id="ledger-title">{HEADLINE}</h1>
          <p class="support">{SUPPORT}</p>
          <p class="body-note">
            Point Mozz at the server you already run, then keep the catalogue in
            your pocket. The index treats streams and downloads as equal entries:
            one library, one set of files, one owner.
          </p>
          <div class="actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="index-table" aria-label="Sample music index entries">
          <div class="column-heads" aria-hidden="true">
            <span>No.</span>
            <span>Artist</span>
            <span>Title</span>
            <span>Source</span>
            <span>State</span>
          </div>
          {INDEX_ROWS.map((row) => (
            <div class="index-row" data-index-row>
              <span class="row-no">{row.no}</span>
              <span>{row.artist}</span>
              <span>{row.title}</span>
              <span>{row.source}</span>
              <span>{row.state}</span>
            </div>
          ))}
        </div>
      </div>
    </header>

    <section class="folio sheet" aria-labelledby="ledger-sources">
      <span class="folio-no" aria-hidden="true">01</span>
      <div class="folio__head">
        <p class="kicker">Folio 01</p>
        <h2 id="ledger-sources">Sources</h2>
        <p>Point Mozz at a server you already run. The entries below are not accounts with Mozz; they are doors into your own library.</p>
      </div>
      <div class="server-ledger">
        {SERVERS.map((server, index) => (
          <article class="server-entry" data-index-row>
            <span class="entry-no">0{index + 1}</span>
            <span class="server-mark"><ServerLogo name={server.name} size={34} /></span>
            <div>
              <h3>{server.name}</h3>
              <p>{server.note}</p>
              <small>connect via / existing server / no mozz account</small>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="folio sheet equal" aria-labelledby="ledger-equal">
      <span class="folio-no" aria-hidden="true">02</span>
      <div class="folio__head">
        <p class="kicker">Folio 02</p>
        <h2 id="ledger-equal">Two columns, equal</h2>
        <p>Streaming and offline are not a hierarchy. They occupy the same measure, the same rhythm, and the same weight in the index.</p>
      </div>
      <div class="equal-grid">
        <article data-index-row>
          <p class="column-code">STREAM / A</p>
          <h3>At home over your own network.</h3>
          <ul>
            <li>Browse the catalogue on the server you control.</li>
            <li>Tap a track and play from your own library.</li>
            <li>Queue albums without leaving the house network.</li>
            <li>Use the same interface across every server type.</li>
          </ul>
          <p class="tally"><span>004</span> live rows in the local register</p>
        </article>
        <article data-index-row>
          <p class="column-code">OFFLINE / B</p>
          <h3>Downloaded, plays with nothing.</h3>
          <ul>
            <li>Keep chosen records on the device before you leave.</li>
            <li>Search the catalogue when the server is unreachable.</li>
            <li>Play an album on the train with no signal at all.</li>
            <li>Return home to the same library and same queue logic.</li>
          </ul>
          <p class="tally"><span>004</span> held rows in the pocket register</p>
        </article>
      </div>
    </section>

    <section class="folio sheet instrument" aria-labelledby="ledger-instrument">
      <span class="folio-no" aria-hidden="true">03</span>
      <div class="folio__head">
        <p class="kicker">Folio 03</p>
        <h2 id="ledger-instrument">The instrument</h2>
        <p>The app is a reading room for the index: fast search, immediate playback, weekly routes and a proper equalizer without a paid tier.</p>
      </div>
      <div class="instrument-grid">
        <ol class="feature-ledger" role="list">
          {FEATURES.map((feature, index) => (
            <li data-index-row>
              <span class="feature-key">{FEATURE_KEYS[index]}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <figure class="plate">
          <div class="phone" aria-label="An iPhone running Mozz with a downloaded album ready to play offline" role="img">
            <span class="phone-key key-one"></span>
            <span class="phone-key key-two"></span>
            <div class="phone-screen">
              <div class="island"></div>
              <div class="status"><span>9:41</span><span>▮▮▮ ▱</span></div>
              <div class="app-title"><span>Now Playing</span><b>Your index</b></div>
              <svg class="album-art" viewBox="0 0 100 100" aria-hidden="true">
                <rect width="100" height="100" fill="#f2efe6" />
                <rect x="8" y="8" width="84" height="84" fill="none" stroke="#131313" stroke-width="2" />
                <path d="M0 68 L100 24 L100 100 L0 100 Z" fill="#c80028" />
                <circle cx="35" cy="35" r="19" fill="none" stroke="#131313" stroke-width="3" />
                <path d="M18 78 H84 M18 86 H74" stroke="#f2efe6" stroke-width="3" />
              </svg>
              <div class="track">
                <strong>Filed Under Home</strong>
                <span>The Quiet Archive</span>
              </div>
              <div class="scrub"><i></i></div>
              <div class="times"><span>1:24</span><span>−3:11</span></div>
              <div class="controls"><span>◀</span><b>▶</b><span>▶</span></div>
              <div class="badge">downloaded · plays offline</div>
            </div>
          </div>
          <figcaption>Fig. 03 — plate tipped into the ledger; screen composition drawn in paper, ink and red.</figcaption>
        </figure>
      </div>
    </section>

    <section class="folio sheet measured" aria-labelledby="ledger-measured">
      <span class="folio-no" aria-hidden="true">04</span>
      <div class="folio__head">
        <p class="kicker">Folio 04</p>
        <h2 id="ledger-measured">Measured</h2>
        <p>Four accounting rows, set plainly. The numerals are large because the claims are specific.</p>
      </div>
      <div class="stats-table">
        {STATS.map((stat) => (
          <article data-index-row>
            <span>{stat.label}</span>
            <strong>{stat.value}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="folio sheet terms" aria-labelledby="ledger-terms">
      <span class="folio-no" aria-hidden="true">05</span>
      <div class="folio__head">
        <p class="kicker">Folio 05</p>
        <h2 id="ledger-terms">Terms</h2>
        <p>The ownership argument is written as clauses because that is what it is: the conditions under which your library stays yours. GPL-3.0, plainly stated.</p>
      </div>
      <div class="clauses">
        {TERMS.map((term) => (
          <article data-index-row>
            <span class="clause-mark">■</span>
            <span class="clause-no">{term.no}</span>
            <div>
              <h3>{term.title}</h3>
              <p>{term.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="folio sheet queries" aria-labelledby="ledger-queries">
      <span class="folio-no" aria-hidden="true">06</span>
      <div class="folio__head">
        <p class="kicker">Folio 06</p>
        <h2 id="ledger-queries">Queries</h2>
        <p>Reader questions, filed in the same hand as the rest of the index.</p>
      </div>
      <div class="qa-ledger">
        {FAQS.map((item, index) => (
          <article data-index-row>
            <span class="query-no">Q{index + 1}</span>
            <div>
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer class="colophon sheet">
      <div class="colophon__lockup">
        <Mark size={36} decorative />
        <span>{NAME}</span>
      </div>
      <div class="colophon__copy">
        <h2>{TAGLINE}</h2>
        <p>{SUBLINE}</p>
      </div>
      <div class="actions">
        {APP_STORE_URL ? (
          <a class="store" href={APP_STORE_URL}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
            <span><small>Download on the</small>App Store</span>
          </a>
        ) : (
          <span class="store is-pending" aria-disabled="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
            <span><small>Coming to the</small>App Store</span>
          </span>
        )}
        <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <p class="fineprint">Colophon: {FAQS[3].a}</p>
    </footer>
  </main>
</Layout>

<script>
  const page = document.querySelector('.ledger');
  const rows = Array.from(document.querySelectorAll('[data-index-row]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (page && rows.length) {
    const setRestingState = () => {
      page.style.setProperty('--read-alpha', '.9');
      rows[0]?.classList.add('is-hot');
    };

    if (reduce.matches) {
      setRestingState();
    } else {
      let queued = false;
      const update = () => {
        queued = false;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, window.scrollY / max));
        page.style.setProperty('--read-alpha', `${0.52 + progress * 0.42}`);
        const lineY = window.innerHeight * 0.52;
        let active = rows[0];
        let best = Infinity;
        for (const row of rows) {
          const rect = row.getBoundingClientRect();
          const distance = Math.abs(rect.top + rect.height / 2 - lineY);
          if (distance < best) {
            best = distance;
            active = row;
          }
        }
        rows.forEach((row) => row.classList.toggle('is-hot', row === active));
      };
      const request = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      };
      update();
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
    }
  }
</script>

<style>
  :global(html) {
    background: #f2efe6;
  }

  :global(body) {
    margin: 0;
    color: #131313;
    background: #f2efe6;
    font-family: 'Newsreader', Georgia, serif;
  }

  :global(*:focus-visible) {
    outline: 2px solid #c80028;
    outline-offset: 4px;
  }

  .ledger {
    --paper: #f2efe6;
    --ink: #131313;
    --rule: #cdc7b8;
    --red: #c80028;
    --rhythm: clamp(25px, 2.1vw, 34px);
    --gutter: clamp(1rem, 5vw, 7rem);
    --read-alpha: .68;
    position: relative;
    min-height: 100svh;
    overflow-x: clip;
    background:
      repeating-linear-gradient(0deg, rgba(19,19,19,.018) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(90deg, rgba(19,19,19,.014) 0 1px, transparent 1px 11px),
      var(--paper);
  }

  .sheet {
    position: relative;
    padding-inline: var(--gutter);
    background:
      repeating-linear-gradient(0deg, transparent 0 calc(var(--rhythm) - 1px), var(--rule) calc(var(--rhythm) - 1px) var(--rhythm)),
      linear-gradient(90deg, transparent 0, transparent calc(var(--gutter) - 1px), rgba(205,199,184,.65) calc(var(--gutter) - 1px) var(--gutter), transparent var(--gutter));
  }

  .reading-line {
    position: fixed;
    z-index: 90;
    top: 52svh;
    left: 0;
    width: 100%;
    height: 13px;
    pointer-events: none;
  }

  .reading-line__rule {
    position: absolute;
    top: 6px;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(200, 0, 40, .34);
  }

  .reading-line__bullet {
    position: absolute;
    top: 2px;
    left: clamp(.75rem, 2.3vw, 3rem);
    width: 9px;
    height: 9px;
    background: var(--red);
    opacity: var(--read-alpha);
    transform: translateX(-50%);
  }

  .lockup,
  .colophon__lockup {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    color: var(--ink);
    text-decoration: none;
  }

  .lockup span,
  .colophon__lockup span {
    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .kicker,
  .folio-label,
  .column-heads,
  .row-no,
  .entry-no,
  .feature-key,
  .column-code,
  .tally,
  .clause-no,
  .query-no,
  .fineprint,
  .store small,
  .source-link,
  .server-entry small {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  .kicker,
  .folio-label,
  .column-heads,
  .column-code,
  .server-entry small {
    color: rgba(19,19,19,.62);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .14em;
  }

  .hero {
    min-height: calc(100svh - 42px);
    padding-top: clamp(1.2rem, 2.4vw, 2.5rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .hero__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--rhythm);
    border-bottom: 1px solid var(--rule);
  }

  .column-heads {
    display: grid;
    grid-template-columns: 5.5rem minmax(8rem, 1fr) minmax(10rem, 1.2fr) 8rem 8rem;
    gap: 1rem;
    align-items: end;
    min-height: var(--rhythm);
    border-bottom: 1px solid var(--ink);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(580px, 1.08fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
    padding-top: calc(var(--rhythm) * 1.2);
  }

  .hero__copy .kicker {
    display: block;
    margin-bottom: calc(var(--rhythm) * 1.15);
    line-height: var(--rhythm);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    font-family: 'Newsreader', Georgia, serif;
    font-optical-sizing: auto;
    letter-spacing: -.035em;
  }

  h1 {
    max-width: 11ch;
    margin-bottom: calc(var(--rhythm) * .72);
    font-size: clamp(3.6rem, 6.6vw, 7.8rem);
    font-weight: 500;
    line-height: .88;
  }

  .support {
    max-width: 25ch;
    margin-bottom: calc(var(--rhythm) * .55);
    font-size: clamp(1.35rem, 1.85vw, 2.25rem);
    font-weight: 500;
    line-height: 1.04;
  }

  .body-note,
  .folio__head p,
  .equal-grid li,
  .feature-ledger p,
  .clauses p,
  .qa-ledger p,
  .colophon__copy p {
    color: rgba(19,19,19,.74);
    font-size: clamp(1rem, 1.08vw, 1.16rem);
    line-height: 1.62;
  }

  .body-note {
    max-width: 39ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .8rem 1rem;
    margin-top: calc(var(--rhythm) * .9);
  }

  .store {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    gap: .72rem;
    padding: .45rem 1rem;
    border: 1px solid var(--ink);
    color: var(--paper);
    background: var(--ink);
    text-decoration: none;
  }

  .store svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: currentColor;
  }

  .store span {
    display: grid;
    font-weight: 600;
    line-height: 1.04;
  }

  .store small {
    font-size: .58rem;
    letter-spacing: .08em;
    opacity: .72;
  }

  .store.is-pending {
    border-style: dashed;
    color: rgba(19,19,19,.62);
    background: transparent;
    cursor: default;
  }

  .source-link {
    color: var(--ink);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-underline-offset: .3rem;
  }

  .index-table {
    border-top: 1px solid var(--ink);
