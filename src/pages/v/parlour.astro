---
/**
 * VARIANT — PARLOUR
 * A warm editorial listening room. Cream, burnt orange, dark warm brown, one
 * true-red spark. The extreme display-to-body type ratio is the instrument.
 * See the design contract in the HTML comment at the top of <main>.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import Shot from '../../components/Shot.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, DONATE_URL, APP_STORE_URL,
} from '../../data/site';

/** A small pixel disc, drawn from the mark's own 8-bit language — used as a
    quiet print device beside a rule, never as an eyebrow above a heading. */
const pixDisc = `<svg viewBox="0 0 9 9" width="18" height="18" aria-hidden="true" class="pd">
  <g fill="currentColor">
    <rect x="3" y="0" width="3" height="1"/><rect x="2" y="1" width="5" height="1"/>
    <rect x="1" y="2" width="2" height="1"/><rect x="6" y="2" width="2" height="1"/>
    <rect x="1" y="3" width="1" height="3"/><rect x="7" y="3" width="1" height="3"/>
    <rect x="1" y="6" width="2" height="1"/><rect x="6" y="6" width="2" height="1"/>
    <rect x="2" y="7" width="5" height="1"/><rect x="3" y="8" width="3" height="1"/>
  </g>
  <rect x="4" y="4" width="1" height="1" fill="#f2e9d8"/>
</svg>`;

/** The five screens, framed as printed plates in the adaptive-tint section. */
const PLATES = [
  { name: 'mozz-album-red',   note: 'crimson sleeve' },
  { name: 'mozz-album-warm',  note: 'amber cover' },
  { name: 'mozz-artist',      note: 'sepia portrait' },
  { name: 'mozz-playlist',    note: 'cool silver' },
  { name: 'mozz-album-dark',  note: 'dark maroon' },
];
---

<Layout
  title={`${NAME} — your music, wherever it lives`}
  description="A free, open-source music app for Plex, Jellyfin and Navidrome. Your library, your server, your files — no account, no tracking, no subscription."
  themeColor="#f2e9d8"
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=zodiak@400,500,700,800,900&f[]=satoshi@400,500,700,900&display=swap"
    />
  </Fragment>

  <!--
    THESIS: The page is an editorial listening room. An enormous, high-contrast
    chunky display serif (Zodiak) carries every idea in two- or three-word
    lines; body copy is tiny, quiet Satoshi set diagonally opposite. The extreme
    type ratio IS the design — everything else is paper, object and photograph.
    OWN-WORLD: Warm cream paper ground, burnt orange, dark warm brown ink, and
    Mozz red kept as a deliberate spark held in tension against the orange.
    Print devices — hairline rules, corner registration marks, a pixel disc
    drawn from the mark — replace eyebrows and pill tags. One dark full-bleed
    section near the end for contrast.
    STORY: Your music, wherever it lives. Plays off your own server, no account,
    no tracking, free forever — and it takes the colour of whatever is playing.
    FIRST VIEWPORT: Wordmark top-left; the tagline set huge; a dressed phone and
    a hand-drawn die-cut sleeve with a CD collaged to the right; store + source
    actions; a small measured specimen line low-left.
    FORM: The conventionally beautiful one — art-directed, expensive, calm.
  -->

  <VariantBar slug="parlour" tone="warm" />

  <!-- Paper grain + registration marks, authored once here and reused. -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <filter id="par-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
  </svg>

  <div class="page">
    <div class="grain" aria-hidden="true"></div>

    <header class="top">
      <a class="wordmark" href="/" aria-label="Mozz home">
        <Mark size={30} />
        <span>Mozz</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="#servers">Servers</a>
        <a href="#craft">What it does</a>
        <a href="#yours">Why it's yours</a>
        <a class="src" href={GITHUB_URL}>Source</a>
      </nav>
    </header>

    <main>
      <!-- ============================ HERO ============================ -->
      <section class="hero" aria-labelledby="hero-h">
        <div class="hero-copy">
          <p class="hero-lede">
            A record player for the music you already own. Point it at your Plex,
            Jellyfin or Navidrome server and press play.
          </p>
          <h1 id="hero-h" class="display">
            <span>Your music,</span>
            <span class="em">wherever</span>
            <span>it lives.</span>
          </h1>

          <div class="actions">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="ghost" href={GITHUB_URL}>Read the source</a>
          </div>

          <dl class="specimen" aria-label="Measured facts">
            {STATS.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!--
          The stage: a dressed phone and a hand-drawn die-cut sleeve with a CD.
          A hero plate layers on top of the composed art — drop AI artwork at
          /public/hero/parlour.jpg and it enriches the scene. With no file the
          layer paints nothing (an expected 404, never a broken box) and the
          composed hero stands entirely on its own.
        -->
        <div class="stage">
          <div class="plate" aria-hidden="true"></div>

          <!-- Illustration 1 — a printed, die-cut album sleeve with a CD -->
          <figure class="sleeve" aria-hidden="true">
            <svg viewBox="0 0 300 300" role="presentation">
              <defs>
                <radialGradient id="cd-sheen" cx="42%" cy="38%" r="72%">
                  <stop offset="0%" stop-color="#fff6e6"/>
                  <stop offset="26%" stop-color="#f4c98a"/>
                  <stop offset="46%" stop-color="#e2701f"/>
                  <stop offset="62%" stop-color="#c85a14"/>
                  <stop offset="78%" stop-color="#c80028"/>
                  <stop offset="100%" stop-color="#7a3410"/>
                </radialGradient>
                <clipPath id="diecut"><circle cx="150" cy="158" r="96"/></clipPath>
              </defs>

              <!-- sleeve board -->
              <rect x="14" y="14" width="272" height="272" rx="4" fill="#efe3cb"/>
              <rect x="14" y="14" width="272" height="272" rx="4" fill="none" stroke="#241c14" stroke-width="1.5"/>
              <!-- printed header block -->
              <rect x="30" y="30" width="240" height="30" fill="#241c14"/>
              <text x="40" y="50" fill="#f2e9d8" font-family="Zodiak, Georgia, serif" font-weight="800" font-size="17" letter-spacing="0.5">MOZZ · CATALOGUE</text>
              <!-- small printed index rules under header -->
              <line x1="30" y1="66" x2="270" y2="66" stroke="#241c14" stroke-width="0.75"/>
              <text x="30" y="280" fill="#5a4a34" font-family="Satoshi, sans-serif" font-size="9" letter-spacing="1.5">SIDE A · YOUR LIBRARY · NO ACCOUNT</text>

              <!-- the CD behind the die-cut window -->
              <g clip-path="url(#diecut)">
                <rect x="40" y="60" width="220" height="200" fill="#241c14"/>
                <circle cx="150" cy="158" r="92" fill="url(#cd-sheen)"/>
                <!-- fine data rings (a CD surface, not a vinyl groove) -->
                <g fill="none" stroke="#241c14" stroke-opacity="0.10" stroke-width="0.8">
                  <circle cx="150" cy="158" r="84"/><circle cx="150" cy="158" r="76"/>
                  <circle cx="150" cy="158" r="68"/><circle cx="150" cy="158" r="60"/>
                  <circle cx="150" cy="158" r="52"/><circle cx="150" cy="158" r="44"/>
                </g>
                <!-- specular streak -->
                <path d="M96 108 A92 92 0 0 1 208 108 L198 120 A76 76 0 0 0 106 120 Z" fill="#fff6e6" opacity="0.42"/>
                <!-- CD hub: wide clear ring + clamp ring + centre hole -->
                <circle cx="150" cy="158" r="34" fill="#efe3cb"/>
                <circle cx="150" cy="158" r="34" fill="none" stroke="#241c14" stroke-width="1"/>
                <circle cx="150" cy="158" r="26" fill="none" stroke="#c85a14" stroke-width="1.5"/>
                <circle cx="150" cy="158" r="12" fill="#efe3cb" stroke="#241c14" stroke-width="1"/>
              </g>
              <!-- the die-cut edge itself -->
              <circle cx="150" cy="158" r="96" fill="none" stroke="#241c14" stroke-width="1.5"/>
              <circle cx="150" cy="158" r="100" fill="none" stroke="#241c14" stroke-width="0.5" stroke-dasharray="2 4"/>
            </svg>
          </figure>

          <div class="hero-phone-wrap">
            <Phone name="mozz-nowplaying" width={252} priority class="hero-phone" alt="Mozz now playing, its interface tinted violet to match the album art." />
          </div>

          <!-- corner registration marks, the print device of the whole page -->
          <span class="reg tl" aria-hidden="true"></span>
          <span class="reg br" aria-hidden="true"></span>
        </div>
      </section>

      <!-- ========================= SERVERS ========================= -->
      <section id="servers" class="servers" aria-labelledby="srv-h">
        <div class="rule"><span class="mark" set:html={pixDisc}></span></div>
        <div class="srv-grid">
          <div class="srv-head">
            <h2 id="srv-h" class="display">
              <span>Point it at</span>
              <span class="em">your own</span>
              <span>shelf.</span>
            </h2>
            <p class="body">
              Mozz is the player; your server is the library. Add more than one
              and browse them as if they had always been the same collection.
            </p>
          </div>
          <ul class="srv-list" role="list">
            {SERVERS.map((s) => (
              <li>
                <ServerLogo name={s.name} size={34} brand />
                <div>
                  <h3>{s.name}</h3>
                  <p>{s.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ======================= WHAT IT DOES ======================= -->
      <section id="craft" class="craft" aria-labelledby="craft-h">
        <div class="rule"><span class="mark" set:html={pixDisc}></span></div>
        <header class="craft-head">
          <h2 id="craft-h" class="display">
            <span>What it does,</span>
            <span class="em">quietly.</span>
          </h2>
          <p class="body">
            Six things it gets right, printed like an index. No pro tier holding
            any of them hostage — every one is in the free app.
          </p>
        </header>

        <ol class="spread" role="list">
          {FEATURES.map((f) => (
            <li class="entry">
              <span class="entry-mark" set:html={pixDisc}></span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ==================== ADAPTIVE TINT PLATES ==================== -->
      <section class="tint" aria-labelledby="tint-h">
        <div class="rule"><span class="mark" set:html={pixDisc}></span></div>
        <div class="tint-head">
          <h2 id="tint-h" class="display">
            <span>It takes the</span>
            <span class="em">colour</span>
            <span>of the record.</span>
          </h2>
          <p class="body">
            One app. Every screen draws its palette from the artwork that is
            playing, so the interface is never louder than the music.
          </p>
        </div>

        <div class="contact" role="list" aria-label="Screens, each tinted by its artwork">
          {PLATES.map((p, i) => (
            <figure class={`shell shell-${i}`} role="listitem">
              <Shot
                name={p.name}
                sizes="(max-width: 720px) 40vw, 220px"
                class="tint-shot"
              />
              <figcaption>{p.note}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- ================= OWNERSHIP — DARK SECTION ================= -->
      <section id="yours" class="yours" aria-labelledby="yours-h">
        <div class="yours-inner">
          <div class="yours-lead">
            <span class="mark dark" set:html={pixDisc}></span>
            <h2 id="yours-h" class="display">
              <span>It's yours.</span>
              <span class="em">Actually</span>
              <span>yours.</span>
            </h2>
            <p class="body">
              These are people who decided not to rent their music. Mozz is built
              the same way: it talks to your server and nobody else.
            </p>

            <!-- Illustration 2 — a hand-drawn elevation of where music lives -->
            <figure class="elevation" aria-hidden="true">
              <svg viewBox="0 0 360 220" role="presentation">
                <!-- floor + shelf carcass, drawn as an ink elevation -->
                <g fill="none" stroke="#f2e9d8" stroke-width="1.4" stroke-linejoin="round">
                  <rect x="12" y="24" width="196" height="164"/>
                  <line x1="12" y1="80" x2="208" y2="80"/>
                  <line x1="12" y1="136" x2="208" y2="136"/>
                  <line x1="110" y1="136" x2="110" y2="188"/>
                  <line x1="6" y1="188" x2="352" y2="188"/>
                </g>

                <!-- top shelf: books / record spines -->
                <g>
                  <rect x="24" y="40" width="9" height="34" fill="#e2701f"/>
                  <rect x="35" y="36" width="9" height="38" fill="#c80028"/>
                  <rect x="46" y="42" width="7" height="32" fill="#efe3cb"/>
                  <rect x="55" y="38" width="10" height="36" fill="#e2701f" opacity="0.6"/>
                  <rect x="67" y="40" width="8" height="34" fill="#efe3cb"/>
                  <!-- a small plant on the right of the top shelf -->
                  <path d="M186 74 q-10 -20 -2 -34 M186 74 q10 -18 3 -30 M186 74 q0 -22 0 -30" stroke="#7fae7a" stroke-width="1.4" fill="none"/>
                  <path d="M176 74 h20 l-3 -8 h-14 z" fill="#c85a14"/>
                </g>

                <!-- middle shelf: the home server (a NAS with drive lights) -->
                <g>
                  <rect x="26" y="92" width="86" height="36" rx="2" fill="#241c14" stroke="#f2e9d8" stroke-width="1.2"/>
                  <g fill="#efe3cb"><rect x="34" y="98" width="6" height="24"/><rect x="44" y="98" width="6" height="24"/><rect x="54" y="98" width="6" height="24"/><rect x="64" y="98" width="6" height="24"/></g>
                  <circle cx="100" cy="102" r="2.6" fill="#35e08f"/>
                  <circle cx="100" cy="110" r="2.6" fill="#e2701f"/>
                  <text x="30" y="150" fill="#b8a988" font-family="Satoshi, sans-serif" font-size="8" letter-spacing="1">YOUR SERVER</text>
                  <!-- a router beside it -->
                  <rect x="128" y="104" width="60" height="24" rx="2" fill="none" stroke="#f2e9d8" stroke-width="1.2"/>
                  <line x1="142" y1="104" x2="136" y2="88" stroke="#f2e9d8" stroke-width="1.2"/>
                  <line x1="164" y1="104" x2="172" y2="86" stroke="#f2e9d8" stroke-width="1.2"/>
                  <circle cx="140" cy="116" r="1.8" fill="#35e08f"/>
                </g>

                <!-- bottom shelf: crates of files -->
                <g stroke="#f2e9d8" stroke-width="1.2" fill="none">
                  <rect x="24" y="150" width="70" height="30"/>
                  <line x1="30" y1="150" x2="30" y2="180"/><line x1="40" y1="150" x2="40" y2="180"/>
                  <line x1="50" y1="150" x2="50" y2="180"/><line x1="60" y1="150" x2="60" y2="180"/>
                  <line x1="70" y1="150" x2="70" y2="180"/><line x1="80" y1="150" x2="80" y2="180"/>
                </g>

                <!-- the dotted signal path to a phone in hand -->
                <path d="M188 116 C240 116 250 96 286 96" fill="none" stroke="#e2701f" stroke-width="1.6" stroke-dasharray="2 6" stroke-linecap="round"/>
                <g>
                  <rect x="286" y="52" width="52" height="96" rx="10" fill="#efe3cb" stroke="#241c14" stroke-width="1.4"/>
                  <rect x="292" y="60" width="40" height="72" rx="4" fill="#c80028"/>
                  <circle cx="312" cy="88" r="12" fill="#f2c14e"/>
                  <rect x="298" y="108" width="28" height="3" rx="1.5" fill="#f2e9d8" opacity="0.85"/>
                  <rect x="298" y="115" width="20" height="3" rx="1.5" fill="#f2e9d8" opacity="0.6"/>
                  <text x="286" y="164" fill="#b8a988" font-family="Satoshi, sans-serif" font-size="8" letter-spacing="1">YOUR PHONE</text>
                </g>
              </svg>
            </figure>
          </div>

          <div class="yours-body">
            <ul class="own-list" role="list">
              {OWNERSHIP.map((o) => (
                <li>
                  <h3>{o.title}</h3>
                  <p>{o.body}</p>
                </li>
              ))}
            </ul>

            <dl class="specsheet" aria-label="Measured facts">
              {STATS.map((s) => (
                <div>
                  <dt>{s.value}</dt>
                  <dd>{s.label}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>

      <!-- =========================== FAQ =========================== -->
      <section class="faq" aria-labelledby="faq-h">
        <div class="rule"><span class="mark" set:html={pixDisc}></span></div>
        <h2 id="faq-h" class="display">
          <span>Still</span>
          <span class="em">wondering.</span>
        </h2>
        <dl class="qa">
          {FAQS.map((f) => (
            <div class="qa-row">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ========================= FOOTER ========================= -->
      <footer class="foot" aria-labelledby="foot-h">
        <div class="foot-big">
          <h2 id="foot-h" class="display">
            <span>Free</span>
            <span class="em">forever.</span>
          </h2>
          <p class="body">{TAGLINE} {SUBLINE}</p>
        </div>
        <div class="foot-meta">
          <a class="wordmark" href="/" aria-label="Mozz home">
            <Mark size={26} />
            <span>Mozz</span>
          </a>
          <nav aria-label="Footer">
            <a href={GITHUB_URL}>GitHub</a>
            <a href={DONATE_URL}>Sponsor</a>
            <a href="#servers">Servers</a>
          </nav>
          <p class="license">Open source under GPL-3.0, with an App Store Exception. No account, no tracking.</p>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<style>
  /* ------------------------------------------------------------------ */
  /*  PARLOUR — warm editorial listening room                            */
  /* ------------------------------------------------------------------ */
  .page {
    --cream: #f2e9d8;
    --paper: #f6efe1;
    --panel: #eadfc8;
    --panel-deep: #e4d6ba;
    --orange: #e2701f;
    --orange-deep: #b8570f;
    --ink: #241c14;
    --ink-soft: #4a3d2b;
    --ink-faint: #6a5a42;
    --red: #c80028;
    --dark: #1c150d;
    --dark-2: #2a2013;
    --line: rgba(36, 28, 20, 0.24);
    --line-soft: rgba(36, 28, 20, 0.12);

    --serif: 'Zodiak', 'Iowan Old Style', Georgia, 'Times New Roman', serif;
    --sans: 'Satoshi', ui-sans-serif, system-ui, -apple-system, sans-serif;

    position: relative;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--sans);
    overflow: clip;
  }

  /* subtle authored paper grain — never a muddy overlay */
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.05;
    mix-blend-mode: multiply;
    filter: url(#par-grain);
    /* the filter needs a painted box to work on */
    background: #000;
  }

  main { position: relative; z-index: 2; }

  .display {
    font-family: var(--serif);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--ink);
    text-wrap: balance;
  }
  .display span { display: block; }
  .display .em { color: var(--orange-deep); font-style: italic; font-weight: 900; }

  .body {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(0.98rem, 1.05vw, 1.08rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  /* ---- shared page frame ---- */
  .top, .hero, .servers, .craft, .tint, .faq, .foot {
    padding-inline: clamp(1.25rem, 5vw, 5.5rem);
  }

  /* ============================ HEADER ============================ */
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    background: color-mix(in srgb, var(--cream) 86%, transparent);
    border-bottom: 1px solid var(--line-soft);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .topnav { display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 1.75rem); }
  .topnav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .topnav a:hover { color: var(--orange-deep); }
  .topnav .src { color: var(--red); font-weight: 700; }
  @media (max-width: 46rem) { .topnav a:not(.src) { display: none; } }

