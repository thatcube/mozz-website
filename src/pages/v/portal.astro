            <ellipse cx={VPX} cy={r2(stage.b - 5)} rx="70" ry="17" fill="#412a4c" />
            <g class="disc">
              <circle cx={VPX} cy={r2(stage.b - 32)} r="30" fill="#150e1c" />
              <g fill="none" stroke="#6b4f7a" stroke-width="1.1" opacity="0.8">
                <circle cx={VPX} cy={r2(stage.b - 32)} r="25" />
                <circle cx={VPX} cy={r2(stage.b - 32)} r="20" />
                <circle cx={VPX} cy={r2(stage.b - 32)} r="15" />
              </g>
              <circle cx={VPX} cy={r2(stage.b - 32)} r="9" fill="#d6002b" />
              <circle cx={VPX} cy={r2(stage.b - 32)} r="1.8" fill="#150e1c" />
            </g>

            <!-- sound leaving the stage, swelling toward the doorway -->
            <g class="rings" fill="none" stroke="#ffd6a0">
              {rings.map((r) => (
                <ellipse
                  cx={VPX} cy={r.cy} rx={r.rx} ry={r.ry}
                  opacity={r.o} stroke-width={r.w} style={`--rd:${r.d}s`}
                />
              ))}
            </g>

            <rect width="360" height="780" fill="url(#pt-haze)" />
            <rect class="sheen" x="-360" y="0" width="360" height="780" fill="#ffe9c6" opacity="0.05" />
          </svg>

          <!-- the marks of the servers this hall is built out of -->
          <div class="plaques">
            {PLAQUES.map((p) => (
              <span
                class="plaque"
                style={`--px:${p.x}%; --py:${p.y}%; --ps:${p.s}; --pc:${p.c}`}
              >
                <ServerLogo name={p.name as any} size={30} brand />
              </span>
            ))}
          </div>

          <!-- the doorway itself: jambs, lintel, sill -->
          <svg class="frame" viewBox="0 0 360 780" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="pt-metal" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#150e1e" />
                <stop offset="0.16" stop-color="#4a3757" />
                <stop offset="0.34" stop-color="#8d76a0" />
                <stop offset="0.5" stop-color="#5c4670" />
                <stop offset="0.7" stop-color="#8d76a0" />
                <stop offset="0.88" stop-color="#3d2d4c" />
                <stop offset="1" stop-color="#150e1e" />
              </linearGradient>
              <linearGradient id="pt-metalv" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#9d86ad" />
                <stop offset="1" stop-color="#2f2340" />
              </linearGradient>
            </defs>
            <path
              d="M-62,-54 H422 V834 H-62 Z M12,42 a32,32 0 0 1 32,-32 H316 a32,32 0 0 1 32,32 V738 a32,32 0 0 1 -32,32 H44 a32,32 0 0 1 -32,-32 Z"
              fill="url(#pt-metal)" fill-rule="evenodd"
            />
            <!-- the outer edge catching the room's dark, and the inner lip catching the hall -->
            <path
              d="M-62,-54 H422 V834 H-62 Z M-26,-18 H386 V798 H-26 Z"
              fill="#0a0710" fill-rule="evenodd" opacity="0.72"
            />
            <rect x="-26" y="-18" width="412" height="816" fill="none" stroke="#b49ac4" stroke-width="2.5" opacity="0.5" />
            <rect x="12" y="10" width="336" height="760" rx="32" fill="none" stroke="#0a0710" stroke-width="7" opacity="0.85" />
            <rect x="12" y="10" width="336" height="760" rx="32" fill="none" stroke="#ffd9a6" stroke-width="2.4" opacity="0.72" />
            <rect x="20" y="18" width="320" height="744" rx="26" fill="none" stroke="#ffe9c6" stroke-width="1.2" opacity="0.34" />
            <!-- side keys, drawn as pilasters standing off the jamb -->
            <g fill="url(#pt-metalv)" stroke="#0a0710" stroke-width="2">
              <rect x="-34" y="176" width="26" height="66" rx="10" />
              <rect x="-34" y="262" width="26" height="102" rx="10" />
              <rect x="342" y="224" width="26" height="132" rx="10" />
            </g>
          </svg>

          <div class="lintel">
            <Mark size={22} class="key" decorative />
            <span class="lintel__word">{NAME}</span>
            <span class="lintel__dot" aria-hidden="true"></span>
          </div>

          <div class="sill" aria-hidden="true"></div>
        </div>

        <!-- light on the room's floor, and the viewer standing in it -->
        <svg class="spill" viewBox="0 0 1200 460" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="pt-spill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffcf94" stop-opacity="0.5" />
              <stop offset="0.42" stop-color="#ff9d3d" stop-opacity="0.17" />
              <stop offset="1" stop-color="#ff9d3d" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="pt-shadow" cx="0.5" cy="1" r="0.85">
              <stop offset="0" stop-color="#05030a" stop-opacity="0.94" />
              <stop offset="0.62" stop-color="#05030a" stop-opacity="0.72" />
              <stop offset="1" stop-color="#05030a" stop-opacity="0" />
            </radialGradient>
          </defs>
          <path d="M470,0 H730 L1180,460 H20 Z" fill="url(#pt-spill)" />
          <g fill="#ffe6bd" opacity="0.13">
            <path d="M500,0 H520 L360,460 H300 Z" />
            <path d="M690,0 H706 L900,460 H840 Z" />
            <path d="M596,0 H604 L600,460 H592 Z" />
          </g>
          <!-- the viewer's own shadow, thrown back into the room -->
          <ellipse cx="600" cy="470" rx="470" ry="250" fill="url(#pt-shadow)" />
        </svg>

        <!-- sleeves that have already come through -->
        <div class="pour" aria-hidden="true">
          {TILES.map((t) => (
            <span
              class="tile"
              style={`--tx:${t.x}px; --ty:${t.y}px; --ts:${t.s}; --tr:${t.r}deg; --td:${t.d}s`}
            >
              {t.disc && <span class="tile__disc"></span>}
              <svg viewBox="0 0 100 100" class="tile__art" set:html={SLEEVE_ART[t.art]} />
            </span>
          ))}
        </div>
      </div>

      <!-- Headline painted on the floor inside the light; controls standing in
           the threshold. Not a copy column beside a picture. -->
      <div class="copy">
        <h1 class="head">
          <span class="head__l1">Step into the library</span>
          <span class="head__l2">you already own.</span>
        </h1>
        <p class="lede">
          A free, open source player for the <strong>Plex</strong>, <strong>Jellyfin</strong> or{' '}
          <strong>Navidrome</strong> server already running in your house. iPhone and iPad.
          Streamed at home, downloaded for everywhere else.
        </p>

        <div class="console">
          <span class="console__rail" aria-hidden="true"></span>
          <div class="console__keys">
            {APP_STORE_URL ? (
              <a class="store" href={APP_STORE_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                </svg>
                <span><small>Download on the</small>App Store</span>
              </a>
            ) : (
              <span class="store is-pending" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                </svg>
                <span><small>Coming to the</small>App Store</span>
              </span>
            )}
            <a class="src" href={GITHUB_URL} rel="noopener">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
              Read the source
            </a>
          </div>
          <p class="console__meta">
            <span>free forever</span><span>open source</span><span>no account</span><span>nothing tracking you</span>
          </p>
        </div>
      </div>

      <!-- Crates of downloads in the near foreground, cut by the frame. -->
      <svg class="crate crate--l" viewBox="0 0 520 340" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
        <!-- records standing in the crate -->
        <g>
          <rect x="24" y="24" width="132" height="132" rx="4" fill="#e8a04a" transform="rotate(-5 90 90)" />
          <circle cx="90" cy="90" r="30" fill="#1d1226" transform="rotate(-5 90 90)" />
          <circle cx="90" cy="90" r="8" fill="#d6002b" transform="rotate(-5 90 90)" />
          <rect x="150" y="14" width="132" height="140" rx="4" fill="#8f3f14" transform="rotate(-4 216 84)" />
          <rect x="168" y="40" width="70" height="10" fill="#f0c479" transform="rotate(-4 216 84)" />
          <rect x="168" y="58" width="44" height="7" fill="#f0c479" opacity="0.6" transform="rotate(-4 216 84)" />
          <rect x="276" y="6" width="132" height="146" rx="4" fill="#f0c479" transform="rotate(-3 342 78)" />
          <path d="M276,152 L408,6 L408,152 Z" fill="#b8452c" transform="rotate(-3 342 78)" />
          <rect x="396" y="0" width="120" height="150" rx="4" fill="#5b6f8a" transform="rotate(-2 456 76)" />
        </g>
        <!-- the crate itself, cut by the bottom of the frame -->
        <g fill="none" stroke="#160e1c" stroke-width="3" opacity="0.8">
          <path d="M148,20 L160,154" /><path d="M272,12 L284,152" /><path d="M392,6 L402,150" />
        </g>
        <path d="M-20,150 L500,120 L520,340 L-20,340 Z" fill="#2a1b21" />
        <path d="M-20,150 L500,120 L502,158 L-20,188 Z" fill="#432c34" />
        <g fill="none" stroke="#5c343d" stroke-width="8">
          <path d="M-20,214 L508,186" />
          <path d="M-20,278 L514,252" />
        </g>
        <g opacity="0.42">
          <path d="M56,246 l0,-30 l-15,0 l27,-30 l27,30 l-15,0 l0,30 Z" fill="#ffd6a0" transform="rotate(178 68 231)" />
          <text x="112" y="248" fill="#ffd6a0" font-size="34" font-family="'Clash Display',sans-serif" letter-spacing="7">OFFLINE</text>
        </g>
      </svg>

      <svg class="crate crate--r" viewBox="0 0 460 320" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
        <g>
          <rect x="18" y="26" width="124" height="132" rx="4" fill="#4f7d74" transform="rotate(4 80 92)" />
          <rect x="138" y="16" width="124" height="138" rx="4" fill="#9a5b8c" transform="rotate(5 200 85)" />
          <circle cx="200" cy="85" r="27" fill="#1d1226" transform="rotate(5 200 85)" />
          <circle cx="200" cy="85" r="7" fill="#d6002b" transform="rotate(5 200 85)" />
          <rect x="258" y="8" width="124" height="144" rx="4" fill="#c9622c" transform="rotate(6 320 80)" />
          <rect x="378" y="2" width="110" height="148" rx="4" fill="#e0d2b8" transform="rotate(7 433 76)" />
        </g>
        <path d="M-14,148 L474,176 L474,320 L-14,320 Z" fill="#241a2c" />
        <path d="M-14,148 L474,176 L474,212 L-14,184 Z" fill="#3b2b47" />
        <g fill="none" stroke="#4f3a5e" stroke-width="8">
          <path d="M-14,238 L474,262" />
          <path d="M-14,292 L474,312" />
        </g>
      </svg>

      <div class="vignette" aria-hidden="true"></div>
      <div class="scroll" aria-hidden="true"><span></span>further in</div>
    </section>

    <!-- =====================================================================
         CHAMBER ONE — the three doors the hall is built out of
    ====================================================================== -->
    <section class="ch ch--doors" aria-labelledby="ch-doors">
      <div class="ch__air" aria-hidden="true"></div>
      <header class="placard">
        <span class="placard__no">Chamber one</span>
        <h2 id="ch-doors">Three doors, one hall</h2>
        <p>
          Mozz does not host anything. It walks into the server you already run and reads
          the library you already have — <strong>{sServers.value}</strong> {sServers.label}.
        </p>
      </header>

      <div class="doors">
        {SERVERS.map((s, i) => (
          <article class="door" style={`--i:${i}; --dc:${PLAQUES[i].c}`}>
            <span class="door__leaf" aria-hidden="true">
              <span class="door__glow"></span>
              <span class="door__mark"><ServerLogo name={s.name as any} size={52} brand /></span>
              <span class="door__sill"></span>
              <span class="door__pool"></span>
            </span>
            <h3>{s.name}</h3>
            <p>{s.note}</p>
          </article>
        ))}
      </div>

      <p class="ch__foot">
        Pick the server you already run. Its catalog becomes a fast, searchable shelf on the device.
      </p>
    </section>

    <!-- =====================================================================
         CHAMBER TWO — the shelves, holding the real app
    ====================================================================== -->
    <section class="ch ch--shelf" aria-labelledby="ch-shelf">
      <header class="placard placard--left">
        <span class="placard__no">Chamber two</span>
        <h2 id="ch-shelf">The shelf runs further than the room</h2>
        <p>
          The whole catalog is kept in a database on the device, so the wall is already
          indexed before you reach for it. A hundred thousand tracks come back in about{' '}
          <strong>{sSearch.value}</strong> — the list moves while you are still typing.
        </p>
      </header>

      <div class="alcoves">
        <span class="alcoves__board" aria-hidden="true"></span>
        {SHELF_SHOTS.map((n, i) => (
          <span class="alcove" style={`--i:${i}`}>
            <span class="alcove__back" aria-hidden="true"></span>
            <Shot name={n} sizes="(max-width: 720px) 44vw, 220px" class="alcove__shot" ariaHidden={i > 0} />
            <span class="alcove__lip" aria-hidden="true"></span>
          </span>
        ))}
      </div>
    </section>

    <!-- =====================================================================
         CHAMBER THREE — the stage you saw from the doorway, up close
    ====================================================================== -->
    <section class="ch ch--stage" aria-labelledby="ch-stage">
      <div class="stage__cone" aria-hidden="true"></div>
      <div class="stage__rings" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => <span style={`--i:${i}`}></span>)}
      </div>
      <div class="stage__dais" aria-hidden="true"></div>

      <div class="stage__phone">
        <Phone name="mozz-nowplaying" width={286} priority class="stage__device" />
      </div>

      <header class="placard placard--stage">
        <span class="placard__no">Chamber three</span>
        <h2 id="ch-stage">It plays before you have finished tapping</h2>
        <p>
          <strong>{sStart.value}</strong> {sStart.label}. The queue is gapless, so a record
          that was mixed to run together still runs together, and there is a real equalizer
          when you want to lean on it.
        </p>
      </header>
    </section>

    <!-- =====================================================================
         CHAMBER FOUR — the crate room, where the doorway is closed
    ====================================================================== -->
    <section class="ch ch--crates" aria-labelledby="ch-crates">
      <div class="crates__scene" aria-hidden="true">
        <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMax slice">
          <defs>
            <linearGradient id="pt-crfloor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1a1220" />
              <stop offset="1" stop-color="#0a0710" />
            </linearGradient>
            <linearGradient id="pt-crlight" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffcf94" stop-opacity="0.28" />
              <stop offset="1" stop-color="#ffcf94" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect width="1200" height="520" fill="url(#pt-crfloor)" />
          <!-- the doorway, far away now and dimmed to nothing -->
          <g opacity="0.9">
            <rect x="548" y="120" width="104" height="212" rx="20" fill="#241834" />
            <rect x="548" y="120" width="104" height="212" rx="20" fill="none" stroke="#5c4670" stroke-width="3" />
            <rect x="560" y="132" width="80" height="188" rx="13" fill="#0e0916" />
            <rect x="560" y="132" width="80" height="188" rx="13" fill="none" stroke="rgba(255,214,170,0.16)" stroke-width="1.5" />
          </g>
          <path d="M470,0 H730 L980,520 H220 Z" fill="url(#pt-crlight)" opacity="0.55" />
          <rect y="392" width="1200" height="128" fill="#0a0710" opacity="0.55" />
          <g stroke="rgba(255,205,150,0.10)" stroke-width="2">
            <path d="M0,438 H1200" /><path d="M0,478 H1200" />
          </g>
          <!-- crates, lit, full of records that are already here -->
          {[
            { x: 120, y: 262, w: 300, h: 190, t: -3 },
            { x: 468, y: 306, w: 262, h: 168, t: 2 },
            { x: 782, y: 248, w: 318, h: 206, t: -2 },
          ].map((c, i) => (
            <g transform={`rotate(${c.t} ${c.x + c.w / 2} ${c.y + c.h / 2})`}>
              {[0, 1, 2, 3].map((k) => {
                const sw = c.w / 4.1;
                return (
                  <g transform={`rotate(${(k - 1.5) * 2.4} ${c.x + 14 + k * (c.w / 4.4) + sw / 2} ${c.y + 30})`}>
                    <rect
                      x={c.x + 14 + k * (c.w / 4.4)}
                      y={c.y - sw + 34}
                      width={sw}
                      height={sw}
                      rx="3"
                      fill={SPINE[(i * 5 + k * 3) % SPINE.length]}
                    />
                    <rect
                      x={c.x + 14 + k * (c.w / 4.4)}
                      y={c.y - sw + 34}
                      width={sw}
                      height={sw}
                      rx="3"
                      fill="none"
                      stroke="#120b18"
                      stroke-width="2.5"
                    />
                  </g>
                );
              })}
              <rect x={c.x} y={c.y + 26} width={c.w} height={c.h} rx="6" fill="#2a1b21" />
              <rect x={c.x} y={c.y + 26} width={c.w} height={c.h * 0.15} rx="6" fill="#432c34" />
              <g fill="none" stroke="#5c343d" stroke-width="6">
                <path d={`M${c.x},${c.y + 26 + c.h * 0.5} H${c.x + c.w}`} />
                <path d={`M${c.x},${c.y + 26 + c.h * 0.8} H${c.x + c.w}`} />
              </g>
              <ellipse cx={c.x + c.w / 2} cy={c.y + 26 + c.h + 8} rx={c.w / 1.9} ry="14" fill="#05030a" opacity="0.55" />
            </g>
          ))}
        </svg>
      </div>

      <header class="placard placard--crates">
        <span class="placard__no">Chamber four</span>
        <h2 id="ch-crates">Nothing here needs the door open</h2>
        <p>
          Downloads were designed in, not bolted on. Take a record onto a plane and it
          behaves exactly as it does at home — and because the catalog lives on the device,
          browsing and searching still work with the server unreachable.
        </p>
      </header>
    </section>

    <!-- =====================================================================
         CHAMBER FIVE — six niches carved into the wall
    ====================================================================== -->
    <section class="ch ch--niches" aria-labelledby="ch-niches">
      <header class="placard">
        <span class="placard__no">Chamber five</span>
        <h2 id="ch-niches">Cut into the wall</h2>
      </header>
      <div class="niches">
        {FEATURES.map((f, i) => (
          <article class="niche" style={`--i:${i}`}>
            <span class="niche__lamp" aria-hidden="true"></span>
            <span class="niche__glyph" aria-hidden="true">
              <svg viewBox="0 0 48 48" set:html={GLYPH[i]} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- =====================================================================
         CHAMBER SIX — the fixtures this building does not have
    ====================================================================== -->
    <section class="ch ch--absent" aria-labelledby="ch-absent">
      <header class="placard placard--left">
        <span class="placard__no">Chamber six</span>
        <h2 id="ch-absent">The rooms we never built</h2>
        <p>
          Every other music app has these fittings somewhere in the floorplan.
          There was never anywhere to put them here — <strong>{sFree.value}</strong> {sFree.label}.
        </p>
      </header>

      <div class="absences">
        {OWNERSHIP.map((o, i) => (
          <article class="absence" style={`--i:${i}`}>
            <span class="absence__fixture" aria-hidden="true">
              <svg viewBox="0 0 48 48" set:html={ABSENT[i]} />
            </span>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </article>
        ))}
      </div>

      <aside class="inscription">
        <span class="inscription__chip" aria-hidden="true"></span>
        <p>
          One honest exception, carved where you can read it: to build a station, Mozz asks
          MusicBrainz and ListenBrainz what sounds similar to an artist and title. That
          request carries no name, no server address and no account, and Settings has a
          switch that stops it.
        </p>
      </aside>
    </section>

    <!-- =====================================================================
         THE WAY OUT — questions cut into the slab beside the door
    ====================================================================== -->
    <section class="ch ch--faq" aria-labelledby="ch-faq">
      <header class="placard">
        <span class="placard__no">Before you go</span>
        <h2 id="ch-faq">Cut into the slab by the door</h2>
      </header>
      <div class="slab">
        {FAQS.map((f) => (
          <details class="q">
            <summary>
              <span>{f.q}</span>
              <span class="q__mark" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- The doorway shrinks back to the size of a phone. -->
    <footer class="out">
      <div class="out__door" aria-hidden="true">
        <span class="out__glow"></span>
        <span class="out__frame">
          <span class="out__screen"></span>
        </span>
      </div>
      <Mark size={34} class="out__key" decorative />
      <p class="out__word">{NAME}</p>
      <p class="out__line">
        One app for your music, wherever it lives. Free forever, open source under GPL-3.0
        with an App Store Exception. For iPhone and iPad on iOS or iPadOS 17 or later.
      </p>
      <p class="out__links">
        <a href={GITHUB_URL} rel="noopener">Source on GitHub</a>
        <span aria-hidden="true">·</span>
        {APP_STORE_URL
          ? <a href={APP_STORE_URL}>Download on the App Store</a>
          : <span class="out__pending">App Store listing pending</span>}
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* ---------------------------------------------------------------------
     MATERIALS. One room, lit by one doorway, so the palette is a single
     warm light falling through a cold dark space.
  --------------------------------------------------------------------- */
  .pt {
    --ink-0: #05030a;
    --ink-1: #0a0710;
    --ink-2: #120c1a;
    --wall: #1a1220;
    --amber: #ffb257;
    --amber-hi: #ffe0b0;
    --amber-lo: #8f3f14;
    --ember: #ff8a3d;
    --red: #d6002b;
    --red-body: #b00023;
    --cream: #f8ede2;
    --body: #cbb9ae;
    --muted: #9b8a84;
    --line: rgba(255, 214, 170, 0.14);

    --bar: 41px;
    --hero-h: max(calc(100svh - var(--bar)), 640px);
    --portal-h: clamp(320px, 60svh, 660px);
    --portal-w: calc(var(--portal-h) * 0.4615);
    --floor: 66%;

    background: var(--ink-1);
    color: var(--body);
    font-family: 'Satoshi', system-ui, -apple-system, sans-serif;
    overflow-x: clip;
  }

  .pt :is(h1, h2, h3) {
    font-family: 'Clash Display', system-ui, sans-serif;
    color: var(--cream);
    margin: 0;
    letter-spacing: -0.015em;
  }
  .pt p { margin: 0; }
  .pt strong { color: var(--amber-hi); font-weight: 700; }

  /* =====================================================================
     FIRST VIEWPORT
  ===================================================================== */
  .hero {
    position: relative;
    height: var(--hero-h);
    overflow: hidden;
    isolation: isolate;
    background: var(--ink-1);
  }

  /* the air of the viewer's room */
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 78% at 50% 74%, rgba(255, 157, 61, 0.20), transparent 62%),
      radial-gradient(60% 42% at 50% 62%, rgba(255, 207, 148, 0.16), transparent 70%),
      linear-gradient(180deg, #07050d 0%, #0e0916 46%, #16101f 72%, #0a0710 100%);
  }

  .scenery {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* A real perspective plane: the boards converge on the doorway by
     construction, at every viewport aspect. */
  .floor {
    position: absolute;
    z-index: 2;
    top: var(--floor);
    left: 50%;
    width: 460%;
    height: calc(var(--hero-h) * 0.86);
    transform-origin: 50% 0%;
    transform: translateX(-50%) perspective(700px) rotateX(66deg);
    background:
      radial-gradient(52% 60% at 50% 0%, rgba(255, 178, 87, 0.26), transparent 66%),
      linear-gradient(180deg, #150e1e 0%, #0b0711 58%, #07050c 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 56%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 0%, #000 56%, transparent 96%);
  }
  .floor__grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background:
      repeating-linear-gradient(90deg, transparent 0 118px, rgba(255, 205, 150, 0.16) 118px 120px),
      repeating-linear-gradient(0deg, transparent 0 82px, rgba(255, 205, 150, 0.10) 82px 84px);
  }

  /* Everything that must line up with the doorway. */
  .core {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: calc(100% - var(--floor));
    transform: translateX(-50%);
    width: var(--portal-w);
    height: var(--portal-h);
  }

  .halo {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    width: 320%;
    height: 132%;
    background: radial-gradient(closest-side, rgba(255, 178, 87, 0.46), rgba(255, 138, 61, 0.16) 54%, transparent 78%);
    filter: blur(26px);
    z-index: 0;
  }

  .portal {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .hall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: clamp(18px, 5.4%, 34px);
    box-shadow:
      0 0 120px rgba(255, 157, 61, 0.42),
      0 40px 140px rgba(0, 0, 0, 0.78);
  }

  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 3;
    pointer-events: none;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.65));
  }

  /* server marks, hung deep in the hall */
  .plaques { position: absolute; inset: 0; z-index: 2; }
  .plaque {
    position: absolute;
    left: var(--px);
    top: var(--py);
    transform: translate(-50%, -50%) scale(var(--ps));
    display: grid;
    place-items: center;
    padding: 0.42rem;
    border-radius: 10px;
    background: rgba(10, 7, 16, 0.62);
    border: 1px solid color-mix(in srgb, var(--pc) 46%, transparent);
    box-shadow: 0 0 26px color-mix(in srgb, var(--pc) 40%, transparent);
  }
  .plaque :global(svg) { display: block; filter: drop-shadow(0 0 8px color-mix(in srgb, var(--pc) 70%, transparent)); }

  /* the key in the lintel */
  .lintel {
    position: absolute;
    z-index: 4;
    top: 3%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.8rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #1b1424, #090610);
    border: 1px solid rgba(255, 214, 170, 0.22);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 214, 170, 0.16);
    white-space: nowrap;
  }
  .lintel :global(.key) {
    filter: drop-shadow(0 0 8px rgba(214, 0, 43, 0.85));
  }
  .lintel__word {
    font-family: 'Clash Display', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--amber-hi);
  }
  .lintel__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 10px var(--amber);
  }

  .sill {
    position: absolute;
    z-index: 4;
    left: -9%;
    right: -9%;
    bottom: -1.1%;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--amber-hi) 22%, #fff6e6 50%, var(--amber-hi) 78%, transparent);
    box-shadow: 0 0 34px rgba(255, 207, 148, 0.75);
  }

  /* the light on the room's floor, and the viewer's own shadow in it */
  .spill {
    position: absolute;
    z-index: 1;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 240vw;
    max-width: none;
    height: calc(var(--hero-h) * 0.34);
    display: block;
    pointer-events: none;
  }

  /* sleeves that have already come through */
  .pour {
    position: absolute;
    z-index: 6;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .tile {
    position: absolute;
    left: var(--tx);
    top: var(--ty);
    width: 112px;
    height: 112px;
    margin: -56px 0 0 -56px;
    transform: rotate(var(--tr)) scale(var(--ts));
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.6));
  }
  .tile__art {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    outline: 1px solid rgba(255, 214, 170, 0.22);
    outline-offset: -1px;
  }
  .tile__disc {
    position: absolute;
    z-index: 1;
    right: -34%;
    top: 8%;
    width: 84%;
    height: 84%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--red) 0 17%, #191020 17% 22%, #241830 22% 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 214, 170, 0.14);
  }

  /* crates of downloads, cut by the frame */
  .crate {
    position: absolute;
    z-index: 7;
    bottom: -3%;
    display: block;
    pointer-events: none;
    filter: drop-shadow(0 -10px 40px rgba(0, 0, 0, 0.6));
  }
  .crate--l { left: -6%; bottom: -7%; width: min(33vw, 430px); }
  .crate--r { right: -7%; bottom: -6%; width: min(28vw, 360px); opacity: 0.9; }

  .vignette {
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    background:
      radial-gradient(140% 100% at 50% 56%, transparent 44%, rgba(4, 2, 8, 0.72) 100%),
      linear-gradient(180deg, rgba(4, 2, 8, 0.66), transparent 26%);
  }

  .scroll {
    position: absolute;
    z-index: 10;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scroll span {
    width: 34px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--amber));
  }

  /* ---------------------------------------------------------------------
     The words are part of the room: the headline is painted on the floor
     inside the light the doorway throws, and the buttons are the desk
     standing in the threshold.
  --------------------------------------------------------------------- */
  /* A pool of shadow on the floor so the words read over anything behind. */
  .copy::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -8% -14% -12%;
    background: radial-gradient(
      62% 68% at 50% 56%,
      rgba(7, 4, 12, 0.9),
      rgba(7, 4, 12, 0.62) 52%,
      rgba(7, 4, 12, 0) 78%
    );
  }
  .copy {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: clamp(2.1rem, 5vh, 3.2rem);
    transform: translateX(-50%);
    width: min(1020px, 92vw);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: clamp(0.7rem, 1.6vh, 1.15rem);
  }

  .head {
    display: grid;
    gap: 0.06em;
    font-weight: 600;
    line-height: 0.94;
    transform-origin: 50% 100%;
    transform: perspective(1100px) rotateX(17deg);
    text-shadow:
      0 2px 0 rgba(0, 0, 0, 0.55),
      0 18px 46px rgba(0, 0, 0, 0.9),
      0 0 62px rgba(255, 157, 61, 0.28);
  }
  .head__l1 {
    font-size: clamp(1.6rem, 4.3vw, 3.5rem);
    color: color-mix(in srgb, var(--cream) 76%, var(--amber));
  }
  .head__l2 {
    font-size: clamp(2.1rem, 5.8vw, 4.9rem);
    color: var(--cream);
  }

  .lede {
    max-width: 58ch;
    font-size: clamp(0.92rem, 1.18vw, 1.08rem);
    line-height: 1.55;
    color: var(--body);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.95);
  }

  .console {
    position: relative;
    width: min(600px, 94vw);
    padding: clamp(0.7rem, 1.5vw, 0.95rem) clamp(0.75rem, 1.6vw, 1.05rem) 0.7rem;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(38, 27, 48, 0.94), rgba(12, 8, 18, 0.96));
    border: 1px solid rgba(255, 214, 170, 0.2);
    box-shadow:
      inset 0 1px 0 rgba(255, 224, 176, 0.2),
      0 26px 60px rgba(0, 0, 0, 0.75),
      0 0 44px rgba(255, 157, 61, 0.16);
    backdrop-filter: blur(3px);
  }
  .console__rail {
    position: absolute;
    left: 50%;
    top: -9px;
    transform: translateX(-50%);
    width: 46%;
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(255, 214, 170, 0.5), transparent);
  }
  .console__keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  .store,
  .src {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 12px;
    font-family: 'Satoshi', system-ui, sans-serif;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .store {
    padding: 0.62rem 1.15rem;
    background: linear-gradient(180deg, var(--red) 0%, var(--red-body) 100%);
    color: #fff4f5;
    font-weight: 700;
    font-size: 1.02rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 26px rgba(200, 0, 40, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }
  .store svg { width: 22px; height: 22px; fill: currentColor; flex: none; }
  .store span { display: grid; text-align: left; line-height: 1.06; }
  .store small { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.86; font-weight: 500; }
  .store.is-pending {
    background: linear-gradient(180deg, rgba(200, 0, 40, 0.34), rgba(134, 0, 0, 0.4));
    color: #ffd6dc;
    border: 1px dashed rgba(255, 214, 220, 0.5);
    box-shadow: none;
    cursor: default;
  }
  .src {
    padding: 0.62rem 1.05rem;
    color: var(--amber-hi);
    font-weight: 600;
    font-size: 0.95rem;
    background: rgba(255, 214, 170, 0.06);
    border: 1px solid rgba(255, 214, 170, 0.28);
  }
  .src svg { width: 17px; height: 17px; fill: currentColor; }
  .src:hover { background: rgba(255, 214, 170, 0.13); border-color: rgba(255, 214, 170, 0.5); }
  .store:hover:not(.is-pending) { transform: translateY(-2px); }
  .console :is(a):focus-visible {
    outline: 2px solid var(--amber-hi);
    outline-offset: 3px;
  }

  .console__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(255, 214, 170, 0.14);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .console__meta span { position: relative; }
  .console__meta span + span::before {
    content: '';
    position: absolute;
    left: -0.55rem;
    top: 50%;
    width: 3px; height: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: var(--amber-lo);
  }

  /* =====================================================================
     CHAMBERS — the same building, further in
  ===================================================================== */
  .ch {
    position: relative;
    padding: clamp(3.6rem, 9vh, 7.5rem) clamp(1.1rem, 5vw, 3.5rem);
    isolation: isolate;
  }
  .ch__air {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(80% 60% at 50% 0%, rgba(255, 157, 61, 0.12), transparent 70%);
    pointer-events: none;
  }
  .pt .ch__foot {
    max-width: 46ch;
    margin: clamp(3rem, 7vh, 4.6rem) auto 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .placard {
    position: relative;
    max-width: 54ch;
    margin: 0 auto clamp(2rem, 5vh, 3.4rem);
    text-align: center;
    display: grid;
    gap: 0.85rem;
    justify-items: center;
  }
  .placard--left { margin-inline: 0 auto; text-align: left; justify-items: start; }
  .placard__no {
    font-size: 0.66rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--amber-lo);
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(255, 214, 170, 0.2);
    border-radius: 999px;
    background: rgba(255, 214, 170, 0.04);
  }
  .placard h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.9rem);
    line-height: 1.02;
    font-weight: 600;
  }
  .placard p {
    font-size: clamp(0.95rem, 1.1vw, 1.06rem);
    line-height: 1.6;
    color: var(--body);
  }

  /* chamber one — three doors */
  .doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 4vw, 3.4rem);
    max-width: 940px;
    margin: 0 auto;
    perspective: 1500px;
    perspective-origin: 50% 40%;
  }
  .door {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
    transform-style: preserve-3d;
  }
  /* the leaf is a doorway of its own, echoing the big one */
  .door__leaf {
    position: relative;
    display: block;
    width: min(184px, 78%);
    aspect-ratio: 9 / 16.5;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
    border-radius: 20px 20px 4px 4px;
    transform-origin: 50% 90%;
    transform: rotateY(calc((var(--i) - 1) * -17deg));
    background:
      radial-gradient(120% 70% at 50% 78%, color-mix(in srgb, var(--dc) 22%, transparent), transparent 68%),
      linear-gradient(180deg, #241832 0%, #150e1f 60%, #0c0813 100%);
    border: 1px solid rgba(255, 214, 170, 0.2);
    box-shadow:
      inset 0 0 0 6px rgba(10, 7, 16, 0.7),
      inset 0 26px 40px rgba(0, 0, 0, 0.7),
      0 34px 60px rgba(0, 0, 0, 0.6);
  }
  .door__glow {
    position: absolute;
    left: 50%;
    bottom: -6%;
    transform: translateX(-50%);
    width: 150%;
    height: 62%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--dc) 38%, transparent), transparent 72%);
    filter: blur(16px);
    pointer-events: none;
  }
  .door__mark {
    position: absolute;
    left: 50%;
    top: 44%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
  }
  .door__mark :global(svg) {
    display: block;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--dc) 70%, transparent));
  }
  .door__sill {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 6px;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--dc), transparent);
    opacity: 0.85;
  }
  .door__pool {
    position: absolute;
    left: 50%;
    bottom: -26px;
    transform: translateX(-50%);
    width: 132%;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--dc) 26%, transparent), transparent 74%);
    filter: blur(8px);
    pointer-events: none;
  }
  .door h3 { font-size: 1.24rem; font-weight: 600; }
  .door p { font-size: 0.92rem; line-height: 1.55; color: var(--muted); max-width: 24ch; }

  /* chamber two — the shelf */
