---
/**
 * VARIANT — PORTAL
 *
 * THESIS: The app opens into music. Not a phone photographed on a background —
 *   a phone-shaped doorway at architectural scale, standing in the viewer's own
 *   dark room, with an impossible physical library on the other side of it.
 *   Shelves, a listening stage, radio rings, crates of downloads and the mix
 *   paths all pour out through the threshold and land at your feet.
 *
 * WHY IT IS BUILT THIS WAY (and not as one full-bleed slice SVG): everything in
 *   the composition has to touch the doorway — the light spill starts at its
 *   sill, the rings continue out of it, the sleeves emerge from its mouth. A
 *   slice-cropped SVG's coordinates drift against a CSS-sized element as the
 *   viewport aspect changes, so the scene is layered instead:
 *     .sky      CSS   — the room's air, ceiling and back wall
 *     .scenery  SVG   — far field only (hanging shelves, motes) — slice-safe,
 *                       nothing in it needs to touch the floor or the door
 *     .floor    CSS3D — a real perspective plane, so the boards converge on the
 *                       doorway automatically at every aspect ratio
 *     .core     mixed — the portal itself, its beams, its spill and everything
 *                       pouring out, all positioned relative to the portal box,
 *                       so the alignment is true by construction
 *     .fg       SVG   — crates anchored to the bottom edge, cut by the frame
 *   The interior world is its own SVG drawn in true one-point perspective from a
 *   vanishing point inside the hall, generated below so the recession is exact.
 *
 * INTEGRATION, not overlay: the wordmark and the red pixel mark are the key in
 *   the doorway's lintel; the headline is painted on the floor inside the light
 *   the doorway throws; the buttons are the portal's control desk standing in
 *   the threshold. Sleeves and rings cross in front of the copy.
 *
 * Later sections are chambers of the same world, in the same materials.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import Shot from '../../components/Shot.astro';
import {
  NAME, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Step into the library you already own.';

// Stats, woven into the chamber they belong to rather than lined up in a row.
const sSearch = STATS[0];  // 16ms — search across 100,000 tracks
const sStart = STATS[1];   // 75ms — from tap to first note
const sServers = STATS[2]; // 3 — compatible server families
const sFree = STATS[3];    // $0 — forever, and open source

/* ---------------------------------------------------------------------------
 * Deterministic noise. The shelves want the irregularity of real records, but a
 * build must be byte-identical every time, so Math.random is out.
 * ------------------------------------------------------------------------- */
function prng(seed: number) {
  let t = seed >>> 0;
  return () => {
    t += 0x6d2b79f5;
    let x = Math.imul(t ^ (t >>> 15), 1 | t);
    x ^= x + Math.imul(x ^ (x >>> 7), 61 | x);
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = prng(20260822);
const r2 = (n: number) => Math.round(n * 100) / 100;

/* ---------------------------------------------------------------------------
 * THE HALL — one-point perspective inside the doorway.
 *
 * The interior SVG is 360x780 (the doorway's own 9:19.5). The vanishing point
 * sits at eye level, a little above the middle. `P(s)` returns the four edges of
 * the hall at depth `s`, where s=1 is the doorway plane itself and s→0 is the
 * vanishing point. Depths fall off geometrically, which is what makes the
 * recession read as distance rather than as a flat fan of lines.
 * ------------------------------------------------------------------------- */
const VPX = 180;
const VPY = 330;
const BW = 360;
const BH = 780;
const P = (s: number) => ({
  s,
  l: VPX * (1 - s),
  r: VPX + (BW - VPX) * s,
  t: VPY * (1 - s),
  b: VPY + (BH - VPY) * s,
});
const DEPTH = [1, 0.7, 0.485, 0.335, 0.23, 0.155];

/** Warm record spines, with a few cool ones so the wall is not one hue. */
const SPINE = [
  '#e8a04a', '#c9622c', '#8f3f14', '#f0c479', '#b8452c',
  '#5b6f8a', '#9a5b8c', '#d98b3a', '#7a4a2a', '#ddd0b6',
  '#4f7d74', '#e2743f',
];

interface Face { d: string; f: string; o: number }

/**
 * A wall of shelved records running from the doorway back to the vanishing
 * point: bay panels, four shelf boards per bay, and individual spines whose
 * heights vary so the row has a top edge you can read.
 */
function shelfWall(side: 'l' | 'r') {
  const bays: Face[] = [];
  const boards: string[] = [];
  const spines: Face[] = [];
  const rows: [number, number][] = [
    [0.17, 0.35], [0.38, 0.56], [0.59, 0.77], [0.8, 0.96],
  ];

  for (let i = 0; i < DEPTH.length - 1; i++) {
    const n = P(DEPTH[i]);
    const f = P(DEPTH[i + 1]);
    const nx = side === 'l' ? n.l : n.r;
    const fx = side === 'l' ? f.l : f.r;
    const fade = 0.9 - i * 0.09;

    bays.push({
      d: `M${r2(nx)},${r2(n.t)} L${r2(fx)},${r2(f.t)} L${r2(fx)},${r2(f.b)} L${r2(nx)},${r2(n.b)} Z`,
      f: i % 2 ? '#20132a' : '#271830',
      o: 1,
    });

    for (const [t0, t1] of rows) {
      const nTop = n.t + (n.b - n.t) * t0;
      const nBot = n.t + (n.b - n.t) * t1;
      const fTop = f.t + (f.b - f.t) * t0;
      const fBot = f.t + (f.b - f.t) * t1;

      // the board the records stand on
      boards.push(
        `M${r2(nx)},${r2(nBot)} L${r2(fx)},${r2(fBot)}`
      );

      const N = 5;
      for (let k = 0; k < N; k++) {
        const u0 = k / N;
        const u1 = (k + 0.82) / N;
        const h = 0.6 + rand() * 0.4;
        const x0 = nx + (fx - nx) * u0;
        const x1 = nx + (fx - nx) * u1;
        const b0 = nBot + (fBot - nBot) * u0;
        const b1 = nBot + (fBot - nBot) * u1;
        const t0y = b0 - (b0 - (nTop + (fTop - nTop) * u0)) * h;
        const t1y = b1 - (b1 - (nTop + (fTop - nTop) * u1)) * h;
        spines.push({
          d: `M${r2(x0)},${r2(t0y)} L${r2(x1)},${r2(t1y)} L${r2(x1)},${r2(b1)} L${r2(x0)},${r2(b0)} Z`,
          f: SPINE[Math.floor(rand() * SPINE.length)],
          o: fade,
        });
      }
    }
  }
  return { bays, boards, spines };
}

const wallL = shelfWall('l');
const wallR = shelfWall('r');

/** Floor and ceiling bays, for the receding boards under and over the hall. */
const hallFloor = DEPTH.slice(0, -1).map((s, i) => {
  const n = P(s);
  const f = P(DEPTH[i + 1]);
  return {
    d: `M${r2(n.l)},${r2(n.b)} L${r2(n.r)},${r2(n.b)} L${r2(f.r)},${r2(f.b)} L${r2(f.l)},${r2(f.b)} Z`,
    f: i % 2 ? '#180f1f' : '#1d1325',
  };
});
const hallCeil = DEPTH.slice(0, -1).map((s, i) => {
  const n = P(s);
  const f = P(DEPTH[i + 1]);
  return {
    d: `M${r2(n.l)},${r2(n.t)} L${r2(n.r)},${r2(n.t)} L${r2(f.r)},${r2(f.t)} L${r2(f.l)},${r2(f.t)} Z`,
    f: i % 2 ? '#150d1c' : '#190f21',
  };
});

/** The mix path: a lit ribbon of stepping stones running out of the hall. */
const RIB = 58;
const ribbon = (() => {
  const n = P(1);
  const f = P(0.155);
  return `M${r2(VPX - RIB)},${r2(n.b)} L${r2(VPX + RIB)},${r2(n.b)} L${r2(VPX + RIB * f.s)},${r2(f.b)} L${r2(VPX - RIB * f.s)},${r2(f.b)} Z`;
})();
const stones = [0.94, 0.8, 0.68, 0.575, 0.485, 0.41, 0.345, 0.29, 0.24, 0.2].map((s) => {
  const p = P(s);
  const w = 92 * s;
  const h = 15 * s;
  return { x: r2(VPX - w / 2), y: r2(p.b - h), w: r2(w), h: r2(h), r: r2(5 * s), o: r2(0.28 + s * 0.5) };
});

/** The strip light running along the ceiling of the hall, into the distance. */
const stripLight = (() => {
  const n = P(1);
  const f = P(0.155);
  return `M${VPX - 10},${r2(n.t)} L${VPX + 10},${r2(n.t)} L${r2(VPX + 10 * f.s)},${r2(f.t)} L${r2(VPX - 10 * f.s)},${r2(f.t)} Z`;
})();

/** The listening stage, mid-hall: a dais, a standing disc, a beam from above. */
const STAGE_S = 0.4;
const stage = P(STAGE_S);

/** Radio rings leaving the stage and swelling toward the doorway. */
const rings = [0, 1, 2, 3, 4, 5].map((i) => {
  const k = i / 5;
  return {
    cy: r2(486 + k * 190),
    rx: r2(44 + k * 210),
    ry: r2(11 + k * 62),
    o: r2(0.5 - k * 0.36),
    w: r2(2.6 - k * 1.2),
    d: r2(i * 1.3),
  };
});

/* ---------------------------------------------------------------------------
 * WHAT COMES THROUGH — sleeves that have crossed the threshold into the room.
 * Positions are relative to the portal box, so they always emerge from the
 * doorway's mouth no matter how the viewport is shaped. `s` is the forced-
 * perspective scale: the nearer to the viewer, the larger.
 * ------------------------------------------------------------------------- */
const SLEEVE_ART = [
  // concentric rings, with the brand red as the label
  '<rect width="100" height="100" fill="#1d1226"/><circle cx="50" cy="50" r="35" fill="none" stroke="#e8a04a" stroke-width="7"/><circle cx="50" cy="50" r="21" fill="none" stroke="#c9622c" stroke-width="7"/><circle cx="50" cy="50" r="8" fill="#d6002b"/>',
  // hard diagonal split
  '<rect width="100" height="100" fill="#f0c479"/><path d="M0,100 L100,0 L100,100 Z" fill="#b8452c"/><rect x="11" y="11" width="30" height="9" fill="#1d1226"/><rect x="11" y="26" width="18" height="6" fill="#1d1226" opacity="0.7"/>',
  // level meter
  '<rect width="100" height="100" fill="#12232a"/><g fill="#4fd6c4"><rect x="14" y="58" width="11" height="28"/><rect x="31" y="40" width="11" height="46"/><rect x="48" y="24" width="11" height="62"/><rect x="65" y="46" width="11" height="40"/></g><rect x="14" y="14" width="34" height="7" fill="#e8a04a"/>',
  // dot grid
  '<rect width="100" height="100" fill="#2a1730"/><g fill="#f0c479">' +
    [0, 1, 2, 3].map((y) => [0, 1, 2, 3].map((x) => `<circle cx="${20 + x * 20}" cy="${20 + y * 20}" r="${x === 1 && y === 2 ? 9 : 5}"/>`).join('')).join('') +
    '</g><circle cx="40" cy="60" r="4" fill="#d6002b"/>',
  // stacked arcs
  '<rect width="100" height="100" fill="#1a1420"/><path d="M6,94 A88,88 0 0 1 94,6" fill="none" stroke="#e2743f" stroke-width="9"/><path d="M6,94 A62,62 0 0 1 68,32" fill="none" stroke="#9a5b8c" stroke-width="9"/><path d="M6,94 A34,34 0 0 1 40,60" fill="none" stroke="#4fd6c4" stroke-width="9"/>',
  // horizon band
  '<rect width="100" height="100" fill="#e6dcc6"/><rect y="52" width="100" height="48" fill="#2a1730"/><circle cx="50" cy="52" r="19" fill="#d6002b"/><rect y="48" width="100" height="4" fill="#1d1226"/>',
];

const TILES = [
  { x: 2, y: -54, s: 0.32, r: -9, art: 0, d: 0, disc: false },
  { x: -40, y: 4, s: 0.46, r: 13, art: 2, d: 1.2, disc: false },
  { x: 46, y: 52, s: 0.6, r: -11, art: 4, d: 0.6, disc: false },
  { x: -158, y: 92, s: 0.95, r: -14, art: 1, d: 1.8, disc: true },
  { x: 172, y: 62, s: 1.02, r: 12, art: 3, d: 2.3, disc: false },
  { x: -268, y: 18, s: 0.78, r: 18, art: 5, d: 0.9, disc: false },
  { x: 292, y: -38, s: 0.7, r: -16, art: 0, d: 1.5, disc: true },
  { x: -352, y: 162, s: 1.34, r: 7, art: 4, d: 2.7, disc: false },
  { x: 372, y: 178, s: 1.42, r: -6, art: 2, d: 2.1, disc: false },
];

/** Where the three real server marks hang inside the hall. */
const PLAQUES = [
  { name: 'Plex', x: 19, y: 47, s: 0.8, c: '#e5a00d' },
  { name: 'Jellyfin', x: 50, y: 31, s: 0.62, c: '#00a4dc' },
  { name: 'Navidrome', x: 81, y: 49, s: 0.8, c: '#3f8fd0' },
];

/**
 * Six niches, each carrying its own engraved glyph. Drawn rather than borrowed:
 * three doors, a crate, a lens over a stack, a lit path, a wave and a fader.
 */
const GLYPH = [
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M6 30V10l9-4v28z"/><path d="M21 30V8l9 3v19z"/><path d="M33 30V14l7 3v13z"/><path d="M3 30h42"/></g>',
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M7 16h34v18H7z"/><path d="M7 22h34M7 28h34"/><path d="M15 16V7h8v9M27 16V9h7v7"/><path d="M24 4v7m0 0 3-3m-3 3-3-3"/></g>',
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="20" cy="18" r="10"/><path d="M27 25l9 9"/><path d="M6 34h20M6 39h12"/></g>',
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M24 6v9M24 33v9M8 24h9M31 24h9"/><circle cx="24" cy="24" r="7"/><path d="M13 13l5 5M35 13l-5 5M13 35l5-5M35 35l-5-5"/></g>',
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="24" cy="26" r="4"/><path d="M17 19a10 10 0 0 0 0 14M31 19a10 10 0 0 1 0 14"/><path d="M11 13a18 18 0 0 0 0 26M37 13a18 18 0 0 1 0 26"/></g>',
  '<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 6v34M24 6v34M36 6v34"/><rect x="7" y="14" width="10" height="6" rx="2" fill="currentColor" stroke="none"/><rect x="19" y="26" width="10" height="6" rx="2" fill="currentColor" stroke="none"/><rect x="31" y="18" width="10" height="6" rx="2" fill="currentColor" stroke="none"/></g>',
];

/** The four fixtures this world does not contain: drawn as absences. */
const ABSENT = [
  // a turnstile with no arm
  '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M24 40V22"/><circle cx="24" cy="18" r="6"/><path d="M12 40h24"/><path d="M30 18h14" stroke-dasharray="4 5" opacity="0.42"/><path d="M18 18H4" stroke-dasharray="4 5" opacity="0.42"/></g>',
  // an empty ledger stand
  '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 12h28v26H10z" stroke-dasharray="5 6" opacity="0.42"/><path d="M24 38v-8"/><path d="M14 44h20"/></g>',
  // a meter with no needle
  '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 32a16 16 0 0 1 32 0"/><path d="M8 32h32"/><path d="M24 32l10-9" stroke-dasharray="4 5" opacity="0.4"/><circle cx="24" cy="32" r="2.4" fill="currentColor" stroke="none"/></g>',
  // an open shackle
  '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="12" y="22" width="24" height="18" rx="3"/><path d="M18 22v-5a6 6 0 0 1 12 0"/><path d="M30 17v5" stroke-dasharray="4 4" opacity="0.4"/></g>',
];

const SHELF_SHOTS = ['mozz-album-red', 'mozz-artist', 'mozz-album-warm', 'mozz-playlist', 'mozz-album-dark'];

const heroLabel =
  'A colossal doorway the shape of a phone stands in a dark room. Through it a warm hall recedes: walls of shelved records running back to a vanishing point, a lit path of stepping stones down the middle, and a raised stage part way in where a record stands upright under a beam of light, throwing rings of sound out toward the doorway. Album sleeves drift out of the opening into the room and grow as they come, light spills across the floor, and crates of downloaded records sit in the near foreground, cut off by the bottom of the frame.';
---

<Layout
  title={`${NAME} — step into the library you already own`}
  description="A free, open source iPhone and iPad music player for Plex, Jellyfin and Navidrome. Your library, your server, your files — streamed or downloaded, with no account and nothing tracking you."
  themeColor="#0a0710"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="pt">
    <VariantBar slug="portal" tone="neutral" />

    <!-- =====================================================================
         FIRST VIEWPORT — the room, the doorway, and what is coming through it
    ====================================================================== -->
    <section class="hero">
      <div class="sky" aria-hidden="true"></div>

      <!-- Far field only. Nothing here has to meet the floor or the doorway,
           so the slice crop can move freely with the viewport. -->
      <svg class="scenery" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="pt-airglow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffb257" stop-opacity="0" />
            <stop offset="1" stop-color="#ffb257" stop-opacity="0.13" />
          </linearGradient>
          <linearGradient id="pt-beam" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd6a0" stop-opacity="0.16" />
            <stop offset="1" stop-color="#ffd6a0" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- ceiling joists of the viewer's own room, running back overhead -->
        <g stroke="#2a1d30" stroke-width="8" fill="none" opacity="0.85">
          <path d="M-60,-40 L560,196" />
          <path d="M300,-60 L700,190" />
          <path d="M1660,-40 L1040,196" />
          <path d="M1300,-60 L900,190" />
        </g>
        <g stroke="#1d1424" stroke-width="26" fill="none" opacity="0.9">
          <path d="M-60,120 L1660,120" />
          <path d="M-60,44 L1660,44" />
        </g>

        <!-- shelving in the viewer's room, silhouetted at both edges -->
        <g fill="#160f1d">
          <path d="M-60,150 H210 V1060 H-60 Z" />
          <path d="M1390,150 H1660 V1060 H1390 Z" />
        </g>
        <g fill="#241832">
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <>
              <rect x="-60" y={196 + i * 128} width="264" height="15" />
              <rect x={1396} y={196 + i * 128} width="264" height="15" />
            </>
          ))}
        </g>
        <g opacity="0.5">
          {[0, 1, 2, 3, 4, 5].map((i) =>
            [0, 1, 2, 3, 4, 5, 6, 7].map((k) => (
              <rect
                x={-52 + k * 32}
                y={196 + i * 128 - (54 + ((i * 7 + k * 5) % 4) * 11)}
                width="22"
                height={54 + ((i * 7 + k * 5) % 4) * 11}
                fill={SPINE[(i * 5 + k * 3) % SPINE.length]}
                opacity="0.5"
              />
            ))
          )}
          {[0, 1, 2, 3, 4, 5].map((i) =>
            [0, 1, 2, 3, 4, 5, 6, 7].map((k) => (
              <rect
                x={1404 + k * 32}
                y={196 + i * 128 - (54 + ((i * 3 + k * 7) % 4) * 11)}
                width="22"
                height={54 + ((i * 3 + k * 7) % 4) * 11}
                fill={SPINE[(i * 7 + k * 5) % SPINE.length]}
                opacity="0.5"
              />
            ))
          )}
        </g>

        <!-- air lit by the doorway -->
        <rect x="0" y="420" width="1600" height="580" fill="url(#pt-airglow)" />
        <path d="M700,150 L900,150 L1180,1000 L420,1000 Z" fill="url(#pt-beam)" />

        <!-- dust hanging in the light -->
        <g fill="#ffd6a0" class="motes">
          {Array.from({ length: 34 }).map((_, i) => {
            const x = r2(240 + rand() * 1120);
            const y = r2(220 + rand() * 700);
            const rr = r2(1 + rand() * 2.6);
            return <circle cx={x} cy={y} r={rr} opacity={r2(0.12 + rand() * 0.36)} style={`--md:${r2(rand() * 9)}s`} />;
          })}
        </g>
      </svg>

      <!-- A genuine perspective plane: the boards converge on the doorway by
           construction, so no crop can knock them out of alignment. -->
      <div class="floor" aria-hidden="true"><div class="floor__grid"></div></div>

      <!-- Everything that must line up with the doorway lives in here. -->
      <div class="core">
        <div class="halo" aria-hidden="true"></div>

        <div class="portal">
          <svg class="hall" viewBox="0 0 360 780" preserveAspectRatio="xMidYMid slice" role="img" aria-label={heroLabel}>
            <defs>
              <radialGradient id="pt-far" cx="0.5" cy="0.42" r="0.6">
                <stop offset="0" stop-color="#ffd9a6" stop-opacity="0.95" />
                <stop offset="0.45" stop-color="#ff9d3d" stop-opacity="0.42" />
                <stop offset="1" stop-color="#ff9d3d" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="pt-ribbon" x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#ffc478" stop-opacity="0.55" />
                <stop offset="1" stop-color="#ffe6bd" stop-opacity="0.1" />
              </linearGradient>
              <linearGradient id="pt-cone" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fff0d2" stop-opacity="0.42" />
                <stop offset="1" stop-color="#ffb257" stop-opacity="0.04" />
              </linearGradient>
              <linearGradient id="pt-haze" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0a0710" stop-opacity="0.55" />
                <stop offset="0.4" stop-color="#0a0710" stop-opacity="0" />
                <stop offset="1" stop-color="#0a0710" stop-opacity="0.5" />
              </linearGradient>
              <linearGradient id="pt-strip" x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#ffe9c6" stop-opacity="0.8" />
                <stop offset="1" stop-color="#ffe9c6" stop-opacity="0.18" />
              </linearGradient>
            </defs>

            <rect width="360" height="780" fill="#100a17" />

            <!-- the end of the hall, still lit -->
            <rect
              x={r2(P(0.155).l)} y={r2(P(0.155).t)}
              width={r2(P(0.155).r - P(0.155).l)} height={r2(P(0.155).b - P(0.155).t)}
              fill="#241633"
            />
            <ellipse cx={VPX} cy={VPY + 26} rx="150" ry="150" fill="url(#pt-far)" />

            <g>{hallCeil.map((q) => <path d={q.d} fill={q.f} />)}</g>
            <g>{hallFloor.map((q) => <path d={q.d} fill={q.f} />)}</g>

            <!-- the mix path, running out of the hall toward the threshold -->
            <path d={ribbon} fill="url(#pt-ribbon)" />
            <g fill="#ffdca6">
              {stones.map((s) => <rect x={s.x} y={s.y} width={s.w} height={s.h} rx={s.r} opacity={s.o} />)}
            </g>

            <!-- shelved records, both walls -->
            <g>
              {wallL.bays.map((q) => <path d={q.d} fill={q.f} />)}
              {wallR.bays.map((q) => <path d={q.d} fill={q.f} />)}
            </g>
            <g>
              {wallL.spines.map((q) => <path d={q.d} fill={q.f} opacity={q.o} />)}
              {wallR.spines.map((q) => <path d={q.d} fill={q.f} opacity={q.o} />)}
            </g>
            <g stroke="#3a2740" stroke-width="2.4" fill="none" opacity="0.85" stroke-linecap="square">
              {wallL.boards.map((d) => <path d={d} />)}
              {wallR.boards.map((d) => <path d={d} />)}
            </g>

            <!-- strip light overhead -->
            <path d={stripLight} fill="url(#pt-strip)" />

            <!-- the listening stage, mid-hall -->
            <path
              d={`M${VPX - 15},${r2(stage.t)} L${VPX + 15},${r2(stage.t)} L${VPX + 86},${r2(stage.b)} L${VPX - 86},${r2(stage.b)} Z`}
