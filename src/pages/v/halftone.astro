---
/**
 * VARIANT — HALFTONE
 *
 * The next generation of the Eclipse hero study.
 *
 * Eclipse set MOZZ enormous and sent the app across the middle of it, turning
 * everything it passed over red. Halftone keeps the crossing and changes what
 * the crossing does. The word is not solid at all: it is a field of dots, open
 * and faint at the edges of the frame, closing and darkening as they approach
 * the device, and going to solid red directly behind it. The wordmark focuses
 * around the thing that plays it — the picture is the resolution, not the
 * colour.
 *
 * Every claim comes from src/data/site.ts. Only the hero headline, the hero
 * support line and the meta description are written here.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'It only comes into focus on your own hardware.';
const SUPPORT =
  'Mozz plays the library sitting on the server in your house — over the network at home, or straight off the phone with nothing connected at all.';

/** Invented sleeves. Nothing here names a real record or artist. */
const DRIFT = [
  { title: 'Screen Angle', artist: 'Halden Rill', art: 'coarse' },
  { title: 'Fine Grain', artist: 'Paper Cinema', art: 'fine' },
  { title: 'Dot Gain', artist: 'North Window', art: 'gradient' },
  { title: 'Solid Area', artist: 'Quiet Motor', art: 'solid' },
  { title: 'Resolution', artist: 'Field Assembly', art: 'ring' },
  { title: 'Under Colour', artist: 'June Current', art: 'coarse' },
  { title: 'Rosette', artist: 'Glass Arcade', art: 'gradient' },
  { title: 'Full Tone', artist: 'Common Weather', art: 'solid' },
] as const;

const WALL = [
  'coarse', 'fine', 'gradient', 'solid', 'ring', 'coarse', 'gradient', 'fine',
  'solid', 'ring', 'gradient', 'coarse', 'fine', 'solid', 'ring', 'gradient',
  'fine', 'coarse', 'ring', 'solid', 'gradient', 'fine', 'coarse', 'ring',
];
---

<Layout
  title={`${NAME} — it only comes into focus on your own hardware`}
  description="Mozz is a free, open source music player for iPhone and iPad. Connect Plex, Jellyfin or a Subsonic server such as Navidrome, listen at home over your own network, or download albums and play them with no connection."
  themeColor="#0a0a0c"
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Instrument+Sans:wdth,wght@75..100,400..700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <VariantBar slug="halftone" tone="cool" />

  <main class="ht">
    <!-- ================================================================ --
      -- HERO — the word as a screen of dots, resolving at the device     --
      -- ================================================================ -->
    <section class="hero" aria-labelledby="ht-h1">
      <div class="plate" aria-hidden="true">
        <!-- open dots everywhere -->
        <div class="word open"><span>MOZZ</span></div>
        <!-- closing up as it nears the device -->
        <div class="word mid"><span>MOZZ</span></div>
        <!-- solid ink directly behind it -->
        <div class="word full"><span>MOZZ</span></div>
        <span class="focus"></span>
      </div>

      <header class="top">
        <a class="lockup" href="/" aria-label={`${NAME} home`}>
          <Mark size={26} decorative />
          <b>{NAME}</b>
          <i aria-hidden="true"></i>
          <span>self&#8209;hosted music player</span>
        </a>
        <span class="fine">free forever &middot; gpl&#8209;3.0 &middot; no account</span>
      </header>

      <div class="say">
        <p class="eyebrow">For iPhone and iPad</p>
        <h1 id="ht-h1">{HEADLINE}</h1>
        <p class="support">{SUPPORT}</p>

        <p class="works">
          <span class="works-tag">plays from</span>
          {SERVERS.map((s) => (
            <span class="works-one"><ServerLogo name={s.name} size={15} />{s.name}</span>
          ))}
          <span class="works-one">Subsonic</span>
        </p>

        <div class="actions">
          {APP_STORE_URL ? (
            <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
          ) : (
            <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
          )}
          <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
        </div>
      </div>

      <div
        class="phone hero-phone"
        role="img"
        aria-label="An iPhone running Mozz, playing a downloaded album from a home server."
      >
        <div class="screen">
          <span class="island" aria-hidden="true"></span>

          <div class="status" aria-hidden="true">
            <span>9:41</span>
            <span class="glyphs">
              <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              <svg viewBox="0 0 26 12">
                <rect x="1" y="1" width="20" height="10" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                <rect x="3" y="3" width="14" height="6" rx="1.4"></rect>
                <path d="M23 4.3v3.4a1.9 1.9 0 0 0 0-3.4z"></path>
              </svg>
            </span>
          </div>

          <div class="scr-head" aria-hidden="true">
            <svg class="chev" viewBox="0 0 16 16"
              ><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
            <span>playing from your server</span>
            <span class="eq"><i></i><i></i><i></i></span>
          </div>

          <div class="art" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs>
                <radialGradient id="ht-fade" cx="50%" cy="46%" r="52%">
                  <stop offset="0%" stop-color="#fff" stop-opacity="1"></stop>
                  <stop offset="58%" stop-color="#fff" stop-opacity="0.45"></stop>
                  <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
                </radialGradient>
                <mask id="ht-mask">
                  <rect width="120" height="120" fill="url(#ht-fade)"></rect>
                </mask>
                <pattern id="ht-dots" width="7" height="7" patternUnits="userSpaceOnUse">
                  <circle cx="3.5" cy="3.5" r="2.5" fill="#ece6da"></circle>
                </pattern>
              </defs>
              <rect width="120" height="120" fill="#131318"></rect>
              <rect width="120" height="120" fill="url(#ht-dots)" mask="url(#ht-mask)"></rect>
              <circle cx="60" cy="55" r="21" fill="#c80028"></circle>
              <rect x="16" y="96" width="52" height="4" fill="#ece6da" opacity="0.7"></rect>
              <rect x="16" y="105" width="30" height="4" fill="#ece6da" opacity="0.34"></rect>
            </svg>
          </div>

          <div class="meta">
            <strong>Screen Angle</strong>
            <span>Halden Rill &middot; Paper Weather</span>
          </div>

          <div class="bar" aria-hidden="true"><i></i></div>
          <div class="times" aria-hidden="true"><span>1:47</span><span>&minus;2:25</span></div>

          <div class="ctrl" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M17.4 3.4v13.2L7.6 10z"></path><rect x="2.6" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
            <span class="play"><svg viewBox="0 0 20 20"><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.3"></rect><rect x="11.1" y="4.4" width="3.3" height="11.2" rx="1.3"></rect></svg></span>
            <svg viewBox="0 0 20 20"><path d="M2.6 3.4v13.2L12.4 10z"></path><rect x="14.8" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg>
          </div>

          <div class="pill" aria-hidden="true">
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#ece6da" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>downloaded &middot; plays offline</span>
          </div>

          <span class="home" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- SERVERS                                                          --
      -- ================================================================ -->
    <section class="band servers" aria-labelledby="ht-servers">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Sources</p>
            <h2 id="ht-servers">Point it at the server you already run.</h2>
          </div>
          <p class="lede">
            Mozz signs in to yours and mirrors the catalog into a database on the device, so
            browsing and search keep answering when the server does not.
          </p>
        </div>

        <ol class="rows" role="list">
          {SERVERS.map((s, i) => (
            <li>
              <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="row-logo"><ServerLogo name={s.name} size={28} /></span>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </li>
          ))}
          <li>
            <span class="row-no">&mdash;</span>
            <span class="row-logo row-logo-plain" aria-hidden="true">S</span>
            <h3>Subsonic &amp; OpenSubsonic</h3>
            <p>
              Navidrome is the tested OpenSubsonic target. Other compatible servers are
              best&#8209;effort, and the source is public if yours needs a look.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- SPLIT PAYOFF — split against the screen itself. One side is      --
      -- fully resolved, the other is the same picture with the server    --
      -- taken away, and it is still all there.                           --
      -- ================================================================ -->
    <section class="band split" aria-labelledby="ht-split">
      <div class="split-grid">
        <div class="half connected">
          <span class="half-screen" aria-hidden="true"></span>
          <div class="half-body">
            <p class="kicker"><span class="tick"></span>Connected</p>
            <h2 id="ht-split">Streaming</h2>
            <p>
              At home Mozz reads from the Plex, Jellyfin or OpenSubsonic server on your own
              network. Your files at the quality you keep them, over a wire nobody else owns.
            </p>
            <ol class="marks" role="list">
              <li><b>01</b>The whole catalog indexed on the device</li>
              <li><b>02</b>Gapless queue, so an album runs as one piece</li>
              <li><b>03</b>Seventy-five milliseconds from tap to first note</li>
            </ol>
          </div>
        </div>

        <div class="seam" aria-hidden="true"></div>

        <div class="half cut">
          <span class="half-screen" aria-hidden="true"></span>
          <div class="half-body">
            <p class="kicker"><span class="tick"></span>Cut off</p>
            <h2>Offline</h2>
            <p>
              Downloads are part of the design, not an afterthought. Take a record into a
              tunnel and the picture does not degrade: it is the same app doing the same job.
            </p>
            <ol class="marks" role="list">
              <li><b>01</b>Browsing and search answer with the server unreachable</li>
              <li><b>02</b>Mozz Weekly is built on the device, so it travels</li>
              <li><b>03</b>No degraded mode and no reconnect prompt</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- MARQUEE PAYOFF — a drifting strip that comes into focus at the   --
      -- centre of the frame and falls out of it at the edges.            --
      -- ================================================================ -->
    <section class="band feature" aria-labelledby="ht-feature">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Featured</p>
            <h2 id="ht-feature">A new mix every week, out of music you already own.</h2>
          </div>
          <p class="lede">
            Mozz Weekly builds a fresh set from your own library. It runs on the device and
            stays available offline, so discovery never depends on somebody else's catalogue.
          </p>
        </div>
      </div>

      <div class="drift" aria-hidden="true">
        <div class="drift-track">
          {[0, 1].map(() => (
            <>
              {DRIFT.map((d) => (
                <figure class="sleeve">
                  <span class={`sleeve-art art-${d.art}`}></span>
                  <figcaption><b>{d.title}</b><span>{d.artist}</span></figcaption>
                </figure>
              ))}
            </>
          ))}
        </div>
        <span class="drift-fade drift-fade-l"></span>
        <span class="drift-fade drift-fade-r"></span>
      </div>

      <div class="shell">
        <p class="drift-note">
          Radio, shuffle and mixes can be sharpened by MusicBrainz and ListenBrainz when
          enrichment is enabled. Turn it off and local, genre&#8209;based recommendations
          still work.
        </p>
      </div>
    </section>

    <!-- ================================================================ --
      -- PAIR PAYOFF — iPhone and iPad, resolving on scroll               --
      -- ================================================================ -->
    <section class="band pair" aria-labelledby="ht-pair">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Both devices</p>
            <h2 id="ht-pair">One app, on the iPhone and the iPad.</h2>
          </div>
          <p class="lede">
            Written in SwiftUI for iOS and iPadOS 17 or later. The same library, the same
            downloads, the same player, laid out for whichever screen you picked up.
          </p>
        </div>
      </div>

      <div class="rig" role="img" aria-label="An iPad and an iPhone side by side, both running Mozz.">
        <div class="tablet">
          <div class="tab-screen">
            <div class="tab-side" aria-hidden="true">
              <span class="tab-lock"><Mark size={16} decorative /><b>Mozz</b></span>
              <span class="tab-nav is-on">Library</span>
              <span class="tab-nav">Albums</span>
              <span class="tab-nav">Artists</span>
              <span class="tab-nav">Downloads</span>
              <span class="tab-nav">Mozz Weekly</span>
              <span class="tab-nav">Radio</span>
            </div>
            <div class="tab-main" aria-hidden="true">
              <span class="tab-title">Albums</span>
              <div class="tab-grid">
                {['coarse', 'fine', 'gradient', 'solid', 'ring', 'coarse', 'gradient', 'fine', 'solid', 'ring', 'gradient', 'coarse', 'fine', 'solid', 'ring', 'gradient', 'fine', 'coarse', 'ring', 'solid', 'gradient', 'fine', 'coarse', 'ring'].map((k) => (
                  <span class={`tile art-${k}`}></span>
                ))}
              </div>
              <div class="tab-now">
                <span class="tab-now-art art-gradient"></span>
                <span class="tab-now-txt"><b>Screen Angle</b><span>Halden Rill</span></span>
                <span class="tab-now-bar"><i></i></span>
                <span class="tab-now-eq"><i></i><i></i><i></i></span>
              </div>
            </div>
          </div>
        </div>

        <div class="phone pair-phone">
          <div class="screen">
            <span class="island" aria-hidden="true"></span>
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="glyphs">
                <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              </span>
            </div>
            <div class="scr-head" aria-hidden="true">
              <svg class="chev" viewBox="0 0 16 16"><path d="M3 6.2 8 11l5-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <span>downloads</span>
              <span class="eq"><i></i><i></i><i></i></span>
            </div>
            <ul class="list" aria-hidden="true">
              {DRIFT.slice(0, 5).map((d) => (
                <li>
                  <span class={`list-art art-${d.art}`}></span>
                  <span class="list-txt"><b>{d.title}</b><span>{d.artist}</span></span>
                  <svg class="list-tick" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#c80028"></circle><path d="M4.9 8.2 6.9 10.3 11 5.9" fill="none" stroke="#ece6da" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </li>
              ))}
            </ul>
            <span class="home" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- WHAT IT DOES                                                     --
      -- ================================================================ -->
    <section class="band does" aria-labelledby="ht-does">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>The app</p>
            <h2 id="ht-does">Seven things it does, at full resolution.</h2>
          </div>
          <p class="lede">
            None of this is aspirational and none of it sits behind a paid tier, because
            there is no paid tier for it to sit behind.
          </p>
        </div>

        <ol class="does-list" role="list">
          {FEATURES.map((f, i) => (
            <li>
              <span class="does-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================================================================ --
      -- TRUST, over the wall used only as decoration                     --
      -- ================================================================ -->
    <section class="band trust" aria-labelledby="ht-trust">
      <div class="wall" aria-hidden="true">
        {WALL.map((k) => <span class={`wall-tile art-${k}`}></span>)}
      </div>

      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>What is not here</p>
            <h2 id="ht-trust">Four things Mozz does not have.</h2>
          </div>
          <p class="lede">
            The case for keeping your own music is mostly a case about what is absent from
            the app that plays it.
          </p>
        </div>

        <div class="own">
          {OWNERSHIP.map((o) => (
            <article>
              <h3><span class="dot" aria-hidden="true"></span>{o.title}</h3>
              <p>{o.body}</p>
            </article>
          ))}
        </div>

        <dl class="stats">
          {STATS.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================================================================ --
      -- FAQ                                                              --
      -- ================================================================ -->
    <section class="band faq" aria-labelledby="ht-faq">
      <div class="shell">
        <div class="head">
          <div>
            <p class="kicker"><span class="tick"></span>Questions</p>
            <h2 id="ht-faq">Plain answers.</h2>
          </div>
          <p class="lede">
            If an answer is missing here, the source, the docs and the issue tracker are all
            public.
          </p>
        </div>

        <div class="faq-list">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}<span class="sign" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ --
      -- CLOSE                                                            --
      -- ================================================================ -->
    <footer class="close" aria-labelledby="ht-close">
      <div class="shell">
        <div class="final">
          <div>
            <h2 id="ht-close">{TAGLINE}</h2>
            <p class="close-sub">{SUBLINE}</p>
          </div>

          <div>
            <div class="actions">
              {APP_STORE_URL ? (
                <a class="btn go" href={APP_STORE_URL}>Download on the App Store</a>
              ) : (
                <span class="btn go is-pending" aria-disabled="true">Coming to the App Store</span>
              )}
              <a class="btn src" href={GITHUB_URL} rel="noopener">Read the source</a>
            </div>
            <p class="final-fine">
              Free forever, open source under GPL&#8209;3.0. Every feature is in the free
              app, because there is no other kind.
            </p>
          </div>
        </div>

        <p class="colophon">
          <span>iPhone and iPad &middot; iOS 17 or later</span>
          <span>Plex &middot; Jellyfin &middot; Subsonic &middot; OpenSubsonic</span>
        </p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .ht {
    --void: #0a0a0c;
    --raise: #131318;
    --red: #c80028;
    --cream: #ece6da;
    --dim: rgba(236, 230, 218, 0.66);
    --faint: rgba(236, 230, 218, 0.4);
    --hair: rgba(236, 230, 218, 0.14);

    /* the point the screen resolves around */
    --fx: 62%;
    --fy: 62%;

    position: relative;
    overflow-x: clip;
    background: var(--void);
    color: var(--cream);
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  /* ================================ hero ================================ */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    padding: clamp(56px, 6vh, 78px) clamp(18px, 4vw, 60px) clamp(190px, 31vh, 320px);
  }

  .plate {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .word {
    position: absolute;
    inset: 0;
  }

  .word span {
    position: absolute;
    left: 50%;
    bottom: -6%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: 'Archivo Black', 'Arial Black', system-ui;
    font-weight: 400;
    font-size: 30vw;
    line-height: 0.74;
    letter-spacing: -0.03em;
    /*
     * The letterform is a window onto a screen of dots rather than a solid
     * shape. background-clip: text is what makes the type itself carry the
     * halftone instead of having a pattern laid over the top of it.
     */
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* the open screen: wide pitch, small dot, faint — the edges of the frame */
  .word.open span {
    background-image: radial-gradient(circle at 50% 50%, var(--cream) 0 1.6px, transparent 1.8px);
    background-size: 15px 15px;
    opacity: 0.5;
  }

  /* mid tone: tighter pitch, fatter dot, brought up close to the device */
  .word.mid span {
    background-image: radial-gradient(circle at 50% 50%, var(--cream) 0 3.1px, transparent 3.4px);
    background-size: 11px 11px;
  }

  .word.mid {
    -webkit-mask-image: radial-gradient(58% 46% at var(--fx) var(--fy), #000 0 34%, rgba(0, 0, 0, 0.55) 60%, transparent 100%);
    mask-image: radial-gradient(58% 46% at var(--fx) var(--fy), #000 0 34%, rgba(0, 0, 0, 0.55) 60%, transparent 100%);
  }

  /* full tone: solid red, only immediately behind the device */
  .word.full span {
    background-image: linear-gradient(var(--red), var(--red));
  }

  .word.full {
    -webkit-mask-image: radial-gradient(30% 26% at var(--fx) var(--fy), #000 0 46%, transparent 100%);
    mask-image: radial-gradient(30% 26% at var(--fx) var(--fy), #000 0 46%, transparent 100%);
  }

  /* the light the screen resolves in */
  .focus {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      44% 40% at var(--fx) var(--fy),
      rgba(200, 0, 40, 0.26) 0%,
      rgba(200, 0, 40, 0.08) 44%,
      transparent 78%
    );
  }

  /* --- the words on top ---------------------------------------------- */

  .top {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--hair);
  }

  .lockup {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    font-size: 13px;
  }

  .lockup b {
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: -0.02em;
  }

  .lockup i { width: 1px; height: 13px; background: var(--faint); }
  .lockup span { color: var(--dim); }

  .fine,
  .works-tag,
  .eyebrow {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .say {
    position: relative;
    z-index: 3;
    align-self: center;
    max-width: 31rem;
    padding: clamp(14px, 3vh, 36px) 0;
  }

  .eyebrow { margin-bottom: 0.9rem; }

  h1 {
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 50px);
    line-height: 1.05;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .support {
    max-width: 34ch;
    margin-top: 1.05rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.1vw, 16.5px);
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.95rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .works-one {
    display: inline-flex;
    gap: 0.34rem;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--dim);
  }

  .works-one :global(.server-logo) { color: var(--red); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.15rem;
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
    transition: transform 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .btn.go { background: var(--red); color: #fff; }

  .btn.go.is-pending {
    background: transparent;
    border: 1px dashed rgba(200, 0, 40, 0.8);
    color: #ff6b86;
  }

  .btn.src { border: 1px solid var(--hair); color: var(--cream); }

  .btn:hover { transform: translateY(-2px); }
  .btn.src:hover { border-color: var(--faint); }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  /* --- the phone ------------------------------------------------------ */

  .phone {
    width: var(--pw, clamp(196px, 17.5vw, 300px));
    aspect-ratio: 71.6 / 147.6;
    padding: 0.7%;
    border-radius: clamp(24px, 2.4vw, 40px);
    background: linear-gradient(158deg, #34333c, #101015 66%);
    box-shadow:
      inset 0 0 0 1px rgba(236, 230, 218, 0.2),
      0 40px 90px -34px rgba(0, 0, 0, 0.95);
  }

  .hero-phone {
    position: absolute;
    z-index: 2;
    left: var(--fx);
    top: var(--fy);
    --pw: clamp(180px, 15.5vw, 262px);
    transform: translate(-50%, -46%);
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 7.4% 6.4% 4.6%;
    border-radius: clamp(21px, 2.1vw, 35px);
    overflow: hidden;
    background: linear-gradient(180deg, #17171d, #0b0b10 78%);
    color: var(--cream);
    container-type: inline-size;
  }

  .island {
    position: absolute;
    top: 3.1%;
    left: 50%;
    width: 30%;
    height: 3.1%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050508;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 3.4cqw;
    font-weight: 700;
  }

  .glyphs { display: inline-flex; gap: 3%; align-items: center; }
  .glyphs svg { height: 3.1cqw; width: auto; fill: currentColor; }

  .scr-head {
    display: flex;
    gap: 3%;
    align-items: center;
    margin-top: 7%;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 2.6cqw;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .chev { width: 3.6cqw; flex: none; }
  .scr-head span:not(.eq) { flex: 1; }

  .eq {
    display: inline-flex;
    gap: 0.8cqw;
    align-items: flex-end;
    height: 3.4cqw;
  }

  .eq i {
    width: 1.1cqw;
    background: var(--red);
    animation: eq 1.15s ease-in-out infinite;
  }

  .eq i:nth-child(1) { height: 55%; }
  .eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .eq i:nth-child(3) { height: 72%; animation-delay: 0.36s; }

  @keyframes eq {
    0%, 100% { transform: scaleY(0.45); }
    50% { transform: scaleY(1); }
  }

  .art {
    margin-top: 6%;
    border-radius: 2.4cqw;
    overflow: hidden;
  }

  .art svg { width: 100%; height: auto; }

  .meta { margin-top: 7%; }

  .meta strong {
    display: block;
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: 5.4cqw;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .meta span {
    display: block;
    margin-top: 1.4%;
    font-size: 3.4cqw;
    color: var(--faint);
  }

  .bar {
    margin-top: 6.5%;
    height: 0.9cqw;
    border-radius: 999px;
    background: rgba(236, 230, 218, 0.16);
  }

  .bar i { display: block; width: 46%; height: 100%; border-radius: 999px; background: var(--red); }

  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 2.4%;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 2.6cqw;
    color: var(--faint);
  }

  .ctrl {
    display: flex;
    gap: 9%;
    align-items: center;
    justify-content: center;
    margin-top: 6.5%;
  }

  .ctrl svg { width: 6.4cqw; fill: var(--cream); }

  .play {
    display: inline-grid;
    place-items: center;
    width: 14cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  .play svg { width: 6.4cqw; fill: #fff; }

  .pill {
    display: flex;
    gap: 2.6%;
    align-items: center;
    margin-top: auto;
    padding: 2.6% 3.4%;
    border-radius: 999px;
    background: rgba(236, 230, 218, 0.07);
    font-size: 3cqw;
    color: var(--dim);
  }

  .pill svg { width: 4cqw; flex: none; }

  .home {
    width: 34%;
    height: 0.9cqw;
    margin: 4% auto 0;
    border-radius: 999px;
    background: rgba(236, 230, 218, 0.4);
  }

  /* ============================== bands ================================= */

  .band {
    position: relative;
    padding: clamp(66px, 9vh, 128px) 0;
    border-top: 1px solid var(--hair);
  }

  .shell {
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin-inline: auto;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(18px, 4vw, 68px);
    align-items: end;
  }

  .kicker {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tick { width: 9px; height: 9px; border-radius: 50%; background: var(--red); }

  h2 {
    max-width: 15ch;
    margin-top: 0.85rem;
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: clamp(25px, 3.1vw, 42px);
    line-height: 1.06;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .lede {
    max-width: 46ch;
    padding-bottom: 0.4rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
  }

  h3 {
    font-family: 'Instrument Sans', system-ui;
    font-weight: 700;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  /* --- servers as rows -------------------------------------------------- */

  .rows {
    margin-top: clamp(28px, 4vh, 48px);
    border-top: 1px solid var(--hair);
  }

  .rows li {
    display: grid;
    grid-template-columns: 3.2rem 3.4rem minmax(0, 0.7fr) minmax(0, 1.4fr);
    gap: clamp(12px, 2vw, 34px);
    align-items: center;
    padding: clamp(16px, 2.2vh, 26px) 0;
    border-bottom: 1px solid var(--hair);
  }

  .row-no {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--red);
  }

  .row-logo { color: var(--cream); }

  .row-logo-plain {
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: 26px;
    line-height: 1;
  }

  .rows p { color: var(--dim); font-size: 14.5px; }

  /* --- split payoff ------------------------------------------------------ */

  .split { padding-block: 0; }

  .split-grid { display: grid; grid-template-columns: 1fr 1px 1fr; }

  .half {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(52px, 8vh, 108px) clamp(24px, 4.4vw, 76px);
  }

  /*
   * The split is against the screen itself. One half is printed at full
   * resolution, the other at a coarse open screen — and the point is that the
   * same picture is there in both. Neither half is the lesser half.
   */
  /*
   * The two screens carry the same picture at two resolutions, but they are
   * masked back off the copy — a halftone under running text is a legibility
   * problem, and the comparison reads perfectly well as a band at the head of
   * each half.
   */
  .half-screen {
    position: absolute;
    inset: 0;
    z-index: -1;
    -webkit-mask-image: linear-gradient(180deg, #000 0 16%, rgba(0, 0, 0, 0.35) 34%, transparent 52%);
    mask-image: linear-gradient(180deg, #000 0 16%, rgba(0, 0, 0, 0.35) 34%, transparent 52%);
  }

  .connected .half-screen {
    background-image: radial-gradient(circle at 50% 50%, var(--cream) 0 1.7px, transparent 1.9px);
    background-size: 8px 8px;
    opacity: 0.3;
  }

  .cut .half-screen {
    background-image: radial-gradient(circle at 50% 50%, var(--cream) 0 2.8px, transparent 3.1px);
    background-size: 22px 22px;
    opacity: 0.3;
  }

  .cut { background: var(--raise); }

  .seam { background: var(--red); }

  .half h2 {
    max-width: none;
    margin-top: 0.55rem;
    font-size: clamp(32px, 4.4vw, 58px);
  }

  .half-body > p {
    max-width: 36ch;
    margin-top: 1rem;
    color: var(--dim);
    font-size: clamp(14.5px, 1.05vw, 16.5px);
  }

  .marks {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--hair);
  }

  .marks li {
    display: flex;
    gap: 0.75rem;
    font-size: 14.4px;
    color: var(--dim);
  }

  .marks b {
    flex: none;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.85;
    color: var(--red);
  }

  /* --- marquee payoff ---------------------------------------------------- */

  .drift {
    position: relative;
    overflow: hidden;
    margin: clamp(32px, 5vh, 56px) 0;
    padding: 4px 0;
  }

  .drift-track {
    display: flex;
    gap: clamp(14px, 1.6vw, 24px);
    width: max-content;
    animation: drift 68s linear infinite;
  }

  @keyframes drift {
    to { transform: translateX(-50%); }
  }

  .drift:hover .drift-track { animation-play-state: paused; }

  .sleeve { width: clamp(140px, 14vw, 200px); flex: none; }

  .sleeve-art {
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--hair);
  }

  .sleeve figcaption {
    display: block;
    margin-top: 0.6rem;
    font-size: 12.5px;
    line-height: 1.35;
  }

  .sleeve figcaption b { display: block; font-weight: 700; }
  .sleeve figcaption span { display: block; color: var(--faint); }

  .drift-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(40px, 8vw, 130px);
    pointer-events: none;
  }

  .drift-fade-l { left: 0; background: linear-gradient(90deg, var(--void), transparent); }
  .drift-fade-r { right: 0; background: linear-gradient(270deg, var(--void), transparent); }

  .drift-note { max-width: 58ch; color: var(--faint); font-size: 13.5px; }

  /* the invented sleeves, all built out of the same screen */
  .art-coarse {
    background:
      radial-gradient(circle at 50% 50%, var(--red) 0 4px, transparent 4.4px) 0 0 / 14px 14px,
      var(--raise);
  }

  .art-fine {
    background:
      radial-gradient(circle at 50% 50%, var(--cream) 0 1.5px, transparent 1.7px) 0 0 / 7px 7px,
      linear-gradient(180deg, var(--red) 0 34%, var(--raise) 34%);
  }

  .art-gradient {
    background:
      radial-gradient(circle at 50% 50%, var(--cream) 0 2.6px, transparent 2.9px) 0 0 / 10px 10px,
      radial-gradient(circle at 50% 46%, var(--red) 0 40%, transparent 74%),
      var(--raise);
  }

  .art-solid {
    background:
      linear-gradient(180deg, transparent 0 46%, var(--raise) 46%),
      radial-gradient(circle at 50% 50%, var(--raise) 0 2.2px, transparent 2.5px) 0 0 / 9px 9px,
      var(--red);
  }

  .art-ring {
    background:
      radial-gradient(circle at 50% 50%, transparent 0 30%, var(--red) 30% 44%, transparent 44%),
      radial-gradient(circle at 50% 50%, var(--cream) 0 1.6px, transparent 1.8px) 0 0 / 8px 8px,
      var(--raise);
  }

  /* --- pair payoff -------------------------------------------------------- */

  .rig {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: min(1120px, calc(100% - clamp(36px, 8vw, 120px)));
    margin: clamp(30px, 4vh, 52px) auto 0;
  }

  .tablet {
    width: clamp(310px, 52vw, 720px);
    aspect-ratio: 248 / 179;
    flex: none;
    padding: 1.1%;
    border-radius: clamp(16px, 1.8vw, 28px);
    background: linear-gradient(152deg, #3b3a44, #131318 66%);
    box-shadow:
      inset 0 0 0 1px rgba(236, 230, 218, 0.2),
      0 44px 90px -40px rgba(0, 0, 0, 0.95);
  }

  .tab-screen {
    display: grid;
    grid-template-columns: 26% 1fr;
    height: 100%;
    border-radius: clamp(11px, 1.3vw, 20px);
    overflow: hidden;
    background: #16161c;
    container-type: inline-size;
  }

  .tab-side {
    display: flex;
    flex-direction: column;
    gap: 1.8cqw;
    padding: 3cqw 2.4cqw;
    border-right: 1px solid var(--hair);
    background: #1d1d25;
  }

  .tab-lock {
    display: flex;
    gap: 1.1cqw;
    align-items: center;
    margin-bottom: 1.2cqw;
    font-size: 1.9cqw;
  }

  .tab-lock b { font-family: 'Archivo Black', system-ui; font-weight: 400; }

  .tab-nav { font-size: 1.6cqw; color: var(--dim); }

  .tab-nav.is-on { position: relative; color: var(--cream); font-weight: 700; }

  .tab-nav.is-on::before {
    content: '';
    position: absolute;
    left: -2.2cqw;
    top: 0.35em;
    width: 0.7cqw;
    height: 0.7cqw;
    border-radius: 50%;
    background: var(--red);
  }

  .tab-main {
    display: flex;
    flex-direction: column;
    padding: 3cqw 2.6cqw 2.4cqw;
  }

  .tab-title {
    display: block;
    margin-bottom: 2.2cqw;
    font-family: 'Archivo Black', system-ui;
    font-weight: 400;
    font-size: 3cqw;
    letter-spacing: -0.03em;
  }

  .tab-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.8cqw;
  }

  .tile { aspect-ratio: 1; border: 1px solid var(--hair); }

  .tab-now {
    display: flex;
    gap: 1.6cqw;
    align-items: center;
    margin-top: auto;
    padding-top: 2.2cqw;
    border-top: 1px solid var(--hair);
  }

  .tab-now-art { width: 4cqw; aspect-ratio: 1; flex: none; }
  .tab-now-txt { flex: none; }
  .tab-now-txt b { display: block; font-size: 1.7cqw; font-weight: 700; }
  .tab-now-txt > span { display: block; font-size: 1.4cqw; color: var(--faint); }

  .tab-now-bar { flex: 1; height: 0.4cqw; border-radius: 999px; background: rgba(236, 230, 218, 0.16); }
  .tab-now-bar i { display: block; width: 38%; height: 100%; border-radius: 999px; background: var(--red); }

  .tab-now-eq {
    display: inline-flex;
    gap: 0.4cqw;
    align-items: flex-end;
    height: 1.9cqw;
    flex: none;
  }

  .tab-now-eq i {
    width: 0.55cqw;
    background: var(--red);
    animation: eq 1.15s ease-in-out infinite;
  }

  .tab-now-eq i:nth-child(1) { height: 55%; }
  .tab-now-eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .tab-now-eq i:nth-child(3) { height: 72%; animation-delay: 0.36s; }

  .pair-phone {
    --pw: clamp(150px, 19.5vw, 272px);
    position: relative;
    z-index: 2;
    margin-left: clamp(-56px, -3.4vw, -18px);
    margin-bottom: clamp(-24px, -1.6vw, -8px);
  }

  .list {
    display: grid;
    gap: 3.4%;
    margin-top: 7%;
    padding: 0;
    list-style: none;
  }

  .list li { display: flex; gap: 3.4%; align-items: center; }

  .list-art { width: 15%; aspect-ratio: 1; flex: none; border: 1px solid var(--hair); }
  .list-txt { flex: 1; min-width: 0; }

  .list-txt b {
    display: block;
    font-size: 3.5cqw;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .list-txt span { display: block; font-size: 2.9cqw; color: var(--faint); }
  .list-tick { width: 4.4cqw; flex: none; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tablet {
        animation: rise-tab linear both;
        animation-timeline: view();
        animation-range: entry 4% entry 88%;
      }

      .pair-phone {
        animation: rise-phone linear both;
        animation-timeline: view();
        animation-range: entry 12% entry 100%;
      }
    }
  }

  @keyframes rise-tab {
    from { transform: translateY(30px) scale(0.972); opacity: 0.55; }
    to { transform: none; opacity: 1; }
  }

  @keyframes rise-phone {
    from { transform: translate(40px, 52px) rotate(3.5deg); opacity: 0.4; }
    to { transform: none; opacity: 1; }
  }

  /* --- what it does -------------------------------------------------------- */

  .does-list {
    margin-top: clamp(28px, 4vh, 48px);
    border-top: 1px solid var(--hair);
  }

  .does-list li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 0.85fr) minmax(0, 1.5fr);
    gap: clamp(12px, 2vw, 40px);
    align-items: start;
    padding: clamp(16px, 2.2vh, 26px) 0;
    border-bottom: 1px solid var(--hair);
  }

  .does-no {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 2.1;
    color: var(--red);
  }

  .does-list p { color: var(--dim); font-size: 14.6px; }

  /* --- trust ---------------------------------------------------------------- */

  .trust {
    isolation: isolate;
    overflow: clip;
    background: var(--raise);
  }

  .wall {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 12px;
    padding: 12px;
    opacity: 0.2;
    -webkit-mask-image: radial-gradient(122% 94% at 50% 46%, transparent 0 40%, #000 90%);
    mask-image: radial-gradient(122% 94% at 50% 46%, transparent 0 40%, #000 90%);
    pointer-events: none;
  }

  .wall-tile { aspect-ratio: 1; }

  .own {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(228px, 1fr));
    gap: clamp(22px, 2.6vw, 38px);
    margin-top: clamp(28px, 4vh, 48px);
  }

  .own article { padding-top: 0.9rem; border-top: 1px solid var(--cream); }

  .own h3 { display: flex; gap: 0.5rem; align-items: baseline; }

  .own .dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--red); }

  .own p { margin-top: 0.45rem; color: var(--dim); font-size: 14.4px; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(20px, 2.6vw, 40px);
    margin-top: clamp(32px, 4.6vh, 58px);
    padding-top: clamp(22px, 3vh, 38px);
    border-top: 1px solid var(--hair);
