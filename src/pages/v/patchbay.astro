---
/**
 * VARIANT — PATCHBAY
 *
 * A hard vertical rack of bolted modules. Red patch cables route signal from
 * source to device, making the ownership argument literal: you choose the path,
 * and no company sits between the jacks.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME, TAGLINE, SUBLINE, SERVERS, FEATURES, OWNERSHIP, STATS, FAQS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'You own the signal path.';
const PRODUCT_LINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT = 'Patch in Plex, Jellyfin or Navidrome, then route the same library to streaming at home and downloads with no signal.';
const OUTPUTS = [
  {
    unit: 'OUT A',
    title: 'Home network',
    label: 'streaming',
    body: 'Mozz talks directly to your server over the network you already run. There is no Mozz login, relay or subscription tier between the input jack and your headphones.',
  },
  {
    unit: 'OUT B',
    title: 'No signal at all',
    label: 'offline',
    body: 'Download a record and the route stays closed when the server cannot be reached. Browsing, search and playback keep moving from the device itself.',
  },
];
const SOCKET_X = Array.from({ length: 12 }, (_, i) => 82 + i * 54);
const TOP_JACKS = SOCKET_X.map((x, i) => ({ x, y: 132, no: String(i + 1).padStart(2, '0') }));
const BOTTOM_JACKS = SOCKET_X.map((x, i) => ({ x, y: 342, no: String(i + 1).padStart(2, '0') }));
const SOURCE_GROUPS = SERVERS.map((server, i) => ({ label: server.name.toUpperCase(), x: 163 + i * 216 }));
const OUTPUT_GROUPS = ['PHONE', 'IPAD', 'OFFLINE'].map((label, i) => ({ label, x: 163 + i * 216 }));
const HERO_CABLES = [
  { start: TOP_JACKS[1], end: BOTTOM_JACKS[1], d: 'M136 132 C76 206 78 276 136 342', startAngle: 108, endAngle: -28 },
  { start: TOP_JACKS[5], end: BOTTOM_JACKS[5], d: 'M352 132 C432 206 430 276 352 342', startAngle: 136, endAngle: 28 },
  { start: TOP_JACKS[9], end: BOTTOM_JACKS[10], d: 'M568 132 C690 204 700 286 622 342', startAngle: 138, endAngle: -18 },
];

---

<Layout
  title={`${NAME} — you own the signal path`}
  description="A free, open-source iPhone and iPad music player for your own Plex, Jellyfin or Navidrome server. Stream at home, download for offline, with no account and no tracking."
  themeColor="#17181b"
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="patchbay">
    <VariantBar slug="patchbay" tone="neutral" />

    <div class="rack">
      <header class="unit hero-unit" aria-labelledby="pb-hero">
        <span class="screw tl" aria-hidden="true"></span>
        <span class="screw tr" aria-hidden="true"></span>
        <span class="screw bl" aria-hidden="true"></span>
        <span class="screw br" aria-hidden="true"></span>
        <div class="unit-top">
          <span class="unit-label">1U MASTER</span>
          <span class="unit-no">MZ-PB-01</span>
        </div>

        <nav class="lockbar" aria-label="Mozz">
          <a class="lockup" href={GITHUB_URL} aria-label={`${NAME} on GitHub`}>
            <Mark size={32} decorative />
            <span>{NAME}</span>
          </a>
          <span class="engraved">FREE FOREVER / GPL-3.0</span>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <h1 id="pb-hero">{HEADLINE}</h1>
            <p class="product-line">{PRODUCT_LINE}</p>
            <p class="support">{SUPPORT}</p>
            <div class="actions">
              {APP_STORE_URL ? (
                <a class="store" href={APP_STORE_URL}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                  <span><small>Download on the</small>App Store</span>
                </a>
              ) : (
                <span class="store is-pending" aria-disabled="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                  <span><small>Coming to the</small>App Store</span>
                </span>
              )}
              <a class="source-link" href={GITHUB_URL}>See the source on GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <figure class="patch-field" aria-label="Patchbay field routing servers to phone, iPad and offline outputs.">
            <svg viewBox="0 0 760 520" preserveAspectRatio="xMidYMid meet" role="img">
              <defs>
                <linearGradient id="pb-cable" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0" stop-color="#f13a55" />
                  <stop offset="1" stop-color="#9d001f" />
                </linearGradient>
                <radialGradient id="pb-jack" cx="42%" cy="32%" r="60%">
                  <stop offset="0" stop-color="#f4f1eb" />
                  <stop offset="0.38" stop-color="#9a9a9d" />
                  <stop offset="0.62" stop-color="#303137" />
                  <stop offset="1" stop-color="#09090b" />
                </radialGradient>
              </defs>
              <rect x="18" y="18" width="724" height="484" rx="16" fill="#17181b" stroke="#e4e2dd" stroke-opacity="0.2" />
              <g class="jack-labels top-labels">
                {SOURCE_GROUPS.map((group) => (
                  <g>
                    <rect class="label-plate" x={group.x - 74} y="52" width="148" height="24" rx="4" />
                    <text x={group.x} y="68" text-anchor="middle">{group.label}</text>
                  </g>
                ))}
              </g>
              <g class="jack-row">
                {TOP_JACKS.map((jack) => (
                  <g transform={`translate(${jack.x} ${jack.y})`}>
                    <circle r="17" fill="url(#pb-jack)" />
                    <circle r="7" fill="#030304" />
                    <text class="socket-no" y="48" text-anchor="middle">{jack.no}</text>
                  </g>
                ))}
              </g>
              <g class="jack-labels bottom-labels">
                {OUTPUT_GROUPS.map((group) => (
                  <g>
                    <rect class="label-plate" x={group.x - 74} y="392" width="148" height="24" rx="4" />
                    <text x={group.x} y="408" text-anchor="middle">{group.label}</text>
                  </g>
                ))}
              </g>
              <g class="jack-row">
                {BOTTOM_JACKS.map((jack) => (
                  <g transform={`translate(${jack.x} ${jack.y})`}>
                    <circle r="17" fill="url(#pb-jack)" />
                    <circle r="7" fill="#030304" />
                    <text class="socket-no" y="48" text-anchor="middle">{jack.no}</text>
                  </g>
                ))}
              </g>
              <g class="hero-cables">
                {HERO_CABLES.map((cable) => (
                  <g>
                    <path class="cable-outline" d={cable.d} />
                    <path class="cable" d={cable.d} />
                    <path class="cable-hi" d={cable.d} />
                    <path class="pulse" d={cable.d} />
                  </g>
                ))}
              </g>
              {HERO_CABLES.map((cable) => (
                <g>
                  <g class="plug" transform={`translate(${cable.start.x} ${cable.start.y}) rotate(${cable.startAngle})`}>
                    <rect x="-7" y="-43" width="14" height="44" rx="7" fill="#870018" />
                    <rect x="-5" y="-58" width="10" height="18" rx="5" fill="#d8d4cf" />
                  </g>
                  <g class="plug" transform={`translate(${cable.end.x} ${cable.end.y}) rotate(${cable.endAngle})`}>
                    <rect x="-7" y="0" width="14" height="44" rx="7" fill="#870018" />
                    <rect x="-5" y="40" width="10" height="18" rx="5" fill="#d8d4cf" />
                  </g>
                </g>
              ))}
            </svg>
          </figure>
        </div>
      </header>

      <section class="unit sources-unit" aria-labelledby="pb-sources">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">2U SOURCES</span><span class="unit-no">INPUTS 01-03</span></div>
        <div class="unit-grid intro-grid">
          <div>
            <h2 id="pb-sources">Patch in the server you already run.</h2>
            <p class="unit-lede">Mozz is the player. Your server is the library. The input strips use the real server notes from the shared copy.</p>
          </div>
          <div class="input-strips">
            {SERVERS.map((server, index) => (
              <article class="input-strip">
                <span class="channel">CH {String(index + 1).padStart(2, '0')}</span>
                <span class="strip-logo"><ServerLogo name={server.name} size={34} /></span>
                <div>
                  <h3>{server.name}</h3>
                  <p>{server.note}</p>
                </div>
                <span class="jack" aria-hidden="true"></span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="unit routing-unit" aria-labelledby="pb-routing">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">3U ROUTING</span><span class="unit-no">OUTPUTS A/B</span></div>
        <h2 id="pb-routing">Two outputs from the same source.</h2>
        <div class="routing-grid">
          {OUTPUTS.map((output) => (
            <article class="route-card">
              <span class="channel">{output.unit}</span>
              <span class="short-cable" aria-hidden="true"></span>
              <p class="route-label">{output.label}</p>
              <h3>{output.title}</h3>
              <p>{output.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="unit monitor-unit" aria-labelledby="pb-monitor">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">4U MONITOR</span><span class="unit-no">APP + METERS</span></div>
        <div class="monitor-grid">
          <div class="feature-bank">
            <h2 id="pb-monitor">The app, mounted like a monitor.</h2>
            <ol role="list">
              {FEATURES.map((feature, index) => (
                <li>
                  <span class="channel">KEY {String(index + 1).padStart(2, '0')}</span>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="monitor-stack">
            <div class="phone" role="img" aria-label="An iPhone mounted in the rack, showing Mozz now playing from a server.">
              <div class="phone-screen">
                <span class="island" aria-hidden="true"></span>
                <div class="status" aria-hidden="true">
                  <span>9:41</span>
                  <span class="status-icons">
                    <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z" /></svg>
                    <svg viewBox="0 0 26 12"><rect x="1" y="1" width="21" height="10" rx="2.5" /><path d="M23 4h2v4h-2z" /><rect x="3" y="3" width="14" height="6" rx="1" /></svg>
                  </span>
                </div>
                <div class="app-head"><Mark size={20} decorative /><span>Playing from your server</span></div>
                <div class="album-art" aria-hidden="true">
                  <svg viewBox="0 0 240 240">
                    <rect width="240" height="240" fill="#e4e2dd" />
                    <rect x="0" y="0" width="92" height="240" fill="#c80028" />
                    <circle cx="128" cy="112" r="64" fill="#17181b" />
                    <circle cx="128" cy="112" r="24" fill="#e4e2dd" />
                    <path d="M36 192 C88 154 143 166 198 128" fill="none" stroke="#c80028" stroke-width="10" stroke-linecap="round" />
                    <path d="M42 208 H168" stroke="#17181b" stroke-width="5" />
                  </svg>
                </div>
                <div class="track-copy"><strong>Patch Memory</strong><span>Relay Floor · Line Check</span></div>
                <div class="scrub"><span></span></div>
                <div class="controls-phone" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 5v14M16 6 6 12l10 6z" /></svg><span><svg viewBox="0 0 24 24"><rect x="7" y="5" width="4" height="14" rx="1" /><rect x="13" y="5" width="4" height="14" rx="1" /></svg></span><svg viewBox="0 0 24 24"><path d="M6 5v14M8 6l10 6-10 6z" /></svg></div>
                <div class="offline-badge"><span></span>downloaded · plays offline</div>
                <span class="home-indicator" aria-hidden="true"></span>
              </div>
            </div>

            <div class="meter-bank" aria-label="Mozz measured stats">
              {STATS.map((stat, index) => (
                <div class="led-meter">
                  <span class="channel">M{String(index + 1).padStart(2, '0')}</span>
                  <strong>{stat.value}</strong>
                  <em>{stat.label}</em>
                  <svg viewBox="0 0 180 44" aria-hidden="true">
                    {Array.from({ length: 12 }).map((_, i) => (
                      <rect x={8 + i * 14} y="12" width="8" height="20" rx="2" class={i <= 8 - index ? 'hot' : ''} />
                    ))}
                  </svg>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="unit terms-unit" aria-labelledby="pb-terms">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">5U TERMS</span><span class="unit-no">OWNERSHIP</span></div>
        <div class="terms-grid">
          <div>
            <h2 id="pb-terms">The routing table is short.</h2>
            <p class="unit-lede">Free forever, open source under GPL-3.0, and built around the idea that your files stay on hardware you control.</p>
          </div>
          <div class="terms-list">
            {OWNERSHIP.map((item) => (
              <article>
                <span class="led" aria-hidden="true"></span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="unit faq-unit" aria-labelledby="pb-faq">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">6U FAQ</span><span class="unit-no">SERVICE MANUAL</span></div>
        <h2 id="pb-faq">Service notes</h2>
        <div class="faq-list">
          {FAQS.map((faq, index) => (
            <details>
              <summary><span>Q{String(index + 1).padStart(2, '0')}</span><b>{faq.q}</b></summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <footer class="unit output-unit" aria-labelledby="pb-output">
        <span class="screw tl" aria-hidden="true"></span><span class="screw tr" aria-hidden="true"></span><span class="screw bl" aria-hidden="true"></span><span class="screw br" aria-hidden="true"></span>
        <div class="unit-top"><span class="unit-label">7U OUTPUT</span><span class="unit-no">MAIN OUT</span></div>
        <div class="output-grid">
          <div>
            <div class="footer-lockup"><Mark size={34} decorative /><span>{NAME}</span></div>
            <h2 id="pb-output">{TAGLINE}</h2>
            <p class="subline">{SUBLINE}</p>
            <div class="actions">
              {APP_STORE_URL ? (
                <a class="store" href={APP_STORE_URL}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                  <span><small>Download on the</small>App Store</span>
                </a>
              ) : (
                <span class="store is-pending" aria-disabled="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
                  <span><small>Coming to the</small>App Store</span>
                </span>
              )}
              <a class="source-link" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
            </div>
            <p class="fine-print">Recommendations can ask MusicBrainz and ListenBrainz what sounds similar to an artist and title. That request carries no name, no server address and no account, and it can be switched off in Settings.</p>
          </div>
          <svg class="final-cable" viewBox="0 0 360 220" aria-hidden="true">
            <path class="cable-outline" d="M60 28 C150 76 196 122 304 196" />
            <path class="cable" d="M60 28 C150 76 196 122 304 196" />
            <path class="cable-hi" d="M60 28 C150 76 196 122 304 196" />
            <path class="pulse" d="M60 28 C150 76 196 122 304 196" />
            <circle cx="60" cy="28" r="19" fill="#111" stroke="#e4e2dd" stroke-opacity="0.5" />
            <circle cx="60" cy="28" r="7" fill="#030304" />
          </svg>
        </div>
      </footer>
    </div>
  </main>
</Layout>

<style>
  :global(html) { background: #17181b; }
  :global(body) {
    margin: 0;
    background: #17181b;
    color: #e4e2dd;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .patchbay {
    --rack: #17181b;
    --panel: #232429;
    --panel-hi: #2c2d33;
    --bone: #e4e2dd;
    --muted: rgba(228, 226, 221, 0.66);
    --dim: rgba(228, 226, 221, 0.38);
    --red: #c80028;
    --red-hi: #f13855;
    --line: rgba(228, 226, 221, 0.18);
    min-height: 100vh;
    background:
      radial-gradient(80vw 60vw at 92% 0%, rgba(200, 0, 40, 0.12), transparent 58%),
      linear-gradient(180deg, #111215, var(--rack));
    overflow-x: clip;
  }

  .rack {
    width: min(1380px, 100% - clamp(1rem, 4vw, 4rem));
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.2rem) 0 clamp(4rem, 7vw, 6rem);
  }

  .unit {
    position: relative;
    margin-top: 1rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border-radius: 4px;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.026) 0 1px, rgba(0,0,0,0.026) 1px 4px),
      linear-gradient(180deg, var(--panel-hi), var(--panel));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.2),
      inset 0 -1px 0 rgba(0,0,0,0.7),
      0 20px 50px -34px #000;
    border: 1px solid rgba(0,0,0,0.75);
  }

  .hero-unit {
    min-height: calc(100svh - 42px);
    display: flex;
    flex-direction: column;
  }

  .unit-top,
  .channel,
  .engraved,
  .unit-lede,
  .route-label,
  .fine-print,
  .faq-list summary span {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }

  .unit-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-shadow: 0 -1px 0 rgba(0,0,0,0.9), 0 1px 0 rgba(255,255,255,0.12);
  }

  .screw {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f1eee8, #6e6e72 62%, #161719 100%);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.55), 0 1px 0 rgba(255,255,255,0.12);
  }

  .screw::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    top: 8px;
    height: 2px;
    border-radius: 2px;
    background: rgba(0,0,0,0.72);
    transform: rotate(var(--slot, 12deg));
  }

  .tl { top: 12px; left: 12px; --slot: -18deg; }
  .tr { top: 12px; right: 12px; --slot: 24deg; }
  .bl { bottom: 12px; left: 12px; --slot: 8deg; }
  .br { bottom: 12px; right: 12px; --slot: -32deg; }

  .lockbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1.2rem, 3vw, 2rem);
  }

  .lockup,
  .footer-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--bone);
    text-decoration: none;
  }

  .lockup span,
  .footer-lockup span {
