    transition-delay: calc(var(--i, 0) * 90ms);
  }

  :global(html.js) .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------------ servers */

  .servers {
    border-top: 1px solid rgba(20, 16, 26, 0.16);
    overflow: hidden;
  }

  /* The band the app casts, standing over one column. */
  .transit {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: min(var(--band), 62vw);
    transform: translateX(-50%);
    background: linear-gradient(
      to right,
      rgba(216, 0, 45, 0) 0%,
      rgba(216, 0, 45, 0.09) 22%,
      rgba(216, 0, 45, 0.09) 78%,
      rgba(216, 0, 45, 0) 100%
    );
    pointer-events: none;
  }

  .rack {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .rack-item {
    position: relative;
    padding: clamp(20px, 2.2vw, 32px) clamp(18px, 2vw, 30px);
    border: 1px solid rgba(20, 16, 26, 0.2);
    background: var(--stock);
  }

  .rack-item.is-lit {
    background: var(--red);
    border-color: var(--red);
    color: var(--cream);
  }

  .rack-logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.85;
  }

  .rack-item h3 {
    margin-top: 1rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 106%;
    font-size: clamp(19px, 1.7vw, 26px);
    letter-spacing: -0.02em;
  }

  .rack-item p {
    margin-top: 0.5rem;
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.55;
    opacity: 0.72;
  }

  .aside {
    position: relative;
    max-width: 62ch;
    margin-top: clamp(22px, 3vh, 34px);
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.6;
    opacity: 0.68;
  }

  /* ------------------------------------------------- streaming / offline */

  .halves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .half {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.6vw, 40px);
    min-height: clamp(280px, 34vh, 380px);
  }

  .half.is-paper {
    background: var(--stock);
    border: 1px solid rgba(20, 16, 26, 0.2);
  }

  .half.is-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .half-tag {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }

  .half.is-ink .half-tag {
    color: #ff5c7c;
  }

  .half h3 {
    margin-top: 0.8rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 104%;
    font-size: clamp(21px, 2.2vw, 33px);
    line-height: 1.04;
    letter-spacing: -0.026em;
  }

  .half p {
    margin-top: 0.75rem;
    max-width: 42ch;
    font-size: clamp(13px, 1.02vw, 15.5px);
    line-height: 1.58;
    opacity: 0.75;
  }

  .half-illo {
    width: min(220px, 62%);
    height: auto;
    margin-top: auto;
    padding-top: 1.6rem;
    opacity: 0.8;
  }

  /* ------------------------------------------------------------ figures */

  .figures {
    padding-block: clamp(28px, 5vh, 60px);
    background: var(--ink);
    color: var(--paper);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 26px);
  }

  .stats li {
    padding-top: clamp(10px, 1.4vh, 16px);
    border-top: 1px solid rgba(238, 234, 226, 0.28);
  }

  .stats li:first-child {
    border-top-color: var(--red);
  }

  .stats b {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(30px, 3.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .stats li:first-child b {
    color: var(--red);
  }

  .stats span {
    display: block;
    margin-top: 0.5rem;
    font-size: clamp(11.5px, 0.9vw, 13.5px);
    line-height: 1.4;
    opacity: 0.6;
  }

  /* ----------------------------------------------------------- marquee */

  .weekly-body {
    max-width: 54ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    opacity: 0.7;
  }

  .mq {
    position: relative;
    margin-top: clamp(30px, 5vh, 60px);
    overflow: hidden;
  }

  .mq-row {
    position: relative;
    overflow: hidden;
  }

  .mq-track {
    display: flex;
    width: max-content;
    gap: clamp(10px, 1.2vw, 18px);
    will-change: transform;
    animation: drift 62s linear infinite;
  }

  /* The red copy, clipped to the band the app stands in. Same geometry, same
     animation — only the ink changes as a sleeve enters the light. The clip
     lives on a static wrapper, not on the moving track, so the band stays put
     while the sleeves travel through it. */
  .mq-band {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0 calc(50% - var(--band) / 2) 0 calc(50% - var(--band) / 2));
  }

  .mq-band::before,
  .mq-band::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 2px;
    background: rgba(216, 0, 45, 0.55);
  }

  .mq-band::before {
    left: 0;
  }

  .mq-band::after {
    right: 0;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - clamp(5px, 0.6vw, 9px)), 0, 0);
    }
  }

  .mq-cell {
    display: block;
    flex: none;
    width: clamp(118px, 14.5vw, 210px);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .mq-cell :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mq-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(40px, 10vw, 160px);
    pointer-events: none;
  }

  .mq-edge-l {
    left: 0;
    background: linear-gradient(to right, var(--paper), rgba(238, 234, 226, 0));
  }

  .mq-edge-r {
    right: 0;
    background: linear-gradient(to left, var(--paper), rgba(238, 234, 226, 0));
  }

  /* ----------------------------------------------------------- features */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(30px, 5vh, 58px);
    background: rgba(20, 16, 26, 0.2);
    border: 1px solid rgba(20, 16, 26, 0.2);
  }

  .card {
    padding: clamp(24px, 2.8vw, 44px);
    background: var(--paper);
  }

  .card-no {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--red);
  }

  .card h3 {
    margin-top: 0.9rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 104%;
    font-size: clamp(19px, 1.8vw, 28px);
    line-height: 1.08;
    letter-spacing: -0.024em;
  }

  .card p {
    margin-top: 0.6rem;
    max-width: 44ch;
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.58;
    opacity: 0.7;
  }

  /* -------------------------------------------------------------- aloud */

  .aloud {
    border-top: 1px solid rgba(20, 16, 26, 0.16);
  }

  .aloud-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .aloud-body {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    opacity: 0.72;
  }

  .aloud-illo {
    width: 100%;
    height: auto;
    padding: clamp(18px, 2.4vw, 38px);
    border: 1px solid rgba(20, 16, 26, 0.2);
    background: var(--stock);
    color: var(--ink);
  }

  .aloud-illo .aloud-label {
    fill: var(--red);
    font-family: 'DM Mono', ui-monospace, monospace;
  }

  /* -------------------------------------------------------------- split */

  .split {
    position: relative;
    display: grid;
    grid-template-columns: 46% 1fr;
    min-height: clamp(560px, 92svh, 900px);
    border-top: 1px solid rgba(20, 16, 26, 0.16);
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: clamp(40px, 6vh, 90px) clamp(22px, 4vw, 70px);
  }

  .field-diagram {
    background: var(--ink);
    color: var(--paper);
  }

  .diagram {
    width: min(100%, 440px);
    height: auto;
    margin-inline: auto;
  }

  .diagram text {
    fill: var(--paper);
    opacity: 0.6;
  }

  .diagram path[d^='M20 300'] {
    stroke: var(--paper);
    opacity: 0.25;
  }

  .diagram .crosser {
    fill: var(--ink);
    animation: transit 24s ease-in-out infinite;
  }

  @keyframes transit {
    0%,
    100% {
      transform: translateX(-16px);
    }
    50% {
      transform: translateX(34px);
    }
  }

  .field-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: clamp(22px, 3vh, 38px);
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: clamp(10.5px, 0.9vw, 12.5px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .field-note .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
  }

  .field-own {
    background: var(--paper);
  }

  .own {
    position: relative;
    z-index: 2;
    width: min(100%, 640px);
  }

  .own h2 {
    max-width: 14ch;
    margin-top: 0.7rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 110%;
    font-size: clamp(32px, 4.3vw, 66px);
    line-height: 0.94;
    letter-spacing: -0.036em;
  }

  .own ul {
    margin-top: clamp(22px, 3vh, 36px);
  }

  .own li {
    padding-block: clamp(14px, 1.8vh, 22px);
    border-top: 1px solid rgba(20, 16, 26, 0.22);
  }

  .own li:last-child {
    border-bottom: 1px solid rgba(20, 16, 26, 0.22);
  }

  .own h3 {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 104%;
    font-size: clamp(17px, 1.5vw, 23px);
    letter-spacing: -0.02em;
  }

  .own p {
    margin-top: 0.35rem;
    max-width: 48ch;
    font-size: clamp(12.5px, 0.98vw, 14.5px);
    line-height: 1.55;
    opacity: 0.72;
  }

  /* The seam carries the chapter, not another copy of the wordmark. */
  .seam-mark {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(22px, 4vh, 48px);
    pointer-events: none;
  }

  .seam-mark i {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgba(20, 16, 26, 0) 0%,
      rgba(20, 16, 26, 0.42) 22%,
      rgba(20, 16, 26, 0.42) 78%,
      rgba(20, 16, 26, 0) 100%
    );
  }

  .seam-mark span {
    flex: none;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.62;
    writing-mode: vertical-rl;
  }

  /* --------------------------------------------------------------- pair */

  .pair {
    overflow: hidden;
    border-top: 1px solid rgba(20, 16, 26, 0.16);
  }

  .pair-body {
    max-width: 50ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    opacity: 0.7;
  }

  .rig {
    position: relative;
    width: min(100% - var(--pad) * 2, 1000px);
    margin: clamp(34px, 6vh, 74px) auto 0;
    padding-bottom: 7%;
  }

  .pad {
    width: 100%;
    aspect-ratio: 1.43;
    padding: clamp(8px, 0.9vw, 14px);
    border-radius: clamp(16px, 1.9vw, 30px);
    background: #100c14;
    box-shadow:
      0 0 0 1px rgba(20, 16, 26, 0.2),
      0 44px 80px -40px rgba(20, 16, 26, 0.7);
  }

  .pad-screen {
    display: grid;
    grid-template-columns: clamp(120px, 19%, 190px) 1fr;
    height: 100%;
    border-radius: clamp(10px, 1.3vw, 20px);
    overflow: hidden;
    background: #191320;
    color: var(--cream);
  }

  .pad-side {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(12px, 1.5vw, 22px);
    background: rgba(10, 7, 13, 0.6);
    border-right: 1px solid rgba(253, 246, 236, 0.09);
    font-size: clamp(9.5px, 0.86vw, 12.5px);
  }

  .pad-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .pad-brand b {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 110%;
    font-size: 1.15em;
  }

  .pad-nav {
    padding: 0.34rem 0.5rem;
    border-radius: 3px;
    color: rgba(253, 246, 236, 0.55);
  }

  .pad-nav.is-on {
    background: var(--red);
    color: var(--cream);
  }

  .pad-weekly {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(253, 246, 236, 0.12);
    color: rgba(253, 246, 236, 0.66);
  }

  .pad-weekly i {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
  }

  .pad-main {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 1.5vw, 22px);
    min-width: 0;
  }

  .pad-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(10px, 1.2vw, 16px);
  }

  .pad-h {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 106%;
    font-size: clamp(13px, 1.4vw, 22px);
    letter-spacing: -0.02em;
  }

  .pad-search {
    width: clamp(70px, 22%, 190px);
    height: clamp(14px, 1.5vw, 22px);
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.1);
  }

  .pad-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(6px, 0.8vw, 12px);
    align-content: start;
    min-height: 0;
  }

  .pad-tile {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .pad-tile :global(svg),
  .pad-now-art :global(svg),
  .mini-art :global(svg),
  .wall-tile :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pad-now {
    display: grid;
    grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1.6fr) auto;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
    margin-top: auto;
    padding-top: clamp(10px, 1.2vw, 18px);
    border-top: 1px solid rgba(253, 246, 236, 0.12);
  }

  .pad-now-art {
    display: block;
    width: clamp(26px, 3.4vw, 46px);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .pad-now-meta {
    display: grid;
    min-width: 0;
    font-size: clamp(9px, 0.82vw, 12px);
  }

  .pad-now-meta b {
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pad-now-meta i {
    font-style: normal;
    opacity: 0.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pad-now-bar {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.18);
  }

  .pad-now-bar i {
    display: block;
    width: 46%;
    height: 100%;
    border-radius: 999px;
    background: var(--red);
  }

  .pad-now-play {
    width: clamp(18px, 2.2vw, 30px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  .mini {
    position: absolute;
    right: 1.5%;
    bottom: 0;
    width: 18.5%;
    min-width: 84px;
    aspect-ratio: 71.6 / 147.6;
    padding: clamp(4px, 0.5vw, 8px);
    border-radius: clamp(14px, 1.7vw, 26px);
    background: #100c14;
    box-shadow:
      0 0 0 clamp(5px, 0.6vw, 9px) var(--paper),
      0 0 0 calc(clamp(5px, 0.6vw, 9px) + 1px) rgba(20, 16, 26, 0.16),
      0 30px 60px -30px rgba(20, 16, 26, 0.7);
    transform: rotate(3deg);
    transform-origin: 50% 100%;
  }

  .mini-screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(6px, 0.7vw, 11px);
    border-radius: clamp(10px, 1.3vw, 20px);
    background: #191320;
    color: var(--cream);
    overflow: hidden;
    font-size: clamp(6px, 0.62vw, 9px);
  }

  .mini-island {
    width: 34%;
    height: 0.9em;
    margin: 0.2em auto 0.7em;
    border-radius: 999px;
    background: #0a070d;
  }

  .mini-art {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .mini-title {
    margin-top: 0.8em;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 1.15em;
  }

  .mini-sub {
    opacity: 0.55;
  }

  .mini-bar {
    display: block;
    height: 0.28em;
    margin-top: 0.7em;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.2);
  }

  .mini-bar i {
    display: block;
    width: 46%;
    height: 100%;
    border-radius: 999px;
    background: var(--red);
  }

  .mini-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9em;
    margin-top: auto;
  }

  .mini-ctrl i {
    width: 0.7em;
    height: 0.7em;
    background: rgba(253, 246, 236, 0.7);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .mini-ctrl i:first-child {
    transform: scaleX(-1);
  }

  .mini-ctrl b {
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    background: var(--red);
  }

  .mini-chip {
    margin-top: 0.7em;
    text-align: center;
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.8em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .mini-home {
    width: 32%;
    height: 0.25em;
    margin: 0.6em auto 0;
    border-radius: 999px;
    background: rgba(253, 246, 236, 0.45);
  }

  :global(html.js) .rig .pad,
  :global(html.js) .rig .mini {
    opacity: 0;
    transition:
      opacity 0.75s cubic-bezier(0.2, 0.75, 0.2, 1),
      transform 0.75s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  :global(html.js) .rig .pad {
    transform: translateY(58px);
  }

  :global(html.js) .rig .mini {
    transform: translateY(78px) rotate(9deg);
    transition-delay: 160ms;
  }

  :global(html.js) .rig.is-in .pad {
    opacity: 1;
    transform: none;
  }

  :global(html.js) .rig.is-in .mini {
    opacity: 1;
    transform: rotate(3deg);
  }

  /* ---------------------------------------------------------------- faq */

  .faq {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(20, 16, 26, 0.16);
  }

  .wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2px;
    opacity: 0.12;
    pointer-events: none;
    -webkit-mask-image:
      radial-gradient(110% 70% at 84% 30%, #000 0%, rgba(0, 0, 0, 0.28) 44%, transparent 74%),
      linear-gradient(to bottom, transparent 0%, #000 22%, #000 74%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(110% 70% at 84% 30%, #000 0%, rgba(0, 0, 0, 0.28) 44%, transparent 74%),
      linear-gradient(to bottom, transparent 0%, #000 22%, #000 74%, transparent 100%);
    mask-composite: intersect;
  }

  .wall-tile {
