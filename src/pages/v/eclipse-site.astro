---
/**
 * VARIANT — ECLIPSE SITE
 *
 * A direct extension of the hero study at /h/eclipse, not a new idea.
 *
 * The hero is kept: MOZZ set enormous in Archivo and cropped by the bottom of
 * the window, the app standing in front of it, and a band of red running behind
 * the phone — everything the object passes over changes colour, the way light
 * does when something crosses it.
 *
 * That is then the whole document. A transit band runs down the page and each
 * section is lit by what is in front of it: the middle server is the one in the
 * band, the drifting sleeves turn red only while they are inside it, and the
 * split section puts an eclipse diagram against the ownership argument. Ink,
 * paper and one red. No photography — every sleeve is generated below.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  DONATE_URL,
  APP_STORE_URL,
} from '../../data/site';

/* Hardcoded here, and only here: the hero sentence and the meta description. */
const HEADLINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT =
  'Point it at Plex, Jellyfin or Navidrome. Listen at home, or keep an album on the phone and play it with no signal at all.';
const META =
  'Mozz is a free, open source music player for iPhone and iPad. Point it at your own Plex, Jellyfin or Navidrome server, listen at home, or download an album and play it offline.';

const PARITY = [FEATURES[0], FEATURES[1]];
const WEEKLY = FEATURES[5];
const REST = [FEATURES[2], FEATURES[3], FEATURES[4], FEATURES[6]];

/* ------------------------------------------------------------------ sleeves */

/**
 * Invented artwork in two states.
 *
 * Every sleeve is drawn twice from the same geometry: once in ink on paper, and
 * once with the ink swapped for red. Stacking the two and clipping the red copy
 * to a fixed band is the hero's trick, applied to a moving row — a sleeve is
 * only red while it is inside the light.
 */
type Tokens = { p: string; i: string; c: string };

const DARK: Tokens = { p: '#e2ddd3', i: '#14101a', c: '#fdf6ec' };
const LIT: Tokens = { p: '#ffe1e6', i: '#d8002d', c: '#fdf6ec' };

/** Each sleeve is a shape kind plus a ground/mark/accent role triple. */
const SLEEVES: Array<{ k: string; r: [keyof Tokens, keyof Tokens, keyof Tokens] }> = [
  { k: 'transit', r: ['p', 'i', 'c'] },
  { k: 'rule', r: ['i', 'c', 'p'] },
  { k: 'crescent', r: ['c', 'i', 'p'] },
  { k: 'column', r: ['p', 'i', 'c'] },
  { k: 'halfdisc', r: ['i', 'p', 'c'] },
  { k: 'ladder', r: ['c', 'i', 'p'] },
  { k: 'corner', r: ['p', 'i', 'c'] },
  { k: 'orbit', r: ['i', 'c', 'p'] },
  { k: 'stack', r: ['c', 'i', 'p'] },
  { k: 'notch', r: ['p', 'i', 'c'] },
  { k: 'dial', r: ['i', 'c', 'p'] },
  { k: 'grain', r: ['c', 'i', 'p'] },
];

function shapes(kind: string, bg: string, fg: string, ac: string): string {
  switch (kind) {
    case 'transit':
      return `<circle cx="50" cy="48" r="30" fill="${fg}"/>
        <circle cx="66" cy="40" r="30" fill="${bg}"/>
        <rect x="0" y="88" width="100" height="4" fill="${ac}"/>`;
    case 'rule': {
      let out = '';
      for (let i = 0; i < 9; i += 1)
        out += `<rect x="10" y="${12 + i * 8.6}" width="${
          i === 4 ? 80 : 34 + ((i * 17) % 46)
        }" height="2.6" fill="${i === 4 ? ac : fg}" opacity="${i === 4 ? 1 : 0.8}"/>`;
      return out;
    }
    case 'crescent':
      return `<circle cx="46" cy="50" r="32" fill="${fg}"/>
        <circle cx="62" cy="44" r="30" fill="${bg}"/>
        <circle cx="20" cy="20" r="5" fill="${ac}"/>`;
    case 'column': {
      let out = '';
      for (let i = 0; i < 5; i += 1)
        out += `<rect x="${9 + i * 18}" y="${14 + (i % 3) * 9}" width="11" height="${
          72 - (i % 3) * 14
        }" fill="${i === 2 ? ac : fg}"/>`;
      return out;
    }
    case 'halfdisc':
      return `<path d="M50 12a38 38 0 0 1 0 76Z" fill="${fg}"/>
        <path d="M50 12a38 38 0 0 0 0 76Z" fill="${ac}" opacity="0.9"/>
        <circle cx="50" cy="50" r="7" fill="${bg}"/>`;
    case 'ladder': {
      let out = `<rect x="14" y="10" width="3" height="80" fill="${fg}"/><rect x="83" y="10" width="3" height="80" fill="${fg}"/>`;
      for (let i = 0; i < 6; i += 1)
        out += `<rect x="14" y="${16 + i * 14}" width="72" height="4" fill="${
          i === 3 ? ac : fg
        }" opacity="${i === 3 ? 1 : 0.72}"/>`;
      return out;
    }
    case 'corner':
      return `<path d="M0 0H62L0 62Z" fill="${fg}"/>
        <path d="M100 100H44L100 44Z" fill="${ac}"/>`;
    case 'orbit':
      return `<g fill="none" stroke="${fg}" stroke-width="2.6">
          <ellipse cx="50" cy="50" rx="40" ry="15" transform="rotate(-26 50 50)"/>
          <ellipse cx="50" cy="50" rx="40" ry="15" transform="rotate(26 50 50)"/>
        </g><circle cx="50" cy="50" r="9" fill="${ac}"/>`;
    case 'stack': {
      let out = '';
      for (let i = 0; i < 4; i += 1)
        out += `<rect x="${12 + i * 4}" y="${14 + i * 17}" width="${
          76 - i * 8
        }" height="12" fill="${i === 1 ? ac : fg}" opacity="${i === 1 ? 1 : 0.85}"/>`;
      return out;
    }
    case 'notch':
      return `<rect x="0" y="0" width="100" height="46" fill="${fg}"/>
        <rect x="34" y="0" width="32" height="46" fill="${bg}"/>
        <rect x="0" y="58" width="100" height="6" fill="${ac}"/>
        <rect x="0" y="72" width="62" height="6" fill="${fg}" opacity="0.6"/>`;
    case 'dial':
      return `<g fill="none" stroke="${fg}" stroke-width="2.4">
          <circle cx="50" cy="50" r="34"/><circle cx="50" cy="50" r="23"/><circle cx="50" cy="50" r="12"/>
        </g><rect x="49" y="8" width="2.6" height="26" fill="${ac}"/>`;
    case 'grain':
    default: {
      let out = '';
      for (let r = 0; r < 7; r += 1)
        for (let c = 0; c < 7; c += 1)
          out += `<circle cx="${10 + c * 13.4}" cy="${10 + r * 13.4}" r="${
            1.2 + ((r + c) % 4) * 1.1
          }" fill="${r === 3 && c === 3 ? ac : fg}"/>`;
      return out;
    }
  }
}

function sleeve(index: number, lit = false): string {
  const spec = SLEEVES[index % SLEEVES.length];
  const t = lit ? LIT : DARK;
  const [bg, fg, ac] = spec.r.map((role) => t[role]);
  return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">
    <rect width="100" height="100" fill="${bg}"/>${shapes(spec.k, bg, fg, ac)}</svg>`;
}

const DRIFT = Array.from({ length: 12 }, (_, i) => i);
const WALL = Array.from({ length: 60 }, (_, i) => i * 5 + 2);
/* Hand-shuffled rather than a stride, so no two rows of the grid repeat. */
const PAD_TILES = [3, 9, 1, 7, 11, 5, 0, 6, 10, 2, 8, 4, 7, 2, 11, 4, 9, 0, 5, 10, 3, 8, 1, 6];
---

<Layout title={`${NAME} — a free player for the music on your own server`} description={META} themeColor="#eeeae2">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  <VariantBar slug="eclipse-site" tone="cool" />

  <main class="eclipse">
    <!-- ============================================================== HERO
         The study at /h/eclipse, preserved: the word cropped by the frame,
         the app in front of it, and a band of red where the app crosses. -->
    <section class="hero" aria-labelledby="ec-hero">
      <div class="frame">
        <header class="top">
          <a class="lockup" href="#ec-hero">
            <Mark size={24} decorative />
            <b>{NAME}</b>
            <i aria-hidden="true"></i>
            <span>self-hosted music player</span>
          </a>
          <span class="fine">{SUBLINE.toLowerCase()} &middot; gpl-3.0 &middot; no account</span>
        </header>

        <div class="mid">
          <div class="say">
            <h1 id="ec-hero">{HEADLINE}</h1>
            <p>{SUPPORT}</p>
          </div>

          <div class="works">
            <span class="tag">works with</span>
            <ul role="list">
              {SERVERS.map((s) => <li>{s.name}</li>)}
            </ul>
          </div>

          <div class="word" aria-hidden="true">
            <span class="w">MOZZ</span>
            <span class="w lit">MOZZ</span>
          </div>

          <div
            class="phone"
            role="img"
            aria-label="The Mozz now playing screen: an album streaming from your own server, already downloaded to the phone."
          >
            <div class="screen">
              <div class="island"></div>

              <div class="status">
                <span>9:41</span>
                <span class="glyphs">
                  <svg viewBox="0 0 16 16" aria-hidden="true"
                    ><path
                      d="M1.6 7.5 14.3 2.1a.42.42 0 0 1 .55.55L9.45 15.35a.42.42 0 0 1-.78.02L6.35 10.4 1.58 8.28a.42.42 0 0 1 .02-.78z"
                      fill="currentColor"></path></svg
                  >
                  <svg viewBox="0 0 26 12" aria-hidden="true"
                    ><rect
                      x="0.7"
                      y="0.7"
                      width="21"
                      height="10.6"
                      rx="3.2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"></rect><rect
                      x="2.6"
                      y="2.6"
                      width="14"
                      height="6.8"
                      rx="1.8"
                      fill="currentColor"></rect><path
                      d="M23.6 4.2v3.6a2.1 2.1 0 0 0 0-3.6z"
                      fill="currentColor"></path></svg
                  >
                </span>
              </div>

              <div class="scr-head">
                <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"
                  ><path
                    d="M3 6l5 5 5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <span class="from">playing from your server</span>
                <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
              </div>

              <div class="art">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <defs>
                    <clipPath id="ecs-disc"><circle cx="60" cy="54" r="33"></circle></clipPath>
                  </defs>
                  <rect width="120" height="120" fill="#d8002d"></rect>
                  <circle cx="60" cy="54" r="40" fill="none" stroke="#fdf6ec" stroke-width="1.4" opacity="0.34"></circle>
                  <circle cx="60" cy="54" r="33" fill="#f6ece0"></circle>
                  <g clip-path="url(#ecs-disc)">
                    <circle class="umbra" cx="42" cy="51" r="31" fill="#1a0812"></circle>
                  </g>
                  <circle cx="60" cy="54" r="3.6" fill="#d8002d"></circle>
                  <rect x="18" y="104" width="26" height="3" fill="#fdf6ec" opacity="0.5"></rect>
                </svg>
              </div>

              <div class="meta">
                <strong>Umbra</strong>
                <span>Sable Field &middot; Long Shadow</span>
              </div>

              <div class="bar"><span></span></div>
              <div class="times"><span>1:47</span><span>&minus;2:25</span></div>

              <div class="ctrls">
                <svg viewBox="0 0 20 20" aria-hidden="true"
                  ><path d="M17 3.5v13L7.5 10z" fill="currentColor"></path><rect
                    x="3"
                    y="3.5"
                    width="2.4"
                    height="13"
                    rx="1"
                    fill="currentColor"></rect></svg
                >
                <span class="play"
                  ><svg viewBox="0 0 20 20" aria-hidden="true"
                    ><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.2" fill="currentColor"></rect><rect
                      x="11.1"
                      y="4.4"
                      width="3.3"
                      height="11.2"
                      rx="1.2"
                      fill="currentColor"></rect></svg
                  ></span
                >
                <svg viewBox="0 0 20 20" aria-hidden="true"
                  ><path d="M3 3.5v13L12.5 10z" fill="currentColor"></path><rect
                    x="14.6"
                    y="3.5"
                    width="2.4"
                    height="13"
                    rx="1"
                    fill="currentColor"></rect></svg
                >
              </div>

              <div class="vol">
                <svg viewBox="0 0 16 16" aria-hidden="true"
                  ><path d="M4 6h2.4L9.4 3.4v9.2L6.4 10H4z" fill="currentColor"></path></svg
                >
                <span class="track"><i></i></span>
                <svg viewBox="0 0 16 16" aria-hidden="true"
                  ><path d="M2.5 6h2.4L7.9 3.4v9.2L4.9 10H2.5z" fill="currentColor"></path><path
                    d="M10.4 5.6a3.4 3.4 0 0 1 0 4.8M12.4 3.4a6.4 6.4 0 0 1 0 9.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"></path></svg
                >
              </div>

              <div class="dl">
                <svg viewBox="0 0 16 16" aria-hidden="true"
                  ><circle cx="8" cy="8" r="7" fill="#d8002d"></circle><path
                    d="M4.8 8.2 7 10.4l4-4.6"
                    fill="none"
                    stroke="#fdf6ec"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <span>downloaded &middot; plays offline</span>
              </div>

              <div class="home"></div>
            </div>
          </div>

          <p class="note a">
            <span class="dot"
              ><svg viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  d="M4 8h8M8.6 4.4 12.2 8l-3.6 3.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              ></span
            >
            <span>your library<br />lives on your box</span>
          </p>

          <p class="note b">
            <span class="dot"
              ><svg viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  d="M12 8H4M7.4 4.4 3.8 8l3.6 3.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              ></span
            >
            <span>downloaded once<br />plays with no signal</span>
          </p>
        </div>

        <footer class="bot">
          <div class="actions">
            <a class="btn" href={GITHUB_URL}>Source on GitHub</a>
            {
              APP_STORE_URL ? (
                <a class="btn ghost" href={APP_STORE_URL}>
                  Download on the App Store
                </a>
              ) : (
                <span class="btn ghost pending" aria-disabled="true">
                  Coming to the App Store
                </span>
              )
            }
          </div>
          <a class="ref" href="#ec-servers">
            mz–04 &middot; eclipse
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 2v12M3.4 9.4 8 14l4.6-4.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </a>
        </footer>
      </div>
    </section>

    <!-- ========================================================== SERVERS
         Three servers, and the transit band standing over the middle one. -->
    <section class="band servers" id="ec-servers" aria-labelledby="ec-servers-t">
      <span class="transit" aria-hidden="true"></span>

      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>01</b>Where the music already is</p>
        <h2 id="ec-servers-t">Point it at the machine you already own.</h2>

        <ul class="rack" role="list">
          {
            SERVERS.map((s, i) => (
              <li class={`rack-item reveal${i === 1 ? ' is-lit' : ''}`} style={`--i:${i}`}>
                <span class="rack-logo">
                  <ServerLogo name={s.name} size={24} />
                </span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </li>
            ))
          }
        </ul>

        <p class="aside">{FAQS[0].a}</p>
      </div>
    </section>

    <!-- ================================================= STREAMING / OFFLINE -->
    <section class="band parity" aria-labelledby="ec-parity-t">
      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>02</b>Equal halves</p>
        <h2 id="ec-parity-t">In the light or out of it, the same player.</h2>

        <div class="halves">
          {
            PARITY.map((f, i) => (
              <article class={`half ${i === 0 ? 'is-paper' : 'is-ink'} reveal`} style={`--i:${i}`}>
                <span class="half-tag">{i === 0 ? 'Streaming' : 'Offline'}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <svg class="half-illo" viewBox="0 0 130 66" aria-hidden="true">
                  {i === 0 ? (
                    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <rect x="3" y="15" width="26" height="36" rx="3" />
                      <path d="M10 44h5" />
                      <path d="M41 24a16 16 0 0 1 0 18" />
                      <path d="M52 16a28 28 0 0 1 0 34" opacity="0.6" />
                      <path d="M63 8a40 40 0 0 1 0 50" opacity="0.34" />
                      <rect x="97" y="10" width="28" height="46" rx="6" />
                      <circle cx="111" cy="33" r="6" fill="currentColor" stroke="none" />
                    </g>
                  ) : (
                    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <path d="M3 33h46" opacity="0.45" stroke-dasharray="4 7" />
                      <path d="M59 22 77 44M77 22 59 44" />
                      <rect x="97" y="10" width="28" height="46" rx="6" />
                      <circle cx="111" cy="33" r="6" fill="currentColor" stroke="none" />
                    </g>
                  )}
                </svg>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================ STATS -->
    <section class="band figures" aria-label="Measured figures">
      <div class="wrap">
        <ul class="stats" role="list">
          {
            STATS.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <b>{s.value}</b>
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ========================================================== MARQUEE
         The drifting row from /h/marquee, executed the way this page works:
         one row of sleeves in ink, a second identical row in red clipped to
         a fixed band, and both on the same animation. A sleeve is only red
         for as long as it is inside the light. -->
    <section class="band weekly" aria-labelledby="ec-weekly-t">
      <div class="wrap weekly-head">
        <p class="eyebrow"><i aria-hidden="true"></i><b>03</b>Featured</p>
        <h2 id="ec-weekly-t">{WEEKLY.title}</h2>
        <p class="weekly-body">{WEEKLY.body}</p>
      </div>

      <div class="mq" aria-hidden="true">
        <div class="mq-row">
          <div class="mq-track">
            {[0, 1].map(() => DRIFT.map((n) => <span class="mq-cell" set:html={sleeve(n)} />))}
          </div>
          <div class="mq-band">
            <div class="mq-track mq-lit">
              {[0, 1].map(() => DRIFT.map((n) => <span class="mq-cell" set:html={sleeve(n, true)} />))}
            </div>
          </div>
        </div>
        <span class="mq-edge mq-edge-l"></span>
        <span class="mq-edge mq-edge-r"></span>
      </div>
    </section>

    <!-- ========================================================= FEATURES -->
    <section class="band does" aria-labelledby="ec-does-t">
      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>04</b>What it does with them</p>
        <h2 id="ec-does-t">A player built the way a library wants to be played.</h2>

        <ul class="cards" role="list">
          {
            REST.map((f, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <span class="card-no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================ ALOUD -->
    <section class="band aloud" aria-labelledby="ec-aloud-t">
      <div class="wrap aloud-grid">
        <div class="aloud-say">
          <p class="eyebrow"><i aria-hidden="true"></i><b>05</b>Past the phone</p>
          <h2 id="ec-aloud-t">{FEATURES[7].title}</h2>
          <p class="aloud-body">{FEATURES[7].body}</p>
        </div>

        <svg class="aloud-illo" viewBox="0 0 440 210" role="img" aria-label="A HomePod handing a request to an iPhone, which plays it and AirPlays the sound back.">
          <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <rect x="34" y="52" width="86" height="122" rx="42" />
            <ellipse cx="77" cy="66" rx="30" ry="10" opacity="0.5" />
            <path d="M52 96h50M52 110h50M52 124h50M58 138h38" opacity="0.4" />
            <rect x="330" y="38" width="74" height="140" rx="16" />
            <rect x="342" y="56" width="50" height="104" rx="6" opacity="0.45" />
            <circle cx="367" cy="108" r="13" fill="currentColor" stroke="none" />
            <path d="M136 78C196 52 268 50 316 62" />
            <path d="M304 52l14 10-13 11" />
            <path d="M316 158C258 180 190 178 138 160" opacity="0.75" />
            <path d="M150 150l-14 10 13 11" opacity="0.75" />
          </g>
          <g class="aloud-label" font-size="11" letter-spacing="1.6">
            <text x="77" y="196" text-anchor="middle">HOMEPOD</text>
            <text x="367" y="196" text-anchor="middle">IPHONE</text>
            <text x="226" y="46" text-anchor="middle">REQUEST</text>
            <text x="226" y="186" text-anchor="middle">AIRPLAY BACK</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- ============================================================ SPLIT
         /h/split, moved down the page and turned against a drawing rather
         than a device: the eclipse itself on one side, the reason the app
         exists on the other. The seam is marked by the chapter rather than
         by another copy of the logo. -->
    <section class="split" aria-labelledby="ec-own-t">
      <div class="field field-diagram">
