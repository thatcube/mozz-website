<script>
  const tapeRoot = document.querySelector('[data-tape-page]');
  const counter = document.querySelector('[data-tape-counter]');
  const motionOkay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tapeRoot && motionOkay) {
    let ticking = false;
    const paint = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / max));
      tapeRoot.style.setProperty('--tape-shift', String(progress));
      if (counter) counter.textContent = String(Math.round(progress * 742)).padStart(4, '0');
      ticking = false;
    };
    const requestPaint = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    paint();
    window.addEventListener('scroll', requestPaint, { passive: true });
    window.addEventListener('resize', requestPaint);
  }
</script>
