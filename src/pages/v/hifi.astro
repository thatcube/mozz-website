              <!-- head block: erase / record / play, with capstan and pinch roller -->
              <g>
                <rect x="262" y="372" width="96" height="42" rx="5" fill="#26282c" stroke="#0c0d0f" stroke-width="1.5" />
                <rect x="262" y="372" width="96" height="42" rx="5" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
                <g fill="#b9b6ac" stroke="#6a675d" stroke-width="1">
                  <rect x="276" y="380" width="12" height="18" rx="2" />
                  <rect x="304" y="380" width="12" height="18" rx="2" />
                  <rect x="332" y="380" width="12" height="18" rx="2" />
                </g>
                <rect x="376" y="366" width="4" height="30" rx="2" fill="#c9c5bd" />
                <circle cx="392" cy="392" r="12" fill="#1b1815" stroke="#3a3c40" stroke-width="2" />
