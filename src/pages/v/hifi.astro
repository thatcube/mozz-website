---
/**
 * VARIANT — HI-FI
 * See the design contract in the HTML comment at the top of <main>.
 *
 * The page is a rack of separates: each section is a brushed-aluminium
 * faceplate with real machined controls. Geometry that has to be exact — the
 * VU meter's scale and needle, the LED bargraphs — is computed here at build
 * time so the SVG can never drift out of alignment.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import Phone from '../../components/Phone.astro';
import Shot from '../../components/Shot.astro';
import {
  NAME, SERVERS, FEATURES, OWNERSHIP, FAQS, STATS,
  GITHUB_URL, APP_STORE_URL,
} from '../../data/site';

const HEADLINE = 'Every component is yours.';

/* ---- Adaptive-colour array ----
   The same app, tinted by whatever record is playing. Four different screens
   drawn from four different sleeves: violet, crimson, sepia, cool silver. */
const palette = [
  { name: 'mozz-nowplaying', label: 'Now Playing' },
  { name: 'mozz-album-red', label: 'Album' },
  { name: 'mozz-album-warm', label: 'Album' },
  { name: 'mozz-artist', label: 'Artist' },
];

/* ---- LED bargraph for the four stats (14 segments each) ---- */
const SEG = 14;
const litFor = [12, 11, 3, 13];           // intentional per-stat, not random
const meters = STATS.map((s, i) => ({
  ...s,
  segs: Array.from({ length: SEG }, (_, n) => {
    const idx = n + 1;
    const zone = idx >= 13 ? 'red' : idx >= 12 ? 'amber' : 'green';
    return { on: idx <= litFor[i], zone };
  }),
}));

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Layout
  title={`${NAME} — every component is yours`}
  description="A free, open source music app for Plex, Jellyfin and Navidrome. Your library, your server, your files — every part of it yours to keep."
  themeColor="#c9c5bd"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,400..900&family=Doto:wght@400..900&family=Familjen+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="hf">
    <!--
      THESIS: A hi-fi separates rack, not a landing page. Each section is one
      component's front panel — brushed aluminium, real machined controls —
      because a self-hoster owns music the way an audiophile owns gear: parts
      they chose and can replace. It refuses the centred, empty hero; the app
      leads the frame.
      OWN-WORLD: Warm grey brushed aluminium (#c9c5bd), fine grain, a raking
      sheen; dark anodised sub-panels (#2b2d31); cream VU faces. Brand red is
      only ever an indicator — the power LED, the meter's peak zone — never a
      wash. Type is Archivo, condensed like panel silkscreen.
      STORY: Power on. Read the meters. Pick your input. Nothing is switched off
      behind a paywall; it is all yours.
      FIRST VIEWPORT: An amplifier faceplate, split asymmetrically — headline and
      two panel buttons left; the Mozz "Now Playing" phone in a lit display bay,
      right; a machined volume knob below.
      FORM: 1970s–80s integrated amp as real hardware; panels carry the structure.
    -->

    <VariantBar slug="hifi" tone="cool" />

    <div class="rack">
      <!-- ===================== HERO / MAIN AMPLIFIER ===================== -->
      <section class="panel faceplate hero" aria-labelledby="hf-h1">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="plate-top">
          <div class="brand">
            <Mark size={34} decorative />
            <div class="brand-txt">
              <span class="wordmark">{NAME}</span>
              <span class="model">Stereo Integrated · Model MZ‑1</span>
            </div>
          </div>
          <div class="power">
            <span class="silk">Power</span>
            <span class="led led-red is-on" aria-hidden="true"></span>
          </div>
        </div>

        <div class="hero-body">
          <div class="hero-copy">
            <h1 id="hf-h1" class="headline">{HEADLINE}</h1>
            <p class="lede">
              Mozz plays the music already on your own Plex, Jellyfin or
              Navidrome server. No account, no subscription, nothing logging what
              you play — and every feature is in the free, open-source app.
            </p>

            <div class="actions">
              {APP_STORE_URL ? (
                <a class="btn btn-primary" href={APP_STORE_URL}>
                  <span class="led led-red is-on" aria-hidden="true"></span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                  <span class="btn-txt"><small>Download on the</small>App Store</span>
                </a>
              ) : (
                <span class="btn btn-primary is-pending" aria-disabled="true">
                  <span class="led led-red" aria-hidden="true"></span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                  <span class="btn-txt"><small>Coming to the</small>App Store</span>
                </span>
              )}
              <a class="btn btn-ghost" href={GITHUB_URL}>Read the source</a>
            </div>
          </div>

          <!--
            Hero plate: drop a portrait photo at /hero/hifi.jpg (about 1200×1500)
            and it layers on top of the CSS-composed glow below via --hero-plate.
            With no file present the url() layer simply paints nothing, so the bay
            degrades to the warm CSS backdrop — never a broken-image box.
          -->
          <div class="hero-device">
            <div class="device-bay">
              <Phone
                name="mozz-playlist"
                width={280}
                priority
                class="hero-phone"
                sizes="(max-width: 832px) 62vw, 280px"
              />
            </div>
          </div>
        </div>

        <div class="control-rail">
          <span class="knob" style="--turn: 26deg" aria-hidden="true">
            <span class="knob-cap"></span>
            <span class="knob-ptr"></span>
          </span>
          <div class="rail-read" aria-hidden="true">
            <span class="silk xs">Volume · 32</span>
            <span class="readout">100k</span>
            <span class="silk xs">tracks indexed on device</span>
          </div>
          <span class="rail-lamp" aria-hidden="true">
            <span class="led led-red is-on tiny"></span>
            <span class="silk xs">Signal · Locked</span>
          </span>
        </div>
      </section>

      <!-- ===================== ADAPTIVE COLOUR / DISPLAY ARRAY ===================== -->
      <section class="panel anod palette" aria-labelledby="hf-colour">
        <span class="screw s-tl dark" aria-hidden="true"></span>
        <span class="screw s-tr dark" aria-hidden="true"></span>
        <span class="screw s-bl dark" aria-hidden="true"></span>
        <span class="screw s-br dark" aria-hidden="true"></span>

        <div class="section-head on-dark">
          <h2 id="hf-colour">It takes the colour of the record</h2>
          <p class="section-sub">Mozz tints its whole interface from the artwork that’s
            playing — the same app, a new colour for every sleeve.</p>
        </div>

        <ol class="palette-rack" role="list">
          {palette.map((p) => (
            <li class="pal-item">
              <span class="pal-screen">
                <span class="pal-inner">
                  <Shot name={p.name} sizes="(max-width: 52rem) 42vw, 240px" class="pal-img" />
                </span>
              </span>
              <span class="pal-cap">
                <span class="led led-red is-on tiny" aria-hidden="true"></span>
                <span class="silk xs">{p.label}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>

      <!-- ===================== INPUT SELECTOR / SERVERS ===================== -->
      <section class="panel faceplate inputs-panel" aria-labelledby="hf-inputs">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="section-head">
          <h2 id="hf-inputs">Input selector</h2>
          <p class="section-sub">Point Mozz at the server your library already lives on. Turn the dial.</p>
        </div>

        <fieldset class="selector">
          <legend class="sr-only">Choose an input</legend>

          <div class="dial">
            <div class="legend">
              {SERVERS.map((s, i) => (
                <label class="pos" for={`sel-${slug(s.name)}`}>
                  <input type="radio" name="hf-input" id={`sel-${slug(s.name)}`} checked={i === 0} />
                  <ServerLogo name={s.name} size={20} class="pos-logo" />
                  <span class="pos-name">{s.name}</span>
                  <span class="notch" aria-hidden="true"></span>
                </label>
              ))}
            </div>
            <span class="knob big" aria-hidden="true">
              <span class="knob-cap"></span>
              <span class="knob-ptr"></span>
            </span>
          </div>

          <ol class="input-rows" role="list">
            {SERVERS.map((s) => (
              <li data-srv={slug(s.name)}>
                <span class="iled" aria-hidden="true"></span>
                <span class="ibadge" aria-hidden="true"><ServerLogo name={s.name} size={26} /></span>
                <span class="iname">{s.name}</span>
                <p class="inote">{s.note}</p>
                <span class="itag" aria-hidden="true">Selected</span>
              </li>
            ))}
          </ol>
        </fieldset>
      </section>

      <!-- ===================== SIGNAL PATH (illustration) ===================== -->
      <section class="panel anod signal" aria-labelledby="hf-signal">
        <span class="screw s-tl dark" aria-hidden="true"></span>
        <span class="screw s-tr dark" aria-hidden="true"></span>
        <span class="screw s-bl dark" aria-hidden="true"></span>
        <span class="screw s-br dark" aria-hidden="true"></span>

        <div class="section-head on-dark">
          <h2 id="hf-signal">The signal path</h2>
          <p class="section-sub">Your server, your device, your ears — a closed loop. The music
            never routes through us, because there is no us in the circuit.</p>
        </div>

        <figure class="sp-fig">
          <svg class="sp" viewBox="0 0 1200 360" role="img"
            aria-label="A signal-path schematic: your server connects to your device connects to your headphones, one closed loop. A branch toward the outside world — accounts, trackers, ads — is switched off and broken, so nothing leaves.">
            <defs>
              <linearGradient id="sp-metal" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#e9e5dc" />
                <stop offset="0.5" stop-color="#cfcabf" />
                <stop offset="1" stop-color="#a8a498" />
              </linearGradient>
              <linearGradient id="sp-dark" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#33353a" />
                <stop offset="1" stop-color="#191a1d" />
              </linearGradient>
              <radialGradient id="sp-scr" cx="0.5" cy="0.36" r="0.8">
                <stop offset="0" stop-color="#f0d9b0" />
                <stop offset="0.55" stop-color="#d99a3c" />
                <stop offset="1" stop-color="#7c4a15" />
              </radialGradient>
              <filter id="sp-sh" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity="0.5" />
              </filter>
              <filter id="sp-sh-sm" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity="0.45" />
              </filter>
            </defs>

            <!-- live signal bus -->
            <g stroke-linecap="round" fill="none">
              <path d="M 292 214 H 520" stroke="#0c0d0f" stroke-width="9" />
              <path d="M 292 214 H 520" stroke="#63d17a" stroke-width="3" opacity="0.9" />
              <path d="M 700 214 H 918" stroke="#0c0d0f" stroke-width="9" />
              <path d="M 700 214 H 918" stroke="#63d17a" stroke-width="3" opacity="0.9" />
            </g>
            <g fill="#63d17a" opacity="0.92">
              <path d="M 372 206 l 12 8 l -12 8 z" />
              <path d="M 412 206 l 12 8 l -12 8 z" />
              <path d="M 452 206 l 12 8 l -12 8 z" />
              <path d="M 780 206 l 12 8 l -12 8 z" />
              <path d="M 820 206 l 12 8 l -12 8 z" />
              <path d="M 860 206 l 12 8 l -12 8 z" />
            </g>

            <!-- STATION 1 · server / NAS -->
            <g filter="url(#sp-sh)">
              <rect x="96" y="120" width="196" height="150" rx="12" fill="url(#sp-metal)" stroke="#8a8578" stroke-width="1.5" />
            </g>
            <rect x="96" y="120" width="196" height="150" rx="12" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1" />
            <circle cx="272" cy="138" r="5" fill="#c80028" />
            <circle cx="272" cy="138" r="8.5" fill="none" stroke="#c80028" stroke-width="1" opacity="0.4" />
            <g>
              <rect x="112" y="146" width="150" height="26" rx="5" fill="#bdb8ac" stroke="#8f8b7f" stroke-width="1" />
              <rect x="112" y="180" width="150" height="26" rx="5" fill="#bdb8ac" stroke="#8f8b7f" stroke-width="1" />
              <rect x="112" y="214" width="150" height="26" rx="5" fill="#bdb8ac" stroke="#8f8b7f" stroke-width="1" />
            </g>
            <g fill="#3b3a33">
              <rect x="120" y="155" width="34" height="8" rx="4" />
              <rect x="120" y="189" width="34" height="8" rx="4" />
              <rect x="120" y="223" width="34" height="8" rx="4" />
            </g>
            <g fill="#63d17a">
              <circle cx="248" cy="159" r="3.4" />
              <circle cx="248" cy="193" r="3.4" />
              <circle cx="248" cy="227" r="3.4" />
            </g>

            <!-- STATION 2 · your device / phone -->
            <g filter="url(#sp-sh)">
              <rect x="556" y="104" width="88" height="172" rx="18" fill="url(#sp-dark)" stroke="#0b0c0e" stroke-width="2" />
            </g>
            <rect x="556" y="104" width="88" height="172" rx="18" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1" />
            <rect x="568" y="120" width="64" height="140" rx="8" fill="#111214" />
            <rect x="586" y="112" width="28" height="6" rx="3" fill="#050506" />
            <path d="M 588 168 v 44 l 34 -22 z" fill="#f0ede4" />
            <g fill="#c80028"><rect x="576" y="238" width="48" height="4" rx="2" opacity="0.85" /></g>

            <!-- STATION 3 · your ears / headphones -->
            <g filter="url(#sp-sh-sm)" fill="none" stroke="#2b2d31" stroke-width="14" stroke-linecap="round">
              <path d="M 968 214 V 176 A 62 62 0 0 1 1092 176 V 214" />
            </g>
            <g filter="url(#sp-sh)">
              <rect x="946" y="196" width="46" height="86" rx="16" fill="url(#sp-dark)" stroke="#0b0c0e" stroke-width="1.5" />
              <rect x="1068" y="196" width="46" height="86" rx="16" fill="url(#sp-dark)" stroke="#0b0c0e" stroke-width="1.5" />
            </g>
            <ellipse cx="994" cy="239" rx="14" ry="30" fill="#0e0f11" stroke="#3a3c40" stroke-width="2" />
            <ellipse cx="1066" cy="239" rx="14" ry="30" fill="#0e0f11" stroke="#3a3c40" stroke-width="2" />

            <!-- connector plugs at each junction -->
            <g fill="#8a8578" stroke="#5f5c52" stroke-width="1">
              <rect x="286" y="204" width="12" height="20" rx="2" />
              <rect x="514" y="204" width="12" height="20" rx="2" />
              <rect x="694" y="204" width="12" height="20" rx="2" />
              <rect x="912" y="204" width="12" height="20" rx="2" />
            </g>

            <!-- the TAP that is switched off — nothing leaves -->
            <g>
              <path d="M 600 104 V 74" stroke="#c80028" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9" opacity="0.85" />
              <!-- open switch: a broken blade, tilted away from the contact -->
              <circle cx="600" cy="74" r="4" fill="#c80028" />
              <line x1="600" y1="74" x2="628" y2="56" stroke="#c80028" stroke-width="3.4" stroke-linecap="round" />
              <circle cx="600" cy="52" r="4" fill="none" stroke="#c80028" stroke-width="2.4" />
              <rect x="470" y="20" width="260" height="34" rx="8" fill="none" stroke="#7a5a5f" stroke-width="1.4" stroke-dasharray="3 6" />
              <text x="600" y="42" text-anchor="middle" fill="#e7b8bf"
                style="font-family:Archivo,sans-serif;font-weight:800;font-stretch:74%;font-size:13px;letter-spacing:0.14em;">
                THE OUTSIDE WORLD · ACCOUNTS · TRACKERS · ADS
              </text>
            </g>

            <!-- station captions -->
            <g fill="#efece3" text-anchor="middle"
              style="font-family:Archivo,sans-serif;font-weight:800;font-stretch:74%;font-size:15px;letter-spacing:0.16em;">
              <text x="194" y="312">YOUR SERVER</text>
              <text x="600" y="312">YOUR DEVICE</text>
              <text x="1030" y="312">YOUR EARS</text>
            </g>
            <g fill="#63d17a" text-anchor="middle"
              style="font-family:Doto,monospace;font-weight:800;font-size:12px;letter-spacing:0.08em;">
              <text x="406" y="248">SIGNAL</text>
              <text x="814" y="248">SIGNAL</text>
            </g>
          </svg>
          <figcaption class="sr-only">
            The music travels only from your own server to your device to your headphones.
            The branch to the outside world is broken and switched off: no account, no
            tracking, no telemetry.
          </figcaption>
        </figure>
      </section>

      <!-- ===================== FUNCTIONS / FEATURES ===================== -->
      <section class="panel faceplate fn-panel" aria-labelledby="hf-fn">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="section-head">
          <h2 id="hf-fn">Function panel</h2>
          <p class="section-sub">Every switch is up. There is no dim, locked bank behind a paid tier.</p>
        </div>

        <ol class="fn-rows" role="list">
          {FEATURES.map((f) => (
            <li>
              <span class="fn-switch is-on" aria-hidden="true"><span class="cap"></span></span>
              <span class="fn-led" aria-hidden="true"></span>
              <div class="fn-copy">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ===================== METER BRIDGE / STATS ===================== -->
      <section class="panel anod bridge" aria-labelledby="hf-bridge">
        <span class="screw s-tl dark" aria-hidden="true"></span>
        <span class="screw s-tr dark" aria-hidden="true"></span>
        <span class="screw s-bl dark" aria-hidden="true"></span>
        <span class="screw s-br dark" aria-hidden="true"></span>

        <h2 id="hf-bridge" class="bridge-title">Meter bridge</h2>
        <div class="cells">
          {meters.map((m) => (
            <div class="cell">
              <div class="bars" aria-hidden="true">
                {m.segs.map((sg) => (
                  <span class={`bar ${sg.zone} ${sg.on ? 'on' : ''}`}></span>
                ))}
              </div>
              <span class="cell-val">{m.value}</span>
              <span class="cell-lab">{m.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ===================== OFFLINE / REEL-TO-REEL (illustration) ===================== -->
      <section class="panel faceplate reel-panel" aria-labelledby="hf-reel">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="reel-split">
          <figure class="reel-fig">
            <svg class="reel" viewBox="0 0 620 470" role="img"
              aria-label="A reel-to-reel tape deck: two reels threaded with tape running across the heads, standing for downloaded music you keep as your own copy on the device.">
              <defs>
                <radialGradient id="rr-flange" cx="0.36" cy="0.3" r="0.85">
                  <stop offset="0" stop-color="#eae6dd" />
                  <stop offset="0.5" stop-color="#cbc6bb" />
                  <stop offset="1" stop-color="#9a968b" />
                </radialGradient>
                <radialGradient id="rr-hub" cx="0.4" cy="0.34" r="0.8">
                  <stop offset="0" stop-color="#f2efe7" />
                  <stop offset="0.6" stop-color="#c8c4b9" />
                  <stop offset="1" stop-color="#8f8c82" />
                </radialGradient>
                <mask id="rr-holes-l" maskUnits="userSpaceOnUse" x="-140" y="-140" width="280" height="280">
                  <circle r="132" fill="#fff" />
                  <circle cx="0" cy="-70" r="34" fill="#000" />
                  <circle cx="60.6" cy="35" r="34" fill="#000" />
                  <circle cx="-60.6" cy="35" r="34" fill="#000" />
                </mask>
                <mask id="rr-holes-r" maskUnits="userSpaceOnUse" x="-140" y="-140" width="280" height="280">
                  <circle r="132" fill="#fff" />
                  <circle cx="0" cy="-70" r="34" fill="#000" />
                  <circle cx="60.6" cy="35" r="34" fill="#000" />
                  <circle cx="-60.6" cy="35" r="34" fill="#000" />
                </mask>
                <filter id="rr-sh" x="-30%" y="-30%" width="160%" height="160%">
                  <feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#000" flood-opacity="0.42" />
                </filter>
              </defs>

              <!-- tape threaded between the reels, across the heads -->
              <g fill="none" stroke-linejoin="round" stroke-linecap="round">
                <path d="M 165 314 V 392 H 455 V 314" stroke="#0d0b09" stroke-width="7" />
                <path d="M 165 314 V 392 H 455 V 314" stroke="#443b31" stroke-width="2" opacity="0.6" />
              </g>

              <!-- left reel (supply) -->
              <g transform="translate(165 210)" filter="url(#rr-sh)">
                <circle r="104" fill="#241f1b" />
                <g fill="none" stroke="#191512" stroke-width="1.5" opacity="0.8">
                  <circle r="96" /><circle r="86" /><circle r="74" /><circle r="62" />
