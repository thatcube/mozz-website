      </section>

      <!-- ===================== OWNERSHIP / PROTECTION ===================== -->
      <section class="panel faceplate own-panel" aria-labelledby="hf-own">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="section-head">
          <h2 id="hf-own">It's actually yours</h2>
          <p class="section-sub">Four switches that stay set. This is the whole reason the app exists.</p>
        </div>

        <ol class="own-rows" role="list">
          {OWNERSHIP.map((o) => (
            <li>
              <span class="toggle" aria-hidden="true"><span class="lever"></span></span>
              <div class="own-copy">
                <h3>{o.title}</h3>
                <p>{o.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ===================== FAQ ===================== -->
      <section class="panel faceplate faq-panel" aria-labelledby="hf-faq">
        <span class="screw s-tl" aria-hidden="true"></span>
        <span class="screw s-tr" aria-hidden="true"></span>
        <span class="screw s-bl" aria-hidden="true"></span>
        <span class="screw s-br" aria-hidden="true"></span>

        <div class="section-head">
          <h2 id="hf-faq">Service notes</h2>
        </div>

        <div class="faq">
          {FAQS.map((f) => (
            <details>
              <summary>
                <span class="q-led" aria-hidden="true"></span>
                <span class="q-txt">{f.q}</span>
                <span class="q-mark" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- ===================== FOOTER / BACK PANEL ===================== -->
      <footer class="panel anod backplate">
        <span class="screw s-tl dark" aria-hidden="true"></span>
        <span class="screw s-tr dark" aria-hidden="true"></span>
        <span class="screw s-bl dark" aria-hidden="true"></span>
        <span class="screw s-br dark" aria-hidden="true"></span>

        <div class="plate">
          <Mark size={30} decorative />
          <p>
            {NAME} is free forever and open source under GPL‑3.0.
            <a href={GITHUB_URL}>See it on GitHub</a>
          </p>
        </div>
        <span class="serial" aria-hidden="true">SER. No. MZ1‑0000 · MADE FOR THE MUSIC YOU OWN</span>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .hf {
    /* Palette — warm grey aluminium, dark anodised accents, one red indicator. */
    --alu: #c9c5bd;
    --alu-hi: #ebe7df;
    --alu-lo: #9b978e;
    --anod: #2b2d31;
    --anod-hi: #3a3d43;
    --ink: #24262a;         /* body ink on aluminium — ~8.9:1 */
    --ink-dim: #4a473f;     /* secondary, tinted from the warm surface — ~5:1 */
    --light: #e7e4dd;       /* text on anodised panels */
    --light-dim: #a9a69d;
    --red: #c80028;
    --red-hot: #ff3b52;
    --groove: rgba(0, 0, 0, 0.32);

    background:
      radial-gradient(120% 90% at 50% -10%, #232426, transparent 60%),
      #17181a;
    color: var(--ink);
    font-family: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: clip;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .rack {
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.25rem);
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }

  /* ---------- shared material: brushed aluminium faceplate ---------- */

  .brush,
  .faceplate {
    background-color: var(--alu);
    background-image:
      linear-gradient(104deg, rgba(255,255,255,0) 22%, rgba(255,255,255,0.34) 44%, rgba(255,255,255,0.06) 56%, rgba(255,255,255,0) 74%),
      linear-gradient(180deg, rgba(255,255,255,0.30), rgba(0,0,0,0.06) 55%, rgba(0,0,0,0.16)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, rgba(0,0,0,0.05) 1px 2px);
  }

  .panel {
    position: relative;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.38);
    padding: clamp(1.35rem, 3vw, 2.4rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 1px 0 0 rgba(255, 255, 255, 0.22),
      inset -1px 0 0 rgba(0, 0, 0, 0.18),
      inset 0 -2px 7px rgba(0, 0, 0, 0.22),
      0 12px 26px rgba(0, 0, 0, 0.5),
      0 2px 4px rgba(0, 0, 0, 0.4);
  }

  .anod {
    background-color: var(--anod);
    background-image:
      linear-gradient(104deg, rgba(255,255,255,0) 28%, rgba(255,255,255,0.08) 48%, rgba(255,255,255,0) 66%),
      linear-gradient(180deg, rgba(255,255,255,0.07), rgba(0,0,0,0.34)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.028) 0 1px, rgba(0,0,0,0.16) 1px 2px);
    color: var(--light);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 2px 10px rgba(0, 0, 0, 0.6),
      0 12px 26px rgba(0, 0, 0, 0.55),
      0 2px 4px rgba(0, 0, 0, 0.45);
  }

  /* ---------- corner screws ---------- */

  .screw {
    position: absolute;
    width: 15px; height: 15px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #efece6, #c2beb5 44%, #8b887f 74%, #6f6c65);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.65),
      inset 0 -1px 2px rgba(0, 0, 0, 0.4),
      0 1px 2px rgba(0, 0, 0, 0.45);
    rotate: 22deg;
  }
  .screw.dark {
    background: radial-gradient(circle at 38% 32%, #6d7075, #4b4d52 46%, #303236 78%, #232427);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.25),
      inset 0 -1px 2px rgba(0, 0, 0, 0.6),
      0 1px 2px rgba(0, 0, 0, 0.5);
  }
  .screw::before,
  .screw::after {
    content: "";
    position: absolute;
    inset: 0; margin: auto;
    background: rgba(0, 0, 0, 0.42);
    border-radius: 1px;
  }
  .screw::before { width: 62%; height: 1.6px; }
  .screw::after { width: 1.6px; height: 62%; }
  .screw.dark::before,
  .screw.dark::after { background: rgba(0, 0, 0, 0.6); }

  .s-tl { top: 11px; left: 11px; }
  .s-tr { top: 11px; right: 11px; rotate: -14deg; }
  .s-bl { bottom: 11px; left: 11px; rotate: 40deg; }
  .s-br { bottom: 11px; right: 11px; rotate: 8deg; }

  /* ---------- silkscreen labels & readouts ---------- */

  .silk {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--ink-dim);
  }
  .silk.xs { font-size: 0.62rem; letter-spacing: 0.12em; }

  .readout {
    font-family: 'Doto', ui-monospace, monospace;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  h2, h3 {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 82%;
    letter-spacing: -0.01em;
    line-height: 1.02;
    color: var(--ink);
  }

  /* ---------- LEDs ---------- */

  .led {
    width: 11px; height: 11px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #6a6b6e, #3a3b3e 70%, #2a2b2d);
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.3), inset 0 -1px 2px rgba(0,0,0,0.6);
    flex: none;
  }
  .led.tiny { width: 8px; height: 8px; }
  .led-red.is-on {
    background: radial-gradient(circle at 38% 30%, #ff8a98, var(--red-hot) 46%, var(--red) 76%);
    box-shadow:
      inset 0 0 2px rgba(255, 255, 255, 0.7),
      0 0 6px rgba(200, 0, 40, 0.85),
      0 0 12px rgba(200, 0, 40, 0.45);
  }

  /* ================= HERO ================= */

  .plate-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--groove);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.42);
  }

  .brand { display: flex; align-items: center; gap: 0.7rem; }
  .brand-txt { display: grid; gap: 0.1rem; }
  .wordmark {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-stretch: 88%;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1;
  }
  .model {
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-stretch: 76%;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .power { display: flex; align-items: center; gap: 0.5rem; }

  .hero-body {
    margin-top: clamp(1.35rem, 3vw, 2.1rem);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: center;
  }

  .headline {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-stretch: 84%;
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .lede {
    margin-top: 1.15rem;
    max-width: 42ch;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  .actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* panel button — a machined slab that presses into the faceplate */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 1.15rem;
    border-radius: 5px;
    border: 1px solid rgba(0, 0, 0, 0.4);
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 82%;
    letter-spacing: 0.03em;
    color: var(--ink);
    background-color: #cecabf;
    background-image:
      linear-gradient(180deg, rgba(255,255,255,0.5), rgba(0,0,0,0.05) 52%, rgba(0,0,0,0.14)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, rgba(0,0,0,0.05) 1px 2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2px 3px rgba(0, 0, 0, 0.2),
      0 3px 5px rgba(0, 0, 0, 0.4);
    transition: translate 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
  }
  .btn svg { width: 20px; height: 20px; fill: currentColor; }
  .btn-txt { display: grid; line-height: 1.02; font-size: 0.98rem; }
  .btn-txt small {
    font-family: 'Familjen Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  a.btn:hover { filter: brightness(1.05); translate: 0 -1px; }
  a.btn:active {
    translate: 0 1px;
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .btn:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .btn-primary { padding-right: 1.3rem; }
  .btn.is-pending {
    cursor: default;
    color: var(--ink-dim);
    filter: saturate(0.9);
  }
  .btn-ghost {
    background-color: var(--anod);
    background-image:
      linear-gradient(180deg, rgba(255,255,255,0.1), rgba(0,0,0,0.35)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 1px, rgba(0,0,0,0.14) 1px 2px);
    color: var(--light);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset 0 -2px 4px rgba(0, 0, 0, 0.5),
      0 3px 5px rgba(0, 0, 0, 0.4);
  }

  /* ---------- hero split: copy left, lit device bay right ---------- */
  .hero { --hero-plate: url('/hero/hifi.jpg'); }
  .hero-copy { min-width: 0; }
  .hero-device { min-width: 0; }

  /* recessed, back-lit display window the phone sits inside.
     The --hero-plate photo layers ON TOP of the CSS glow art; if the file is
     absent the url() layer paints nothing and the warm backdrop stands alone. */
  .device-bay {
    position: relative;
    padding: clamp(1.1rem, 2.6vw, 1.9rem);
    border-radius: 10px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #201f1c;
    background-image:
      var(--hero-plate),
      radial-gradient(115% 82% at 74% 12%, rgba(255, 173, 120, 0.36), rgba(255, 120, 60, 0) 58%),
      radial-gradient(130% 96% at 20% 108%, rgba(200, 0, 40, 0.24), rgba(200, 0, 40, 0) 60%),
      linear-gradient(158deg, #2f2b26 0%, #211f1c 44%, #14130f 100%),
      repeating-linear-gradient(92deg, rgba(255,255,255,0.028) 0 1px, rgba(0,0,0,0.14) 1px 3px);
    background-size: cover, auto, auto, auto, auto;
    background-position: center, center, center, center, center;
    background-repeat: no-repeat;
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.7),
      inset 0 0 0 1px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -3px 14px rgba(0, 0, 0, 0.7);
    border: 1px solid #0c0c0e;
  }

  /* ---------- hero phone: real screenshot in a machined frame ---------- */
  /* The <Phone> frame is dressed to match the rack — brushed-aluminium hardware
     with a machined rim — so it reads as another component in the bay, not a
     black slab. Only the surface is dressed; the frame geometry is left solved. */
  .hero-device :global(.phone) {
    --phone-bezel-w: 0.034;
    --phone-rim: rgba(255, 255, 255, 0.55);
    --phone-bezel:
      linear-gradient(150deg, rgba(255,255,255,0.34) 0%, rgba(255,255,255,0) 32%, rgba(0,0,0,0.24) 72%, rgba(255,255,255,0.14) 100%),
      repeating-linear-gradient(92deg, rgba(255,255,255,0.06) 0 1px, rgba(0,0,0,0.08) 1px 2px),
      linear-gradient(150deg, #d8d3c9, #9b978e 48%, #74716a 72%, #b0aca3);
    --phone-shadow:
      0 22px 40px -8px rgba(0, 0, 0, 0.62),
      0 4px 10px rgba(0, 0, 0, 0.55);
    rotate: -1.6deg;
  }

  /* ---------- adaptive-colour display array ---------- */
  .palette-rack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.7rem, 2vw, 1.5rem);
    align-items: start;
  }
  .pal-item {
    display: grid;
    gap: 0.7rem;
    justify-items: center;
  }
  /* each screen is a display module mounted in the panel: machined aluminium
     bezel, a black inner window that clips the screenshot to the device screen. */
  .pal-screen {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    border-radius: 16px;
    padding: 5px;
    background:
      linear-gradient(150deg, rgba(255,255,255,0.3), rgba(0,0,0,0.22) 70%),
      linear-gradient(150deg, #d3cec4, #8d8a82 52%, #b0aca3);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      0 16px 32px -14px rgba(0, 0, 0, 0.72),
      0 3px 8px rgba(0, 0, 0, 0.5);
  }
  .pal-inner {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 11px;
    overflow: hidden;
    background: #05060a;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.85);
  }
  .pal-inner :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .pal-cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .palette .silk { color: var(--light-dim); }

  /* ---------- control rail under the hero split ---------- */
  .control-rail {
    margin-top: clamp(1.35rem, 3vw, 2rem);
    padding-top: clamp(1.1rem, 2.4vw, 1.5rem);
    border-top: 1px solid var(--groove);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.8rem);
    flex-wrap: wrap;
  }
  .rail-read { display: grid; gap: 0.14rem; margin-right: auto; }
  .rail-read .readout { font-size: 1.5rem; color: var(--ink); line-height: 1; }
  .rail-lamp {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .rail-lamp .silk { color: var(--ink-dim); }

  /* ---------- machined knob ---------- */

  .knob {
    --d: 66px;
    --turn: 0deg;
    position: relative;
    width: var(--d); height: var(--d);
    border-radius: 50%;
    flex: none;
    background: repeating-conic-gradient(from 0deg, #b9b5ac 0deg 2.3deg, #8d8a82 2.3deg 4.6deg);
    box-shadow:
      0 5px 9px rgba(0, 0, 0, 0.55),
      0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }
  .knob.big { --d: 118px; }
  .knob-cap {
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 42% 34%, #edeae2, #c6c2b9 42%, #9d9a91 78%, #85827a),
      repeating-radial-gradient(circle at 50% 50%, rgba(0,0,0,0.06) 0 1.6px, rgba(255,255,255,0.05) 1.6px 3.2px);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.55),
      inset 0 -3px 7px rgba(0, 0, 0, 0.42);
  }
  .knob-ptr {
    position: absolute;
    left: 50%; top: 9%;
    width: 3px; height: 26%;
    translate: -50% 0;
    rotate: var(--turn);
    transform-origin: 50% 158%;
    border-radius: 2px;
    background: var(--ink);
    box-shadow: 0 0 1px rgba(255, 255, 255, 0.5);
    transition: rotate 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ================= INPUT SELECTOR ================= */

  .section-head { margin-bottom: clamp(1.4rem, 3vw, 2rem); max-width: 60ch; }
  .section-head h2 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); }
  .section-sub {
    margin-top: 0.55rem;
    color: var(--ink-dim);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .selector {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .dial {
    justify-self: center;
    width: 15rem;
    display: grid;
    gap: 1.15rem;
    justify-items: center;
  }
  .legend {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4rem;
    padding: 0 0.3rem;
  }
  .pos {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--ink-dim);
    transition: color 0.15s ease;
    text-align: center;
  }
  .pos input {
    position: absolute;
    opacity: 0;
    width: 1px; height: 1px;
  }
  .notch {
    width: 3px; height: 11px;
    border-radius: 1px;
    background: linear-gradient(180deg, #d7d3ca, #a29f96);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.6), 0 1px 1px rgba(0,0,0,0.35);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .pos-name {
    font-family: 'Doto', ui-monospace, monospace;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: currentColor;
    line-height: 1;
  }
  .pos-logo { color: var(--ink-dim); transition: color 0.15s ease; }
  .pos:has(input:checked) .pos-logo { color: var(--red); }

  .selector:has(#sel-plex:checked) .dial .knob-ptr { rotate: -40deg; }
  .selector:has(#sel-jellyfin:checked) .dial .knob-ptr { rotate: 0deg; }
  .selector:has(#sel-navidrome:checked) .dial .knob-ptr { rotate: 40deg; }

  .pos:has(input:checked) { color: var(--red); }
  .pos:has(input:checked) .notch {
    background: radial-gradient(circle at 40% 30%, #ff8a98, var(--red-hot) 45%, var(--red));
    box-shadow: 0 0 6px rgba(200, 0, 40, 0.8), inset 0 0 2px rgba(255,255,255,0.6);
  }
  .pos:has(input:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .input-rows { display: grid; gap: 0.55rem; margin: 0; padding: 0; }
  .input-rows li {
    display: grid;
    grid-template-columns: auto auto 7.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 0.9rem;
    border-radius: 5px;
    background: linear-gradient(180deg, rgba(255,255,255,0.14), rgba(0,0,0,0.05));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.4),
      inset 0 -1px 2px rgba(0,0,0,0.14),
      inset 0 0 0 1px rgba(0,0,0,0.08);
  }
  /* the server's own logo, recessed into the panel like an etched source badge */
  .ibadge {
    display: grid;
    place-items: center;
    width: 42px; height: 42px;
    border-radius: 8px;
    color: var(--ink);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.34), rgba(0,0,0,0.06) 60%, rgba(0,0,0,0.12)),
      var(--alu);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.6),
      inset 0 -2px 4px rgba(0,0,0,0.24),
      inset 0 0 0 1px rgba(0,0,0,0.18),
      0 1px 1px rgba(255,255,255,0.4);
  }
  .ibadge :global(.server-logo) {
    filter: drop-shadow(0 1px 0 rgba(255,255,255,0.55));
  }
  .iled {
    width: 10px; height: 10px; border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #6a6b6e, #3a3b3e 70%, #2a2b2d);
    box-shadow: inset 0 -1px 2px rgba(0,0,0,0.6);
  }
  .iname {
    font-family: 'Doto', ui-monospace, monospace;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .inote { color: var(--ink-dim); font-size: 0.95rem; text-wrap: pretty; }
  .itag {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 74%;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .selector:has(#sel-plex:checked) [data-srv="plex"] .iled,
  .selector:has(#sel-jellyfin:checked) [data-srv="jellyfin"] .iled,
  .selector:has(#sel-navidrome:checked) [data-srv="navidrome"] .iled {
    background: radial-gradient(circle at 38% 30%, #ff8a98, var(--red-hot) 45%, var(--red));
    box-shadow: 0 0 7px rgba(200, 0, 40, 0.85), inset 0 0 2px rgba(255,255,255,0.5);
  }
  .selector:has(#sel-plex:checked) [data-srv="plex"] .itag,
  .selector:has(#sel-jellyfin:checked) [data-srv="jellyfin"] .itag,
  .selector:has(#sel-navidrome:checked) [data-srv="navidrome"] .itag { opacity: 1; }

  /* ================= FUNCTION PANEL (features) ================= */

  .fn-rows { display: grid; gap: 0; margin: 0; padding: 0; }
  .fn-rows li {
    display: grid;
    grid-template-columns: 3.4rem 0.8rem minmax(0, 1fr);
    align-items: start;
    gap: 1.1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--groove);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .fn-rows li:last-child { border-bottom: 0; box-shadow: none; }
  .fn-copy h3 { font-size: 1.2rem; margin-bottom: 0.25rem; }
  .fn-copy p { color: var(--ink-dim); max-width: 68ch; text-wrap: pretty; }

  /* small rocker, pressed to the ON (top) side */
  .fn-switch {
    width: 3rem; height: 1.65rem;
    border-radius: 4px;
    background: var(--anod);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.5), inset 0 2px 5px rgba(0,0,0,0.6);
    position: relative;
    margin-top: 0.15rem;
  }
  .fn-switch .cap {
    position: absolute;
    left: 2px; right: 2px; top: 2px;
    height: calc(50% - 1px);
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(180deg, #e2ded6, #b6b3ab);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), 0 1px 2px rgba(0,0,0,0.5);
  }
  .fn-switch::after {
    content: "I";
    position: absolute;
    left: 0; right: 0; top: 3px;
    text-align: center;
    font: 800 0.7rem/1 'Archivo', sans-serif;
    color: #3a3d43;
  }
  .fn-led {
    width: 10px; height: 10px; border-radius: 50%;
    margin-top: 0.5rem;
    background: radial-gradient(circle at 38% 30%, #b6f3c9, #3fbf6d 46%, #2f9a55 78%);
    box-shadow: 0 0 6px rgba(63, 191, 109, 0.75), inset 0 0 2px rgba(255,255,255,0.5);
  }

  /* ================= METER BRIDGE (stats) ================= */

  .bridge-title {
    color: var(--light);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    margin-bottom: 1.3rem;
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.4rem);
  }
  .cell {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    padding: 0.9rem 0.95rem 1rem;
    border-radius: 6px;
    background: linear-gradient(180deg, #16171a, #0d0e10);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      inset 0 2px 8px rgba(0,0,0,0.8),
      0 1px 0 rgba(255,255,255,0.05);
    border: 1px solid #050506;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 2.1rem;
    width: 100%;
  }
  .bar {
    flex: 1;
    height: 42%;
    border-radius: 1px;
    background: #232a26;
    box-shadow: inset 0 0 1px rgba(0,0,0,0.8);
  }
  .bar.amber { height: 60%; background: #2c2a20; }
  .bar.red { height: 78%; background: #2c2020; }
  .bar.green.on { background: #43d67d; box-shadow: 0 0 5px rgba(67, 214, 125, 0.85); }
  .bar.amber.on { background: #ffbf3d; box-shadow: 0 0 5px rgba(255, 191, 61, 0.85); }
  .bar.red.on { background: var(--red-hot); box-shadow: 0 0 6px rgba(255, 59, 82, 0.9); }
  .cell-val {
    font-family: 'Doto', ui-monospace, monospace;
    font-weight: 900;
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    color: #ffd7b0;
    line-height: 1;
    text-shadow: 0 0 8px rgba(255, 176, 96, 0.4);
  }
  .cell-lab {
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-stretch: 78%;
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--light-dim);
    line-height: 1.25;
  }

  /* ================= SIGNAL PATH (illustration) ================= */

  .section-head.on-dark h2 { color: var(--light); }
  .section-head.on-dark .section-sub { color: var(--light-dim); }

  .signal { overflow: hidden; }
  .sp-fig { margin: 0; }
  .sp {
    display: block;
    width: 100%;
    height: auto;
    max-width: 68rem;
    margin-inline: auto;
    filter: drop-shadow(0 2px 1px rgba(0, 0, 0, 0.4));
  }

  /* ================= OFFLINE / REEL-TO-REEL (illustration) ================= */

  .reel-split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .reel-fig { margin: 0; }
  .reel {
    display: block;
    width: 100%;
    height: auto;
    max-width: 34rem;
    margin-inline: auto;
  }
  .reel-copy h2 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); }
  .reel-copy p {
    margin-top: 1rem;
    max-width: 60ch;
    color: var(--ink-dim);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .reel-tags {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  .reel-tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-stretch: 80%;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ================= OWNERSHIP ================= */

  .own-rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
    margin: 0; padding: 0;
  }
  .own-rows li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    padding: 1.15rem 1.2rem;
    border-radius: 6px;
    background: linear-gradient(180deg, rgba(255,255,255,0.16), rgba(0,0,0,0.04));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.5),
      inset 0 -2px 4px rgba(0,0,0,0.14),
      inset 0 0 0 1px rgba(0,0,0,0.08);
  }
  .own-copy h3 { font-size: 1.18rem; margin-bottom: 0.3rem; }
  .own-copy p { color: var(--ink-dim); text-wrap: pretty; }

  /* vertical toggle, thrown to the top (protective) position */
  .toggle {
    width: 1.9rem; height: 3rem;
    border-radius: 6px;
    background: var(--anod);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.55), inset 0 2px 6px rgba(0,0,0,0.65);
    position: relative;
    margin-top: 0.1rem;
  }
  .toggle .lever {
    position: absolute;
    left: 50%; top: 6%;
    width: 0.85rem; height: 46%;
    translate: -50% 0;
    border-radius: 5px 5px 3px 3px;
    background: linear-gradient(180deg, #edeae3 0%, #c3bfb6 55%, #a9a69d 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.8),
      0 3px 5px rgba(0,0,0,0.55);
  }
  .toggle::after {
    content: "";
    position: absolute;
    left: 50%; bottom: 16%;
    width: 6px; height: 6px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 30%, #ff8a98, var(--red-hot) 50%, var(--red));
    box-shadow: 0 0 5px rgba(200, 0, 40, 0.8);
  }

  /* ================= FAQ ================= */

  .faq { max-width: none; }
  .faq details {
    border-bottom: 1px solid var(--groove);
