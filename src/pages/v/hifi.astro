    padding: 1.1rem 0.2rem;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .q-txt {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-stretch: 84%;
    font-size: 1.05rem;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .q-led {
    width: 9px; height: 9px; border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #6a6b6e, #3a3b3e 70%, #2a2b2d);
    box-shadow: inset 0 -1px 2px rgba(0,0,0,0.6);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .q-mark {
    position: relative;
    width: 16px; height: 16px;
    flex: none;
  }
  .q-mark::before,
  .q-mark::after {
    content: "";
    position: absolute;
    inset: 0; margin: auto;
    background: var(--ink);
    border-radius: 1px;
  }
  .q-mark::before { width: 14px; height: 2px; }
  .q-mark::after { width: 2px; height: 14px; transition: transform 0.2s ease; }
  .faq details[open] .q-mark::after { transform: scaleY(0); }
  .faq details[open] .q-led {
    background: radial-gradient(circle at 38% 30%, #ff8a98, var(--red-hot) 45%, var(--red));
    box-shadow: 0 0 6px rgba(200, 0, 40, 0.8), inset 0 0 2px rgba(255,255,255,0.5);
  }
  .faq summary:hover .q-txt { color: #000; }
  .faq summary:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .faq p {
    padding: 0 1.85rem 1.25rem;
    color: var(--ink-dim);
    max-width: 72ch;
    text-wrap: pretty;
  }

  /* ================= FOOTER ================= */

  .backplate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .backplate .plate { display: flex; align-items: center; gap: 0.85rem; }
  .backplate p { color: var(--light-dim); font-size: 0.95rem; }
  .backplate a {
