                <circle r="128" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1" />
                <circle r="120" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1" />
                <g fill="none">
                  <circle cx="0" cy="-70" r="34" stroke="rgba(0,0,0,0.55)" stroke-width="2" />
                  <circle cx="60.6" cy="35" r="34" stroke="rgba(0,0,0,0.55)" stroke-width="2" />
                  <circle cx="-60.6" cy="35" r="34" stroke="rgba(0,0,0,0.55)" stroke-width="2" />
                  <path d="M -24 -84 A 34 34 0 0 1 24 -84" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" />
                </g>
                <circle r="42" fill="url(#rr-hub)" stroke="#6f6c62" stroke-width="1.5" />
                <circle r="26" fill="none" stroke="rgba(0,0,0,0.3)" stroke-width="2" />
                <circle r="10" fill="#2a2723" />
                <g fill="#8f8c82">
