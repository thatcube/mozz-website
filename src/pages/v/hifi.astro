    .hero-device :global(.phone) { --phone-w: min(260px, 66%) !important; rotate: 0deg; }
    .palette-rack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .own-rows { grid-template-columns: minmax(0, 1fr); }
    .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
