  }

  .sup {
    max-width: 40ch;
    margin-top: 0.7em;
    font-size: clamp(12.5px, 1vw, 14.5px);
    line-height: 1.48;
    color: rgba(238, 234, 226, 0.66);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(14px, 2vh, 24px);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 42px;
    padding: 0 1.15rem;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
  }

  .solid {
    background: var(--red);
    color: var(--paper);
    transition: background 0.18s ease;
  }

  .solid:hover {
    background: #f10334;
  }

  .ghost {
    border: 1px dashed rgba(238, 234, 226, 0.34);
    color: rgba(238, 234, 226, 0.66);
  }

  .plain {
    color: rgba(238, 234, 226, 0.72);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(216, 0, 45, 0.8);
    padding: 0;
  }

  .plain:hover {
    color: var(--cream);
  }

  .pending i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
  }

  .ref {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 4px;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(238, 234, 226, 0.42);
    transition: color 0.18s ease;
  }

  .ref:hover {
    color: var(--cream);
  }

  .ref svg {
    width: 13px;
    height: 13px;
    animation: nudge 2.6s ease-in-out infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  a:focus-visible,
  .btn:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  /* --------------------------------------------------- shared band typography */

  .band {
    position: relative;
    padding-block: clamp(64px, 9vh, 128px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(238, 234, 226, 0.46);
  }

  .eyebrow i {
    width: 22px;
    height: 2px;
    background: var(--red);
  }

  .eyebrow b {
    font-weight: 500;
    color: var(--red);
    letter-spacing: 0.14em;
  }

  .band h2 {
    max-width: 20ch;
    margin-top: 0.7rem;
    font-family: 'Bricolage Grotesque', 'Wix Madefor Text', Arial, sans-serif;
    font-variation-settings: 'opsz' 60, 'wdth' 104, 'wght' 760;
    font-size: clamp(28px, 4.1vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .reveal {
    opacity: 1;
  }

  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.22, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  :global(html.js) .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------------- servers */

  .servers {
    border-top: 1px solid rgba(238, 234, 226, 0.1);
  }

  .lamps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .lamp {
    position: relative;
    padding: clamp(20px, 2.2vw, 32px) clamp(18px, 2vw, 30px) clamp(24px, 2.6vw, 36px);
    border: 1px solid rgba(238, 234, 226, 0.12);
    border-radius: 4px;
    overflow: hidden;
    background:
      linear-gradient(160deg, rgba(216, 0, 45, 0.16), rgba(10, 7, 13, 0) 62%),
      var(--ink);
  }

  .lamp.is-penumbra {
    background:
      linear-gradient(160deg, rgba(216, 0, 45, 0.09), rgba(10, 7, 13, 0) 55%),
      var(--ink);
  }

  .lamp.is-umbra {
    background: var(--ink);
  }

  .lamp-logo {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(238, 234, 226, 0.07);
    color: var(--cream);
  }

  .lamp.is-lit .lamp-logo {
    background: var(--red);
    color: var(--paper);
  }

  .lamp h3 {
    margin-top: 1rem;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 24, 'wdth' 104, 'wght' 750;
    font-size: clamp(19px, 1.7vw, 26px);
    letter-spacing: -0.02em;
  }

  .lamp p {
    margin-top: 0.5rem;
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.55;
    color: rgba(238, 234, 226, 0.62);
  }

  .lamp-rule {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, var(--red), rgba(216, 0, 45, 0));
  }

  .lamp.is-penumbra .lamp-rule {
    background: linear-gradient(to right, var(--deep), rgba(161, 0, 32, 0));
  }

  .lamp.is-umbra .lamp-rule {
    background: linear-gradient(to right, rgba(238, 234, 226, 0.3), rgba(238, 234, 226, 0));
  }

  .aside {
    max-width: 62ch;
    margin-top: clamp(22px, 3vh, 34px);
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.6;
    color: rgba(238, 234, 226, 0.58);
  }

  /* -------------------------------------------------- streaming / offline */

  .halves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
    margin-top: clamp(30px, 5vh, 58px);
  }

  .half {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.6vw, 40px);
    border-radius: 4px;
    min-height: clamp(280px, 34vh, 380px);
  }

  .half.is-lit {
    background: var(--red);
    color: var(--paper);
  }

  .half.is-dark {
    background: var(--ink);
    color: var(--cream);
    border: 1px solid rgba(238, 234, 226, 0.12);
  }

  .half-tag {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .half h3 {
    margin-top: 0.8rem;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 36, 'wdth' 104, 'wght' 750;
    font-size: clamp(21px, 2.2vw, 33px);
    line-height: 1.04;
    letter-spacing: -0.024em;
  }

  .half p {
    margin-top: 0.75rem;
    max-width: 42ch;
    font-size: clamp(13px, 1.02vw, 15.5px);
    line-height: 1.58;
    opacity: 0.78;
  }

  .half-illo {
    width: min(210px, 60%);
    height: auto;
    margin-top: auto;
    padding-top: 1.6rem;
    color: currentColor;
    opacity: 0.75;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    margin-top: clamp(24px, 3.4vh, 40px);
    padding-top: clamp(20px, 2.6vh, 30px);
    border-top: 1px solid rgba(238, 234, 226, 0.12);
  }

  .stats b {
    display: block;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 48, 'wdth' 108, 'wght' 800;
    font-size: clamp(28px, 3.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--red);
  }

  .stats span {
    display: block;
    margin-top: 0.45rem;
    font-size: clamp(11.5px, 0.9vw, 13.5px);
    line-height: 1.4;
    color: rgba(238, 234, 226, 0.56);
  }

  /* ---------------------------------------------------- the drifting band */

  .weekly {
    padding-bottom: clamp(48px, 7vh, 96px);
  }

  .weekly-head {
    position: relative;
    z-index: 2;
  }

  .weekly-body {
    max-width: 54ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    color: rgba(238, 234, 226, 0.64);
  }

  .drift {
    position: relative;
    margin-top: clamp(30px, 5vh, 60px);
    padding-block: clamp(18px, 3vh, 34px);
    overflow: hidden;
  }

  .drift-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(900px, 74vw);
    height: 130%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(216, 0, 45, 0.42), rgba(216, 0, 45, 0) 70%);
    pointer-events: none;
  }

  /* The umbra, laid straight over the band: the sleeves are only ever fully
     visible where the light is, and go to ground at both edges. */
  .drift-umbra {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      to right,
      var(--void) 0%,
      rgba(10, 7, 13, 0.86) 12%,
      rgba(10, 7, 13, 0) 34%,
      rgba(10, 7, 13, 0) 66%,
      rgba(10, 7, 13, 0.86) 88%,
      var(--void) 100%
    );
  }

  .drift-row {
    position: relative;
    z-index: 2;
    overflow: hidden;
  }

  .drift-row.is-back {
    z-index: 1;
    margin-top: clamp(10px, 1.4vw, 18px);
    opacity: 0.42;
  }

  .drift-track {
    display: flex;
    width: max-content;
    gap: clamp(10px, 1.2vw, 18px);
    will-change: transform;
    animation: drift 64s linear infinite;
  }

  .drift-row.is-back .drift-track {
    animation-duration: 96s;
  }

  .drift-track.is-rev {
    animation-direction: reverse;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - clamp(5px, 0.6vw, 9px)), 0, 0);
    }
  }

  .sleeve {
    display: block;
    flex: none;
    width: clamp(120px, 15vw, 218px);
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .drift-row.is-back .sleeve {
    width: clamp(66px, 8vw, 118px);
  }

  .sleeve :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ------------------------------------------------------------ features */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1px, 0.2vw, 2px);
    margin-top: clamp(30px, 5vh, 58px);
    background: rgba(238, 234, 226, 0.12);
    border: 1px solid rgba(238, 234, 226, 0.12);
  }

  .card {
    position: relative;
    padding: clamp(24px, 2.8vw, 44px);
    background: var(--void);
  }

  .card-no {
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--red);
  }

  .card h3 {
    margin-top: 0.9rem;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 32, 'wdth' 104, 'wght' 740;
    font-size: clamp(19px, 1.8vw, 28px);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .card p {
    margin-top: 0.6rem;
    max-width: 44ch;
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.58;
    color: rgba(238, 234, 226, 0.6);
  }

  /* --------------------------------------------------------------- aloud */

  .aloud {
    border-top: 1px solid rgba(238, 234, 226, 0.1);
  }

  .aloud-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .aloud-body {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    color: rgba(238, 234, 226, 0.68);
  }

  .aloud-illo {
    width: 100%;
    height: auto;
    padding: clamp(18px, 2.4vw, 38px);
    border: 1px solid rgba(238, 234, 226, 0.14);
    border-radius: 4px;
    background:
      radial-gradient(90% 120% at 22% 40%, rgba(216, 0, 45, 0.16), rgba(10, 7, 13, 0) 66%),
      var(--ink);
    color: var(--cream);
  }

  .aloud-illo .aloud-label {
    fill: var(--red);
    font-family: 'Azeret Mono', ui-monospace, monospace;
  }

  /* --------------------------------------------------------------- split */

  .split {
    position: relative;
    display: grid;
    grid-template-columns: 46% 1fr;
    min-height: clamp(560px, 92svh, 900px);
    border-top: 1px solid rgba(238, 234, 226, 0.1);
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: clamp(40px, 6vh, 90px) clamp(22px, 4vw, 70px);
  }

  .field-sound {
    background:
      radial-gradient(120% 90% at 30% 40%, rgba(216, 0, 45, 0.2), rgba(10, 7, 13, 0) 62%),
      var(--void);
  }

  .sound {
    width: min(100%, 460px);
    height: auto;
    margin-inline: auto;
  }

  .sound .ring path {
    animation: pulse 5.5s ease-in-out infinite;
  }

  .sound .ring path:nth-child(2) {
    animation-delay: 0.5s;
  }
  .sound .ring path:nth-child(3) {
    animation-delay: 1s;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.24;
    }
    50% {
      opacity: 1;
    }
  }

  .field-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(24px, 3vh, 40px);
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: clamp(10.5px, 0.9vw, 12.5px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(238, 234, 226, 0.6);
    text-align: center;
    justify-content: center;
  }

  .field-note .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
  }

  .field-own {
    background: var(--red);
    color: var(--paper);
  }

  .own {
    position: relative;
    z-index: 2;
    width: min(100%, 640px);
  }

  .eyebrow.on-red {
    color: rgba(253, 246, 236, 0.72);
  }

  .eyebrow.on-red i,
  .eyebrow.on-red b {
    color: var(--paper);
    background: var(--paper);
  }

  .eyebrow.on-red b {
    background: none;
  }

  .own h2 {
    max-width: 14ch;
    margin-top: 0.7rem;
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 60, 'wdth' 108, 'wght' 780;
    font-size: clamp(34px, 4.4vw, 68px);
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  .own ul {
    margin-top: clamp(22px, 3vh, 36px);
    display: grid;
    gap: 0;
  }

  .own li {
    padding-block: clamp(14px, 1.8vh, 22px);
    border-top: 1px solid rgba(253, 246, 236, 0.3);
  }

  .own li:last-child {
    border-bottom: 1px solid rgba(253, 246, 236, 0.3);
  }

  .own h3 {
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 24, 'wdth' 104, 'wght' 750;
    font-size: clamp(17px, 1.5vw, 23px);
    letter-spacing: -0.018em;
  }

  .own p {
    margin-top: 0.35rem;
    max-width: 48ch;
    font-size: clamp(12.5px, 0.98vw, 14.5px);
    line-height: 1.55;
    color: rgba(253, 246, 236, 0.82);
  }

  /* The seam is marked by the chapter, not by the logo: one hairline down
     the join and the number set small against it. */
  .seam-mark {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(22px, 4vh, 48px);
    pointer-events: none;
  }

  .seam-mark i {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgba(253, 246, 236, 0) 0%,
      rgba(253, 246, 236, 0.55) 22%,
      rgba(253, 246, 236, 0.55) 78%,
      rgba(253, 246, 236, 0) 100%
    );
  }

  .seam-mark span {
    flex: none;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(253, 246, 236, 0.66);
    writing-mode: vertical-rl;
  }

  /* ---------------------------------------------------------------- pair */

  .pair {
    overflow: hidden;
    border-top: 1px solid rgba(238, 234, 226, 0.1);
  }

  .pair-body {
    max-width: 50ch;
    margin-top: 1rem;
    font-size: clamp(13.5px, 1.06vw, 16px);
    line-height: 1.6;
    color: rgba(238, 234, 226, 0.64);
  }

  .rig {
    position: relative;
    width: min(100% - var(--pad) * 2, 1000px);
    margin: clamp(34px, 6vh, 74px) auto 0;
    padding-bottom: 7%;
  }

  .pad {
    width: 100%;
    aspect-ratio: 1.43;
    padding: clamp(8px, 0.9vw, 14px);
    border-radius: clamp(16px, 1.9vw, 30px);
    background: linear-gradient(160deg, #efe9e0, #b9b2a8 52%, #ded7cd);
    box-shadow:
      0 40px 90px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(10, 7, 13, 0.55);
  }

  .pad-screen {
    display: grid;
    grid-template-columns: clamp(120px, 19%, 190px) 1fr;
    height: 100%;
    border-radius: clamp(10px, 1.3vw, 20px);
    overflow: hidden;
    background: var(--ink);
  }

  .pad-side {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(12px, 1.5vw, 22px);
    background: rgba(10, 7, 13, 0.72);
    border-right: 1px solid rgba(238, 234, 226, 0.09);
    font-size: clamp(9.5px, 0.86vw, 12.5px);
  }

  .pad-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .pad-brand b {
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 14, 'wdth' 108, 'wght' 800;
    font-size: 1.15em;
  }

  .pad-nav {
    padding: 0.34rem 0.5rem;
    border-radius: 3px;
    color: rgba(238, 234, 226, 0.55);
  }

  .pad-nav.is-on {
    background: var(--red);
    color: var(--paper);
  }

  .pad-weekly {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(238, 234, 226, 0.12);
    color: rgba(238, 234, 226, 0.66);
  }

  .pad-weekly i {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
  }

  .pad-main {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 1.5vw, 22px);
    min-width: 0;
  }

  .pad-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(10px, 1.2vw, 16px);
  }

  .pad-h {
    font-family: 'Bricolage Grotesque', Arial, sans-serif;
    font-variation-settings: 'opsz' 24, 'wdth' 104, 'wght' 750;
    font-size: clamp(13px, 1.4vw, 22px);
    letter-spacing: -0.02em;
  }

  .pad-search {
    width: clamp(70px, 22%, 190px);
    height: clamp(14px, 1.5vw, 22px);
    border-radius: 999px;
    background: rgba(238, 234, 226, 0.1);
  }

  .pad-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(6px, 0.8vw, 12px);
    min-height: 0;
    align-content: start;
  }

  .pad-now {
    display: grid;
    grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1.6fr) auto;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
    margin-top: auto;
    padding-top: clamp(10px, 1.2vw, 18px);
    border-top: 1px solid rgba(238, 234, 226, 0.12);
  }

  .pad-now-art {
    display: block;
    width: clamp(26px, 3.4vw, 46px);
    aspect-ratio: 1;
    border-radius: 2px;
    overflow: hidden;
  }

  .pad-now-art :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pad-now-meta {
    display: grid;
    min-width: 0;
