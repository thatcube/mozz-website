---
/**
 * VARIANT — UMBRA SITE
 *
 * A direct extension of the hero study at /h/umbra, not a new idea.
 *
 * The hero is kept: one colossal MOZZ running off both edges of the window,
 * lit cream at the frame, falling to red as it nears the app, and going to
 * ground black directly behind it. The phone does not sit on the wordmark; it
 * eats a hole in the light.
 *
 * Everything below the fold is the same physics read again. The servers are
 * three lamps. Streaming and offline are the lit half and the shadowed half of
 * one picture, given identical weight. The weekly mixes drift through a band of
 * light and fall back into the dark at both edges. The split section puts the
 * sound itself on one side of a hard seam and the ownership argument on the
 * other. The sleeve wall is demoted to the texture behind the questions.
 *
 * Red, cream and near-black. Nothing else, and no photography anywhere: every
 * sleeve on this page is generated below as a small SVG.
 */
import Layout from '../../layouts/Layout.astro';
import Mark from '../../components/Mark.astro';
import VariantBar from '../../components/VariantBar.astro';
import ServerLogo from '../../components/ServerLogo.astro';
import {
  NAME,
  TAGLINE,
  SUBLINE,
  SERVERS,
  FEATURES,
  CONTINUITY,
  OWNERSHIP,
  STATS,
  FAQS,
  GITHUB_URL,
  DONATE_URL,
  APP_STORE_URL,
} from '../../data/site';

/* Only the hero headline, its support line and the meta description are written
   here. Every product claim on the page comes out of src/data/site.ts. */
const HEADLINE = 'Mozz is a free player for the music on your own server.';
const SUPPORT =
  'Listen at home over your own network, or keep an album on the phone and play it with no signal at all.';
const META =
  'Mozz is a free, open source music player for iPhone and iPad. Point it at the Plex, Jellyfin or Navidrome server you already run, listen at home, or download an album and play it offline.';

/* The three servers get their own light. Everything they say comes from data. */
const SERVER_ROLES = ['lit', 'penumbra', 'umbra'] as const;

/* Streaming and offline, given the same room. Both bodies are verbatim. */
const PARITY = [FEATURES[0], FEATURES[1]];
/* The weekly mixes carry the drifting band. */
const WEEKLY = FEATURES[5];
/* Everything else fills the capability grid. */
const REST = [FEATURES[2], FEATURES[3], FEATURES[4], FEATURES[6]];

/* ------------------------------------------------------------------ sleeves */

/**
 * Invented artwork, drawn in the page's own three inks.
 *
 * Nothing here borrows a real record: each sleeve is a handful of shapes over a
 * flat ground, and the whole set is deterministic so a rebuild never reshuffles
 * the wall.
 */
type Ink = { bg: string; fg: string; ac: string };

const VOID = '#0a070d';
const INK = '#140a11';
const CREAM = '#eeeae2';
const RED = '#d8002d';
const DEEP = '#a10020';

const INKS: Ink[] = [
  { bg: INK, fg: CREAM, ac: RED },
  { bg: RED, fg: CREAM, ac: INK },
  { bg: CREAM, fg: INK, ac: RED },
  { bg: VOID, fg: RED, ac: CREAM },
  { bg: DEEP, fg: CREAM, ac: VOID },
];

const KINDS = [
  'disc',
  'band',
  'peak',
  'grid',
  'arc',
  'wedge',
  'dot',
  'stack',
  'rise',
  'eye',
] as const;

function sleeveArt(kind: string, ink: Ink, uid: string): string {
  const { bg, fg, ac } = ink;
  switch (kind) {
    case 'disc':
      return `<rect width="100" height="100" fill="${bg}"/>
        <circle cx="50" cy="46" r="30" fill="${fg}"/>
        <circle cx="62" cy="40" r="30" fill="${bg}"/>
        <rect x="14" y="86" width="34" height="3.6" fill="${ac}"/>`;
    case 'band':
      return `<rect width="100" height="100" fill="${bg}"/>
        <rect y="34" width="100" height="30" fill="${fg}"/>
        <circle cx="50" cy="49" r="11" fill="${ac}"/>
        <rect y="21" width="100" height="3" fill="${fg}" opacity=".5"/>
        <rect y="74" width="100" height="3" fill="${fg}" opacity=".5"/>`;
    case 'peak':
      return `<rect width="100" height="100" fill="${bg}"/>
        <path d="M0 100 30 40 60 100Z" fill="${fg}"/>
        <path d="M38 100 70 28 100 100Z" fill="${ac}"/>`;
    case 'grid': {
      let out = `<rect width="100" height="100" fill="${bg}"/>`;
      for (let r = 0; r < 5; r += 1)
        for (let c = 0; c < 5; c += 1)
          out += `<rect x="${9 + c * 17}" y="${9 + r * 17}" width="${
            4 + r * 1.6
          }" height="${4 + r * 1.6}" fill="${r === 3 && c === 1 ? ac : fg}"/>`;
      return out;
    }
    case 'arc':
      return `<rect width="100" height="100" fill="${bg}"/>
        <g fill="none" stroke="${fg}" stroke-width="4.6" stroke-linecap="round">
          <path d="M18 20a40 40 0 0 1 0 60"/><path d="M40 33a22 22 0 0 1 0 34"/>
        </g><circle cx="72" cy="50" r="7" fill="${ac}"/>`;
    case 'wedge':
      return `<rect width="100" height="100" fill="${bg}"/>
        <path d="M0 0H100L0 100Z" fill="${fg}"/>
        <circle cx="70" cy="70" r="15" fill="${ac}"/>`;
    case 'dot': {
      let out = `<rect width="100" height="100" fill="${bg}"/>`;
      for (let i = 0; i < 9; i += 1)
        out += `<circle cx="${14 + (i % 3) * 30}" cy="${
          16 + Math.floor(i / 3) * 30
        }" r="${3 + (i % 4) * 2.4}" fill="${i === 4 ? ac : fg}"/>`;
      return `${out}<rect y="88" width="100" height="4" fill="${ac}" opacity=".7"/>`;
    }
    case 'stack': {
      const w = [72, 44, 84, 30, 60, 50];
      return (
        `<rect width="100" height="100" fill="${bg}"/>` +
        w
          .map(
            (v, i) =>
              `<rect x="10" y="${16 + i * 12}" width="${v}" height="5" fill="${
                i === 2 ? ac : fg
              }" opacity="${i === 2 ? 1 : 0.82}"/>`,
          )
          .join('')
      );
    }
    case 'rise': {
      const h = [22, 44, 30, 62, 38, 70, 26];
      return (
        `<rect width="100" height="100" fill="${bg}"/>` +
        h
          .map(
            (v, i) =>
              `<rect x="${8 + i * 13}" y="${86 - v}" width="8" height="${v}" fill="${
                i % 3 === 1 ? ac : fg
              }"/>`,
          )
          .join('')
      );
    }
    case 'eye':
    default:
      return `<rect width="100" height="100" fill="${bg}"/>
        <ellipse cx="50" cy="50" rx="40" ry="24" fill="none" stroke="${fg}" stroke-width="5"/>
        <circle cx="50" cy="50" r="11" fill="${ac}"/>
        <rect x="8" y="8" width="18" height="4" fill="${fg}" opacity=".6"/>`;
  }
}

function sleeve(index: number, uid: string): string {
  const kind = KINDS[index % KINDS.length];
  const ink = INKS[(index * 3 + 1) % INKS.length];
  return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" aria-hidden="true">${sleeveArt(
    kind,
    ink,
    uid,
  )}</svg>`;
}

/** The drifting band, and the wall behind the questions. */
const DRIFT_FRONT = Array.from({ length: 9 }, (_, i) => i);
const DRIFT_BACK = Array.from({ length: 12 }, (_, i) => i + 4);
const WALL = Array.from({ length: 48 }, (_, i) => i * 3 + 1);

/** The library grid drawn on the iPad in the pair section. */
/* Hand-shuffled rather than a stride, so no two rows of the grid repeat. */
const PAD_TILES = [4, 9, 1, 6, 12, 3, 15, 7, 18, 2, 11, 5, 8, 14, 0, 17, 10, 19, 13, 16, 21, 24, 26, 23];
---

<Layout title={`${NAME} — a free player for the music on your own server`} description={META} themeColor="#0a070d">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..200,300..800&family=Wix+Madefor+Text:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  <VariantBar slug="umbra-site" tone="neutral" />

  <main class="umbra">
    <!-- ============================================================ HERO
         The study at /h/umbra, preserved: four stacked copies of the word,
         each masked to a different distance from the app, so the light falls
         off as it approaches and goes out entirely behind it. -->
    <section class="hero" aria-labelledby="um-hero">
      <div class="glow" aria-hidden="true"></div>

      <div class="stage" aria-hidden="true">
        <div class="wl lit"><span>MOZZ</span></div>
        <div class="wl pen"><span>MOZZ</span></div>
        <div class="wl deep"><span>MOZZ</span></div>
        <div class="wl umb"><span>MOZZ</span></div>

        <svg class="illo arcs" viewBox="0 0 46 84">
          <path
            d="M6 10a44 44 0 0 1 0 64M20 21a28 28 0 0 1 0 42M34 32a13 13 0 0 1 0 20"
            fill="none"
            stroke="#d8002d"
            stroke-width="2.6"
            stroke-linecap="round"></path>
        </svg>

        <svg class="illo spark" viewBox="0 0 40 40">
          <path
            d="M20 0c1.1 11.3 8.7 18.9 20 20-11.3 1.1-18.9 8.7-20 20-1.1-11.3-8.7-18.9-20-20 11.3-1.1 18.9-8.7 20-20Z"
            fill="#eeeae2"></path>
        </svg>

        <!--
          The mark at large format. Not the header sprite — that is ten reds
          which only blend optically at 26px. This is the same geometry lifted
          from src/brand/mozz-logo.svg, flat, so it stays clean at poster size.
        -->
        <svg class="illo moon" viewBox="0 0 32 32">
          <path
            class="disc"
            d="M12 3H20V4H22V5H24V6H25V7H26V8H27V10H28V12H29V20H28V22H27V24H26V25H25V26H24V27H22V28H20V29H12V28H10V27H8V26H7V25H6V24H5V22H4V20H3V12H4V10H5V8H6V7H7V6H8V5H10V4H12V3Z"
            fill="#d8002d"></path>
          <path
            class="face"
            d="M12 12h3v1h-3zm5 0h3v1h-3zm-4 1h2v1h-2zm5 0h2v1h-2zm-6 1h2v1h-2zm5 0h2v1h-2zm-5 1h3v1h-3zm5 0h3v1h-3zm-4 3h1v1h-1zm5 0h1v1h-1zm-4 1h4v1h-4z"
            fill="#eeeae2"></path>
        </svg>

        <svg class="illo bars" viewBox="0 0 34 26">
          <rect class="b1" x="0" y="6" width="6" height="20" fill="#eeeae2" opacity="0.7"></rect>
          <rect class="b2" x="10" y="0" width="6" height="26" fill="#d8002d"></rect>
          <rect class="b3" x="20" y="11" width="6" height="15" fill="#eeeae2" opacity="0.7"></rect>
          <rect class="b4" x="30" y="17" width="4" height="9" fill="#d8002d" opacity="0.65"></rect>
        </svg>
      </div>

      <div
        class="phone"
        role="img"
        aria-label="An iPhone running Mozz, playing a downloaded album from a home server."
      >
        <div class="screen">
          <div class="island" aria-hidden="true"></div>

          <div class="status" aria-hidden="true">
            <span>9:41</span>
            <span class="glyphs">
              <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V0h-2z"></path></svg>
              <svg viewBox="0 0 26 12">
                <rect x="1" y="1" width="20" height="10" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                <rect x="3" y="3" width="14" height="6" rx="1.4"></rect>
                <path d="M23 4.3v3.4a1.9 1.9 0 0 0 0-3.4z"></path>
              </svg>
            </span>
          </div>

          <div class="head" aria-hidden="true">
            <svg class="chev" viewBox="0 0 16 16"
              ><path
                d="M3 6.2 8 11l5-4.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <span>playing from your server</span>
            <span class="eq"><i></i><i></i><i></i></span>
          </div>

          <div class="art" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <rect width="120" height="120" fill="#f2e9df"></rect>
              <rect width="52" height="120" fill="#d8002d"></rect>
              <circle cx="52" cy="50" r="30" fill="#140a11"></circle>
              <rect x="66" y="86" width="40" height="3.4" fill="#140a11" opacity="0.55"></rect>
              <rect x="66" y="95" width="24" height="3.4" fill="#140a11" opacity="0.3"></rect>
              <rect x="12" y="99" width="18" height="7" fill="#f2e9df"></rect>
            </svg>
          </div>

          <div class="meta">
            <strong>Second Shadow</strong>
            <span>Halo North &middot; Nightside</span>
          </div>

          <div class="bar" aria-hidden="true"><i></i></div>
          <div class="times" aria-hidden="true"><span>1:52</span><span>&minus;2:14</span></div>

          <div class="ctrl" aria-hidden="true">
            <svg viewBox="0 0 20 20"
              ><path d="M17.4 3.4v13.2L7.6 10z"></path><rect x="2.6" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg
            >
            <span class="play"
              ><svg viewBox="0 0 20 20"
                ><rect x="5.6" y="4.4" width="3.3" height="11.2" rx="1.3"></rect><rect
                  x="11.1"
                  y="4.4"
                  width="3.3"
                  height="11.2"
                  rx="1.3"></rect></svg
              ></span
            >
            <svg viewBox="0 0 20 20"
              ><path d="M2.6 3.4v13.2L12.4 10z"></path><rect x="14.8" y="3.4" width="2.6" height="13.2" rx="1.2"></rect></svg
            >
          </div>

          <div class="pill" aria-hidden="true">
            <svg viewBox="0 0 16 16"
              ><circle cx="8" cy="8" r="7" fill="#d8002d"></circle><path
                d="M4.9 8.2 6.9 10.3 11 5.9"
                fill="none"
                stroke="#fdf6ec"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <span>downloaded &middot; plays offline</span>
          </div>

          <span class="home" aria-hidden="true"></span>
        </div>
      </div>

      <div class="ui">
        <header class="top">
          <a class="lockup" href="#um-hero">
            <Mark size={26} decorative />
            <b>{NAME}</b>
            <i aria-hidden="true"></i>
            <span>self&#8209;hosted music player</span>
          </a>
          <span class="fine">{SUBLINE.toLowerCase()} &middot; gpl&#8209;3.0 &middot; no account</span>
        </header>

        <p class="works">
          <span class="tag">plays from</span>
          {
            SERVERS.map((s, i) => (
              <>
                {i > 0 && <i aria-hidden="true" />}
                <b>{s.name}</b>
              </>
            ))
          }
        </p>

        <div class="mid" aria-hidden="true"></div>

        <div class="say">
          <div class="words">
            <h1 id="um-hero">{HEADLINE}</h1>
            <p class="sup">{SUPPORT}</p>

            <div class="acts">
              <a class="btn solid" href={GITHUB_URL}>Source on GitHub</a>
              {
                APP_STORE_URL ? (
                  <a class="btn ghost" href={APP_STORE_URL}>
                    Download on the App Store
                  </a>
                ) : (
                  <span class="btn ghost pending" aria-disabled="true">
                    <i aria-hidden="true" />
                    Coming to the App Store
                  </span>
                )
              }
            </div>
          </div>

          <a class="ref" href="#um-servers">
            <span>keep reading</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 2v12M3.4 9.4 8 14l4.6-4.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <!-- ======================================================== SERVERS
         Three lamps at three distances: lit, penumbra, umbra. -->
    <section class="band servers" id="um-servers" aria-labelledby="um-servers-t">
      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>01</b>Where the music already is</p>
        <h2 id="um-servers-t">Point it at the machine you already own.</h2>

        <ul class="lamps" role="list">
          {
            SERVERS.map((s, i) => (
              <li class={`lamp is-${SERVER_ROLES[i]} reveal`} style={`--i:${i}`}>
                <span class="lamp-logo">
                  <ServerLogo name={s.name} size={26} />
                </span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
                <span class="lamp-rule" aria-hidden="true"></span>
              </li>
            ))
          }
        </ul>

        <p class="aside">
          {FAQS[0].a}
        </p>
      </div>
    </section>

    <!-- =================================================== STREAMING / OFFLINE
         The lit half and the shadowed half of one picture, at identical
         weight — the argument the hero makes, said in words. -->
    <section class="band parity" aria-labelledby="um-parity-t">
      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>02</b>Two halves of the same picture</p>
        <h2 id="um-parity-t">In the light, or in the shadow. Same player.</h2>

        <div class="halves">
          {
            PARITY.map((f, i) => (
              <article class={`half ${i === 0 ? 'is-lit' : 'is-dark'} reveal`} style={`--i:${i}`}>
                <span class="half-tag">{i === 0 ? 'Streaming' : 'Offline'}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <svg class="half-illo" viewBox="0 0 120 60" aria-hidden="true">
                  {i === 0 ? (
                    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                      <rect x="3" y="13" width="24" height="34" rx="3" />
                      <path d="M9 40h4" />
                      <path d="M38 21a15 15 0 0 1 0 18" />
                      <path d="M48 14a26 26 0 0 1 0 32" opacity="0.62" />
                      <path d="M58 7a37 37 0 0 1 0 46" opacity="0.36" />
                      <rect x="88" y="9" width="26" height="42" rx="6" />
                      <circle cx="101" cy="30" r="5.5" fill="currentColor" stroke="none" />
                    </g>
                  ) : (
                    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                      <path d="M3 30h42" opacity="0.45" stroke-dasharray="5 7" />
                      <path d="M55 19 71 41M71 19 55 41" />
                      <rect x="88" y="9" width="26" height="42" rx="6" />
                      <circle cx="101" cy="30" r="5.5" fill="currentColor" stroke="none" />
                      <path d="M101 41v5" opacity="0.5" />
                    </g>
                  )}
                </svg>
              </article>
            ))
          }
        </div>

        <ul class="stats" role="list">
          {
            STATS.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <b>{s.value}</b>
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- =========================================================== MARQUEE
         The drifting band from /h/marquee, recoloured to three inks and
         re-executed: instead of four blurred rows behind a phone, one broad
         band of sleeves that emerges out of the umbra at the left edge,
         crosses a red light in the middle, and falls back into it at the
         right. Decoration for the weekly mixes, not a hero. -->
    <section class="band weekly" aria-labelledby="um-weekly-t">
      <div class="wrap weekly-head">
        <p class="eyebrow"><i aria-hidden="true"></i><b>03</b>Featured</p>
        <h2 id="um-weekly-t">{WEEKLY.title}</h2>
        <p class="weekly-body">{WEEKLY.body}</p>
      </div>

      <div class="drift" aria-hidden="true">
        <div class="drift-glow"></div>
        <div class="drift-row is-front">
          <div class="drift-track">
            {[0, 1].map((copy) =>
              DRIFT_FRONT.map((n) => <span class="sleeve" set:html={sleeve(n, `f${n}${copy}`)} />),
            )}
          </div>
        </div>
        <div class="drift-row is-back">
          <div class="drift-track is-rev">
            {[0, 1].map((copy) =>
              DRIFT_BACK.map((n) => <span class="sleeve" set:html={sleeve(n, `b${n}${copy}`)} />),
            )}
          </div>
        </div>
        <div class="drift-umbra"></div>
      </div>
    </section>

    <!-- ========================================================== FEATURES -->
    <section class="band does" aria-labelledby="um-does-t">
      <div class="wrap">
        <p class="eyebrow"><i aria-hidden="true"></i><b>04</b>What it does with them</p>
        <h2 id="um-does-t">A player, built the way a library wants to be played.</h2>

        <ul class="cards" role="list">
          {
            REST.map((f, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <span class="card-no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================ ALOUD
         New ground: the app reaches past the phone. Drawn rather than
         described — the request goes one way and the sound comes back. -->
    <section class="band aloud" aria-labelledby="um-aloud-t">
      <div class="wrap aloud-grid">
        <div class="aloud-say">
          <p class="eyebrow"><i aria-hidden="true"></i><b>05</b>Past the phone</p>
          <h2 id="um-aloud-t">{FEATURES[7].title}</h2>
          <p class="aloud-body">{FEATURES[7].body}</p>
        </div>

        <svg class="aloud-illo" viewBox="0 0 440 210" role="img" aria-label="A HomePod handing a request to an iPhone, which plays it and AirPlays the sound back.">
          <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <rect x="34" y="52" width="86" height="122" rx="42" />
            <ellipse cx="77" cy="66" rx="30" ry="10" opacity="0.5" />
            <path d="M52 96h50M52 110h50M52 124h50M58 138h38" opacity="0.4" />
            <rect x="330" y="38" width="74" height="140" rx="16" />
            <rect x="342" y="56" width="50" height="104" rx="6" opacity="0.45" />
            <circle cx="367" cy="108" r="13" fill="currentColor" stroke="none" />
            <path d="M136 78C196 52 268 50 316 62" />
            <path d="M304 52l14 10-13 11" />
            <path d="M316 158C258 180 190 178 138 160" opacity="0.75" />
            <path d="M150 150l-14 10 13 11" opacity="0.75" />
          </g>
          <g class="aloud-label" font-size="11" letter-spacing="1.6">
            <text x="77" y="196" text-anchor="middle">HOMEPOD</text>
            <text x="367" y="196" text-anchor="middle">IPHONE</text>
