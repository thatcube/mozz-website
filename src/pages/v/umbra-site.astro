<script>
  /* Scroll reveal. Everything has a resting state in CSS, so the page is
     complete with JavaScript off and under prefers-reduced-motion; this only
     decides when the transition is allowed to run. */
  const items = document.querySelectorAll<HTMLElement>('.reveal, .rig');
  if (items.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    for (const item of items) io.observe(item);
  }
</script>

