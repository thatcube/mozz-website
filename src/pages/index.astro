---
/**
 * The vibe picker.
 *
 * This is scaffolding, not a design statement: its whole job is to let seven
 * very loud landing pages be compared fairly. So it stays deliberately quiet —
 * neutral ground, plain type, no personality of its own — and every bit of
 * colour on the page comes from the variants it is showing. It is the first
 * thing to delete once a direction wins.
 *
 * Thumbnails are generated by `npm run thumbs` after a build. If one is
 * missing the card falls back to the variant's own swatches, so the picker is
 * never broken by a stale or absent screenshot.
 */
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import { VARIANTS, NAME, GITHUB_URL, SITE } from '../data/site';
---

<Layout
  title={`${NAME} — pick a vibe`}
  description="Seven complete design directions for the Mozz website. Same product, same facts, seven different worlds."
  themeColor="#0e0e11"
  noindex
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="pick">
    <header>
      <div class="lockup">
        <Mark size={44} decorative />
        <span>{NAME}</span>
      </div>

      <h1>{VARIANTS.length} ways this could look.</h1>
      <p class="sub">
        Every page below is complete and says exactly the same true things about
        the app. Only the world changes. Open a few, pick the one that feels
        like Mozz, and the rest get deleted.
      </p>
      <p class="note">
        The store button is a placeholder on every one of them until there is a
        listing to point it at. Every illustration is drawn in CSS and SVG, so
        nothing here is waiting on an image.
      </p>
    </header>

    <ol class="grid" role="list">
      {VARIANTS.map((v, i) => (
        <li>
          <a href={`/v/${v.slug}`} class="card">
            <span class="shot" style={`--a:${v.swatch[0]};--b:${v.swatch[1]};--c:${v.swatch[2]}`}>
              <img
                src={`/thumbs/${v.slug}.png`}
                alt={`The ${v.name} design direction for the Mozz website`}
                width="1440"
                height="900"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                onerror="this.remove()"
              />
            </span>

            <span class="meta">
              <span class="name">
                {v.name}
                <em>{v.vibe}</em>
              </span>
              <span class="blurb">{v.blurb}</span>
              <span class="swatches" aria-hidden="true">
                {v.swatch.map((c) => <i style={`--sw:${c}`}></i>)}
                <b>{v.mood}</b>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <footer>
      <p>
        {NAME} is free forever and open source under GPL-3.0.
        <a href={GITHUB_URL}>See the app on GitHub</a>
      </p>
      <p class="dim">{SITE.replace('https://', '')}</p>
    </footer>
  </main>
</Layout>

<style>
  .pick {
    --bg: #0e0e11;
    --panel: #17171c;
    --line: #2a2a33;
    --text: #f1f1f4;
    --dim: #9a9aa6;

    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem clamp(3rem, 6vw, 5rem);
  }

  header {
    max-width: 46rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .sub {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: #d3d3db;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dim);
    max-width: 68ch;
    text-wrap: pretty;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 78rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(23rem, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .card {
    display: grid;
    gap: 1rem;
    height: 100%;
    align-content: start;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    transition: border-color 0.18s ease, translate 0.18s cubic-bezier(0.2, 0.9, 0.3, 1),
      box-shadow 0.18s ease;
  }

  .card:hover {
    border-color: #4a4a58;
    translate: 0 -3px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
  }

  /* The swatch gradient sits under the screenshot, so a missing thumbnail
     degrades to the variant's own colours instead of an empty hole. */
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(140deg, var(--a) 0 42%, var(--c) 42% 72%, var(--b) 72% 100%);
  }

  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .meta {
    display: grid;
    gap: 0.55rem;
    padding-inline: 0.4rem;
  }

  .name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .name em {
    font-style: italic;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--dim);
    letter-spacing: 0;
  }

  .blurb {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #c2c2cc;
    text-wrap: pretty;
  }

  .swatches {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  .swatches i {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .swatches b {
    margin-left: 0.45rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  footer {
    max-width: 78rem;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--dim);
  }

  footer a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 0.4rem;
  }

  .dim {
    font-variant-numeric: tabular-nums;
  }
</style>
