---
/**
 * The Mozz mark, inlined.
 *
 * The artwork is pixel art from the app repo (`npm run brand` fetches it from
 * GitHub). It is inlined rather than linked so it paints with the first byte of
 * HTML and so `currentColor` never gets a chance to touch it — the reds are the
 * brand's, not the page's.
 *
 * Every scaled instance keeps hard edges. A smoothed 32px sprite at hero size
 * looks like a mistake, and this mark is only ever right when the squares show.
 */

import raw from '../brand/mozz-logo.svg?raw';

export interface Props {
  /** Rendered edge length in px. */
  size?: number;
  class?: string;
  /** Decorative instances sit beside a wordmark that already says "Mozz". */
  decorative?: boolean;
}

const { size = 48, class: className = '', decorative = false } = Astro.props;

// The source ships at 32x32 with hard-coded width/height. Strip those so the
// wrapper's box decides the size, and keep the viewBox doing the scaling.
const inner = raw
  .replace(/<\?xml[^>]*\?>/g, '')
  .replace(/<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();
---

<span
  class={`mozz-mark ${className}`.trim()}
  style={`--mark-size:${size}px`}
  aria-hidden={decorative ? 'true' : undefined}
>
  <svg
    viewBox="0 0 32 32"
    role={decorative ? 'presentation' : 'img'}
    aria-label={decorative ? undefined : 'Mozz'}
    focusable="false"
    set:html={inner}
  />
</span>

<style>
  .mozz-mark {
    display: inline-block;
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    line-height: 0;
  }

  .mozz-mark svg {
    width: 100%;
    height: 100%;
    /* Pixel art. Both properties matter: one governs any rasterisation the
       browser does, the other stops sub-pixel antialiasing on the rect edges. */
    image-rendering: pixelated;
    shape-rendering: crispEdges;
  }
</style>
