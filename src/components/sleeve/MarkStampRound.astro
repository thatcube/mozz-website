---
/**
 * The Mozz mark as a catalogue stamp, with a true circle instead of the
 * stepped pixel silhouette.
 *
 * The pixel disc is a drawing of a circle, made of steps because the original
 * artwork lives on a 32-unit grid. At stamp size those steps are the whole
 * character; blown up to plate scale they are the loudest thing on the page,
 * and they compete with the face they are supposed to frame.
 *
 * So this keeps the face exactly as it is — pixels intact, lifted verbatim
 * from src/brand/mozz-logo.svg — and lets the outline be the smooth circle the
 * steps were always approximating. The tension between the two is the point:
 * a clean plate with a pixel face printed on it.
 *
 * Radius 13 on the 32-unit grid matches the pixel disc's own 26-unit span, so
 * this and MarkStamp carry identical mass and can be compared honestly.
 */

export interface Props {
  /** Red plate with a bone mark, or bare bone with a red mark. */
  ground?: 'red' | 'bone';
  /** Hairline frame, as a sleeve edge. */
  frame?: boolean;
  class?: string;
  label?: string;
}

const { ground = 'red', frame = false, class: className = '', label } = Astro.props;

/** Same 56/100 field as the stepped stamp, so the two are directly comparable. */
const SCALE = 56 / 26;
const OFFSET = 50 - 16 * SCALE;

const FACE =
  'M12 12h3v1h-3zm5 0h3v1h-3zm-4 1h2v1h-2zm5 0h2v1h-2zm-6 1h2v1h-2zm5 0h2v1h-2zm-5 1h3v1h-3zm5 0h3v1h-3zm-4 3h1v1h-1zm5 0h1v1h-1zm-4 1h4v1h-4z';
---

<svg
  class:list={['mark-stamp', ground === 'red' ? 'on-red' : 'on-bone', className]}
  viewBox="0 0 100 100"
  role={label ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect class="ground" width="100" height="100" />
  <g transform={`translate(${OFFSET.toFixed(3)} ${OFFSET.toFixed(3)}) scale(${SCALE.toFixed(5)})`}>
    <circle class="disc" cx="16" cy="16" r="13" />
    <path class="face" d={FACE} />
  </g>
  {frame && <rect x="0.6" y="0.6" width="98.8" height="98.8" class="frame" />}
</svg>

<style>
  .mark-stamp {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The circle is the one thing here allowed to be smooth. */
  .disc {
    shape-rendering: geometricPrecision;
  }

  /* The face is still pixel art, and the steps are still the artwork. */
  .face {
    shape-rendering: crispEdges;
  }

  .on-red .ground { fill: var(--sl-red, #c80028); }
  .on-red .disc { fill: var(--sl-bone, #f2efe6); }
  .on-red .face { fill: var(--sl-red, #c80028); }

  .on-bone .ground { fill: var(--sl-bone, #f2efe6); }
  .on-bone .disc { fill: var(--sl-red, #c80028); }
  .on-bone .face { fill: var(--sl-bone, #f2efe6); }

  .frame {
    fill: none;
    stroke: var(--sl-rule, rgba(19, 19, 19, 0.18));
    stroke-width: 1.2;
    shape-rendering: geometricPrecision;
  }
</style>
