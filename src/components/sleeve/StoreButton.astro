---
/**
 * The store button, in both of its states.
 *
 * APP_STORE_URL is intentionally empty until the listing exists, so this renders
 * a visibly pending badge rather than a link that goes nowhere. Paste the URL
 * into src/data/site.ts and every page turns into a real download button.
 */
import { APP_STORE_URL } from '../../data/site';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const GLYPH =
  'M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z';
---

{APP_STORE_URL ? (
  <a class:list={['store', className]} href={APP_STORE_URL}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={GLYPH} /></svg>
    <span><small>Download on the</small>App Store</span>
  </a>
) : (
  <span class:list={['store', 'is-pending', className]} aria-disabled="true">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={GLYPH} /></svg>
    <span><small>Coming to the</small>App Store</span>
  </span>
)}

<style>
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.35rem;
    background: var(--store-bg, #131313);
    color: var(--store-fg, #f2efe6);
    border: 1px solid var(--store-bg, #131313);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .store svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    flex: none;
  }

  .store span {
    display: flex;
    flex-direction: column;
    font-size: 0.98rem;
  }

  .store small {
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    opacity: 0.72;
    font-weight: 500;
  }

  a.store:hover {
    background: var(--store-bg-hover, var(--sl-red, #c80028));
    border-color: var(--store-bg-hover, var(--sl-red, #c80028));
  }

  .is-pending {
    background: transparent;
    color: var(--store-pending-fg, #131313);
    border: 1px dashed var(--store-pending-border, rgba(19, 19, 19, 0.42));
    cursor: default;
  }
</style>
