---
import { APP_HEROES, ART_HEROES, HEROES, LATEST_HEROES, NEW_HEROES } from '../data/heroes';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const current = HEROES.findIndex((hero) => hero.slug === slug);
const GROUPS = [
  { label: 'Latest', heroes: LATEST_HEROES },
  { label: 'New', heroes: NEW_HEROES },
  { label: 'App', heroes: APP_HEROES },
  { label: 'Art', heroes: ART_HEROES },
];
---

<nav class="hero-bar" aria-label="Hero studies">
  <a href="/heroes" class="all">All heroes</a>
  {GROUPS.map((group) => (
    <>
      <span class="group-label">{group.label}</span>
      <ol role="list">
        {group.heroes.map((hero) => (
          <li>
            <a href={`/h/${hero.slug}`} aria-current={hero.slug === slug ? 'page' : undefined}>
              {hero.name}
            </a>
          </li>
        ))}
      </ol>
    </>
  ))}
  <span class="count">{current + 1} / {HEROES.length}</span>
</nav>

<style>
  .hero-bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 42px;
    padding: 0.45rem 0.8rem;
    overflow-x: auto;
    color: #202124;
    background: color-mix(in srgb, #fff 88%, transparent);
    border-bottom: 1px solid rgba(20, 20, 22, 0.12);
    backdrop-filter: blur(14px);
    font: 600 12px/1 ui-sans-serif, system-ui, sans-serif;
    scrollbar-width: none;
  }

  .hero-bar::-webkit-scrollbar { display: none; }

  .all, .hero-bar > span { flex: none; }
  .all { font-weight: 800; }
  .count { margin-left: auto; opacity: 0.48; }

  .group-label {
    padding-left: 0.6rem;
    border-left: 1px solid rgba(20, 20, 22, 0.16);
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.42;
  }

  ol {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol a {
    display: block;
    padding: 0.45rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    opacity: 0.55;
  }

  ol a:hover, ol a[aria-current='page'] {
    opacity: 1;
    background: rgba(20, 20, 22, 0.07);
  }

  a:focus-visible {
    outline: 2px solid #c80028;
    outline-offset: 2px;
  }
</style>
