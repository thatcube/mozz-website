# local screenshot output used for visual review
shots/

# App screenshot masters and their encoded ladders.
#
# This repository is public, and the screenshots currently in use were shot
# against a real personal library, so every one of them contains third-party
# album artwork. Publishing those to a public git history is not something a
# later commit can undo — it takes a history rewrite. They stay local until
# they are re-shot against a library with clearing-free artwork, at which point
# both of these lines come out.
#
# src/data/screenshots.json IS committed: it holds only filenames and
# dimensions, no imagery, and the build imports it.
screenshots-src/
public/screenshots/

# visual QA renders (regenerate with `npm run qa`)
qa/

# impeccable local hook cache
.impeccable/hook.cache.json

# throwaway verification renders and one-off scripts
scratch-*
scratch_*
qa/

# local QA scratch (screenshot dumps from tools/check-four.mjs and tools/scan.mjs)
.qa/
